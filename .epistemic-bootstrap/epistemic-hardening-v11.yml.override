name: Epistemic hardening

on:
  pull_request:
    paths:
      - "Cargo.lock"
      - "crates/domains/symthaea-engineering/**"
      - "crates/domains/symthaea-materials/**"
      - "crates/domains/symthaea-nuclear/**"
      - "crates/domains/symthaea-nuclear-forensics/**"
      - "crates/domains/symthaea-process-discovery/**"
      - "crates/domains/symthaea-quantum-chemistry/**"
      - "crates/domains/symthaea-thermofluids/**"
      - "scripts/check-epistemic-authority.py"
      - ".github/workflows/epistemic-hardening.yml"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: epistemic-hardening-${{ github.event_name == 'workflow_dispatch' && github.run_id || github.ref }}
  cancel-in-progress: ${{ github.event_name != 'workflow_dispatch' }}

env:
  RUST_BACKTRACE: 1

jobs:
  contract:
    name: contract
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4

      - name: Install pinned Rust toolchain
        uses: dtolnay/rust-toolchain@master
        with:
          toolchain: 1.94.0
          components: rustfmt, clippy

      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: epistemic-hardening-contract

      - name: Verify epistemic authority contracts
        run: python3 scripts/check-epistemic-authority.py

      - name: Resolve locked workspace metadata
        run: cargo metadata --locked --no-deps --format-version 1

      - name: Check formatting for hardened scientific crates
        run: >-
          cargo fmt
          -p symthaea-engineering
          -p symthaea-materials
          -p symthaea-nuclear
          -p symthaea-nuclear-forensics
          -p symthaea-process-discovery
          -p symthaea-quantum-chemistry
          -p symthaea-thermofluids
          -- --check

  test:
    name: test / ${{ matrix.package }}
    needs: contract
    runs-on: ubuntu-latest
    timeout-minutes: 90
    strategy:
      fail-fast: false
      matrix:
        package:
          - symthaea-engineering
          - symthaea-materials
          - symthaea-nuclear
          - symthaea-nuclear-forensics
          - symthaea-process-discovery
          - symthaea-quantum-chemistry
          - symthaea-thermofluids
    steps:
      - uses: actions/checkout@v4

      - name: Install pinned Rust toolchain
        uses: dtolnay/rust-toolchain@master
        with:
          toolchain: 1.94.0

      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: epistemic-hardening-${{ matrix.package }}

      - name: Test all targets and features
        run: cargo test --locked --all-targets --all-features -p "${{ matrix.package }}"

  clippy:
    name: clippy / ${{ matrix.package }}
    needs: test
    runs-on: ubuntu-latest
    timeout-minutes: 90
    strategy:
      fail-fast: false
      matrix:
        package:
          - symthaea-engineering
          - symthaea-materials
          - symthaea-nuclear
          - symthaea-nuclear-forensics
          - symthaea-process-discovery
          - symthaea-quantum-chemistry
          - symthaea-thermofluids
    steps:
      - uses: actions/checkout@v4

      - name: Install pinned Rust toolchain
        uses: dtolnay/rust-toolchain@master
        with:
          toolchain: 1.94.0
          components: clippy

      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: epistemic-hardening-${{ matrix.package }}

      - name: Lint all targets and features
        run: cargo clippy --locked --all-targets --all-features -p "${{ matrix.package }}" -- -D warnings
