# Mycelix Portal — development commands
# Usage: just <recipe>

# Default target dir (avoids lock contention with other sessions)
export CARGO_TARGET_DIR := "target"

# ── Build ──

# Build portal WASM (debug)
build:
    cargo build --target wasm32-unknown-unknown -j2

# Build portal WASM (release, optimized for size)
build-release:
    cargo build --target wasm32-unknown-unknown --release -j2

# Build with trunk (for serving)
trunk-build:
    ~/.cargo/bin/trunk build

# ── Serve ──

# Serve the portal at localhost:8095
serve:
    ~/.cargo/bin/trunk serve --port 8095

# ── Test ──

# Run all portal tests (lightweight, no conductor needed)
test:
    @echo "Testing domain types..."
    cargo test -p domain-governance --no-default-features
    @echo "Testing portal-inference..."
    cargo test -p portal-inference --no-default-features
    @echo "Testing wire protocol..."
    cargo test -p mycelix-leptos-client --manifest-path ../crates/mycelix-leptos-client/Cargo.toml
    @echo "Testing conductor integration types..."
    cargo test --test conductor_integration
    @echo "All tests passed!"

# Run just the wire protocol tests
test-wire:
    cargo test -p mycelix-leptos-client --manifest-path ../crates/mycelix-leptos-client/Cargo.toml

# Run just the domain type tests
test-types:
    cargo test -p domain-governance --no-default-features

# ── Check ──

# Check all crates compile for WASM target
check:
    cargo check --target wasm32-unknown-unknown

# Check workspace (all crates)
check-all:
    cargo check --workspace --target wasm32-unknown-unknown

# ── Release ──

# Full production build with optimization
release:
    cargo build --target wasm32-unknown-unknown --release -j2
    @echo "Release WASM at target/wasm32-unknown-unknown/release/mycelix-portal.wasm"
    @ls -lh target/wasm32-unknown-unknown/release/mycelix-portal.wasm

# Optimize WASM with wasm-opt
optimize: release
    wasm-opt -Oz target/wasm32-unknown-unknown/release/mycelix-portal.wasm -o dist/mycelix-portal.wasm
    @echo "Optimized:"
    @ls -lh dist/mycelix-portal.wasm

# ── Clean ──

# Remove build artifacts
clean:
    cargo clean
    rm -rf dist/
