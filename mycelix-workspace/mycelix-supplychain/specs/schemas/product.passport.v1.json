{
  "$id": "https://mycelix.org/schemas/product.passport.v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Digital Product Passport",
  "description": "Exportable bundle containing full provenance and lineage for a product batch",
  "type": "object",
  "required": ["id", "product", "batch", "lineage", "credentials", "generatedAt"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Passport identifier"
    },
    "product": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Product SKU or identifier"
        },
        "name": {
          "type": "string",
          "description": "Product name"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "gtin": {
          "type": "string",
          "description": "Global Trade Item Number (barcode)"
        }
      }
    },
    "batch": {
      "type": "object",
      "required": ["id", "quantity", "unit"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Batch/lot identifier"
        },
        "quantity": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "productionDate": {
          "type": "string",
          "format": "date-time"
        },
        "expiryDate": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "lineage": {
      "type": "object",
      "required": ["claims", "graph"],
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "$ref": "dkg.claim.v1.json"
          },
          "description": "All claims in chronological order"
        },
        "graph": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "description": "Lineage graph representation"
        }
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of VC JWTs"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "credentialJwt": {
            "type": "string"
          }
        }
      }
    },
    "sustainability": {
      "type": "object",
      "properties": {
        "carbonFootprint": {
          "type": "number",
          "description": "kg CO2e"
        },
        "waterUsage": {
          "type": "number",
          "description": "liters"
        },
        "energyUsage": {
          "type": "number",
          "description": "kWh"
        },
        "recyclability": {
          "type": "string",
          "enum": ["FULLY_RECYCLABLE", "PARTIALLY_RECYCLABLE", "NOT_RECYCLABLE"]
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When this passport was generated"
    },
    "generatedBy": {
      "type": "string",
      "description": "DID of entity generating the passport"
    },
    "signature": {
      "type": "string",
      "description": "Signature over the entire passport (optional)"
    }
  }
}
