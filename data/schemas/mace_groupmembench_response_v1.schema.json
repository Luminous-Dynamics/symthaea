{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mace_groupmembench_response_v1.schema.json",
  "title": "MACE GroupMemBench Response V1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "run_id",
        "run_binding_sha256"
      ],
      "properties": {
        "status": {
          "const": "reset"
        },
        "run_id": {
          "type": "string"
        },
        "run_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "receipt"
      ],
      "properties": {
        "status": {
          "const": "ingested"
        },
        "receipt": {
          "$ref": "#/$defs/ingestReceipt"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "receipt"
      ],
      "properties": {
        "status": {
          "const": "retrieved"
        },
        "receipt": {
          "$ref": "#/$defs/queryReceipt"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "run_id"
      ],
      "properties": {
        "status": {
          "const": "closed"
        },
        "run_id": {
          "type": "string"
        }
      }
    }
  ],
  "$defs": {
    "ingestReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "run_binding_sha256",
        "message_count",
        "ordered_message_ids_sha256",
        "candidate_projection_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "mace_groupmembench_adapter_v1"
        },
        "run_id": {
          "type": "string"
        },
        "run_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "message_count": {
          "type": "integer",
          "minimum": 1
        },
        "ordered_message_ids_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_projection_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "queryReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "run_binding_sha256",
        "query_invocation_id",
        "search_query_sha256",
        "top_k",
        "retrieved_message_ids",
        "retrieved_passages",
        "context_projection_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "mace_groupmembench_adapter_v1"
        },
        "run_id": {
          "type": "string"
        },
        "run_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "query_invocation_id": {
          "type": "string",
          "minLength": 1
        },
        "search_query_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "retrieved_message_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retrieved_passages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/passage"
          }
        },
        "context_projection_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "message_id",
        "passage"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "message_id": {
          "type": "string"
        },
        "passage": {
          "type": "string"
        }
      }
    }
  }
}
