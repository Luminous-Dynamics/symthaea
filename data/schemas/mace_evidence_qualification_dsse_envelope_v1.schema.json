{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mace_evidence_qualification_dsse_envelope_v1.schema.json",
  "title": "MACE Evidence Qualification DSSE Envelope V1",
  "description": "Closed single-signature MACE profile over a DSSE v1 in-toto Statement. DSSE itself supports multiple signatures; this profile deliberately requires exactly one Ed25519 signer until a threshold and role policy is specified.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payloadType", "payload", "signatures"],
  "properties": {
    "payloadType": {
      "const": "application/vnd.in-toto+json"
    },
    "payload": {
      "type": "string",
      "minLength": 4,
      "maxLength": 11184812,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyid", "sig"],
        "properties": {
          "keyid": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sig": {
            "type": "string",
            "minLength": 88,
            "maxLength": 88,
            "pattern": "^[A-Za-z0-9+/]{86}==$"
          }
        }
      }
    }
  }
}
