{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mace_evidence_qualification_dsse_envelope_v1.schema.json",
  "title": "MACE Evidence Qualification DSSE Envelope V1",
  "description": "DSSE v1.0.2 JSON envelope with the MACE single-Ed25519-signature profile. Standard and URL-safe Base64 encodings are accepted; outer keyid is optional and unauthenticated; unknown envelope fields are ignored.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "payloadType",
    "payload",
    "signatures"
  ],
  "properties": {
    "payloadType": {
      "const": "application/vnd.in-toto+json"
    },
    "payload": {
      "type": "string",
      "minLength": 4,
      "maxLength": 11184812,
      "pattern": "^[A-Za-z0-9+/_-]+={0,2}$"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "sig"
        ],
        "properties": {
          "keyid": {
            "type": "string",
            "maxLength": 256
          },
          "sig": {
            "type": "string",
            "minLength": 86,
            "maxLength": 88,
            "pattern": "^[A-Za-z0-9+/_-]{86}(?:==)?$"
          }
        }
      }
    }
  }
}
