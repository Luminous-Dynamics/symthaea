{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/data/schemas/sc_feasibility_gate_v0_1.schema.json",
  "title": "Tri-state superconductivity feasibility and conditional Tc benchmark",
  "description": "Synthetic-only contract for condition-qualified feasibility labels, mandatory unknown abstention, and Tc prediction only on observed superconductors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "fixture_only", "instance_id", "records", "predictions", "claim_ceiling"],
  "properties": {
    "contract": { "const": "SC-FEASIBILITY-GATE-0.1" },
    "fixture_only": { "const": true },
    "instance_id": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id", "material_id", "family_id", "source_id", "publication_date",
          "label_state", "condition_context", "observed_tc_k"
        ],
        "properties": {
          "record_id": { "type": "string", "minLength": 1 },
          "material_id": { "type": "string", "minLength": 1 },
          "family_id": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 },
          "publication_date": { "type": "string", "format": "date" },
          "label_state": {
            "enum": [
              "observed_superconducting",
              "observed_non_superconducting_under_conditions",
              "unknown_or_not_reported"
            ]
          },
          "condition_context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pressure_gpa", "measurement_temperature_range_k", "sample_form",
              "measurement_method", "transition_criterion", "evidence_scope", "scope_description"
            ],
            "properties": {
              "pressure_gpa": { "type": ["number", "null"], "minimum": 0 },
              "measurement_temperature_range_k": {
                "type": "array", "minItems": 2, "maxItems": 2,
                "items": { "type": "number", "minimum": 0 }
              },
              "sample_form": {
                "enum": ["bulk_crystal", "thin_film", "powder", "wire_or_tape", "unknown"]
              },
              "measurement_method": { "type": "string", "minLength": 1 },
              "transition_criterion": {
                "enum": [
                  "bulk_thermodynamic", "zero_resistance", "diamagnetic_onset",
                  "resistive_onset", "none", "unknown"
                ]
              },
              "evidence_scope": {
                "enum": ["targeted_experiment", "targeted_literature_review", "unknown_or_not_reported"]
              },
              "scope_description": { "type": "string", "minLength": 1 }
            }
          },
          "observed_tc_k": { "type": ["number", "null"], "exclusiveMinimum": 0 }
        }
      }
    },
    "predictions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id", "feasibility_abstained", "p_superconducting",
          "conditional_tc_pred_k", "tc_lower_k", "tc_upper_k"
        ],
        "properties": {
          "record_id": { "type": "string", "minLength": 1 },
          "feasibility_abstained": { "type": "boolean" },
          "p_superconducting": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "conditional_tc_pred_k": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "tc_lower_k": { "type": ["number", "null"], "minimum": 0 },
          "tc_upper_k": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    },
    "claim_ceiling": {
      "const": "Synthetic feasibility-gate contract only; no external data, superconducting material, Tc, or model performance is established."
    }
  }
}
