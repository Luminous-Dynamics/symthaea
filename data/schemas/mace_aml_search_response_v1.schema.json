{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mace_aml_search_response_v1.schema.json",
  "title": "MACE AML Search response v1",
  "description": "Returns ranked memories only. The Search endpoint must not synthesize a final answer.",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/memory"
      }
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "memory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "mace_aml_add_request_v1.schema.json#/$defs/contentPart"
              }
            }
          ]
        },
        "score": {
          "type": "number"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "content"
      ],
      "additionalProperties": false
    }
  }
}
