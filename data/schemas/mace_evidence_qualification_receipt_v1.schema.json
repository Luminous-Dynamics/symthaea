{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mace_evidence_qualification_receipt_v1.schema.json",
  "title": "MACE Evidence Qualification Receipt V1",
  "description": "Decision-scoped independent evidence qualification receipt. Signature bytes are unsigned octets; schema validation does not verify the signature or trust profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "query_invocation_id",
    "domain_id",
    "subject_scope_sha256",
    "environment_revision_sha256",
    "tool_profile_sha256",
    "query_sha256",
    "candidate_set_sha256",
    "candidate_evidence_ids_sha256",
    "decision_need_sha256",
    "purpose_sha256",
    "qualification_policy_sha256",
    "lifecycle_snapshot_sha256",
    "verifier_profile_sha256",
    "key_id",
    "issued_at_unix",
    "expires_at_unix",
    "entries",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "mace_evidence_qualification_receipt_v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "query_invocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "domain_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject_scope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_revision_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tool_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "query_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_evidence_ids_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision_need_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "purpose_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qualification_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lifecycle_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verifier_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issued_at_unix": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at_unix": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "disposition",
          "basis_receipt_sha256"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "disposition": {
            "enum": [
              "admissible",
              "rejected",
              "indeterminate"
            ]
          },
          "basis_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "signature": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  }
}
