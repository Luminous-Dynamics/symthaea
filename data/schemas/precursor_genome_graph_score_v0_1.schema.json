{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/data/schemas/precursor_genome_graph_score_v0_1.schema.json",
  "title": "Precursor pair-graph cold-start prediction score contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "benchmark_id", "fixture_only", "cohort", "models", "claim_ceiling"],
  "properties": {
    "contract": {"const": "SC-PRECURSOR-GENOME-GRAPH-SCORE-0.1"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "fixture_only": {"const": true},
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "source_snapshot_sha256", "graph_receipt_sha256", "records"],
      "properties": {
        "nodes": {"type": "array", "minItems": 3, "maxItems": 46, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_snapshot_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "graph_receipt_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "records": {
          "type": "array",
          "minItems": 3,
          "maxItems": 1035,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["record_id", "sample_id", "precursor_a", "precursor_b", "category", "cohort_state", "label"],
            "properties": {
              "record_id": {"type": "string", "minLength": 1},
              "sample_id": {"type": "string", "minLength": 1},
              "precursor_a": {"type": "string", "minLength": 1},
              "precursor_b": {"type": "string", "minLength": 1},
              "category": {"enum": ["transformed", "unreacted", "completely_reacted", "partially_reacted", "unclassified"]},
              "cohort_state": {"enum": ["included", "physical_failure_excluded", "poor_refinement_excluded"]},
              "label": {"type": ["integer", "null"], "enum": [0, 1, null]},
              "exclusion_reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_id", "model_artifact_sha256", "decision_threshold", "lopo_folds", "double_node_folds"],
        "properties": {
          "model_id": {"type": "string", "minLength": 1},
          "model_artifact_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "decision_threshold": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
          "lopo_folds": {"type": "array", "minItems": 3, "maxItems": 46, "items": {"$ref": "#/$defs/fold"}},
          "double_node_folds": {"type": "array", "minItems": 3, "maxItems": 1035, "items": {"$ref": "#/$defs/fold"}}
        }
      }
    },
    "claim_ceiling": {"const": "Synthetic cold-start graph scoring contract only. No real model performance, synthesis recommendation, phase yield, or material discovery is established."}
  },
  "$defs": {
    "fold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fold_id", "heldout_precursors", "training_precursors", "training_record_count", "predictions"],
      "properties": {
        "fold_id": {"type": "string", "minLength": 1},
        "heldout_precursors": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "training_precursors": {"type": "array", "minItems": 1, "maxItems": 45, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "training_record_count": {"type": "integer", "minimum": 0},
        "predictions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 89,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["record_id", "probability"],
            "properties": {
              "record_id": {"type": "string", "minLength": 1},
              "probability": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    }
  }
}
