{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mace_evidence_qualification_statement_v1.schema.json",
  "title": "MACE Evidence Qualification in-toto Statement V1",
  "description": "The DSSE-signed in-toto Statement v1 payload. in-toto extension fields are ignored; the MACE v1 predicate itself is closed and version-specific.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^urn:luminous:mace:candidate-set:v1:[0-9a-f]{64}$"
          },
          "digest": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "sha256"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "predicateType": {
      "const": "https://luminousdynamics.io/attestations/mace/evidence-qualification/v1"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "query_invocation_id",
        "domain_id",
        "subject_scope_sha256",
        "environment_revision_sha256",
        "tool_profile_sha256",
        "query_sha256",
        "candidate_set_sha256",
        "candidate_evidence_ids_sha256",
        "decision_need_sha256",
        "purpose_sha256",
        "qualification_policy_sha256",
        "lifecycle_snapshot_sha256",
        "verifier_profile_sha256",
        "key_id",
        "issued_at_unix",
        "expires_at_unix",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "const": "mace_evidence_qualification_receipt_v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "query_invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "domain_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subject_scope_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_revision_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tool_profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "query_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_evidence_ids_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision_need_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "purpose_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "qualification_policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lifecycle_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verifier_profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "issued_at_unix": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at_unix": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "disposition",
              "basis_receipt_sha256"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "disposition": {
                "enum": [
                  "admissible",
                  "rejected",
                  "indeterminate"
                ]
              },
              "basis_receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
