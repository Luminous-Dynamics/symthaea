{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/data/schemas/mace_onpolicy_analysis_report_v1.schema.json",
  "title": "MACE On-Policy Analysis Receipt v1",
  "description": "Evaluator-owned, digest-bound analysis output for stratified profile-randomized memory-policy experiments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "estimator",
    "run_manifest_digest",
    "assignments_digest",
    "task_schedule_digest",
    "outcomes_digest",
    "report"
  ],
  "properties": {
    "schema_version": {
      "const": "mace_onpolicy_analysis_report_v1"
    },
    "estimator": {
      "const": "stratified_profile_mean_wald_v1"
    },
    "run_manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assignments_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_schedule_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcomes_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "treatment",
        "utility_effect",
        "strata",
        "hard_gates_passed",
        "confirmatory_cluster_floor_met"
      ],
      "properties": {
        "control": {
          "$ref": "#/$defs/arm_summary"
        },
        "treatment": {
          "$ref": "#/$defs/arm_summary"
        },
        "utility_effect": {
          "$ref": "#/$defs/effect_estimate"
        },
        "strata": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stratum_effect"
          }
        },
        "hard_gates_passed": {
          "type": "boolean"
        },
        "confirmatory_cluster_floor_met": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "arm_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_clusters",
        "episodes",
        "mean_utility",
        "task_success_rate",
        "mean_questions_per_episode",
        "mean_all_in_cost_per_episode",
        "user_refusal_rate",
        "privacy_violations",
        "unauthorized_actions"
      ],
      "properties": {
        "profile_clusters": {
          "type": "integer",
          "minimum": 2
        },
        "episodes": {
          "type": "integer",
          "minimum": 1
        },
        "mean_utility": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "task_success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_questions_per_episode": {
          "type": "number",
          "minimum": 0
        },
        "mean_all_in_cost_per_episode": {
          "type": "number",
          "minimum": 0
        },
        "user_refusal_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "privacy_violations": {
          "type": "integer",
          "minimum": 0
        },
        "unauthorized_actions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "effect_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treatment_minus_control",
        "standard_error",
        "ci95_lower",
        "ci95_upper",
        "control_profiles",
        "treatment_profiles",
        "confirmatory_cluster_floor_met"
      ],
      "properties": {
        "treatment_minus_control": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "standard_error": {
          "type": "number",
          "minimum": 0
        },
        "ci95_lower": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "ci95_upper": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "control_profiles": {
          "type": "integer",
          "minimum": 2
        },
        "treatment_profiles": {
          "type": "integer",
          "minimum": 2
        },
        "confirmatory_cluster_floor_met": {
          "type": "boolean"
        }
      }
    },
    "stratum_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stratum",
        "control_profiles",
        "treatment_profiles",
        "control_mean_utility",
        "treatment_mean_utility",
        "treatment_minus_control",
        "standard_error",
        "ci95_lower",
        "ci95_upper"
      ],
      "properties": {
        "stratum": {
          "type": "string",
          "minLength": 1
        },
        "control_profiles": {
          "type": "integer",
          "minimum": 2
        },
        "treatment_profiles": {
          "type": "integer",
          "minimum": 2
        },
        "control_mean_utility": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "treatment_mean_utility": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "treatment_minus_control": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "standard_error": {
          "type": "number",
          "minimum": 0
        },
        "ci95_lower": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "ci95_upper": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    }
  }
}
