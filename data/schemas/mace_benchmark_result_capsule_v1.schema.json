{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mace_benchmark_result_capsule_v1.schema.json",
  "title": "MACE Benchmark Result Evidence Capsule V1",
  "description": "Reproducible benchmark run manifest. It records exact evaluation inputs, denominators, safety counts, costs, uncertainty and verification level; it does not itself attest to their truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "run_status",
    "benchmark",
    "candidate",
    "model",
    "environment",
    "run_control",
    "population",
    "metrics",
    "safety_counts",
    "resource_usage",
    "comparison",
    "verification",
    "claim_status"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "run_status": {
      "enum": [
        "planned",
        "executed",
        "officially_scored",
        "independently_replayed",
        "field_validated"
      ]
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_id",
        "track_id",
        "release",
        "harness_commit_sha",
        "harness_sha256",
        "dataset_split_sha256",
        "grader_sha256",
        "rights_manifest_sha256"
      ],
      "properties": {
        "benchmark_id": {
          "$ref": "#/$defs/id"
        },
        "track_id": {
          "$ref": "#/$defs/id"
        },
        "release": {
          "$ref": "#/$defs/id"
        },
        "harness_commit_sha": {
          "oneOf": [
            {
              "$ref": "#/$defs/gitSha"
            },
            {
              "type": "null"
            }
          ]
        },
        "harness_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataset_split_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "grader_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "rights_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_full_name",
        "commit_sha",
        "configuration_sha256",
        "build_sha256",
        "prompt_template_sha256",
        "tool_manifest_sha256"
      ],
      "properties": {
        "repository_full_name": {
          "$ref": "#/$defs/id"
        },
        "commit_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "build_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_template_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_manifest_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "model_version",
        "model_artifact_sha256",
        "sampling_seed",
        "temperature_milli",
        "maximum_output_tokens"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/id"
        },
        "model_id": {
          "$ref": "#/$defs/id"
        },
        "model_version": {
          "$ref": "#/$defs/id"
        },
        "model_artifact_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "sampling_seed": {
          "type": "integer",
          "minimum": 0
        },
        "temperature_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "maximum_output_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "cpu",
        "gpu",
        "container_image_sha256",
        "runtime_manifest_sha256"
      ],
      "properties": {
        "os": {
          "$ref": "#/$defs/id"
        },
        "architecture": {
          "$ref": "#/$defs/id"
        },
        "cpu": {
          "$ref": "#/$defs/id"
        },
        "gpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "container_image_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "run_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at",
        "task_order_sha256",
        "matched_group_id",
        "repeat_index"
      ],
      "properties": {
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "task_order_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "matched_group_id": {
          "$ref": "#/$defs/id"
        },
        "repeat_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_tasks",
        "attempted_tasks",
        "completed_tasks",
        "timeouts",
        "invalid_tasks",
        "abstentions",
        "scored_denominator",
        "task_ids_sha256",
        "scenario_cluster_key"
      ],
      "properties": {
        "planned_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "attempted_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "completed_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "timeouts": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "abstentions": {
          "type": "integer",
          "minimum": 0
        },
        "scored_denominator": {
          "type": "integer",
          "minimum": 0
        },
        "task_ids_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scenario_cluster_key": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "safety_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "false_accepts",
        "false_rejects",
        "unsafe_actions",
        "hard_constraint_violations",
        "cross_scope_leaks",
        "stale_evidence_uses",
        "rights_violations"
      ],
      "properties": {
        "false_accepts": {
          "type": "integer",
          "minimum": 0
        },
        "false_rejects": {
          "type": "integer",
          "minimum": 0
        },
        "unsafe_actions": {
          "type": "integer",
          "minimum": 0
        },
        "hard_constraint_violations": {
          "type": "integer",
          "minimum": 0
        },
        "cross_scope_leaks": {
          "type": "integer",
          "minimum": 0
        },
        "stale_evidence_uses": {
          "type": "integer",
          "minimum": 0
        },
        "rights_violations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "inspected_bytes",
        "latency_p50_ns",
        "latency_p95_ns",
        "latency_p99_ns",
        "monetary_cost_microunits"
      ],
      "properties": {
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "inspected_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "latency_p50_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latency_p95_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latency_p99_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "monetary_cost_microunits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "comparison": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "baseline_run_ids",
        "paired_task_ids_sha256",
        "statistical_method",
        "confidence_level_basis_points",
        "ci_low_numerator",
        "ci_high_numerator",
        "ci_denominator",
        "multiple_comparison_correction"
      ],
      "properties": {
        "baseline_run_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "paired_task_ids_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "statistical_method": {
          "$ref": "#/$defs/id"
        },
        "confidence_level_basis_points": {
          "type": "integer",
          "minimum": 5000,
          "maximum": 9999
        },
        "ci_low_numerator": {
          "type": "integer"
        },
        "ci_high_numerator": {
          "type": "integer"
        },
        "ci_denominator": {
          "type": "integer",
          "minimum": 1
        },
        "multiple_comparison_correction": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "verifier_id",
        "raw_run_receipt_sha256",
        "evaluator_output_sha256",
        "independent_replay_run_id"
      ],
      "properties": {
        "level": {
          "enum": [
            "self_reported",
            "locally_replayed",
            "official_evaluator",
            "independently_replayed",
            "field_audited"
          ]
        },
        "verifier_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_run_receipt_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluator_output_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "independent_replay_run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claim_status": {
      "enum": [
        "none",
        "exploratory",
        "matched_comparison",
        "official_leaderboard",
        "third_party_replicated",
        "field_validated"
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "statistic",
        "unit",
        "higher_is_better",
        "numerator",
        "denominator",
        "decimal_scale"
      ],
      "properties": {
        "metric_id": {
          "$ref": "#/$defs/id"
        },
        "statistic": {
          "enum": [
            "count",
            "rate",
            "mean",
            "median",
            "p50",
            "p95",
            "p99",
            "paired_delta",
            "worst_case"
          ]
        },
        "unit": {
          "$ref": "#/$defs/id"
        },
        "higher_is_better": {
          "type": "boolean"
        },
        "numerator": {
          "type": "integer"
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        },
        "decimal_scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run_status": {
            "enum": [
              "executed",
              "officially_scored",
              "independently_replayed",
              "field_validated"
            ]
          }
        },
        "required": [
          "run_status"
        ]
      },
      "then": {
        "properties": {
          "run_control": {
            "properties": {
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "finished_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "population": {
            "properties": {
              "attempted_tasks": {
                "minimum": 1
              },
              "scored_denominator": {
                "minimum": 1
              }
            }
          },
          "metrics": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
