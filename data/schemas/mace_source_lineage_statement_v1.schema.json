{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mace_source_lineage_statement_v1.schema.json",
  "title": "MACE Source Lineage in-toto Statement V1",
  "description": "DSSE payload statement for one independently resolved source-root family.",
  "type": "object",
  "additionalProperties": true,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": {
          "name": { "type": "string", "pattern": "^urn:luminous:mace:source-root-family:v1:[0-9a-f]{64}$" },
          "digest": {
            "type": "object",
            "required": ["sha256"],
            "properties": {
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "predicateType": {
      "const": "https://luminousdynamics.io/attestations/mace/source-lineage/v1"
    },
    "predicate": { "$ref": "mace_source_lineage_receipt_v1.schema.json" }
  }
}
