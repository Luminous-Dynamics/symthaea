{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/superconductivity_finite_q_lattice_v0_1.schema.json",
  "title": "Superconductivity finite-Q lattice GL fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "fixture_only",
    "instance_id",
    "model",
    "lattice",
    "modes"
  ],
  "properties": {
    "contract": {
      "const": "SC-FINITE-Q-LATTICE-0.1"
    },
    "fixture_only": {
      "const": true
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "energy_unit",
        "order_parameter_unit",
        "alpha",
        "beta",
        "gradient_coupling",
        "link_convention",
        "momentum_convention"
      ],
      "properties": {
        "kind": {
          "const": "static_commensurate_finite_q_lattice_gl"
        },
        "energy_unit": {
          "const": "dimensionless_lattice_energy"
        },
        "order_parameter_unit": {
          "const": "dimensionless"
        },
        "alpha": {
          "type": "number"
        },
        "beta": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gradient_coupling": {
          "type": "number",
          "minimum": 0
        },
        "link_convention": {
          "const": "delta_source_minus_exp_iA_delta_target"
        },
        "momentum_convention": {
          "const": "q_index_integer_mod_ring_length"
        }
      }
    },
    "lattice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "length",
        "boundary_condition",
        "site_ids",
        "links"
      ],
      "properties": {
        "dimension": {
          "const": 1
        },
        "length": {
          "type": "integer",
          "minimum": 4,
          "maximum": 256
        },
        "boundary_condition": {
          "const": "periodic"
        },
        "site_ids": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "links": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "link_id",
              "source_index",
              "target_index",
              "gauge_phase_rad"
            ],
            "properties": {
              "link_id": {
                "type": "string",
                "minLength": 1
              },
              "source_index": {
                "type": "integer",
                "minimum": 0
              },
              "target_index": {
                "type": "integer",
                "minimum": 0
              },
              "gauge_phase_rad": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode_id",
          "symmetry_label",
          "q_index",
          "envelope"
        ],
        "properties": {
          "mode_id": {
            "type": "string",
            "minLength": 1
          },
          "symmetry_label": {
            "type": "string",
            "minLength": 1
          },
          "q_index": {
            "type": "integer",
            "minimum": 0
          },
          "envelope": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "site_index",
                "real",
                "imag"
              ],
              "properties": {
                "site_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "real": {
                  "type": "number"
                },
                "imag": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
