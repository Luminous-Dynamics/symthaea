{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/data/schemas/superconductivity_onset_prediction_v0_1.schema.json",
  "title": "Evidence-qualified reaction-onset prediction evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "benchmark_id", "fixture_only", "temperature_unit", "source_reference", "pairs", "models", "claim_ceiling"],
  "properties": {
    "contract": {"const": "SC-ONSET-PREDICTION-AUDIT-0.1"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "fixture_only": {"const": true},
    "temperature_unit": {"const": "kelvin"},
    "source_reference": {"type": "string", "minLength": 1},
    "pairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pair_id", "precursor_ids", "evidence_kind", "lower_bound_k", "upper_bound_k", "exact_onset_k", "evidence_ids", "raw_data_sha256"],
        "properties": {
          "pair_id": {"type": "string", "minLength": 1},
          "precursor_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_kind": {"enum": ["left_censored", "right_censored", "interval_censored", "exact"]},
          "lower_bound_k": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "upper_bound_k": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "exact_onset_k": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "raw_data_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_id", "model_artifact_sha256", "uncertainty_method", "training_pair_ids", "predictions"],
        "properties": {
          "model_id": {"type": "string", "minLength": 1},
          "model_artifact_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "uncertainty_method": {"type": "string", "minLength": 1},
          "training_pair_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "predictions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pair_id", "median_onset_k", "log_sigma"],
              "properties": {
                "pair_id": {"type": "string", "minLength": 1},
                "median_onset_k": {"type": "number", "exclusiveMinimum": 0},
                "log_sigma": {"type": "number", "exclusiveMinimum": 0, "maximum": 2}
              }
            }
          }
        }
      }
    },
    "claim_ceiling": {"const": "Synthetic onset-evaluation plumbing only; no real reaction onset, model accuracy, phase yield, material synthesizability or laboratory outcome is established."}
  }
}
