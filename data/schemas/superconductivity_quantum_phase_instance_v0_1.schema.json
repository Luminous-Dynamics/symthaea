{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/data/schemas/superconductivity_quantum_phase_instance_v0_1.schema.json",
  "title": "Superconductivity Quantum Phase Model Instance",
  "description": "Condition-bound input for a generic compact quantum-rotor / Josephson-network model. A valid input is not a solved state or material observation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "instance_id",
    "fixture_only",
    "model",
    "graph",
    "charging",
    "simulation",
    "bath",
    "external_flux",
    "source_references",
    "claim_ceiling"
  ],
  "properties": {
    "contract": {
      "const": "SC-QUANTUM-PHASE-0.1"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_only": {
      "type": "boolean"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "equation_id",
        "hbar_convention",
        "kB_convention",
        "energy_unit",
        "temperature_unit",
        "charge_convention",
        "phase_compactification",
        "pair_charge_convention"
      ],
      "properties": {
        "kind": {
          "enum": [
            "compact_quantum_rotor",
            "source_reproduction"
          ]
        },
        "equation_id": {
          "type": "string",
          "minLength": 1
        },
        "hbar_convention": {
          "const": "hbar_equals_1"
        },
        "kB_convention": {
          "const": "kB_equals_1"
        },
        "energy_unit": {
          "const": "coupling_energy_units"
        },
        "temperature_unit": {
          "const": "coupling_energy_units"
        },
        "charge_convention": {
          "const": "integer_cooper_pair_number"
        },
        "phase_compactification": {
          "const": "2pi"
        },
        "source_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        },
        "pair_charge_convention": {
          "const": "2e_equals_1"
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spatial_dimension",
        "embedding",
        "topology_family",
        "nodes",
        "edges",
        "box_lengths",
        "periodic_axes"
      ],
      "properties": {
        "spatial_dimension": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "embedding": {
          "const": "physical_coordinates"
        },
        "topology_family": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "position"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "edge_id",
              "source",
              "target",
              "josephson_energy",
              "gauge_link_phase_rad",
              "physical_edge_length",
              "periodic_image_shift"
            ],
            "properties": {
              "edge_id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "josephson_energy": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "gauge_link_phase_rad": {
                "type": "number"
              },
              "physical_edge_length": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "periodic_image_shift": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "box_lengths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "periodic_axes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "uniqueItems": true
        }
      }
    },
    "charging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_kind",
        "energy_unit",
        "offset_charges"
      ],
      "properties": {
        "matrix_kind": {
          "enum": [
            "dense_symmetric_positive_definite",
            "diagonal_positive",
            "diagonal_scalar"
          ]
        },
        "energy_unit": {
          "const": "coupling_energy_units"
        },
        "matrix_u_ij": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "offset_charges": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "diagonal_value": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "temperature",
        "temperature_unit",
        "imaginary_time_slices",
        "random_seed",
        "representation",
        "imaginary_time_step",
        "charge_basis_cutoff"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "path_integral_quantum_monte_carlo",
            "worldline_quantum_monte_carlo",
            "stochastic_series_expansion"
          ]
        },
        "temperature": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "temperature_unit": {
          "const": "coupling_energy_units"
        },
        "imaginary_time_slices": {
          "type": "integer",
          "minimum": 4
        },
        "random_seed": {
          "type": "integer",
          "minimum": 0
        },
        "representation": {
          "enum": [
            "phase_path_integral",
            "integer_charge_basis"
          ]
        },
        "imaginary_time_step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "charge_basis_cutoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "max_abs_charge_state"
          ],
          "properties": {
            "mode": {
              "enum": [
                "not_applicable",
                "symmetric_integer"
              ]
            },
            "max_abs_charge_state": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 100000
            }
          }
        }
      }
    },
    "bath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "coupling_operator",
        "coupling_strength",
        "low_frequency_exponent",
        "cutoff_energy",
        "spectral_density"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "analytic_power_law",
            "tabulated"
          ]
        },
        "coupling_operator": {
          "enum": [
            "none",
            "phase_difference",
            "node_charge"
          ]
        },
        "coupling_strength": {
          "type": "number",
          "minimum": 0
        },
        "low_frequency_exponent": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "cutoff_energy": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "spectral_density": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "omega",
              "density"
            ],
            "properties": {
              "omega": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "density": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "external_flux": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "total_flux_quanta"
      ],
      "properties": {
        "mode": {
          "enum": [
            "zero",
            "link_phases_declared"
          ]
        },
        "total_flux_quanta": {
          "type": "number"
        }
      }
    },
    "source_references": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "claim_ceiling": {
      "const": "Model input only; not a solved quantum state, measured Tc, conductivity result, or experimental material observation."
    }
  }
}
