{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/research/sc-aniso-3d-v0.1/data/schemas/sc_rebco_local_tape_frame_v0_1.schema.json",
  "title": "REBCO Local Tape Frame and Field Vector Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "claim_ceiling",
    "frame_convention",
    "stations"
  ],
  "properties": {
    "schema_version": {
      "const": "sc-rebco-local-tape-frame.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "local-frame-transform-and-vector-geometry-semantics-only"
    },
    "frame_convention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_semantics",
        "basis_axis_order",
        "handedness",
        "theta_convention",
        "phi_convention",
        "angle_unit"
      ],
      "properties": {
        "matrix_semantics": {
          "const": "columns_are_local_axes_expressed_in_global_coordinates"
        },
        "basis_axis_order": {
          "const": [
            "longitudinal",
            "width",
            "normal"
          ]
        },
        "handedness": {
          "const": "right_handed"
        },
        "theta_convention": {
          "const": "angle_from_local_tape_normal"
        },
        "phi_convention": {
          "const": "azimuth_in_tape_plane_from_longitudinal_toward_width"
        },
        "angle_unit": {
          "const": "radian"
        }
      }
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "station_id",
          "reel_id",
          "segment_id",
          "coordinate_frame_id",
          "longitudinal_position_m",
          "global_field_vector_t",
          "local_to_global_rotation_matrix",
          "transform_uncertainty_rad",
          "source_artifact_sha256"
        ],
        "properties": {
          "station_id": {
            "type": "string",
            "minLength": 1
          },
          "reel_id": {
            "type": "string",
            "minLength": 1
          },
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "coordinate_frame_id": {
            "type": "string",
            "minLength": 1
          },
          "longitudinal_position_m": {
            "type": "number",
            "minimum": 0
          },
          "global_field_vector_t": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "local_to_global_rotation_matrix": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          },
          "transform_uncertainty_rad": {
            "type": "number",
            "minimum": 0
          },
          "source_artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
