{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/data/schemas/memory_evidence_event_v1.schema.json",
  "title": "Memory Evidence Event v1",
  "description": "Bitemporal, rights-scoped event envelope for existing Symthaea semantic and episodic memory tiers. Cross-event and lifecycle semantics are additionally enforced by the Rust validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "kind",
    "claim_key",
    "source",
    "payload_digest",
    "issuer_id",
    "authority_scopes",
    "rights",
    "observed_at_millis",
    "known_at_millis",
    "valid_from_millis",
    "valid_until_millis",
    "parents",
    "targets",
    "consent_id"
  ],
  "properties": {
    "schema_version": {
      "const": "memory_evidence_event_v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "type": "string",
      "enum": [
        "assertion",
        "correction",
        "retraction",
        "consent_granted",
        "consent_revoked",
        "erasure_tombstone"
      ]
    },
    "claim_key": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "source": {
      "oneOf": [
        {"$ref": "#/$defs/source_commitment"},
        {"type": "null"}
      ]
    },
    "payload_digest": {
      "oneOf": [
        {"$ref": "#/$defs/content_digest"},
        {"type": "null"}
      ]
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rights": {
      "$ref": "#/$defs/memory_rights"
    },
    "observed_at_millis": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "known_at_millis": {
      "type": "integer",
      "minimum": 0
    },
    "valid_from_millis": {
      "type": "integer",
      "minimum": 0
    },
    "valid_until_millis": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "parents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "consent_id": {
      "type": ["string", "null"],
      "minLength": 1
    }
  },
  "$defs": {
    "content_digest": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "source_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "source_digest"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "source_digest": {
          "$ref": "#/$defs/content_digest"
        }
      }
    },
    "memory_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_purposes",
        "consent_required",
        "consent_grant_event_id",
        "retention_until_millis"
      ],
      "properties": {
        "allowed_purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consent_required": {
          "type": "boolean"
        },
        "consent_grant_event_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "retention_until_millis": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    }
  }
}
