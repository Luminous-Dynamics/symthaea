{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/data/schemas/mace_evidence_qualification_request_v1.schema.json",
  "title": "MACE Independent Evidence Qualification Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_batch_jsonl",
    "binding",
    "request_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "mace_evidence_qualification_request_v1"
    },
    "candidate_batch_jsonl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16777216,
      "description": "Canonical, complete CandidateEvidenceBatchV1 JSONL. The issuer must parse and independently recompute the candidate-set commitment and resolve payload/source evidence."
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "query_invocation_id",
        "domain_id",
        "subject_scope_sha256",
        "environment_revision_sha256",
        "tool_profile_sha256",
        "query_sha256",
        "candidate_set_sha256",
        "candidate_evidence_ids",
        "decision_need_sha256",
        "purpose_sha256",
        "qualification_policy_sha256",
        "lifecycle_snapshot_sha256",
        "verifier_profile_sha256"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "query_invocation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "domain_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "subject_scope_sha256": { "$ref": "#/$defs/sha256" },
        "environment_revision_sha256": { "$ref": "#/$defs/sha256" },
        "tool_profile_sha256": { "$ref": "#/$defs/sha256" },
        "query_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_set_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "description": "Must be in strict ascending lexical order. JSON Schema uniqueItems does not enforce ordering; the protocol validator must."
        },
        "decision_need_sha256": { "$ref": "#/$defs/sha256" },
        "purpose_sha256": { "$ref": "#/$defs/sha256" },
        "qualification_policy_sha256": { "$ref": "#/$defs/sha256" },
        "lifecycle_snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "verifier_profile_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "Domain-separated digest over the schema version, exact canonical candidate JSONL bytes, and every binding field. It is an idempotency/request identity, not an issuer signature."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
