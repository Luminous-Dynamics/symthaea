                    },
                    "temperature_c": {
                      "type": "number"
                    },
                    "stored_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "applied_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "elapsed_minutes_at_application": {
                  "type": "number",
                  "minimum": 0
                },
                "chemistry_observations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "quantity_id",
                      "status",
                      "method_id"
                    ],
                    "properties": {
                      "quantity_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "enum": [
                          "MEASURED",
                          "BELOW_DETECTION_LIMIT",
                          "NOT_MEASURED",
                          "NOT_APPLICABLE",
                          "UNKNOWN",
                          "WITHHELD"
                        ]
                      },
                      "value": {
                        "type": "number"
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1
                      },
                      "detection_limit": {
                        "type": "number"
                      },
                      "method_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "calibration": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "enum": [
                              "IN_DATE",
                              "EXPIRED",
                              "UNKNOWN",
                              "NOT_REQUIRED",
                              "NOT_APPLICABLE"
                            ]
                          },
                          "calibration_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "valid_from": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "valid_until": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "certificate_sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        }
                      },
                      "uncertainty": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "enum": [
                              "QUANTIFIED",
                              "NOT_QUANTIFIED"
                            ]
                          },
                          "value": {
                            "type": "number",
                            "minimum": 0
                          },
                          "unit": {
                            "type": "string",
                            "minLength": 1
                          },
                          "coverage_factor": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "confidence_level": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 1
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "observed_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "raw_data_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "sampling_location_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "notes": {
                        "type": "string"
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "status": {
                              "const": "MEASURED"
                            }
                          },
                          "required": [
                            "status"
                          ]
                        },
                        "then": {
                          "required": [
                            "value",
                            "unit",
                            "calibration",
                            "uncertainty",
                            "observed_at",
                            "raw_data_sha256"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "status": {
                              "const": "BELOW_DETECTION_LIMIT"
                            }
                          },
                          "required": [
                            "status"
                          ]
                        },
                        "then": {
                          "required": [
                            "detection_limit",
                            "unit",
                            "calibration",
                            "observed_at",
                            "raw_data_sha256"
                          ]
                        }
                      }
                    ]
                  }
                }
              }
            },
            "delivery": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "volume_ml",
                "contact_duration_seconds"
              ],
              "properties": {
                "volume_ml": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "contact_duration_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "delivery_method": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
