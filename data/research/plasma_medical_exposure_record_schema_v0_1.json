                  }
                }
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "raw_data_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "sampling_location_id": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "MEASURED"
