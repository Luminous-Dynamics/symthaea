                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "QUANTIFIED",
                      "NOT_QUANTIFIED"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "coverage_factor": {
                    "type": "number",
