  "metamorphic_controls": [
    {
      "id": "MOMENT-SCALE",
      "rule": "multiplying every dipole moment by alpha multiplies B by alpha"
    },
    {
      "id": "GEOMETRY-SCALE",
      "rule": "scaling every relative position by lambda while keeping moments fixed scales B by lambda^-3"
    },
    {
      "id": "GLOBAL-REVERSAL",
      "rule": "reversing every dipole moment reverses the complete field vector"
    },
    {
      "id": "ROTATION-COVARIANCE",
      "rule": "rotating positions, moments and query point by the same orthogonal rotation rotates B by that rotation"
    },
    {
      "id": "SUPERPOSITION",
      "rule": "the field of a dipole set equals the vector sum of the individual dipole fields"
    },
    {
      "id": "SINGULARITY-REJECTION",
      "rule": "a query point coincident with an ideal point dipole is undefined and must be rejected"
    }
