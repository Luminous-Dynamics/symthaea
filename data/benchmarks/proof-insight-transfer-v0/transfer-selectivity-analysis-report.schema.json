        "compatible_recall_target_met": {
          "type": "boolean"
        },
        "pair_selectivity_gate": {
          "enum": [
            "pair_track_thresholds_met",
            "pair_track_thresholds_not_met"
          ]
        },
        "finite_mutation_suite_gate": {
          "const": "not_evaluated_by_this_analyzer"
        },
        "overall_confirmatory_decision": {
          "const": "not_evaluated_requires_independent_mutation_receipt_and_protocol_audit"
