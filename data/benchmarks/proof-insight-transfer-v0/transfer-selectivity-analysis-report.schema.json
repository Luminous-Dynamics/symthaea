        "compatible_component_floor_met": {
          "type": "boolean"
        },
        "minimum_incompatible_components": {
          "const": 20
        },
        "observed_incompatible_components": {
          "type": "integer",
          "minimum": 0
        },
        "incompatible_component_floor_met": {
          "type": "boolean"
        },
        "minimum_compatible_recall": {
          "const": 0.9
