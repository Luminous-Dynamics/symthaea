{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb.lean-context-manifest.v1.schema.json",
  "title": "PITB Lean-derived support-lattice manifest v1 with local instances",
  "description": "Mechanical dependency and local-instance projection graph from independently verified Lean evidence. The local-context digest covers both ordered declarations and registered local instances.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "target_id",
    "source_evidence_sha256",
    "role_plan_sha256",
    "local_context_sha256",
    "target_statement_sha256",
    "toolchain_sha256",
    "lean_toolchain",
    "mutable_declarations",
    "fixed_declarations",
    "declaration_order",
    "local_instance_fvar_ids",
    "local_instances",
    "local_context_declarations",
    "declaration_dependencies",
    "assigned_value_provenance_dependencies",
    "target_typed_dependency_closure",
    "proof_term_direct_support",
    "proof_term_typed_dependency_closure",
    "proof_term_assigned_value_provenance_closure",
    "interpretation_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.lean-context-manifest.v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "source_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "role_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "local_context_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_statement_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "toolchain_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "mutable_declarations": {
      "$ref": "#/$defs/ids"
    },
    "fixed_declarations": {
      "$ref": "#/$defs/ids"
    },
    "declaration_order": {
      "$ref": "#/$defs/ids"
    },
    "declaration_dependencies": {
      "$ref": "#/$defs/graph"
    },
    "assigned_value_provenance_dependencies": {
      "$ref": "#/$defs/graph"
    },
    "target_typed_dependency_closure": {
      "$ref": "#/$defs/ids"
    },
    "proof_term_direct_support": {
      "$ref": "#/$defs/ids"
    },
    "proof_term_typed_dependency_closure": {
      "$ref": "#/$defs/ids"
    },
    "proof_term_assigned_value_provenance_closure": {
      "$ref": "#/$defs/ids"
    },
    "interpretation_boundary": {
      "type": "string",
      "minLength": 1
    },
    "local_context_declarations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/declaration"
      }
    },
    "local_instances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class_name",
          "fvar_id",
          "type"
        ],
        "properties": {
          "class_name": {
            "type": "string",
            "minLength": 1
          },
          "fvar_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "local_instance_fvar_ids": {
      "$ref": "#/$defs/ids"
    },
    "lean_toolchain": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ids"
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fvar_id",
        "index",
        "user_name",
        "type",
        "type_fvar_ids",
        "type_global_constants",
        "is_let_declaration",
        "is_nondep",
        "is_implementation_detail",
        "transparent_value",
        "transparent_value_fvar_ids",
        "transparent_value_global_constants",
        "nondep_value_provenance",
        "nondep_value_fvar_ids",
        "nondep_value_global_constants",
        "binder_info",
        "is_aux_declaration"
      ],
      "properties": {
        "fvar_id": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "user_name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "type_fvar_ids": {
          "$ref": "#/$defs/ids"
        },
        "type_global_constants": {
          "$ref": "#/$defs/strings"
        },
        "is_let_declaration": {
          "type": "boolean"
        },
        "is_nondep": {
          "type": "boolean"
        },
        "is_implementation_detail": {
          "type": "boolean"
        },
        "transparent_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "transparent_value_fvar_ids": {
          "$ref": "#/$defs/ids"
        },
        "transparent_value_global_constants": {
          "$ref": "#/$defs/strings"
        },
        "nondep_value_provenance": {
          "type": [
            "string",
            "null"
          ]
        },
        "nondep_value_fvar_ids": {
          "$ref": "#/$defs/ids"
        },
        "nondep_value_global_constants": {
          "$ref": "#/$defs/strings"
        },
        "binder_info": {
          "enum": [
            "Lean.BinderInfo.default",
            "Lean.BinderInfo.implicit",
            "Lean.BinderInfo.strictImplicit",
            "Lean.BinderInfo.instImplicit"
          ]
        },
        "is_aux_declaration": {
          "type": "boolean"
        }
      }
    }
  }
}
