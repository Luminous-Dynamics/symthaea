{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb.lean-context-manifest.v1.schema.json",
  "title": "PITB Lean-derived support-lattice manifest v1 with local instances",
  "description": "Mechanical dependency graph from verified Lean evidence, with typing prerequisites separated from assigned-value provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "target_id",
    "source_evidence_sha256",
    "role_plan_sha256",
    "local_context_sha256",
    "target_statement_sha256",
    "toolchain_sha256",
    "mutable_declarations",
    "fixed_declarations",
    "declaration_order",
    "local_instance_fvar_ids",
    "local_instances",
    "local_context_declarations",
    "declaration_dependencies",
    "assigned_value_provenance_dependencies",
    "target_typed_dependency_closure",
    "proof_term_direct_support",
    "proof_term_typed_dependency_closure",
    "proof_term_assigned_value_provenance_closure",
    "interpretation_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.lean-context-manifest.v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "source_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "role_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "local_context_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_statement_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "toolchain_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "mutable_declarations": {
      "$ref": "#/$defs/ids"
    },
    "fixed_declarations": {
      "$ref": "#/$defs/ids"
    },
    "declaration_order": {
      "$ref": "#/$defs/ids"
    },
    "declaration_dependencies": {
      "$ref": "#/$defs/graph"
    },
    "assigned_value_provenance_dependencies": {
      "$ref": "#/$defs/graph"
    },
    "target_typed_dependency_closure": {
      "$ref": "#/$defs/ids"
    },
    "proof_term_direct_support": {
      "$ref": "#/$defs/ids"
    },
    "proof_term_typed_dependency_closure": {
      "$ref": "#/$defs/ids"
    },
    "proof_term_assigned_value_provenance_closure": {
      "$ref": "#/$defs/ids"
    },
    "interpretation_boundary": {
      "type": "string",
      "minLength": 1
    },
    "local_context_declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fvar_id",
          "index",
          "user_name",
          "type",
          "binder_info"
        ],
        "properties": {
          "fvar_id": {
            "type": "string",
            "minLength": 1
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "user_name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "binder_info": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "local_instances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class_name",
          "fvar_id",
          "type"
        ],
        "properties": {
          "class_name": {
            "type": "string",
            "minLength": 1
          },
          "fvar_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "local_instance_fvar_ids": {
      "$ref": "#/$defs/ids"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ids"
      }
    }
  }
}
