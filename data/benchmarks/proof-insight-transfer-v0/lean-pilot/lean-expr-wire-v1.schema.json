{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb/lean-expr-wire-v1.schema.json",
  "title": "PITB Lean structural expression evidence v1",
  "description": "Environment-scoped structural Lean Expr and LocalContext wire format. It is not a definitional-equality normal form or a kernel receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "environment",
    "goal",
    "target",
    "local_context",
    "digests"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.lean-expr-wire.v1"
    },
    "evidence_class": {
      "enum": [
        "synthetic_contract_fixture",
        "lean_capture"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lean_toolchain",
        "lean_version",
        "lean_binary_sha256",
        "lean_runtime_manifest_sha256",
        "imported_olean_manifest_sha256",
        "task_id",
        "source_repository",
        "source_path",
        "source_file_sha256",
        "source_commit",
        "lean_toolchain_file_sha256",
        "lakefile_sha256",
        "lake_manifest_sha256",
        "root_module_sha256",
        "context_exporter_source_sha256",
        "clean_checkout",
        "serializer_id",
        "lean_runtime_artifacts",
        "imported_olean_artifacts"
      ],
      "properties": {
        "lean_toolchain": {
          "type": "string",
          "minLength": 1
        },
        "lean_version": {
          "type": "string",
          "minLength": 1
        },
        "lean_binary_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_repository": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_file_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "lean_toolchain_file_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lakefile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lake_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "root_module_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_exporter_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "clean_checkout": {
          "const": true
        },
        "serializer_id": {
          "const": "pitb.lean-expr-wire.v1/binary-transcript-1"
        },
        "lean_runtime_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the sorted Lean runtime binary/shared-library manifest"
        },
        "imported_olean_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the exact imported OLean artifact manifest"
        },
        "lean_runtime_artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "description": "Path-sorted runtime executable/shared-library artifacts used by the capture process.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "kind",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "lean_executable",
                  "shared_library"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "imported_olean_artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "description": "Module/path-sorted exact transitive OLean files imported by the capture process.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module_name",
              "path",
              "sha256"
            ],
            "properties": {
              "module_name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "target": {
      "$ref": "#/$defs/expr"
    },
    "local_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declarations",
        "local_instances"
      ],
      "properties": {
        "declarations": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/local_decl"
          }
        },
        "local_instances": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/local_instance"
          }
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_sha256",
        "goal_metadata_sha256",
        "target_expr_sha256",
        "context_sha256",
        "proof_state_sha256"
      ],
      "properties": {
        "environment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_expr_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proof_state_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "goal_metadata_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_name",
        "kind",
        "depth_decimal",
        "num_scope_args_decimal",
        "creation_index_decimal"
      ],
      "properties": {
        "user_name": {
          "$ref": "#/$defs/lean_name"
        },
        "kind": {
          "enum": [
            "natural",
            "synthetic",
            "synthetic_opaque"
          ]
        },
        "depth_decimal": {
          "$ref": "#/$defs/decimal"
        },
        "num_scope_args_decimal": {
          "$ref": "#/$defs/decimal"
        },
        "creation_index_decimal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "Diagnostic-only creation order; excluded from structural identity."
        }
      }
    }
  },
  "$defs": {
    "lean_name": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag"
          ],
          "properties": {
            "tag": {
              "const": "anonymous"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "prefix",
            "value"
          ],
          "properties": {
            "tag": {
              "const": "str"
            },
            "prefix": {
              "$ref": "#/$defs/lean_name"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "prefix",
            "value_decimal"
          ],
          "properties": {
            "tag": {
              "const": "num"
            },
            "prefix": {
              "$ref": "#/$defs/lean_name"
            },
            "value_decimal": {
              "$ref": "#/$defs/decimal"
            }
          }
        }
      ]
    },
    "decimal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "level": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag"
          ],
          "properties": {
            "tag": {
              "const": "zero"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "of"
          ],
          "properties": {
            "tag": {
              "const": "succ"
            },
            "of": {
              "$ref": "#/$defs/level"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "left",
            "right"
          ],
          "properties": {
            "tag": {
              "const": "max"
            },
            "left": {
              "$ref": "#/$defs/level"
            },
            "right": {
              "$ref": "#/$defs/level"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "left",
            "right"
          ],
          "properties": {
            "tag": {
              "const": "imax"
            },
            "left": {
              "$ref": "#/$defs/level"
            },
            "right": {
              "$ref": "#/$defs/level"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "name"
          ],
          "properties": {
            "tag": {
              "const": "param"
            },
            "name": {
              "$ref": "#/$defs/lean_name"
            }
          }
        }
      ]
    },
    "binder_info": {
      "enum": [
        "explicit",
        "implicit",
        "strict_implicit",
        "instance_implicit"
      ]
    },
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "index"
          ],
          "properties": {
            "tag": {
              "const": "bvar"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "local_index"
          ],
          "properties": {
            "tag": {
              "const": "fvar"
            },
            "local_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "level"
          ],
          "properties": {
            "tag": {
              "const": "sort"
            },
            "level": {
              "$ref": "#/$defs/level"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "name",
            "levels"
          ],
          "properties": {
            "tag": {
              "const": "const"
            },
            "name": {
              "$ref": "#/$defs/lean_name"
            },
            "levels": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/level"
              },
              "maxItems": 256
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "function",
            "argument"
          ],
          "properties": {
            "tag": {
              "const": "app"
            },
            "function": {
              "$ref": "#/$defs/expr"
            },
            "argument": {
              "$ref": "#/$defs/expr"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "binder_info",
            "domain",
            "body"
          ],
          "properties": {
            "tag": {
              "const": "lam"
            },
            "binder_info": {
              "$ref": "#/$defs/binder_info"
            },
            "domain": {
              "$ref": "#/$defs/expr"
            },
            "body": {
              "$ref": "#/$defs/expr"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "binder_info",
            "domain",
            "body"
          ],
          "properties": {
            "tag": {
              "const": "forall_e"
            },
            "binder_info": {
              "$ref": "#/$defs/binder_info"
            },
            "domain": {
              "$ref": "#/$defs/expr"
            },
            "body": {
              "$ref": "#/$defs/expr"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "domain",
            "value",
            "body",
            "nondep"
          ],
          "properties": {
            "tag": {
              "const": "let_e"
            },
            "domain": {
              "$ref": "#/$defs/expr"
            },
            "value": {
              "$ref": "#/$defs/expr"
            },
            "body": {
              "$ref": "#/$defs/expr"
            },
            "nondep": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "value_decimal"
          ],
          "properties": {
            "tag": {
              "const": "literal_nat"
            },
            "value_decimal": {
              "$ref": "#/$defs/decimal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "value"
          ],
          "properties": {
            "tag": {
              "const": "literal_string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "type_name",
            "field_index",
            "structure"
          ],
          "properties": {
            "tag": {
              "const": "proj"
            },
            "type_name": {
              "$ref": "#/$defs/lean_name"
            },
            "field_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "structure": {
              "$ref": "#/$defs/expr"
            }
          }
        }
      ]
    },
    "local_decl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_index",
        "user_name",
        "binder_info",
        "is_aux_declaration",
        "is_implementation_detail",
        "is_let_declaration",
        "is_nondep",
        "type",
        "transparent_value",
        "nondep_value_provenance"
      ],
      "properties": {
        "local_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "user_name": {
          "type": "string",
          "minLength": 1
        },
        "binder_info": {
          "$ref": "#/$defs/binder_info"
        },
        "is_aux_declaration": {
          "type": "boolean"
        },
        "is_implementation_detail": {
          "type": "boolean"
        },
        "is_let_declaration": {
          "type": "boolean"
        },
        "is_nondep": {
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/expr"
        },
        "transparent_value": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/expr"
            }
          ]
        },
        "nondep_value_provenance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/expr"
            }
          ]
        }
      }
    },
    "local_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_name",
        "local_index"
      ],
      "properties": {
        "class_name": {
          "$ref": "#/$defs/lean_name"
        },
        "local_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
