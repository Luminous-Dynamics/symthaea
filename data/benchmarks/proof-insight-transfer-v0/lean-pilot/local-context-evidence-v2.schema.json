{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb.local-context-evidence.v2.schema.json",
  "title": "PITB Lean local-context, local-instance and proof-support evidence v2",
  "description": "Full ordered local-context snapshot, local instance registry, binder metadata, separate typed dependency and assigned-value provenance closures, plus exact build metadata. Structural validation does not authenticate the Lean process or receipt bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "label",
    "build_metadata",
    "target",
    "local_context",
    "proof_support",
    "interpretation_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.local-context-evidence.v2"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "free_variable_ids",
        "typed_dependency_closure_ids",
        "typed_dependency_closure",
        "global_constants"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "free_variable_ids": {
          "$ref": "#/$defs/ids"
        },
        "typed_dependency_closure_ids": {
          "$ref": "#/$defs/ids"
        },
        "typed_dependency_closure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declaration"
          }
        },
        "global_constants": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "local_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_order",
        "declarations",
        "local_instances"
      ],
      "properties": {
        "declaration_order": {
          "$ref": "#/$defs/ids"
        },
        "declarations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declaration"
          }
        },
        "local_instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/local_instance"
          }
        }
      }
    },
    "proof_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_term",
        "direct_free_variable_ids",
        "direct_declarations",
        "typed_dependency_closure_ids",
        "typed_dependency_closure",
        "typed_dependency_global_constants",
        "assigned_value_provenance_closure_ids",
        "assigned_value_provenance_closure",
        "assigned_value_provenance_global_constants",
        "opaque_value_provenance",
        "proof_term_global_constants"
      ],
      "properties": {
        "proof_term": {
          "type": "string",
          "minLength": 1
        },
        "direct_free_variable_ids": {
          "$ref": "#/$defs/ids"
        },
        "direct_declarations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declaration"
          }
        },
        "typed_dependency_closure_ids": {
          "$ref": "#/$defs/ids"
        },
        "typed_dependency_closure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declaration"
          }
        },
        "typed_dependency_global_constants": {
          "$ref": "#/$defs/strings"
        },
        "assigned_value_provenance_closure_ids": {
          "$ref": "#/$defs/ids"
        },
        "assigned_value_provenance_closure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declaration"
          }
        },
        "assigned_value_provenance_global_constants": {
          "$ref": "#/$defs/strings"
        },
        "opaque_value_provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "declaration_fvar_id",
              "declaration_user_name",
              "assigned_value_fvar_ids",
              "assigned_value_global_constants"
            ],
            "properties": {
              "declaration_fvar_id": {
                "type": "string",
                "minLength": 1
              },
              "declaration_user_name": {
                "type": "string",
                "minLength": 1
              },
              "assigned_value_fvar_ids": {
                "$ref": "#/$defs/ids"
              },
              "assigned_value_global_constants": {
                "$ref": "#/$defs/strings"
              }
            }
          }
        },
        "proof_term_global_constants": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "interpretation_boundary": {
      "type": "string",
      "minLength": 1
    },
    "build_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lean_toolchain",
        "lean_toolchain_file_sha256",
        "lakefile_sha256",
        "root_module_path",
        "root_module_sha256",
        "context_exporter_path",
        "context_exporter_source_sha256"
      ],
      "properties": {
        "lean_toolchain": {
          "type": "string",
          "minLength": 1
        },
        "lean_toolchain_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lakefile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "root_module_path": {
          "const": "PITBCounterfactualPilot.lean"
        },
        "root_module_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "context_exporter_path": {
          "const": "PITBCounterfactualPilot/ContextEvidence.lean"
        },
        "context_exporter_source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fvar_id",
        "index",
        "user_name",
        "type",
        "type_fvar_ids",
        "type_global_constants",
        "is_let_declaration",
        "is_nondep",
        "is_implementation_detail",
        "transparent_value",
        "transparent_value_fvar_ids",
        "transparent_value_global_constants",
        "nondep_value_provenance",
        "nondep_value_fvar_ids",
        "nondep_value_global_constants",
        "binder_info",
        "is_aux_declaration"
      ],
      "properties": {
        "fvar_id": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "user_name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "type_fvar_ids": {
          "$ref": "#/$defs/ids"
        },
        "type_global_constants": {
          "$ref": "#/$defs/strings"
        },
        "is_let_declaration": {
          "type": "boolean"
        },
        "is_nondep": {
          "type": "boolean"
        },
        "is_implementation_detail": {
          "type": "boolean"
        },
        "transparent_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "transparent_value_fvar_ids": {
          "$ref": "#/$defs/ids"
        },
        "transparent_value_global_constants": {
          "$ref": "#/$defs/strings"
        },
        "nondep_value_provenance": {
          "type": [
            "string",
            "null"
          ]
        },
        "nondep_value_fvar_ids": {
          "$ref": "#/$defs/ids"
        },
        "nondep_value_global_constants": {
          "$ref": "#/$defs/strings"
        },
        "binder_info": {
          "enum": [
            "Lean.BinderInfo.default",
            "Lean.BinderInfo.implicit",
            "Lean.BinderInfo.strictImplicit",
            "Lean.BinderInfo.instImplicit"
          ]
        },
        "is_aux_declaration": {
          "type": "boolean"
        }
      }
    },
    "local_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_name",
        "fvar_id",
        "type"
      ],
      "properties": {
        "class_name": {
          "type": "string",
          "minLength": 1
        },
        "fvar_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
