{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb.lean-context-role-plan.v0.schema.json",
  "title": "PITB Lean local-context role assignment v0",
  "description": "Human/reviewer adjudicated fixed-versus-mutable declaration assignment pinned to exact Lean context and target digests. This is not inferred by the exporter or search optimizer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "target_id",
    "expected_local_context_sha256",
    "expected_target_statement_sha256",
    "toolchain_sha256",
    "mutable_fvar_ids",
    "fixed_fvar_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.lean-context-role-plan.v0"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_local_context_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "expected_target_statement_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "toolchain_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "mutable_fvar_ids": {
      "$ref": "#/$defs/ids"
    },
    "fixed_fvar_ids": {
      "$ref": "#/$defs/ids"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
