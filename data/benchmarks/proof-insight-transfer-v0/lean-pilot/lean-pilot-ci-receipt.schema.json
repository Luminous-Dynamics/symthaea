{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/data/benchmarks/proof-insight-transfer-v0/lean-pilot/lean-pilot-ci-receipt.schema.json",
  "title": "PITB Lean Pilot Content-Addressed CI Receipt v0",
  "description": "Strict evidence contract for the pinned Lean pilot build, axiom checks, and the fixed-goal local-context intervention trace. A structurally valid receipt is not a model outcome or a proof of benchmark utility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "commit_sha",
    "workflow_run_id",
    "workflow_run_attempt",
    "toolchain",
    "lean_version",
    "lake_version",
    "source",
    "checked_artifact",
    "build_log_sha256",
    "proof_state_intervention_trace",
    "checks",
    "case_manifest_bindings",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.lean-pilot-ci-receipt.v0"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "commit_sha": {
      "$ref": "#/$defs/commit"
    },
    "workflow_run_id": {
      "type": "integer",
      "minimum": 1
    },
    "workflow_run_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "toolchain": {
      "type": "string",
      "minLength": 1
    },
    "lean_version": {
      "type": "string",
      "minLength": 1
    },
    "lake_version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "case_manifest_path",
        "case_manifest_sha256",
        "lakefile_sha256",
        "toolchain_file_sha256",
        "lake_manifest_sha256",
        "receipt_schema_path",
        "receipt_schema_sha256"
      ],
      "properties": {
        "path": {
          "const": "PITBCounterfactualPilot.lean"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "case_manifest_path": {
          "const": "cases.json"
        },
        "case_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lakefile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "toolchain_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lake_manifest_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_schema_path": {
          "const": "lean-pilot-ci-receipt.schema.json"
        },
        "receipt_schema_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "checked_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "build_log_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "proof_state_intervention_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "base_snapshot_sha256",
        "variant_snapshot_sha256",
        "base_local_context_sha256",
        "variant_local_context_sha256",
        "goal_type_sha256",
        "goal_type_preserved",
        "required_declaration_present_before",
        "required_declaration_absent_after",
        "alternate_route_hypothesis_present_after",
        "trace_log_sha256",
        "case_id",
        "case_manifest_sha256",
        "target_statement_fragment_sha256",
        "base_structured_snapshot_sha256",
        "variant_structured_snapshot_sha256",
        "base_structured_local_context_sha256",
        "variant_structured_local_context_sha256",
        "snapshot_schema_version",
        "irrelevant_context_intervention",
        "structured_snapshots",
        "proof_term_support_receipts"
      ],
      "properties": {
        "operation": {
          "const": "clear h"
        },
        "base_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "variant_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "base_local_context_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "variant_local_context_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "goal_type_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "goal_type_preserved": {
          "const": true
        },
        "required_declaration_present_before": {
          "const": true
        },
        "required_declaration_absent_after": {
          "const": true
        },
        "alternate_route_hypothesis_present_after": {
          "const": true
        },
        "trace_log_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "case_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_statement_fragment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "base_structured_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "variant_structured_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "base_structured_local_context_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "variant_structured_local_context_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_schema_version": {
          "const": "pitb.lean-proof-state-snapshot.v0"
        },
        "irrelevant_context_intervention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "base_snapshot_sha256",
            "variant_snapshot_sha256",
            "base_local_context_sha256",
            "variant_local_context_sha256",
            "goal_type_sha256",
            "goal_type_preserved",
            "required_hypothesis_present_in_both",
            "irrelevant_declaration_present_before",
            "irrelevant_declaration_absent_after",
            "case_id",
            "case_manifest_sha256",
            "target_statement_fragment_sha256"
          ],
          "properties": {
            "operation": {
              "const": "clear hIrrelevant"
            },
            "base_snapshot_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "variant_snapshot_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "base_local_context_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "variant_local_context_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "goal_type_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "goal_type_preserved": {
              "const": true
            },
            "required_hypothesis_present_in_both": {
              "const": true
            },
            "irrelevant_declaration_present_before": {
              "const": true
            },
            "irrelevant_declaration_absent_after": {
              "const": true
            },
            "case_id": {
              "type": "string",
              "minLength": 1
            },
            "case_manifest_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "target_statement_fragment_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "structured_snapshots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base",
            "variant",
            "irrelevant_base",
            "irrelevant_variant"
          ],
          "properties": {
            "base": {
              "$ref": "#/$defs/state_snapshot"
            },
            "variant": {
              "$ref": "#/$defs/state_snapshot"
            },
            "irrelevant_base": {
              "$ref": "#/$defs/state_snapshot"
            },
            "irrelevant_variant": {
              "$ref": "#/$defs/state_snapshot"
            }
          }
        },
        "proof_term_support_receipts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "receipt",
              "evidence_sha256"
            ],
            "properties": {
              "evidence_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "receipt": {
                "$ref": "#/$defs/proof_term_support"
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lake_build",
        "direct_reelaboration_with_structured_state_trace",
        "same_goal_and_required_hypothesis_withdrawal_verified_from_trace",
        "lean_kernel_checked_examples",
        "nanoda_independent_type_check",
        "sorry_disallowed_by_nanoda",
        "axiom_audit",
        "unlisted_axioms_disallowed",
        "axiom_allowlist"
      ],
      "properties": {
        "lake_build": {
          "const": "passed"
        },
        "direct_reelaboration_with_structured_state_trace": {
          "const": "passed"
        },
        "same_goal_and_required_hypothesis_withdrawal_verified_from_trace": {
          "const": "passed"
        },
        "lean_kernel_checked_examples": {
          "const": "passed"
        },
        "nanoda_independent_type_check": {
          "const": "passed"
        },
        "sorry_disallowed_by_nanoda": {
          "const": true
        },
        "axiom_audit": {
          "const": "passed"
        },
        "unlisted_axioms_disallowed": {
          "const": true
        },
        "axiom_allowlist": {
          "type": "array",
          "items": {
            "enum": [
              "propext",
              "Classical.choice",
              "Quot.sound"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "case_manifest_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "mutation_kind",
          "expected_relation",
          "base_statement_fragment_sha256",
          "variant_statement_fragment_sha256",
          "evidence_declarations",
          "contract_precondition",
          "state_intervention",
          "model_outcomes",
          "proof_term_support"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "mutation_kind": {
            "type": "string",
            "minLength": 1
          },
          "expected_relation": {
            "type": "string",
            "minLength": 1
          },
          "base_statement_fragment_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "variant_statement_fragment_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "evidence_declarations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contract_precondition": {
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "state_intervention": {
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "model_outcomes": {
            "const": "not_run"
          },
          "proof_term_support": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/proof_term_support_contract"
              }
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "state_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "label",
        "goal",
        "declarations"
      ],
      "properties": {
        "schema_version": {
          "const": "pitb.lean-proof-state-snapshot.v0"
        },
        "label": {
          "enum": [
            "base",
            "variant",
            "irrelevant-base",
            "irrelevant-variant"
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "declarations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "user_name",
              "type"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "user_name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "support_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fvar_id",
        "declaration_index",
        "user_name",
        "type",
        "is_let_declaration"
      ],
      "properties": {
        "fvar_id": {
          "type": "string",
          "minLength": 1
        },
        "declaration_index": {
          "type": "integer",
          "minimum": 0
        },
        "user_name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "is_let_declaration": {
          "type": "boolean"
        }
      }
    },
    "proof_term_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "label",
        "proof_term",
        "direct_free_variable_support",
        "transitive_local_dependency_closure",
        "direct_global_constants"
      ],
      "properties": {
        "schema_version": {
          "const": "pitb.proof-term-support.v0"
        },
        "label": {
          "enum": [
            "alternate-route-after-required-hypothesis-withdrawal",
            "original-route-after-irrelevant-context-removal"
          ]
        },
        "proof_term": {
          "type": "string",
          "minLength": 1
        },
        "direct_free_variable_support": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/support_declaration"
          }
        },
        "transitive_local_dependency_closure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/support_declaration"
          }
        },
        "direct_global_constants": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "proof_term_support_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_label",
        "must_include_direct_declarations",
        "must_exclude_direct_declarations",
        "interpretation"
      ],
      "properties": {
        "receipt_label": {
          "enum": [
            "alternate-route-after-required-hypothesis-withdrawal",
            "original-route-after-irrelevant-context-removal"
          ]
        },
        "must_include_direct_declarations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "must_exclude_direct_declarations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
