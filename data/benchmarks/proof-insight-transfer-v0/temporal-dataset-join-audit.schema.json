{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb.temporal-dataset-join-audit.v1.json",
  "title": "PITB temporal dataset-to-timeline join audit",
  "description": "Read-only join and statement-drift audit for a pinned chronological proof dataset. Ambiguous file-path joins remain ambiguous and are never resolved by selecting an arbitrary first row. Unsafe machine-local timeline paths are counted and excluded from the join index, without being read or echoed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_url",
    "repository_commit",
    "timeline_path",
    "timeline_sha256",
    "dataset_path",
    "dataset_sha256",
    "total_timeline_rows",
    "unique_timeline_path_count",
    "invalid_timeline_path_count",
    "total_dataset_records",
    "unique_dataset_id_count",
    "blank_dataset_line_count",
    "unique_path_join_count",
    "ambiguous_path_join_count",
    "unmatched_path_join_count",
    "invalid_dataset_path_count",
    "commit_before_ancestor_of_head_count",
    "commit_before_not_ancestor_of_head_count",
    "commit_before_missing_commit_object_count",
    "commit_before_invalid_sha_count",
    "commit_before_ancestor_of_completion_count",
    "statement_match_relation_counts",
    "unique_theorem_identity_join_count",
    "ambiguous_theorem_identity_join_count",
    "unmatched_theorem_identity_join_count",
    "theorem_identity_status_counts",
    "events"
  ],
  "properties": {
    "schema_version": {"const": "pitb.temporal-dataset-join-audit.v1"},
    "repository_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "minLength": 9
    },
    "repository_commit": {"$ref": "#/$defs/gitSha"},
    "timeline_path": {"$ref": "#/$defs/repositoryPath"},
    "timeline_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_path": {"$ref": "#/$defs/repositoryPath"},
    "dataset_sha256": {"$ref": "#/$defs/sha256"},
    "total_timeline_rows": {"type": "integer", "minimum": 1},
    "unique_timeline_path_count": {"type": "integer", "minimum": 0},
    "invalid_timeline_path_count": {"type": "integer", "minimum": 0},
    "total_dataset_records": {"type": "integer", "minimum": 1},
    "unique_dataset_id_count": {"type": "integer", "minimum": 0},
    "blank_dataset_line_count": {"type": "integer", "minimum": 0},
    "unique_path_join_count": {"type": "integer", "minimum": 0},
    "ambiguous_path_join_count": {"type": "integer", "minimum": 0},
    "unmatched_path_join_count": {"type": "integer", "minimum": 0},
    "invalid_dataset_path_count": {"type": "integer", "minimum": 0},
    "commit_before_ancestor_of_head_count": {"type": "integer", "minimum": 0},
    "commit_before_not_ancestor_of_head_count": {"type": "integer", "minimum": 0},
    "commit_before_missing_commit_object_count": {"type": "integer", "minimum": 0},
    "commit_before_invalid_sha_count": {"type": "integer", "minimum": 0},
    "commit_before_ancestor_of_completion_count": {"type": "integer", "minimum": 0},
    "statement_match_relation_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "unique_theorem_identity_join_count": {"type": "integer", "minimum": 0},
    "ambiguous_theorem_identity_join_count": {"type": "integer", "minimum": 0},
    "unmatched_theorem_identity_join_count": {"type": "integer", "minimum": 0},
    "theorem_identity_status_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$)).+$"
    },
    "nullableString": {
      "oneOf": [
        {"type": "string"},
        {"type": "null"}
      ]
    },
    "nullableBoolean": {
      "oneOf": [
        {"type": "boolean"},
        {"type": "null"}
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_position",
        "dataset_id",
        "theorem_name",
        "file_path",
        "commit_before",
        "statement_sha256",
        "commit_before_object_exists",
        "path_join_status",
        "candidate_timeline_positions",
        "matched_completion_commit",
        "commit_before_is_ancestor_of_head",
        "commit_before_is_ancestor_of_completion",
        "statement_match_at_commit_before",
        "statement_match_at_completion",
        "statement_match_relation",
        "declared_statement_name",
        "declared_name_matches_dataset",
        "dataset_proof_sha256",
        "identity_candidate_timeline_positions",
        "identity_join_status",
        "identity_statement_match_at_commit_before",
        "identity_statement_match_at_completion",
        "identity_proof_matches_completion",
        "identity_proof_absent_at_commit_before"
      ],
      "properties": {
        "dataset_position": {"type": "integer", "minimum": 0},
        "dataset_id": {"type": "string"},
        "theorem_name": {"type": "string"},
        "file_path": {"type": "string"},
        "commit_before": {"type": "string"},
        "statement_sha256": {"$ref": "#/$defs/sha256"},
        "commit_before_object_exists": {"$ref": "#/$defs/nullableBoolean"},
        "path_join_status": {
          "enum": [
            "unique_path_match",
            "ambiguous_path_match",
            "no_path_match",
            "invalid_path"
          ]
        },
        "candidate_timeline_positions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "matched_completion_commit": {
          "oneOf": [
            {"$ref": "#/$defs/gitSha"},
            {"type": "null"}
          ]
        },
        "commit_before_is_ancestor_of_head": {"$ref": "#/$defs/nullableBoolean"},
        "commit_before_is_ancestor_of_completion": {"$ref": "#/$defs/nullableBoolean"},
        "statement_match_at_commit_before": {"$ref": "#/$defs/nullableBoolean"},
        "statement_match_at_completion": {"$ref": "#/$defs/nullableBoolean"},
        "statement_match_relation": {
          "enum": [
            "not_checked_due_to_ambiguous_path",
            "not_checked_due_to_unmatched_path",
            "not_checked_due_to_invalid_path",
            "statement_check_unavailable",
            "empty_formal_statement",
            "matches_before_and_completion",
            "matches_pre_state_only",
            "matches_completion_only",
            "matches_neither_state",
            "completion_match_pre_state_unavailable",
            "pre_state_match_completion_unavailable",
            "pre_state_nonmatch_completion_unavailable",
            "completion_nonmatch_pre_state_unavailable"
          ]
        },
        "declared_statement_name": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "declared_name_matches_dataset": {"$ref": "#/$defs/nullableBoolean"},
        "dataset_proof_sha256": {"$ref": "#/$defs/sha256"},
        "identity_candidate_timeline_positions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "identity_join_status": {
          "enum": [
            "declared_name_unavailable",
            "declared_name_mismatch",
            "not_checked_invalid_path",
            "not_checked_empty_dataset_proof",
            "not_checked_no_path_candidate",
            "no_exact_proof_transition",
            "ambiguous_proof_transition",
            "unique_proof_transition_with_statement_or_visibility_mismatch",
            "unique_stable_theorem_proof_transition"
          ]
        },
        "identity_statement_match_at_commit_before": {"$ref": "#/$defs/nullableBoolean"},
        "identity_statement_match_at_completion": {"$ref": "#/$defs/nullableBoolean"},
        "identity_proof_matches_completion": {"$ref": "#/$defs/nullableBoolean"},
        "identity_proof_absent_at_commit_before": {"$ref": "#/$defs/nullableBoolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"path_join_status": {"const": "unique_path_match"}}},
          "then": {
            "properties": {
              "candidate_timeline_positions": {"minItems": 1, "maxItems": 1},
              "matched_completion_commit": {"$ref": "#/$defs/gitSha"}
            }
          }
        },
        {
          "if": {"properties": {"path_join_status": {"const": "ambiguous_path_match"}}},
          "then": {
            "properties": {
              "candidate_timeline_positions": {"minItems": 2},
              "matched_completion_commit": {"type": "null"},
              "statement_match_relation": {"const": "not_checked_due_to_ambiguous_path"},
              "statement_match_at_commit_before": {"type": "null"},
              "statement_match_at_completion": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"path_join_status": {"const": "no_path_match"}}},
          "then": {
            "properties": {
              "candidate_timeline_positions": {"maxItems": 0},
              "matched_completion_commit": {"type": "null"},
              "statement_match_relation": {"const": "not_checked_due_to_unmatched_path"},
              "statement_match_at_commit_before": {"type": "null"},
              "statement_match_at_completion": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"path_join_status": {"const": "invalid_path"}}},
          "then": {
            "properties": {
              "candidate_timeline_positions": {"maxItems": 0},
              "matched_completion_commit": {"type": "null"},
              "statement_match_relation": {"const": "not_checked_due_to_invalid_path"},
              "statement_match_at_commit_before": {"type": "null"},
              "statement_match_at_completion": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
