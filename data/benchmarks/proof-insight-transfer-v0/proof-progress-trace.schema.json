{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/data/benchmarks/proof-insight-transfer-v0/proof-progress-trace.schema.json",
  "title": "Proof Insight Transfer Proof-Progress Trace v0",
  "description": "Content-addressed diagnostic trace for proof execution and obligation transitions. A valid trace is not itself proof success; terminal success requires separate exact-target kernel and semantic-gate evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "split",
    "source_insight",
    "target",
    "run",
    "events",
    "outcome",
    "trace_receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.proof-progress-trace.v0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test",
        "external_challenge"
      ]
    },
    "source_insight": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_id",
            "family_id",
            "insight_sha256"
          ],
          "properties": {
            "record_id": {
              "type": "string",
              "minLength": 1
            },
            "family_id": {
              "type": "string",
              "minLength": 1
            },
            "insight_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "family_id",
        "source_commit",
        "artifact_path",
        "artifact_sha256",
        "statement_sha256",
        "root_obligation_id",
        "root_obligation_sha256",
        "toolchain",
        "checker"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "$ref": "#/$defs/commit"
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "statement_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "root_obligation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "checker": {
          "type": "string",
          "minLength": 1
        },
        "root_obligation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "arm_id",
        "model_id",
        "model_version",
        "prompt_sha256",
        "config_sha256",
        "input_sha256",
        "budget"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "arm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_model_calls",
            "max_tokens",
            "max_wall_ms",
            "max_cost_microusd"
          ],
          "properties": {
            "max_model_calls": {
              "type": "integer",
              "minimum": 0
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "max_wall_ms": {
              "type": "integer",
              "minimum": 0
            },
            "max_cost_microusd": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_status",
        "target_kernel_status",
        "semantic_gate_status",
        "successor_status",
        "actual_model_calls",
        "actual_tokens",
        "actual_wall_ms",
        "actual_cost_microusd",
        "outcome_receipt_sha256"
      ],
      "properties": {
        "terminal_status": {
          "enum": [
            "verified_success",
            "non_solve",
            "timeout",
            "tool_unavailable",
            "cancelled",
            "invalid_trace"
          ]
        },
        "target_kernel_status": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "unavailable"
          ]
        },
        "semantic_gate_status": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "unavailable"
          ]
        },
        "successor_status": {
          "enum": [
            "passed",
            "failed",
            "not_applicable",
            "not_run",
            "unavailable"
          ]
        },
        "actual_model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "actual_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "actual_wall_ms": {
          "type": "integer",
          "minimum": 0
        },
        "actual_cost_microusd": {
          "type": "integer",
          "minimum": 0
        },
        "outcome_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "trace_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "event_id",
        "kind",
        "elapsed_ms",
        "cumulative_model_calls",
        "cumulative_tokens",
        "cumulative_cost_microusd",
        "state_before_sha256",
        "state_after_sha256",
        "obligation_transitions",
        "event_receipt_sha256",
        "checker_receipt_sha256"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "attempt_started",
            "strategy_presented",
            "precondition_checked",
            "tactic_attempted",
            "obligation_state_changed",
            "target_kernel_checked",
            "successor_check",
            "semantic_gate_checked",
            "budget_exhausted",
            "attempt_terminated",
            "failure_diagnosed",
            "lemma_invalidated",
            "subtree_retracted",
            "global_replan",
            "action_routed",
            "automation_dispatched"
          ]
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cumulative_model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "cumulative_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cumulative_cost_microusd": {
          "type": "integer",
          "minimum": 0
        },
        "state_before_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "state_after_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "obligation_transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obligation_transition"
          }
        },
        "event_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checker_receipt_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "failure_class": {
          "enum": [
            "insufficient_guidance",
            "false_lemma_or_specification",
            "decomposition_error",
            "missing_dependency",
            "tooling_failure",
            "budget_exhaustion",
            "unknown"
          ]
        },
        "failure_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decision_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "retracted_obligation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "routed_action": {
          "enum": [
            "automation",
            "direct_tactic",
            "lemma_generation",
            "retrieval",
            "specialist_agent",
            "increase_reasoning_effort",
            "backtrack",
            "replan",
            "abstain"
          ]
        },
        "estimated_success_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "estimated_action_cost_microusd": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "failure_diagnosed",
                  "lemma_invalidated"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "failure_class",
              "failure_evidence_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "lemma_invalidated",
                  "subtree_retracted",
                  "global_replan",
                  "action_routed",
                  "automation_dispatched"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "decision_receipt_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "subtree_retracted"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "retracted_obligation_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "action_routed"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "routed_action",
              "estimated_success_probability",
              "estimated_action_cost_microusd"
            ]
          }
        }
      ]
    },
    "obligation_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "obligation_sha256",
        "transition",
        "children",
        "checker_receipt_sha256"
      ],
      "properties": {
        "obligation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transition": {
          "enum": [
            "preserved",
            "refined",
            "split",
            "discharged",
            "reopened",
            "rejected",
            "unknown"
          ]
        },
        "checker_receipt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "obligation_id": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "obligation_id",
              "obligation_sha256"
            ],
            "properties": {
              "obligation_id": {
                "type": "string",
                "minLength": 1
              },
              "obligation_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    }
  }
}
