{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb.temporal-replay-manifest.v0.json",
  "title": "PITB temporal replay manifest",
  "description": "Evaluator-side, provenance-bound timeline and artifact visibility manifest. Do not pass this audit manifest directly to the solver; generate the target-specific visible artifact bundle from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_url",
    "repository_commit",
    "timeline_path",
    "timeline_sha256",
    "lean_toolchain",
    "mathlib_revision",
    "events",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.temporal-replay-manifest.v0"
    },
    "repository_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "minLength": 9
    },
    "repository_commit": {
      "$ref": "#/$defs/gitSha"
    },
    "timeline_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "lean_toolchain": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!latest$).+"
    },
    "mathlib_revision": {
      "$ref": "#/$defs/gitSha"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "timeline_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$)).+$"
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "target_id",
        "theorem_id",
        "target_state_commit",
        "proof_completion_commit",
        "statement_sha256",
        "statement_artifact_id",
        "proof_artifact_id",
        "visible_artifact_ids"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "theorem_id": {
          "type": "string",
          "minLength": 1
        },
        "target_state_commit": {
          "$ref": "#/$defs/gitSha"
        },
        "proof_completion_commit": {
          "$ref": "#/$defs/gitSha"
        },
        "statement_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "statement_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "proof_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "visible_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path",
        "artifact_kind",
        "content_sha256",
        "content_start_line",
        "content_end_line",
        "source_file_sha256",
        "source_commit",
        "available_at_position",
        "target_position",
        "theorem_id"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$)).+$"
        },
        "artifact_kind": {
          "enum": [
            "theorem_statement",
            "proof_body",
            "definition",
            "module_context"
          ]
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_start_line": {
          "type": "integer",
          "minimum": 1
        },
        "content_end_line": {
          "type": "integer",
          "minimum": 1
        },
        "source_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_commit": {
          "$ref": "#/$defs/gitSha"
        },
        "available_at_position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "theorem_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "artifact_kind": {
                "const": "proof_body"
              }
            },
            "required": [
              "artifact_kind"
            ]
          },
          "then": {
            "properties": {
              "available_at_position": {
                "type": "null"
              },
              "target_position": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "available_at_position": {
                "type": "integer",
                "minimum": 0
              },
              "target_position": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
