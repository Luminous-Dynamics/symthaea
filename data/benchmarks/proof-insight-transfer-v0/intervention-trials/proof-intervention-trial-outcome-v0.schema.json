{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb/proof-intervention-trial-outcome-v0.schema.json",
  "title": "PITB paired proof-intervention trial outcome v0",
  "description": "One arm run for one preregistered task/state/model-seed pair. Outcome labels are derived by the analyzer from exact-target and independent receipt gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "trial_id",
    "pair_id",
    "arm_id",
    "run_id",
    "task_id",
    "component_id",
    "repository_commit",
    "lean_toolchain",
    "environment_sha256",
    "initial_proof_state_sha256",
    "initial_state_receipt_sha256",
    "target_statement_sha256",
    "model_seed_sha256",
    "evaluation_horizon_id",
    "continuation_policy_sha256",
    "execution_order_index",
    "status",
    "checker_passed",
    "target_integrity_passed",
    "successor_gate_status",
    "checked_target_statement_sha256",
    "proof_sha256",
    "checker_receipt_sha256",
    "target_integrity_receipt_sha256",
    "successor_gate_receipt_sha256",
    "run_receipt_sha256",
    "actual_resources",
    "proof_path",
    "checker_receipt_path",
    "target_integrity_receipt_path",
    "successor_gate_receipt_path",
    "run_receipt_path"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.proof-intervention-trial-outcome.v0"
    },
    "evidence_class": {
      "enum": [
        "synthetic_outcome_fixture",
        "measured_outcome"
      ]
    },
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "pair_id": {
      "$ref": "#/$defs/sha256"
    },
    "arm_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "$ref": "#/$defs/sha256"
    },
    "component_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_commit": {
      "$ref": "#/$defs/sha1"
    },
    "lean_toolchain": {
      "type": "string",
      "minLength": 1
    },
    "environment_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "initial_proof_state_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "initial_state_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_statement_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_seed_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evaluation_horizon_id": {
      "type": "string",
      "minLength": 1
    },
    "continuation_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "execution_order_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "status": {
      "enum": [
        "verified_success",
        "proof_only",
        "failed",
        "timeout",
        "not_attempted",
        "tool_unavailable",
        "invalid_candidate"
      ]
    },
    "checker_passed": {
      "type": "boolean"
    },
    "target_integrity_passed": {
      "type": "boolean"
    },
    "successor_gate_status": {
      "enum": [
        "passed",
        "not_applicable",
        "failed",
        "not_run"
      ]
    },
    "checked_target_statement_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "proof_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "checker_receipt_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "semantic_gate_receipt_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "successor_gate_receipt_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "actual_resources": {
      "$ref": "#/$defs/resources"
    },
    "proof_path": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\\\.\\\\.?(/|$))(?!.*\\\\\\\\)"
        },
        {
          "type": "null"
        }
      ]
    },
    "checker_receipt_path": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\\\.\\\\.?(/|$))(?!.*\\\\\\\\)"
        },
        {
          "type": "null"
        }
      ]
    },
    "semantic_gate_receipt_path": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\\\.\\\\.?(/|$))(?!.*\\\\\\\\)"
        },
        {
          "type": "null"
        }
      ]
    },
    "successor_gate_receipt_path": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\\\.\\\\.?(/|$))(?!.*\\\\\\\\)"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_receipt_path": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\\\.\\\\.?(/|$))(?!.*\\\\\\\\)"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified_success"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "proof_sha256",
          "checker_receipt_sha256"
        ],
        "properties": {
          "checker_passed": {
            "const": true
          },
          "target_integrity_passed": {
            "const": true
          },
          "successor_gate_status": {
            "enum": [
              "passed",
              "not_applicable"
            ]
          },
          "checked_target_statement_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "successor_gate_status": {
                  "const": "passed"
                }
              },
              "required": [
                "successor_gate_status"
              ]
            },
            "then": {
              "required": [
                "successor_receipt_path"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_attempted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "checker_passed": {
            "const": false
          },
          "target_integrity_passed": {
            "const": true
          },
          "successor_gate_status": {
            "const": "not_run"
          },
          "checked_target_statement_sha256": {
            "type": "null"
          },
          "proof_sha256": {
            "type": "null"
          },
          "checker_receipt_sha256": {
            "type": "null"
          },
          "successor_gate_receipt_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_class": {
            "const": "measured_outcome"
          }
        },
        "required": [
          "evidence_class"
        ]
      },
      "then": {
        "properties": {
          "target_integrity_passed": {
            "const": true
          },
          "target_integrity_receipt_path": {
            "$ref": "#/$defs/relative_path"
          },
          "target_integrity_receipt_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "run_receipt_path": {
            "$ref": "#/$defs/relative_path"
          }
        },
        "required": [
          "target_integrity_receipt_path",
          "target_integrity_receipt_sha256",
          "run_receipt_path"
        ]
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "evidence_class": {
                "const": "measured_outcome"
              }
            },
            "required": [
              "evidence_class"
            ]
          },
          {
            "properties": {
              "successor_gate_status": {
                "const": "passed"
              }
            },
            "required": [
              "successor_gate_status"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "successor_receipt_path"
        ]
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "evidence_class": {
                "const": "measured_outcome"
              }
            },
            "required": [
              "evidence_class"
            ]
          },
          {
            "properties": {
              "status": {
                "const": "verified_success"
              }
            },
            "required": [
              "status"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "proof_path",
          "checker_receipt_path"
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "model_calls",
        "tool_calls",
        "wall_ms",
        "lean_cpu_ms",
        "cost_microusd"
      ],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 0
        },
        "lean_cpu_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cost_microusd": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\\\.\\\\.?(/|$))(?!.*\\\\\\\\)"
    }
  }
}
