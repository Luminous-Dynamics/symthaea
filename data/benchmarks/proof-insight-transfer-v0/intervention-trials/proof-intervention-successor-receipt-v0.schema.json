{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://luminousdynamics.io/schemas/pitb/proof-intervention-successor-receipt-v0.schema.json",
 "title":"PITB intervention successor receipt v0",
 "description":"Downstream semantic/successor checks bound to the exact accepted proof and target from one paired trial arm.",
 "type":"object","additionalProperties":false,
 "required":["schema_version","evidence_class","evidence_kind","trial_id","pair_id","arm_id","run_id","task_id","component_id","repository_commit","lean_toolchain","environment_sha256","initial_proof_state_sha256","target_statement_sha256","model_seed_sha256","status","proof_sha256","successor_suite_id","successor_suite_sha256","passed_check_ids","failed_check_ids"],
 "properties":{
  "schema_version":{"const":"pitb.proof-intervention-successor-receipt.v0"},
  "evidence_class":{"const":"measured_evidence"},
  "evidence_kind":{"const":"successor"},
  "trial_id":{"type":"string","minLength":1},
  "pair_id":{"$ref":"#/$defs/sha256"},
  "arm_id":{"type":"string","minLength":1},
  "run_id":{"type":"string","minLength":1},
  "task_id":{"$ref":"#/$defs/sha256"},
  "component_id":{"type":"string","minLength":1},
  "repository_commit":{"$ref":"#/$defs/sha1"},
  "lean_toolchain":{"type":"string","minLength":1},
  "environment_sha256":{"$ref":"#/$defs/sha256"},
  "initial_proof_state_sha256":{"$ref":"#/$defs/sha256"},
  "target_statement_sha256":{"$ref":"#/$defs/sha256"},
  "model_seed_sha256":{"$ref":"#/$defs/sha256"},
  "status":{"enum":["passed","failed","not_run"]},
  "proof_sha256":{"$ref":"#/$defs/sha256"},
  "successor_suite_id":{"type":"string","minLength":1},
  "successor_suite_sha256":{"$ref":"#/$defs/sha256"},
  "passed_check_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
  "failed_check_ids":{"type":"array","maxItems":0,"items":{"type":"string","minLength":1}}
 },
 "allOf":[{"if":{"properties":{"status":{"const":"passed"}},"required":["status"]},"then":{"properties":{"failed_check_ids":{"maxItems":0},"passed_check_ids":{"minItems":1}}}}],
 "$defs":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sha1":{"type":"string","pattern":"^[a-f0-9]{40}$"}}
}
