{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb/proof-intervention-run-receipt-v0.schema.json",
  "title": "PITB intervention run receipt v0",
  "description": "Execution receipt that binds a paired intervention arm to its actual resource measurements, exact evidence digests and frozen budget.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "evidence_kind",
    "trial_id",
    "pair_id",
    "arm_id",
    "run_id",
    "task_id",
    "component_id",
    "repository_commit",
    "lean_toolchain",
    "environment_sha256",
    "initial_proof_state_sha256",
    "target_statement_sha256",
    "model_seed_sha256",
    "evaluation_horizon_id",
    "continuation_policy_sha256",
    "execution_order_index",
    "status",
    "actual_resources",
    "resource_budget",
    "proof_sha256",
    "checker_receipt_sha256",
    "semantic_gate_receipt_sha256",
    "successor_receipt_sha256",
    "run_config_sha256",
    "started_from_fresh_process",
    "mutable_caches_isolated"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.proof-intervention-run-receipt.v0"
    },
    "evidence_class": {
      "const": "measured_evidence"
    },
    "evidence_kind": {
      "const": "run"
    },
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "pair_id": {
      "$ref": "#/$defs/sha256"
    },
    "arm_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "$ref": "#/$defs/sha256"
    },
    "component_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_commit": {
      "$ref": "#/$defs/sha1"
    },
    "lean_toolchain": {
      "type": "string",
      "minLength": 1
    },
    "environment_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "initial_proof_state_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_statement_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_seed_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evaluation_horizon_id": {
      "type": "string",
      "minLength": 1
    },
    "continuation_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "execution_order_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "status": {
      "enum": [
        "verified_success",
        "proof_only",
        "failed",
        "timeout",
        "not_attempted",
        "tool_unavailable",
        "invalid_candidate"
      ]
    },
    "actual_resources": {
      "$ref": "#/$defs/resources"
    },
    "resource_budget": {
      "$ref": "#/$defs/resources"
    },
    "proof_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "checker_receipt_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "semantic_gate_receipt_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "successor_receipt_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "started_from_fresh_process": {
      "const": true
    },
    "mutable_caches_isolated": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified_success"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "proof_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "checker_receipt_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "target_integrity_receipt_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "model_calls",
        "tool_calls",
        "wall_ms",
        "lean_cpu_ms",
        "cost_microusd"
      ],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 0
        },
        "lean_cpu_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cost_microusd": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
