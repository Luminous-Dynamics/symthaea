{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/pitb/proof-intervention-trial-plan-v0.schema.json",
  "title":"PITB paired proof-intervention trial plan v0",
  "description":"Frozen multi-arm, matched proof-state experiment. Every arm runs from an independent copy of the same initial state; execution order is deterministically randomized and auditable.",
  "type":"object","additionalProperties":false,
  "required":["schema_version","evidence_class","trial_id","dataset","evaluation_split","model","evaluation","randomization","execution_controls","arms","pairs","analysis_policy"],
  "properties":{
    "schema_version":{"const":"pitb.proof-intervention-trial-plan.v0"},
    "evidence_class":{"enum":["synthetic_contract_fixture","preregistered_trial"]},
    "trial_id":{"type":"string","minLength":1,"maxLength":160},
    "dataset":{"$ref":"#/$defs/dataset"},
    "evaluation_split":{"enum":["validation","test","external_challenge"]},
    "model":{"$ref":"#/$defs/model"},
    "evaluation":{"$ref":"#/$defs/evaluation"},
    "randomization":{"$ref":"#/$defs/randomization"},
    "execution_controls":{"$ref":"#/$defs/execution_controls"},
    "arms":{"type":"array","minItems":2,"maxItems":8,"items":{"$ref":"#/$defs/arm"}},
    "pairs":{"type":"array","minItems":4,"maxItems":100000,"items":{"$ref":"#/$defs/pair"}},
    "analysis_policy":{"$ref":"#/$defs/analysis_policy"}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "sha1":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "dataset":{
      "type":"object","additionalProperties":false,
      "required":["cohort_id","snapshot_id","dataset_manifest_sha256"],
      "properties":{
        "cohort_id":{"type":"string","minLength":1},
        "snapshot_id":{"type":"string","minLength":1},
        "dataset_manifest_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "model":{
      "type":"object","additionalProperties":false,
      "required":["model_id","model_version"],
      "properties":{
        "model_id":{"type":"string","minLength":1},
        "model_version":{"type":"string","minLength":1}
      }
    },
    "evaluation":{
      "type":"object","additionalProperties":false,
      "required":["horizon_id","continuation_policy_sha256","primary_outcome"],
      "properties":{
        "horizon_id":{"type":"string","minLength":1},
        "continuation_policy_sha256":{"$ref":"#/$defs/sha256"},
        "primary_outcome":{"const":"exact_target_semantic_gate_success"}
      }
    },
    "randomization":{
      "type":"object","additionalProperties":false,
      "required":["seed_sha256","algorithm","order_rule"],
      "properties":{
        "seed_sha256":{"$ref":"#/$defs/sha256"},
        "algorithm":{"const":"sha256-pair-arm-order-v0"},
        "order_rule":{"const":"sort by SHA256(domain || seed || pair_id || arm_id), ascending; arm ID breaks ties"}
      }
    },
    "execution_controls":{
      "type":"object","additionalProperties":false,
      "required":["fresh_process_per_arm","independent_copy_of_initial_state","discard_mutable_caches_between_arms","same_environment_within_pair","same_model_seed_within_pair","same_resource_budget_within_pair"],
      "properties":{
        "fresh_process_per_arm":{"const":true},
        "independent_copy_of_initial_state":{"const":true},
        "discard_mutable_caches_between_arms":{"const":true},
        "same_environment_within_pair":{"const":true},
        "same_model_seed_within_pair":{"const":true},
        "same_resource_budget_within_pair":{"const":true}
      }
    },
    "arm":{
      "type":"object","additionalProperties":false,
      "required":["arm_id","role","method","policy_sha256","config_sha256"],
      "properties":{
        "arm_id":{"type":"string","minLength":1,"maxLength":96},
        "role":{"enum":["control","intervention","oracle_upper_bound","negative_control"]},
        "method":{"type":"string","minLength":1,"maxLength":160},
        "policy_sha256":{"$ref":"#/$defs/sha256"},
        "config_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "budget":{
      "type":"object","additionalProperties":false,
      "required":["tokens","model_calls","tool_calls","wall_ms","lean_cpu_ms","cost_microusd"],
      "properties":{
        "tokens":{"type":"integer","minimum":1},
        "model_calls":{"type":"integer","minimum":1},
        "tool_calls":{"type":"integer","minimum":1},
        "wall_ms":{"type":"integer","minimum":1},
        "lean_cpu_ms":{"type":"integer","minimum":1},
        "cost_microusd":{"type":"integer","minimum":1}
      }
    },
    "pair":{
      "type":"object","additionalProperties":false,
      "required":["pair_id","task_id","component_id","repository_commit","lean_toolchain","environment_sha256","initial_proof_state_sha256","initial_state_receipt_sha256","target_statement_sha256","model_seed_sha256","resource_budget","execution_order"],
      "properties":{
        "pair_id":{"$ref":"#/$defs/sha256"},
        "task_id":{"$ref":"#/$defs/sha256"},
        "component_id":{"type":"string","minLength":1,"maxLength":160},
        "repository_commit":{"$ref":"#/$defs/sha1"},
        "lean_toolchain":{"type":"string","minLength":1},
        "environment_sha256":{"$ref":"#/$defs/sha256"},
        "initial_proof_state_sha256":{"$ref":"#/$defs/sha256"},
        "initial_state_receipt_sha256":{"$ref":"#/$defs/sha256"},
        "target_statement_sha256":{"$ref":"#/$defs/sha256"},
        "model_seed_sha256":{"$ref":"#/$defs/sha256"},
        "resource_budget":{"$ref":"#/$defs/budget"},
        "execution_order":{"type":"array","minItems":2,"maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "analysis_policy":{
      "type":"object","additionalProperties":false,
      "required":["primary_estimand","resampling_unit","minimum_components","include_not_attempted_as_failure","include_tool_unavailable_as_failure","require_complete_arm_coverage","oracle_arm_is_diagnostic_only","confirmatory_decision"],
      "properties":{
        "primary_estimand":{"const":"paired_intention_to_treat_risk_difference"},
        "resampling_unit":{"const":"component_id"},
        "minimum_components":{"type":"integer","minimum":4},
        "include_not_attempted_as_failure":{"const":true},
        "include_tool_unavailable_as_failure":{"const":true},
        "require_complete_arm_coverage":{"const":true},
        "oracle_arm_is_diagnostic_only":{"const":true},
        "confirmatory_decision":{"const":"not_evaluated_until_measured_outcome_receipts_are_validated"}
      }
    }
  }
}
