{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb.temporal-target-bundle.v0.json",
  "title": "PITB materialized temporal target bundle",
  "description": "Content-addressed, target-specific solver context. Contains only artifacts explicitly whitelisted as visible by the validated temporal replay manifest; evaluator-only current/future proof bodies and completion statements are not valid bundle items.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload_sha256", "payload"],
  "properties": {
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "payload": {"$ref": "#/$defs/payload"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$)).+$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "repository_url",
        "repository_commit",
        "target_id",
        "theorem_id",
        "position",
        "target_state_commit",
        "statement_sha256",
        "visible_artifacts"
      ],
      "properties": {
        "schema_version": {"const": "pitb.temporal-target-bundle.v0"},
        "repository_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "minLength": 9
        },
        "repository_commit": {"$ref": "#/$defs/gitSha"},
        "target_id": {"type": "string", "minLength": 1},
        "theorem_id": {"type": "string", "minLength": 1},
        "position": {"type": "integer", "minimum": 0},
        "target_state_commit": {"$ref": "#/$defs/gitSha"},
        "statement_sha256": {"$ref": "#/$defs/sha256"},
        "visible_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/visibleArtifact"}
        }
      }
    },
    "visibleArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path",
        "artifact_kind",
        "content_sha256",
        "source_file_sha256",
        "source_commit",
        "available_at_position",
        "target_position",
        "theorem_id",
        "content"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "artifact_kind": {
          "enum": [
            "theorem_statement",
            "proof_body",
            "definition",
            "module_context"
          ]
        },
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "source_file_sha256": {"$ref": "#/$defs/sha256"},
        "source_commit": {"$ref": "#/$defs/gitSha"},
        "available_at_position": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "target_position": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "theorem_id": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "content": {"type": "string"}
      }
    }
  }
}
