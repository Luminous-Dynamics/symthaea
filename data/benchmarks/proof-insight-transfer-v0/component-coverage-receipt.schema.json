{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb.component-coverage-receipt.v1.json",
  "title": "PITB Component Coverage Receipt",
  "description": "Cryptographic endorsements of an exhaustive relationship-inventory review. Schema validation does not verify signatures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "upstream_commit",
    "source_partition_digest_sha256",
    "relationship_inventory_edges_sha256",
    "review_methodology_sha256",
    "trust_store_sha256",
    "attestation",
    "signatures"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.component-coverage-receipt.v1"
    },
    "upstream_commit": {
      "const": "1581d4cbdd69a0faf34b2089614fe2a814316a6a"
    },
    "source_partition_digest_sha256": {
      "const": "e7ac417556cbd47cee1ddd51b98f9684fadfc8cd097587ae3beacc4dfb59f970"
    },
    "relationship_inventory_edges_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "review_methodology_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "trust_store_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "attestation": {
      "const": "complete_relationship_inventory"
    },
    "signatures": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/signature"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "key_id",
        "signature_hex"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "signature_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      }
    }
  }
}
