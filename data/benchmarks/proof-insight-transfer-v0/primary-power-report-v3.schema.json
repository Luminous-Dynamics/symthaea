    "estimated_power_at_20pp_and_icc_020_lower_95",
    "estimated_power_at_20pp_and_icc_020_lower_simultaneous_95",
    "power_gate_passed",
    "scenarios",
    "model_assumptions",
    "interpretation",
    "weak_null_pair_association_fraction_grid"
