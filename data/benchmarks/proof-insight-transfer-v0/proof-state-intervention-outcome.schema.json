{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/data/benchmarks/proof-insight-transfer-v0/proof-state-intervention-outcome.schema.json",
  "title": "PITB Proof-State Intervention Outcome v0",
  "description": "One state-side outcome row (base or variant) for a paired fixed-theorem proof-state intervention. Separately records expected insight applicability and expected action policy. Rows join to the suite's base/variant outcome IDs. Structural validation does not determine mathematical truth. Synthetic fixtures must remain not_run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "dataset_kind",
    "outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.proof-state-intervention-outcomes.v0"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "dataset_kind": {
      "enum": [
        "synthetic_fixture",
        "reviewed_benchmark"
      ]
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome_id",
          "case_id",
          "pair_id",
          "component_id",
          "split",
          "state_role",
          "source_insight_record_id",
          "source_insight_sha256",
          "expected_applicability",
          "expected_action_policy",
          "proof_state",
          "execution"
        ],
        "properties": {
          "outcome_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "pair_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "component_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "split": {
            "enum": [
              "train",
              "validation",
              "test",
              "external_challenge"
            ]
          },
          "state_role": {
            "enum": [
              "base",
              "variant"
            ]
          },
          "source_insight_record_id": {
            "type": "string",
            "minLength": 1
          },
          "source_insight_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expected_action_policy": {
            "enum": [
              "preserve_eligibility",
              "move_forbidden_or_replan"
            ]
          },
          "proof_state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_statement_sha256",
              "goal_type_sha256",
              "environment_sha256",
              "snapshot_sha256",
              "paired_snapshot_sha256",
              "local_context_sha256",
              "paired_local_context_sha256"
            ],
            "properties": {
              "target_statement_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "goal_type_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "environment_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "snapshot_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "paired_snapshot_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "local_context_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "paired_local_context_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "model",
              "applicability_judgment",
              "decision",
              "original_move_applied",
              "checked_target_statement_sha256",
              "checker_result",
              "proof_sha256",
              "run_receipt_sha256",
              "resource_usage",
              "budget_caps",
              "semantic_gate"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not_run",
                  "executed"
                ]
              },
              "model": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "model_id",
                      "model_version",
                      "config_sha256"
                    ],
                    "properties": {
                      "model_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "model_version": {
                        "type": "string",
                        "minLength": 1
                      },
                      "config_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "decision": {
                "oneOf": [
                  {
                    "type": "string",
                    "enum": [
                      "apply_original_move",
                      "adapt_move",
                      "replan",
                      "abstain",
                      "reject_insight"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "original_move_applied": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "checker_result": {
                "enum": [
                  "not_run",
                  "checked_success",
                  "checked_failure"
                ]
              },
              "proof_sha256": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "run_receipt_sha256": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "resource_usage": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "model_calls",
                      "input_tokens",
                      "output_tokens",
                      "wall_time_ms",
                      "cost_microusd"
                    ],
                    "properties": {
                      "model_calls": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "input_tokens": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "output_tokens": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "wall_time_ms": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "cost_microusd": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "applicability_judgment": {
                "oneOf": [
                  {
                    "type": "string",
                    "enum": [
                      "eligible",
                      "not_applicable",
                      "uncertain"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "checked_target_statement_sha256": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "budget_caps": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "model_calls",
                      "input_tokens",
                      "output_tokens",
                      "wall_time_ms",
                      "cost_microusd"
                    ],
                    "properties": {
                      "model_calls": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "input_tokens": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "output_tokens": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "wall_time_ms": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "cost_microusd": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "semantic_gate": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "checked_target_statement_sha256",
                      "statement_correspondence",
                      "axiom_policy",
                      "successor_check",
                      "mutation_controls"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "passed",
                          "failed",
                          "unknown"
                        ]
                      },
                      "checked_target_statement_sha256": {
                        "$ref": "#/$defs/sha256"
                      },
                      "statement_correspondence": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "status",
                          "receipt_sha256",
                          "reviewers"
                        ],
                        "properties": {
                          "status": {
                            "enum": [
                              "matches_intended_claim",
                              "mismatch",
                              "unknown"
                            ]
                          },
                          "receipt_sha256": {
                            "$ref": "#/$defs/sha256"
                          },
                          "reviewers": {
                            "type": "array",
                            "minItems": 0,
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "reviewer_id",
                                "decision",
                                "evidence_sha256"
                              ],
                              "properties": {
                                "reviewer_id": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "decision": {
                                  "enum": [
                                    "matches_intended_claim",
                                    "mismatch",
                                    "unknown"
                                  ]
                                },
                                "evidence_sha256": {
                                  "$ref": "#/$defs/sha256"
                                }
                              }
                            }
                          }
                        }
                      },
                      "axiom_policy": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "status",
                          "policy_id",
                          "receipt_sha256"
                        ],
                        "properties": {
                          "status": {
                            "enum": [
                              "compliant",
                              "violation",
                              "unknown"
                            ]
                          },
                          "policy_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "receipt_sha256": {
                            "$ref": "#/$defs/sha256"
                          }
                        }
                      },
                      "successor_check": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "status",
                          "receipt_sha256",
                          "reason"
                        ],
                        "properties": {
                          "status": {
                            "enum": [
                              "passed",
                              "failed",
                              "not_applicable",
                              "unknown"
                            ]
                          },
                          "receipt_sha256": {
                            "$ref": "#/$defs/sha256"
                          },
                          "reason": {
                            "oneOf": [
                              {
                                "type": "string",
                                "minLength": 1
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "status": {
                                  "const": "not_applicable"
                                }
                              },
                              "required": [
                                "status"
                              ]
                            },
                            "then": {
                              "properties": {
                                "reason": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            }
                          },
                          {
                            "if": {
                              "properties": {
                                "status": {
                                  "enum": [
                                    "passed",
                                    "failed",
                                    "unknown"
                                  ]
                                }
                              },
                              "required": [
                                "status"
                              ]
                            },
                            "then": {
                              "properties": {
                                "reason": {
                                  "type": "null"
                                }
                              }
                            }
                          }
                        ]
                      },
                      "mutation_controls": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "status",
                          "suite_sha256",
                          "receipt_sha256"
                        ],
                        "properties": {
                          "status": {
                            "enum": [
                              "passed",
                              "failed",
                              "unknown"
                            ]
                          },
                          "suite_sha256": {
                            "$ref": "#/$defs/sha256"
                          },
                          "receipt_sha256": {
                            "$ref": "#/$defs/sha256"
                          }
                        }
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "status": {
                              "const": "passed"
                            }
                          },
                          "required": [
                            "status"
                          ]
                        },
                        "then": {
                          "properties": {
                            "statement_correspondence": {
                              "properties": {
                                "status": {
                                  "const": "matches_intended_claim"
                                },
                                "reviewers": {
                                  "type": "array",
                                  "minItems": 2
                                }
                              }
                            },
                            "axiom_policy": {
                              "properties": {
                                "status": {
                                  "const": "compliant"
                                }
                              }
                            },
                            "successor_check": {
                              "properties": {
                                "status": {
                                  "enum": [
                                    "passed",
                                    "not_applicable"
                                  ]
                                }
                              }
                            },
                            "mutation_controls": {
                              "properties": {
                                "status": {
                                  "const": "passed"
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "not_run"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "model": {
                      "type": "null"
                    },
                    "decision": {
                      "type": "null"
                    },
                    "original_move_applied": {
                      "type": "null"
                    },
                    "checker_result": {
                      "const": "not_run"
                    },
                    "proof_sha256": {
                      "type": "null"
                    },
                    "run_receipt_sha256": {
                      "type": "null"
                    },
                    "resource_usage": {
                      "type": "null"
                    },
                    "applicability_judgment": {
                      "type": "null"
                    },
                    "checked_target_statement_sha256": {
                      "type": "null"
                    },
                    "budget_caps": {
                      "type": "null"
                    },
                    "semantic_gate": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "executed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "status",
                    "model",
                    "decision",
                    "original_move_applied",
                    "checker_result",
                    "run_receipt_sha256",
                    "resource_usage",
                    "applicability_judgment",
                    "checked_target_statement_sha256",
                    "semantic_gate"
                  ],
                  "properties": {
                    "model": {
                      "type": "object"
                    },
                    "decision": {
                      "enum": [
                        "apply_original_move",
                        "adapt_move",
                        "replan",
                        "abstain",
                        "reject_insight"
                      ]
                    },
                    "original_move_applied": {
                      "type": "boolean"
                    },
                    "checker_result": {
                      "enum": [
                        "checked_success",
                        "checked_failure"
                      ]
                    },
                    "run_receipt_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "resource_usage": {
                      "type": "object"
                    },
                    "applicability_judgment": {
                      "enum": [
                        "eligible",
                        "not_applicable",
                        "uncertain"
                      ]
                    },
                    "checked_target_statement_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "semantic_gate": {
                      "type": "object"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "checker_result": {
                      "const": "checked_success"
                    }
                  },
                  "required": [
                    "checker_result"
                  ]
                },
                "then": {
                  "properties": {
                    "proof_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "semantic_gate": {
                      "type": "object"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "decision": {
                      "const": "apply_original_move"
                    }
                  },
                  "required": [
                    "decision"
                  ]
                },
                "then": {
                  "properties": {
                    "original_move_applied": {
                      "const": true
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "original_move_applied": {
                      "const": true
                    }
                  },
                  "required": [
                    "original_move_applied"
                  ]
                },
                "then": {
                  "properties": {
                    "decision": {
                      "const": "apply_original_move"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "applicability_judgment": {
                      "const": "not_applicable"
                    }
                  },
                  "required": [
                    "applicability_judgment"
                  ]
                },
                "then": {
                  "properties": {
                    "original_move_applied": {
                      "const": false
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "original_move_applied": {
                      "const": true
                    }
                  },
                  "required": [
                    "original_move_applied"
                  ]
                },
                "then": {
                  "properties": {
                    "applicability_judgment": {
                      "const": "eligible"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "executed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "budget_caps": {
                      "type": "object"
                    }
                  }
                }
              }
            ]
          },
          "expected_applicability": {
            "enum": [
              "eligible",
              "not_applicable"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state_role": {
                  "const": "base"
                }
              },
              "required": [
                "state_role"
              ]
            },
            "then": {
              "properties": {
                "expected_applicability": {
                  "const": "eligible"
                },
                "expected_action_policy": {
                  "const": "preserve_eligibility"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "expected_applicability": {
                  "const": "not_applicable"
                }
              },
              "required": [
                "expected_applicability"
              ]
            },
            "then": {
              "properties": {
                "expected_action_policy": {
                  "const": "move_forbidden_or_replan"
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dataset_kind": {
            "const": "synthetic_fixture"
          }
        },
        "required": [
          "dataset_kind"
        ]
      },
      "then": {
        "properties": {
          "outcomes": {
            "items": {
              "properties": {
                "execution": {
                  "properties": {
                    "status": {
                      "const": "not_run"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
