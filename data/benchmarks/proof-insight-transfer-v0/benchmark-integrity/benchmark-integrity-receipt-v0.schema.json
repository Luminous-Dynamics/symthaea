{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/pitb/benchmark-integrity-receipt-v0.schema.json",
  "title":"PITB benchmark target integrity receipt v0",
  "description":"Per-target audit of pinned source, Lean elaboration, axioms, counterexample/vacuity probes, and independent semantic review. Compilation alone does not establish that a target matches its intended informal problem.",
  "type":"object","additionalProperties":false,
  "required":["schema_version","evidence_class","audit_id","dataset","target","environment","elaboration","axioms","counterexample_audit","vacuity_audit","semantic_review","integrity_status"],
  "properties":{
    "schema_version":{"const":"pitb.benchmark-integrity-receipt.v0"},
    "evidence_class":{"enum":["synthetic_contract_fixture","measured_audit"]},
    "audit_id":{"type":"string","minLength":1},
    "dataset":{"$ref":"#/$defs/dataset"},
    "target":{"$ref":"#/$defs/target"},
    "environment":{"$ref":"#/$defs/environment"},
    "elaboration":{"$ref":"#/$defs/elaboration"},
    "axioms":{"$ref":"#/$defs/axioms"},
    "counterexample_audit":{"$ref":"#/$defs/probe"},
    "vacuity_audit":{"$ref":"#/$defs/probe"},
    "semantic_review":{"$ref":"#/$defs/semantic_review"},
    "integrity_status":{"enum":["not_attempted","pending","eligible","ineligible"]}
  },
  "allOf":[
    {
      "if":{"properties":{"evidence_class":{"const":"synthetic_contract_fixture"}},"required":["evidence_class"]},
      "then":{"properties":{
        "integrity_status":{"const":"not_attempted"},
        "elaboration":{"properties":{"status":{"const":"not_run"},"metavariable_count":{"const":0},"unresolved_universe_count":{"const":0},"contains_sorry_ax":{"const":false}}},
        "counterexample_audit":{"properties":{"status":{"const":"not_run"},"receipt_sha256":{"type":"null"}}},
        "vacuity_audit":{"properties":{"status":{"const":"not_run"},"receipt_sha256":{"type":"null"}}},
        "semantic_review":{"properties":{"status":{"const":"not_reviewed"},"reviewer_attestation_sha256":{"type":"null"}}}
      }}
    },
    {
      "if":{"properties":{"integrity_status":{"const":"eligible"}},"required":["integrity_status"]},
      "then":{
        "properties":{
          "evidence_class":{"const":"measured_audit"},
          "elaboration":{"properties":{"status":{"const":"passed"},"metavariable_count":{"const":0},"unresolved_universe_count":{"const":0},"contains_sorry_ax":{"const":false}}},
          "counterexample_audit":{"properties":{"status":{"const":"not_found"},"receipt_sha256":{"$ref":"#/$defs/sha256"}}},
          "vacuity_audit":{"properties":{"status":{"const":"no_counterexample_found"},"receipt_sha256":{"$ref":"#/$defs/sha256"}}},
          "semantic_review":{"properties":{"status":{"const":"approved"},"reviewer_identity":{"type":"string","minLength":1},"reviewer_attestation_sha256":{"$ref":"#/$defs/sha256"}}}
        }
      }
    }
  ],
  "$defs":{
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "sha1":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "dataset":{
      "type":"object","additionalProperties":false,
      "required":["cohort_id","snapshot_id","task_id","task_manifest_sha256"],
      "properties":{
        "cohort_id":{"type":"string","minLength":1},
        "snapshot_id":{"type":"string","minLength":1},
        "task_id":{"$ref":"#/$defs/sha256"},
        "task_manifest_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "target":{
      "type":"object","additionalProperties":false,
      "required":["repository_remote","repository_commit","source_path","source_file_sha256","start_line","start_column","end_line","end_column","statement_sha256","expected_informal_statement_sha256"],
      "properties":{
        "repository_remote":{"type":"string","format":"uri"},
        "repository_commit":{"$ref":"#/$defs/sha1"},
        "source_path":{"type":"string","minLength":1},
        "source_file_sha256":{"$ref":"#/$defs/sha256"},
        "start_line":{"type":"integer","minimum":1},
        "start_column":{"type":"integer","minimum":0},
        "end_line":{"type":"integer","minimum":1},
        "end_column":{"type":"integer","minimum":0},
        "statement_sha256":{"$ref":"#/$defs/sha256"},
        "expected_informal_statement_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]}
      }
    },
    "environment":{
      "type":"object","additionalProperties":false,
      "required":["lean_toolchain","lean_binary_sha256","lake_manifest_sha256","root_module_sha256","environment_sha256"],
      "properties":{
        "lean_toolchain":{"type":"string","minLength":1},
        "lean_binary_sha256":{"$ref":"#/$defs/sha256"},
        "lake_manifest_sha256":{"$ref":"#/$defs/sha256"},
        "root_module_sha256":{"$ref":"#/$defs/sha256"},
        "environment_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "elaboration":{
      "type":"object","additionalProperties":false,
      "required":["status","checked_statement_sha256","metavariable_count","unresolved_universe_count","contains_sorry_ax","receipt_sha256"],
      "properties":{
        "status":{"enum":["not_run","passed","failed","unknown"]},
        "checked_statement_sha256":{"$ref":"#/$defs/sha256"},
        "metavariable_count":{"type":"integer","minimum":0},
        "unresolved_universe_count":{"type":"integer","minimum":0},
        "contains_sorry_ax":{"type":"boolean"},
        "receipt_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]}
      }
    },
    "axioms":{
      "type":"object","additionalProperties":false,
      "required":["used_axioms","used_axioms_manifest_sha256","allowed_axioms","allowlist_manifest_sha256","unexpected_axioms"],
      "properties":{
        "used_axioms":{"type":"array","items":{"type":"string","minLength":1}},
        "used_axioms_manifest_sha256":{"$ref":"#/$defs/sha256"},
        "allowed_axioms":{"type":"array","items":{"type":"string","minLength":1}},
        "allowlist_manifest_sha256":{"$ref":"#/$defs/sha256"},
        "unexpected_axioms":{"type":"integer","minimum":0}
      }
    },
    "probe":{
      "type":"object","additionalProperties":false,
      "required":["status","method_id","receipt_sha256","notes_sha256"],
      "properties":{
        "status":{"enum":["not_run","not_found","no_counterexample_found","counterexample_found","inconclusive","not_applicable"]},
        "method_id":{"type":"string","minLength":1},
        "receipt_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
        "notes_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]}
      }
    },
    "semantic_review":{
      "type":"object","additionalProperties":false,
      "required":["status","review_scope","reviewer_identity","reviewer_attestation_sha256"],
      "properties":{
        "status":{"enum":["not_reviewed","approved","rejected","needs_revision"]},
        "review_scope":{"enum":["statement_to_source","informal_to_formal","domain_expert_review","combined"]},
        "reviewer_identity":{"type":"string"},
        "reviewer_attestation_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]}
      }
    }
  }
}
