{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/pitb/aegis-cohort-manifest-v0.schema.json",
  "title":"PITB Aegis benchmark cohort manifest v0",
  "description":"Aegis is a separate implementation-derived Rust-to-Lean verification cohort. This manifest distinguishes published paper statistics from an acquired and pinned evaluation artifact.",
  "type":"object","additionalProperties":false,
  "required":["schema_version","evidence_class","benchmark_id","paper","source_release","published_statistics","evaluation_design","cohort_availability","task_manifest_sha256","stratification_manifest_sha256"],
  "properties":{
    "schema_version":{"const":"pitb.aegis-cohort-manifest.v0"},
    "evidence_class":{"enum":["design_only","acquired_source_snapshot"]},
    "benchmark_id":{"const":"Aegis"},
    "paper":{
      "type":"object","additionalProperties":false,
      "required":["arxiv_id","title","submitted_date","paper_uri"],
      "properties":{
        "arxiv_id":{"const":"2610.38174"},
        "title":{"const":"Scaling Lean Theorem Proving for Real-World Code Verification"},
        "submitted_date":{"const":"2026-10-28"},
        "paper_uri":{"const":"https://arxiv.org/abs/2610.38174"}
      }
    },
    "source_release":{
      "type":"object","additionalProperties":false,
      "required":["dataset_uri","source_repository_uri","immutable_revision","archive_sha256","license_status","license_id"],
      "properties":{
        "dataset_uri":{"oneOf":[{"type":"null"},{"type":"string","format":"uri"}]},
        "source_repository_uri":{"oneOf":[{"type":"null"},{"type":"string","format":"uri"}]},
        "immutable_revision":{"oneOf":[{"type":"null"},{"type":"string","minLength":7}]},
        "archive_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
        "license_status":{"enum":["unknown","review_required","verified_open_source","restricted","not_available"]},
        "license_id":{"oneOf":[{"type":"null"},{"type":"string","minLength":1}]}
      }
    },
    "published_statistics":{
      "type":"object","additionalProperties":false,
      "required":["rust_lean_program_pairs","candidate_specifications","stratified_evaluation_sample","easyprover_proved","easyprover_reported_proof_rate_ppm","per_statement_time_budget_ms"],
      "properties":{
        "rust_lean_program_pairs":{"const":2045},
        "candidate_specifications":{"const":11533},
        "stratified_evaluation_sample":{"const":2000},
        "easyprover_proved":{"const":1054},
        "easyprover_reported_proof_rate_ppm":{"const":527000},
        "per_statement_time_budget_ms":{"const":1800000}
      }
    },
    "evaluation_design":{
      "type":"object","additionalProperties":false,
      "required":["task_unit","required_outcome_classes","require_differential_validation","require_kernel_checked_proof_or_refutation","require_target_integrity_receipt","resource_accounting"],
      "properties":{
        "task_unit":{"const":"frozen_candidate_specification_on_pinned_rust_lean_pair"},
        "required_outcome_classes":{
          "type":"array","uniqueItems":true,"minItems":8,
          "items":{"enum":["verified_proof","verified_refutation","unresolved","invalid_specification","abstained","differential_mismatch","timeout","tool_unavailable"]}
        },
        "require_differential_validation":{"const":true},
        "require_kernel_checked_proof_or_refutation":{"const":true},
        "require_target_integrity_receipt":{"const":true},
        "resource_accounting":{"const":["wall_ms","lean_cpu_ms","model_calls","tool_calls","tokens","peak_memory_bytes","cost_microusd"]}
      }
    },
    "cohort_availability":{"enum":["design_only","release_not_located","license_not_cleared","source_snapshot_acquired","stratified_sample_frozen"]},
    "task_manifest_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "stratification_manifest_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]}
  },
  "allOf":[
    {
      "if":{"properties":{"evidence_class":{"const":"design_only"}},"required":["evidence_class"]},
      "then":{"properties":{
        "cohort_availability":{"enum":["design_only","release_not_located","license_not_cleared"]},
        "source_release":{"properties":{"dataset_uri":{"type":"null"},"source_repository_uri":{"type":"null"},"immutable_revision":{"type":"null"},"archive_sha256":{"type":"null"},"license_status":{"enum":["unknown","review_required","not_available"]}}},
        "task_manifest_sha256":{"type":"null"},
        "stratification_manifest_sha256":{"type":"null"}
      }}
    },
    {
      "if":{"properties":{"evidence_class":{"const":"acquired_source_snapshot"}},"required":["evidence_class"]},
      "then":{"properties":{
        "cohort_availability":{"enum":["source_snapshot_acquired","stratified_sample_frozen"]},
        "source_release":{"properties":{"dataset_uri":{"type":"string","format":"uri"},"source_repository_uri":{"type":"string","format":"uri"},"immutable_revision":{"type":"string","minLength":7},"archive_sha256":{"$ref":"#/$defs/sha256"},"license_status":{"const":"verified_open_source"},"license_id":{"type":"string","minLength":1}}},
        "task_manifest_sha256":{"$ref":"#/$defs/sha256"}
      },"required":["task_manifest_sha256"]}
    },
    {
      "if":{"properties":{"cohort_availability":{"const":"stratified_sample_frozen"}},"required":["cohort_availability"]},
      "then":{"properties":{"stratification_manifest_sha256":{"$ref":"#/$defs/sha256"}},"required":["stratification_manifest_sha256"]}
    }
  ],
  "$defs":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
