{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/pitb/aegis-outcome-receipt-v0.schema.json",
  "title":"PITB Aegis task outcome receipt v0",
  "description":"One method run on one frozen Aegis candidate specification and one Rust-Lean implementation pair. Proof, refutation, invalid specification and failure-to-resolve are separate outcomes.",
  "type":"object","additionalProperties":false,
  "required":["schema_version","evidence_class","cohort_manifest_sha256","task_id","pair_id","specification_id","rust_source_sha256","lean_translation_sha256","statement_sha256","aeneas_version","lean_toolchain","differential_validation_status","differential_validation_receipt_sha256","task_integrity_status","task_integrity_receipt_sha256","arm","run","outcome","proof_evidence_sha256","proof_checker_receipt_sha256","refutation_evidence_sha256","refutation_checker_receipt_sha256","specification_review_status","specification_review_receipt_sha256","actual_resources"],
  "properties":{
    "schema_version":{"const":"pitb.aegis.outcome-receipt.v0"},
    "evidence_class":{"enum":["synthetic_contract_fixture","measured_run"]},
    "cohort_manifest_sha256":{"$ref":"#/$defs/sha256"},
    "task_id":{"$ref":"#/$defs/sha256"},
    "pair_id":{"type":"string","minLength":1},
    "specification_id":{"type":"string","minLength":1},
    "rust_source_sha256":{"$ref":"#/$defs/sha256"},
    "lean_translation_sha256":{"$ref":"#/$defs/sha256"},
    "statement_sha256":{"$ref":"#/$defs/sha256"},
    "aeneas_version":{"type":"string","minLength":1},
    "lean_toolchain":{"type":"string","minLength":1},
    "differential_validation_status":{"enum":["passed","failed","not_run","unknown"]},
    "differential_validation_receipt_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "task_integrity_status":{"enum":["eligible","pending","ineligible","not_audited"]},
    "task_integrity_receipt_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "arm":{
      "type":"object","additionalProperties":false,
      "required":["arm_id","method_class","model_id","model_version","configuration_sha256"],
      "properties":{
        "arm_id":{"type":"string","minLength":1},
        "method_class":{"enum":["one_shot","iterative","agentic","proof_graph_scheduler","pitb_adaptive","other"]},
        "model_id":{"type":"string","minLength":1},
        "model_version":{"type":"string","minLength":1},
        "configuration_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "run":{
      "type":"object","additionalProperties":false,
      "required":["run_id","replicate_index","time_cap_ms"],
      "properties":{
        "run_id":{"type":"string","minLength":1},
        "replicate_index":{"type":"integer","minimum":0},
        "time_cap_ms":{"const":1800000}
      }
    },
    "outcome":{"enum":["verified_proof","verified_refutation","unresolved","invalid_specification","abstained","differential_mismatch","timeout","tool_unavailable"]},
    "proof_evidence_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "proof_checker_receipt_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "refutation_evidence_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "refutation_checker_receipt_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "specification_review_status":{"enum":["approved","invalid","ambiguous","not_reviewed"]},
    "specification_review_receipt_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "actual_resources":{
      "type":"object","additionalProperties":false,
      "required":["wall_ms","lean_cpu_ms","model_calls","tool_calls","tokens","peak_memory_bytes","cost_microusd"],
      "properties":{
        "wall_ms":{"type":"integer","minimum":0,"maximum":1800000},
        "lean_cpu_ms":{"type":"integer","minimum":0},
        "model_calls":{"type":"integer","minimum":0},
        "tool_calls":{"type":"integer","minimum":0},
        "tokens":{"type":"integer","minimum":0},
        "peak_memory_bytes":{"type":"integer","minimum":0},
        "cost_microusd":{"type":"integer","minimum":0}
      }
    }
  },
  "allOf":[
    {
      "if":{"properties":{"evidence_class":{"const":"synthetic_contract_fixture"}},"required":["evidence_class"]},
      "then":{"properties":{"task_integrity_status":{"const":"not_audited"},"differential_validation_status":{"const":"not_run"},"outcome":{"const":"unresolved"}}}
    },
    {
      "if":{"properties":{"outcome":{"const":"verified_proof"}},"required":["outcome"]},
      "then":{"properties":{
        "differential_validation_status":{"const":"passed"},
        "task_integrity_status":{"const":"eligible"},
        "specification_review_status":{"const":"approved"},
        "proof_evidence_sha256":{"$ref":"#/$defs/sha256"},
        "proof_checker_receipt_sha256":{"$ref":"#/$defs/sha256"},
        "refutation_evidence_sha256":{"type":"null"},
        "refutation_checker_receipt_sha256":{"type":"null"}
      }}
    },
    {
      "if":{"properties":{"outcome":{"const":"verified_refutation"}},"required":["outcome"]},
      "then":{"properties":{
        "differential_validation_status":{"const":"passed"},
        "task_integrity_status":{"const":"eligible"},
        "specification_review_status":{"const":"approved"},
        "proof_evidence_sha256":{"type":"null"},
        "proof_checker_receipt_sha256":{"type":"null"},
        "refutation_evidence_sha256":{"$ref":"#/$defs/sha256"},
        "refutation_checker_receipt_sha256":{"$ref":"#/$defs/sha256"}
      }}
    },
    {
      "if":{"properties":{"outcome":{"const":"invalid_specification"}},"required":["outcome"]},
      "then":{"properties":{
        "specification_review_status":{"const":"invalid"},
        "specification_review_receipt_sha256":{"$ref":"#/$defs/sha256"},
        "proof_evidence_sha256":{"type":"null"},
        "refutation_evidence_sha256":{"type":"null"}
      }}
    },
    {
      "if":{"properties":{"outcome":{"const":"differential_mismatch"}},"required":["outcome"]},
      "then":{"properties":{"differential_validation_status":{"const":"failed"}}}
    }
  ],
  "$defs":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
