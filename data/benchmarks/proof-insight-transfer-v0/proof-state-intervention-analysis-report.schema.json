{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/data/benchmarks/proof-insight-transfer-v0/proof-state-intervention-analysis-report.schema.json",
  "title": "PITB Proof-State Intervention Analysis Report v0",
  "description": "Strict output contract for the deterministic state-intervention analyzer. The report is descriptive and the confirmatory decision cannot be pass.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "dataset_kind",
    "split",
    "suite_sha256",
    "outcomes_sha256",
    "analyzer_source_sha256",
    "bootstrap",
    "counts",
    "metrics",
    "resource_usage",
    "limitations",
    "confirmatory_decision"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.proof-state-intervention-analysis.v0"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_kind": {
      "enum": [
        "synthetic_fixture",
        "reviewed_benchmark"
      ]
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test",
        "external_challenge"
      ]
    },
    "suite_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcomes_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "replicates",
        "seed",
        "interval",
        "note"
      ],
      "properties": {
        "unit": {
          "const": "component_id"
        },
        "replicates": {
          "type": "integer",
          "minimum": 1000
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "interval": {
          "const": "percentile_95"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases_in_split",
        "rows_in_split",
        "executed_rows_in_split",
        "not_run_rows_in_split",
        "expected_eligible_rows",
        "expected_not_applicable_rows",
        "uncertain_judgments",
        "checked_success_rows",
        "checked_failure_rows",
        "semantic_gate_pass_rows",
        "semantic_gate_failed_rows",
        "semantic_gate_unknown_rows"
      ],
      "properties": {
        "cases_in_split": {
          "type": "integer",
          "minimum": 0
        },
        "rows_in_split": {
          "type": "integer",
          "minimum": 0
        },
        "executed_rows_in_split": {
          "type": "integer",
          "minimum": 0
        },
        "not_run_rows_in_split": {
          "type": "integer",
          "minimum": 0
        },
        "expected_eligible_rows": {
          "type": "integer",
          "minimum": 0
        },
        "expected_not_applicable_rows": {
          "type": "integer",
          "minimum": 0
        },
        "uncertain_judgments": {
          "type": "integer",
          "minimum": 0
        },
        "checked_success_rows": {
          "type": "integer",
          "minimum": 0
        },
        "checked_failure_rows": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_gate_pass_rows": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_gate_failed_rows": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_gate_unknown_rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "numerator",
          "denominator",
          "estimate",
          "independent_components",
          "confidence_interval_95"
        ],
        "properties": {
          "numerator": {
            "type": "integer",
            "minimum": 0
          },
          "denominator": {
            "type": "integer",
            "minimum": 0
          },
          "independent_components": {
            "type": "integer",
            "minimum": 0
          },
          "estimate": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence_interval_95": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "status",
              "lower",
              "upper"
            ],
            "properties": {
              "method": {
                "const": "component_clustered_percentile_bootstrap"
              },
              "status": {
                "enum": [
                  "not_reported_no_observations",
                  "suppressed_insufficient_independent_components",
                  "suppressed_degenerate_interval",
                  "reported_descriptive_interval"
                ]
              },
              "lower": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "upper": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "confidence_interval_95": {
                  "properties": {
                    "status": {
                      "const": "reported_descriptive_interval"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              },
              "required": [
                "confidence_interval_95"
              ]
            },
            "then": {
              "properties": {
                "independent_components": {
                  "minimum": 20
                },
                "confidence_interval_95": {
                  "properties": {
                    "lower": {
                      "type": "number"
                    },
                    "upper": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "confidence_interval_95": {
                  "properties": {
                    "status": {
                      "const": "suppressed_degenerate_interval"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              },
              "required": [
                "confidence_interval_95"
              ]
            },
            "then": {
              "properties": {
                "independent_components": {
                  "minimum": 20
                },
                "estimate": {
                  "type": "number"
                },
                "confidence_interval_95": {
                  "properties": {
                    "lower": {
                      "type": "null"
                    },
                    "upper": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "confidence_interval_95": {
                  "properties": {
                    "status": {
                      "const": "suppressed_insufficient_independent_components"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              },
              "required": [
                "confidence_interval_95"
              ]
            },
            "then": {
              "properties": {
                "independent_components": {
                  "minimum": 1,
                  "maximum": 19
                },
                "estimate": {
                  "type": "number"
                },
                "confidence_interval_95": {
                  "properties": {
                    "lower": {
                      "type": "null"
                    },
                    "upper": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "confidence_interval_95": {
                  "properties": {
                    "status": {
                      "const": "not_reported_no_observations"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              },
              "required": [
                "confidence_interval_95"
              ]
            },
            "then": {
              "properties": {
                "denominator": {
                  "const": 0
                },
                "independent_components": {
                  "const": 0
                },
                "estimate": {
                  "type": "null"
                },
                "confidence_interval_95": {
                  "properties": {
                    "lower": {
                      "type": "null"
                    },
                    "upper": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed_rows_with_usage",
        "totals",
        "mean_per_executed_row"
      ],
      "properties": {
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_calls",
            "input_tokens",
            "output_tokens",
            "wall_time_ms",
            "cost_microusd"
          ],
          "properties": {
            "model_calls": {
              "type": "integer",
              "minimum": 0
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "wall_time_ms": {
              "type": "integer",
              "minimum": 0
            },
            "cost_microusd": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "mean_per_executed_row": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model_calls",
                "input_tokens",
                "output_tokens",
                "wall_time_ms",
                "cost_microusd"
              ],
              "properties": {
                "model_calls": {
                  "type": "number",
                  "minimum": 0
                },
                "input_tokens": {
                  "type": "number",
                  "minimum": 0
                },
                "output_tokens": {
                  "type": "number",
                  "minimum": 0
                },
                "wall_time_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "cost_microusd": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "executed_rows_with_usage": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confirmatory_decision": {
      "enum": [
        "not_evaluated_synthetic_fixture",
        "not_evaluated_incomplete_execution_coverage",
        "not_evaluated_requires_preregistered_protocol_independent_receipts_and_review"
      ]
    },
    "analyzer_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
