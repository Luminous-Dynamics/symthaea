{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/data/benchmarks/proof-insight-transfer-v0/component-split-feasibility-report-v0.schema.json",
  "title": "PITB Component Split Feasibility Diagnostic v0",
  "description": "Outcome-blind structural diagnostic; never authorizes confirmatory analysis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "candidate_dataset_kind",
    "candidate_split_sha256",
    "source_component_manifest_sha256",
    "candidate_partition_digest_sha256",
    "eligibility_census_sha256",
    "family_universe_sha256",
    "eligibility_policy_sha256",
    "dataset_kind",
    "outcomes_used",
    "family_count",
    "component_count",
    "component_count_by_split",
    "eligible_component_count_by_split",
    "eligible_target_count_by_split",
    "excluded_target_count_by_split",
    "unknown_target_count_by_split",
    "minimum_eligible_components_per_validation_and_test",
    "heldout_structural_floor_met",
    "unknown_eligibility_present",
    "structurally_feasible_for_power_planning",
    "qualified_for_confirmatory_use",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.component-split-feasibility-report.v0"
    },
    "status": {
      "const": "diagnostic_only"
    },
    "candidate_split_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_partition_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "eligibility_census_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "family_universe_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "eligibility_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "dataset_kind": {
      "enum": [
        "synthetic_fixture",
        "reviewed_census"
      ]
    },
    "outcomes_used": {
      "const": false
    },
    "family_count": {
      "type": "integer",
      "minimum": 1
    },
    "component_count": {
      "type": "integer",
      "minimum": 1
    },
    "component_count_by_split": {
      "$ref": "#/$defs/splitCounts"
    },
    "eligible_component_count_by_split": {
      "$ref": "#/$defs/splitCounts"
    },
    "eligible_target_count_by_split": {
      "$ref": "#/$defs/splitCounts"
    },
    "excluded_target_count_by_split": {
      "$ref": "#/$defs/splitCounts"
    },
    "unknown_target_count_by_split": {
      "$ref": "#/$defs/splitCounts"
    },
    "minimum_eligible_components_per_validation_and_test": {
      "const": 20
    },
    "heldout_structural_floor_met": {
      "type": "boolean"
    },
    "unknown_eligibility_present": {
      "type": "boolean"
    },
    "structurally_feasible_for_power_planning": {
      "type": "boolean"
    },
    "qualified_for_confirmatory_use": {
      "const": false
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidate_dataset_kind": {
      "enum": [
        "candidate_only",
        "synthetic_fixture"
      ]
    },
    "source_component_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "splitCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train",
        "validation",
        "test"
      ],
      "properties": {
        "train": {
          "type": "integer",
          "minimum": 0
        },
        "validation": {
          "type": "integer",
          "minimum": 0
        },
        "test": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "candidate_dataset_kind": {
            "const": "synthetic_fixture"
          }
        },
        "required": [
          "candidate_dataset_kind"
        ]
      },
      "then": {
        "properties": {
          "dataset_kind": {
            "const": "synthetic_fixture"
          },
          "structurally_feasible_for_power_planning": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "candidate_dataset_kind": {
            "const": "candidate_only"
          }
        },
        "required": [
          "candidate_dataset_kind"
        ]
      },
      "then": {
        "properties": {
          "dataset_kind": {
            "const": "reviewed_census"
          }
        }
      }
    }
  ]
}
