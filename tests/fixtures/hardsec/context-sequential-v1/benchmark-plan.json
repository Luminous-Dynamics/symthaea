  "aspirational_targets": {
    "p95_delay_reduction_vs_best_reproduced_baseline": 0.2,
    "worst_group_gap_max": 0.03,
    "benign_false_alerts_per_device_hour_max": 0.1,
    "pooled_attack_effect_recall_min": 0.9,
    "invalid_sensor_or_unseen_context_silent_clears_max": 0,
    "incremental_decision_layer_p95_overhead_max": 0.02
  },
  "claim_rules": {
    "conditional_superuniformity_must_be_justified": true,
    "alpha_budget_allocated_across_streams": true,
    "domain_pooling_forbidden": true,
    "random_window_confirmatory_claim_forbidden": true,
    "targets_not_achievements": true
  },
  "reference_implementations": [
    {
      "id": "published_paper_equations_v2",
