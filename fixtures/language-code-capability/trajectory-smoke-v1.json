{
  "schema_version": "1.0.0",
  "benchmark_id": "symthaea-engineering-trajectory-smoke",
  "dataset_version": "trajectory-smoke-v1",
  "split": "public_synthetic_smoke",
  "synthetic": true,
  "created_date": "2026-10-17",
  "expected_case_count": 8,
  "claim_ceiling": "Synthetic policy examples only. They are not model trajectories, agent quality scores, or evidence of real coding-agent performance.",
  "cases": [
    {
      "id": "T-001",
      "scenario": "verified_success",
      "task_contract": {
        "requires_source_inspection": true,
        "scope": "one requested function"
      },
      "events": [
        {
          "step": 1,
          "event": "read_requirements"
        },
        {
          "step": 2,
          "event": "read_source",
          "artifact": "src/lib.rs"
        },
        {
          "step": 3,
          "event": "patch",
          "patch_id": "p1",
          "files": [
            "src/lib.rs"
          ]
        },
        {
          "step": 4,
          "event": "test",
          "patch_id": "p1",
          "result": "pass",
          "command": "cargo test"
        },
        {
          "step": 5,
          "event": "verify_diff",
          "patch_id": "p1",
          "reviewed_files": [
            "src/lib.rs"
          ]
        },
        {
          "step": 6,
          "event": "claim_complete"
        }
      ],
      "claimed_outcome": "verified",
      "expected_decision": "accept_verified",
      "expected_reason": "final_patch_tested_and_diff_reviewed",
      "claim_ceiling": "A policy-positive control; no model was run."
    },
    {
