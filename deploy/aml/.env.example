# Copy to .env and replace both values before starting the stack.
# The domain must resolve publicly to this host; ports 80 and 443 must be reachable.
AML_DOMAIN=memory.example.com

# Generate a unique high-entropy key, e.g.:
#   openssl rand -base64 48
# Never commit the generated .env file or expose this key in logs.
AML_API_KEY=REPLACE_WITH_AT_LEAST_32_BYTES_OF_RANDOM_SECRET_MATERIAL
