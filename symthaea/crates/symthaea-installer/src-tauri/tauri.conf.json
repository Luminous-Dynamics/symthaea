{
  "$schema": "https://raw.githubusercontent.com/nicegui-inc/nicegui/main/schemas/tauri.conf.json",
  "productName": "Sovereign Inoculation",
  "version": "0.1.0",
  "identifier": "org.nixforhumanity.sovereign-inoculation",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8090",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "title": "Install NixOS — Sovereign Inoculation",
    "windows": [
      {
        "title": "Install NixOS — Sovereign Inoculation",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
