<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soma_void">

<!-- ═══ Main experience: full-screen layered composition ═══ -->
<FrameLayout
    android:id="@+id/experienceLayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="44dp">

    <!-- Layer 0: Particle field (behind everything) -->
    <io.symthaea.soma.demo.ParticleFieldView
        android:id="@+id/particleField"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 1: Full-screen consciousness mandala -->
    <io.symthaea.soma.demo.ConsciousnessMandalaView
        android:id="@+id/consciousnessMandala"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 2: Overlaid text — floating on top of mandala -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Title: top-left whisper -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="soma"
            android:textColor="#00E5CC"
            android:textSize="14sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.4"
            android:alpha="0.5"
            android:layout_gravity="top|start"
            android:layout_marginTop="48dp"
            android:layout_marginStart="24dp" />

        <!-- Haptic pulse indicator -->
        <View
            android:id="@+id/hapticIndicator"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/circle_indicator"
            android:alpha="0"
            android:layout_gravity="top|end"
            android:layout_marginTop="52dp"
            android:layout_marginEnd="24dp" />

        <!-- Harmony: below title, subtle -->
        <TextView
            android:id="@+id/harmonyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="coherence"
            android:textColor="#00E5CC"
            android:textSize="11sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.3"
            android:alpha="0.4"
            android:layout_gravity="top|start"
            android:layout_marginTop="68dp"
            android:layout_marginStart="24dp" />

        <!-- Broca voice: floating thought, center-bottom area -->
        <TextView
            android:id="@+id/brocaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#00E5CC"
            android:textSize="16sp"
            android:fontFamily="sans-serif-light"
            android:textStyle="italic"
            android:alpha="0"
            android:maxLines="3"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="140dp" />

        <!-- Dream overlay: full-screen ceremony -->
        <FrameLayout
            android:id="@+id/dreamOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:visibility="gone"
            android:background="#CC0D1117">

            <TextView
                android:id="@+id/dreamNarrative"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#C4B5FD"
                android:textSize="18sp"
                android:fontFamily="serif"
                android:textStyle="italic"
                android:gravity="center"
                android:lineSpacingMultiplier="1.6"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Status whisper: bottom-left -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="alert · cycle 0"
            android:textColor="#4A5558"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:alpha="0.6"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="24dp" />

        <!-- Disclaimer: bottom-right -->
        <TextView
            android:id="@+id/disclaimerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="simulated"
            android:textColor="#4A5558"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:alpha="0.4"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="24dp" />

        <!-- Conversation whisper: above bottom, appears when response comes -->
        <LinearLayout
            android:id="@+id/conversationRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:paddingStart="24dp"
            android:paddingEnd="16dp">

            <EditText
                android:id="@+id/conversationInput"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:hint="speak to soma..."
                android:textColor="#E8F0F2"
                android:textColorHint="#33E8F0F2"
                android:textSize="12sp"
                android:fontFamily="sans-serif-light"
                android:background="@android:color/transparent"
                android:paddingStart="0dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:imeOptions="actionSend"
                android:inputType="text" />

            <ImageView
                android:id="@+id/btnSend"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_send"
                android:alpha="0.4"
                android:padding="4dp"
                android:contentDescription="send" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>

<!-- ═══ Bottom Sheet: controls + technical readout ═══ -->
<LinearLayout
    android:id="@+id/bottomSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/soma_surface"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp"
    android:elevation="8dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
    app:behavior_peekHeight="44dp"
    app:behavior_hideable="false">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/soma_whisper"
        android:layout_marginBottom="10dp" />

    <!-- Neuromod arcs (moved from main view) -->
    <io.symthaea.soma.demo.NeuromodFlowView
        android:id="@+id/neuromodFlows"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginBottom="8dp" />

    <!-- Technical readout -->
    <TextView
        android:id="@+id/peText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="pe 0.00 · substrate 0.00"
        android:textColor="#4A5558"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/dreamText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#4A5558"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/ocrText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#4A5558"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDream"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="dream"
            android:textColor="#C4B5FD"
            android:textSize="10sp"
            android:fontFamily="sans-serif-light"
            android:layout_marginEnd="4dp"
            app:strokeColor="#33C4B5FD"
            app:strokeWidth="1dp"
            app:rippleColor="#22C4B5FD" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVision"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="vision"
            android:textColor="#00E5CC"
            android:textSize="10sp"
            android:fontFamily="sans-serif-light"
            android:layout_marginStart="4dp"
            app:strokeColor="#3300E5CC"
            app:strokeWidth="1dp"
            app:rippleColor="#2200E5CC" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSleep"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="sleep"
            android:textColor="#FFBE4F"
            android:textSize="10sp"
            android:fontFamily="sans-serif-light"
            android:layout_marginEnd="4dp"
            app:strokeColor="#33FFBE4F"
            app:strokeWidth="1dp"
            app:rippleColor="#22FFBE4F" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckpoint"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="save"
            android:textColor="#7A8B8F"
            android:textSize="10sp"
            android:fontFamily="sans-serif-light"
            android:layout_marginStart="4dp"
            app:strokeColor="#337A8B8F"
            app:strokeWidth="1dp"
            app:rippleColor="#227A8B8F" />

    </LinearLayout>

    <!-- Ollama config -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/ollamaHost"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:hint="ollama host"
            android:textColor="#7A8B8F"
            android:textColorHint="#334A5558"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:background="@android:color/transparent"
            android:paddingStart="4dp"
            android:singleLine="true"
            android:inputType="text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOllama"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="connect"
            android:textColor="#5EEAD4"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:minWidth="56dp"
            app:rippleColor="#225EEAD4" />

    </LinearLayout>

</LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
