# Build artifacts
target/
target-test/
symthaea-core/target/

# JS/TS build output and deps (for standalone-repo cleanliness;
# the parent monorepo already gitignores node_modules globally, but
# sync-to-standalone ships symthaea/ without the parent gitignore).
node_modules/
*/node_modules/
dist/
.next/

# Python cache
__pycache__/
__pyphi_cache__/
*.pyc
*.pyo
.pytest_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Environment
.env
.env.local

# Benchmark intermediate files (keep history)
# .benchmark-history/

# Large datasets (keep small ones)
datasets/*.parquet
datasets/*.csv
datasets/*.json

# Nix build
result
result-*

# Rust specific
**/*.rs.bk
Cargo.lock.bak

# Editor backups
*.backup
*.bak
*.orig

# Archives (old code - preserved locally)
.archive/
archive/

