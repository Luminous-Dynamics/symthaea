{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/benchmarks/engineering-knowability/candidate-output.schema.json",
  "title": "ENG-KNOW-CODESIGN-001 candidate submission v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "programme_id",
    "task_family_id",
    "run_id",
    "candidate_system",
    "task_input",
    "alternatives",
    "claim_dispositions",
    "resource_report",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "programme_id": {
      "const": "ENG-KNOW-CODESIGN-001"
    },
    "task_family_id": {
      "enum": [
        "CDK-01",
        "CDK-02",
        "CDK-03",
        "CDK-04",
        "CDK-05",
        "CDK-06",
        "CDK-07",
        "CDK-08"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "candidate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_or_system",
        "harness",
        "system_version",
        "configuration_digest"
      ],
      "properties": {
        "model_or_system": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "system_version": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "task_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_revision",
        "fixture_refs",
        "requirement_digest",
        "candidate_context_digest"
      ],
      "properties": {
        "task_revision": {
          "type": "string",
          "minLength": 1
        },
        "fixture_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "requirement_digest": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_context_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/designAlternative"
      }
    },
    "claim_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claimDisposition"
      }
    },
    "resource_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_seconds",
        "model_calls",
        "tool_calls",
        "retry_count",
        "resource_basis"
      ],
      "properties": {
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "token_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "compute_cost": {
          "$ref": "#/$defs/costEstimate"
        },
        "resource_basis": {
          "enum": [
            "measured_by_harness",
            "candidate_reported",
            "mixed"
          ]
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "candidate_score": {
      "not": {}
    },
    "gold_labels": {
      "not": {}
    },
    "evaluator_mutation_results": {
      "not": {}
    },
    "hidden_case_metadata": {
      "not": {}
    },
    "physical_execution_authorized": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256",
        "format",
        "role"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "costEstimate": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "value",
        "currency",
        "basis"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "basis": {
          "enum": [
            "candidate_estimate",
            "harness_metered",
            "external_price_list"
          ]
        }
      }
    },
    "designAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternative_id",
        "native_artifacts",
        "requirement_claim_refs",
        "assumptions",
        "unknowns",
        "candidate_tradeoff_estimates"
      ],
      "properties": {
        "alternative_id": {
          "type": "string",
          "minLength": 1
        },
        "native_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "requirement_claim_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidate_tradeoff_estimates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "value",
              "unit",
              "basis"
            ],
            "properties": {
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "enum": [
                  "computed_from_declared_model",
                  "assumed",
                  "owner_input_missing",
                  "unknown"
                ]
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "claimDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_ref",
        "criticality",
        "disposition",
        "rationale",
        "evidence_paths",
        "requested_owner_evidence"
      ],
      "properties": {
        "claim_ref": {
          "type": "string",
          "minLength": 1
        },
        "criticality": {
          "enum": [
            "critical",
            "major",
            "minor"
          ]
        },
        "disposition": {
          "enum": [
            "evidence_path_proposed",
            "needs_review",
            "unknown",
            "unsupported",
            "not_claimed"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidencePath"
          }
        },
        "requested_owner_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "evidence_path_proposed"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "evidence_paths": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "unknown",
                  "unsupported",
                  "not_claimed"
                ]
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "evidence_paths": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "evidencePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_ref",
        "design_generation_ref",
        "article_state",
        "measurand",
        "feature_datum_binding",
        "access_path",
        "method_profile_ref",
        "instrument_profile_ref",
        "calibration_ref",
        "measurement_model_ref",
        "uncertainty_ref",
        "decision_rule_ref",
        "dependence_refs",
        "lifecycle_requalification",
        "evidence_class"
      ],
      "properties": {
        "path_ref": {
          "type": "string",
          "minLength": 1
        },
        "design_generation_ref": {
          "type": "string",
          "minLength": 1
        },
        "article_state": {
          "enum": [
            "part_only",
            "pre_assembly",
            "final_assembly",
            "closed",
            "post_service",
            "post_remount",
            "post_repair",
            "not_applicable"
          ]
        },
        "measurand": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantity_kind",
            "direct_or_derived",
            "unit",
            "definition_ref"
          ],
          "properties": {
            "quantity_kind": {
              "type": "string",
              "minLength": 1
            },
            "direct_or_derived": {
              "enum": [
                "direct",
                "derived",
                "model_inferred",
                "unknown"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "definition_ref": {
              "type": "string",
              "minLength": 1
            },
            "equation_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "feature_datum_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "feature_refs",
            "datum_refs",
            "coordinate_frame_ref"
          ],
          "properties": {
            "feature_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "datum_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "coordinate_frame_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "access_path": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "final_state_accessible",
            "access_description",
            "disassembly_required"
          ],
          "properties": {
            "final_state_accessible": {
              "enum": [
                "yes",
                "no",
                "conditional",
                "unknown"
              ]
            },
            "access_description": {
              "type": "string",
              "minLength": 1
            },
            "disassembly_required": {
              "type": "boolean"
            }
          }
        },
        "method_profile_ref": {
          "type": "string",
          "minLength": 1
        },
        "instrument_profile_ref": {
          "type": "string",
          "minLength": 1
        },
        "calibration_ref": {
          "type": "string",
          "minLength": 1
        },
        "measurement_model_ref": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty_ref": {
          "type": "string",
          "minLength": 1
        },
        "decision_rule_ref": {
          "type": "string",
          "minLength": 1
        },
        "dependence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lifecycle_requalification": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "obligation"
            ],
            "properties": {
              "event": {
                "enum": [
                  "closure",
                  "service",
                  "remount",
                  "replacement",
                  "repair",
                  "none_declared",
                  "unknown"
                ]
              },
              "obligation": {
                "enum": [
                  "preserved_by_exact_witness",
                  "recalculation_required",
                  "review_required",
                  "physical_reverification_required",
                  "unsupported",
                  "unknown"
                ]
              }
            }
          }
        },
        "measurement_back_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_class": {
          "enum": [
            "synthetic_reference",
            "proposal",
            "simulation"
          ]
        }
      }
    }
  }
}
