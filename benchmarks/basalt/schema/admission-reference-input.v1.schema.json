{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BASALT admission reference evaluator input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "expected_binding",
    "capsule"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "expected_binding": {
      "$ref": "#/$defs/binding"
    },
    "capsule": {
      "$ref": "#/$defs/capsule"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,128}$"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "required_obligations"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "profile_version": {
          "type": "integer",
          "minimum": 1
        },
        "required_obligations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "optional_obligations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "subject_digest",
        "intended_use_id",
        "context_digest",
        "policy_digest"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/identifier"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "intended_use_id": {
          "$ref": "#/$defs/identifier"
        },
        "context_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outcome",
        "reason_code"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "outcome": {
          "enum": [
            "valid",
            "invalid",
            "unknown"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "oneOf": [
        {
          "properties": {
            "outcome": {
              "const": "valid"
            }
          },
          "required": [
            "evidence_ref"
          ]
        },
        {
          "properties": {
            "outcome": {
              "enum": [
                "invalid",
                "unknown"
              ]
            }
          }
        }
      ]
    },
    "capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile_id",
        "profile_version",
        "binding",
        "obligations"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "profile_version": {
          "type": "integer",
          "minimum": 1
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evaluation"
          }
        }
      }
    }
  }
}
