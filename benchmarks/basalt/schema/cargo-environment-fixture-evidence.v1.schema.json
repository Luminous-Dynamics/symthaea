{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"BASALT Cargo build-script environment fixture evidence v1",
  "type":"object","additionalProperties":false,
  "required":[
    "format_version","suite_id","run_id","case_id","resource_id","environment_variable_name",
    "before_value_commitment","after_value_commitment","catalog_digest","fixture_digest",
    "cargo_binary_digest","cargo_version","rustc_launcher_digest","rustc_sysroot_binary_digest",
    "rustc_version","rustc_sysroot","path_environment_digest","cargo_home_relative_path",
    "cargo_configuration_policy","ancestor_cargo_config_absent","workspace_relative_path",
    "git_baseline_commit","hidden_build_script_digest","hidden_rerun_env_variables",
    "declared_build_script_digest","declared_rerun_env_variables","hidden_baseline",
    "hidden_warm_after_environment_change","hidden_fresh_after_environment_change",
    "declared_baseline","declared_warm_after_environment_change","hidden_cached_stale_output",
    "declared_control_detected_change","fresh_replay_detected_change","ground_truth_basis",
    "raw_environment_values_stored","independent_kernel_observation","qualification_eligible"
  ],
  "properties":{
    "format_version":{"const":1},"suite_id":{"const":"basalt-cargo-environment-fixture-evidence-v1"},
    "run_id":{"type":"string","pattern":"^basalt-cargo-env-[0-9]+-[0-9]+$"},
    "case_id":{"const":"cargo-build-script-env-input"},
    "resource_id":{"const":"env:BASALT_BUILD_INPUT"},
    "environment_variable_name":{"const":"BASALT_BUILD_INPUT"},
    "before_value_commitment":{"$ref":"#/$defs/digest"},"after_value_commitment":{"$ref":"#/$defs/digest"},
    "catalog_digest":{"$ref":"#/$defs/digest"},"fixture_digest":{"$ref":"#/$defs/digest"},
    "cargo_binary_digest":{"$ref":"#/$defs/digest"},"cargo_version":{"type":"string","minLength":1,"maxLength":128},
    "rustc_launcher_digest":{"$ref":"#/$defs/digest"},"rustc_sysroot_binary_digest":{"$ref":"#/$defs/digest"},
    "rustc_version":{"type":"string","minLength":1,"maxLength":2048},"rustc_sysroot":{"type":"string","minLength":1,"maxLength":1024},
    "path_environment_digest":{"$ref":"#/$defs/digest"},"cargo_home_relative_path":{"const":"cargo-home"},
    "cargo_configuration_policy":{"const":"isolated_empty_cargo_home_no_ancestor_dot_cargo_config"},
    "ancestor_cargo_config_absent":{"const":true},"workspace_relative_path":{"const":"workspace"},
    "git_baseline_commit":{"type":"string","pattern":"^[a-f0-9]{40,64}$"},
    "hidden_build_script_digest":{"$ref":"#/$defs/digest"},"hidden_rerun_env_variables":{"type":"array","maxItems":0},
    "declared_build_script_digest":{"$ref":"#/$defs/digest"},"declared_rerun_env_variables":{"const":["BASALT_BUILD_INPUT"]},
    "hidden_baseline":{"$ref":"#/$defs/execution"},"hidden_warm_after_environment_change":{"$ref":"#/$defs/execution"},
    "hidden_fresh_after_environment_change":{"$ref":"#/$defs/execution"},"declared_baseline":{"$ref":"#/$defs/execution"},
    "declared_warm_after_environment_change":{"$ref":"#/$defs/execution"},
    "hidden_cached_stale_output":{"const":true},"declared_control_detected_change":{"const":true},
    "fresh_replay_detected_change":{"const":true},"ground_truth_basis":{"type":"string","minLength":1},
    "raw_environment_values_stored":{"const":false},"independent_kernel_observation":{"const":false},
    "qualification_eligible":{"const":false}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "execution":{
      "type":"object","additionalProperties":false,
      "required":["stage","package","target_directory","cargo_process_id","exit_code","stdout_digest","stderr_digest"],
      "properties":{
        "stage":{"enum":["hidden_baseline","hidden_warm_after_environment_change","hidden_fresh_after_environment_change","declared_baseline","declared_warm_after_environment_change"]},
        "package":{"enum":["env-hidden","env-declared"]},
        "target_directory":{"type":"string","minLength":1,"maxLength":512},
        "cargo_process_id":{"type":"integer","minimum":1},"exit_code":{"const":0},
        "stdout_digest":{"$ref":"#/$defs/digest"},"stderr_digest":{"$ref":"#/$defs/digest"}
      }
    }
  }
}
