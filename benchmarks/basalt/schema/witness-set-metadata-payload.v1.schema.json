{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/basalt/witness-set-metadata-payload.v1.schema.json",
  "title": "BASALT witness set and trust metadata payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "authority_id",
    "witness_set_id",
    "witness_set_version",
    "previous_witness_set_digest",
    "trust_root_version",
    "fault_tolerance",
    "member_count",
    "write_quorum",
    "read_quorum",
    "signature_algorithm_policy",
    "members"
  ],
  "properties": {
    "record_type": { "const": "basalt.authority.witness-set-metadata" },
    "schema_version": { "const": 1 },
    "authority_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "witness_set_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "witness_set_version": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "previous_witness_set_digest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "trust_root_version": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "fault_tolerance": { "type": "integer", "minimum": 0 },
    "member_count": { "type": "integer", "minimum": 1 },
    "write_quorum": { "type": "integer", "minimum": 1 },
    "read_quorum": { "type": "integer", "minimum": 1 },
    "signature_algorithm_policy": { "const": "from-pinned-trust-metadata; never selected from an untrusted envelope" },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member_id",
          "keyid",
          "algorithm",
          "public_key",
          "administrative_domain",
          "status"
        ],
        "properties": {
          "member_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "keyid": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "algorithm": { "enum": ["ed25519"] },
          "public_key": {
            "type": "string",
            "minLength": 43,
            "maxLength": 44,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          },
          "administrative_domain": { "type": "string", "minLength": 1, "maxLength": 128 },
          "status": { "enum": ["active", "revoked"] }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
