{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/sfeb/leptos-pattern-v1.schema.json",
  "title": "Symthaea Leptos Knowledge Pattern v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_version",
    "corpus_id",
    "status",
    "framework",
    "scope",
    "patterns",
    "promotion_policy"
  ],
  "properties": {
    "corpus_version": {
      "type": "string"
    },
    "corpus_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "source_observed",
        "reference_checked",
        "compiled",
        "unit_tested",
        "browser_verified"
      ]
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "api_family",
        "rendering_model",
        "dependency_requirement",
        "source_commit",
        "compile_status"
      ],
      "properties": {
        "name": {
          "const": "Leptos"
        },
        "api_family": {
          "type": "string"
        },
        "rendering_model": {
          "enum": [
            "csr",
            "ssr",
            "ssr_hydrate",
            "islands"
          ]
        },
        "dependency_requirement": {
          "type": "string"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "compile_status": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starter_surface",
        "complementary_surface",
        "objective",
        "limitations"
      ],
      "properties": {
        "starter_surface": {
          "type": "string"
        },
        "complementary_surface": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pattern"
      }
    },
    "promotion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statuses",
        "required_evidence",
        "rule"
      ],
      "properties": {
        "statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "required_evidence": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "rule": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "concept",
        "code",
        "source",
        "evidence_status",
        "use_when",
        "avoid",
        "tests_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "concept": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "blob_sha"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "blob_sha": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{40}$"
            },
            "related_sources": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/source_ref"
              }
            }
          }
        },
        "evidence_status": {
          "enum": [
            "source_observed_not_compiled",
            "source_observed_reference_checked",
            "compiled",
            "unit_tested",
            "browser_verified"
          ]
        },
        "use_when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests_required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "blob_sha"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "blob_sha": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        }
      }
    }
  }
}
