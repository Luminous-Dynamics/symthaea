{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/sfeb/pattern-retrieval-v1.schema.json",
  "title": "SFEB Pattern Retrieval Evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "corpus", "corpus_version", "exposure", "purpose", "queries", "metrics", "baselines", "controls", "notes"],
  "properties": {
    "schema": {"const": "sfeb-leptos-pattern-retrieval-v1"},
    "version": {"type": "string"},
    "status": {"enum": ["specification_only", "runnable", "baseline_measured", "holdout_qualified"]},
    "corpus": {"type": "string"},
    "corpus_version": {"type": "string"},
    "exposure": {"enum": ["public_pilot", "controller_only", "hidden_holdout"]},
    "purpose": {"type": "string", "minLength": 1},
    "queries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/query"}},
    "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "baselines": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "controls": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "query", "expected_pattern_ids", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]*$"},
        "query": {"type": "string", "minLength": 12, "maxLength": 1000},
        "expected_pattern_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "kind": {"enum": ["positive", "hard_negative"]}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "positive"}}, "required": ["kind"]},
          "then": {"properties": {"expected_pattern_ids": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"kind": {"const": "hard_negative"}}, "required": ["kind"]},
          "then": {"properties": {"expected_pattern_ids": {"maxItems": 0}}}
        }
      ]
    }
  }
}

