{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/sfeb/qualification-report-v1.schema.json",
  "title": "SFEB Qualification Execution Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_id",
    "campaign_id",
    "campaign_sha256",
    "baseline_source_commit",
    "runner_revision",
    "environment_manifest_sha256",
    "artifact_root",
    "browser_build",
    "os_image",
    "started_at",
    "finished_at",
    "case_results"
  ],
  "properties": {
    "schema": {
      "const": "sfeb-qualification-report-v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^SFEB-QUAL-RUN-[A-Za-z0-9._-]+$"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^SFEB-QUAL-[0-9]{3}$"
    },
    "campaign_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "baseline_source_commit": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{40,64}$"
    },
    "runner_revision": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{40,64}$"
    },
    "environment_manifest_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "artifact_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "browser_build": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "os_image": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "case_results": {
      "type": "array",
      "minItems": 30,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "kind": {
          "enum": [
            "screenshot",
            "accessibility",
            "layout"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "disposition",
        "source_commit",
        "fixture_sha256",
        "environment_manifest_sha256",
        "evidence_receipt_path",
        "evidence_receipt_sha256",
        "artifacts",
        "observed_oracle_ids",
        "verified_invariants",
        "semantic_outcome_sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "disposition": {
          "enum": [
            "accepted",
            "rejected",
            "error",
            "inconclusive"
          ]
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{40,64}$"
        },
        "fixture_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "environment_manifest_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "evidence_receipt_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evidence_receipt_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "observed_oracle_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "verified_invariants": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "semantic_outcome_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_kind",
        "task_id",
        "fixture_id",
        "baseline",
        "candidate"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "case_kind": {
          "enum": [
            "mutation",
            "positive_control",
            "metamorphic"
          ]
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "fixture_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "baseline": {
          "$ref": "#/$defs/run"
        },
        "candidate": {
          "$ref": "#/$defs/run"
        }
      }
    }
  }
}
