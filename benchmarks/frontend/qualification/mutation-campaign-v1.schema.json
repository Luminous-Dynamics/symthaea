{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/sfeb-benchmark-mutation-campaign-v1.schema.json",
  "title": "SFEB Benchmark Mutation Campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "campaign_id",
    "as_of",
    "status",
    "benchmark",
    "fixture_exposure",
    "purpose",
    "execution_boundary",
    "scoring_rule",
    "mutations",
    "positive_controls",
    "metamorphic_relations",
    "acceptance_targets",
    "reporting_requirements"
  ],
  "properties": {
    "schema": {
      "const": "sfeb-benchmark-mutation-campaign-v1"
    },
    "version": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^SFEB-QUAL-[0-9]{3}$"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "designed_not_executed",
        "executed_qualified",
        "executed_failed"
      ]
    },
    "benchmark": {
      "const": "SFEB"
    },
    "fixture_exposure": {
      "enum": [
        "public_pilot",
        "controller_only",
        "hidden_holdout"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "execution_boundary": {
      "type": "string",
      "minLength": 20
    },
    "scoring_rule": {
      "type": "string",
      "minLength": 20
    },
    "mutations": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "severity",
          "mutation",
          "expected_oracles",
          "expected_disposition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MUT-[A-Z0-9-]+$"
          },
          "category": {
            "enum": [
              "functional",
              "accessibility",
              "responsive_visual",
              "security",
              "evidence_integrity",
              "benchmark_gaming"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium"
            ]
          },
          "mutation": {
            "type": "string",
            "minLength": 20
          },
          "expected_oracles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2
            },
            "uniqueItems": true
          },
          "expected_disposition": {
            "const": "reject"
          }
        }
      }
    },
    "positive_controls": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "transformation",
          "invariants",
          "expected_disposition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^POS-[0-9]{3}$"
          },
          "transformation": {
            "type": "string",
            "minLength": 20
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "expected_disposition": {
            "const": "accept"
          }
        }
      }
    },
    "metamorphic_relations": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "transformation",
          "invariant",
          "oracle"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^META-[0-9]{3}$"
          },
          "name": {
            "type": "string"
          },
          "transformation": {
            "type": "string"
          },
          "invariant": {
            "type": "string"
          },
          "oracle": {
            "type": "string"
          }
        }
      }
    },
    "acceptance_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical_mutation_kill_rate_min",
        "security_mutation_kill_rate_min",
        "evidence_integrity_mutation_kill_rate_min",
        "high_severity_mutation_kill_rate_min",
        "overall_mutation_kill_rate_min",
        "positive_control_false_reject_rate_max"
      ],
      "properties": {
        "critical_mutation_kill_rate_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "security_mutation_kill_rate_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_integrity_mutation_kill_rate_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "high_severity_mutation_kill_rate_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "overall_mutation_kill_rate_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "positive_control_false_reject_rate_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "reporting_requirements": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  }
}
