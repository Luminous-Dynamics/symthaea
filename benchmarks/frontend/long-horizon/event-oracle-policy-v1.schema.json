{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/sfeb/event-oracle-policy-v1.schema.json",
  "title": "SFEB event oracle policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "version",
    "task_id",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "sfeb-event-oracle-policy-v1"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[A-Z0-9._-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "task_id": {
      "const": "SFEB-PILOT-INT-004"
    },
    "rules": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "required",
          "evaluator",
          "evidence",
          "inconclusive_on_missing"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "informational"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "evaluator": {
            "enum": [
              "strict_event_contract",
              "contiguous_sequence_replay",
              "idempotent_event_identity",
              "pending_action_reconciliation",
              "permission_revocation",
              "clarification_gate",
              "exactly_once_audit"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "inconclusive_on_missing": {
            "const": true
          }
        }
      }
    }
  }
}
