{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/sfeb/monitoring-policy-v1.schema.json",
  "title": "SFEB monitoring policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "version",
    "task_id",
    "case_ids",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "sfeb-monitoring-policy-v1"
    },
    "policy_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "task_id": {
      "const": "SFEB-MON-001"
    },
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "required",
          "evaluator",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "required": {
            "const": true
          },
          "evaluator": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
