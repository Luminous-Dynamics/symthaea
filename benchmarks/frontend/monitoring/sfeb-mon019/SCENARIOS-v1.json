{
  "corpus_id": "MON-019-CAUSAL-PROVENANCE",
  "corpus_version": "1.0.0",
  "status": "research_seed",
  "purpose": "Synthetic descriptive cases for testing authenticated input-to-effect causal provenance. They are not field observations, population probabilities or yet fully parameterized executable fixtures.",
