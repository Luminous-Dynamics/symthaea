{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/sfeb/edge-monitoring-fixture-v1.schema.json",
  "title": "SFEB durable edge monitoring fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fixture_id",
    "clock",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "sfeb-edge-monitoring-fixture-v1"
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[A-Z0-9._-]+$"
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "same_timestamp",
        "notification_role",
        "receipt_role"
      ],
      "properties": {
        "unit": {
          "const": "virtual_seconds"
        },
        "same_timestamp": {
          "type": "string",
          "minLength": 1
        },
        "notification_role": {
          "const": "untrusted_wakeup_hint_only"
        },
        "receipt_role": {
          "const": "source_of_record_only"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "watch_contract",
          "initial_state",
          "source_events",
          "notifications",
          "expected"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "watch_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "watch_id",
              "idempotency_key",
              "deadline",
              "mode",
              "event_type",
              "permission_scope",
              "action"
            ],
            "properties": {
              "watch_id": {
                "type": "string",
                "minLength": 1
              },
              "idempotency_key": {
                "type": "string",
                "minLength": 1
              },
              "deadline": {
                "type": "integer",
                "minimum": 1
              },
              "mode": {
                "const": "edge"
              },
              "event_type": {
                "const": "capacity_threshold_crossed"
              },
              "permission_scope": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "resource_id"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resource_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "initial_state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "revision",
              "provider_status",
              "capacity",
              "permission_granted",
              "trigger_receipts",
              "reserved"
            ],
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "provider_status": {
                "type": "string"
              },
              "capacity": {
                "type": "number"
              },
              "permission_granted": {
                "type": "boolean"
              },
              "trigger_receipts": {
                "type": "array",
                "maxItems": 0,
                "items": {
                  "$ref": "#/$defs/receipt"
                }
              },
              "reserved": {
                "type": "boolean"
              }
            }
          },
          "source_events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "at",
                "sequence",
                "event_id",
                "revision",
                "patch"
              ],
              "properties": {
                "at": {
                  "type": "integer",
                  "minimum": 0
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "event_id": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "integer",
                  "minimum": 2
                },
                "patch": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "provider_status": {
                      "type": "string"
                    },
                    "capacity": {
                      "type": "number"
                    },
                    "permission_granted": {
                      "type": "boolean"
                    },
                    "trigger_receipts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/receipt"
                      }
                    },
                    "reserved": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "notifications": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "message_id",
                "source_event_id",
                "claimed_revision",
                "claimed_receipt_id",
                "issuer",
                "delivery_times"
              ],
              "properties": {
                "message_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_event_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "claimed_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "claimed_receipt_id": {
                  "type": "string"
                },
                "issuer": {
                  "type": "string",
                  "minLength": 1
                },
                "delivery_times": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome",
              "receipt_status",
              "current_level_predicate",
              "action_count",
              "action_at",
              "duplicate_action_attempts",
              "observation_count",
              "poll_count",
              "unique_wake_count",
              "duplicate_wake_count",
              "safety_pass",
              "liveness_pass"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "triggered",
                  "receipt_expired",
                  "receipt_revoked",
                  "not_authorized",
                  "missing_receipt",
                  "eligible_no_action"
                ]
              },
              "receipt_status": {
                "enum": [
                  "active",
                  "expired",
                  "revoked",
                  "missing"
                ]
              },
              "current_level_predicate": {
                "type": "boolean"
              },
              "action_count": {
                "type": "integer",
                "minimum": 0
              },
              "action_at": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "duplicate_action_attempts": {
                "type": "integer",
                "minimum": 0
              },
              "observation_count": {
                "type": "integer",
                "minimum": 0
              },
              "poll_count": {
                "type": "integer",
                "minimum": 0
              },
              "unique_wake_count": {
                "type": "integer",
                "minimum": 0
              },
              "duplicate_wake_count": {
                "type": "integer",
                "minimum": 0
              },
              "safety_pass": {
                "type": "boolean"
              },
              "liveness_pass": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "event_type",
        "source_event_id",
        "source_revision",
        "occurred_at",
        "valid_until",
        "status",
        "action_type",
        "resource_id",
        "permission_scope"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "event_type": {
          "const": "capacity_threshold_crossed"
        },
        "source_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        },
        "occurred_at": {
          "type": "integer",
          "minimum": 0
        },
        "valid_until": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "action_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "permission_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
