{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/mon036-recovery-evidence-continuity-input-v1.schema.json",
  "title":"MON-036 Recovery Evidence Continuity Input",
  "type":"object","additionalProperties":false,
  "required":["profile","version","now","ledger","current_states","claims"],
  "properties":{
    "profile":{"const":"mon036-recovery-evidence-continuity-input-v1"},
    "version":{"const":"1.0.0"},
    "now":{"type":"string","format":"date-time"},
    "ledger":{"type":"object","additionalProperties":false,
      "required":["complete","through_sequence","captured_at","expires_at","events"],
      "properties":{
        "complete":{"type":"boolean"},
        "through_sequence":{"type":"integer","minimum":0},
        "head_digest":{"type":"string","pattern":"^$|^[0-9a-f]{64}$"},
        "captured_at":{"type":"string","format":"date-time"},
        "expires_at":{"type":"string","format":"date-time"},
        "events":{"type":"array","maxItems":100000,"items":{"$ref":"#/$defs/event"}}
      },
      "allOf":[
        {"if":{"properties":{"through_sequence":{"const":0}},"required":["through_sequence"]},
         "then":{"properties":{"events":{"maxItems":0},"head_digest":{"const":""}}},
         "else":{"properties":{"events":{"minItems":1},"head_digest":{"$ref":"#/$defs/digest"}}}
      ]
    },
    "current_states":{"type":"array","maxItems":250000,"items":{"$ref":"#/$defs/dependency_state"}},
    "claims":{"type":"array","maxItems":10000,"items":{"$ref":"#/$defs/claim"}}
  },
  "$defs":{
    "identifier":{"type":"string","minLength":1,"maxLength":256,"pattern":"^\\S(?:[^\\r\\n]*\\S)?$"},
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "event":{
      "type":"object","additionalProperties":false,
      "required":["sequence","event_id","kind","occurred_at","digest"],
      "properties":{
        "sequence":{"type":"integer","minimum":1},
        "event_id":{"$ref":"#/$defs/identifier"},
        "dependency_id":{"$ref":"#/$defs/identifier"},
        "kind":{"enum":["dependency_changed","verification_changed","authority_revoked","scope_changed","contradiction","unknown_change"]},
        "before_revision":{"type":"integer","minimum":1},
        "after_revision":{"type":"integer","minimum":1},
        "before_digest":{"$ref":"#/$defs/digest"},
        "after_digest":{"$ref":"#/$defs/digest"},
        "occurred_at":{"type":"string","format":"date-time"},
        "previous_digest":{"type":"string","pattern":"^$|^[0-9a-f]{64}$"},
        "digest":{"$ref":"#/$defs/digest"}
      },
      "allOf":[
        {"if":{"properties":{"kind":{"enum":["dependency_changed","verification_changed"]}},"required":["kind"]},
         "then":{"required":["dependency_id","before_revision","after_revision","before_digest","after_digest"]}},
        {"if":{"properties":{"kind":{"enum":["authority_revoked","scope_changed","contradiction"]}},"required":["kind"]},
         "then":{"required":["dependency_id"]}},
        {"if":{"properties":{"sequence":{"const":1}},"required":["sequence"]},
         "then":{"properties":{"previous_digest":{"const":""}}},
         "else":{"required":["previous_digest"],"properties":{"previous_digest":{"$ref":"#/$defs/digest"}}}
      ]
    },
    "dependency_binding":{
      "type":"object","additionalProperties":false,
      "required":["dependency_id","revision","digest"],
      "properties":{"dependency_id":{"$ref":"#/$defs/identifier"},"revision":{"type":"integer","minimum":1},"digest":{"$ref":"#/$defs/digest"}}
    },
    "dependency_state":{
      "type":"object","additionalProperties":false,
      "required":["dependency_id","revision","digest"],
      "properties":{"dependency_id":{"$ref":"#/$defs/identifier"},"revision":{"type":"integer","minimum":1},"digest":{"$ref":"#/$defs/digest"}}
    },
    "claim":{
      "type":"object","additionalProperties":false,
      "required":["claim_id","evidence_id","evidence_grade","closure_complete","observed_through_sequence","observed_at","expires_at","support"],
      "properties":{
        "claim_id":{"$ref":"#/$defs/identifier"},
        "evidence_id":{"$ref":"#/$defs/identifier"},
        "evidence_grade":{"enum":["runtime_independently_verified","structurally_checked","synthetic"]},
        "closure_complete":{"type":"boolean"},
        "observed_through_sequence":{"type":"integer","minimum":0},
        "observed_through_digest":{"type":"string","pattern":"^$|^[0-9a-f]{64}$"},
        "observed_at":{"type":"string","format":"date-time"},
        "expires_at":{"type":"string","format":"date-time"},
        "support":{"type":"array","minItems":1,"maxItems":2000,"items":{"$ref":"#/$defs/dependency_binding"}}
      },
      "allOf":[
        {"if":{"properties":{"observed_through_sequence":{"const":0}},"required":["observed_through_sequence"]},
         "then":{"properties":{"observed_through_digest":{"const":""}}},
         "else":{"required":["observed_through_digest"],"properties":{"observed_through_digest":{"$ref":"#/$defs/digest"}}}
      ]
    }
  }
}
