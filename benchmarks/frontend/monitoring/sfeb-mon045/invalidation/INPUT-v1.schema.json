{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mon045-evidence-dependency-input-v1.json",
  "title": "MON-045 Evidence Dependency Graph Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "version",
    "mode",
    "evaluated_at",
    "allowed_future_skew_seconds",
    "nodes",
    "edges",
    "root_claim_ids"
  ],
  "properties": {
    "profile": {
      "const": "mon045-evidence-dependency-input-v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": [
        "offline_fixture",
        "runtime_candidate"
      ]
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "allowed_future_skew_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "root_claim_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "digest",
        "declared_verdict",
        "issuer_id",
        "issued_at",
        "valid_until",
        "authenticated"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "evidence",
            "capability",
            "scope",
            "policy",
            "claim"
          ]
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "declared_verdict": {
          "enum": [
            "qualified",
            "blocked",
            "indeterminate"
          ]
        },
        "issuer_id": {
          "$ref": "#/$defs/id"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_at": {
          "type": "string",
          "format": "date-time"
        },
        "authenticated": {
          "type": "boolean"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prerequisite_id",
        "dependent_id",
        "relation",
        "expected_sha256"
      ],
      "properties": {
        "prerequisite_id": {
          "$ref": "#/$defs/id"
        },
        "dependent_id": {
          "$ref": "#/$defs/id"
        },
        "relation": {
          "enum": [
            "requires",
            "context"
          ]
        },
        "expected_sha256": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        }
      }
    }
  }
}