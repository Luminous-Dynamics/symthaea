{
  "corpus_id": "MON-018-AUTHORITY-EVIDENCE",
  "corpus_version": "1.0.0",
  "status": "research_seed",
  "purpose": "Synthetic known-answer cases for testing exact Mycelix authority-to-MON action composition. These cases are not field observations or security probabilities.",
