{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mon027-signing-request-v1.schema.json",
  "title": "MON-027 Detached Signing Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "version",
    "request_id",
    "run_id",
    "sequence",
    "root_sha256",
    "algorithm",
    "key_id",
    "message_base64",
    "created_at"
  ],
  "properties": {
    "profile": {
      "const": "mon027-detached-signing-request-v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "root_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "key_id": {
      "type": "string",
      "minLength": 1
    },
    "message_base64": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
