{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mon027-input-v1.schema.json",
  "title": "MON-027 Allowlisted Bundle Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "version",
    "run_id",
    "sequence",
    "captured_at",
    "clock_domain",
    "clock_uncertainty_ns",
    "source",
    "signer_key_id",
    "artifacts"
  ],
  "properties": {
    "profile": {
      "const": "mon027-evidence-bundle-input-v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_root_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "clock_domain": {
      "type": "string",
      "minLength": 1
    },
    "clock_uncertainty_ns": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_id",
        "source_cluster_id",
        "database",
        "system_identifier",
        "timeline_id",
        "snapshot_id",
        "capture_lsn",
        "scope_digest",
        "inventory_digest"
      ],
      "properties": {
        "incident_id": {
          "type": "string",
          "minLength": 1
        },
        "source_cluster_id": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "system_identifier": {
          "type": "string",
          "minLength": 1
        },
        "timeline_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "capture_lsn": {
          "type": "string",
          "minLength": 1
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "inventory_digest": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "signer_key_id": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "media_type",
          "role",
          "producer",
          "command_id",
          "collected_at",
          "clock_domain",
          "clock_uncertainty_ns"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "command_id": {
            "type": "string",
            "minLength": 1
          },
          "collected_at": {
            "type": "string",
            "format": "date-time"
          },
          "clock_domain": {
            "type": "string",
            "minLength": 1
          },
          "clock_uncertainty_ns": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
