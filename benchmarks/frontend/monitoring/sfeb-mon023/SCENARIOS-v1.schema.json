{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/benchmarks/frontend/monitoring/sfeb-mon023/SCENARIOS-v1.schema.json",
  "title": "MON-023 Restore-to-Serve Scenario Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_id",
    "corpus_version",
    "status",
    "purpose",
    "scenarios"
  ],
  "properties": {
    "corpus_id": {
      "const": "MON-023-RESTORE-TO-SERVE"
    },
    "corpus_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "research_seed",
        "frozen_confirmatory",
        "retired"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "description",
          "expected_decision",
          "reason_code",
          "required_control",
          "severity",
          "positive_control"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REST-[0-9]{3}$"
          },
          "family": {
            "enum": [
              "artifact",
              "wal",
              "target",
              "database",
              "rpo",
              "rto",
              "dependency",
              "application",
              "traffic",
              "service",
              "isolation",
              "cleanup",
              "lineage"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "expected_decision": {
            "enum": [
              "qualified",
              "denied",
              "indeterminate",
              "divergent"
            ]
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "required_control": {
            "enum": [
              "continue",
              "deny",
              "hold",
              "surface"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium"
            ]
          },
          "positive_control": {
            "type": "boolean"
          }
        }
      }
    }
  }
}