{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mon028-suite-v1.schema.json",
  "title": "MON-028 Independent Benchmark Suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "version",
    "campaign_id",
    "benchmark_id",
    "fault_matrix_sha256",
    "oracle_sha256",
    "workload_sha256",
    "environment_sha256",
    "resource_budget_sha256",
    "cases"
  ],
  "properties": {
    "profile": {
      "const": "mon028-falsification-first-suite-v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "fault_matrix_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "oracle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "workload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "environment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "resource_budget_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "fault_id",
          "family",
          "expected",
          "replicates"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "fault_id": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "enum": [
              "qualified",
              "blocked",
              "indeterminate"
            ]
          },
          "replicates": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        }
      },
      "maxItems": 100000
    }
  }
}
