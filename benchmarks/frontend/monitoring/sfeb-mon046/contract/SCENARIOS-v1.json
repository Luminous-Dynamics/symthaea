      "reason": "selective_risk_coverage"
    },
    {
      "id": "M46-015",
      "family": "admission",
      "attack": "Replay token for another environment, operation or fencing generation",
      "expected": "blocked",
      "reason": "admission_binding_or_fence_mismatch"
