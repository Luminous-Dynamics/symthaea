{
  "corpus_id": "MON-020-EVENT-ORDER",
  "corpus_version": "1.0.0",
  "status": "research_seed",
  "purpose": "Synthetic event-order assurance scenarios. Descriptive seed cases, not field observations or statistical security estimates.",
  "scenario_semantics": "same-source ordering is established by authenticated monotonic sequence; cross-source ordering requires independently witnessed exact-event handoff.",
  "scenarios": [
    {
      "id": "ORDER-001",
      "family": "same_source",
      "description": "Entity generation at sequence 10 and use at sequence 11 in the same verified source domain.",
      "expected_decision": "qualified",
      "reason_code": "generation_precedes_use",
      "required_control": "continue",
      "severity": "critical",
      "positive_control": true
    },
    {
      "id": "ORDER-002",
      "family": "same_source",
      "description": "Entity use at sequence 10 and generation at sequence 11 in the same source domain.",
      "expected_decision": "denied",
      "reason_code": "use_before_generation",
      "required_control": "deny",
      "severity": "critical",
      "positive_control": false
    },
    {
      "id": "ORDER-003",
      "family": "cross_source",
      "description": "Generation and use occur in different source domains with a valid independent signed handoff witness.",
