{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/sfeb/url-state-conformance-v1.schema.json",
  "title": "SFEB URL-state cross-language conformance vectors v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy",
    "valid_states",
    "invalid_states",
    "invalid_urls"
  ],
  "properties": {
    "schema": {
      "const": "sfeb-url-state-conformance-v1"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix",
        "parameter_count",
        "raw_component_characters",
        "reserved_and_non_ascii",
        "state_fields",
        "field_policy",
        "query_case_folding",
        "forbidden_query_controls",
        "safe_integer_max"
      ],
      "properties": {
        "prefix": {
          "const": "?state="
        },
        "parameter_count": {
          "const": 1
        },
        "raw_component_characters": {
          "type": "string"
        },
        "reserved_and_non_ascii": {
          "type": "string"
        },
        "state_fields": {
          "const": [
            "q",
            "category",
            "available_only",
            "min_price_cents",
            "max_price_cents",
            "sort",
            "page",
            "page_size"
          ]
        },
        "field_policy": {
          "type": "string"
        },
        "query_case_folding": {
          "type": "string"
        },
        "forbidden_query_controls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safe_integer_max": {
          "const": 9007199254740991
        }
      }
    },
    "valid_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/state_vector"
      }
    },
    "invalid_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/invalid_state"
      }
    },
    "invalid_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/invalid_url"
      }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q",
        "category",
        "available_only",
        "min_price_cents",
        "max_price_cents",
        "sort",
        "page",
        "page_size"
      ],
      "properties": {
        "q": {
          "type": "string",
          "maxLength": 80
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "available_only": {
          "type": "boolean"
        },
        "min_price_cents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_price_cents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sort": {
          "enum": [
            "name_asc",
            "price_asc",
            "price_desc",
            "stock_asc"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "state_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      }
    },
    "invalid_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "error",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "state": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "invalid_url": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    }
  }
}
