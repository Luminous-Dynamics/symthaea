        "Go to page 2.",
        "Copy state URL and open a fresh session."
      ],
      "oracle": [
        "Page 2 IDs match golden case.",
        "Every state field restores."
      ]
    },
    {
      "id": "inventory.invalid-and-empty-states",
      "goal": "Distinguish invalid ranges from no matches.",
      "steps": [
        "Set min greater than max.",
        "Search quantum."
      ],
      "oracle": [
        "Reversed range rejects.",
        "Valid zero-match state shows empty results."
      ]
