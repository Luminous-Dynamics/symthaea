      "id": "inventory.search-and-filter",
      "goal": "Find available sensors.",
      "steps": [
        "Enter SENSOR.",
        "Select Sensors.",
        "Enable in-stock only.",
        "Apply filters."
      ],
      "oracle": [
        "Only AST-002 and AST-008 appear.",
        "Lowercase sensor preserves result IDs."
      ]
