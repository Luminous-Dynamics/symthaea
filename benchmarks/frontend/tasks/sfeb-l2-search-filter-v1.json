      "id": "inventory.price-sort-and-ties",
      "goal": "Verify inclusive prices and stable ties.",
      "steps": [
        "Set 50000..130000 cents.",
        "Sort price descending.",
        "Filter Devices; sort price ascending."
      ],
      "oracle": [
        "Six assets match.",
        "Equal-price AST-011 precedes AST-013."
      ]
    },
    {
      "id": "inventory.pagination-and-url-state",
