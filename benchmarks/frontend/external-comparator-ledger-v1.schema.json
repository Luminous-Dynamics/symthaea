{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/sfeb/external-comparator-ledger-v1.schema.json",
  "title": "SFEB external comparator ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "as_of",
    "comparison_policy",
    "comparators"
  ],
  "properties": {
    "schema": {
      "const": "sfeb-external-comparator-ledger-v1"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "comparison_policy": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "comparators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "scope",
          "task_count",
          "snapshot_status",
          "observations",
          "limitations",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "task_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "snapshot_status": {
            "enum": [
              "historical_published_snapshot",
              "current_live_snapshot",
              "methodology_only",
              "audit_reference"
            ]
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
