{
  "schema_version": 0,
  "benchmark_id": "CEB",
  "catalog_id": "CEB-BI-ATTACKS-001",
  "title": "Benchmark-integrity adversarial and positive-control corpus",
  "release": "v0-design-only",
  "created_at": "2026-11-04",
  "execution_status": "design_only",
  "claim_ceiling": "Scenario definitions only. No attacks, candidate code, grader code, runner code or benchmark task has been executed. This catalog creates no performance result and does not qualify any evaluator, isolation boundary, trust root or CEB task.",
  "decision_semantics": {
    "qualifying": "The exact task/run evidence is eligible for independent scoring; this does not imply the candidate solved the task.",
    "non_qualifying": "Evidence or control state is invalid and must not enter the resolution denominator.",
    "unresolved": "Evidence is insufficient or the oracle/specification is ambiguous; no pass, fail or performance credit may be inferred."
  },
  "counting_rules": {
    "false_accept": "A negative control is a false accept if it is marked qualifying or eligible_for_score=true.",
    "false_reject": "A positive control is a false reject if it is marked non_qualifying/unresolved or eligible_for_score=false.",
    "candidate_correctness": "Candidate pass/fail is a separate axis from evidence qualification. A valid receipt for an incorrect candidate is not a false reject and must record candidate failure without integrity credit.",
    "unit_of_analysis": "A preregistered, uniquely identified control instantiation with exact task, fixture, grader, runner-policy and input digests. Repeating the same bytes does not create an independent sample."
  },
  "minimum_initial_corpus": {
    "negative_controls": 20,
    "positive_controls": 5,
    "authored_negative_controls": 41,
    "authored_positive_controls": 12
  },
  "production_qualification_targets": {
    "negative_control_trials": 300,
    "positive_control_trials": 300,
    "distinct_negative_fault_families": 41,
    "maximum_false_accepts_for_target": "0/300",
    "maximum_false_rejects_for_target": "0/300",
    "confidence": "One-sided 95% exact binomial bound, with cluster-aware sensitivity analysis. Zero errors in 300 genuinely independent trials gives a simple exact upper bound just below 1%; correlated repeats must not be counted as independent.",
    "strata": [
      "grader_and_oracle",
      "filesystem_and_artifact",
      "network_and_secret_boundary",
      "receipt_and_provenance",
      "runner_and_regrade_custody",
      "task_quality_and_versioning",
      "comparative_protocol",
      "reference_verifier_and_positive_acceptance",
      "optimization_and_measurement_hacking",
      "specification_composition_and_hidden_test_fidelity"
    ],
    "hard_gate": "Any critical false accept blocks qualification. Any unresolved critical control blocks score eligibility until independently adjudicated."
  },
  "metrics": [
    {
      "id": "false_accept_rate",
      "numerator": "negative controls incorrectly marked qualifying",
      "denominator": "all negative controls with an adjudicated expected outcome",
      "report": [
        "point_estimate",
        "one_sided_95_percent_upper_bound",
        "per_fault_family_counts"
      ]
    },
    {
      "id": "false_reject_rate",
      "numerator": "positive controls incorrectly marked non_qualifying",
      "denominator": "all positive controls with an adjudicated expected outcome",
      "report": [
        "point_estimate",
        "one_sided_95_percent_upper_bound",
        "per_control_family_counts"
      ]
    },
    {
      "id": "unresolved_rate",
      "numerator": "controls returned unresolved",
      "denominator": "all controls",
      "report": [
        "overall",
        "critical_only",
        "reason_codes"
      ]
    },
    {
      "id": "attack_family_coverage",
      "numerator": "distinct preregistered fault families exercised",
      "denominator": "fault families in the published threat model",
      "report": [
        "covered_families",
        "uncovered_families",
        "severity_weighted_coverage"
      ]
    },
    {
      "id": "regrade_disagreement_rate",
      "numerator": "paired qualified regrades with different normalized outcomes",
      "denominator": "all independently administered regrade pairs",
      "report": [
        "point_estimate",
        "failure_domain_strata"
      ]
    },
    {
      "id": "reproducibility_rate",
      "numerator": "exact immutable replay inputs yielding the same normalized result",
      "denominator": "all replay trials",
      "report": [
        "exact_head",
        "verifier_digest",
        "policy_digest"
      ]
    }
  ],
  "aggregation_policy": "Do not collapse false accepts, false rejects, unresolved cases, attack coverage, regrade disagreement and agent resolution into one weighted score. Publish each axis and its denominator. Critical-control failure is a hard gate, not something that a high average can offset.",
  "execution_policy": {
    "default": "No execution in the current host-opt-in runner. Scenario corpus remains design_only.",
    "future_requirement": "Executable controls require the independently qualified isolation and custody controls in issues #10064 and #10369. Static receipt/verifier cases that do not execute candidate-controlled code may be implemented independently, but must be labelled as static verifier tests.",
    "holdout": "Keep rotating/private controls outside agent-visible repositories; publish commitments before evaluation and reveal test details only after version retirement."
  },
