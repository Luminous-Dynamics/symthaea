    "Hamiltonian": "H_j = mu_left*n_j + mu_right*n_(j+1) + V*n_j*n_(j+1) + h*|01><10| + conj(h)*|10><01|",
    "gate": "G_j(tau) = exp(-i*tau*H_j)",
