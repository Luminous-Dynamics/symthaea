{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/retrieval-plan-v0.1.schema.json",
  "title": "Candidate-only retrieval plan v0.1",
  "description": "Offline contract for immutable query anchors, typed constraints, and candidate retrieval steps. This schema does not authorize retrieval or network access.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "original_query",
    "original_query_sha256",
    "fallback_query",
    "rewrite_policy",
    "required_anchors",
    "constraints",
    "steps"
  ],
  "properties": {
    "schema_version": { "const": "retrieval-plan-v0.1" },
    "plan_id": { "type": "string", "minLength": 1 },
    "original_query": { "type": "string", "minLength": 1 },
    "original_query_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fallback_query": { "type": "string", "minLength": 1 },
    "rewrite_policy": { "enum": ["original_only", "anchor_preserving"] },
    "required_anchors": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_id", "kind", "text", "match_mode"],
        "properties": {
          "anchor_id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["exact_entity", "identifier", "numeric", "date", "rare_term", "negation", "modality"]
          },
          "text": { "type": "string", "minLength": 1 },
          "match_mode": { "enum": ["exact", "case_insensitive"] }
        }
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint_id", "kind", "value"],
        "properties": {
          "constraint_id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["language", "geography", "valid_time", "known_at", "relation", "source_policy", "rights_policy", "source_family", "domain"]
          },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "query", "required_anchor_ids", "required_constraint_ids"],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "query": { "type": "string", "minLength": 1 },
          "required_anchor_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "required_constraint_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}