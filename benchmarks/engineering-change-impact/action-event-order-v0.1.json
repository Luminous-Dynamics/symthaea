    "ordering_states": [
      "before",
      "after",
      "overlapping",
      "unknown",
      "inconsistent"
    ],
    "stop_rule": "A stop trigger creates an immediate no-new-effect obligation. A qualified stop-obligation discharge ordered after the trigger is required before a later operation start, retry, or irreversible effect can be treated as admissible.",
    "reconciliation_rule": "Cancellation acknowledgement is not terminal operation outcome. Unknown outcomes remain pending; retry requires exact qualified NOT_APPLIED outcome ordered before the retry.",
    "clock_rule": "Wall-clock intervals are comparable only with qualified clock integrity. Monotonic sequences are comparable only within one qualified clock domain. Qualified causal edges can refine overlapping clock intervals; contradictions are inconsistent.",
    "delivery_rule": "Input event-array order is not temporal order. Reordering delivery must not change the result.",
    "discharge_rule": "Stop-obligation discharge is a distinct owner-qualified revalidation event. It cannot precede the trigger, cannot be inferred from candidate narration, and cannot discharge while any operation remains unreconciled."
  },
