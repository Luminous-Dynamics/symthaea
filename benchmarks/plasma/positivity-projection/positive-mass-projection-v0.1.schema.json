{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/benchmarks/plasma/positivity-projection/positive-mass-projection-v0.1.schema.json",
  "title": "Positive mass-constrained kinetic transition fixture v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "input_values",
    "cell_volumes",
    "target_mass",
    "expected",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "input_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "cell_volumes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "target_mass": {
      "type": "number",
      "minimum": 0
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projected_values",
        "achieved_mass",
        "mass_residual",
        "lagrange_multiplier",
        "active_positive_cell_count",
        "weighted_correction_norm",
        "minimum_projected_value"
      ],
      "properties": {
        "projected_values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "achieved_mass": {
          "type": "number",
          "minimum": 0
        },
        "mass_residual": {
          "type": "number"
        },
        "lagrange_multiplier": {
          "type": "number"
        },
        "active_positive_cell_count": {
          "type": "integer",
          "minimum": 0
        },
        "weighted_correction_norm": {
          "type": "number",
          "minimum": 0
        },
        "minimum_projected_value": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mass_constraint_only",
        "does_not_claim_momentum_or_energy",
        "no_physical_solver_run"
      ],
      "properties": {
        "status": {
          "const": "synthetic_known_answer_only"
        },
        "mass_constraint_only": {
          "const": true
        },
        "does_not_claim_momentum_or_energy": {
          "const": true
        },
        "no_physical_solver_run": {
          "const": true
        }
      }
    }
  }
}
