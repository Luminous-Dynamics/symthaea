{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/benchmarks/plasma/topology-lifting/weighted-fourier-measure-v0.1.schema.json",
  "title": "Weighted Fourier empirical-measure embedding fixture v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "status",
    "positions",
    "weights",
    "max_harmonic",
    "expected_normalized_complex_moments",
    "properties_under_test",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "synthetic_analytic_only"
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "number"
      }
    },
    "weights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "max_harmonic": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "expected_normalized_complex_moments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "harmonic",
          "real",
          "imag"
        ],
        "properties": {
          "harmonic": {
            "type": "integer",
            "minimum": 1
          },
          "real": {
            "type": "number"
          },
          "imag": {
            "type": "number"
          }
        }
      }
    },
    "properties_under_test": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finite_fourier_band_is_not_injective",
        "no_field_operator_evaluated",
        "no_physical_plasma_run"
      ],
      "properties": {
        "finite_fourier_band_is_not_injective": {
          "const": true
        },
        "no_field_operator_evaluated": {
          "const": true
        },
        "no_physical_plasma_run": {
          "const": true
        }
      }
    }
  }
}
