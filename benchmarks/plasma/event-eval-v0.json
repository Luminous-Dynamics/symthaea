{
  "schema_version": "luminous.plasma-event-evaluation.v0.1",
  "benchmark_id": "PLASMA-EVENT-EVAL-001",
  "status": "protocol_specification",
  "claim_ceiling": "OFFLINE_EVALUATION_PROTOCOL_ONLY_NOT_PHYSICAL_CONTROL_QUALIFICATION",
  "references": {
    "tokamark_dataset": "https://huggingface.co/datasets/UKAEA-IBM-STFC/tokamark-v1",
    "robustness_repository": "https://github.com/Neerav-Gupta/tokamark-robustness",
    "robustness_reference_commit": "a51d392c34567601c802edac0a614c179683566c",
    "robustness_paper": "https://arxiv.org/abs/2607.11915",
    "baseline_commit_pinned": true,
    "gen_toka_paper": "https://arxiv.org/abs/2611.08153",
    "gen_toka_arxiv_version": "v1, 2026-11-05",
    "tokamind_repository": "https://github.com/UKAEA-IBM-STFC-Fusion-FMs/tokamind",
    "tokamind_repository_commit": "d64fbe3826057576f06d3158592917dd2443a960",
    "tokamark_repository": "https://github.com/UKAEA-IBM-STFC-Fusion-FMs/tokamark",
    "tokamark_repository_commit": "146b0a0f87380bb16817f2e8758e84ce79ed45d0",
    "tokamark_cnn_baseline_repository": "https://github.com/UKAEA-IBM-STFC-Fusion-FMs/tokamark_baseline",
    "tokamark_cnn_baseline_repository_commit": "1e7c489653716a60ffe0b4c2a6a2e51883228695"
  },
  "population_and_split_contract": {
    "primary_split": "exact frozen shot IDs from each published baseline for reproduction; do not regenerate or mix split strategies",
    "all_transforms_fit_on": [
      "train",
      "validation"
    ],
    "thresholds_selected_on": "validation",
    "alarm_persistence_selected_on": "validation",
    "imputation_and_scaling_fit_on": "train",
    "test_is_read_only": true,
    "include_positive_and_negative_shots": true,
    "if_negative_shots_unavailable": "report false-alarm rates as undefined; do not substitute zero",
    "split_tracks": {
      "published_robustness_reproduction": {
        "description": "Reproduce the pinned Neerav-Gupta TokaMark robustness repository against its exact saved test cohort and saved model/data artifacts",
        "repository_commit": "a51d392c34567601c802edac0a614c179683566c",
        "do_not_regenerate_shot_ids": true,
        "test_read_only": true
      },
      "tokamind_gentoka_group6_reproduction": {
        "description": "Reproduce the paper-defined shared Group-6 held-out cohort, window grid, nested input schemas, Soft-TTD labels and validation-selected common threshold",
        "paper": "arXiv:2611.08153v1",
        "test_read_only": true
      },
      "tokamark_temporal_transfer": {
        "description": "Supplementary campaign-shift evaluation using TokaMark temporal split; the two most recent campaigns are held out as test",
        "source": "TokaMind official data-split documentation",
        "repository_commit": "d64fbe3826057576f06d3158592917dd2443a960",
        "use_for_primary_temporal_generalization": true,
        "do_not_mix_with_random_or_paper_cohort": true
      },
      "tokamark_random_split": {
        "description": "Secondary in-distribution random shot split (80/10/10) for comparability with conventional benchmark practice",
        "source": "TokaMind official data-split documentation",
        "use_as_secondary_only": true,
        "do_not_mix_with_temporal_or_paper_cohort": true
      }
    }
  },
  "online_policy_contract": {
    "input_fields": [
      "shot_id",
      "frame_id",
      "frame_time_ns",
      "exact_serialized_input_frame_sha256",
      "risk_score_evidence_schema_version",
      "forecast_horizon_ns",
      "forecast_target_time_ns",
      "model_id",
      "model_revision",
      "model_artifact_sha256",
      "training_split_sha256",
      "calibration_id",
      "calibration_revision",
      "calibration_receipt_sha256",
      "uncertainty_method_id",
      "nominal_interval_coverage",
      "estimate",
      "lower_bound",
      "upper_bound"
    ],
    "allowed_evidence_quality": [
      "direct_measured"
    ],
    "abstain_evidence_quality": [
      "synthetic",
      "unavailable",
      "invalid",
      "delayed",
      "degraded"
    ],
    "strictly_monotonic_window_end": true,
    "event_labels_available_online": false,
    "t_cut_available_online": false,
    "future_windows_available_online": false,
    "full_shot_statistics_available_online": false,
    "test_threshold_optimization": false,
    "active_alarm_cleared_by_missing_data": false,
    "policy_config_fields": [
      "policy_id",
      "score_scale_id",
      "validation_receipt_sha256",
      "trigger_threshold",
      "clear_threshold",
      "trigger_persistence_windows",
      "clear_persistence_windows",
      "required_warning_ns",
      "risk_model_binding",
      "max_warning_ns"
    ],
    "policy_config_sha256": "computed from exact policy ID, score scale ID, validation receipt, threshold bit patterns, persistence counts and required warning interval",
    "risk_score_contract": {
      "required_fields": [
        "shot_id",
        "frame_id",
        "frame_time_ns",
        "input_frame_sha256",
        "horizon_ns",
        "target_time_ns",
        "model_id",
        "model_revision",
        "score_scale_id",
        "model_artifact_sha256",
        "training_split_sha256",
        "calibration_id",
        "calibration_revision",
        "calibration_receipt_sha256",
        "schema_version",
        "uncertainty_method_id",
        "nominal_coverage",
        "estimate",
        "lower_bound",
        "upper_bound"
      ],
      "exact_input_frame_sha256_required": true,
      "model_artifact_sha256_required": true,
      "train_split_and_calibration_receipts_required": true,
      "target_time_must_equal_frame_time_plus_horizon": true,
      "interval_order": "finite_lower_bound <= finite_estimate <= finite_upper_bound",
      "trigger_condition": "lower_bound >= trigger_threshold",
      "clear_condition": "upper_bound <= clear_threshold",
      "uncertainty_straddles_threshold": "return_uncertain_and_preserve_current_alarm_state",
      "uncertainty_breaks_persistence": true,
      "digests_are_content_identity_not_authentication": true,
      "risk_evidence_schema_version": "luminous.plasma-risk-score-evidence.v0.1",
      "uncertainty_method_and_nominal_coverage_required": true,
      "uncertainty_semantics": {
        "trigger": "lower_bound >= trigger_threshold",
        "clear": "upper_bound <= clear_threshold",
        "otherwise": "uncertain; preserve current alert state and reset persistence counters"
      },
      "interval_coverage_claim": "nominal method metadata only; empirical coverage must be reported on held-out data",
      "evidence_digest": "SHA-256 content identity only; not source/model/calibration authenticity proof",
      "threshold_scale_identity": "risk evidence score_scale_id must exactly match frozen policy score_scale_id",
      "policy_config_digest_schema": "luminous.plasma-alarm-policy.v0.4",
      "exact_model_and_calibration_binding_required": true,
      "model_training_split_calibration_uncertainty_must_match_frozen_policy": true
    },
    "policy_config_digest_schema": "luminous.plasma-alarm-policy.v0.5",
    "policy_config_digest_encoding": "length-prefixed UTF-8 fields plus exact IEEE-754 threshold bit patterns; delimiter characters in IDs cannot create ambiguous field boundaries; includes exact model artifact, training split, calibration identity/receipt, uncertainty method and nominal coverage; includes maximum allowed warning lead time",
    "risk_model_binding_fields": [
      "model_id",
      "model_revision",
      "model_artifact_sha256",
      "training_split_sha256",
      "calibration_id",
      "calibration_revision",
      "calibration_receipt_sha256",
      "uncertainty_method_id",
      "nominal_coverage"
    ],
    "rolling_inference_contract": {
      "reference_task": "GenToka/TokaMind Group 6",
      "history_duration_ns": 100000000,
      "cut_interval_ns": 10000000,
      "input_rule": "for each cut time, use only the previous 100 ms of observations strictly before or at that cut",
      "execution_rule": "re-run the fixed model/policy on each chronological cut with updated measured context; do not condition a cut on later windows or t_cut",
      "report": [
        "per_cut_latency_ns",
        "p50_latency_ns",
        "p95_latency_ns",
        "p99_latency_ns",
        "deadline_miss_rate",
        "abstention_rate",
        "alarm_transition_times"
      ],
      "paper_comparison_note": "GenToka uses one conditional pass to generate a complete output window; this benchmark's rolling mode is repeated causal inference at successive cuts, not a claim that the published model itself is autoregressive"
    }
  },
  "offline_scoring_contract": {
    "event_reference_entered_after_trace_generation": true,
    "metrics": [
      "event_tpr",
      "missed_disruptions",
      "false_alarm_shot_rate",
      "false_alarms_per_non_disruptive_shot",
      "false_alarm_events",
      "mean_warning_time",
      "warning_time_p05",
      "warning_time_p10",
      "warning_time_p50",
      "false_alarms_per_non_disruptive_hour",
      "total_non_disruptive_exposure_ns",
      "false_alarm_events_on_disruptive_shots",
      "false_alarm_events_on_non_disruptive_shots"
    ],
    "warning_requirement_ns": 50000000,
    "warning_requirement_is_research_target_not_achieved_result": true,
    "confidence_intervals": "Wilson score 95% intervals for event TPR and false-alarm-shot rate; for multi-machine or event-class subgroup aggregates, add a shot-level stratified bootstrap and report the resampling seed",
    "undefined_metrics": "return null when the denominator cohort is empty",
    "false_alarm_rate_denominators": {
      "per_shot": "false alarm episodes from non-disruptive shots divided by non-disruptive shots; out-of-window episodes on disruptive shots are reported separately",
      "per_hour": "sum of non-disruptive shot exposure durations in hours",
      "alarm_events": "timestamps at which the online policy transitions into Raised"
    },
    "maximum_warning_horizon_source": "validation-selected and frozen in AlarmPolicyConfig.max_warning_ns",
    "alarms_outside_warning_interval": "count as false alarm episodes; they do not satisfy event detection",
    "warning_interval": {
      "minimum_ns": 50000000,
      "maximum_ns": "validation-selected and frozen in policy; must be >= minimum",
      "event_detected_when": "at least one alarm episode has t_cut - alarm_time in [minimum_ns, maximum_ns]",
      "alarm_episode_matching": "exactly one in-window alarm episode may match the disruption; all other episodes are false alarms",
      "too_early": "alarm lead time > max_warning_ns counts as false alarm and cannot satisfy event detection",
      "too_late": "alarm lead time < required_warning_ns counts as false alarm and cannot satisfy event detection"
    }
  },
  "required_ablation_families": [
    "clean",
    "random_dropout_10_25_50_percent",
    "front_acquisition_gap_20_40_60_percent",
    "pre_event_gap_10_25_50_percent",
    "single_channel_ablation",
