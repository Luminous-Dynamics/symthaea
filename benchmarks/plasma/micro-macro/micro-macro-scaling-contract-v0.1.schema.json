{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/benchmarks/plasma/micro-macro/micro-macro-scaling-contract-v0.1.schema.json",
  "title": "High-field VPFP micro–macro scaling contract v0.1",
  "description": "Frozen model scaling, macro variables, discrete micro constraints and limiting equation identity. Schema validation does not establish an AP solver.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "cohort",
    "scaling",
    "macro_contract",
    "micro_contract",
    "collision_contract",
    "limit_contract",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equation_id",
        "dimension",
        "boundary_contract_id",
        "reference_revision"
      ],
      "properties": {
        "equation_id": {
          "const": "high_field_vlasov_poisson_fokker_planck"
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "boundary_contract_id": {
          "type": "string",
          "minLength": 1
        },
        "reference_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nondimensionalization_id",
        "epsilon_definition",
        "epsilon_values",
        "field_scaling_id"
      ],
      "properties": {
        "nondimensionalization_id": {
          "type": "string",
          "minLength": 1
        },
        "epsilon_definition": {
          "type": "string",
          "minLength": 1
        },
        "epsilon_values": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "uniqueItems": true
        },
        "field_scaling_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "macro_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variables",
        "spatial_resolution",
        "retained_full_order",
        "macro_state_sha256"
      ],
      "properties": {
        "variables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "spatial_resolution": {
          "type": "integer",
          "minimum": 2
        },
        "retained_full_order": {
          "const": true
        },
        "macro_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "micro_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis_family",
        "rank",
        "projection_metric_id",
        "constraint_ids",
        "constraint_matrix_sha256",
        "projector_id"
      ],
      "properties": {
        "basis_family": {
          "enum": [
            "POD",
            "response_balanced",
            "local_POD",
            "hybrid"
          ]
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "projection_metric_id": {
          "type": "string",
          "minLength": 1
        },
        "constraint_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraint_matrix_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "projector_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "collision_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_id",
        "discrete_operator_sha256",
        "nullspace_identity_sha256",
        "dissipation_law_id"
      ],
      "properties": {
        "operator_id": {
          "type": "string",
          "minLength": 1
        },
        "discrete_operator_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nullspace_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dissipation_law_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limit_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit_epsilon",
        "limit_model_id",
        "limit_model_sha256",
        "verification_method",
        "status"
      ],
      "properties": {
        "limit_epsilon": {
          "const": 0
        },
        "limit_model_id": {
          "type": "string",
          "minLength": 1
        },
        "limit_model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verification_method": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "UNKNOWN",
            "SYNTHETIC_FIXTURE_ONLY",
            "QUALIFIED"
          ]
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_vpfp_run_performed",
        "asymptotic_preservation_claimed",
        "status"
      ],
      "properties": {
        "physical_vpfp_run_performed": {
          "const": false
        },
        "asymptotic_preservation_claimed": {
          "const": false
        },
        "status": {
          "const": "synthetic_contract_only"
        }
      }
    }
  }
}
