{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/benchmarks/plasma/control-interface/sensor-actuator-timing-contract-v0.1.schema.json",
  "title": "Kinetic sensor and actuator timing contract v0.1",
  "description": "Deployment-interface timing and authority contract for a closed-loop kinetic controller. Schema validation does not establish stabilizability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "cohort",
    "clock",
    "diagnostics",
    "actuators",
    "controller",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equation_id",
        "physics_regime",
        "reference_revision"
      ],
      "properties": {
        "equation_id": {
          "type": "string",
          "minLength": 1
        },
        "physics_regime": {
          "type": "string",
          "minLength": 1
        },
        "reference_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_unit",
        "clock_source_id",
        "maximum_clock_skew_seconds"
      ],
      "properties": {
        "time_unit": {
          "const": "second"
        },
        "clock_source_id": {
          "type": "string",
          "minLength": 1
        },
        "maximum_clock_skew_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "measurement_operator_id",
          "sampling_period_seconds",
          "transport_latency_seconds",
          "timestamp_age_bound_seconds",
          "jitter_bound_seconds",
          "noise_std",
          "dropout_policy"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "measurement_operator_id": {
            "type": "string",
            "minLength": 1
          },
          "sampling_period_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "transport_latency_seconds": {
            "type": "number",
            "minimum": 0
          },
          "timestamp_age_bound_seconds": {
            "type": "number",
            "minimum": 0
          },
          "jitter_bound_seconds": {
            "type": "number",
            "minimum": 0
          },
          "noise_std": {
            "type": "number",
            "minimum": 0
          },
          "dropout_policy": {
            "enum": [
              "hold_last_with_age",
              "predict_with_uncertainty",
              "abstain"
            ]
          }
        }
      }
    },
    "actuators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "actuation_operator_id",
          "update_period_seconds",
          "delivery_delay_seconds",
          "bandwidth_hz",
          "maximum_amplitude",
          "maximum_slew_per_second",
          "saturation_policy"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "actuation_operator_id": {
            "type": "string",
            "minLength": 1
          },
          "update_period_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "delivery_delay_seconds": {
            "type": "number",
            "minimum": 0
          },
          "bandwidth_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maximum_amplitude": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maximum_slew_per_second": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "saturation_policy": {
            "enum": [
              "clip_and_record",
              "reject_command",
              "safe_fallback"
            ]
          }
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_period_seconds",
        "worst_case_execution_seconds",
        "deadline_seconds",
        "full_state_access",
        "maximum_observation_age_seconds",
        "fallback_policy"
      ],
      "properties": {
        "update_period_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "worst_case_execution_seconds": {
          "type": "number",
          "minimum": 0
        },
        "deadline_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "full_state_access": {
          "const": false
        },
        "maximum_observation_age_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fallback_policy": {
          "enum": [
            "safe_hold",
            "safe_shutdown",
            "abstain_and_escalate"
          ]
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_interface_only",
        "closed_loop_experiment_performed",
        "stability_claimed"
      ],
      "properties": {
        "synthetic_interface_only": {
          "const": true
        },
        "closed_loop_experiment_performed": {
          "const": false
        },
        "stability_claimed": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "controller": {
          "properties": {
            "worst_case_execution_seconds": {
              "maximum": 0.05
            }
          }
        }
      }
    }
  ]
}
