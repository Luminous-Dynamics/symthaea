{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/benchmarks/decision-sufficient-evidence/v0.1/oracle-schema.json",
  "title": "Decision-sufficient evidence oracle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "oracle_version",
    "synthetic",
    "status",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "oracle_version": {
      "const": "0.1"
    },
    "synthetic": {
      "const": true
    },
    "status": {
      "const": "development_oracle_not_independently_adjudicated"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "expected_next_request_ref",
          "expected_target_dimension",
          "expected_decision",
          "required_reason_codes",
          "prohibited_request_refs"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^VOI-[0-9]{3}$"
          },
          "expected_next_request_ref": {
            "type": "string",
            "minLength": 1
          },
          "expected_target_dimension": {
            "type": "string",
            "minLength": 1
          },
          "expected_decision": {
            "enum": [
              "ALLOW_SCOPED",
              "ALLOW_PARTIAL",
              "HOLD_FOR_RECONCILIATION",
              "BLOCK",
              "DEFER_OR_DECLINE"
            ]
          },
          "required_reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prohibited_request_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
