{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/benchmarks/standards-interoperability/manifest.schema.json",
  "title": "MBD-INTEROP-001 blueprint manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "programme_id",
    "source_issue",
    "title",
    "status",
    "standards",
    "cases",
    "limitations",
    "mtconnect_execution_gate"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "programme_id": {
      "const": "MBD-INTEROP-001"
    },
    "source_issue": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus",
        "gold_adjudication",
        "scoring",
        "candidate_execution_authorized",
        "oracle_access_authorized",
        "physical_testing_authorized"
      ],
      "properties": {
        "corpus": {
          "const": "blueprint_only"
        },
        "gold_adjudication": {
          "const": "not_yet_adjudicated"
        },
        "scoring": {
          "const": "not_scored"
        },
        "candidate_execution_authorized": {
          "const": false
        },
        "oracle_access_authorized": {
          "const": false
        },
        "physical_testing_authorized": {
          "const": false
        }
      }
    },
    "standards": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "edition",
          "version",
          "surface",
          "source_uri"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "edition": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "enum": [
              "AP242",
              "QIF",
              "MTConnect",
              "traceability_principles"
            ]
          },
          "source_uri": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "primary_surface",
          "surfaces",
          "critical",
          "intent",
          "required_semantics",
          "seeded_fault"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MBDI-(POS|NEG)-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "positive_blueprint",
              "negative_control_blueprint"
            ]
          },
          "primary_surface": {
            "enum": [
              "AP242",
              "QIF",
              "MTConnect",
              "cross_surface"
            ]
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "AP242",
                "QIF",
                "MTConnect"
              ]
            }
          },
          "critical": {
            "type": "boolean"
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "required_semantics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "seeded_fault": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mtconnect_execution_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "eligible_for_candidate_execution",
        "eligible_for_scoring",
        "observed_public_version_labels",
        "sources",
        "required_frozen_tuple",
        "phase_policy",
        "rejection_rule"
      ],
      "properties": {
        "status": {
          "const": "blocked_until_compatibility_tuple_frozen"
        },
        "eligible_for_candidate_execution": {
          "const": false
        },
        "eligible_for_scoring": {
          "const": false
        },
        "observed_public_version_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "official_standard_download_page",
            "normative_sysml_model_release",
            "normative_model_documentation",
            "published_xml_schema_bundle"
          ],
          "properties": {
            "official_standard_download_page": {
              "type": "string"
            },
            "normative_sysml_model_release": {
              "type": "string"
            },
            "normative_model_documentation": {
              "type": "string"
            },
            "published_xml_schema_bundle": {
              "type": "string"
            }
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          },
          "minProperties": 4
        },
        "required_frozen_tuple": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "phase_policy": {
          "type": "string",
          "minLength": 1
        },
        "rejection_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
