{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mel-perception-parity-v1.schema.json",
  "title": "Melothaea Paired Audio-Symbolic Perception Parity v1",
  "description": "Strict suite, immutable run, and scored report schemas for evaluating the same musical task through audio and symbolic MIDI modalities.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "task": {
      "type": "string",
      "enum": [
        "SyncopationScoring",
        "TranspositionDetection",
        "ChordQualityIdentification"
      ]
    },
    "modality": {
      "type": "string",
      "enum": [
        "Audio",
        "SymbolicMidi"
      ]
    },
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "task",
            "level"
          ],
          "properties": {
            "task": {
              "const": "syncopation_level"
            },
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "task",
            "detected"
          ],
          "properties": {
            "task": {
              "const": "transposition_detected"
            },
            "detected": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "task",
            "quality"
          ],
          "properties": {
            "task": {
              "const": "chord_quality"
            },
            "quality": {
              "type": "string",
              "enum": [
                "Major",
                "Minor",
                "Dominant",
                "Diminished"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "task",
        "split",
        "source_score_sha256",
        "audio_input_sha256",
        "symbolic_input_sha256",
        "renderer_recipe_sha256",
        "ground_truth"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "$ref": "#/$defs/task"
        },
        "split": {
          "type": "string",
          "enum": [
            "Development",
            "Validation",
            "Test"
          ]
        },
        "source_score_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "audio_input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "symbolic_input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "renderer_recipe_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ground_truth": {
          "$ref": "#/$defs/answer"
        }
      },
      "additionalProperties": false
    },
    "model_identity": {
      "type": "object",
      "required": [
        "system_id",
        "system_version",
        "model_identity_sha256",
        "preprocessing_identity_sha256",
        "prompt_or_policy_sha256"
      ],
      "properties": {
        "system_id": {
          "type": "string",
          "minLength": 1
        },
        "system_version": {
          "type": "string",
          "minLength": 1
        },
        "model_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "preprocessing_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_or_policy_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "prediction": {
      "type": "object",
      "required": [
        "case_id",
        "modality",
        "input_sha256",
        "answer",
        "confidence"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "modality": {
          "$ref": "#/$defs/modality"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/answer"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "calibration_bin": {
      "type": "object",
      "required": [
        "bin_index",
        "lower_bound",
        "upper_bound",
        "sample_count",
        "mean_confidence",
        "empirical_accuracy"
      ],
      "properties": {
        "bin_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "lower_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "upper_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "mean_confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "empirical_accuracy": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "confidence_calibration": {
      "type": "object",
      "required": [
        "evaluated_count",
        "brier_score",
        "expected_calibration_error",
        "bins"
      ],
      "properties": {
        "evaluated_count": {
          "type": "integer",
          "minimum": 0
        },
        "brier_score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_calibration_error": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "bins": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/calibration_bin"
          }
        }
      },
      "additionalProperties": false
    },
    "modality_metrics": {
      "type": "object",
      "required": [
        "case_count",
        "answered_count",
        "abstained_count",
        "missing_count",
        "correct_count",
        "accuracy_all_cases",
        "accuracy_answered_only",
        "coverage",
        "mean_absolute_error_answered",
        "confidence_calibration"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "answered_count": {
          "type": "integer",
          "minimum": 0
        },
        "abstained_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "correct_count": {
          "type": "integer",
          "minimum": 0
        },
        "accuracy_all_cases": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "accuracy_answered_only": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_absolute_error_answered": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence_calibration": {
          "$ref": "#/$defs/confidence_calibration"
        }
      },
      "additionalProperties": false
    },
    "task_parity_metrics": {
      "type": "object",
      "required": [
        "task",
        "audio",
        "symbolic_midi",
        "audio_minus_symbolic_accuracy",
        "paired_answer_agreement",
        "paired_answer_count"
      ],
      "properties": {
        "task": {
          "$ref": "#/$defs/task"
        },
        "audio": {
          "$ref": "#/$defs/modality_metrics"
        },
        "symbolic_midi": {
          "$ref": "#/$defs/modality_metrics"
        },
        "audio_minus_symbolic_accuracy": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "paired_answer_agreement": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "paired_answer_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "title": "Frozen benchmark suite",
      "type": "object",
      "required": [
        "schema",
        "suite_id",
        "benchmark_version",
        "cases"
      ],
      "properties": {
        "schema": {
          "const": "mel-perception-parity-v1"
        },
        "suite_id": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_version": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/case"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "Immutable model run",
      "type": "object",
      "required": [
        "schema",
        "run_id",
        "suite_id",
        "model",
        "predictions"
      ],
      "properties": {
        "schema": {
          "const": "mel-perception-parity-v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "suite_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "$ref": "#/$defs/model_identity"
        },
        "predictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prediction"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "Scored paired modality report",
      "type": "object",
      "required": [
        "schema",
        "suite_id",
        "run_id",
        "model",
        "total_cases",
        "task_metrics"
      ],
      "properties": {
        "schema": {
          "const": "mel-perception-parity-v1"
        },
        "suite_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "$ref": "#/$defs/model_identity"
        },
        "total_cases": {
          "type": "integer",
          "minimum": 1
        },
        "task_metrics": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/task_parity_metrics"
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
