{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mel/grounded-participation-evidence-v1.schema.json",
  "title": "Melothaea grounded musical evidence bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "turn_id",
    "artifact",
    "temporal_grounding_evaluator_version",
    "annotation_policy_version",
    "permitted_prefix_end_frame",
    "committed_at_ns",
    "claims",
    "claim_set_sha256",
    "evidence_bundle_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "mel-grounded-participation-evidence-v1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audio_sha256",
        "sample_rate_hz",
        "channels",
        "total_frames"
      ],
      "properties": {
        "audio_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "total_frames": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "temporal_grounding_evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "annotation_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "permitted_prefix_end_frame": {
      "type": "integer",
      "minimum": 1
    },
    "committed_at_ns": {
      "type": "integer",
      "minimum": 0
    },
    "claim_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "kind",
          "status",
          "source_interval",
          "observed_through_frame",
          "committed_at_ns",
          "grounding_receipt_sha256",
          "reason"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "invitation",
              "retained_floor",
              "active_phrase",
              "handoff_or_stop",
              "intentional_space",
              "ambiguous_context",
              "stream_unavailable",
              "collaborator_veto"
            ]
          },
          "status": {
            "enum": [
              "grounded",
              "ambiguous",
              "unavailable",
              "contradicted",
              "not_estimable"
            ]
          },
          "source_interval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_frame",
              "end_frame"
            ],
            "properties": {
              "start_frame": {
                "type": "integer",
                "minimum": 0
              },
              "end_frame": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "observed_through_frame": {
            "type": "integer",
            "minimum": 0
          },
          "committed_at_ns": {
            "type": "integer",
            "minimum": 0
          },
          "grounding_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
