{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mel/music-edit-metamorphic-transform-receipt-v1.schema.json",
  "title": "Melothaea music-edit metamorphic transform execution receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pair_id",
    "dataset_id",
    "dataset_version",
    "benchmark_track_id",
    "base_sample_id",
    "transformed_sample_id",
    "source_lineage_sha256",
    "split",
    "transform_family",
    "input_audio_sha256",
    "output_audio_sha256",
    "base_instruction_sha256",
    "transformed_instruction_sha256",
    "transform_implementation_sha256",
    "transform_version",
    "transform_parameters_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "mel-music-edit-metamorphic-transform-receipt-v1"
    },
    "pair_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_track_id": {
      "type": "string",
      "minLength": 1
    },
    "base_sample_id": {
      "type": "string",
      "minLength": 1
    },
    "transformed_sample_id": {
      "type": "string",
      "minLength": 1
    },
    "source_lineage_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "split": {
      "enum": [
        "train",
        "development",
        "test"
      ]
    },
    "transform_family": {
      "enum": [
        "metadata_only",
        "lossless_reencode",
        "gain_headroom",
        "channel_permutation",
        "benign_crop_padding",
        "renderer_change",
        "global_transposition",
        "tempo_scaling",
        "key_scale_shift",
        "meter_preserving_rhythm_scale",
        "spatial_permutation",
        "target_crop",
        "target_masking",
        "absolute_pitch_shift",
        "dynamic_compression",
        "separation_topology_change",
        "instruction_scope_change"
      ]
    },
    "input_audio_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "output_audio_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "base_instruction_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "transformed_instruction_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "transform_implementation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "transform_version": {
      "type": "string",
      "minLength": 1
    },
    "transform_parameters_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
