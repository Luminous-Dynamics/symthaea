{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mel/grounded-participation-policy-v1.schema.json",
  "title": "Melothaea grounded participation policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "require_grounded_claims_for_wait",
    "maximum_evidence_age_ns",
    "minimum_effect_lead_ns",
    "maximum_effect_window_ns"
  ],
  "properties": {
    "schema_version": {
      "const": "mel-grounded-participation-policy-v1"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "require_grounded_claims_for_wait": {
      "type": "boolean"
    },
    "maximum_evidence_age_ns": {
      "type": "integer",
      "minimum": 0
    },
    "minimum_effect_lead_ns": {
      "type": "integer",
      "minimum": 0
    },
    "maximum_effect_window_ns": {
      "type": "integer",
      "minimum": 1
    }
  }
}
