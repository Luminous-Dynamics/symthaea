{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mel-music-source-observation-v1.schema.json",
  "title": "Melothaea Frozen Music Source Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_artifact_sha256", "source_lineage_sha256",
    "duration_ticks", "events", "anchors", "occurrences", "observation_sha256"
  ],
  "properties": {
    "schema_version": { "const": "mel-music-source-observation-v1" },
    "source_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "source_lineage_sha256": { "$ref": "#/$defs/sha256" },
    "duration_ticks": { "type": "integer", "minimum": 1 },
    "events": { "type": "array", "minItems": 1, "maxItems": 65536, "items": { "$ref": "#/$defs/event" } },
    "anchors": { "type": "array", "maxItems": 8192, "items": { "$ref": "#/$defs/anchor" } },
    "occurrences": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/occurrence" } },
    "observation_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "part_id", "onset_ticks", "duration_ticks"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "part_id": { "type": "string", "minLength": 1 },
        "onset_ticks": { "type": "integer", "minimum": 0 },
        "duration_ticks": { "type": "integer", "minimum": 1 }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "kind", "label", "start_tick", "end_tick"],
      "properties": {
        "anchor_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["section", "bar", "beat", "phrase", "event", "explicit_time"] },
        "label": { "type": "string", "minLength": 1 },
        "start_tick": { "type": "integer", "minimum": 0 },
        "end_tick": { "type": "integer", "minimum": 1 }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrence_id", "semantic_class_id", "start_tick", "end_tick", "event_ids", "anchor_ids"],
      "properties": {
        "occurrence_id": { "type": "string", "minLength": 1 },
        "semantic_class_id": { "type": "string", "minLength": 1 },
        "start_tick": { "type": "integer", "minimum": 0 },
        "end_tick": { "type": "integer", "minimum": 1 },
        "event_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "anchor_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
