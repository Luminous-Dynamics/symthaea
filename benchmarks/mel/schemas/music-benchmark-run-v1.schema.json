{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mel/music-benchmark-run-v1.schema.json",
  "title": "Melothaea reproducible music benchmark run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "disposition",
    "profile_sha256",
    "model",
    "execution",
    "failure_policy",
    "attempted_items",
    "succeeded_items",
    "failed_items",
    "timed_out_items",
    "unparseable_items",
    "abstained_items",
    "resource_usage",
    "metrics",
    "candidate_output_sha256",
    "raw_output_sha256",
    "evaluator_receipt_sha256",
    "run_manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "mel-music-benchmark-run-v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "enum": [
        "officially_reported",
        "locally_reproduced",
        "exploratory",
        "provisional"
      ]
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "immutable_version",
        "observed_at_utc",
        "endpoint_id",
        "model_artifact_sha256"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "immutable_version": {
          "type": "string",
          "minLength": 1
        },
        "observed_at_utc": {
          "type": "string",
          "minLength": 1
        },
        "endpoint_id": {
          "type": "string",
          "minLength": 1
        },
        "model_artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_template_sha256",
        "system_prompt_sha256",
        "adapter_sha256",
        "input_preprocessing_sha256",
        "decoding_config_sha256",
        "runtime_environment_sha256",
        "runner_commit_sha",
        "precision",
        "seed",
        "budget"
      ],
      "properties": {
        "prompt_template_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "system_prompt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "adapter_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_preprocessing_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decoding_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_environment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runner_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "precision": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximum_requests",
            "maximum_audio_seconds",
            "maximum_input_tokens",
            "maximum_output_tokens",
            "maximum_retries_per_request",
            "maximum_concurrency"
          ],
          "properties": {
            "maximum_requests": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_audio_seconds": {
              "type": "number",
              "minimum": 0
            },
            "maximum_input_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_output_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_retries_per_request": {
              "type": "integer",
              "minimum": 0
            },
            "maximum_concurrency": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "failure_policy": {
      "const": "every_attempt_retained_in_denominator"
    },
    "attempted_items": {
      "type": "integer",
      "minimum": 1
    },
    "succeeded_items": {
      "type": "integer",
      "minimum": 0
    },
    "failed_items": {
      "type": "integer",
      "minimum": 0
    },
    "timed_out_items": {
      "type": "integer",
      "minimum": 0
    },
    "unparseable_items": {
      "type": "integer",
      "minimum": 0
    },
    "abstained_items": {
      "type": "integer",
      "minimum": 0
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "audio_seconds",
        "input_tokens",
        "output_tokens",
        "retries",
        "maximum_observed_concurrency",
        "wall_time_ms",
        "measured_energy_millijoules",
        "energy_measurement_sha256"
      ],
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "audio_seconds": {
          "type": "number",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_observed_concurrency": {
          "type": "integer",
          "minimum": 0
        },
        "wall_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "measured_energy_millijoules": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "energy_measurement_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "scope_id",
          "direction",
          "value",
          "unit",
          "denominator",
          "numerator"
        ],
        "properties": {
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "scope_id": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "higher_is_better",
              "lower_is_better",
              "descriptive_only"
            ]
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "denominator": {
            "type": "integer",
            "minimum": 1
          },
          "numerator": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "candidate_output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluator_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
