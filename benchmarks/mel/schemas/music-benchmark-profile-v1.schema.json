{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mel/music-benchmark-profile-v1.schema.json",
  "title": "Melothaea native music benchmark profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_title",
    "benchmark_family",
    "benchmark_version",
    "protocol_reference",
    "native_track_id",
    "source_manifest_sha256",
    "split_manifest_sha256",
    "task_protocol_sha256",
    "scorer_id",
    "scorer_version",
    "scorer_sha256",
    "native_metric_ids",
    "native_metric_ids",
    "comparison_scope_id",
    "intended_use",
    "rights"
  ],
  "properties": {
    "schema_version": {
      "const": "mel-music-benchmark-profile-v1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_title": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_family": {
      "enum": [
        "temporal_grounding",
        "temporal_reasoning",
        "symbolic_audio_alignment",
        "global_music_understanding",
        "music_generation_preference",
        "selective_participation",
        "cross_cultural_evaluation",
        "other"
      ]
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "protocol_reference": {
      "type": "string",
      "minLength": 1
    },
    "native_track_id": {
      "type": "string",
      "minLength": 1
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "split_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scorer_id": {
      "type": "string",
      "minLength": 1
    },
    "scorer_version": {
      "type": "string",
      "minLength": 1
    },
    "scorer_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "native_metric_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "comparison_scope_id": {
      "type": "string",
      "minLength": 1
    },
    "intended_use": {
      "enum": [
        "evaluation_only",
        "training",
        "redistribution",
        "public_release"
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rights_reference",
        "rights_evidence_sha256",
        "permitted_uses"
      ],
      "properties": {
        "status": {
          "enum": [
            "cleared",
            "restricted",
            "unresolved"
          ]
        },
        "rights_reference": {
          "type": "string",
          "minLength": 1
        },
        "rights_evidence_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "permitted_uses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "evaluation_only",
              "training",
              "redistribution",
              "public_release"
            ]
          }
        }
      }
    }
  }
}
