{
  "schema_version": "symthaea.rea-differential-cases.v1",
  "corpus_id": "rea-differential-v1",
  "purpose": "Deterministic, inert, generated known-answer fixture recipes. Provider findings are scored against generated expected trees and byte-ledger oracles, never against provider self-reports.",
  "safety_constraints": [
    "Only generated text and container fixtures; no vendor firmware",
    "Never execute extracted files",
    "No device writes, firmware flashing, or emulator execution",
    "Record provider unsupported and unknown capability as abstention, not success"
  ],
  "cases": [
    {
      "case_id": "nested-gzip-tar-001",
      "family": "nested-containers",
      "recipe": "gzip(tar(payload.txt))",
      "supported_baseline": true,
      "expected_files": [
        {
          "path": "payload.txt",
          "utf8": "REA known-answer payload 001\n",
          "logical_id": "payload-001"
        }
      ],
      "required_region_kinds": [
        "gzip-container",
        "tar-container"
      ],
      "accounting_classes": [
        "identified",
        "padding"
      ],
      "mutations": [
        "wrong-child-content-hash",
        "dropped-child-edge",
        "false-root-offset"
      ]
    },
