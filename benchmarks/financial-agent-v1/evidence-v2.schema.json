{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/benchmarks/financial-agent-v1/evidence-v2.schema.json",
  "title": "Luminous Financial Research Evidence Artifact v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "source_id",
    "source_record_id",
    "source_version_id",
    "revision_group_id",
    "subject_refs",
    "evidence_kind",
    "content_sha256",
    "media_type",
    "temporal",
    "availability",
    "rights_authorization",
    "provenance",
    "revision",
    "access_class",
    "payload_ref",
    "qualification"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.financial-research-evidence.v2"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "revision_group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_kind": {
      "enum": [
        "filing",
        "financial_statement",
        "price_observation",
        "quote_observation",
        "trade_observation",
        "macro_series",
        "market_calendar",
        "corporate_action",
        "policy_document",
        "company_announcement",
        "research",
        "supply_chain_observation",
        "geospatial_observation",
        "physical_measurement",
        "model_output",
        "other"
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "media_type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_time_basis",
        "validity_interval_convention"
      ],
      "properties": {
        "event_time_basis": {
          "enum": [
            "instant",
            "period",
            "interval",
            "unknown"
          ]
        },
        "observation_period_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "observation_period_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "validity_interval_convention": {
          "const": "half_open"
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision",
        "principal_id",
        "known_at",
        "interval",
        "proof"
      ],
      "properties": {
        "precision": {
          "enum": [
            "exact_instant",
            "bounded_interval",
            "unknown"
          ]
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "known_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "interval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "earliest_possible_at",
                "latest_possible_at",
                "bounds",
                "time_basis"
              ],
              "properties": {
                "earliest_possible_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "latest_possible_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "bounds": {
                  "const": "inclusive"
                },
                "time_basis": {
                  "enum": [
                    "utc_instants",
                    "source_calendar_converted_with_declared_timezone"
                  ]
                },
                "source_timezone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "source_date": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          ]
        },
        "proof": {
          "$ref": "#/$defs/attestation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "precision": {
                "const": "exact_instant"
              }
            },
            "required": [
              "precision"
            ]
          },
          "then": {
            "properties": {
              "known_at": {
                "type": "string",
                "format": "date-time"
              },
              "interval": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "bounded_interval"
              }
            },
            "required": [
              "precision"
            ]
          },
          "then": {
            "properties": {
              "known_at": {
                "type": "null"
              },
              "interval": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "unknown"
              }
            },
            "required": [
              "precision"
            ]
          },
          "then": {
            "properties": {
              "known_at": {
                "type": "null"
              },
              "interval": {
                "type": "null"
              },
              "proof": {
                "properties": {
                  "state": {
                    "enum": [
                      "missing",
                      "unverifiable",
                      "synthetic_fixture_only"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "rights_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "rights_profile_id",
        "disposition",
        "valid_from",
        "valid_until",
        "proof"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rights_profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "disposition": {
          "enum": [
            "authorized",
            "not_authorized",
            "unknown"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "proof": {
          "$ref": "#/$defs/attestation"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "lineage_ref"
      ],
      "properties": {
        "family_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "lineage_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supersedes_evidence_ids"
      ],
      "properties": {
        "supersedes_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "access_class": {
      "enum": [
        "public",
        "licensed",
        "participant_authorized",
        "sealed_evaluator_only"
      ]
    },
    "payload_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "qualification": {
      "enum": [
        "synthetic_development_only",
        "historical_confirmation",
        "prospective_shadow"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "source_version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "$defs": {
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "artifact_ref",
        "artifact_sha256",
        "verification_receipt_ref",
        "verification_receipt_sha256",
        "verifier_id",
        "verifier_build_sha256",
        "binding_sha256"
      ],
      "properties": {
        "state": {
          "enum": [
            "verified",
            "missing",
            "unverifiable",
            "synthetic_fixture_only"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "verification_receipt_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "verification_receipt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "verifier_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "verifier_build_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "binding_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "verified"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "artifact_ref": {
                "type": "string",
                "minLength": 1
              },
              "artifact_sha256": {
                "type": "string"
              },
              "verification_receipt_ref": {
                "type": "string",
                "minLength": 1
              },
              "verification_receipt_sha256": {
                "type": "string"
              },
              "verifier_id": {
                "type": "string",
                "minLength": 1
              },
              "verifier_build_sha256": {
                "type": "string"
              },
              "binding_sha256": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
