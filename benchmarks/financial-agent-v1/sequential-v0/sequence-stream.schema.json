{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/benchmarks/financial-agent-v1/sequential-v0/sequence-stream.schema.json",
  "title": "Luminous Sequential Financial Evidence Stream v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stream_id",
    "qualification",
    "purpose",
    "principal_profile_id",
    "rights_profile_id",
    "temporal_profile",
    "entities",
    "events",
    "frontiers",
    "prequential_forecast_task"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.financial-sequence-stream.v0-dev"
    },
    "stream_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "qualification": {
      "const": "development_public_non_qualifying"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "principal_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "rights_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "temporal_profile": {
      "enum": [
        "exact_instants_synthetic_only",
        "proof_bound_v2",
        "interval_censored_v2"
      ]
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "entity_type"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "entity_type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "frontiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frontier_id",
          "decision_at",
          "newly_admissible_event_ids"
        ],
        "properties": {
          "frontier_id": {
            "type": "string",
            "minLength": 1
          },
          "decision_at": {
            "type": "string",
            "format": "date-time"
          },
          "newly_admissible_event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "prequential_forecast_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forecast_id",
        "question",
        "issue_at_frontiers",
        "outcome_event_id",
        "outcome_known_at",
        "resolution_rule",
        "scoring"
      ],
      "properties": {
        "forecast_id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "issue_at_frontiers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "outcome_event_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome_known_at": {
          "type": "string",
          "format": "date-time"
        },
        "resolution_rule": {
          "type": "string",
          "minLength": 1
        },
        "scoring": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "evidence_id",
        "event_kind",
        "source",
        "times",
        "rights",
        "subjects",
        "supersedes_evidence_ids",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "source_record_id",
            "source_version_id",
            "revision_group_id",
            "provenance_family_id"
          ],
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "source_record_id": {
              "type": "string",
              "minLength": 1
            },
            "source_version_id": {
              "type": "string",
              "minLength": 1
            },
            "revision_group_id": {
              "type": "string",
              "minLength": 1
            },
            "provenance_family_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "times": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed_at",
            "published_at",
            "known_at",
            "retrieved_at",
            "valid_from",
            "valid_until"
          ],
          "properties": {
            "observed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "published_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "known_at": {
              "type": "string",
              "format": "date-time"
            },
            "retrieved_at": {
              "type": "string",
              "format": "date-time"
            },
            "valid_from": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "valid_until": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_id",
            "disposition",
            "proof_status"
          ],
          "properties": {
            "profile_id": {
              "type": "string",
              "minLength": 1
            },
            "disposition": {
              "enum": [
                "synthetic_authorized_placeholder",
                "authorized",
                "not_authorized",
                "unknown"
              ]
            },
            "proof_status": {
              "enum": [
                "synthetic_fixture_only",
                "verified",
                "missing",
                "unverifiable"
              ]
            }
          }
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "supersedes_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "payload": {
          "type": "object"
        }
      }
    }
  }
}
