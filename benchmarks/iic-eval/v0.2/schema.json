{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/benchmarks/iic-eval/v0.2/schema.json",
  "title": "IIC-Eval adversarial source corpus v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_version",
    "synthetic",
    "status",
    "as_of",
    "cases"
  ],
  "properties": {
    "corpus_version": {
      "const": "0.2"
    },
    "synthetic": {
      "const": true
    },
    "status": {
      "const": "development"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "version",
        "source_kind",
        "language",
        "availability",
        "effective_from",
        "effective_through",
        "content"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": [
            "brief",
            "policy",
            "email",
            "amendment",
            "service_request",
            "schedule",
            "attachment_manifest",
            "inspection_standard"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "availability": {
          "enum": [
            "available",
            "missing",
            "partial"
          ]
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "effective_through": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "category",
        "description",
        "task",
        "documents"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^IIC-[0-9]{3}$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/document"
          }
        }
      }
    }
  }
}
