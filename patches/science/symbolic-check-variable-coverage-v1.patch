+fn collect_conservation_variables(expr: &SymExpr, out: &mut Vec<String>) {
+    match expr {
+        SymExpr::Var(name) => out.push(name.clone()),
+        SymExpr::Const(_) => {}
+        SymExpr::Add(a, b) | SymExpr::Mul(a, b) | SymExpr::Div(a, b) => {
+            collect_conservation_variables(a, out);
+            collect_conservation_variables(b, out);
+        }
+        SymExpr::Neg(a) | SymExpr::Log(a) | SymExpr::Sin(a) | SymExpr::Cos(a) => {
+            collect_conservation_variables(a, out);
+        }
+        SymExpr::Pow(base, _) => collect_conservation_variables(base, out),
+    }
+}
+
+/// Build deterministic finite probes that bind every variable still present
+/// in the simplified chain-rule residual.
+///
+/// These probes are only a finite falsification check, not a proof that the
+/// residual is identically zero. Their purpose is to prevent the evaluator's
+/// legacy missing-variable default (`0.0`) from collapsing multivariate checks
+/// onto an unintended lower-dimensional slice.
+fn conservation_probe_points(total_derivative: &SymExpr) -> Vec<Vec<(String, f64)>> {
+    let mut variables = Vec::new();
+    collect_conservation_variables(total_derivative, &mut variables);
+    variables.sort();
+    variables.dedup();
+
+    const BASES: [f64; 6] = [0.37, 0.71, 1.13, 1.59, 2.03, 2.47];
+    (0..BASES.len())
+        .map(|probe_index| {
+            variables
+                .iter()
+                .enumerate()
+                .map(|(variable_index, name)| {
+                    let base = BASES[(probe_index + variable_index) % BASES.len()];
+                    (name.clone(), base + 0.113 * variable_index as f64)
+                })
+                .collect()
+        })
+        .collect()
 }
 
