+#[cfg(test)]
+mod conservation_verification_tests {
+    use super::*;
+
+    #[test]
+    fn multivariate_residual_cannot_pass_via_missing_variable_zero_fill() {
+        let energy = SymExpr::Var("x".into());
+        let dynamics = [
+            ("x", SymExpr::Var("y".into())),
+            ("y", SymExpr::Const(1.0)),
+        ];
+
+        let proof = verify_conservation_symbolic(&energy, &dynamics);
+
+        assert_eq!(proof.total_derivative, "y");
+        assert!(!proof.is_conserved);
+        assert!(proof.max_numerical_residual > 1e-10);
+    }
+
+    #[test]
+    fn harmonic_conservation_still_passes_with_complete_probe_bindings() {
+        let energy = SymExpr::Add(
+            Box::new(SymExpr::Pow(Box::new(SymExpr::Var("x".into())), 2.0)),
+            Box::new(SymExpr::Pow(Box::new(SymExpr::Var("v".into())), 2.0)),
+        );
+        let dynamics = [
+            ("x", SymExpr::Var("v".into())),
+            ("v", SymExpr::Neg(Box::new(SymExpr::Var("x".into())))),
+        ];
+
+        let proof = verify_conservation_symbolic(&energy, &dynamics);
+
+        assert!(proof.is_conserved, "{proof}");
+    }
