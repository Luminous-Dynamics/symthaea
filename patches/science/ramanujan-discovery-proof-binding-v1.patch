+fn harmonic_rhs(state: &[f64], _t: f64) -> Vec<f64> {
+    vec![state[1], -state[0]]
+}
+
+/// Execute one end-to-end pilot where the Z3 obligation is derived from the
+/// exact formula returned by autonomous discovery rather than from the
+/// verifier's parallel reference expression.
+///
+/// The receipt is intentionally textual/non-cryptographic. It establishes a
+/// direct in-process translation chain, not a content-addressed evidence root.
+fn run_discovery_bound_harmonic_pilot(dir: &Path) -> Result<(), String> {
+    let problem = problems()
+        .into_iter()
+        .find(|problem| problem.name == "harmonic_oscillator")
+        .ok_or_else(|| "harmonic reference problem missing".to_string())?;
+
+    let config = RegressorConfig {
+        population_size: 250,
+        generations: 80,
+        max_depth: 4,
+        max_complexity: 12,
+        lambda: 0.001,
+        mutation_rate: 0.4,
+        seed: 42,
+        ..RegressorConfig::default()
+    };
+    let variable_names = ["x", "v"];
+    let discovered = discover_invariants_autonomous(
+        harmonic_rhs,
+        &[1.0, 0.0],
+        &variable_names,
+        Some(&problem.dynamics),
+        &config,
+        20.0,
+        0.01,
+    )
+    .into_iter()
+    .next()
+    .ok_or_else(|| "autonomous harmonic discovery returned no invariant".to_string())?;
+
+    let translated = expr_to_sym(&discovered.formula).ok_or_else(|| {
+        format!(
+            "discovered formula is outside Expr->SymExpr proof subset: {}",
+            discovered.formula
+        )
+    })?;
+    let obligation = build_obligation_for_energy(
+        &problem,
+        &translated,
+        "autonomous_discovery_expr_via_expr_to_sym",
+    )
+    .ok_or_else(|| {
+        format!(
+            "translated discovered formula is outside QF_NRA proof subset: {}",
+            translated
+        )
+    })?;
+
+    let witness_path = dir.join("harmonic_oscillator.discovery-bound.smt2");
+    fs::write(&witness_path, &obligation)
+        .map_err(|e| format!("write {} failed: {}", witness_path.display(), e))?;
+
+    let z3_result = run_z3(&obligation)?;
+    let final_line = z3_result.trim().lines().last().unwrap_or("");
+    if final_line != "unsat" {
+        return Err(format!(
+            "discovery-bound harmonic obligation was not UNSAT: {}",
+            final_line
+        ));
+    }
+
+    let receipt_path = dir.join("harmonic_oscillator.discovery-bound.binding.txt");
+    let receipt = format!(
+        "binding_version=1\nproblem={}\norigin=autonomous_discovery_expr_via_expr_to_sym\ndiscovered_formula={}\ntranslated_formula={}\nsymbolically_checked={}\nvariance={:.17e}\nsmt_file={}\nz3_result=unsat\nidentity_strength=in_process_direct_translation_non_cryptographic\n",
+        problem.name,
+        discovered.formula,
+        translated,
+        discovered.symbolically_proven,
+        discovered.variance,
+        witness_path.display(),
+    );
+    fs::write(&receipt_path, receipt)
+        .map_err(|e| format!("write {} failed: {}", receipt_path.display(), e))?;
+
+    eprintln!(
+        "# discovery-bound pilot: {} -> {} -> UNSAT [{}]",
+        discovered.formula,
+        translated,
+        receipt_path.display()
+    );
+    Ok(())
+}
