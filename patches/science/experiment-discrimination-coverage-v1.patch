+/// Select the highest-disagreement experiment that is evaluable by at least
+/// `min_prediction_coverage` of the live hypotheses.
+///
+/// Experiments with fewer than two finite predictions are never eligible,
+/// because there is no pairwise disagreement to measure. `None` is returned
+/// for an empty candidate pool, an invalid coverage threshold, or when no
+/// experiment meets the requested coverage.
+///
+/// This is still a query-by-committee heuristic, not expected information gain:
+/// it does not yet model hypothesis posterior weights, measurement noise, cost,
+/// duration, safety risk, or intervention feasibility.
+pub fn select_most_informative_experiment_with_min_coverage<'a, H, E>(
+    candidates: &'a [E],
+    hypotheses: &[H],
+    min_prediction_coverage: f64,
+    predict: impl Fn(&H, &E) -> Option<f64> + Copy,
+) -> Option<(&'a E, ExperimentDiscrimination)> {
+    if !min_prediction_coverage.is_finite() || !(0.0..=1.0).contains(&min_prediction_coverage) {
+        return None;
+    }
+
+    let mut best: Option<(&E, ExperimentDiscrimination)> = None;
+    for experiment in candidates {
+        let score = experiment_discrimination(experiment, hypotheses, predict);
+        if score.valid_predictions < 2 || score.prediction_coverage() < min_prediction_coverage {
+            continue;
+        }
+        match best {
+            None => best = Some((experiment, score)),
+            Some((_, best_score)) if score.prediction_variance > best_score.prediction_variance => {
+                best = Some((experiment, score));
+            }
+            _ => {}
+        }
+    }
+    best
 }
 
