+/// Coverage-aware diagnostic for one candidate experiment.
+///
+/// `prediction_variance` remains the original query-by-committee disagreement
+/// score. The additional counts make explicit how much of the live hypothesis
+/// set could actually be evaluated at this experiment. Coverage is not a
+/// posterior probability and does not by itself make an experiment useful.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct ExperimentDiscrimination {
+    pub prediction_variance: f64,
+    pub valid_predictions: usize,
+    pub total_hypotheses: usize,
+}
+
+impl ExperimentDiscrimination {
+    /// Fraction of hypotheses that produced a finite prediction.
+    pub fn prediction_coverage(&self) -> f64 {
+        if self.total_hypotheses == 0 {
+            0.0
+        } else {
+            self.valid_predictions as f64 / self.total_hypotheses as f64
+        }
+    }
+}
+
+/// Measure prediction disagreement and prediction coverage for one experiment.
+///
+/// `None` and non-finite predictions are both treated as unavailable. This
+/// follows the module contract that undefined/non-finite predictions should not
+/// be injected into the disagreement statistic as numerical values.
+pub fn experiment_discrimination<H, E>(
+    experiment: &E,
+    hypotheses: &[H],
+    predict: impl Fn(&H, &E) -> Option<f64>,
+) -> ExperimentDiscrimination {
+    let predictions: Vec<f64> = hypotheses
+        .iter()
+        .filter_map(|h| predict(h, experiment).filter(|value| value.is_finite()))
+        .collect();
+    ExperimentDiscrimination {
+        prediction_variance: variance(&predictions),
+        valid_predictions: predictions.len(),
+        total_hypotheses: hypotheses.len(),
+    }
+}
