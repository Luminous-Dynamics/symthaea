+    fn assert_refined_finite_state_retains_recurrent_promotion(
+        status: ConjectureStatus,
+        label: &str,
+    ) {
+        let formula = n_squared_plus_c(1.0);
+        let subtree = normalize_expr(&formula);
+        let mut engine = ConjectureEngine::new();
+
+        for i in 0..3 {
+            let mut conjecture = make_conjecture(
+                formula.clone(),
+                MathDomain::Physics,
+                &format!("{label}-source-{i}"),
+                status.clone(),
+            );
+            conjecture.macro_promotion_tier = MacroPromotionTier::RecurrentNumerical;
+            engine.conjectures.push(conjecture);
+        }
+
+        let mut grammar = DynamicGrammar::new();
+        grammar.observe_subtree(subtree, &[0, 1, 2], &engine);
+
+        assert_eq!(grammar.candidates.len(), 1);
+        assert_eq!(
+            grammar.candidates[0].verified_count, 3,
+            "{label} must retain the recurrent evidence already earned"
+        );
+        assert_eq!(
+            grammar.candidates[0].strongly_verified_count, 0,
+            "{label} must not become singleton fast-track evidence"
+        );
+        assert_eq!(
+            grammar.candidates[0].promotion_tier,
+            MacroPromotionTier::RecurrentNumerical
+        );
+
+        grammar.promote_eligible(&engine);
+        assert_eq!(grammar.operators.len(), 1);
+        assert_eq!(
+            grammar.operators[0].promotion_tier,
+            MacroPromotionTier::RecurrentNumerical,
+            "{label} should promote only through recurrence"
+        );
+    }
