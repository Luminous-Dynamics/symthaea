+/// Two deliberately non-collapsed confidence-like coordinates carried by a
+/// research-derived conjecture.
+///
+/// `conjecture_score` is whatever legacy/model-internal score the Conjecture
+/// Engine assigned. `data_provenance_confidence` is the web-research
+/// verifier's assessment of the source/data pedigree. They are not assumed to
+/// share calibration, likelihood semantics, or evidentiary meaning.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct ProvenancedConfidenceCoordinates {
+    pub conjecture_score: f64,
+    pub data_provenance_confidence: f32,
+}
+
+impl ProvenancedConjecture {
+    pub fn confidence_coordinates(&self) -> ProvenancedConfidenceCoordinates {
+        ProvenancedConfidenceCoordinates {
+            conjecture_score: self.conjecture.confidence,
+            data_provenance_confidence: self.provenance.confidence,
+        }
+    }
+}
+
