@@ -22,7 +22,42 @@ pub struct CausalDAG {
 
 impl CausalDAG {
     pub fn new(nodes: Vec<String>, edges: Vec<(usize, usize)>) -> Self {
+        Self::assert_valid_structure(nodes.len(), &edges);
         Self { nodes, edges }
     }
+
+    fn assert_valid_structure(node_count: usize, edges: &[(usize, usize)]) {
+        let mut indegree = vec![0usize; node_count];
+        let mut outgoing = vec![Vec::new(); node_count];
+
+        for &(parent, child) in edges {
+            assert!(parent < node_count, "Parent index out of bounds");
+            assert!(child < node_count, "Child index out of bounds");
+            assert_ne!(parent, child, "Self-loops are not allowed in a DAG");
+
+            outgoing[parent].push(child);
+            indegree[child] += 1;
+        }
+
+        let mut queue: VecDeque<usize> = indegree
+            .iter()
+            .enumerate()
+            .filter_map(|(node, &degree)| (degree == 0).then_some(node))
+            .collect();
+        let mut visited = 0usize;
+
+        while let Some(node) = queue.pop_front() {
+            visited += 1;
+            for &child in &outgoing[node] {
+                indegree[child] -= 1;
+                if indegree[child] == 0 {
+                    queue.push_back(child);
+                }
+            }
+        }
+
+        assert_eq!(
+            visited, node_count,
+            "Directed cycles are not allowed in a DAG"
+        );
+    }
 
