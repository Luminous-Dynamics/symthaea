+/// Coverage of the declared hypothesis set by machine-readable predictions.
+///
+/// Missing prediction coverage is not a probability model. In particular,
+/// callers must not interpret a missing hypothesis as assigning a uniform
+/// distribution over the outcome classes predicted by other hypotheses.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct PredictionCoverage {
+    /// Hypotheses with at least one machine-readable `ExpectedOutcome`.
+    pub predicted_hypotheses: Vec<HypothesisType>,
+    /// Hypotheses with no machine-readable prediction for this design.
+    pub missing_hypotheses: Vec<HypothesisType>,
+    /// Current prior mass carried by hypotheses with encoded predictions.
+    pub predicted_prior_mass: f64,
+}
+
+impl PredictionCoverage {
+    /// Whether every hypothesis in Spark's declared hypothesis scope has an
+    /// encoded prediction for this design.
+    pub fn complete_for_scope(&self) -> bool {
+        self.missing_hypotheses.is_empty()
+    }
+}
+
+/// Non-authorizing information assessment for one experiment design.
+///
+/// `conditional_eig_bits` is conditioned on the hypothesis lying inside the
+/// subset with encoded predictions. It is intentionally *not* multiplied by
+/// prediction coverage: combining those coordinates is a planner policy.
+///
+/// `full_scope_eig_bits` is present only when every declared hypothesis has an
+/// encoded prediction. `None` means full-scope Bayesian EIG is not established
+/// by this signature-level model.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ExperimentInformationAssessment {
+    pub prediction_coverage: PredictionCoverage,
+    pub conditional_eig_bits: Option<f64>,
+    pub full_scope_eig_bits: Option<f64>,
+}
+
+/// Inspect which hypotheses actually have machine-readable predictions.
+pub fn prediction_coverage(
+    design: &ExperimentDesign,
+    belief: &HypothesisBelief,
+) -> PredictionCoverage {
+    let predicted_hypotheses: Vec<HypothesisType> = ALL_HYPOTHESES
+        .iter()
+        .copied()
+        .filter(|h| design.expected_outcomes.iter().any(|o| o.hypothesis == *h))
+        .collect();
+    let missing_hypotheses: Vec<HypothesisType> = ALL_HYPOTHESES
+        .iter()
+        .copied()
+        .filter(|h| !predicted_hypotheses.contains(h))
+        .collect();
+    let predicted_prior_mass = predicted_hypotheses
+        .iter()
+        .map(|&h| belief.prob(h))
+        .sum();
+
+    PredictionCoverage {
+        predicted_hypotheses,
+        missing_hypotheses,
+        predicted_prior_mass,
+    }
+}
+
+/// Mutual-information EIG conditioned on the hypothesis being one for which
+/// this design has an encoded prediction.
+///
+/// This does not invent a likelihood for missing predictions and therefore
+/// must not be presented as full-scope EIG when prediction coverage is
+/// incomplete.
+pub fn conditional_expected_information_gain(
+    design: &ExperimentDesign,
+    belief: &HypothesisBelief,
+) -> Option<f64> {
+    let coverage = prediction_coverage(design, belief);
+    if coverage.predicted_hypotheses.is_empty() || coverage.predicted_prior_mass <= 0.0 {
+        return None;
+    }
+
+    let classes = OutcomeClasses::from_design(design);
+    if classes.is_empty() {
+        return Some(0.0);
+    }
+
+    let probs: Vec<(HypothesisType, f64)> = coverage
+        .predicted_hypotheses
+        .iter()
+        .map(|&h| (h, belief.prob(h) / coverage.predicted_prior_mass))
+        .collect();
+
+    let prior_entropy: f64 = -probs
+        .iter()
+        .map(|(_, p)| if *p > 0.0 { p * p.log2() } else { 0.0 })
+        .sum::<f64>();
+
+    let mut expected_posterior_entropy = 0.0;
+    for class in &classes.classes {
+        let p_o: f64 = probs
+            .iter()
+            .filter(|(h, _)| class.contains(h))
+            .map(|(_, p)| *p)
+            .sum();
+        if p_o <= 0.0 {
+            continue;
+        }
+
+        let posterior_entropy: f64 = -probs
+            .iter()
+            .filter(|(h, _)| class.contains(h))
+            .map(|(_, p)| {
+                let q = *p / p_o;
+                if q > 0.0 { q * q.log2() } else { 0.0 }
+            })
+            .sum::<f64>();
+        expected_posterior_entropy += p_o * posterior_entropy;
+    }
+
+    Some((prior_entropy - expected_posterior_entropy).max(0.0))
+}
+
+/// Assess information value without converting missing prediction coverage
+/// into an invented full-scope likelihood model.
+pub fn assess_information_gain(
+    design: &ExperimentDesign,
+    belief: &HypothesisBelief,
+) -> ExperimentInformationAssessment {
+    let prediction_coverage = prediction_coverage(design, belief);
+    let conditional_eig_bits = conditional_expected_information_gain(design, belief);
+    let full_scope_eig_bits = prediction_coverage
+        .complete_for_scope()
+        .then(|| expected_information_gain(design, belief));
+
+    ExperimentInformationAssessment {
+        prediction_coverage,
+        conditional_eig_bits,
+        full_scope_eig_bits,
+    }
+}
 
