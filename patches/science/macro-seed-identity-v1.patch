+#[cfg(test)]
+mod macro_seed_identity_tests {
+    use super::*;
+
+    #[test]
+    fn explicit_macro_seed_identity_survives_usage_accounting() {
+        let n = Expr::Var("n".into());
+        let template = Expr::BinOp(
+            BinOp::Add,
+            Box::new(Expr::Func(UnaryFn::Sin, Box::new(n.clone()))),
+            Box::new(Expr::BinOp(
+                BinOp::Mul,
+                Box::new(n.clone()),
+                Box::new(n),
+            )),
+        );
+        let identity = "eml:strict:fixture-scientific-macro-id".to_string();
+        let data = (1..=12)
+            .map(|x| {
+                let x = x as f64;
+                (x, x.sin() + x * x)
+            })
+            .collect();
+        let sequence = ObservedSequence::new("macro_identity_fixture", MathDomain::Physics, data);
+        let mut regressor = SymbolicRegressor::new(RegressorConfig {
+            population_size: 30,
+            generations: 0,
+            max_depth: 5,
+            max_complexity: 12,
+            lambda: 0.0,
+            seed: 17,
+            ..RegressorConfig::default()
+        });
+        regressor.set_seed_macros_with_identity(vec![MacroSeed::new(
+            identity.clone(),
+            template.clone(),
+        )]);
+
+        let results = regressor.fit(&sequence, 5);
+        assert!(
+            results
+                .iter()
+                .any(|candidate| contains_structural_match(&candidate.formula, &template)),
+            "identity fixture must retain the seeded macro in at least one returned candidate"
+        );
+        assert!(
+            regressor.macro_usage().get(&identity).copied().unwrap_or(0) > 0,
+            "usage must be attributed to the exact caller-supplied macro identity"
+        );
+    }
+}
