+#[cfg(test)]
+mod macro_seed_identity_tests {
+    use super::*;
+
+    #[test]
+    fn explicit_macro_seed_identity_survives_dependency_resolution() {
+        let n = Expr::Var("n".into());
+        let template = Expr::BinOp(
+            BinOp::Add,
+            Box::new(Expr::Func(UnaryFn::Sin, Box::new(n.clone()))),
+            Box::new(Expr::BinOp(
+                BinOp::Mul,
+                Box::new(n.clone()),
+                Box::new(n),
+            )),
+        );
+        let identity = "eml:strict:fixture-scientific-macro-id".to_string();
+        let mut regressor = SymbolicRegressor::new(RegressorConfig::default());
+        regressor.set_seed_macros_with_identity(vec![MacroSeed::new(
+            identity.clone(),
+            template.clone(),
+        )]);
+
+        assert_ne!(identity, macro_usage_key(&template));
+        assert_eq!(
+            regressor.macro_dependencies_for_expr(&template),
+            vec![identity],
+            "dependency lookup must preserve the exact caller-supplied macro identity"
+        );
+    }
+}
