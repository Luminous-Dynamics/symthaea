+/// Identity-bearing learned macro seed.
+///
+/// `identity` is the exact promoted-operator identity supplied by the grammar.
+/// It must not be reconstructed from `template`: the grammar may use a richer
+/// canonicalization (for example an EML-qualified identity) than the
+/// regressor's structural expression key.
+#[derive(Debug, Clone)]
+pub struct MacroSeed {
+    pub identity: String,
+    pub template: Expr,
+}
+
+impl MacroSeed {
+    pub fn new(identity: impl Into<String>, template: Expr) -> Self {
+        Self {
+            identity: identity.into(),
+            template,
+        }
+    }
+
+    fn inferred(template: Expr) -> Self {
+        let identity = macro_usage_key(&template);
+        Self { identity, template }
+    }
+}
