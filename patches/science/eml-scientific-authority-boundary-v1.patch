+    #[test]
+    fn eml_equivalence_does_not_make_mediocre_numeric_fit_macro_safe() {
+        let data: Vec<(f64, f64)> = (1..=10)
+            .map(|x| {
+                let x = x as f64;
+                (x, x)
+            })
+            .collect();
+        let sequence = ObservedSequence::new("eml_authority_fixture", MathDomain::Physics, data);
+        let formula = Expr::BinOp(
+            BinOp::Mul,
+            Box::new(Expr::Const(0.95)),
+            Box::new(Expr::Var("n".into())),
+        );
+        let mut conjecture = Conjecture {
+            formula: formula.clone(),
+            formula_str: format!("{formula}"),
+            source: sequence.name.clone(),
+            domain: MathDomain::Physics,
+            training_mse: 0.1,
+            complexity: formula.complexity(),
+            fitness: 0.1,
+            status: ConjectureStatus::Proposed,
+            confidence: 0.5,
+            macro_promotion_tier: MacroPromotionTier::RecurrentNumerical,
+            eml_compiled: None,
+            eml_metrics: None,
+            eml_verified_real: None,
+            eml_real_domain: None,
+            eml_verified_complex: None,
+            eml_constructive_compiled: None,
+            eml_constructive_metrics: None,
+            eml_verified_constructive_real: None,
+        };
+        attach_eml_metadata(&mut conjecture);
+        assert!(
+            conjecture_has_verified_eml_backend(&conjecture),
+            "fixture must have verified EML representation equivalence"
+        );
+
+        let mut engine = ConjectureEngine::new();
+        engine.observe(sequence);
+        engine.conjectures.push(conjecture);
+        engine.verify_numerical();
+
+        assert!(matches!(
+            engine.conjectures[0].status,
+            ConjectureStatus::NumericallyTested { .. }
+        ));
+        assert_eq!(
+            engine.conjectures[0].macro_promotion_tier,
+            MacroPromotionTier::Quarantined,
+            "5% held-out relative error must remain macro-quarantined even when EML-equivalent"
+        );
+    }
+}
