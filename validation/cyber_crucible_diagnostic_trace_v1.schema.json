{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/validation/cyber_crucible_diagnostic_trace_v1.schema.json",
  "title": "Symthaea Cyber Crucible Diagnostic Trace v1",
  "description": "Public calibration contract for evidence-bound diagnosis, safe observations, bounded containment proposals, recovery obligations, and explicit residual uncertainty. Not a qualification or authorization token.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_schema_version", "trace_id", "classification", "scenario_binding",
    "execution_context", "assets", "evidence", "hypotheses", "observations",
    "containment_proposals", "recovery", "phases", "residual_uncertainty", "report"
  ],
  "properties": {
    "trace_schema_version": { "const": "cyber-crucible-diagnostic-trace.v1" },
    "trace_id": { "type": "string", "pattern": "^TRACE-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
    "classification": { "const": "public_calibration_non_qualifying" },
    "scenario_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "revision", "scenario_digest"],
      "properties": {
        "scenario_id": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
        "revision": { "type": "integer", "minimum": 1 },
        "scenario_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "execution_context": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "scope", "authorization_ref"],
      "properties": {
        "mode": { "enum": ["synthetic", "replay", "real"] },
        "scope": { "type": "string", "minLength": 20 },
        "authorization_ref": { "type": ["string", "null"] }
      }
    },
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["asset_id", "role", "trust_boundary", "criticality"],
        "properties": {
          "asset_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]*$" },
          "role": { "type": "string", "minLength": 3 },
          "trust_boundary": { "type": "string", "minLength": 10 },
          "criticality": { "enum": ["low", "moderate", "high", "critical"] }
        }
      }
    },
    "evidence": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "observed_at", "kind", "basis", "source_class", "integrity_status", "observation"],
        "properties": {
          "evidence_id": { "type": "string", "pattern": "^E[1-9][0-9]*$" },
          "observed_at": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "basis": { "enum": ["direct", "control_plane_record", "derived", "flow_derived"] },
          "source_class": { "enum": ["public_fixture", "tool_receipt", "human_observation", "derived_record"] },
          "integrity_status": { "enum": ["unknown", "unverified", "verified"] },
          "observation": { "type": "string", "minLength": 10 }
        }
      }
    },
    "hypotheses": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["hypothesis_id", "statement", "status", "confidence_bps", "confidence_calibration", "supporting_evidence_refs", "contradicting_evidence_refs"],
        "properties": {
          "hypothesis_id": { "type": "string", "pattern": "^H[1-9][0-9]*$" },
          "statement": { "type": "string", "minLength": 15 },
          "status": { "enum": ["active", "retained", "weakened", "rejected", "supported"] },
          "confidence_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "confidence_calibration": { "enum": ["calibrated", "uncalibrated"] },
          "supporting_evidence_refs": { "$ref": "#/$defs/stringList" },
          "contradicting_evidence_refs": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "observations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["observation_id", "target", "question", "observation_class", "impact", "authority_status", "outcome", "evidence_refs", "rationale", "result_summary"],
        "properties": {
          "observation_id": { "type": "string", "pattern": "^O[1-9][0-9]*$" },
          "target": { "type": "string", "minLength": 3 },
          "question": { "type": "string", "minLength": 15 },
          "observation_class": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "impact": { "enum": ["read_only", "low_impact_reversible", "state_changing", "unsafe"] },
          "authority_status": { "enum": ["not_required", "requested", "approved", "denied", "unknown"] },
          "outcome": { "enum": ["not_run", "completed", "blocked", "failed", "illustrative_only"] },
          "evidence_refs": { "$ref": "#/$defs/stringList" },
          "rationale": { "type": "string", "minLength": 20 },
          "result_summary": { "type": "string", "minLength": 15 },
          "authorization_ref": { "type": ["string", "null"] }
        }
      }
    },
    "containment_proposals": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["proposal_id", "action_class", "description", "affected_asset_ids", "scope_evidence_refs", "authority_status", "disposition", "preconditions", "predicted_side_effects", "reversible", "rollback_plan", "rollback_verification"],
        "properties": {
          "proposal_id": { "type": "string", "pattern": "^C[1-9][0-9]*$" },
          "action_class": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string", "minLength": 20 },
          "affected_asset_ids": { "$ref": "#/$defs/nonEmptyStringList" },
          "scope_evidence_refs": { "$ref": "#/$defs/nonEmptyStringList" },
          "authority_status": { "enum": ["not_requested", "requested", "approved", "denied", "unknown"] },
          "disposition": { "enum": ["proposed_only", "deferred", "denied", "executed", "verified"] },
          "preconditions": { "$ref": "#/$defs/nonEmptyStringList" },
          "predicted_side_effects": { "$ref": "#/$defs/nonEmptyStringList" },
          "reversible": { "type": "boolean" },
          "rollback_plan": { "type": "string", "minLength": 15 },
          "rollback_verification": { "type": "string", "minLength": 15 },
          "authorization_ref": { "type": ["string", "null"] },
          "execution_evidence_refs": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "entry_criteria", "obligations"],
      "properties": {
        "status": { "enum": ["not_started", "in_progress", "verified", "incomplete"] },
        "entry_criteria": { "$ref": "#/$defs/nonEmptyStringList" },
        "obligations": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["obligation_id", "description", "verification_method", "status", "evidence_refs", "rationale"],
            "properties": {
              "obligation_id": { "type": "string", "pattern": "^R[1-9][0-9]*$" },
              "description": { "type": "string", "minLength": 15 },
              "verification_method": { "type": "string", "minLength": 15 },
              "status": { "enum": ["pending", "pass", "fail", "not_applicable"] },
              "evidence_refs": { "$ref": "#/$defs/stringList" },
              "rationale": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "phases": {
      "type": "array", "minItems": 15, "maxItems": 15,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["phase", "state", "summary", "evidence_refs"],
        "properties": {
          "phase": { "enum": ["orient", "model_assets_and_trust_boundaries", "enumerate_competing_hypotheses", "identify_evidence_gaps", "select_next_observation", "update_beliefs", "scope_impact", "assess_claim_maturity", "propose_containment", "predict_side_effects", "check_authority", "verify_outcome", "define_recovery_obligations", "assess_residual_uncertainty", "produce_evidence_bearing_report"] },
          "state": { "enum": ["completed", "skipped"] },
          "summary": { "type": "string", "minLength": 20 },
          "evidence_refs": { "$ref": "#/$defs/stringList" },
          "skip_reason": { "type": "string", "minLength": 10 }
        }
      }
    },
    "residual_uncertainty": {
      "type": "object", "additionalProperties": false,
      "required": ["known_unknowns", "confidence_limit", "attribution_status"],
      "properties": {
        "known_unknowns": { "$ref": "#/$defs/nonEmptyStringList" },
        "confidence_limit": { "type": "string", "minLength": 20 },
        "attribution_status": { "enum": ["not_supported", "tentative", "supported"] }
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition", "root_cause_status", "attribution_status", "evidence_refs", "summary", "production_authority_granted"],
      "properties": {
        "disposition": { "enum": ["monitor", "escalate", "abstain", "diagnosed"] },
        "root_cause_status": { "enum": ["not_supported", "tentative", "supported"] },
        "attribution_status": { "enum": ["not_supported", "tentative", "supported"] },
        "evidence_refs": { "$ref": "#/$defs/nonEmptyStringList" },
        "summary": { "type": "string", "minLength": 30 },
        "production_authority_granted": { "const": false }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStringList": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}