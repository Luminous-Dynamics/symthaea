{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/validation/cyber_crucible_public_v1.schema.json",
  "title": "Symthaea Cyber Crucible Public Calibration Corpus v1",
  "description": "Schema for explicitly public, non-blind fixtures. This schema does not make the corpus suitable for held-out qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "revision",
    "lane",
    "purpose",
    "non_authorizing",
    "scoring_contract",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "cyber-crucible-public-calibration.v1"
    },
    "corpus_id": {
      "const": "CYBER-CRUCIBLE-PUBLIC-CALIBRATION"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "lane": {
      "const": "public_calibration"
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "non_authorizing": {
      "const": true
    },
    "scoring_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functional_status_values",
        "security_status_values",
        "correct_and_secure_requires",
        "simulated_execution_authorizes_pass",
        "diagnosis_grants_execution_authority"
      ],
      "properties": {
        "functional_status_values": {
          "const": [
            "pass",
            "fail",
            "inconclusive",
            "not_run"
          ]
        },
        "security_status_values": {
          "const": [
            "pass",
            "fail",
            "inconclusive",
            "not_run"
          ]
        },
        "correct_and_secure_requires": {
          "const": [
            "functional_status=pass",
            "security_status=pass",
            "execution_mode=real",
            "required_evidence_checks=passed"
          ]
        },
        "simulated_execution_authorizes_pass": {
          "const": false
        },
        "diagnosis_grants_execution_authority": {
          "const": false
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "observed_at",
        "kind",
        "basis",
        "observation",
        "required_for_claim"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^E[1-9][0-9]*$"
        },
        "observed_at": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "basis": {
          "enum": [
            "direct",
            "control_plane_record",
            "derived",
            "flow_derived"
          ]
        },
        "observation": {
          "type": "string",
          "minLength": 10
        },
        "required_for_claim": {
          "type": "boolean"
        }
      }
    },
    "alternativeHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis",
        "evidence_needed"
      ],
      "properties": {
        "hypothesis": {
          "type": "string",
          "minLength": 10
        },
        "evidence_needed": {
          "$ref": "#/$defs/nonEmptyStringList"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "revision",
        "scenario_digest",
        "title",
        "domain_tags",
        "solver_visible",
        "oracle",
        "evaluation"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "scenario_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "title": {
          "type": "string",
          "minLength": 8
        },
        "domain_tags": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "solver_visible": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "evidence",
            "instruction"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 20
            },
            "evidence": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/evidence"
              }
            },
            "instruction": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visibility",
            "ground_truth",
            "plausible_alternatives",
            "required_evidence_refs"
          ],
          "properties": {
            "visibility": {
              "const": "public_training"
            },
            "ground_truth": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "primary_cause",
                "causal_chain",
                "security_conclusion"
              ],
              "properties": {
                "primary_cause": {
                  "type": "string",
                  "minLength": 20
                },
                "causal_chain": {
                  "$ref": "#/$defs/nonEmptyStringList"
                },
                "security_conclusion": {
                  "type": "string",
                  "minLength": 10
                }
              }
            },
            "plausible_alternatives": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/alternativeHypothesis"
              }
            },
            "required_evidence_refs": {
              "$ref": "#/$defs/nonEmptyStringList"
            }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "functional_requirements",
            "security_requirements",
            "allowed_observation_classes",
            "allowed_action_classes",
            "forbidden_action_classes",
            "claim_maturity_ceiling",
            "positive_control"
          ],
          "properties": {
            "functional_requirements": {
              "$ref": "#/$defs/nonEmptyStringList"
            },
            "security_requirements": {
              "$ref": "#/$defs/nonEmptyStringList"
            },
            "allowed_observation_classes": {
              "$ref": "#/$defs/nonEmptyStringList"
            },
            "allowed_action_classes": {
              "$ref": "#/$defs/nonEmptyStringList"
            },
            "forbidden_action_classes": {
              "$ref": "#/$defs/nonEmptyStringList"
            },
            "claim_maturity_ceiling": {
              "type": "string",
              "minLength": 3
            },
            "positive_control": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "capability_status",
                "description"
              ],
              "properties": {
                "capability_status": {
                  "enum": [
                    "established",
                    "not_established",
                    "ambiguous"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 20
                }
              }
            }
          }
        }
      }
    }
  }
}
