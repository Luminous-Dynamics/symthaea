{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Luminous-Dynamics/symthaea/blob/main/tools/mel-agency-trace/schema/mel-agency-transaction-trace-v1.schema.json",
  "title":"Melothaea Agency Transaction Trace V1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","trace_id","autonomy_mode","base_artifact_sha256","clock_domain_id","clock_origin_id","events"],
  "properties":{
    "schema_version":{"const":"mel-agency-transaction-trace-v1"},
    "trace_id":{"$ref":"#/$defs/id"},
    "autonomy_mode":{"enum":["suggest_only","preview_only","apply_approved","bounded_exploration"]},
    "base_artifact_sha256":{"$ref":"#/$defs/hash"},
    "clock_domain_id":{"$ref":"#/$defs/id"},
    "clock_origin_id":{"$ref":"#/$defs/id"},
    "events":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/event"}}
  },
  "$defs":{
    "id":{"type":"string","minLength":1,"pattern":"\\S"},
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "subject":{
      "type":"object","additionalProperties":false,
      "required":["source_artifact_sha256","candidate_artifact_sha256","scope_sha256","protected_set_sha256","requested_change_sha256","edit_plan_sha256"],
      "properties":{
        "source_artifact_sha256":{"$ref":"#/$defs/hash"},
        "candidate_artifact_sha256":{"$ref":"#/$defs/hash"},
        "scope_sha256":{"$ref":"#/$defs/hash"},
        "protected_set_sha256":{"$ref":"#/$defs/hash"},
        "requested_change_sha256":{"$ref":"#/$defs/hash"},
        "edit_plan_sha256":{"$ref":"#/$defs/hash"}
      }
    },
    "event":{
      "type":"object","additionalProperties":false,
      "required":["event_id","sequence","monotonic_time_ns","previous_event_sha256","event_sha256","kind"],
      "properties":{
        "event_id":{"$ref":"#/$defs/id"},
        "sequence":{"type":"integer","minimum":1},
        "monotonic_time_ns":{"type":"integer","minimum":0},
        "previous_event_sha256":{"$ref":"#/$defs/hash"},
        "event_sha256":{"$ref":"#/$defs/hash"},
        "kind":{"oneOf":[
          {"$ref":"#/$defs/proposed"},
          {"$ref":"#/$defs/previewed"},
          {"$ref":"#/$defs/approved"},
          {"$ref":"#/$defs/vetoed"},
          {"$ref":"#/$defs/bounded_authority_granted"},
          {"$ref":"#/$defs/committed"},
          {"$ref":"#/$defs/undone"}
        ]}
      }
    },
    "proposed":{
      "type":"object","additionalProperties":false,"required":["event_type","payload"],
      "properties":{"event_type":{"const":"proposed"},"payload":{
        "type":"object","additionalProperties":false,
        "required":["proposal_id","subject","subject_commitment_sha256"],
        "properties":{"proposal_id":{"$ref":"#/$defs/id"},"subject":{"$ref":"#/$defs/subject"},"subject_commitment_sha256":{"$ref":"#/$defs/hash"}}
      }}
    },
    "previewed":{
      "type":"object","additionalProperties":false,"required":["event_type","payload"],
      "properties":{"event_type":{"const":"previewed"},"payload":{
        "type":"object","additionalProperties":false,
        "required":["proposal_id","subject_commitment_sha256","preview_receipt_sha256"],
        "properties":{"proposal_id":{"$ref":"#/$defs/id"},"subject_commitment_sha256":{"$ref":"#/$defs/hash"},"preview_receipt_sha256":{"$ref":"#/$defs/hash"}}
      }}
    },
    "approved":{
      "type":"object","additionalProperties":false,"required":["event_type","payload"],
      "properties":{"event_type":{"const":"approved"},"payload":{
        "type":"object","additionalProperties":false,
        "required":["proposal_id","subject_commitment_sha256","actor_id","authority_receipt_sha256","expires_at_monotonic_ns"],
        "properties":{"proposal_id":{"$ref":"#/$defs/id"},"subject_commitment_sha256":{"$ref":"#/$defs/hash"},"actor_id":{"$ref":"#/$defs/id"},"authority_receipt_sha256":{"$ref":"#/$defs/hash"},"expires_at_monotonic_ns":{"type":"integer","minimum":0}}
      }}
    },
    "vetoed":{
      "type":"object","additionalProperties":false,"required":["event_type","payload"],
      "properties":{"event_type":{"const":"vetoed"},"payload":{
        "type":"object","additionalProperties":false,
        "required":["proposal_id","subject_commitment_sha256","actor_id","veto_receipt_sha256"],
        "properties":{"proposal_id":{"$ref":"#/$defs/id"},"subject_commitment_sha256":{"$ref":"#/$defs/hash"},"actor_id":{"$ref":"#/$defs/id"},"veto_receipt_sha256":{"$ref":"#/$defs/hash"}}
      }}
    },
    "bounded_authority_granted":{
      "type":"object","additionalProperties":false,"required":["event_type","payload"],
      "properties":{"event_type":{"const":"bounded_authority_granted"},"payload":{
        "type":"object","additionalProperties":false,
        "required":["proposal_id","subject_commitment_sha256","actor_id","policy_sha256","authority_receipt_sha256","expires_at_monotonic_ns"],
        "properties":{"proposal_id":{"$ref":"#/$defs/id"},"subject_commitment_sha256":{"$ref":"#/$defs/hash"},"actor_id":{"$ref":"#/$defs/id"},"policy_sha256":{"$ref":"#/$defs/hash"},"authority_receipt_sha256":{"$ref":"#/$defs/hash"},"expires_at_monotonic_ns":{"type":"integer","minimum":0}}
      }}
    },
    "committed":{
      "type":"object","additionalProperties":false,"required":["event_type","payload"],
      "properties":{"event_type":{"const":"committed"},"payload":{
        "type":"object","additionalProperties":false,
        "required":["proposal_id","subject_commitment_sha256","authorization_event_id","result_artifact_sha256","preservation_receipt_sha256","preservation_verifier_id","preservation_verifier_version"],
        "properties":{"proposal_id":{"$ref":"#/$defs/id"},"subject_commitment_sha256":{"$ref":"#/$defs/hash"},"authorization_event_id":{"$ref":"#/$defs/id"},"result_artifact_sha256":{"$ref":"#/$defs/hash"},"preservation_receipt_sha256":{"$ref":"#/$defs/hash"},"preservation_verifier_id":{"$ref":"#/$defs/id"},"preservation_verifier_version":{"$ref":"#/$defs/id"}}
      }}
    },
    "undone":{
      "type":"object","additionalProperties":false,"required":["event_type","payload"],
      "properties":{"event_type":{"const":"undone"},"payload":{
        "type":"object","additionalProperties":false,
        "required":["proposal_id","subject_commitment_sha256","commit_event_id","restored_artifact_sha256","undo_receipt_sha256","undo_verifier_id","undo_verifier_version"],
        "properties":{"proposal_id":{"$ref":"#/$defs/id"},"subject_commitment_sha256":{"$ref":"#/$defs/hash"},"commit_event_id":{"$ref":"#/$defs/id"},"restored_artifact_sha256":{"$ref":"#/$defs/hash"},"undo_receipt_sha256":{"$ref":"#/$defs/hash"},"undo_verifier_id":{"$ref":"#/$defs/id"},"undo_verifier_version":{"$ref":"#/$defs/id"}}
      }}
    }
  }
}