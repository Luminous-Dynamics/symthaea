{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb/sorrydb-cohort-manifest-v0.schema.json",
  "title": "PITB SorryDB cohort manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "provenance",
    "statistics",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.sorrydb-cohort-manifest.v0"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repository_commit",
        "source_path",
        "source_blob_sha1",
        "source_file_bytes",
        "source_file_sha256",
        "source_license",
        "paper",
        "database_spec",
        "snapshot_description",
        "task_goal_text_distributed",
        "blame_email_hash_distributed"
      ],
      "properties": {
        "repository": {
          "const": "SorryDB/SorryDB"
        },
        "repository_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_blob_sha1": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "source_file_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_license": {
          "type": "string",
          "minLength": 1
        },
        "paper": {
          "type": "string",
          "format": "uri"
        },
        "database_spec": {
          "type": "string",
          "format": "uri"
        },
        "snapshot_description": {
          "type": "string",
          "minLength": 20
        },
        "task_goal_text_distributed": {
          "const": false
        },
        "blame_email_hash_distributed": {
          "const": false
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_count",
        "distinct_repository_count",
        "distinct_repository_commit_lean_toolchain_count",
        "unique_task_id_count",
        "unique_goal_hash_count"
      ],
      "properties": {
        "task_count": {
          "type": "integer",
          "minimum": 1
        },
        "distinct_repository_count": {
          "type": "integer",
          "minimum": 1
        },
        "distinct_repository_commit_lean_toolchain_count": {
          "type": "integer",
          "minimum": 1
        },
        "unique_task_id_count": {
          "type": "integer",
          "minimum": 1
        },
        "unique_goal_hash_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "repository_url",
          "repository_branch",
          "repository_commit",
          "lean_toolchain",
          "source_path",
          "start_line",
          "start_column",
          "end_line",
          "end_column",
          "goal_sha256",
          "source_url"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "repository_url": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/]+/[^/]+$"
          },
          "repository_branch": {
            "type": "string",
            "minLength": 1
          },
          "repository_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "lean_toolchain": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
          },
          "source_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.lean$"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "start_column": {
            "type": "integer",
            "minimum": 0
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_column": {
            "type": "integer",
            "minimum": 0
          },
          "goal_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
