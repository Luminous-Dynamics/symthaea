{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb/benchmark-integrity-report-v0.schema.json",
  "title": "PITB benchmark integrity report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "benchmark_id",
    "benchmark_version",
    "upstream_repository_commit",
    "source_split_blob_sha1",
    "task_records_jsonl_sha256",
    "reproduction_receipts_jsonl_sha256",
    "attempt_outcomes_jsonl_sha256",
    "task_count",
    "admitted_task_count",
    "quarantined_task_count",
    "admission_rate",
    "attempt_count",
    "verified_success_attempt_count",
    "verified_success_task_count",
    "verified_success_rate_over_admitted_tasks",
    "verified_success_rate_over_all_tasks",
    "task_admissions",
    "attempts",
    "score_semantics",
    "receipt_authentication_boundary",
    "benchmark_interpretation_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.benchmark-integrity-report.v0"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "upstream_repository_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "source_split_blob_sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "task_records_jsonl_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reproduction_receipts_jsonl_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempt_outcomes_jsonl_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_count": {
      "type": "integer",
      "minimum": 1
    },
    "admitted_task_count": {
      "type": "integer",
      "minimum": 0
    },
    "quarantined_task_count": {
      "type": "integer",
      "minimum": 0
    },
    "admission_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "verified_success_attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "verified_success_task_count": {
      "type": "integer",
      "minimum": 0
    },
    "verified_success_rate_over_admitted_tasks": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ]
    },
    "verified_success_rate_over_all_tasks": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "task_admissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "source_task_id",
          "task_record_sha256",
          "admitted",
          "quarantine_reasons",
          "reproduction_receipt_sha256",
          "repository_commit",
          "lean_version"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_task_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "task_record_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "admitted": {
            "type": "boolean"
          },
          "quarantine_reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reproduction_receipt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "repository_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "lean_version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "task_id",
          "prover_id",
          "prover_version",
          "result",
          "verified_success",
          "proof_sha256",
          "environment_sha256",
          "lean_toolchain_sha256",
          "attempt_record_sha256"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "task_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "prover_id": {
            "type": "string",
            "minLength": 1
          },
          "prover_version": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "verified_success",
              "non_solve",
              "execution_failure",
              "verification_failure"
            ]
          },
          "verified_success": {
            "type": "boolean"
          },
          "proof_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          },
          "environment_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lean_toolchain_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "attempt_record_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "score_semantics": {
      "type": "string",
      "minLength": 40
    },
    "receipt_authentication_boundary": {
      "type": "string",
      "minLength": 40
    },
    "benchmark_interpretation_boundary": {
      "type": "string",
      "minLength": 40
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitSha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
