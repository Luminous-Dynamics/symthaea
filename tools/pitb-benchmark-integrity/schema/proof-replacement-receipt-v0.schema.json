{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb/proof-replacement-receipt-v0.schema.json",
  "title": "PITB proof replacement receipt v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort_manifest_sha256",
    "task_id",
    "repository_url",
    "repository_commit",
    "lean_toolchain",
    "source_path",
    "start_line",
    "start_column",
    "goal_sha256",
    "environment_sha256",
    "lake_manifest_sha256",
    "source_file_sha256",
    "baseline_tree_sha256",
    "final_tree_sha256",
    "patch_sha256",
    "proof_sha256",
    "declaration_signature_before_sha256",
    "declaration_signature_after_sha256",
    "actual_axioms_sha256",
    "axiom_policy_sha256",
    "execution_receipt_sha256",
    "clean_checkout",
    "baseline_reproduction_passed",
    "debug_goal_matched",
    "target_is_prop",
    "target_replaced_exactly_once",
    "lake_build_exit_code",
    "kernel_replay_passed",
    "permitted_axioms_passed",
    "target_sorry_count",
    "semantic_review"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.proof-replacement-receipt.v0"
    },
    "cohort_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repository_url": {
      "type": "string",
      "format": "uri"
    },
    "repository_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "lean_toolchain": {
      "type": "string",
      "minLength": 1
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "start_line": {
      "type": "integer",
      "minimum": 1
    },
    "start_column": {
      "type": "integer",
      "minimum": 0
    },
    "goal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lake_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baseline_tree_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "final_tree_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "patch_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proof_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "declaration_signature_before_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "declaration_signature_after_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actual_axioms_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "axiom_policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution_receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "clean_checkout": {
      "type": "boolean"
    },
    "baseline_reproduction_passed": {
      "type": "boolean"
    },
    "debug_goal_matched": {
      "type": "boolean"
    },
    "target_is_prop": {
      "type": "boolean"
    },
    "target_replaced_exactly_once": {
      "type": "boolean"
    },
    "lake_build_exit_code": {
      "type": "integer"
    },
    "kernel_replay_passed": {
      "type": "boolean"
    },
    "permitted_axioms_passed": {
      "type": "boolean"
    },
    "target_sorry_count": {
      "type": "integer",
      "minimum": 0
    },
    "semantic_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_correspondence",
        "hypothesis_fidelity",
        "non_vacuity",
        "reviewer_attestation_sha256"
      ],
      "properties": {
        "source_correspondence": {
          "enum": [
            "pass",
            "fail",
            "not_run",
            "inconclusive"
          ]
        },
        "hypothesis_fidelity": {
          "enum": [
            "pass",
            "fail",
            "not_run",
            "inconclusive"
          ]
        },
        "non_vacuity": {
          "enum": [
            "pass",
            "fail",
            "not_run",
            "inconclusive"
          ]
        },
        "reviewer_attestation_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        }
      }
    }
  }
}
