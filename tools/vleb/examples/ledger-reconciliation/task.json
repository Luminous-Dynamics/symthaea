  "behavior_contract": {
    "task_statement": "Implement a deterministic ledger reconciler that validates CSV rows, applies exact duplicate transactions once, rejects conflicting duplicate transaction IDs without partial effects, and reports exact per-account and global totals.",
    "invariants": [
      "Amounts are positive integers in minor units; binary floating-point is prohibited.",
      "Exact duplicate rows are idempotent and count once.",
      "A transaction ID reused with different data causes rejection before any side effects are committed.",
      "Output account rows are ordered lexicographically by account ID.",
      "Global credits, debits and net equal the sums over account rows.",
      "Net equals credits minus debits with checked integer arithmetic."
    ],
    "allowed_behavior_changes": [],
    "observable_effects": [
      "stdout_bytes",
      "exit_code",
      "control_totals",
      "numeric_semantics",
      "idempotency"
    ]
  },
  "oracle_contract": {
