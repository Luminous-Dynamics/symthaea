{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/vleb-task.schema.json",
  "title": "Verified Legacy Engineering Benchmark task contract",
  "description": "Machine-readable, preregisterable task contract for a VLEB engineering episode. It defines the task and evidence obligations; it does not itself certify a run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_family",
    "title",
    "classification",
    "source_identity",
    "environment",
    "behavior_contract",
    "oracle_contract",
    "evaluation_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "vleb-task-v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "task_family": {
      "enum": [
        "diagnosis",
        "legacy_repair",
        "specification_implementation",
        "cross_language_migration",
        "data_transaction_integrity",
        "oracle_construction",
        "runtime_operational_repair"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure",
        "sensitivity",
        "difficulty"
      ],
      "properties": {
        "exposure": {
          "enum": [
            "public_development",
            "private_holdout",
            "private_confirmatory"
          ]
        },
        "sensitivity": {
          "enum": [
            "synthetic",
            "authorized_deidentified",
            "public_open_source"
          ]
        },
        "difficulty": {
          "enum": [
            "introductory",
            "intermediate",
            "advanced",
            "expert",
            "unrated"
          ]
        },
        "reviewer_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "revision",
        "source_sha256"
      ],
      "properties": {
        "source_kind": {
          "enum": [
            "repository",
            "synthetic_fixture",
            "benchmark_sample"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fixture_sha256": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9._-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "task_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_row_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "network_mode",
        "toolchains"
      ],
      "properties": {
        "platform": {
          "enum": [
            "linux",
            "windows",
            "macos",
            "z_os",
            "other"
          ]
        },
        "network_mode": {
          "enum": [
            "none",
            "allowlisted",
            "enabled",
            "not_applicable"
          ]
        },
        "container_image_digest": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "toolchains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "role"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "compiler",
                  "runtime",
                  "database",
                  "assembler",
                  "test_runner",
                  "other"
                ]
              },
              "identity_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "resource_budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 1
            },
            "cpu_count": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "behavior_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_statement",
        "invariants",
        "allowed_behavior_changes"
      ],
      "properties": {
        "task_statement": {
          "type": "string",
          "minLength": 20
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "allowed_behavior_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observable_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "stdout_bytes",
              "stderr_bytes",
              "exit_code",
              "record_layout",
              "database_state",
              "control_totals",
              "transaction_boundary",
              "restart_behavior",
              "idempotency",
              "ordering",
              "numeric_semantics",
              "external_side_effect"
            ]
          }
        },
        "numeric_semantics": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "representation": {
              "type": "string"
            },
            "rounding": {
              "type": "string"
            },
            "overflow": {
              "type": "string"
            },
            "comparison": {
              "enum": [
                "exact",
                "absolute_tolerance",
                "relative_tolerance"
              ]
            },
            "tolerance": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "oracle_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_test_ids",
        "baseline_empty_patch_must_fail",
        "reference_patch_must_pass",
        "regression_guards",
        "negative_controls",
        "test_execution_map"
      ],
      "properties": {
        "required_test_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "baseline_empty_patch_must_fail": {
          "const": true
        },
        "reference_patch_must_pass": {
          "const": true
        },
        "regression_guards": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "control_id",
              "mutation_class",
              "expected_verdict"
            ],
            "properties": {
              "control_id": {
                "type": "string",
                "minLength": 1
              },
              "mutation_class": {
                "enum": [
                  "empty_patch",
                  "wrong_result",
                  "rounding_or_truncation",
                  "duplicate_processing",
                  "record_layout",
                  "encoding_or_order",
                  "missing_side_effect",
                  "restart_or_replay",
                  "return_code",
                  "regression_guard_drop",
                  "evidence_tampering",
                  "environment_mismatch",
                  "other_semantic"
                ]
              },
              "expected_verdict": {
                "const": "fail"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "reference_evidence_sha256": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference_patch": {
              "$ref": "#/$defs/sha256"
            },
            "baseline_log": {
              "$ref": "#/$defs/sha256"
            },
            "reference_log": {
              "$ref": "#/$defs/sha256"
            },
            "test_bundle": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "oracle_review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "independent_reviewer_count": {
              "type": "integer",
              "minimum": 0
            },
            "mutation_equivalence_reviewed": {
              "type": "boolean"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "test_execution_map": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "test_id",
              "execution_ids"
            ],
            "properties": {
              "test_id": {
                "type": "string",
                "minLength": 1
              },
              "execution_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "reference_evidence_artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_log",
            "reference_log",
            "reference_patch",
            "test_bundle"
          ],
          "properties": {
            "baseline_log": {
              "type": "string",
              "minLength": 1
            },
            "reference_log": {
              "type": "string",
              "minLength": 1
            },
            "reference_patch": {
              "type": "string",
              "minLength": 1
            },
            "test_bundle": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "evaluation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_attempt_limit",
        "unresolved_policy",
        "agent_network_policy"
      ],
      "properties": {
        "primary_attempt_limit": {
          "const": 1
        },
        "unresolved_policy": {
          "const": "retain_in_denominator_and_suppress_headline_score"
        },
        "agent_network_policy": {
          "enum": [
            "offline",
            "preregistered_allowlist",
            "enabled_separate_condition"
          ]
        },
        "abstention_allowed": {
          "type": "boolean"
        },
        "attempts_per_task_secondary": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "evidence_schema_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
