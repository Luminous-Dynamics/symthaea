{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/vleb-witness-execution-receipt.schema.json",
  "title": "VLEB evaluator-bound witness execution receipt",
  "description": "A machine-readable record of one verifier invocation. It is valid evidence only when its digest is in the attested bundle and all bindings are checked against the evaluator-pinned run manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "claim_id",
    "run_binding",
    "runtime",
    "producer",
    "verifier",
    "invocation",
    "inputs",
    "outputs",
    "process",
    "observed_result",
    "source_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "vleb-witness-execution-receipt-v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 3
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{1,127}$"
    },
    "run_binding": {
      "$ref": "#/$defs/runBinding"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable_image_id",
        "network_mode",
        "network_mode_observed"
      ],
      "properties": {
        "immutable_image_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "network_mode": {
          "enum": [
            "none",
            "restricted",
            "enabled"
          ]
        },
        "network_mode_observed": {
          "type": "boolean"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source_index",
            "static_analysis",
            "compiler",
            "independent_execution",
            "independent_expert_review"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "working_directory",
        "timeout_ms",
        "environment_sha256"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "working_directory": {
          "anyOf": [
            {
              "const": "."
            },
            {
              "$ref": "#/$defs/relativePath"
            }
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "environment_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/outputArtifact"
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "signal",
        "timed_out"
      ],
      "properties": {
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": [
            "string",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        }
      }
    },
    "observed_result": {
      "enum": [
        "supports",
        "contradicts",
        "inconclusive"
      ]
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "process": {
            "properties": {
              "timed_out": {
                "const": true
              }
            },
            "required": [
              "timed_out"
            ]
          }
        },
        "required": [
          "process"
        ]
      },
      "then": {
        "properties": {
          "observed_result": {
            "const": "inconclusive"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "process": {
            "properties": {
              "timed_out": {
                "const": false
              }
            },
            "required": [
              "timed_out"
            ]
          }
        },
        "required": [
          "process"
        ]
      },
      "then": {
        "properties": {
          "process": {
            "properties": {
              "exit_code": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "outputs": {
          "contains": {
            "properties": {
              "role": {
                "const": "stdout"
              }
            },
            "required": [
              "role"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "outputs": {
          "contains": {
            "properties": {
              "role": {
                "const": "stderr"
              }
            },
            "required": [
              "role"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "runBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_full_name",
        "repository_id",
        "run_id",
        "run_attempt",
        "source_repository_digest",
        "source_repository_ref",
        "candidate_checkout_revision",
        "workflow_sha",
        "workflow_ref"
      ],
      "properties": {
        "repository_full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "source_repository_digest": {
          "$ref": "#/$defs/gitSha"
        },
        "source_repository_ref": {
          "type": "string",
          "minLength": 1
        },
        "candidate_checkout_revision": {
          "$ref": "#/$defs/gitSha"
        },
        "workflow_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "workflow_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "outputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "enum": [
            "stdout",
            "stderr",
            "artifact"
          ]
        }
      }
    }
  }
}
