{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Luminous-Dynamics/symthaea/blob/main/tools/mel-rmi-expressive-v2/schema/mel-rmi-expressive-v2.schema.json",
  "title":"MEL RMI Expressive V2 Trial",
  "type":"object","additionalProperties":false,
  "required":["schema_version","trial_id","policy_id","policy_version","deterministic_seed","source_score_sha256","target_feature","target_event_ids","partner_to_agent","agent_to_partner","trial_sha256"],
  "properties":{
    "schema_version":{"const":"mel-rmi-expressive-v2-reference"},
    "trial_id":{"type":"string","minLength":1},
    "policy_id":{"type":"string","minLength":1},
    "policy_version":{"type":"string","minLength":1},
    "deterministic_seed":{"type":"integer","minimum":0},
    "source_score_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "target_feature":{"enum":["velocity","articulation","rubato_offset_us","register","phrase_gesture"]},
    "target_event_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":0}},
    "partner_to_agent":{"$ref":"#/$defs/arm"},
    "agent_to_partner":{"$ref":"#/$defs/arm"},
    "trial_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "$defs":{
    "note":{"type":"object","additionalProperties":false,"required":["event_id","velocity","articulation","rubato_offset_us","register","phrase_gesture"],"properties":{
      "event_id":{"type":"integer","minimum":0},
      "velocity":{"type":"integer","minimum":1,"maximum":127},
      "articulation":{"enum":["detached","staccato","tenuto","legato","accent"]},
      "rubato_offset_us":{"type":"integer"},
      "register":{"type":"integer","minimum":0,"maximum":127},
      "phrase_gesture":{"enum":["neutral","pickup","sustain","release","pause","cadential"]}
    }},
    "frame":{"type":"object","additionalProperties":false,"required":["events"],"properties":{"events":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/note"}}}},
    "arm":{"type":"object","additionalProperties":false,"required":["input_control","input_treatment","response_control","response_treatment","expected_relation"],"properties":{
      "input_control":{"$ref":"#/$defs/frame"},
      "input_treatment":{"$ref":"#/$defs/frame"},
      "response_control":{"$ref":"#/$defs/frame"},
      "response_treatment":{"$ref":"#/$defs/frame"},
      "expected_relation":{"enum":["follow","contrast","any_change"]}
    }}
  }
}