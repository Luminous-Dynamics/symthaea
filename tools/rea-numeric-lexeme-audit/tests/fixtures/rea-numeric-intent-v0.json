{
  "schema": "luminous.rea.numeric-intent-corpus.v0",
  "corpus_id": "rea-numeric-intent-known-answer-v0",
  "status": "design_fixture_only",
  "semantics_note": "Expected labels are design-time reference outcomes, not outputs from an implemented validator. raw_value_token is a string so the fixture preserves the exact source spelling. URN values beginning with urn:example: are synthetic sentinels for mismatch fixtures, not registrations in the canonical quantity/unit authorities.",
  "cases": [
    {
      "id": "binary64-integer-vs-decimal-token",
      "path": "/reading",
      "raw_value_token": "42.0",
      "intent": "binary64",
      "contract": {
        "semantics": "rfc8785_ecmascript_binary64",
        "non_finite_policy": "reject",
        "negative_zero_policy": "jcs_canonicalizes_to_zero"
      },
      "expected": "valid_binary64",
      "expected_canonical_number": "42"
    },
    {
      "id": "binary64-decimal-near-equivalent",
      "path": "/reading",
      "raw_value_token": "0.10000000000000001",
      "intent": "binary64",
      "contract": {
        "semantics": "rfc8785_ecmascript_binary64",
        "non_finite_policy": "reject",
        "negative_zero_policy": "jcs_canonicalizes_to_zero"
      },
      "expected": "valid_binary64",
      "expected_canonical_number": "0.1"
    },
    {
      "id": "binary64-negative-zero",
      "path": "/reading",
      "raw_value_token": "-0",
      "intent": "binary64",
      "contract": {
        "semantics": "rfc8785_ecmascript_binary64",
        "non_finite_policy": "reject",
        "negative_zero_policy": "jcs_canonicalizes_to_zero"
      },
      "expected": "valid_binary64",
      "expected_canonical_number": "0"
    },
    {
      "id": "binary64-exponent",
      "path": "/reading",
      "raw_value_token": "1e3",
      "intent": "binary64",
      "contract": {
        "semantics": "rfc8785_ecmascript_binary64",
        "non_finite_policy": "reject",
        "negative_zero_policy": "jcs_canonicalizes_to_zero"
      },
      "expected": "valid_binary64",
      "expected_canonical_number": "1000"
    },
    {
      "id": "safe-integer-inclusive-upper-bound",
      "path": "/counter",
      "raw_value_token": "9007199254740991",
      "intent": "safe_integer",
      "contract": {
        "signedness": "signed",
        "min_value": "-9007199254740991",
        "max_value": "9007199254740991",
        "integer_form_only": true,
        "safe_range_only": true
      },
      "expected": "valid_safe_integer"
    },
    {
      "id": "safe-integer-first-unsafe",
      "path": "/counter",
      "raw_value_token": "9007199254740992",
      "intent": "safe_integer",
      "contract": {
        "signedness": "signed",
        "min_value": "-9007199254740991",
        "max_value": "9007199254740991",
        "integer_form_only": true,
        "safe_range_only": true
      },
      "expected": "unsafe_integer"
    },
    {
      "id": "safe-integer-exponent-token",
      "path": "/counter",
      "raw_value_token": "1e3",
      "intent": "safe_integer",
      "contract": {
        "signedness": "signed",
        "min_value": "-9007199254740991",
        "max_value": "9007199254740991",
        "integer_form_only": true,
        "safe_range_only": true
      },
      "expected": "lexical_form_mismatch"
    },
    {
      "id": "exact-integer-string-beyond-safe-range",
      "path": "/account_id",
      "raw_value_token": "\"9007199254740993\"",
      "intent": "exact_integer_string",
      "contract": {
        "signedness": "unsigned",
        "max_digits": 32,
        "min_value": "0",
        "max_value": "18446744073709551615",
