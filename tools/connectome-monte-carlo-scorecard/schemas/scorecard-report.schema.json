{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/connectome-monte-carlo-scorecard-report-v1.json",
  "title": "Connectome Monte Carlo scorecard report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "alpha",
    "wilson_z_critical",
    "groups"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "wilson_z_critical": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group_summary"
      }
    }
  },
  "$defs": {
    "nullable_number": {
      "type": [
        "number",
        "null"
      ]
    },
    "wilson_interval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lower",
            "upper"
          ],
          "properties": {
            "lower": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "upper": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "topology_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "empty",
        "bounded",
        "left_ray",
        "right_ray",
        "two_rays",
        "disconnected",
        "whole_line"
      ],
      "properties": {
        "empty": {
          "type": "integer",
          "minimum": 0
        },
        "bounded": {
          "type": "integer",
          "minimum": 0
        },
        "left_ray": {
          "type": "integer",
          "minimum": 0
        },
        "right_ray": {
          "type": "integer",
          "minimum": 0
        },
        "two_rays": {
          "type": "integer",
          "minimum": 0
        },
        "disconnected": {
          "type": "integer",
          "minimum": 0
        },
        "whole_line": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "group_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "method_id",
        "regime",
        "true_beta",
        "tested_null_beta",
        "attempted_replicates",
        "completed_replicates",
        "failed_replicates",
        "not_applicable_replicates",
        "failure_rate",
        "p_value_replicates",
        "rejected_replicates",
        "rejection_rate",
        "rejection_wilson_95",
        "empirical_size",
        "size_wilson_95",
        "empirical_power",
        "power_wilson_95",
        "rejection_rate_missing_all_nonreject",
        "rejection_rate_missing_all_reject",
        "missing_p_value_replicates",
        "p_value_histogram_10",
        "estimate_replicates",
        "mean_estimate",
        "bias",
        "rmse",
        "confidence_set_replicates",
        "covered_replicates",
        "coverage_rate",
        "coverage_wilson_95",
        "coverage_rate_missing_uncovered",
        "coverage_rate_missing_covered",
        "missing_confidence_set_replicates",
        "topology_counts",
        "unbounded_confidence_set_replicates",
        "finite_width_replicates",
        "median_finite_set_width",
        "p90_finite_set_width",
        "runtime_replicates",
        "median_runtime_micros",
        "p95_runtime_micros"
      ],
      "properties": {
        "scenario_id": {
          "type": "string"
        },
        "method_id": {
          "type": "string"
        },
        "regime": {
          "enum": [
            "true_null",
            "alternative"
          ]
        },
        "true_beta": {
          "type": "number"
        },
        "tested_null_beta": {
          "type": "number"
        },
        "attempted_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "completed_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "failed_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "failure_rate": {
          "$ref": "#/$defs/nullable_number"
        },
        "p_value_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "rejection_rate": {
          "$ref": "#/$defs/nullable_number"
        },
        "rejection_wilson_95": {
          "$ref": "#/$defs/wilson_interval"
        },
        "empirical_size": {
          "$ref": "#/$defs/nullable_number"
        },
        "size_wilson_95": {
          "$ref": "#/$defs/wilson_interval"
        },
        "empirical_power": {
          "$ref": "#/$defs/nullable_number"
        },
        "power_wilson_95": {
          "$ref": "#/$defs/wilson_interval"
        },
        "rejection_rate_missing_all_nonreject": {
          "$ref": "#/$defs/nullable_number"
        },
        "rejection_rate_missing_all_reject": {
          "$ref": "#/$defs/nullable_number"
        },
        "missing_p_value_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "p_value_histogram_10": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "estimate_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "mean_estimate": {
          "$ref": "#/$defs/nullable_number"
        },
        "bias": {
          "$ref": "#/$defs/nullable_number"
        },
        "rmse": {
          "$ref": "#/$defs/nullable_number"
        },
        "confidence_set_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "covered_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_rate": {
          "$ref": "#/$defs/nullable_number"
        },
        "coverage_wilson_95": {
          "$ref": "#/$defs/wilson_interval"
        },
        "coverage_rate_missing_uncovered": {
          "$ref": "#/$defs/nullable_number"
        },
        "coverage_rate_missing_covered": {
          "$ref": "#/$defs/nullable_number"
        },
        "missing_confidence_set_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "topology_counts": {
          "$ref": "#/$defs/topology_counts"
        },
        "unbounded_confidence_set_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "finite_width_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "median_finite_set_width": {
          "$ref": "#/$defs/nullable_number"
        },
        "p90_finite_set_width": {
          "$ref": "#/$defs/nullable_number"
        },
        "runtime_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "median_runtime_micros": {
          "$ref": "#/$defs/nullable_number"
        },
        "p95_runtime_micros": {
          "$ref": "#/$defs/nullable_number"
        }
      }
    }
  }
}
