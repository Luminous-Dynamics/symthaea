{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/connectome-monte-carlo-replicate-batch-v1.json",
  "title": "Connectome Monte Carlo replication batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "alpha",
    "wilson_z_critical",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "wilson_z_critical": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/replication_result"
      }
    }
  },
  "$defs": {
    "confidence_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper"
      ],
      "properties": {
        "lower": {
          "type": [
            "number",
            "null"
          ]
        },
        "upper": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "confidence_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intervals"
      ],
      "properties": {
        "intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/confidence_interval"
          }
        }
      }
    },
    "replication_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "method_id",
        "replication_id",
        "seed",
        "regime",
        "true_beta",
        "tested_null_beta",
        "status",
        "p_value",
        "point_estimate",
        "confidence_set",
        "runtime_micros"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "replication_id": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "regime": {
          "enum": [
            "true_null",
            "alternative"
          ]
        },
        "true_beta": {
          "type": "number"
        },
        "tested_null_beta": {
          "type": "number"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "not_applicable"
          ]
        },
        "p_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "point_estimate": {
          "type": [
            "number",
            "null"
          ]
        },
        "confidence_set": {
          "oneOf": [
            {
              "$ref": "#/$defs/confidence_set"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_micros": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "p_value"
                ],
                "properties": {
                  "p_value": {
                    "type": "number"
                  }
                }
              },
              {
                "required": [
                  "point_estimate"
                ],
                "properties": {
                  "point_estimate": {
                    "type": "number"
                  }
                }
              },
              {
                "required": [
                  "confidence_set"
                ],
                "properties": {
                  "confidence_set": {
                    "$ref": "#/$defs/confidence_set"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "p_value": {
                "type": "null"
              },
              "point_estimate": {
                "type": "null"
              },
              "confidence_set": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
