{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Luminous-Dynamics/symthaea/main/tools/cyber-hunt-fixture/schemas/query-v1.schema.json",
  "title": "Synthetic cyber hunt read-only query v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "filters",
    "projection",
    "limit"
  ],
  "properties": {
    "schema_version": {
      "const": "cyber-hunt-query-v1"
    },
    "filters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "field",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "text_equals"
              },
              "field": {
                "enum": [
                  "record_id",
                  "source_event_id",
                  "delivery_id",
                  "host_id",
                  "principal_id",
                  "source_address",
                  "destination",
                  "device_posture",
                  "source",
                  "event_type",
                  "result",
                  "summary",
                  "integrity_state",
                  "change_ticket"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "field",
              "from_inclusive_ms",
              "to_exclusive_ms"
            ],
            "properties": {
              "kind": {
                "const": "time_range"
              },
              "field": {
                "enum": [
                  "event_time_ms",
                  "ingest_time_ms"
                ]
              },
              "from_inclusive_ms": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "to_exclusive_ms": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "minimum"
            ],
            "properties": {
              "kind": {
                "const": "bytes_sent_at_least"
              },
              "minimum": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ]
      }
    },
    "projection": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "contains": {
        "const": "record_id"
      },
      "items": {
        "enum": [
          "record_id",
          "source_event_id",
          "delivery_id",
          "event_time_ms",
          "ingest_time_ms",
          "host_id",
          "principal_id",
          "source_address",
          "destination",
          "bytes_sent",
          "device_posture",
          "source",
          "event_type",
          "result",
          "summary",
          "change_ticket",
          "integrity_state"
        ]
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  }
}
