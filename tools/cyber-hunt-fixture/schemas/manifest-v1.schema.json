{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Luminous-Dynamics/symthaea/main/tools/cyber-hunt-fixture/schemas/manifest-v1.schema.json",
  "title": "Synthetic cyber hunt fixture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator_version",
    "source_commit",
    "synthetic_only",
    "seed",
    "requested_record_count",
    "actual_record_count",
    "malicious_campaign_count",
    "benign_change_decoy_count",
    "duplicate_delivery_count",
    "source_identity_conflict_count",
    "solver_file",
    "oracle_file",
    "files",
    "qualification_state",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "cyber-hunt-manifest-v1"
    },
    "generator_version": {
      "const": "cyber-hunt-fixture-v1"
    },
    "source_commit": {
      "type": "string",
      "minLength": 1
    },
    "synthetic_only": {
      "const": true
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "requested_record_count": {
      "type": "integer",
      "minimum": 500,
      "maximum": 250000
    },
    "actual_record_count": {
      "type": "integer",
      "minimum": 500,
      "maximum": 250000
    },
    "malicious_campaign_count": {
      "type": "integer",
      "minimum": 1
    },
    "benign_change_decoy_count": {
      "type": "integer",
      "minimum": 1
    },
    "duplicate_delivery_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_identity_conflict_count": {
      "type": "integer",
      "minimum": 0
    },
    "solver_file": {
      "const": "solver/events.jsonl"
    },
    "oracle_file": {
      "const": "evaluator/oracle.json"
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "solver/events.jsonl": {
          "$ref": "#/$defs/fileIdentity"
        },
        "evaluator/oracle.json": {
          "$ref": "#/$defs/fileIdentity"
        },
        "solver/manifest.json": {
          "$ref": "#/$defs/fileIdentity"
        }
      },
      "required": [
        "solver/events.jsonl",
        "solver/manifest.json",
        "evaluator/oracle.json"
      ]
    },
    "qualification_state": {
      "const": "UNSCORED"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "utf8_bytes",
        "record_count"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "utf8_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
