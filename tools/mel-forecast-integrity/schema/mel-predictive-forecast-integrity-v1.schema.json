{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Luminous-Dynamics/symthaea/blob/main/tools/mel-forecast-integrity/schema/mel-predictive-forecast-integrity-v1.schema.json",
  "title":"MEL Predictive Forecast Integrity V1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","session_id","clock_domain_id","clock_origin_id","events"],
  "properties":{
    "schema_version":{"const":"mel-predictive-forecast-integrity-v1"},
    "session_id":{"$ref":"#/$defs/id"},
    "clock_domain_id":{"$ref":"#/$defs/id"},
    "clock_origin_id":{"$ref":"#/$defs/id"},
    "events":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/event"}}
  },
  "$defs":{
    "id":{"type":"string","minLength":1,"pattern":"\\S"},
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "event":{
      "type":"object","additionalProperties":false,
      "required":["event_id","sequence","monotonic_time_ns","previous_event_sha256","event_sha256","kind"],
      "properties":{
        "event_id":{"$ref":"#/$defs/id"},
        "sequence":{"type":"integer","minimum":1},
        "monotonic_time_ns":{"type":"integer","minimum":0},
        "previous_event_sha256":{"$ref":"#/$defs/hash"},
        "event_sha256":{"$ref":"#/$defs/hash"},
        "kind":{"oneOf":[
          {"$ref":"#/$defs/input_observed"},
          {"$ref":"#/$defs/forecast_issued"},
          {"$ref":"#/$defs/forecast_displayed"},
          {"$ref":"#/$defs/partner_disposition"},
          {"$ref":"#/$defs/forecast_invalidated"},
          {"$ref":"#/$defs/realization_started"},
          {"$ref":"#/$defs/realization_completed"}
        ]}
      }
    },
    "input_observed":{
      "type":"object","additionalProperties":false,"required":["event_type","payload"],
      "properties":{"event_type":{"const":"input_observed"},"payload":{
        "type":"object","additionalProperties":false,"required":["input_id","input_artifact_sha256"],
        "properties":{"input_id":{"$ref":"#/$defs/id"},"input_artifact_sha256":{"$ref":"#/$defs/hash"}}
      }}
    },
    "forecast_issued":{
      "type":"object","additionalProperties":false,"required":["event_type","payload"],
      "properties":{"event_type":{"const":"forecast_issued"},"payload":{
        "type":"object","additionalProperties":false,
        "required":["forecast_id","input_event_id","policy_sha256","prediction_set_sha256","predicted_event_count","target_window","expires_at_ns","supersedes_forecast_id"],
        "properties":{
          "forecast_id":{"$ref":"#/$defs/id"},"input_event_id":{"$ref":"#/$defs/id"},
          "policy_sha256":{"$ref":"#/$defs/hash"},"prediction_set_sha256":{"$ref":"#/$defs/hash"},
          "predicted_event_count":{"type":"integer","minimum":1},
          "target_window":{"type":"object","additionalProperties":false,"required":["start_ns","end_ns"],"properties":{"start_ns":{"type":"integer","minimum":0},"end_ns":{"type":"integer","minimum":0}}},
          "expires_at_ns":{"type":"integer","minimum":0},
          "supersedes_forecast_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]}
        }
      }}
    },
    "forecast_displayed":{
      "type":"object","additionalProperties":false,"required":["event_type","payload"],
      "properties":{"event_type":{"const":"forecast_displayed"},"payload":{
        "type":"object","additionalProperties":false,"required":["forecast_id","display_receipt_sha256","display_channel"],
        "properties":{"forecast_id":{"$ref":"#/$defs/id"},"display_receipt_sha256":{"$ref":"#/$defs/hash"},"display_channel":{"$ref":"#/$defs/id"}}
      }}
    },
    "partner_disposition":{
      "type":"object","additionalProperties":false,"required":["event_type","payload"],
      "properties":{"event_type":{"const":"partner_disposition"},"payload":{
        "type":"object","additionalProperties":false,
        "required":["forecast_id","actor_id","disposition","disposition_receipt_sha256"],
        "properties":{"forecast_id":{"$ref":"#/$defs/id"},"actor_id":{"$ref":"#/$defs/id"},"disposition":{"enum":["accepted","steered","vetoed","branched","ignored"]},"disposition_receipt_sha256":{"$ref":"#/$defs/hash"}}
      }}
    },
    "forecast_invalidated":{
      "type":"object","additionalProperties":false,"required":["event_type","payload"],
      "properties":{"event_type":{"const":"forecast_invalidated"},"payload":{
        "type":"object","additionalProperties":false,"required":["forecast_id","reason"],
        "properties":{"forecast_id":{"$ref":"#/$defs/id"},"reason":{"enum":["superseded","cancelled_by_collaborator","input_changed","expired","policy_changed"]}}
      }}
    },
    "realization_started":{
      "type":"object","additionalProperties":false,"required":["event_type","payload"],
      "properties":{"event_type":{"const":"realization_started"},"payload":{
        "type":"object","additionalProperties":false,"required":["forecast_id","realized_event_set_sha256","realized_event_count"],
        "properties":{"forecast_id":{"$ref":"#/$defs/id"},"realized_event_set_sha256":{"$ref":"#/$defs/hash"},"realized_event_count":{"type":"integer","minimum":1}}
      }}
    },
    "realization_completed":{
      "type":"object","additionalProperties":false,"required":["event_type","payload"],
      "properties":{"event_type":{"const":"realization_completed"},"payload":{
        "type":"object","additionalProperties":false,"required":["forecast_id","realized_artifact_sha256"],
        "properties":{"forecast_id":{"$ref":"#/$defs/id"},"realized_artifact_sha256":{"$ref":"#/$defs/hash"}}
      }}
    }
  }
}