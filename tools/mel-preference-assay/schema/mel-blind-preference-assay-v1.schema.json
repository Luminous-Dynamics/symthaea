{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mel-blind-preference-assay-v1.schema.json",
  "title": "Melothaea Blind Preference Assay v1",
  "description": "A deterministic presentation-order and evaluator side-bias audit. It does not measure musical quality by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assay_id",
    "frozen_at",
    "assignment_algorithm",
    "assignment_seed_commitment_sha256",
    "assignment_seed_revealed",
    "minimum_per_order_per_stratum",
    "minimum_identical_controls_for_bias_flag",
    "presentations",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": { "const": "mel-blind-preference-assay-v1" },
    "assay_id": { "type": "string", "minLength": 3, "maxLength": 100 },
    "frozen_at": { "type": "string", "format": "date-time" },
    "assignment_algorithm": { "const": "sha256-presentation-v1" },
    "assignment_seed_commitment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assignment_seed_revealed": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "minimum_per_order_per_stratum": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "minimum_identical_controls_for_bias_flag": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "presentations": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/presentation" }
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presentation_id",
        "case_id",
        "stratum",
        "judge_pseudonym_sha256",
        "candidate_a_sha256",
        "candidate_b_sha256",
        "left_candidate",
        "control_kind",
        "choice",
        "judgment_protocol_sha256"
      ],
      "properties": {
        "presentation_id": { "type": "string", "minLength": 1 },
        "case_id": { "type": "string", "minLength": 1 },
        "stratum": { "type": "string", "minLength": 1 },
        "judge_pseudonym_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_a_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_b_sha256": { "$ref": "#/$defs/sha256" },
        "left_candidate": { "enum": ["a", "b"] },
        "control_kind": { "enum": ["candidate_pair", "identical_duplicate"] },
        "choice": { "enum": ["left", "right", "tie", "neither", "skip"] },
        "judgment_protocol_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
