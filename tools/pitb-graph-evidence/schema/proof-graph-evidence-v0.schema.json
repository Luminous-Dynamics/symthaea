{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb/proof-graph-evidence-v0.schema.json",
  "title": "PITB typed proof-graph evidence snapshot v0",
  "description": "Content-addressed typed nodes, multi-relational edges and provenance artifacts. Hash verification is not semantic authentication; v0 never admits an edge directly to the proof scheduler.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "snapshot", "nodes", "edges", "artifacts"],
  "properties": {
    "schema_version": { "const": "pitb.proof-graph-evidence.v0" },
    "evidence_class": { "enum": ["synthetic_contract_fixture", "measured_snapshot"] },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/edge" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "repository_commit",
        "environment_sha256",
        "extractor_id",
        "extractor_version",
        "extractor_config_sha256"
      ],
      "properties": {
        "snapshot_id": { "type": "string", "minLength": 1 },
        "repository_commit": { "$ref": "#/$defs/sha1" },
        "environment_sha256": { "$ref": "#/$defs/sha256" },
        "extractor_id": { "type": "string", "minLength": 1 },
        "extractor_version": { "type": "string", "minLength": 1 },
        "extractor_config_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "kind",
        "label",
        "statement_sha256",
        "statement_artifact_id",
        "source_locator",
        "formal_name"
      ],
      "properties": {
        "node_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": {
          "enum": [
            "formal_declaration",
            "blueprint_node",
            "informal_statement",
            "module",
            "environment_artifact"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "statement_sha256": { "$ref": "#/$defs/sha256" },
        "statement_artifact_id": { "type": "string", "minLength": 1 },
        "source_locator": { "type": "string", "minLength": 1 },
        "formal_name": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "source_node_id",
        "target_node_id",
        "relation",
        "evidence_class",
        "status",
        "evidence_artifact_id",
        "confidence",
        "review_artifact_id",
        "reviewer_key_id"
      ],
      "properties": {
        "edge_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source_node_id": { "type": "string", "minLength": 1 },
        "target_node_id": { "type": "string", "minLength": 1 },
        "relation": {
          "enum": [
            "type_reference",
            "proof_term_reference",
            "instance_synthesis",
            "blueprint_dependency",
            "informal_candidate_dependency",
            "cross_formality_match",
            "module_environment_dependency"
          ]
        },
        "evidence_class": {
          "enum": [
            "lean_elaborator",
            "lean_instance_trace",
            "blueprint_curated",
            "informal_extractor",
            "llm_alignment",
            "lean_build_graph"
          ]
        },
        "status": {
          "enum": ["observed", "candidate", "human_reviewed", "rejected"]
        },
        "evidence_artifact_id": { "type": "string", "minLength": 1 },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "review_artifact_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "reviewer_key_id": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "path", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["statement", "edge_evidence", "review_attestation"]
        },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}