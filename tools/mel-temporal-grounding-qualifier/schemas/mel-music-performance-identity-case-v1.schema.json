{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mel-music-performance-identity-case-v1.schema.json",
  "title": "MEL property-relative musical performance identity case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "benchmark_version",
    "dataset_revision_sha256",
    "evaluator_protocol_sha256",
    "triads"
  ],
  "properties": {
    "schema": {
      "const": "mel-music-performance-identity-case-v1"
    },
    "benchmark_id": {
      "const": "MEL-PERFORMANCE-IDENTITY"
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "dataset_revision_sha256": {
      "$ref": "#/$defs/digest"
    },
    "evaluator_protocol_sha256": {
      "$ref": "#/$defs/digest"
    },
    "triads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/triad"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "property": {
      "enum": [
        "ChordQuality",
        "RootPitchClass",
        "Voicing",
        "RelativeIntervalSequence",
        "MelodicContour",
        "RhythmicRatio",
        "PulseRate",
        "InstrumentFamily"
      ]
    },
    "stayFactor": {
      "enum": [
        "DifferentTakeSamePerformer",
        "DifferentPerformerSameInstrument",
        "StrumOrArticulationChange",
        "ExpressiveTimingChange",
        "DifferentTempoSameRhythmicRatio",
        "DifferentRendererSamePerformance"
      ]
    },
    "flipFactor": {
      "enum": [
        "ChordQualityChange",
        "RootPitchClassChange",
        "VoicingChange",
        "RelativeIntervalSequenceChange",
        "MelodicContourChange",
        "RhythmicRatioChange",
        "PulseRateChange",
        "InstrumentFamilyChange"
      ]
    },
    "relation": {
      "enum": [
        "Same",
        "Different"
      ]
    },
    "answer": {
      "enum": [
        "ChoiceA",
        "ChoiceB",
        "Unparseable",
        "Abstain"
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "audio_sha256",
        "question",
        "question_sha256",
        "option_a_relation",
        "option_b_relation",
        "expected_relation",
        "model_answer"
      ],
      "properties": {
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "audio_sha256": {
          "$ref": "#/$defs/digest"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "question_sha256": {
          "$ref": "#/$defs/digest"
        },
        "option_a_relation": {
          "$ref": "#/$defs/relation"
        },
        "option_b_relation": {
          "$ref": "#/$defs/relation"
        },
        "expected_relation": {
          "$ref": "#/$defs/relation"
        },
        "model_answer": {
          "$ref": "#/$defs/answer"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response",
        "take_identity_sha256",
        "performance_identity_sha256",
        "performer_identity_sha256",
        "instrument_family_sha256",
        "renderer_identity_sha256"
      ],
      "properties": {
        "response": {
          "$ref": "#/$defs/response"
        },
        "take_identity_sha256": {
          "$ref": "#/$defs/digest"
        },
        "performance_identity_sha256": {
          "$ref": "#/$defs/digest"
        },
        "performer_identity_sha256": {
          "$ref": "#/$defs/digest"
        },
        "instrument_family_sha256": {
          "$ref": "#/$defs/digest"
        },
        "renderer_identity_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "triad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "pair_id",
        "source_work_lineage_sha256",
        "target_property",
        "performance_stay_factor",
        "musical_flip_factor",
        "target_property_reference_sha256",
        "pairing_manifest_sha256",
        "model_identity_sha256",
        "system_prompt_sha256",
        "runtime_identity_sha256",
        "decoding_config_sha256",
        "clean",
        "performance_stay",
        "musical_flip"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "pair_id": {
          "type": "string",
          "minLength": 1
        },
        "source_work_lineage_sha256": {
          "$ref": "#/$defs/digest"
        },
        "target_property": {
          "$ref": "#/$defs/property"
        },
        "performance_stay_factor": {
          "$ref": "#/$defs/stayFactor"
        },
        "musical_flip_factor": {
          "$ref": "#/$defs/flipFactor"
        },
        "target_property_reference_sha256": {
          "$ref": "#/$defs/digest"
        },
        "pairing_manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "model_identity_sha256": {
          "$ref": "#/$defs/digest"
        },
        "system_prompt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "runtime_identity_sha256": {
          "$ref": "#/$defs/digest"
        },
        "decoding_config_sha256": {
          "$ref": "#/$defs/digest"
        },
        "clean": {
          "$ref": "#/$defs/variant"
        },
        "performance_stay": {
          "$ref": "#/$defs/variant"
        },
        "musical_flip": {
          "$ref": "#/$defs/variant"
        }
      }
    }
  }
}
