{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mel-temporal-unitizing-alpha-u-corpus-v1.schema.json",
  "title": "MEL Corrected Unitizing Alpha-U Corpus Case V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "annotation_manifest_sha256",
    "minimum_eligible_unitizers_per_item",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "mel-temporal-unitizing-alpha-u-corpus-v1"
    },
    "annotation_manifest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "minimum_eligible_unitizers_per_item": {
      "type": "integer",
      "minimum": 2,
      "maximum": 65535
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audio_sha256",
        "sample_rate_hz",
        "channels",
        "total_frames"
      ],
      "properties": {
        "audio_sha256": {
          "$ref": "#/$defs/digest"
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "total_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_frame",
        "end_frame"
      ],
      "properties": {
        "start_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotator_id_sha256",
        "annotation_sha256",
        "state",
        "intervals",
        "status_reason"
      ],
      "properties": {
        "annotator_id_sha256": {
          "$ref": "#/$defs/digest"
        },
        "annotation_sha256": {
          "$ref": "#/$defs/digest"
        },
        "state": {
          "enum": [
            "Present",
            "Absent",
            "Ambiguous",
            "NotEstimable"
          ]
        },
        "intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          }
        },
        "status_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "source_work_cluster_sha256",
        "query_id",
        "query_text",
        "artifact",
        "annotation_policy_version",
        "annotations"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "source_work_cluster_sha256": {
          "$ref": "#/$defs/digest"
        },
        "query_id": {
          "type": "string",
          "minLength": 1
        },
        "query_text": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "annotation_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/annotation"
          }
        }
      }
    }
  }
}
