{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mel-multi-annotator-temporal-grounding-v1.schema.json",
  "title": "MEL Multi-Annotator Temporal Grounding Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "query_id",
    "query_text",
    "artifact",
    "annotation_policy_version",
    "annotation_manifest_sha256",
    "minimum_annotator_count",
    "plan",
    "prediction",
    "annotations"
  ],
  "properties": {
    "schema": {
      "const": "mel-multi-annotator-temporal-grounding-v1"
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "query_text": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "annotation_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "annotation_manifest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "minimum_annotator_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 65535
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_version",
        "minimum_interval_iou"
      ],
      "properties": {
        "evaluator_version": {
          "type": "string",
          "minLength": 1
        },
        "minimum_interval_iou": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "query_id",
        "artifact",
        "state"
      ],
      "properties": {
        "schema_version": {
          "const": "mel-temporal-grounding-v1"
        },
        "query_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "state": {
          "$ref": "#/$defs/predictionState"
        }
      }
    },
    "annotations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/annotation"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audio_sha256",
        "sample_rate_hz",
        "channels",
        "total_frames"
      ],
      "properties": {
        "audio_sha256": {
          "$ref": "#/$defs/digest"
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "total_frames": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_frame",
        "end_frame"
      ],
      "properties": {
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotator_id_sha256",
        "annotation_sha256",
        "state",
        "intervals",
        "status_reason"
      ],
      "properties": {
        "annotator_id_sha256": {
          "$ref": "#/$defs/digest"
        },
        "annotation_sha256": {
          "$ref": "#/$defs/digest"
        },
        "state": {
          "enum": [
            "Present",
            "Absent",
            "Ambiguous",
            "NotEstimable"
          ]
        },
        "intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          }
        },
        "status_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "predictionState": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "Occurrences"
          ],
          "additionalProperties": false,
          "properties": {
            "Occurrences": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "intervals"
              ],
              "properties": {
                "intervals": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/interval"
                  }
                }
              }
            }
          }
        },
        {
          "const": "QueryAbsent"
        },
        {
          "const": "NotDetected"
        },
        {
          "type": "object",
          "required": [
            "Ambiguous"
          ],
          "additionalProperties": false,
          "properties": {
            "Ambiguous": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "candidate_intervals",
                "reason"
              ],
              "properties": {
                "candidate_intervals": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/interval"
                  }
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "NotEstimable"
          ],
          "additionalProperties": false,
          "properties": {
            "NotEstimable": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "Unparseable"
          ],
          "additionalProperties": false,
          "properties": {
            "Unparseable": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "raw_output_sha256",
                "reason"
              ],
              "properties": {
                "raw_output_sha256": {
                  "$ref": "#/$defs/digest"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    }
  }
}
