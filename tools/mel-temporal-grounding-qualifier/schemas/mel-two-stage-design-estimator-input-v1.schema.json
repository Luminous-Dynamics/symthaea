{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mel-two-stage-design-estimator-input-v1.schema.json",
  "title": "MEL two-stage design-based estimator input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dataset",
    "expected_selection_receipt_sha256",
    "metric_id",
    "model_identity_sha256",
    "evaluator_version",
    "scoring_plan_sha256",
    "observed_audit_outcomes"
  ],
  "properties": {
    "schema": {
      "const": "mel-two-stage-design-estimator-input-v1"
    },
    "dataset": {
      "type": "object"
    },
    "expected_selection_receipt_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "metric_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_audit_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "source_work_id_sha256",
          "scoring_report_sha256",
          "model_identity_sha256",
          "evaluator_version",
          "scoring_plan_sha256",
          "metric_id",
          "value_ppm"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "value_ppm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "source_work_id_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "scoring_report_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "model_identity_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evaluator_version": {
            "type": "string",
            "minLength": 1
          },
          "scoring_plan_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "model_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "scoring_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
