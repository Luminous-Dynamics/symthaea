      "bootstrap_replicates",
      "bootstrap_seed",
      "baseline_violations",
      "candidate_violations",
      "candidate_only_violations",
      "baseline_only_violations",
      "mcnemar_exact_two_sided_p",
      "baseline_violation_rate",
      "candidate_violation_rate",
      "baseline_violation_upper95_exact",
      "candidate_violation_upper95_exact"
    ],
    "risk_precision_examples": [
      {
        "target_one_sided_95_upper_rate": 0.01,
        "required_independent_zero_violation_episodes": 299
      },
      {
        "target_one_sided_95_upper_rate": 0.001,
        "required_independent_zero_violation_episodes": 2995
      },
      {
        "note": "Exact zero-event binomial planning formula; assumes independent Bernoulli episodes and says nothing about untested distributions or dependent sampling."
