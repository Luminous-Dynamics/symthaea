  "paired_inference": {
    "status": "implemented_analysis_utility_synthetic_selftest_only",
    "input_contract": "unquoted episode CSV with scenario, seed, policy, shielded, a finite numeric metric and a binary episode-level violation field",
    "pairing_unit": "complete episode keyed by scenario, seed and shielded setting",
    "effects": [
      "baseline_mean",
      "candidate_mean",
      "candidate_minus_baseline_mean",
      "median_paired_delta"
    ],
    "uncertainty": {
      "method": "percentile paired bootstrap of episode-level differences",
      "confidence_level": 0.95,
      "default_replicates": 10000,
      "replicates_must_be_at_least": 1000,
      "deterministic_prng": true,
      "bootstrap_seed": "deterministic per scenario and shielded flag; emitted as bootstrap_seed"
    },
    "violation_risk": {
      "rate": "observed episode-level violations / paired episode count",
      "upper_confidence_bound": "one-sided 95% exact Clopper-Pearson",
      "paired_test": "exact two-sided McNemar on discordant paired episode outcomes"
    },
    "fail_closed_on": [
      "missing_columns",
      "duplicate_header_or_policy_episode_row",
      "missing_baseline_or_candidate_seed_pair",
      "non_finite_metric",
      "invalid_episode_violation_flag",
      "quoted_csv_field"
    ],
    "interpretation_rule": "No automatic winner label; metric direction must be preregistered and per-condition outcomes must remain visible.",
    "output_columns": [
