  "mandatory_gates": [
    "invalid_input_or_missing_calibration_is_uncertified",
    "budget_exhaustion_is_uncertified",
    "empty_fallback_never_reverts_to_predictive_policy",
    "horizon_1_parity_with_one_step_evaluator",
    "viable_action_sets_are_nested_as_horizon_grows",
    "independent_actual_plant_evaluation",
    "disjoint_calibration_tuning_and_test_seeds",
    "independent_metrics_recomputation_from_raw_traces",
    "active_probe_certificate_uses_common_hull_and_common_safe_continuation",
    "no_information_claim_from_probe_selection_without_observed_uncertainty_reduction",
    "empty_post_observation_model_set_invalidates_certificates_and_never_restores_prior_silently",
    "noise_compatibility_is_not_reported_as_true_plant_membership",
    "active_learning_comparisons_use_fixed_exploration_budget_and_matched_violation_budget",
    "certificate_lease_binds_state_model_limits_calibration_authority_monitor_and_evidence_revisions",
    "stale_certificate_rejected_after_any_bound_context_change",
    "certificate_validation_and_action_application_are_atomic_or_toctou_tested",
    "certificate_horizon_and_expiry_are_checked_at_use"
  ],
  "proposed_targets_not_results": {
    "in_envelope_false_certificates": 0,
    "false_veto_reduction_vs_global_margin_fraction": 0.2,
    "nominal_return_loss_fraction_max": 0.05,
    "note": "Targets are hypotheses and must be reported with denominators, confidence intervals, and per-condition results."
