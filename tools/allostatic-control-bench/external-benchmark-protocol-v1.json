  "active_falsification": {
    "status": "predeclared_external_evaluation_arm",
    "comparators": [
      "task_greedy_certified_action",
      "random_certified_action",
      "maximin_prediction_box_separation",
      "probabilistic_information_gain_when_observation_likelihood_is_validated"
    ],
    "measures": [
      "probe_cost",
      "observed_hypothesis_reduction",
      "viable_action_gain",
      "false_model_eliminations",
      "model_family_falsification",
      "safe_capability_frontier_after_fixed_interaction_budget"
    ],
    "terminology_constraint": "Maximin interval separation is a geometric distinguishability proxy, not mutual information."
  },
  "certificate_lifecycle": {
    "status": "required_external_adapter_gate",
    "bound_fields": [
      "state_revision",
      "dynamics_revision",
      "limits_revision",
      "calibration_revision",
      "authority_revision",
      "monitor_epoch",
      "evidence_digest",
      "issued_step",
      "expiry_step",
      "certified_horizon"
    ],
    "reject_when": [
      "state_revision_changed",
      "dynamics_revision_changed",
      "limits_revision_changed",
      "calibration_revision_changed",
      "authority_revision_changed",
      "monitor_epoch_changed",
      "evidence_digest_changed",
      "lease_expired",
      "clock_regressed",
      "requested_horizon_exceeds_certified_horizon"
    ],
    "rule": "A rejected lease requires recertification; never downgrade an invalidation to a warning and continue using the cached permission."
  },
  "comparison_rules": [
    "Native MPSC/CBF and neural-CBF filters must be compared only on tasks/configurations where their constraints and action semantics match.",
    "Modern conformal SLS-MPC and GPU-SLS references count as headline comparators only after pinned reproduction or documented mathematical adaptation.",
    "Hardware-accelerated runtime comparisons must publish hardware, solver, precision, deadline and compute budgets; do not infer speed superiority from different hardware."
  ]
