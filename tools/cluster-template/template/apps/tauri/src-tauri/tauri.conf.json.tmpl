{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{cluster_display}}",
  "version": "0.1.0",
  "identifier": "net.mycelix.{{cluster_name}}",
  "build": {
    "frontendDist": "../../leptos/dist",
    "devUrl": "http://localhost:{{trunk_port}}",
    "beforeBuildCommand": "cd ../../leptos && trunk build --release",
    "beforeDevCommand": "cd ../../leptos && trunk serve --port {{trunk_port}}"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "{{cluster_display}} — Mycelix",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https:; connect-src 'self' https: wss: ws://localhost:*; font-src 'self' https: data:; img-src 'self' https: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  },
  "plugins": {
    "shell": { "open": true }
  }
}
