{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/connectome-metric-calibration-output-v1.schema.json",
  "title": "Positive-control predictive metric calibration report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metric_id",
    "direction",
    "config",
    "bins",
    "zero_effect_false_positive_upper_bound",
    "minimum_positive_control_detection_lower_bound",
    "monotonicity_violations",
    "calibrated_for_declared_grid"
  ],
  "properties": {
    "schema_version": {
      "const": "connectome-metric-calibration-v1"
    },
    "metric_id": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "HigherIsBetter",
        "LowerIsBetter"
      ]
    },
    "config": {
      "$ref": "#/$defs/config"
    },
    "bins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/bin"
      }
    },
    "zero_effect_false_positive_upper_bound": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "minimum_positive_control_detection_lower_bound": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "monotonicity_violations": {
      "type": "integer",
      "minimum": 0
    },
    "calibrated_for_declared_grid": {
      "type": "boolean"
    }
  },
  "$defs": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_effect_magnitude",
        "minimum_detection_probability",
        "maximum_null_false_positive_probability",
        "tie_tolerance",
        "monotonicity_tolerance",
        "wilson_z_critical"
      ],
      "properties": {
        "minimum_effect_magnitude": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_detection_probability": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "maximum_null_false_positive_probability": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "tie_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "monotonicity_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "wilson_z_critical": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "bin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_magnitude",
        "replicate_count",
        "positive_control_wins",
        "ties",
        "positive_control_losses",
        "positive_control_win_rate",
        "one_sided_wilson_lower_bound",
        "one_sided_wilson_upper_bound",
        "mean_oriented_improvement",
        "mean_dynamic_range_fraction"
      ],
      "properties": {
        "effect_magnitude": {
          "type": "number",
          "minimum": 0
        },
        "replicate_count": {
          "type": "integer",
          "minimum": 1
        },
        "positive_control_wins": {
          "type": "integer",
          "minimum": 0
        },
        "ties": {
          "type": "integer",
          "minimum": 0
        },
        "positive_control_losses": {
          "type": "integer",
          "minimum": 0
        },
        "positive_control_win_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "one_sided_wilson_lower_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "one_sided_wilson_upper_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_oriented_improvement": {
          "type": "number"
        },
        "mean_dynamic_range_fraction": {
          "type": "number"
        }
      }
    }
  }
}
