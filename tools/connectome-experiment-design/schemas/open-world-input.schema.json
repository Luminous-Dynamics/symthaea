{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/connectome-open-world-eig-input-v1.schema.json",
  "title": "Open-world connectome experiment design input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "priors",
    "candidates"
  ],
  "properties": {
    "priors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cost",
        "outcomes",
        "hypothesis_ids",
        "likelihood_scenarios"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cost": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hypothesis_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "contains": {
            "const": "OTHER_OR_UNRESOLVED"
          },
          "minContains": 1,
          "maxContains": 1
        },
        "likelihood_scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/likelihood_scenario"
          }
        }
      }
    },
    "likelihood_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "likelihoods_by_hypothesis"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "likelihoods_by_hypothesis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
