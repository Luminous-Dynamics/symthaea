{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/connectome-decision-value-input-v1.schema.json",
  "title": "Open-world decision-focused EVSI experiment-design input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "priors",
    "decision_problem",
    "candidates"
  ],
  "properties": {
    "priors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "decision_problem": {
      "$ref": "#/$defs/decision_problem"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "open-world-input.schema.json#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "decision_problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hypothesis_ids",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "utility_by_hypothesis"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "utility_by_hypothesis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        }
      }
    }
  }
}
