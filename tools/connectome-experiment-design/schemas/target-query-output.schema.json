{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/connectome-target-query-eig-output-v1.schema.json",
  "title": "Open-world target causal query experiment-design report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query",
    "ranked_experiments"
  ],
  "properties": {
    "schema_version": {
      "const": "connectome-target-query-eig-v1"
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "ranked_experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ranked_experiment"
      }
    }
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hypothesis_ids",
        "answer_by_hypothesis"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer_by_hypothesis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ranked_experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "score"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "query_id",
        "cost",
        "unresolved_prior_mass",
        "worst_case_scenario_id",
        "best_case_scenario_id",
        "worst_case_information_gain_bits",
        "best_case_information_gain_bits",
        "worst_case_information_gain_bits_per_cost",
        "best_case_information_gain_bits_per_cost",
        "scenario_scores"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "minLength": 1
        },
        "query_id": {
          "type": "string",
          "minLength": 1
        },
        "cost": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unresolved_prior_mass": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "worst_case_scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "best_case_scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "worst_case_information_gain_bits": {
          "type": "number",
          "minimum": 0
        },
        "best_case_information_gain_bits": {
          "type": "number",
          "minimum": 0
        },
        "worst_case_information_gain_bits_per_cost": {
          "type": "number",
          "minimum": 0
        },
        "best_case_information_gain_bits_per_cost": {
          "type": "number",
          "minimum": 0
        },
        "scenario_scores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scenario_score"
          }
        }
      }
    },
    "scenario_score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "information_gain_bits",
        "information_gain_bits_per_cost"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "information_gain_bits": {
          "type": "number",
          "minimum": 0
        },
        "information_gain_bits_per_cost": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
