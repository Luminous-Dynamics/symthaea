{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:symthaea:nano-policy-input:v1",
  "title": "Nanophotonic candidate-selection request",
  "description": "Pre-query input contract for the standalone Rust nano-policy prototype. Runtime validation additionally checks vector dimensions, candidate uniqueness, policy-specific required fields, and that hybrid weights sum to one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "policy_revision",
    "candidate_pool_sha256",
    "policy",
    "seed",
    "batch_size",
    "feature_space",
    "weights",
    "estimate_provenance",
    "anchors",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "nano-policy-input-v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1
    },
    "candidate_pool_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy": {
      "enum": [
        "random",
        "goal_only",
        "uncertainty_only",
        "diversity_only",
        "hybrid",
        "balanced_extremes"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1
    },
    "feature_space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "semantics",
        "normalized_to_minus_one_one",
        "transform_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "semantics": {
          "type": "string",
          "minLength": 1
        },
        "normalized_to_minus_one_one": {
          "const": true
        },
        "transform_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_fit",
        "uncertainty",
        "cost_efficiency",
        "diversity"
      ],
      "properties": {
        "goal_fit": {
          "type": "number",
          "minimum": 0
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "cost_efficiency": {
          "type": "number",
          "minimum": 0
        },
        "diversity": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "estimate_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicted_goal_error_model_id",
        "predicted_goal_error_model_sha256",
        "uncertainty_method_id",
        "uncertainty_method_sha256",
        "estimated_cost_model_id",
        "estimated_cost_model_sha256"
      ],
      "properties": {
        "predicted_goal_error_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "predicted_goal_error_model_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "uncertainty_method_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty_method_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "estimated_cost_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "estimated_cost_model_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "features",
          "predicted_goal_error",
          "uncertainty",
          "estimated_cost",
          "eligible",
          "already_queried"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          },
          "predicted_goal_error": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "uncertainty": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "estimated_cost": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "eligible": {
            "type": "boolean"
          },
          "already_queried": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
