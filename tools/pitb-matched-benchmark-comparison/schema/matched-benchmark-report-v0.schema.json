{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb/matched-benchmark-report-v0.schema.json",
  "title": "PITB matched benchmark comparison report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "snapshot_id",
    "split_id",
    "split_role",
    "cluster_unit",
    "split_manifest_sha256",
    "expected_task_count",
    "expected_cluster_count",
    "task_id_set_sha256",
    "results_jsonl_sha256",
    "observed_task_count",
    "observed_cluster_count",
    "arm_count",
    "budget_policy_sha256",
    "source_reproduction_required",
    "specification_audit_required",
    "vacuity_audit_required",
    "assumption_audit_required",
    "arm_metrics",
    "pairwise_comparisons",
    "missing_receipt_count",
    "scheduler_admission",
    "primary_metric",
    "statistical_interpretation_boundary",
    "receipt_authentication_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.matched-benchmark-report.v0"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "split_id": {
      "type": "string",
      "minLength": 1
    },
    "split_role": {
      "const": "test"
    },
    "split_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expected_task_count": {
      "type": "integer",
      "minimum": 1
    },
    "expected_cluster_count": {
      "type": "integer",
      "minimum": 1
    },
    "task_id_set_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "results_jsonl_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_task_count": {
      "type": "integer",
      "minimum": 1
    },
    "observed_cluster_count": {
      "type": "integer",
      "minimum": 1
    },
    "arm_count": {
      "type": "integer",
      "minimum": 2
    },
    "budget_policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_reproduction_required": {
      "type": "boolean"
    },
    "specification_audit_required": {
      "type": "boolean"
    },
    "vacuity_audit_required": {
      "type": "boolean"
    },
    "assumption_audit_required": {
      "type": "boolean"
    },
    "arm_metrics": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "arm_id",
          "model_id",
          "model_version",
          "task_count",
          "attempted_task_count",
          "did_not_compete_count",
          "raw_kernel_verified_successes",
          "source_reproduced_successes",
          "assurance_qualified_successes",
          "assurance_disqualified_successes",
          "assurance_unreviewed_successes",
          "raw_kernel_success_rate",
          "source_reproduced_success_rate",
          "assurance_qualified_success_rate",
          "attempt_coverage",
          "total_attempts",
          "total_wall_ms",
          "total_cost_microusd",
          "total_tokens",
          "cost_per_raw_kernel_success_microusd",
          "cost_per_source_reproduced_success_microusd",
          "cost_per_assurance_qualified_success_microusd",
          "median_cost_per_task_microusd",
          "p95_cost_per_task_microusd"
        ],
        "properties": {
          "arm_id": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "task_count": {
            "type": "integer",
            "minimum": 1
          },
          "attempted_task_count": {
            "type": "integer",
            "minimum": 0
          },
          "did_not_compete_count": {
            "type": "integer",
            "minimum": 0
          },
          "raw_kernel_verified_successes": {
            "type": "integer",
            "minimum": 0
          },
          "source_reproduced_successes": {
            "type": "integer",
            "minimum": 0
          },
          "assurance_qualified_successes": {
            "type": "integer",
            "minimum": 0
          },
          "assurance_disqualified_successes": {
            "type": "integer",
            "minimum": 0
          },
          "assurance_unreviewed_successes": {
            "type": "integer",
            "minimum": 0
          },
          "raw_kernel_success_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source_reproduced_success_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "assurance_qualified_success_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "attempt_coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "total_attempts": {
            "type": "integer",
            "minimum": 0
          },
          "total_wall_ms": {
            "type": "integer",
            "minimum": 0
          },
          "total_cost_microusd": {
            "type": "integer",
            "minimum": 0
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "cost_per_raw_kernel_success_microusd": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          },
          "cost_per_source_reproduced_success_microusd": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          },
          "cost_per_assurance_qualified_success_microusd": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          },
          "median_cost_per_task_microusd": {
            "type": "number",
            "minimum": 0
          },
          "p95_cost_per_task_microusd": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "pairwise_comparisons": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_arm_id",
          "challenger_arm_id",
          "paired_task_count",
          "repository_cluster_count",
          "reference_assurance_qualified_successes",
          "challenger_assurance_qualified_successes",
          "challenger_wins",
          "reference_wins",
          "ties",
          "paired_assurance_success_difference",
          "cluster_bootstrap_95_percentile_lower",
          "cluster_bootstrap_95_percentile_upper",
          "bootstrap_replicates",
          "bootstrap_seed_sha256",
          "interpretation_boundary"
        ],
        "properties": {
          "reference_arm_id": {
            "type": "string",
            "minLength": 1
          },
          "challenger_arm_id": {
            "type": "string",
            "minLength": 1
          },
          "paired_task_count": {
            "type": "integer",
            "minimum": 1
          },
          "repository_cluster_count": {
            "type": "integer",
            "minimum": 1
          },
          "reference_assurance_qualified_successes": {
            "type": "integer",
            "minimum": 0
          },
          "challenger_assurance_qualified_successes": {
            "type": "integer",
            "minimum": 0
          },
          "challenger_wins": {
            "type": "integer",
            "minimum": 0
          },
          "reference_wins": {
            "type": "integer",
            "minimum": 0
          },
          "ties": {
            "type": "integer",
            "minimum": 0
          },
          "paired_assurance_success_difference": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "cluster_bootstrap_95_percentile_lower": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "cluster_bootstrap_95_percentile_upper": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "bootstrap_replicates": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 100000
          },
          "bootstrap_seed_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "interpretation_boundary": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "missing_receipt_count": {
      "const": 0
    },
    "scheduler_admission": {
      "const": false
    },
    "primary_metric": {
      "type": "string",
      "minLength": 20
    },
    "statistical_interpretation_boundary": {
      "type": "string",
      "minLength": 40
    },
    "receipt_authentication_boundary": {
      "type": "string",
      "minLength": 40
    },
    "cluster_unit": {
      "enum": [
        "repository",
        "repository_file"
      ]
    }
  }
}
