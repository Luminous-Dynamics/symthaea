{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/textile-data-intake/v0.1/manifest.json",
  "title": "Textile dataset intake manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "source",
    "rights",
    "files",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "textile-data-intake-v0.1"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "landing_page",
        "doi",
        "version",
        "retrieved_at_utc"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "landing_page": {
          "type": "string",
          "format": "uri"
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at_utc": {
          "type": "string"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "license_url",
        "license_text_local_path",
        "license_text_sha256",
        "reviewed_by",
        "reviewed_at_utc",
        "permitted_uses",
        "attribution",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "reviewed",
            "rejected"
          ]
        },
        "license_url": {
          "type": "string",
          "format": "uri"
        },
        "license_text_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "permitted_uses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "license_text_local_path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_path",
          "local_path",
          "sha256",
          "size_bytes",
          "role"
        ],
        "properties": {
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "local_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
