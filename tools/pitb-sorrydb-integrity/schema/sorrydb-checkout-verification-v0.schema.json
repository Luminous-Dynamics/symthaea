{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb/sorrydb-checkout-verification-v0.schema.json",
  "title": "PITB SorryDB checkout verification v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "checked_out_commit",
    "checked_out_remote",
    "lean_toolchain_file",
    "normalized_lean_version",
    "source_file_sha256",
    "source_span",
    "source_span_verified_as_sorry",
    "scoring_admission",
    "limitation"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.sorrydb-checkout-verification.v0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checked_out_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "checked_out_remote": {
      "type": "string",
      "minLength": 1
    },
    "lean_toolchain_file": {
      "type": "string",
      "minLength": 1
    },
    "normalized_lean_version": {
      "type": "string",
      "minLength": 1
    },
    "source_file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_span": {
      "const": "sorry"
    },
    "source_span_verified_as_sorry": {
      "const": true
    },
    "scoring_admission": {
      "const": false
    },
    "limitation": {
      "type": "string",
      "minLength": 1
    }
  }
}
