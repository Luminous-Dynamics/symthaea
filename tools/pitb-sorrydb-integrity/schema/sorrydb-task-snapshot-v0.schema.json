{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb/sorrydb-task-snapshot-v0.schema.json",
  "title": "PITB SorryDB immutable task snapshot record v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "repo",
    "location",
    "debug_info",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote",
        "branch",
        "commit",
        "lean_version"
      ],
      "properties": {
        "remote": {
          "type": "string",
          "format": "uri"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "lean_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start_line",
        "start_column",
        "end_line",
        "end_column"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "start_column": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "debug_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "url"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blame_email_hash",
        "blame_date",
        "inclusion_date"
      ],
      "properties": {
        "blame_email_hash": {
          "type": "string",
          "minLength": 1
        },
        "blame_date": {
          "type": "string",
          "minLength": 1
        },
        "inclusion_date": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_file_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    }
  }
}
