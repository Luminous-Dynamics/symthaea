{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb/sorrydb-task-identity-v0.schema.json",
  "title": "PITB SorryDB task identity v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "source_database_id",
    "repository_remote",
    "repository_branch",
    "repository_commit",
    "lean_version",
    "source_path",
    "start_line",
    "start_column",
    "end_line",
    "end_column",
    "debug_goal_sha256",
    "debug_url",
    "source_goal_trust",
    "prop_parent_type_trust"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.sorrydb-task-identity.v0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_database_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "repository_remote": {
      "type": "string",
      "pattern": "^(https://github\\.com/|git@github\\.com:)"
    },
    "repository_branch": {
      "type": "string",
      "minLength": 1
    },
    "repository_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "lean_version": {
      "type": "string",
      "minLength": 2
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "start_line": {
      "type": "integer",
      "minimum": 1
    },
    "start_column": {
      "type": "integer",
      "minimum": 0
    },
    "end_line": {
      "type": "integer",
      "minimum": 1
    },
    "end_column": {
      "type": "integer",
      "minimum": 0
    },
    "debug_goal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "debug_url": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "source_goal_trust": {
      "const": "debug_hint_not_reproduced"
    },
    "prop_parent_type_trust": {
      "const": "database_inclusion_claim_not_independently_rechecked"
    }
  }
}
