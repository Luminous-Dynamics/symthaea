{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mel-judge-grounding-probe-panel-v1.schema.json",
  "title": "MEL Judge Grounding Probe Panel v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "frozen_at_utc",
    "judge",
    "policy",
    "cases",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "mel-judge-grounding-probe-panel-v1"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "frozen_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "judge": {
      "$ref": "#/$defs/judge"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "judge_id",
        "judge_version",
        "adapter_sha256",
        "protocol_sha256",
        "rubric_sha256"
      ],
      "properties": {
        "judge_id": {
          "type": "string",
          "minLength": 1
        },
        "judge_version": {
          "type": "string",
          "minLength": 1
        },
        "adapter_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "protocol_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rubric_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_baseline_margin",
        "maximum_prompt_only_margin_ratio"
      ],
      "properties": {
        "minimum_baseline_margin": {
          "type": "number",
          "minimum": 0
        },
        "maximum_prompt_only_margin_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "candidate_a_id",
        "candidate_b_id",
        "candidate_a_audio_sha256",
        "candidate_b_audio_sha256",
        "human_reference_winner",
        "human_reference_directional",
        "baseline",
        "probes"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_a_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_b_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_a_audio_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_b_audio_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "human_reference_winner": {
          "enum": [
            "a",
            "b",
            "tie",
            "abstain"
          ]
        },
        "human_reference_directional": {
          "type": "boolean"
        },
        "baseline": {
          "$ref": "#/$defs/outcome"
        },
        "probes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/probe"
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score_a",
        "score_b",
        "prompt_sha256",
        "instruction_sha256",
        "audio_a_sha256",
        "audio_b_sha256"
      ],
      "properties": {
        "score_a": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "score_b": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "instruction_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "audio_a_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "audio_b_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "kind",
        "score_a",
        "score_b",
        "prompt_sha256",
        "instruction_sha256",
        "audio_a_sha256",
        "audio_b_sha256",
        "expected_candidate",
        "maximum_margin_shift",
        "minimum_score_drop",
        "maximum_score_drift"
      ],
      "properties": {
        "probe_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "prompt_only",
            "audio_swap",
            "instruction_paraphrase",
            "nuisance_transform",
            "semantic_mismatch"
          ]
        },
        "score_a": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "score_b": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "instruction_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "audio_a_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "audio_b_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_candidate": {
          "oneOf": [
            {
              "enum": [
                "a",
                "b"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "maximum_margin_shift": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "minimum_score_drop": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "maximum_score_drift": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
