{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fly-bench.com/schema/result.v1.json",
  "title": "flybench result report",
  "type": "object",
  "required": ["schema", "label", "connectome", "params", "simulator", "tasks", "score", "passed", "n_tasks"],
  "properties": {
    "schema": { "const": 1 },
    "flybench_version": { "type": "string" },
    "label": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[A-Za-z0-9 ._,()+/-]+$" },
    "connectome": { "type": "string", "minLength": 1 },
    "connectome_meta": { "type": "object" },
    "simulator": { "type": "string" },
    "seeds": { "type": "integer", "minimum": 1, "maximum": 50 },
    "verified": { "type": "boolean" },
    "reference_baseline": { "type": "boolean" },
    "model_card": { "type": ["object", "null"] },
    "conflict_of_interest": { "type": "string", "maxLength": 300 },
    "tier": { "type": "array", "items": { "enum": ["core", "hard"] } },
    "params": {
      "type": "object",
      "required": ["gain", "w_syn_mv", "dt_ms"],
      "properties": {
        "gain": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "w_syn_mv": { "type": "number", "exclusiveMinimum": 0 },
        "dt_ms": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "core_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "hard_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "passed": { "type": "integer", "minimum": 0 },
    "n_tasks": { "type": "integer", "minimum": 1 },
    "tasks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task", "passed", "score", "checks", "measurements"],
        "properties": {
          "task": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "passed": { "type": "boolean" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "checks": { "type": "array", "items": { "type": "object", "required": ["description", "value", "passed"] } },
          "measurements": { "type": "object" },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
