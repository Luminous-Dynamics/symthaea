{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb/grouped-benchmark-splits-v0.schema.json",
  "title": "PITB deterministic repository-disjoint benchmark folds v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm_id",
    "source_dataset_sha256",
    "source_dataset_git_blob_sha1",
    "seed",
    "fold_count",
    "task_count",
    "repository_count",
    "repository_commit_pair_count",
    "repository_file_cluster_count",
    "min_tasks_per_fold",
    "max_tasks_per_fold",
    "max_repository_group_size",
    "repository_disjoint",
    "every_task_assigned_once",
    "assignments",
    "folds",
    "interpretation_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.grouped-benchmark-splits.v0"
    },
    "algorithm_id": {
      "const": "lpt-repository-groups-sha256-tiebreak-v1"
    },
    "source_dataset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_dataset_git_blob_sha1": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      ]
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "fold_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 20
    },
    "task_count": {
      "type": "integer",
      "minimum": 1
    },
    "repository_count": {
      "type": "integer",
      "minimum": 2
    },
    "repository_commit_pair_count": {
      "type": "integer",
      "minimum": 1
    },
    "repository_file_cluster_count": {
      "type": "integer",
      "minimum": 1
    },
    "min_tasks_per_fold": {
      "type": "integer",
      "minimum": 1
    },
    "max_tasks_per_fold": {
      "type": "integer",
      "minimum": 1
    },
    "max_repository_group_size": {
      "type": "integer",
      "minimum": 1
    },
    "repository_disjoint": {
      "const": true
    },
    "every_task_assigned_once": {
      "const": true
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "repository_key",
          "fold_id"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "repository_key": {
            "type": "string",
            "minLength": 1
          },
          "fold_id": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "folds": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fold_id",
          "task_count",
          "repository_count",
          "repository_commit_pair_count",
          "repository_file_cluster_count",
          "repository_keys",
          "task_ids"
        ],
        "properties": {
          "fold_id": {
            "type": "integer",
            "minimum": 0
          },
          "task_count": {
            "type": "integer",
            "minimum": 1
          },
          "repository_count": {
            "type": "integer",
            "minimum": 1
          },
          "repository_commit_pair_count": {
            "type": "integer",
            "minimum": 1
          },
          "repository_file_cluster_count": {
            "type": "integer",
            "minimum": 1
          },
          "repository_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "interpretation_boundary": {
      "type": "string",
      "minLength": 30
    }
  }
}
