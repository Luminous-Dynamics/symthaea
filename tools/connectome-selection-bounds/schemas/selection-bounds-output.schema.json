{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/connectome-selection-bounds-output-v1.schema.json",
  "title":"Connectome selection bounds report",
  "type":"object","additionalProperties":false,
  "required":["report_version","protocol_id","estimand_id","selection_rule_id","all_event_outcome_definition","conditional_kernel_definition","arms","all_event_arm_contrast","claim_boundary"],
  "properties":{
    "report_version":{"const":"connectome-selection-bounds-v1"},
    "protocol_id":{"type":"string","minLength":1},
    "estimand_id":{"type":"string","minLength":1},
    "selection_rule_id":{"type":"string","minLength":1},
    "all_event_outcome_definition":{"type":"string","minLength":1},
    "conditional_kernel_definition":{"type":"string","minLength":1},
    "arms":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/armReport"}},
    "all_event_arm_contrast":{"$ref":"#/$defs/contrast"},
    "claim_boundary":{
      "type":"object","additionalProperties":false,
      "required":["causal_identification_verified","sampling_uncertainty_included","detector_error_corrected","conditional_kernel_transport_claimed"],
      "properties":{
        "causal_identification_verified":{"const":false},
        "sampling_uncertainty_included":{"const":false},
        "detector_error_corrected":{"const":false},
        "conditional_kernel_transport_claimed":{"const":false}
      }
    }
  },
  "$defs":{
    "interval":{
      "type":"object","additionalProperties":false,"required":["lower","upper"],
      "properties":{"lower":{"type":"number"},"upper":{"type":"number"}}
    },
    "meanBounds":{
      "type":"object","additionalProperties":false,
      "required":["target_units","observed_units","missing_units","observed_mean","bounds","status"],
      "properties":{
        "target_units":{"type":"integer","minimum":0},
        "observed_units":{"type":"integer","minimum":0},
        "missing_units":{"type":"integer","minimum":0},
        "observed_mean":{"type":["number","null"]},
        "bounds":{"oneOf":[{"$ref":"#/$defs/interval"},{"type":"null"}]},
        "status":{"enum":["PointIdentifiedForFiniteCohort","PartiallyIdentified","NoObservedMeasurements","NotEstimable"]}
      }
    },
    "selectionSummary":{
      "type":"object","additionalProperties":false,
      "required":["planned_units","selected_units","not_selected_units","unobserved_units","classifier_invalid_units","registration_failed_units","selection_rate_among_evaluable","selected_fraction_of_planned","selection_evaluable_units","selection_unknown_units"],
      "properties":{
        "planned_units":{"type":"integer","minimum":1},
        "selected_units":{"type":"integer","minimum":0},
        "not_selected_units":{"type":"integer","minimum":0},
        "unobserved_units":{"type":"integer","minimum":0},
        "classifier_invalid_units":{"type":"integer","minimum":0},
        "registration_failed_units":{"type":"integer","minimum":0},
        "selection_rate_among_evaluable":{"type":["number","null"]},
        "selected_fraction_of_planned":{"type":"number","minimum":0,"maximum":1},
        "selection_evaluable_units":{"type":"integer","minimum":0},
        "selection_unknown_units":{"type":"integer","minimum":0}
      }
    },
    "armReport":{
      "type":"object","additionalProperties":false,
      "required":["arm_id","role","selection","all_event_outcome","conditional_kernel_among_selected"],
      "properties":{
        "arm_id":{"type":"string","minLength":1},
        "role":{"enum":["Treatment","Control"]},
        "selection":{"$ref":"#/$defs/selectionSummary"},
        "all_event_outcome":{"$ref":"#/$defs/meanBounds"},
        "conditional_kernel_among_selected":{"$ref":"#/$defs/meanBounds"}
      }
    },
    "contrast":{
      "type":"object","additionalProperties":false,"required":["bounds","classification"],
      "properties":{
        "bounds":{"$ref":"#/$defs/interval"},
        "classification":{"enum":["PositiveOnly","NegativeOnly","IncludesZero"]}
      }
    }
  }
}
