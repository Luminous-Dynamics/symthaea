{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/connectome-selection-bounds-input-v1.schema.json",
  "title": "Connectome selection bounds input",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_id","estimand_id","selection_rule_id","all_event_outcome_definition","conditional_kernel_definition","all_event_outcome_bounds","conditional_kernel_bounds","arms"],
  "properties": {
    "protocol_id": {"type":"string","minLength":1},
    "estimand_id": {"type":"string","minLength":1},
    "selection_rule_id": {"type":"string","minLength":1},
    "all_event_outcome_definition": {"type":"string","minLength":1},
    "conditional_kernel_definition": {"type":"string","minLength":1},
    "all_event_outcome_bounds": {"$ref":"#/$defs/valueBounds"},
    "conditional_kernel_bounds": {"$ref":"#/$defs/valueBounds"},
    "arms": {"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/arm"}}
  },
  "$defs": {
    "valueBounds": {
      "type":"object","additionalProperties":false,"required":["lower","upper"],
      "properties":{"lower":{"type":"number"},"upper":{"type":"number"}}
    },
    "arm": {
      "type":"object","additionalProperties":false,"required":["arm_id","role","units"],
      "properties":{
        "arm_id":{"type":"string","minLength":1},
        "role":{"enum":["treatment","control"]},
        "units":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/unit"}}
      }
    },
    "unit": {
      "type":"object","additionalProperties":false,"required":["unit_id","selection_status","all_event_outcome","conditional_kernel"],
      "properties":{
        "unit_id":{"type":"string","minLength":1},
        "selection_status":{"enum":["selected","not_selected","unobserved","classifier_invalid","registration_failed"]},
        "all_event_outcome":{"type":["number","null"]},
        "conditional_kernel":{"type":["number","null"]}
      }
    }
  }
}
