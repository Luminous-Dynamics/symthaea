              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "delivered_copies": {
                "type": "integer",
                "minimum": 1
              },
              "content_conflict": {
                "type": "boolean"
              }
            }
          },
          "authorization_state": {
            "enum": [
              "valid",
              "missing",
              "expired",
              "revoked",
              "scope_mismatch"
            ]
          },
          "as_found": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "present",
