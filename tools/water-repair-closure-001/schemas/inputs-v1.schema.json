        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^WR-[0-9]{2}$"
          },
          "profile": {
            "enum": [
              "non_potable_module",
              "municipal_distribution",
              "building_plumbing"
            ]
          },
          "profile_requirements_reviewed": {
            "type": "boolean"
          },
          "asset_id": {
