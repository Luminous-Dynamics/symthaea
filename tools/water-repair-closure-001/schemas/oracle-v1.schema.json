{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Water Repair Closure oracle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "independence_note",
    "qualification_status",
    "claim_ceiling",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "water-repair-closure-001-oracle-v1"
    },
    "independence_note": {
      "type": "string",
      "minLength": 1
    },
    "qualification_status": {
      "const": "NotRun"
    },
    "claim_ceiling": {
      "const": "SyntheticFieldRepairLifecycleOnly"
    },
    "results": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "disposition",
          "reason_codes",
          "semantic_effect_count",
          "duplicate_delivery_idempotent"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^WR-[0-9]{2}$"
          },
          "disposition": {
            "enum": [
              "Blocked",
              "Incomplete",
              "Indeterminate",
              "ReadyForReview",
              "VerifiedWithinProfile",
              "Rejected"
            ]
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "semantic_effect_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "duplicate_delivery_idempotent": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
