{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb/support-antichain-prediction-v0.schema.json",
  "title": "PITB support antichain prediction v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "group_id",
    "model_id",
    "model_version",
    "abstained",
    "claimed_necessary_declarations",
    "proposed_sufficient_route",
    "route_sufficiency_probability",
    "run_receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.support-antichain-prediction.v0"
    },
    "group_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "abstained": {
      "type": "boolean"
    },
    "claimed_necessary_declarations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposed_sufficient_route": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "route_sufficiency_probability": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ]
    },
    "run_receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
