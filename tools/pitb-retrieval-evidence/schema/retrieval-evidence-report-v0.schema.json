{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pitb/retrieval-evidence-report-v0.schema.json",
  "title": "PITB retrieval evidence report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_manifest_sha256",
    "graph_snapshot_id",
    "graph_node_count",
    "receipt_jsonl_sha256",
    "receipt_count",
    "run_summaries",
    "scheduler_admission",
    "score_interpretation",
    "trust_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "pitb.retrieval-evidence-report.v0"
    },
    "graph_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "graph_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "graph_node_count": {
      "type": "integer",
      "minimum": 1
    },
    "receipt_jsonl_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt_count": {
      "type": "integer",
      "minimum": 1
    },
    "run_summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_id",
          "retriever_kind",
          "candidate_count",
          "requested_top_k",
          "returned_candidates",
          "score_metric",
          "graph_manifest_sha256",
          "query_wall_ms",
          "retrieval_cpu_ms",
          "retrieval_gpu_ms",
          "tokens",
          "cost_microusd",
          "receipt_sha256"
        ],
        "properties": {
          "query_id": {
            "type": "string",
            "minLength": 1
          },
          "retriever_kind": {
            "enum": [
              "daps_selector",
              "leangraphsearch",
              "leansearch_v2",
              "theoremgraph",
              "bm25",
              "pitb_union",
              "other"
            ]
          },
          "candidate_count": {
            "type": "integer",
            "minimum": 1
          },
          "requested_top_k": {
            "type": "integer",
            "minimum": 1
          },
          "returned_candidates": {
            "type": "integer",
            "minimum": 0
          },
          "score_metric": {
            "enum": [
              "cosine_similarity",
              "dot_product",
              "logit",
              "distance",
              "rank_only"
            ]
          },
          "graph_manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "query_wall_ms": {
            "type": "integer",
            "minimum": 0
          },
          "retrieval_cpu_ms": {
            "type": "integer",
            "minimum": 0
          },
          "retrieval_gpu_ms": {
            "type": "integer",
            "minimum": 0
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          },
          "cost_microusd": {
            "type": "integer",
            "minimum": 0
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "scheduler_admission": {
      "const": false
    },
    "score_interpretation": {
      "type": "string",
      "minLength": 20
    },
    "trust_boundary": {
      "type": "string",
      "minLength": 20
    }
  }
}
