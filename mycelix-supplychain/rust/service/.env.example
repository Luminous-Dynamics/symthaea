# Mycelix Supply Chain Provenance Service Configuration
#
# Copy this file to .env and customize for your environment
# All settings have sensible defaults - only override what you need

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Address and port to bind to
# Default: 0.0.0.0:8080
# BIND_ADDRESS=0.0.0.0:8080

# Maximum request body size in bytes
# Default: 2097152 (2MB)
# Production: Consider 5242880 (5MB) for larger batches
# MAX_BODY_SIZE=2097152

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database connection URL
# Default: sqlite://data/claims.db
# Production: Use PostgreSQL for better performance and reliability
# DATABASE_URL=sqlite://data/claims.db
# DATABASE_URL=postgresql://user:password@localhost/mycelix

# Maximum number of database connections in pool
# Default: 10
# Production: Consider 20-50 depending on load
# DB_MAX_CONNECTIONS=10

# Database connection timeout in seconds
# Default: 30
# DB_CONNECT_TIMEOUT=30

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Allowed CORS origins (comma-separated)
# Default: http://localhost:3000,http://localhost:8080
# Production: Set to your actual frontend URLs
# ALLOWED_ORIGINS=https://app.example.com,https://dashboard.example.com

# Enable permissive CORS (allow all origins)
# Default: false
# WARNING: Only use for development! NEVER in production!
# PERMISSIVE_CORS=false

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

# Requests per second allowed
# Default: 100
# Production: Adjust based on expected load
# RATE_LIMIT_RPS=100

# Burst size (allows temporary traffic spikes)
# Default: 20
# Production: Set to 20-50% of RPS
# RATE_LIMIT_BURST=20

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Log level: trace, debug, info, warn, error
# Default: info
# Development: debug or trace
# Production: info or warn
# RUST_LOG=info
# LOG_LEVEL=info

# Enable JSON-formatted logs (better for log aggregation)
# Default: false
# Production: true (for structured logging in Elasticsearch, etc.)
# JSON_LOGS=false

# Enable request tracing middleware
# Default: true
# REQUEST_TRACING=true

# ============================================================================
# ENVIRONMENT IDENTIFICATION
# ============================================================================

# Current environment (for warnings and feature flags)
# Values: development, staging, production
# RUST_ENV=development

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
#
# Before deploying to production:
#
# 1. Database:
#    - Set DATABASE_URL to PostgreSQL (not SQLite)
#    - Configure connection pooling (DB_MAX_CONNECTIONS)
#    - Enable connection timeouts
#
# 2. Security:
#    - Set specific ALLOWED_ORIGINS (no wildcards)
#    - Ensure PERMISSIVE_CORS=false
#    - Review rate limiting settings
#
# 3. Observability:
#    - Set RUST_LOG=info or RUST_LOG=warn
#    - Enable JSON_LOGS=true for log aggregation
#    - Configure external monitoring
#
# 4. Performance:
#    - Tune MAX_BODY_SIZE based on batch sizes
#    - Adjust RATE_LIMIT_RPS based on load testing
#    - Set DB_MAX_CONNECTIONS based on traffic
#
# 5. Infrastructure:
#    - Configure Kubernetes readiness/liveness probes:
#      - Liveness: /health/live
#      - Readiness: /health/ready
#    - Set up graceful shutdown (SIGTERM handling)
#    - Configure appropriate resource limits
#
# ============================================================================
# EXAMPLE CONFIGURATIONS
# ============================================================================

# Example: Development Environment
# ----------------------------------
# DATABASE_URL=sqlite://data/claims.db
# RUST_LOG=debug
# JSON_LOGS=false
# PERMISSIVE_CORS=true
# RATE_LIMIT_RPS=1000

# Example: Production Environment
# ----------------------------------
# DATABASE_URL=postgresql://mycelix:secure_password@db.example.com/provenance
# RUST_LOG=info
# JSON_LOGS=true
# ALLOWED_ORIGINS=https://app.example.com,https://dashboard.example.com
# PERMISSIVE_CORS=false
# RATE_LIMIT_RPS=100
# RATE_LIMIT_BURST=20
# DB_MAX_CONNECTIONS=20
# MAX_BODY_SIZE=5242880
# RUST_ENV=production
