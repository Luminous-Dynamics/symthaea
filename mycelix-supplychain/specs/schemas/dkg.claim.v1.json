{
  "$id": "https://mycelix.org/schemas/dkg.claim.v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DKG Epistemic Claim",
  "description": "Schema for supply chain claims published to Mycelix DKG",
  "type": "object",
  "required": ["id", "type", "issuer", "subject", "assertion", "evidence", "lineage", "timestamp"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique claim identifier (hash or UUID)"
    },
    "type": {
      "type": "string",
      "const": "SupplyChainClaim",
      "description": "Claim type"
    },
    "issuer": {
      "type": "string",
      "pattern": "^did:",
      "description": "DID of the claiming entity"
    },
    "subject": {
      "type": "object",
      "required": ["batchId", "productId"],
      "properties": {
        "batchId": {
          "type": "string",
          "description": "Batch identifier"
        },
        "productId": {
          "type": "string",
          "description": "Product SKU or ID"
        }
      }
    },
    "assertion": {
      "type": "object",
      "required": ["eventType"],
      "properties": {
        "eventType": {
          "type": "string",
          "enum": ["PRODUCED", "TRANSFORMED", "SHIPPED", "RECEIVED", "CERTIFIED"]
        },
        "quantity": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "facilityId": {
          "type": "string"
        }
      },
      "description": "The assertion being made"
    },
    "evidence": {
      "type": "object",
      "required": ["vcJwt"],
      "properties": {
        "vcJwt": {
          "type": "string",
          "description": "The signed Verifiable Credential JWT"
        },
        "additionalDocuments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "hash": {
                "type": "string"
              }
            }
          }
        }
      },
      "description": "Evidence supporting the claim"
    },
    "lineage": {
      "type": "object",
      "required": ["hash"],
      "properties": {
        "hash": {
          "type": "string",
          "description": "Merkle hash linking to previous claims"
        },
        "previousClaims": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of parent claim IDs"
        }
      },
      "description": "Lineage tracking"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the claim was created"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score (0-1) for epistemic reasoning"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Additional metadata"
    }
  }
}
