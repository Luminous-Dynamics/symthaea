{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/conformal-policy-control/policy-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "scenario_id",
    "risk_budget_ppm",
    "cvar_alpha_ppm",
    "worst_case_loss_ppm",
    "action_support",
    "safe_reference_policy",
    "optimized_candidate_policy",
    "calibration_mixture_policy",
    "beta_grid",
    "calibration_samples",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.risk_qualified_policy_benchmark.v0.1"
    },
    "version": {
      "const": "0.1.0"
    },
    "status": {
      "const": "synthetic_finite_support_reference_not_a_formal_guarantee"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "risk_budget_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "cvar_alpha_ppm": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "worst_case_loss_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "action_support": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "name",
          "reward_milli",
          "loss_ppm"
        ],
        "properties": {
          "action_id": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reward_milli": {
            "type": "integer"
          },
          "loss_ppm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        }
      }
    },
    "safe_reference_policy": {
      "$ref": "#/$defs/policy"
    },
    "optimized_candidate_policy": {
      "$ref": "#/$defs/policy"
    },
    "calibration_mixture_policy": {
      "$ref": "#/$defs/policy"
    },
    "beta_grid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "numerator",
          "denominator"
        ],
        "properties": {
          "numerator": {
            "type": "integer",
            "minimum": 1
          },
          "denominator": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "calibration_samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "loss_ppm"
        ],
        "properties": {
          "action_id": {
            "type": "integer",
            "minimum": 0
          },
          "loss_ppm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_ids",
        "masses"
      ],
      "properties": {
        "action_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "masses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
