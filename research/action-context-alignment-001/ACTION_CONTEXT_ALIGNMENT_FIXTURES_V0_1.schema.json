{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/action-context-alignment-001/ACTION_CONTEXT_ALIGNMENT_FIXTURES_V0_1.schema.json",
  "title": "ACTION-CONTEXT-ALIGNMENT-001 fixtures v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "status",
    "fixture_count",
    "pair_count",
    "mutation_dimensions",
    "fixtures",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "action-context-alignment-fixtures-v0.1"
    },
    "benchmark_id": {
      "const": "ACTION-CONTEXT-ALIGNMENT-001"
    },
    "status": {
      "const": "synthetic_pair_design_unexecuted"
    },
    "fixture_count": {
      "const": 42
    },
    "pair_count": {
      "const": 21
    },
    "mutation_dimensions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "principal_binding",
          "local_recognition",
          "target_allowlist",
          "purpose_binding",
          "expiry",
          "delegation_scope",
          "pre_state"
        ]
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "pair_id",
          "pair_member",
          "mutation_dimension",
          "environment",
          "task",
          "authority_context",
          "expected_disposition",
          "claim_ceiling"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "minLength": 1
          },
          "pair_id": {
            "type": "string",
            "minLength": 1
          },
          "pair_member": {
            "enum": [
              "authorized_control",
              "single_delta_denial"
            ]
          },
          "mutation_dimension": {
            "enum": [
              "principal_binding",
              "local_recognition",
              "target_allowlist",
              "purpose_binding",
              "expiry",
              "delegation_scope",
              "pre_state"
            ]
          },
          "environment": {
            "const": "synthetic_offline"
          },
          "task": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_ref",
              "principal_ref",
              "actor_ref",
              "on_behalf_of_ref",
              "operation",
              "target_ref",
              "purpose_ref",
              "required_scope",
              "payload_sha256",
              "pre_state_sha256",
              "evaluated_at_unix"
            ],
            "properties": {
              "task_ref": {
                "type": "string",
                "minLength": 1
              },
              "principal_ref": {
                "type": "string",
                "minLength": 1
              },
              "actor_ref": {
                "type": "string",
                "minLength": 1
              },
              "on_behalf_of_ref": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "minLength": 1
              },
              "target_ref": {
                "type": "string",
                "minLength": 1
              },
              "purpose_ref": {
                "type": "string",
                "minLength": 1
              },
              "required_scope": {
                "type": "string",
                "minLength": 1
              },
              "payload_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "pre_state_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evaluated_at_unix": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "authority_context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "principal_binding",
              "local_recognition",
              "target_allowlist",
              "purpose_binding",
              "expires_at_unix",
              "delegated_scope",
              "pre_state_sha256"
            ],
            "properties": {
              "principal_binding": {
                "enum": [
                  "Exact",
                  "Mismatch"
                ]
              },
              "local_recognition": {
                "type": "boolean"
              },
              "target_allowlist": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "purpose_binding": {
                "enum": [
                  "Exact",
                  "Different"
                ]
              },
              "expires_at_unix": {
                "type": "integer",
                "minimum": 1
              },
              "delegated_scope": {
                "type": "string",
                "minLength": 1
              },
              "pre_state_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "expected_disposition": {
            "enum": [
              "EligibleForTestAdapter",
              "IneligibleNoAdapterCall"
            ]
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
