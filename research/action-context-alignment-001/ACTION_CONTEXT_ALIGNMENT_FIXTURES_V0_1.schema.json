{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/action-context-alignment-001/ACTION_CONTEXT_ALIGNMENT_FIXTURES_V0_1.schema.json",
  "title": "ACTION-CONTEXT-ALIGNMENT-001 fixtures v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "status",
    "fixture_count",
    "pair_count",
    "mutation_dimensions",
    "fixtures",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "action-context-alignment-fixtures-v0.5"
    },
    "benchmark_id": {
      "const": "ACTION-CONTEXT-ALIGNMENT-001"
    },
    "status": {
      "const": "synthetic_explicit_identity_payload_binding_and_post_approval_substitution_design_unexecuted"
    },
    "fixture_count": {
      "const": 68
    },
    "pair_count": {
      "const": 34
    },
    "mutation_dimensions": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "principal_binding",
          "actor_binding",
          "on_behalf_of_binding",
          "local_recognition",
          "target_allowlist",
          "purpose_binding",
          "expiry",
          "delegation_scope",
          "pre_state",
          "payload_binding",
          "runtime_trigger"
        ]
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 68,
      "maxItems": 68,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "pair_id",
          "pair_member",
          "mutation_dimension",
          "environment",
          "task",
          "authority_context",
          "expected_disposition",
          "claim_ceiling",
          "runtime_context",
          "oracle_annotations"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "minLength": 1
          },
          "pair_id": {
            "type": "string",
            "minLength": 1
          },
          "pair_member": {
            "enum": [
              "authorized_control",
              "single_delta_denial",
              "continue_control",
              "runtime_trigger_stop"
            ]
          },
          "mutation_dimension": {
            "enum": [
              "principal_binding",
              "actor_binding",
              "on_behalf_of_binding",
              "local_recognition",
              "target_allowlist",
              "purpose_binding",
              "expiry",
              "delegation_scope",
              "pre_state",
              "payload_binding",
              "runtime_trigger"
            ]
          },
          "environment": {
            "const": "synthetic_offline"
          },
          "task": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_ref",
              "principal_ref",
              "actor_ref",
              "on_behalf_of_ref",
              "operation",
              "target_ref",
              "purpose_ref",
              "required_scope",
              "payload_sha256",
              "pre_state_sha256",
              "evaluated_at_unix"
            ],
            "properties": {
              "task_ref": {
                "type": "string",
                "minLength": 1
              },
              "principal_ref": {
                "type": "string",
                "minLength": 1
              },
              "actor_ref": {
                "type": "string",
                "minLength": 1
              },
              "on_behalf_of_ref": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "minLength": 1
              },
              "target_ref": {
                "type": "string",
                "minLength": 1
              },
              "purpose_ref": {
                "type": "string",
                "minLength": 1
              },
              "required_scope": {
                "type": "string",
                "minLength": 1
              },
              "payload_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "pre_state_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evaluated_at_unix": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "authority_context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "principal_ref",
              "actor_ref",
              "on_behalf_of_ref",
              "local_recognition",
              "target_allowlist",
              "purpose_ref",
              "expires_at_unix",
              "delegated_scope",
              "pre_state_sha256",
              "payload_sha256"
            ],
            "properties": {
              "principal_ref": {
                "type": "string",
                "minLength": 1
              },
              "actor_ref": {
                "type": "string",
                "minLength": 1
              },
              "on_behalf_of_ref": {
                "type": "string",
                "minLength": 1
              },
              "local_recognition": {
                "type": "boolean"
              },
              "target_allowlist": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "purpose_ref": {
                "type": "string",
                "minLength": 1
              },
              "expires_at_unix": {
                "type": "integer",
                "minimum": 1
              },
              "delegated_scope": {
                "type": "string",
                "minLength": 1
              },
              "pre_state_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "payload_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "expected_disposition": {
            "enum": [
              "EligibleForTestAdapter",
              "IneligibleNoAdapterCall",
              "ContinueWithinAuthorizedScope",
              "StopBeforeFurtherEffect"
            ]
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 1
          },
          "runtime_context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "observation_ref",
              "observation_text"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "PreExecution",
                  "AfterRead"
                ]
              },
              "observation_ref": {
                "type": "string",
                "minLength": 1
              },
              "observation_text": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "oracle_annotations": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expected_runtime_trigger"
            ],
            "properties": {
              "expected_runtime_trigger": {
                "enum": [
                  "NotApplicable",
                  "None",
                  "CriticalToolFailure",
                  "ConflictingEvidence",
                  "EmergentRisk",
                  "PayloadChangedAfterApproval"
                ]
              }
            }
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
