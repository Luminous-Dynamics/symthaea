{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/aced-adapter-001/EXPERIMENT_VALUE_TRACE_V0_1.schema.json",
  "title": "ACED experiment-value append-only trace v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "events",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "aced-experiment-value-trace-v0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "sequence",
              "event_type",
              "previous_event_sha256",
              "payload",
              "event_sha256"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "previous_event_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "event_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "event_type": {
                "const": "experiment_proposal"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "experiment_id",
                  "belief_state_sha256",
                  "selector",
                  "predicted_outcome_distribution",
                  "predicted_eig_bits",
                  "predicted_evsi",
                  "predicted_risk",
                  "risk_aversion_coefficient",
                  "predicted_cost",
                  "predicted_net_value"
                ],
                "properties": {
                  "experiment_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "belief_state_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "selector": {
                    "enum": [
                      "EIG",
                      "EVSI",
                      "RISK_ADJUSTED_EVSI"
                    ]
                  },
                  "predicted_outcome_distribution": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "outcome",
                        "probability"
                      ],
                      "properties": {
                        "outcome": {
                          "type": "string",
                          "minLength": 1
                        },
                        "probability": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    }
                  },
                  "predicted_eig_bits": {
                    "type": "number",
                    "minimum": 0
                  },
                  "predicted_evsi": {
                    "type": "number",
                    "minimum": 0
                  },
                  "predicted_risk": {
                    "type": "number",
                    "minimum": 0
                  },
                  "risk_aversion_coefficient": {
                    "type": "number",
                    "minimum": 0
                  },
                  "predicted_cost": {
                    "type": "number",
                    "minimum": 0
                  },
                  "predicted_net_value": {
                    "type": "number"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "sequence",
              "event_type",
              "previous_event_sha256",
              "payload",
              "event_sha256"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "previous_event_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "event_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "event_type": {
                "const": "experiment_observation"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "proposal_event_id",
                  "observation_status",
                  "observation_sha256",
                  "actual_cost"
                ],
                "properties": {
                  "proposal_event_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observation_status": {
                    "enum": [
                      "observed",
                      "failed",
                      "unknown"
                    ]
                  },
                  "observation_sha256": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "actual_cost": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "sequence",
              "event_type",
              "previous_event_sha256",
              "payload",
              "event_sha256"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "previous_event_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "event_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "event_type": {
                "const": "stop"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "evidence_state_sha256",
                  "reason"
                ],
                "properties": {
                  "evidence_state_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
