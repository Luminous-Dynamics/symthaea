{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/rob-fep-thermo-001/fixtures/known_answers_v0_1.schema.json",
  "title": "ROB-FEP-THERMO-001 known-answer fixtures v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "status",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "protocol_id": {
      "const": "ROB-FEP-THERMO-001"
    },
    "status": {
      "const": "synthetic_known_answers_only"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "description",
          "expected"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^FT[0-9]{2}_[A-Z0-9_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
