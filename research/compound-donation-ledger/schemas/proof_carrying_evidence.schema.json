{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/proof-carrying-evidence-v1.json",
  "title": "Proof-carrying Bernoulli e-process evidence envelope v1",
  "oneOf": [
    { "$ref": "#/$defs/specification" },
    { "$ref": "#/$defs/roundReceipt" }
  ],
  "$defs": {
    "rationalPair": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 1 },
        { "type": "integer", "minimum": 2 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "candidateSpec": {
      "type": "object",
      "required": ["id", "p0", "p1", "arrival_round"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "p0": { "$ref": "#/$defs/rationalPair" },
        "p1": { "$ref": "#/$defs/rationalPair" },
        "arrival_round": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "specification": {
      "type": "object",
      "required": [
        "version", "filtration_id", "adjuster_id", "adjuster_scale",
        "arrival_policy_digest", "null_assumption_digest",
        "source_completeness_attestation_digest", "candidates", "spec_digest"
      ],
      "properties": {
        "version": { "const": 1 },
        "filtration_id": { "type": "string", "minLength": 1 },
        "adjuster_id": { "const": "A2_SQRT_RUNNING_MAX_V1" },
        "adjuster_scale": { "type": "integer", "minimum": 1 },
        "arrival_policy_digest": { "$ref": "#/$defs/digest" },
        "null_assumption_digest": { "$ref": "#/$defs/digest" },
        "source_completeness_attestation_digest": { "$ref": "#/$defs/digest" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/candidateSpec" }
        },
        "spec_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observation": {
      "type": "object",
      "required": ["candidate_id", "value"],
      "properties": {
        "candidate_id": { "type": "integer", "minimum": 0 },
        "value": { "enum": [0, 1] }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["candidate_id", "factor", "lr", "running_max", "adjusted_integer"],
      "properties": {
        "candidate_id": { "type": "integer", "minimum": 0 },
        "factor": { "$ref": "#/$defs/rationalPair" },
        "lr": { "$ref": "#/$defs/rationalPair" },
        "running_max": { "$ref": "#/$defs/rationalPair" },
        "adjusted_integer": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "roundReceipt": {
      "type": "object",
      "required": [
        "version", "filtration_id", "spec_digest", "round", "sequence",
        "previous_batch_digest", "arrival_policy_digest",
        "source_completeness_attestation_digest", "active_candidate_ids",
        "observations", "claims", "batch_digest"
      ],
      "properties": {
        "version": { "const": 1 },
        "filtration_id": { "type": "string", "minLength": 1 },
        "spec_digest": { "$ref": "#/$defs/digest" },
        "round": { "type": "integer", "minimum": 0 },
        "sequence": { "type": "integer", "minimum": 1 },
        "previous_batch_digest": { "$ref": "#/$defs/digest" },
        "arrival_policy_digest": { "$ref": "#/$defs/digest" },
        "source_completeness_attestation_digest": { "$ref": "#/$defs/digest" },
        "active_candidate_ids": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        },
        "observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/observation" }
        },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim" }
        },
        "batch_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}