{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/ig-contagion-001/IG_CONTAGION_001_MATCHED_CONTENT_V0_1.schema.json",
  "title": "IG-CONTAGION-001 matched content bundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "canonicalization_profile",
    "agent_profile",
    "agent_profile_sha256",
    "evidence_packet",
    "evidence_packet_sha256",
    "paired_content",
    "message_sha256_by_pair",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "ig-contagion-matched-content-v0.1"
    },
    "status": {
      "enum": [
        "synthetic_content_unexecuted",
        "synthetic_content_frozen"
      ]
    },
    "canonicalization_profile": {
      "type": "string",
      "minLength": 40
    },
    "agent_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "description",
        "tool_access",
        "role_claims",
        "evidence_behavior",
        "prompt_injection",
        "identity_multiplicity",
        "model_claim"
      ],
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tool_access": {
          "type": "string"
        },
        "role_claims": {
          "type": "string"
        },
        "evidence_behavior": {
          "type": "string"
        },
        "prompt_injection": {
          "const": false
        },
        "identity_multiplicity": {
          "const": false
        },
        "model_claim": {
          "type": "string"
        }
      }
    },
    "agent_profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "world",
        "facts",
        "ground_truth",
        "limits"
      ],
      "properties": {
        "packet_id": {
          "type": "string"
        },
        "world": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "statement",
              "status"
            ],
            "properties": {
              "evidence_id": {
                "type": "string"
              },
              "statement": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "ground_truth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reading_exceeds_threshold",
            "alert_triggered"
          ],
          "properties": {
            "reading_exceeds_threshold": {
              "const": false
            },
            "alert_triggered": {
              "const": false
            }
          }
        },
        "limits": {
          "type": "string"
        }
      }
    },
    "evidence_packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "paired_content": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paired_content_ref",
          "scenario_kind",
          "message",
          "deceptive_claim",
          "evidence_refs",
          "persuasion_features",
          "expected_grounded_state"
        ],
        "properties": {
          "paired_content_ref": {
            "type": "string"
          },
          "scenario_kind": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 20
          },
          "deceptive_claim": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "persuasion_features": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "expected_grounded_state": {
            "const": "unsupported_and_false_under_packet"
          }
        }
      }
    },
    "message_sha256_by_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "IG-CONTENT-PAIR-01",
        "IG-CONTENT-PAIR-02",
        "IG-CONTENT-PAIR-03",
        "IG-CONTENT-PAIR-04",
        "IG-CONTENT-PAIR-05"
      ],
      "properties": {
        "IG-CONTENT-PAIR-01": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "IG-CONTENT-PAIR-02": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "IG-CONTENT-PAIR-03": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "IG-CONTENT-PAIR-04": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "IG-CONTENT-PAIR-05": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 40
    }
  }
}
