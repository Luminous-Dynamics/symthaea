{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/cmaq-013-selected-action-calibration-v0.1.json",
  "title": "CMAQ-013 selected-action calibration report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_count",
    "decisions_per_episode",
    "alpha",
    "safe_value_threshold",
    "feedback_delay_steps",
    "feedback_drop_rate",
    "rolling_window",
    "online_step_size",
    "search_widths",
    "scenarios",
    "methods",
    "cells",
    "rollout_horizons"
  ],
  "properties": {
    "schema_version": {
      "const": "cmaq-013-selected-action-calibration-v0.1"
    },
    "episode_count": {
      "const": 512
    },
    "decisions_per_episode": {
      "const": 48
    },
    "alpha": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "safe_value_threshold": {
      "type": "number"
    },
    "feedback_delay_steps": {
      "type": "integer",
      "minimum": 0
    },
    "feedback_drop_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rolling_window": {
      "type": "integer",
      "minimum": 1
    },
    "online_step_size": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "search_widths": {
      "const": [
        8,
        32,
        128
      ]
    },
    "scenarios": {
      "const": [
        "stationary",
        "abrupt_shift",
        "gradual_shift"
      ]
    },
    "methods": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "cells": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario",
          "search_width",
          "episode_count",
          "decisions_per_episode",
          "calibration_samples",
          "random_calibration_quantile",
          "selected_calibration_quantile",
          "oracle_selected_quantile",
          "methods",
          "rollout_horizon"
        ],
        "properties": {
          "scenario": {
            "enum": [
              "stationary",
              "abrupt_shift",
              "gradual_shift"
            ]
          },
          "search_width": {
            "enum": [
              8,
              32,
              128
            ]
          },
          "episode_count": {
            "const": 512
          },
          "decisions_per_episode": {
            "const": 48
          },
          "calibration_samples": {
            "type": "integer",
            "minimum": 1
          },
          "random_calibration_quantile": {
            "type": "number"
          },
          "selected_calibration_quantile": {
            "type": "number"
          },
          "oracle_selected_quantile": {
            "type": "number"
          },
          "methods": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "selected_action_coverage",
                "random_action_coverage",
                "false_safe_rate",
                "fallback_rate",
                "mean_realized_utility",
                "mean_interval_width",
                "feedback_updates_per_episode",
                "recovery_episode_rate",
                "p90_recovery_delay",
                "pre_shift_selected_coverage",
                "post_shift_selected_coverage"
              ],
              "properties": {
                "method": {
                  "type": "string"
                },
                "selected_action_coverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "random_action_coverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "false_safe_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "fallback_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "mean_realized_utility": {
                  "type": "number"
                },
                "mean_interval_width": {
                  "type": "number"
                },
                "feedback_updates_per_episode": {
                  "type": "number",
                  "minimum": 0
                },
                "recovery_episode_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "p90_recovery_delay": {
                  "type": "number",
                  "minimum": -1
                },
                "pre_shift_selected_coverage": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "post_shift_selected_coverage": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                }
              }
            }
          },
          "rollout_horizon": {
            "enum": [
              1,
              3,
              8
            ]
          }
        }
      }
    },
    "rollout_horizons": {
      "const": [
        1,
        3,
        8
      ]
    }
  }
}
