{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/ig-nudge-calibration-protocol-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "version",
    "status",
    "title",
    "research_question",
    "composition",
    "external_comparator",
    "cue_families",
    "task_contract",
    "metric_ids",
    "implemented_metric_ids",
    "deferred_metric_ids",
    "qualification_gates",
    "claim_ceiling"
  ],
  "properties": {
    "protocol_id": {
      "const": "IG-NUDGE-CALIBRATION-001"
    },
    "version": {
      "const": "0.1.0"
    },
    "status": {
      "const": "synthetic_one_step_cue_contract"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "composition": {
      "type": "object",
      "minProperties": 7
    },
    "external_comparator": {
      "type": "object"
    },
    "cue_families": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true
    },
    "task_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_count",
        "payoff_unit",
        "candidate_visible_fields",
        "oracle_only_fields",
        "tie_policy",
        "hidden_truth_leakage_permitted",
        "scope_note"
      ],
      "properties": {
        "option_count": {
          "const": 2
        },
        "payoff_unit": {
          "type": "string"
        },
        "candidate_visible_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "oracle_only_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tie_policy": {
          "type": "string"
        },
        "hidden_truth_leakage_permitted": {
          "const": false
        },
        "scope_note": {
          "type": "string"
        }
      }
    },
    "metric_ids": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true
    },
    "implemented_metric_ids": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "deferred_metric_ids": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "qualification_gates": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "claim_ceiling": {
      "type": "object"
    }
  }
}
