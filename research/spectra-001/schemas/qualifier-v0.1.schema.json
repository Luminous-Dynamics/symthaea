{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/spectra-synthetic-suite-v0.1.schema.json",
  "title": "SPECTRA synthetic qualifier suite v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "claim_ceiling", "scenarios"],
  "properties": {
    "schema": { "const": "symthaea.spectra.synthetic_suite.v0.1" },
    "claim_ceiling": { "const": "synthetic_only" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock_domain_id", "earliest_ns", "latest_ns"],
      "properties": {
        "clock_domain_id": { "$ref": "#/$defs/id" },
        "earliest_ns": { "type": "integer", "minimum": 0 },
        "latest_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["judge_id", "ranked_candidate_ids"],
      "properties": {
        "judge_id": { "$ref": "#/$defs/id" },
        "ranked_candidate_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id", "participant_id", "operator_id", "target_custodian_id",
        "evaluator_id", "target_id", "candidate_ids", "protocol_sha256",
        "target_pool_sha256", "target_selection_receipt_sha256", "response_sha256",
        "apparatus_locked_at", "target_selected_at", "response_sealed_at",
        "target_revealed_at", "judge_rankings"
      ],
      "properties": {
        "trial_id": { "$ref": "#/$defs/id" },
        "participant_id": { "$ref": "#/$defs/id" },
        "operator_id": { "$ref": "#/$defs/id" },
        "target_custodian_id": { "$ref": "#/$defs/id" },
        "evaluator_id": { "$ref": "#/$defs/id" },
        "target_id": { "$ref": "#/$defs/id" },
        "candidate_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "protocol_sha256": { "$ref": "#/$defs/sha256" },
        "target_pool_sha256": { "$ref": "#/$defs/sha256" },
        "target_selection_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "response_sha256": { "$ref": "#/$defs/sha256" },
        "apparatus_locked_at": { "$ref": "#/$defs/time" },
        "target_selected_at": { "$ref": "#/$defs/time" },
        "response_sealed_at": { "$ref": "#/$defs/time" },
        "target_revealed_at": { "$ref": "#/$defs/time" },
        "judge_rankings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/ranking" }
        }
      }
    },
    "expected_score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_rank_sum", "judge_count", "candidate_count",
        "twice_chance_minus_observed_rank_sum"
      ],
      "properties": {
        "target_rank_sum": { "type": "integer", "minimum": 1 },
        "judge_count": { "type": "integer", "minimum": 1 },
        "candidate_count": { "type": "integer", "minimum": 2 },
        "twice_chance_minus_observed_rank_sum": { "type": "integer" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "world", "injected_leakage_modality", "expected_acceptance", "expected_score", "trial"],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/id" },
        "world": { "enum": ["null", "signal_injected", "known_leakage_injected", "adversarial_mutation"] },
        "injected_leakage_modality": {
          "type": ["string", "null"],
          "enum": ["rf", "low_frequency_magnetic", "acoustic", "optical", "vibration", "thermal_airflow", "power_conducted", "network_timing", "procedural", null]
        },
        "expected_acceptance": { "type": "boolean" },
        "expected_score": { "oneOf": [{ "$ref": "#/$defs/expected_score" }, { "type": "null" }] },
        "trial": { "$ref": "#/$defs/trial" }
      }
    }
  }
}
