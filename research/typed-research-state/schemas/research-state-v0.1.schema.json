{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/research/typed-research-state/schemas/research-state-v0.1.schema.json",
  "title": "Typed Public ResearchState v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "research_episode_id",
    "evidence_prefix",
    "decision_context",
    "claims",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "symthaea-public-research-state-v0.1"
    },
    "status": {
      "enum": [
        "SYNTHETIC_CONFORMANCE_EXAMPLE_NOT_PRODUCTION_STATE",
        "PRODUCTION_PUBLIC_STATE"
      ]
    },
    "research_episode_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_prefix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix_id",
        "prefix_sha256",
        "lineage_snapshot_ref",
        "sequence_number"
      ],
      "properties": {
        "prefix_id": {
          "type": "string",
          "minLength": 1
        },
        "prefix_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lineage_snapshot_ref": {
          "type": "string",
          "minLength": 1
        },
        "sequence_number": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "decision_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "question",
        "reference_time",
        "risk_class"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "reference_time": {
          "type": "string",
          "format": "date-time"
        },
        "risk_class": {
          "enum": [
            "LOW",
            "MODERATE",
            "HIGH",
            "CRITICAL"
          ]
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population",
        "outcome_or_measure",
        "quantifier_or_effect",
        "domain_or_reference_boundary",
        "scope_note"
      ],
      "properties": {
        "population": {
          "type": "string",
          "minLength": 1
        },
        "outcome_or_measure": {
          "type": "string",
          "minLength": 1
        },
        "quantifier_or_effect": {
          "type": "string",
          "minLength": 1
        },
        "domain_or_reference_boundary": {
          "type": "string",
          "minLength": 1
        },
        "scope_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "scope",
        "reference_time",
        "evidence_relations",
        "truth_adjudication",
        "decision_usability"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "reference_time": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "evidence_id",
              "relation",
              "classifier_provenance",
              "quote_span"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "enum": [
                  "UNCLASSIFIED",
                  "SUPPORTS",
                  "REFUTES",
                  "QUALIFIES",
                  "IRRELEVANT",
                  "UNRESOLVED"
                ]
              },
              "classifier_provenance": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "classifier_id",
                      "version",
                      "output_digest",
                      "confidence",
                      "emitted_at",
                      "evidence_prefix_sha256"
                    ],
                    "properties": {
                      "classifier_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1
                      },
                      "output_digest": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "emitted_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "evidence_prefix_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                ]
              },
              "quote_span": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "byte_start",
                      "byte_end",
                      "quote_sha256"
                    ],
                    "properties": {
                      "byte_start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "byte_end": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "quote_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "truth_adjudication": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "result",
                "authority_id",
                "evidence_reference",
                "adjudicated_at"
              ],
              "properties": {
                "status": {
                  "const": "NOT_ADJUDICATED"
                },
                "result": {
                  "type": "null"
                },
                "authority_id": {
                  "type": "null"
                },
                "evidence_reference": {
                  "type": "null"
                },
                "adjudicated_at": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "result",
                "authority_id",
                "evidence_reference",
                "adjudicated_at"
              ],
              "properties": {
                "status": {
                  "const": "ADJUDICATED"
                },
                "result": {
                  "enum": [
                    "SUPPORTED",
                    "REFUTED",
                    "MIXED",
                    "UNDECIDABLE"
                  ]
                },
                "authority_id": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_reference": {
                  "type": "string",
                  "minLength": 1
                },
                "adjudicated_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          ]
        },
        "decision_usability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "decision_scope_id",
            "policy_id",
            "reason_codes"
          ],
          "properties": {
            "status": {
              "enum": [
                "UNASSESSED",
                "SUFFICIENT",
                "INSUFFICIENT",
                "CONFLICTED",
                "STALE",
                "OUT_OF_SCOPE"
              ]
            },
            "decision_scope_id": {
              "type": "string",
              "minLength": 1
            },
            "policy_id": {
              "type": "string",
              "minLength": 1
            },
            "reason_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "artifact_ref",
        "artifact_sha256",
        "canonical_source_ref",
        "published_at",
        "captured_at",
        "source_role",
        "source_lineage",
        "integrity_status",
        "correction_status",
        "retrieval_state"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "canonical_source_ref": {
          "type": "string",
          "format": "uri"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_lineage": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "const": "UNKNOWN"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "family_ref"
              ],
              "properties": {
                "status": {
                  "const": "KNOWN"
                },
                "family_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "integrity_status": {
          "enum": [
            "UNKNOWN",
            "CLEAN",
            "COMPROMISED",
            "MISSING"
          ]
        },
        "correction_status": {
          "enum": [
            "UNKNOWN",
            "NONE",
            "CORRECTED",
            "RETRACTED",
            "SUPERSEDED"
          ]
        },
        "retrieval_state": {
          "enum": [
            "NOT_FOUND",
            "FETCHED",
            "CAPTURED",
            "DIGEST_MISMATCH",
            "UNATTRIBUTED"
          ]
        },
        "source_role": {
          "enum": [
            "UNKNOWN",
            "PRIMARY",
            "SECONDARY",
            "REGISTRY",
            "SYNDICATED"
          ]
        }
      }
    }
  }
}
