{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/rcaf/execution-receipt.schema.json",
  "title": "RCAF content-addressed simulation execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "workflow",
    "environment",
    "source_tree_sha256",
    "source_files",
    "simulation_reports",
    "claim_limits"
  ],
  "properties": {
    "schema_version": {
      "const": "rcaf.execution-receipt/0.1.0"
    },
    "source_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "run_id",
        "run_attempt",
        "event_sha"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_attempt": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "python",
        "rustc",
        "cargo"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "rustc": {
          "type": "string"
        },
        "cargo": {
          "type": "string"
        }
      }
    },
    "source_tree_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "simulation_reports": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename",
          "sha256",
          "bytes",
          "schema_version",
          "estimator_ids"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "schema_version": {
            "type": "string"
          },
          "estimator_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "claim_limits": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    }
  }
}
