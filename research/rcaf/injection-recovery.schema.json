{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/rcaf/injection-recovery.schema.json",
  "title": "RCAF synthetic injection-recovery report",
  "description": "Simulation-only calibration report. It is not a biological observation or clinical validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seed",
    "participants_per_replicate",
    "regions",
    "samples_per_segment",
    "monte_carlo_replicates",
    "injection_loading_delta",
    "alpha",
    "null_false_positive_rate",
    "injection_detection_power",
    "median_null_paired_gap",
    "median_injected_paired_gap",
    "median_null_positive_gap_fraction",
    "median_injected_positive_gap_fraction",
    "claim_limits"
  ],
  "properties": {
    "schema_version": {
      "const": "rcaf.injection-recovery/0.1.0"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "participants_per_replicate": {
      "type": "integer",
      "minimum": 8
    },
    "regions": {
      "type": "integer",
      "minimum": 4
    },
    "samples_per_segment": {
      "type": "integer",
      "minimum": 30
    },
    "monte_carlo_replicates": {
      "type": "integer",
      "minimum": 20
    },
    "injection_loading_delta": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 0.5
    },
    "null_false_positive_rate": {
      "$ref": "#/$defs/binomialRate"
    },
    "injection_detection_power": {
      "$ref": "#/$defs/binomialRate"
    },
    "median_null_paired_gap": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "median_injected_paired_gap": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "median_null_positive_gap_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "median_injected_positive_gap_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "claim_limits": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "binomialRate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successes",
        "trials",
        "estimate",
        "ci95_lower",
        "ci95_upper"
      ],
      "properties": {
        "successes": {
          "type": "integer",
          "minimum": 0
        },
        "trials": {
          "type": "integer",
          "minimum": 1
        },
        "estimate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ci95_lower": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ci95_upper": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
