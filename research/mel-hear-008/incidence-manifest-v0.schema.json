{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mel-hear-008-incidence-v0.schema.json",
  "title": "MEL-HEAR-008 incidence and estimand manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "work_ids",
    "performer_ids",
    "cells",
    "estimands",
    "support_audit"
  ],
  "properties": {
    "schema_version": {
      "const": "mel-hear-008-incidence-v0"
    },
    "study_id": {
      "$ref": "#/$defs/locator"
    },
    "simulation_only": {
      "type": "boolean"
    },
    "work_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/locator"
      }
    },
    "performer_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/locator"
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cell"
      }
    },
    "estimands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/estimand"
      }
    },
    "support_audit": {
      "$ref": "#/$defs/supportAudit"
    }
  },
  "$defs": {
    "locator": {
      "type": "string",
      "pattern": "^(synthetic:[A-Za-z0-9._-]+|sha256:[a-f0-9]{64})$"
    },
    "weight": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "work_id",
        "performer_membership",
        "status"
      ],
      "properties": {
        "cell_id": {
          "$ref": "#/$defs/locator"
        },
        "work_id": {
          "$ref": "#/$defs/locator"
        },
        "performer_membership": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "performer_id",
              "weight"
            ],
            "properties": {
              "performer_id": {
                "$ref": "#/$defs/locator"
              },
              "weight": {
                "$ref": "#/$defs/weight"
              }
            }
          }
        },
        "session_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "status": {
          "enum": [
            "observed",
            "missing_not_sampled",
            "missing_unknown",
            "unjoinable_performer"
          ]
        },
        "paired_effect_mean": {
          "type": "number"
        },
        "repeat_count": {
          "type": "integer",
          "minimum": 1
        },
        "missingness_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "paired_effect_mean",
              "repeat_count"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "missing_not_sampled",
                  "missing_unknown",
                  "unjoinable_performer"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "missingness_reason"
            ]
          }
        }
      ]
    },
    "cellWeight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "weight"
      ],
      "properties": {
        "cell_id": {
          "$ref": "#/$defs/locator"
        },
        "weight": {
          "$ref": "#/$defs/weight"
        }
      }
    },
    "marginalWeight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "weight"
      ],
      "properties": {
        "unit_id": {
          "$ref": "#/$defs/locator"
        },
        "weight": {
          "$ref": "#/$defs/weight"
        }
      }
    },
    "estimand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimand_id",
        "kind",
        "target_population",
        "weighting_rule",
        "support_disposition",
        "cell_weights"
      ],
      "properties": {
        "estimand_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "observed_cell_mean",
            "equal_work_macro_mean",
            "equal_performer_macro_mean",
            "declared_target_population_mean"
          ]
        },
        "target_population": {
          "type": "string",
          "minLength": 1
        },
        "weighting_rule": {
          "type": "string",
          "minLength": 1
        },
        "support_disposition": {
          "enum": [
            "supported",
            "descriptive_only",
            "not_estimable",
            "model_based_sensitivity"
          ]
        },
        "cell_weights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cellWeight"
          }
        },
        "target_work_weights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marginalWeight"
          }
        },
        "target_performer_weights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marginalWeight"
          }
        },
        "expected_point_estimate_fraction": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_point_estimate_decimal": {
          "type": [
            "number",
            "null"
          ]
        },
        "disposition_reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "declared_target_population_mean"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "target_work_weights",
              "target_performer_weights"
            ],
            "properties": {
              "target_work_weights": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/marginalWeight"
                }
              },
              "target_performer_weights": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/marginalWeight"
                }
              }
            }
          }
        }
      ]
    },
    "supportAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_count",
        "performer_count",
        "possible_single_performer_cells",
        "observed_cells",
        "complete_cartesian_support",
        "connected_components",
        "isolated_work_ids",
        "isolated_performer_ids",
        "max_work_degree",
        "max_performer_degree"
      ],
      "properties": {
        "work_count": {
          "type": "integer",
          "minimum": 1
        },
        "performer_count": {
          "type": "integer",
          "minimum": 1
        },
        "possible_single_performer_cells": {
          "type": "integer",
          "minimum": 1
        },
        "observed_cells": {
          "type": "integer",
          "minimum": 1
        },
        "complete_cartesian_support": {
          "type": "boolean"
        },
        "connected_components": {
          "type": "integer",
          "minimum": 1
        },
        "isolated_work_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "isolated_performer_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "max_work_degree": {
          "type": "integer",
          "minimum": 1
        },
        "max_performer_degree": {
          "type": "integer",
          "minimum": 1
        },
        "incidence_graph_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
