{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mace-evaluator-oracle-v0.1.schema.json",
  "title": "MACE Evaluator Oracle v0.1",
  "description": "Evaluator-only expected outcomes and intervention-pair metadata. Never mount this file into an agent context or prompt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "oracles"
  ],
  "properties": {
    "schema_version": {
      "const": "mace-evaluator-oracles-v0.1"
    },
    "oracles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "pair",
          "evaluator_oracle"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^MACE-[A-Z][0-9]{2}$"
          },
          "pair": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pair_id",
              "role"
            ],
            "properties": {
              "pair_id": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "anchor",
                  "irrelevant_control"
                ]
              }
            }
          },
          "evaluator_oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "causal_status",
              "expected_transfer",
              "expected_action",
              "expected_completion_state",
              "reason_codes"
            ],
            "properties": {
              "causal_status": {
                "enum": [
                  "not_identified",
                  "identified",
                  "regime_shifted",
                  "outcome_unverified"
                ]
              },
              "expected_transfer": {
                "enum": [
                  "record_association_only",
                  "reuse_qualified_transition",
                  "requalify_before_reuse",
                  "mark_outcome_unknown"
                ]
              },
              "expected_action": {
                "type": "string"
              },
              "expected_completion_state": {
                "enum": [
                  "not_applicable",
                  "verified_effect",
                  "not_effect_verified",
                  "unknown_pending_reconciliation"
                ]
              },
              "reason_codes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "identified_effect": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "variable": {
                    "type": "string"
                  },
                  "direction": {
                    "enum": [
                      "positive",
                      "negative",
                      "zero",
                      "non_monotone",
                      "unknown"
                    ]
                  },
                  "preconditions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
