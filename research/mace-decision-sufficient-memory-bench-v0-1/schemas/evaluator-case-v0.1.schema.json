{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/mace-decision-sufficient-memory-bench-v0-1/schemas/evaluator-case-v0.1.schema.json",
  "title": "MACE DSM Evaluator-Private Case v0.1",
  "description": "Evaluator-only truth and loss labels. Never mount this file into the candidate process.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "candidate_sha256",
    "action_losses",
    "no_memory_action",
    "oracle_action",
    "admissible_evidence_ids",
    "required_evidence_ids",
    "forbidden_evidence_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "mace_dsm_evaluator_case_v0_1"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "action_losses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "loss_micros"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "loss_micros": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "no_memory_action": {
      "type": "string",
      "minLength": 1
    },
    "oracle_action": {
      "type": "string",
      "minLength": 1
    },
    "admissible_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
