{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/mace-decision-sufficient-memory-bench-v0-1/schemas/candidate-run-v0.2.schema.json",
  "title": "MACE DSM Candidate Run with Measurement-Aware Cost v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "cost"
  ],
  "properties": {
    "schema_version": {
      "const": "mace_dsm_candidate_run_v0_2"
    },
    "run": {
      "$ref": "#/$defs/candidateRunV1"
    },
    "cost": {
      "$ref": "#/$defs/costReceiptV2"
    }
  },
  "$defs": {
    "candidateRunV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "system_id",
        "downstream_policy_digest",
        "decision_seed",
        "chosen_action",
        "retrieved_evidence_ids",
        "decision_support_evidence_ids"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "system_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "downstream_policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision_seed": {
          "type": "integer",
          "minimum": 0
        },
        "chosen_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "retrieved_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision_support_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "add_ingest_ns",
        "index_update_ns",
        "retrieval_ns",
        "evidence_verification_ns",
        "policy_application_ns",
        "maintenance_ns",
        "unattributed_ns",
        "wall_ns"
      ],
      "properties": {
        "add_ingest_ns": {
          "type": "integer",
          "minimum": 0
        },
        "index_update_ns": {
          "type": "integer",
          "minimum": 0
        },
        "retrieval_ns": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_verification_ns": {
          "type": "integer",
          "minimum": 0
        },
        "policy_application_ns": {
          "type": "integer",
          "minimum": 0
        },
        "maintenance_ns": {
          "type": "integer",
          "minimum": 0
        },
        "unattributed_ns": {
          "type": "integer",
          "minimum": 0
        },
        "wall_ns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resourceQuantity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "status"
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "status": {
              "const": "measured"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "status"
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "status": {
              "const": "estimated"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "status"
          ],
          "properties": {
            "value": {
              "type": "null"
            },
            "status": {
              "const": "unknown"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "status"
          ],
          "properties": {
            "value": {
              "type": "null"
            },
            "status": {
              "const": "not_applicable"
            }
          }
        }
      ]
    },
    "costReceiptV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phases",
        "measured_cost_microunits",
        "estimated_cost_microunits",
        "retained_bytes",
        "index_bytes",
        "network_bytes"
      ],
      "properties": {
        "phases": {
          "$ref": "#/$defs/phases"
        },
        "measured_cost_microunits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "estimated_cost_microunits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retained_bytes": {
          "$ref": "#/$defs/resourceQuantity"
        },
        "index_bytes": {
          "$ref": "#/$defs/resourceQuantity"
        },
        "network_bytes": {
          "$ref": "#/$defs/resourceQuantity"
        }
      }
    }
  }
}
