      "requirement": "Add messages retain exact source order and timestamps."
    },
    {
      "id": "ORDER-002",
      "requirement": "Search results are already relevance-ranked; adapters preserve order and never sort by created_at."
    },
    {
      "id": "READ-AFTER-WRITE-001",
      "requirement": "HTTP 200 Add success is forbidden until persisted data can be retrieved immediately."
    },
    {
      "id": "RETRY-001",
