{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mace-evalqual-corpus-v1.json",
  "title": "MACE Evaluator Qualification Corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "sampling", "fixtures"],
  "properties": {
    "schema_version": {"const": "mace-evalqual/v1"},
    "benchmark": {"$ref": "#/$defs/benchmark"},
    "sampling": {"$ref": "#/$defs/sampling"},
    "fixtures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fixture"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"type": "string", "enum": ["pass", "fail", "indeterminate"]},
    "effectStatus": {"type": "string", "enum": ["pass", "fail", "indeterminate", "not_applicable"]},
    "benchmark": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "revision", "split", "task_set_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "split": {"type": "string", "minLength": 1},
        "task_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sampling": {
      "type": "object", "additionalProperties": false,
      "required": ["design", "unit", "independence_caveat"],
      "properties": {
        "design": {"enum": ["fixed_adversarial_corpus", "iid_random"]},
        "unit": {"type": "string", "minLength": 1},
        "frame_sha256": {"$ref": "#/$defs/sha256"},
        "selection_seed": {"type": "string", "minLength": 1},
        "selection_method": {"type": "string", "minLength": 1},
        "independence_caveat": {"type": "string", "minLength": 1}
      },
      "allOf": [{
        "if": {"properties": {"design": {"const": "iid_random"}}, "required": ["design"]},
        "then": {"required": ["frame_sha256", "selection_seed", "selection_method"]}
      }]
    },
    "resultVector": {
      "type": "object", "additionalProperties": false,
      "required": ["task_result", "effect_assurance_result", "benchmark_integrity_result"],
      "properties": {
        "task_result": {"$ref": "#/$defs/status"},
        "effect_assurance_result": {"$ref": "#/$defs/effectStatus"},
        "benchmark_integrity_result": {"$ref": "#/$defs/status"}
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "task_id", "task_family", "kind", "expected"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "task_family": {"type": "string", "minLength": 1},
        "kind": {"enum": ["positive", "negative", "condition_removed", "representation_twin"]},
        "mutation_family": {"type": "string", "minLength": 1},
        "target_dimension": {"enum": ["task", "effect_assurance", "benchmark_integrity"]},
        "baseline_fixture_id": {"type": "string", "minLength": 1},
        "paired_fixture_id": {"type": "string", "minLength": 1},
        "expected": {"$ref": "#/$defs/resultVector"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "positive"}}, "required": ["kind"]},
          "then": {
            "properties": {"expected": {"properties": {"task_result": {"const": "pass"}, "effect_assurance_result": {"const": "pass"}, "benchmark_integrity_result": {"const": "pass"}}}},
            "not": {"anyOf": [{"required": ["baseline_fixture_id"]}, {"required": ["paired_fixture_id"]}, {"required": ["target_dimension"]}]}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "negative"}}, "required": ["kind"]},
          "then": {"required": ["mutation_family", "target_dimension", "baseline_fixture_id", "paired_fixture_id"]}
        },
        {
          "if": {"properties": {"kind": {"const": "condition_removed"}}, "required": ["kind"]},
          "then": {"required": ["baseline_fixture_id", "paired_fixture_id"]}
        },
        {
          "if": {"properties": {"kind": {"const": "representation_twin"}}, "required": ["kind"]},
          "then": {"required": ["baseline_fixture_id"]}
        }
      ]
    }
  }
}