{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/science-bench-refresh/schema/rubric-specification.schema.json",
  "title": "Symthaea Rubric Specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "purpose",
    "rubric_id",
    "rubric_source_revision",
    "rubric_sha256",
    "hard_constraint_policy",
    "score_scale",
    "criteria",
    "dependency_rules",
    "tests"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.science_bench_refresh_rubric_specification.v1"
    },
    "purpose": {
      "enum": [
        "example_only",
        "qualified_rubric"
      ]
    },
    "rubric_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rubric_source_revision": {
      "type": "string",
      "minLength": 1
    },
    "rubric_sha256": {
      "$ref": "#/$defs/digest"
    },
    "hard_constraint_policy": {
      "const": "veto_not_average"
    },
    "score_scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_millionths",
        "maximum_millionths"
      ],
      "properties": {
        "minimum_millionths": {
          "const": 0
        },
        "maximum_millionths": {
          "const": 1000000
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "dependency_rules": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/test"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "construct_dimension",
        "definition",
        "applicability",
        "required_observable_evidence",
        "insufficient_evidence",
        "exclusions",
        "priority",
        "hard_constraint",
        "veto_condition",
        "score_anchors",
        "counterexamples",
        "planned_test_ids"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "construct_dimension": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "definition": {
          "type": "string",
          "minLength": 20,
          "maxLength": 4000
        },
        "applicability": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "required_observable_evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1000
          }
        },
        "insufficient_evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1000
          }
        },
        "exclusions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1000
          }
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "hard_constraint": {
          "type": "boolean"
        },
        "veto_condition": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "score_anchors": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "score_millionths",
              "description"
            ],
            "properties": {
              "score_millionths": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "description": {
                "type": "string",
                "minLength": 8,
                "maxLength": 1000
              }
            }
          }
        },
        "counterexamples": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1000
          }
        },
        "planned_test_ids": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "hard_constraint": {
                "const": true
              }
            },
            "required": [
              "hard_constraint"
            ]
          },
          "then": {
            "properties": {
              "veto_condition": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hard_constraint": {
                "const": false
              }
            },
            "required": [
              "hard_constraint"
            ]
          },
          "then": {
            "properties": {
              "veto_condition": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_criterion_id",
        "to_criterion_id",
        "relation",
        "rationale"
      ],
      "properties": {
        "from_criterion_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "to_criterion_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "relation": {
          "enum": [
            "requires",
            "conflicts_with",
            "overrides"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 12,
          "maxLength": 1000
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "test_type",
        "criterion_ids",
        "expected_judge_behavior",
        "candidate_pair_sha256"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "test_type": {
          "enum": [
            "positive",
            "negative",
            "edge_case",
            "adversarial",
            "meaning_preserving",
            "meaning_changing"
          ]
        },
        "criterion_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "expected_judge_behavior": {
          "enum": [
            "accept_supported",
            "reject_unsupported",
            "abstain_or_mark_scope_ambiguous",
            "no_unearned_score_uplift",
            "directional_criterion_sensitivity"
          ]
        },
        "candidate_pair_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "qualified_rubric"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "properties": {
          "rubric_source_revision": {
            "allOf": [
              {
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "not": {
                  "pattern": "^0{40}$"
                }
              }
            ]
          },
          "rubric_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "criteria": {
            "items": {
              "properties": {
                "planned_test_ids": {
                  "minItems": 4
                }
              }
            }
          },
          "tests": {
            "items": {
              "properties": {
                "candidate_pair_sha256": {
                  "not": {
                    "pattern": "^0{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
