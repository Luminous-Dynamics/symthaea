{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/science-bench-refresh/schema/intervention-quality-receipt.schema.json",
  "title": "Symthaea Intervention Quality Adjudication Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "analyzer_source_revision",
    "purpose",
    "run_id",
    "plan_sha256",
    "plan_commitment_sha256",
    "generator_source_revision",
    "semantic_verifier_source_revision",
    "semantic_verifier_policy_sha256",
    "adjudications"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.science_bench_refresh_intervention_quality_receipt.v1"
    },
    "analyzer_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "not": {
        "pattern": "^0{40}$"
      }
    },
    "purpose": {
      "enum": [
        "example_only",
        "qualified_run"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "plan_sha256": {
      "$ref": "#/$defs/digest"
    },
    "plan_commitment_sha256": {
      "$ref": "#/$defs/digest"
    },
    "generator_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "semantic_verifier_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "semantic_verifier_policy_sha256": {
      "$ref": "#/$defs/digest"
    },
    "adjudications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/adjudication"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id_sha256",
        "verdict",
        "blind_to_generator_identity",
        "blind_to_intended_relation",
        "blind_to_pipeline_disposition",
        "blind_to_evaluator_outcome",
        "adjudication_artifact_sha256"
      ],
      "properties": {
        "reviewer_id_sha256": {
          "$ref": "#/$defs/digest"
        },
        "verdict": {
          "enum": [
            "meaning_preserving",
            "meaning_changing",
            "ambiguous"
          ]
        },
        "blind_to_generator_identity": {
          "const": true
        },
        "blind_to_pipeline_disposition": {
          "const": true
        },
        "blind_to_evaluator_outcome": {
          "const": true
        },
        "adjudication_artifact_sha256": {
          "$ref": "#/$defs/digest"
        },
        "blind_to_intended_relation": {
          "const": true
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "reviewers"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/reviewer"
          }
        }
      }
    }
  }
}
