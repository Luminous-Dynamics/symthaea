{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/science-bench-refresh/schema/imperfect-judge-certification-receipt.schema.json",
  "title": "Symthaea Imperfect Judge Certification Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "purpose",
    "run_id",
    "plan_sha256",
    "plan_commitment_sha256",
    "analyzer_source_revision",
    "judge_source_revision",
    "judge_prompt_sha256",
    "rubric_sha256",
    "human_reference_protocol_sha256",
    "calibration_observations",
    "test_observations"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.science_bench_refresh_imperfect_judge_certification_receipt.v1"
    },
    "purpose": {
      "enum": [
        "example_only",
        "qualified_run"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "plan_sha256": {
      "$ref": "#/$defs/digest"
    },
    "plan_commitment_sha256": {
      "$ref": "#/$defs/digest"
    },
    "analyzer_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "judge_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "judge_prompt_sha256": {
      "$ref": "#/$defs/digest"
    },
    "rubric_sha256": {
      "$ref": "#/$defs/digest"
    },
    "human_reference_protocol_sha256": {
      "$ref": "#/$defs/digest"
    },
    "calibration_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/calibration_observation"
      }
    },
    "test_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "$ref": "#/$defs/test_observation"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "judge_outcome": {
      "enum": [
        "failure",
        "non_failure",
        "abstain"
      ]
    },
    "calibration_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "input_sha256",
        "judge_outcome"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "input_sha256": {
          "$ref": "#/$defs/digest"
        },
        "judge_outcome": {
          "$ref": "#/$defs/judge_outcome"
        }
      }
    },
    "test_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "input_sha256",
        "judge_outcome"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "input_sha256": {
          "$ref": "#/$defs/digest"
        },
        "judge_outcome": {
          "$ref": "#/$defs/judge_outcome"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "qualified_run"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "properties": {
          "plan_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "plan_commitment_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "analyzer_source_revision": {
            "not": {
              "pattern": "^0{40}$"
            }
          },
          "judge_source_revision": {
            "not": {
              "pattern": "^0{40}$"
            }
          },
          "judge_prompt_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "rubric_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "human_reference_protocol_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          }
        }
      }
    }
  ]
}
