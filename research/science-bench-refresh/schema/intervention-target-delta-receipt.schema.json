{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/science-bench-refresh/schema/intervention-target-delta-receipt.schema.json",
  "title": "Symthaea Intervention Target Delta Adjudication Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "analyzer_source_revision",
    "purpose",
    "run_id",
    "target_plan_sha256",
    "target_plan_commitment_sha256",
    "quality_plan_sha256",
    "quality_receipt_sha256",
    "adjudications"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.science_bench_refresh_intervention_target_delta_receipt.v1"
    },
    "analyzer_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "not": {
        "pattern": "^0{40}$"
      }
    },
    "purpose": {
      "enum": [
        "example_only",
        "qualified_run"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target_plan_sha256": {
      "$ref": "#/$defs/digest"
    },
    "target_plan_commitment_sha256": {
      "$ref": "#/$defs/digest"
    },
    "quality_plan_sha256": {
      "$ref": "#/$defs/digest"
    },
    "quality_receipt_sha256": {
      "$ref": "#/$defs/digest"
    },
    "adjudications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/adjudication"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "change": {
      "enum": [
        "unchanged",
        "support_increased",
        "support_decreased",
        "contradiction_introduced",
        "scope_changed",
        "temporal_validity_changed",
        "unit_changed",
        "identity_changed",
        "source_withdrawn",
        "source_superseded",
        "other_declared_change"
      ]
    },
    "collateral": {
      "enum": [
        "none_observed",
        "material_change_outside_allowed_scope",
        "ambiguous"
      ]
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id_sha256",
        "reviewed_target_identity_sha256",
        "baseline_artifact_sha256",
        "variant_artifact_sha256",
        "observed_target_change",
        "observed_changed_claim_ids_sha256",
        "collateral_change",
        "blind_to_generator_identity",
        "blind_to_intended_relation",
        "blind_to_pipeline_disposition",
        "blind_to_evaluator_outcome",
        "blind_to_expected_target_change",
        "blind_to_allowed_changed_claims",
        "adjudication_artifact_sha256"
      ],
      "properties": {
        "reviewer_id_sha256": {
          "$ref": "#/$defs/digest"
        },
        "observed_target_change": {
          "$ref": "#/$defs/change"
        },
        "observed_changed_claim_ids_sha256": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "collateral_change": {
          "$ref": "#/$defs/collateral"
        },
        "blind_to_generator_identity": {
          "const": true
        },
        "blind_to_intended_relation": {
          "const": true
        },
        "blind_to_pipeline_disposition": {
          "const": true
        },
        "blind_to_evaluator_outcome": {
          "const": true
        },
        "blind_to_expected_target_change": {
          "const": true
        },
        "blind_to_allowed_changed_claims": {
          "const": true
        },
        "adjudication_artifact_sha256": {
          "$ref": "#/$defs/digest"
        },
        "reviewed_target_identity_sha256": {
          "$ref": "#/$defs/digest"
        },
        "baseline_artifact_sha256": {
          "$ref": "#/$defs/digest"
        },
        "variant_artifact_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "reviewers"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/reviewer"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "qualified_run"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "properties": {
          "target_plan_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "target_plan_commitment_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "quality_plan_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "quality_receipt_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          }
        }
      }
    }
  ]
}
