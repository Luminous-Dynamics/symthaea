{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/science-bench-refresh/schema/mutation-validity-receipt.schema.json",
  "title": "Symthaea Semantic Mutation Validity Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "analyzer_source_revision",
    "purpose",
    "run_id",
    "plan_sha256",
    "plan_commitment_sha256",
    "metamorphic_receipt_sha256",
    "generator_source_revision",
    "evaluator_source_revision",
    "evaluator_prompt_sha256",
    "rubric_sha256",
    "observations"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.science_bench_refresh_mutation_validity_receipt.v1"
    },
    "analyzer_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "purpose": {
      "enum": [
        "example_only",
        "qualified_run"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "plan_sha256": {
      "$ref": "#/$defs/digest"
    },
    "plan_commitment_sha256": {
      "$ref": "#/$defs/digest"
    },
    "metamorphic_receipt_sha256": {
      "$ref": "#/$defs/digest"
    },
    "generator_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evaluator_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evaluator_prompt_sha256": {
      "$ref": "#/$defs/digest"
    },
    "rubric_sha256": {
      "$ref": "#/$defs/digest"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudicator_id_sha256",
        "independence_group_sha256",
        "decision",
        "confidence_millionths",
        "rationale_sha256"
      ],
      "properties": {
        "adjudicator_id_sha256": {
          "$ref": "#/$defs/digest"
        },
        "independence_group_sha256": {
          "$ref": "#/$defs/digest"
        },
        "decision": {
          "enum": [
            "preserves_semantics",
            "changes_semantics",
            "indeterminate",
            "abstain"
          ]
        },
        "confidence_millionths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "rationale_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_id",
        "baseline_input_sha256",
        "variant_input_sha256",
        "adjudications",
        "evaluation_status",
        "evaluator_relation_pass",
        "failure_fingerprint_sha256",
        "generator_call_count",
        "generator_token_count",
        "semantic_assistance_call_count",
        "semantic_assistance_token_count",
        "evaluator_call_count",
        "evaluator_token_count",
        "human_review_seconds",
        "wall_time_milliseconds"
      ],
      "properties": {
        "mutation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "baseline_input_sha256": {
          "$ref": "#/$defs/digest"
        },
        "variant_input_sha256": {
          "$ref": "#/$defs/digest"
        },
        "adjudications": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/adjudication"
          }
        },
        "evaluation_status": {
          "enum": [
            "completed",
            "timed_out",
            "blocked",
            "invalid_receipt",
            "not_started"
          ]
        },
        "evaluator_relation_pass": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_fingerprint_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "generator_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "generator_token_count": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_assistance_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_assistance_token_count": {
          "type": "integer",
          "minimum": 0
        },
        "evaluator_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "evaluator_token_count": {
          "type": "integer",
          "minimum": 0
        },
        "human_review_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "wall_time_milliseconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evaluation_status": {
                "const": "completed"
              }
            },
            "required": [
              "evaluation_status"
            ]
          },
          "then": {
            "properties": {
              "evaluator_relation_pass": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluation_status": {
                "enum": [
                  "timed_out",
                  "blocked",
                  "invalid_receipt",
                  "not_started"
                ]
              }
            },
            "required": [
              "evaluation_status"
            ]
          },
          "then": {
            "properties": {
              "evaluator_relation_pass": {
                "type": "null"
              },
              "failure_fingerprint_sha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluator_relation_pass": {
                "const": true
              }
            },
            "required": [
              "evaluator_relation_pass"
            ]
          },
          "then": {
            "properties": {
              "failure_fingerprint_sha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluator_relation_pass": {
                "const": false
              }
            },
            "required": [
              "evaluator_relation_pass"
            ]
          },
          "then": {
            "properties": {
              "failure_fingerprint_sha256": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "qualified_run"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "properties": {
          "analyzer_source_revision": {
            "not": {
              "pattern": "^0{40}$"
            }
          },
          "plan_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "plan_commitment_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "metamorphic_receipt_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "generator_source_revision": {
            "not": {
              "pattern": "^0{40}$"
            }
          },
          "evaluator_source_revision": {
            "not": {
              "pattern": "^0{40}$"
            }
          },
          "evaluator_prompt_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "rubric_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          }
        }
      }
    }
  ]
}
