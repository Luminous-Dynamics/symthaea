{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/science-bench-refresh/schema/imperfect-judge-certification-plan.schema.json",
  "title": "Symthaea Imperfect Judge Certification Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "analyzer_source_revision",
    "purpose",
    "study_id",
    "judge_source_revision",
    "judge_prompt_sha256",
    "rubric_sha256",
    "human_reference_protocol_sha256",
    "sampling_frame_sha256",
    "target_failure_rate_millionths",
    "familywise_alpha_millionths",
    "strata",
    "calibration_items",
    "test_items",
    "plan_commitment_sha256"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.science_bench_refresh_imperfect_judge_certification_plan.v1"
    },
    "analyzer_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "purpose": {
      "enum": [
        "example_only",
        "qualified_run"
      ]
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "judge_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "judge_prompt_sha256": {
      "$ref": "#/$defs/digest"
    },
    "rubric_sha256": {
      "$ref": "#/$defs/digest"
    },
    "human_reference_protocol_sha256": {
      "$ref": "#/$defs/digest"
    },
    "sampling_frame_sha256": {
      "$ref": "#/$defs/digest"
    },
    "target_failure_rate_millionths": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999999
    },
    "familywise_alpha_millionths": {
      "type": "integer",
      "minimum": 1,
      "maximum": 499999
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/stratum"
      }
    },
    "calibration_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/calibration_item"
      }
    },
    "test_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "$ref": "#/$defs/test_item"
      }
    },
    "plan_commitment_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_family",
        "minimum_calibration_failure_items",
        "minimum_calibration_nonfailure_items",
        "minimum_test_items"
      ],
      "properties": {
        "task_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "minimum_calibration_failure_items": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100000
        },
        "minimum_calibration_nonfailure_items": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100000
        },
        "minimum_test_items": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000000
        }
      }
    },
    "calibration_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "task_family",
        "input_sha256",
        "reference_label",
        "reference_adjudication_sha256"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "task_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "input_sha256": {
          "$ref": "#/$defs/digest"
        },
        "reference_label": {
          "enum": [
            "failure",
            "non_failure"
          ]
        },
        "reference_adjudication_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "test_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "task_family",
        "input_sha256"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "task_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "input_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "qualified_run"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "properties": {
          "analyzer_source_revision": {
            "not": {
              "pattern": "^0{40}$"
            }
          },
          "judge_source_revision": {
            "not": {
              "pattern": "^0{40}$"
            }
          },
          "judge_prompt_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "rubric_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "human_reference_protocol_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "sampling_frame_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "plan_commitment_sha256": {
            "not": {
              "pattern": "^0{64}$"
            }
          },
          "calibration_items": {
            "items": {
              "properties": {
                "input_sha256": {
                  "not": {
                    "pattern": "^0{64}$"
                  }
                },
                "reference_adjudication_sha256": {
                  "not": {
                    "pattern": "^0{64}$"
                  }
                }
              }
            }
          },
          "test_items": {
            "items": {
              "properties": {
                "input_sha256": {
                  "not": {
                    "pattern": "^0{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
