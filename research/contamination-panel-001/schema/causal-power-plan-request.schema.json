{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/causal-power-plan-request-v1.json",
  "title": "Causal model-pair power and precision plan request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "study_id",
    "benchmark_id",
    "benchmark_version",
    "primary_estimand_id",
    "independent_unit",
    "alpha_permille",
    "test_tail",
    "multiplicity_policy",
    "contrast_count",
    "target_power_permille",
    "target_ci_half_width_permille",
    "max_gross_model_pair_replicates",
    "attrition_rates_permille",
    "items_per_pair_scenarios",
    "effect_scenarios"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.causal_power_plan_request.v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "primary_estimand_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "independent_unit": {
      "const": "independent_model_pair"
    },
    "alpha_permille": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "test_tail": {
      "type": "string",
      "enum": [
        "two_sided",
        "greater",
        "less"
      ]
    },
    "multiplicity_policy": {
      "type": "string",
      "enum": [
        "none",
        "bonferroni"
      ]
    },
    "contrast_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "target_power_permille": {
      "type": "integer",
      "minimum": 500,
      "maximum": 990
    },
    "target_ci_half_width_permille": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_gross_model_pair_replicates": {
      "type": "integer",
      "minimum": 2,
      "maximum": 500
    },
    "attrition_rates_permille": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 900
      }
    },
    "items_per_pair_scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      }
    },
    "effect_scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "true_effect_permille",
          "between_pair_sd_permille",
          "within_pair_item_sd_permille"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "true_effect_permille": {
            "type": "number"
          },
          "between_pair_sd_permille": {
            "type": "number",
            "minimum": 0
          },
          "within_pair_item_sd_permille": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
