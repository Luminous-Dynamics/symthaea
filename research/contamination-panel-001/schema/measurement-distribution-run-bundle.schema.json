{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/measurement-distribution-run-bundle-v1.json",
  "title": "Measurement-as-Distribution run bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_sha256",
    "instance_manifest",
    "instance_manifest_sha256",
    "models",
    "runs",
    "observations"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.measurement_distribution_run_bundle.v1"
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instance_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "benchmark_id",
        "benchmark_version",
        "instances"
      ],
      "properties": {
        "schema": {
          "const": "symthaea.measurement_distribution_instance_manifest.v1"
        },
        "benchmark_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "benchmark_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "instances": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "task_family",
              "source_cluster_id",
              "source_lineage_sha256"
            ],
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "task_family": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "source_cluster_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "source_lineage_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "instance_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "model_family_id",
          "model_checkpoint_sha256",
          "tokenizer_sha256"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "model_family_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "model_checkpoint_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "tokenizer_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "run_id",
          "independent_unit_id",
          "seed_commitment_sha256"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "independent_unit_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "seed_commitment_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "run_id",
          "independent_unit_id",
          "axis_id",
          "condition_id",
          "item_id",
          "task_family",
          "source_cluster_id",
          "decision",
          "validation_receipt_sha256",
          "perturbation_seed_commitment_sha256",
          "external_egress_receipt_sha256",
          "score",
          "runtime_milliseconds",
          "input_tokens",
          "output_tokens",
          "external_calls"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "independent_unit_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "axis_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "condition_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "task_family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "source_cluster_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "baseline",
              "validated",
              "rejected",
              "indeterminate",
              "fallback_applied",
              "execution_failed",
              "missing"
            ]
          },
          "validation_receipt_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "runtime_milliseconds": {
            "type": "integer",
            "minimum": 0
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "external_calls": {
            "type": "integer",
            "minimum": 0
          },
          "perturbation_seed_commitment_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "external_egress_receipt_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
