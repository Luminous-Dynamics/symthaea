{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/fresh-metamorphic-manifest-v1.json",
  "title": "Fresh metamorphic challenge manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "benchmark_id",
    "benchmark_version",
    "task_family",
    "model_checkpoint_sha256",
    "base_public_packet_sha256",
    "base_manifest_sha256",
    "base_sealed_oracle_sha256",
    "public_packet_sha256",
    "sealed_oracle_sha256",
    "transformation_rules_sha256",
    "transformation_source_sha256",
    "item_set_sha256",
    "group_count",
    "item_count",
    "forms_per_group",
    "manifest_sha256",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.fresh_metamorphic_manifest.v1"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "task_family": {
      "type": "string",
      "minLength": 1
    },
    "model_checkpoint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_public_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_sealed_oracle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "public_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sealed_oracle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transformation_rules_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "item_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "group_count": {
      "type": "integer",
      "minimum": 1
    },
    "item_count": {
      "type": "integer",
      "minimum": 5
    },
    "forms_per_group": {
      "const": 5
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "transformation_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
