{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/replicated-contamination-causal-study-v1.json",
  "title": "Replicated contamination causal study v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "study_id",
    "benchmark_id",
    "benchmark_version",
    "primary_metric_id",
    "primary_metric_definition_sha256",
    "minimum_confirmatory_replicates",
    "randomization_test_draws",
    "randomization_test_seed_hex",
    "replicates"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.replicated_contamination_causal_study.v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "primary_metric_id": {
      "type": "string",
      "minLength": 1
    },
    "primary_metric_definition_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "minimum_confirmatory_replicates": {
      "type": "integer",
      "minimum": 20
    },
    "randomization_test_draws": {
      "type": "integer",
      "minimum": 999,
      "maximum": 100000
    },
    "randomization_test_seed_hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2}){32,}$"
    },
    "replicates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "design",
          "manifest",
          "randomization_seed_hex",
          "training_receipt_audit",
          "training_receipt_audit_sha256",
          "evaluation_evidence",
          "cluster_outcomes"
        ],
        "properties": {
          "design": {
            "$ref": "https://luminousdynamics.org/schemas/randomized-contamination-intervention-design-v1.json"
          },
          "manifest": {
            "$ref": "https://luminousdynamics.org/schemas/randomized-contamination-intervention-manifest-v1.json"
          },
          "randomization_seed_hex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2}){32,}$"
          },
          "training_receipt_audit": {
            "$ref": "https://luminousdynamics.org/schemas/paired-training-execution-audit-v1.json"
          },
          "training_receipt_audit_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evaluation_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base_checkpoint_sha256",
              "treatment_checkpoint_sha256",
              "placebo_checkpoint_sha256",
              "base_evaluation_receipt_sha256",
              "treatment_evaluation_receipt_sha256",
              "placebo_evaluation_receipt_sha256",
              "metric_definition_sha256",
              "oracle_or_adjudication_sha256",
              "evaluation_harness_sha256",
              "prompt_and_decoding_sha256"
            ],
            "properties": {
              "base_checkpoint_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "treatment_checkpoint_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "placebo_checkpoint_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "base_evaluation_receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "treatment_evaluation_receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "placebo_evaluation_receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "metric_definition_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "oracle_or_adjudication_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "evaluation_harness_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "prompt_and_decoding_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "cluster_outcomes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cluster_id",
                "task_family",
                "assigned_to_exposure",
                "item_count",
                "evaluation_item_set_sha256",
                "base",
                "treatment",
                "placebo"
              ],
              "properties": {
                "cluster_id": {
                  "type": "string",
                  "minLength": 1
                },
                "task_family": {
                  "type": "string",
                  "minLength": 1
                },
                "assigned_to_exposure": {
                  "type": "boolean"
                },
                "item_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "evaluation_item_set_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "base": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "success_count",
                    "observed_count"
                  ],
                  "properties": {
                    "success_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "observed_count": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "treatment": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "success_count",
                    "observed_count"
                  ],
                  "properties": {
                    "success_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "observed_count": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "placebo": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "success_count",
                    "observed_count"
                  ],
                  "properties": {
                    "success_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "observed_count": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
