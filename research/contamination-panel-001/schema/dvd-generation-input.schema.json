{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/dvd-generation-input-v1.json",
  "title": "Symthaea DVD generation input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "item_id",
    "benchmark_id",
    "benchmark_version",
    "model_provider",
    "model_name",
    "model_version",
    "model_access_mode",
    "log_probability_semantics",
    "harness_revision_sha256",
    "prompt_sha256",
    "decoding_config_sha256",
    "environment_sha256",
    "temperature_milli",
    "requested_generation_count",
    "tail_token_count",
    "generation_seed_schedule_sha256",
    "generations"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.dvd_generation_input.v1"
    },
    "item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model_provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model_access_mode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "log_probability_semantics": {
      "const": "base_model_conditional_log_probability"
    },
    "harness_revision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prompt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "decoding_config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "environment_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "temperature_milli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000
    },
    "requested_generation_count": {
      "type": "integer",
      "minimum": 10,
      "maximum": 1000
    },
    "tail_token_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "generation_seed_schedule_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "generations": {
      "type": "array",
      "minItems": 10,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/generation"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "rng_seed_commitment_sha256",
        "generated_token_count",
        "response_token_log_probabilities"
      ],
      "properties": {
        "generation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rng_seed_commitment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generated_token_count": {
          "type": "integer",
          "minimum": 1
        },
        "response_token_log_probabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": -1000,
            "maximum": 0
          }
        }
      }
    }
  }
}
