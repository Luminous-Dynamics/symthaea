                "detectors": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "detector_id",
                      "detector_spec_sha256",
                      "direction",
                      "auroc",
                      "auprc",
                      "calibration_threshold_oriented",
                      "calibration_negative_count",
                      "calibration_false_positive_count",
                      "test_positive_count",
                      "test_negative_count",
                      "test_true_positive_count",
                      "test_false_positive_count",
