      "const": "symthaea.detector_fragility_report.v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "study_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_fpr_permille": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "independent_model_pair_replicate_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 1000
    },
    "pair_reports": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1000,
      "items": {
