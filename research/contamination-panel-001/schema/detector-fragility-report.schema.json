                },
                "checkpoint_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "parent_checkpoint_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "training_receipt_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "training_config_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "objective_config_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "training_data_manifest_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "optimizer_steps": {
                  "type": "integer",
