                        "properties": {
                          "lower_95": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "upper_95": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        }
                      },
                      "test_fpr_wilson_95": {
                        "type": "object",
