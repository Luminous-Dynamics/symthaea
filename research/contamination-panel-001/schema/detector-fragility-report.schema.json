  "$id": "https://luminousdynamics.org/schemas/detector-fragility-report-v1.json",
  "title": "Detector fragility report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "study_id",
    "benchmark_id",
    "benchmark_version",
    "study_sha256",
    "target_fpr_permille",
    "independent_model_pair_replicate_count",
    "pair_reports",
    "aggregate_interventions",
