              "type": "object",
              "additionalProperties": false,
              "required": [
                "stage",
                "checkpoint_sha256",
                "parent_checkpoint_sha256",
                "training_receipt_sha256",
                "training_config_sha256",
                "objective_config_sha256",
                "training_data_manifest_sha256",
                "optimizer_steps",
                "performance",
                "detectors"
