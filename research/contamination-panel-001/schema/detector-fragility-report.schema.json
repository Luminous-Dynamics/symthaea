                      "test_positive_count": {
                        "type": "integer",
                        "minimum": 100
                      },
                      "test_negative_count": {
                        "type": "integer",
                        "minimum": 300
                      },
                      "test_true_positive_count": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "test_false_positive_count": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "test_tpr_permille": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000
                      },
                      "test_fpr_permille": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000
