                    "nonmember_accuracy_permille": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "member_test_count": {
                      "type": "integer",
                      "minimum": 100
                    },
                    "nonmember_test_count": {
                      "type": "integer",
                      "minimum": 300
                    }
                  }
