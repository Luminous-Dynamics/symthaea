                        "sft_contaminated_then_grpo_clean",
                        "sft_clean_then_raft",
                        "sft_contaminated_then_raft",
                        "sft_clean_then_raft_plus_plus",
                        "sft_contaminated_then_raft_plus_plus",
                        "advanced_lrm_clean",
                        "advanced_lrm_cot_contaminated"
