                      "auroc": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "auprc": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "calibration_threshold_oriented": {
                        "type": "number"
                      },
                      "calibration_negative_count": {
                        "type": "integer",
                        "minimum": 300
                      },
                      "calibration_false_positive_count": {
