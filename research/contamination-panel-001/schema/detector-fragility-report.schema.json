                      "auroc_after": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "auroc_delta": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "signal_retention_permille": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "tpr_before_permille": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 1000
                      },
                      "tpr_after_permille": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000
                      },
                      "fpr_before_permille": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 1000
                      },
                      "fpr_after_permille": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000
                      },
                      "concealment_gap_permille": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
