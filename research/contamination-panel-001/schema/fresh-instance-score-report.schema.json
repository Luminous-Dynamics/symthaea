{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/fresh-instance-score-report-v1.json",
  "title": "Fresh benchmark exact-match score report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "metric_id",
    "run_id",
    "model_provider",
    "model_name",
    "model_version",
    "model_access_mode",
    "model_checkpoint_sha256",
    "batch_id",
    "benchmark_id",
    "benchmark_version",
    "task_family",
    "public_packet_sha256",
    "sealed_oracle_sha256",
    "manifest_sha256",
    "submission_sha256",
    "inference_harness_sha256",
    "prompt_and_decoding_sha256",
    "metric_definition_sha256",
    "run_execution_receipt_sha256",
    "item_count",
    "answered_count",
    "correct_count",
    "incorrect_count",
    "invalid_format_count",
    "abstained_count",
    "valid_format_response_count",
    "accuracy_over_all_permille",
    "coverage_permille",
    "accuracy_when_answered_permille",
    "accuracy_when_valid_format_permille",
    "model_call_count",
    "input_token_count",
    "output_token_count",
    "wall_clock_millis",
    "tool_call_count",
    "human_assistance_minutes",
    "compute_cost_microusd",
    "execution_receipt_verification",
    "independently_verified",
    "items",
    "report_sha256",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.fresh_instance_score_report.v1"
    },
    "metric_id": {
      "const": "fresh-exact-integer-pair.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "model_provider": {
      "type": "string",
      "minLength": 1
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "model_access_mode": {
      "type": "string",
      "minLength": 1
    },
    "model_checkpoint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "task_family": {
      "type": "string",
      "minLength": 1
    },
    "public_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sealed_oracle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "submission_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inference_harness_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_and_decoding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metric_definition_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_execution_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "item_count": {
      "type": "integer",
      "minimum": 1
    },
    "answered_count": {
      "type": "integer",
      "minimum": 0
    },
    "correct_count": {
      "type": "integer",
      "minimum": 0
    },
    "incorrect_count": {
      "type": "integer",
      "minimum": 0
    },
    "invalid_format_count": {
      "type": "integer",
      "minimum": 0
    },
    "abstained_count": {
      "type": "integer",
      "minimum": 0
    },
    "valid_format_response_count": {
      "type": "integer",
      "minimum": 0
    },
    "accuracy_over_all_permille": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "coverage_permille": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "accuracy_when_answered_permille": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000
    },
    "accuracy_when_valid_format_permille": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000
    },
    "model_call_count": {
      "type": "integer",
      "minimum": 1
    },
    "input_token_count": {
      "type": "integer",
      "minimum": 0
    },
    "output_token_count": {
      "type": "integer",
      "minimum": 0
    },
    "wall_clock_millis": {
      "type": "integer",
      "minimum": 1
    },
    "tool_call_count": {
      "type": "integer",
      "minimum": 0
    },
    "human_assistance_minutes": {
      "type": "integer",
      "minimum": 0
    },
    "compute_cost_microusd": {
      "type": "integer",
      "minimum": 0
    },
    "execution_receipt_verification": {
      "type": "string",
      "minLength": 1
    },
    "independently_verified": {
      "const": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "response_sha256",
          "status"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "response_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "correct",
              "incorrect",
              "invalid_format",
              "abstained"
            ]
          }
        }
      }
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
