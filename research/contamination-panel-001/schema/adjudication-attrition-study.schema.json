{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/adjudication-attrition-study-v1.json",
  "title": "Adjudication attrition study v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "study_id",
    "benchmark_id",
    "benchmark_version",
    "transfer_study_sha256",
    "candidate_manifest",
    "candidate_manifest_sha256",
    "adjudication_started_at_utc",
    "adjudications",
    "adjudication_report_sha256"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.adjudication_attrition_study.v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "transfer_study_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "study_id",
        "benchmark_id",
        "benchmark_version",
        "frozen_at_utc",
        "candidates"
      ],
      "properties": {
        "schema": {
          "const": "symthaea.adjudication_candidate_manifest.v1"
        },
        "study_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "benchmark_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "benchmark_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "frozen_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "task_family",
              "difficulty_band",
              "relation",
              "source_lineage_sha256",
              "recipe_lineage_sha256"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "task_family": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "difficulty_band": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "exact_replay",
                  "surface_variant",
                  "semantic_equivalent",
                  "fresh_same_recipe",
                  "novel_recipe_same_skill",
                  "unrelated_control"
                ]
              },
              "source_lineage_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "recipe_lineage_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adjudication_started_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "adjudications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "terminal_decision",
          "reason_code",
          "reviewer_ids",
          "agreement_permille",
          "decided_at_utc"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "terminal_decision": {
            "type": "string",
            "enum": [
              "accepted",
              "indeterminate",
              "rejected",
              "duplicate",
              "protocol_invalid"
            ]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "reviewer_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          },
          "agreement_permille": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000
          },
          "decided_at_utc": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        }
      }
    },
    "adjudication_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
