{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/fresh-metamorphic-public-packet-v1.json",
  "title": "Fresh metamorphic model-facing packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "benchmark_id",
    "benchmark_version",
    "task_family",
    "model_checkpoint_sha256",
    "base_public_packet_sha256",
    "base_manifest_sha256",
    "item_count",
    "group_count",
    "forms_per_group",
    "tasks",
    "public_packet_sha256",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.fresh_metamorphic_public_packet.v1"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "task_family": {
      "type": "string",
      "minLength": 1
    },
    "model_checkpoint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_public_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "item_count": {
      "type": "integer",
      "minimum": 5
    },
    "group_count": {
      "type": "integer",
      "minimum": 1
    },
    "forms_per_group": {
      "const": 5
    },
    "tasks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "group_id",
          "parent_item_id",
          "form",
          "task_text",
          "task_text_sha256"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "parent_item_id": {
            "type": "string",
            "minLength": 1
          },
          "form": {
            "type": "string",
            "enum": [
              "base",
              "swap_rows",
              "scale_first_row_by_two",
              "scale_second_row_by_negative_two",
              "swap_and_scale_rows"
            ]
          },
          "task_text": {
            "type": "string",
            "minLength": 1
          },
          "task_text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "public_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
