{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/codec-dataset-report-v1.json",
  "title": "CoDeC dataset score report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "implementation_id",
    "dataset_id",
    "dataset_version",
    "model_checkpoint_sha256",
    "tokenizer_sha256",
    "chat_template_sha256",
    "dataset_manifest_sha256",
    "dataset_item_set_sha256",
    "target_item_set_sha256",
    "context_policy_id",
    "context_policy_sha256",
    "inference_backend_id",
    "inference_receipt_sha256",
    "n_context_examples",
    "sampling_mode",
    "context_seed_count_per_target",
    "target_item_count",
    "target_token_count_total",
    "negative_delta_count",
    "codec_score_permille",
    "item_level_wilson_95",
    "mean_delta_nats_per_token",
    "standard_deviation_delta_across_items",
    "median_delta_nats_per_token",
    "per_item",
    "independently_authenticated",
    "confirmatory_eligible",
    "item_interval_assumes_independent_targets",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.codec_dataset_report.v1"
    },
    "implementation_id": {
      "const": "symthaea.codec.paper_faithful.v1"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "model_checkpoint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tokenizer_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chat_template_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset_item_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_item_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "context_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inference_backend_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "inference_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "n_context_examples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "sampling_mode": {
      "type": "string",
      "enum": [
        "single_seed_efficiency",
        "five_seed_paper_robustness",
        "multi_seed_sensitivity"
      ]
    },
    "context_seed_count_per_target": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "target_item_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "target_token_count_total": {
      "type": "integer",
      "minimum": 1
    },
    "negative_delta_count": {
      "type": "integer",
      "minimum": 0
    },
    "codec_score_permille": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "item_level_wilson_95": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower_95",
        "upper_95"
      ],
      "properties": {
        "lower_95": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "upper_95": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "mean_delta_nats_per_token": {
      "type": "number"
    },
    "standard_deviation_delta_across_items": {
      "type": "number",
      "minimum": 0
    },
    "median_delta_nats_per_token": {
      "type": "number"
    },
    "per_item": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "target_token_count",
          "baseline_mean_logprob_nats",
          "context_mean_logprob_nats",
          "mean_delta_nats_per_token",
          "per_seed_delta_nats_per_token",
          "negative_delta",
          "context_seed_count",
          "context_item_ids_by_seed"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "target_token_count": {
            "type": "integer",
            "minimum": 1
          },
          "baseline_mean_logprob_nats": {
            "type": "number",
            "maximum": 0
          },
          "context_mean_logprob_nats": {
            "type": "number",
            "maximum": 0
          },
          "mean_delta_nats_per_token": {
            "type": "number"
          },
          "per_seed_delta_nats_per_token": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "number"
            }
          },
          "negative_delta": {
            "type": "boolean"
          },
          "context_seed_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "context_item_ids_by_seed": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            }
          }
        }
      }
    },
    "independently_authenticated": {
      "const": false
    },
    "confirmatory_eligible": {
      "const": false
    },
    "item_interval_assumes_independent_targets": {
      "const": true
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
