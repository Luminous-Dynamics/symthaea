{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/exposure-transfer-study-v1.json",
  "title": "Causal exposure transfer study v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "study_id",
    "benchmark_id",
    "benchmark_version",
    "primary_metric_id",
    "primary_metric_definition_sha256",
    "relation_protocol_sha256",
    "evaluator_relation_manifest_sha256",
    "replicates"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.exposure_transfer_study.v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "primary_metric_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "primary_metric_definition_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relation_protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluator_relation_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replicates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/replicate"
      }
    }
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success_count",
        "observed_count"
      ],
      "properties": {
        "success_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "replicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicate_id",
        "evaluation_evidence_sha256",
        "training_receipt_audit_sha256",
        "strata"
      ],
      "properties": {
        "replicate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "evaluation_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "training_receipt_audit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "strata": {
          "type": "array",
          "minItems": 12,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/stratum"
          }
        }
      }
    },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_family",
        "difficulty_band",
        "relation",
        "cluster_count",
        "item_ids",
        "item_set_sha256",
        "source_lineage_manifest_sha256",
        "recipe_lineage_manifest_sha256",
        "adjudication_report_sha256",
        "base",
        "treatment",
        "placebo"
      ],
      "properties": {
        "task_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "difficulty_band": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "relation": {
          "type": "string",
          "enum": [
            "exact_replay",
            "surface_variant",
            "semantic_equivalent",
            "fresh_same_recipe",
            "novel_recipe_same_skill",
            "unrelated_control"
          ]
        },
        "cluster_count": {
          "type": "integer",
          "minimum": 1
        },
        "item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "item_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_lineage_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recipe_lineage_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adjudication_report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "base": {
          "$ref": "#/$defs/score"
        },
        "treatment": {
          "$ref": "#/$defs/score"
        },
        "placebo": {
          "$ref": "#/$defs/score"
        }
      }
    }
  }
}
