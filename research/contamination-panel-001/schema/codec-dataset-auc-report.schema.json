{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/codec-dataset-auc-report-v1.json",
  "title": "CoDeC dataset-level AUROC report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dataset_observation_count",
    "source_family_count",
    "exposed_dataset_count",
    "unexposed_dataset_count",
    "dataset_level_auroc",
    "dataset_level_auprc",
    "dataset_level_auroc_cluster_bootstrap_95",
    "dataset_level_auprc_cluster_bootstrap_95",
    "bootstrap_replicates_requested",
    "bootstrap_replicates_valid",
    "bootstrap_seed_commitment_sha256",
    "unit_of_analysis",
    "independently_authenticated",
    "confirmatory_eligible",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.codec_dataset_level_auc.v1"
    },
    "dataset_observation_count": {
      "type": "integer",
      "minimum": 2
    },
    "source_family_count": {
      "type": "integer",
      "minimum": 1
    },
    "exposed_dataset_count": {
      "type": "integer",
      "minimum": 1
    },
    "unexposed_dataset_count": {
      "type": "integer",
      "minimum": 1
    },
    "dataset_level_auroc": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "dataset_level_auprc": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "unit_of_analysis": {
      "const": "independent_dataset"
    },
    "independently_authenticated": {
      "const": false
    },
    "confirmatory_eligible": {
      "const": false
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "dataset_level_auroc_cluster_bootstrap_95": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lower_95",
            "upper_95"
          ],
          "properties": {
            "lower_95": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "upper_95": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "dataset_level_auprc_cluster_bootstrap_95": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lower_95",
            "upper_95"
          ],
          "properties": {
            "lower_95": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "upper_95": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "bootstrap_replicates_requested": {
      "const": 2000
    },
    "bootstrap_replicates_valid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000
    },
    "bootstrap_seed_commitment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
