{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/detector-calibration-study-v1.json",
  "title": "Detector calibration study v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "study_id",
    "benchmark_id",
    "benchmark_version",
    "target_fpr_permille",
    "detector_definitions",
    "calibration_groups",
    "observations"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.detector_calibration_study.v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "target_fpr_permille": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      }
    },
    "detector_definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "detector_id",
          "detector_version",
          "score_direction",
          "score_semantics"
        ],
        "properties": {
          "detector_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "detector_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "score_direction": {
            "type": "string",
            "enum": [
              "higher_means_contaminated",
              "lower_means_contaminated"
            ]
          },
          "score_semantics": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "calibration_groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "group_sha256",
          "identity"
        ],
        "properties": {
          "schema": {
            "const": "symthaea.detector_calibration_group.v1"
          },
          "group_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model_checkpoint_sha256",
              "tokenizer_sha256",
              "task_family",
              "language",
              "exposure_stage",
              "probe_config_sha256",
              "training_replicate_id"
            ],
            "properties": {
              "model_checkpoint_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "tokenizer_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "task_family": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:/-]+$"
              },
              "language": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:/-]+$"
              },
              "exposure_stage": {
                "type": "string",
                "enum": [
                  "pretraining",
                  "supervised_fine_tuning",
                  "reinforcement_learning_verifiable_reward",
                  "reinforcement_learning_human_feedback",
                  "search_time",
                  "unknown"
                ]
              },
              "probe_config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "training_replicate_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:/-]+$"
              }
            }
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "source_cluster_id",
          "calibration_group_sha256",
          "split",
          "ground_truth",
          "detector_id",
          "detector_version",
          "raw_score",
          "inference_calls",
          "input_tokens",
          "output_tokens",
          "wall_time_micros",
          "peak_memory_bytes"
        ],
        "properties": {
          "sample_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "source_cluster_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "calibration_group_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "split": {
            "type": "string",
            "enum": [
              "clean_calibration",
              "locked_test"
            ]
          },
          "ground_truth": {
            "type": "string",
            "enum": [
              "clean",
              "contaminated"
            ]
          },
          "detector_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "detector_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "raw_score": {
            "type": "number"
          },
          "inference_calls": {
            "type": "integer",
            "minimum": 0
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "wall_time_micros": {
            "type": "integer",
            "minimum": 0
          },
          "peak_memory_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
