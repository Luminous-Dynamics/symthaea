{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/retrieval-decomposition-corpus-v1.json",
  "title": "Retrieval decomposition sandbox corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "benchmark_version",
    "task",
    "documents",
    "corpus_sha256",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.retrieval_decomposition.corpus.v1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_family",
        "task_text",
        "response_contract"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "task_family": {
          "type": "string",
          "minLength": 1
        },
        "task_text": {
          "type": "string",
          "minLength": 1
        },
        "response_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "fields",
            "units"
          ],
          "properties": {
            "format": {
              "const": "json"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "units": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "source_family_id",
          "title",
          "body",
          "content_sha256",
          "body_utf8_bytes",
          "provenance"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "source_family_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "body_utf8_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
