{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/adjudication-attrition-report-v1.json",
  "title": "Adjudication attrition report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "study_id",
    "benchmark_id",
    "benchmark_version",
    "base_causal_study_sha256",
    "transfer_study_sha256",
    "candidate_manifest_sha256",
    "adjudication_report_sha256",
    "attrition_study_sha256",
    "independent_model_pair_replicate_count",
    "candidate_count",
    "accepted_count",
    "excluded_count",
    "overall_acceptance_rate_permille",
    "relation_reports",
    "cell_reports",
    "intervals_multiplicity_adjusted",
    "independently_authenticated",
    "confirmatory_eligible",
    "analysis_status",
    "issues",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.adjudication_attrition_report.v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "base_causal_study_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transfer_study_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adjudication_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "independent_model_pair_replicate_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 1000
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "accepted_count": {
      "type": "integer",
      "minimum": 0
    },
    "excluded_count": {
      "type": "integer",
      "minimum": 0
    },
    "overall_acceptance_rate_permille": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "relation_reports": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "candidate_count",
          "accepted_count",
          "indeterminate_count",
          "rejected_count",
          "duplicate_count",
          "protocol_invalid_count",
          "excluded_count",
          "acceptance_rate_permille",
          "family_macro_acceptance_rate_permille",
          "full_candidate_lower_effect_permille",
          "full_candidate_upper_effect_permille"
        ],
        "properties": {
          "relation": {
            "type": "string",
            "enum": [
              "exact_replay",
              "surface_variant",
              "semantic_equivalent",
              "fresh_same_recipe",
              "novel_recipe_same_skill",
              "unrelated_control"
            ]
          },
          "candidate_count": {
            "type": "integer",
            "minimum": 1
          },
          "accepted_count": {
            "type": "integer",
            "minimum": 0
          },
          "indeterminate_count": {
            "type": "integer",
            "minimum": 0
          },
          "rejected_count": {
            "type": "integer",
            "minimum": 0
          },
          "duplicate_count": {
            "type": "integer",
            "minimum": 0
          },
          "protocol_invalid_count": {
            "type": "integer",
            "minimum": 0
          },
          "excluded_count": {
            "type": "integer",
            "minimum": 0
          },
          "acceptance_rate_permille": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "family_macro_acceptance_rate_permille": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "full_candidate_lower_effect_permille": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mean",
              "standard_deviation_across_replicates",
              "standard_error",
              "confidence_level_permille",
              "lower_95",
              "upper_95"
            ],
            "properties": {
              "mean": {
                "type": "number"
              },
              "standard_deviation_across_replicates": {
                "type": "number",
                "minimum": 0
              },
              "standard_error": {
                "type": "number",
                "minimum": 0
              },
              "confidence_level_permille": {
                "const": 950
              },
              "lower_95": {
                "type": "number"
              },
              "upper_95": {
                "type": "number"
              }
            }
          },
          "full_candidate_upper_effect_permille": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mean",
              "standard_deviation_across_replicates",
              "standard_error",
              "confidence_level_permille",
              "lower_95",
              "upper_95"
            ],
            "properties": {
              "mean": {
                "type": "number"
              },
              "standard_deviation_across_replicates": {
                "type": "number",
                "minimum": 0
              },
              "standard_error": {
                "type": "number",
                "minimum": 0
              },
              "confidence_level_permille": {
                "const": 950
              },
              "lower_95": {
                "type": "number"
              },
              "upper_95": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "cell_reports": {
      "type": "array",
      "minItems": 12,
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_family",
          "difficulty_band",
          "relation",
          "candidate_count",
          "accepted_count",
          "indeterminate_count",
          "rejected_count",
          "duplicate_count",
          "protocol_invalid_count",
          "excluded_count",
          "acceptance_rate_permille",
          "adjudication_agreement_mean_permille",
          "accepted_subset_effect_permille",
          "full_candidate_lower_effect_permille",
          "full_candidate_upper_effect_permille",
          "per_replicate_bounds"
        ],
        "properties": {
          "task_family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "difficulty_band": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "relation": {
            "type": "string",
            "enum": [
              "exact_replay",
              "surface_variant",
              "semantic_equivalent",
              "fresh_same_recipe",
              "novel_recipe_same_skill",
              "unrelated_control"
            ]
          },
          "candidate_count": {
            "type": "integer",
            "minimum": 1
          },
          "accepted_count": {
            "type": "integer",
            "minimum": 0
          },
          "indeterminate_count": {
            "type": "integer",
            "minimum": 0
          },
          "rejected_count": {
            "type": "integer",
            "minimum": 0
          },
          "duplicate_count": {
            "type": "integer",
            "minimum": 0
          },
          "protocol_invalid_count": {
            "type": "integer",
            "minimum": 0
          },
          "excluded_count": {
            "type": "integer",
            "minimum": 0
          },
          "acceptance_rate_permille": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "adjudication_agreement_mean_permille": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000
          },
          "accepted_subset_effect_permille": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mean",
                  "standard_deviation_across_replicates",
                  "standard_error",
                  "confidence_level_permille",
                  "lower_95",
                  "upper_95"
                ],
                "properties": {
                  "mean": {
                    "type": "number"
                  },
                  "standard_deviation_across_replicates": {
                    "type": "number",
                    "minimum": 0
                  },
                  "standard_error": {
                    "type": "number",
                    "minimum": 0
                  },
                  "confidence_level_permille": {
                    "const": 950
                  },
                  "lower_95": {
                    "type": "number"
                  },
                  "upper_95": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "full_candidate_lower_effect_permille": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mean",
              "standard_deviation_across_replicates",
              "standard_error",
              "confidence_level_permille",
              "lower_95",
              "upper_95"
            ],
            "properties": {
              "mean": {
                "type": "number"
              },
              "standard_deviation_across_replicates": {
                "type": "number",
                "minimum": 0
              },
              "standard_error": {
                "type": "number",
                "minimum": 0
              },
              "confidence_level_permille": {
                "const": 950
              },
              "lower_95": {
                "type": "number"
              },
              "upper_95": {
                "type": "number"
              }
            }
          },
          "full_candidate_upper_effect_permille": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mean",
              "standard_deviation_across_replicates",
              "standard_error",
              "confidence_level_permille",
              "lower_95",
              "upper_95"
            ],
            "properties": {
              "mean": {
                "type": "number"
              },
              "standard_deviation_across_replicates": {
                "type": "number",
                "minimum": 0
              },
              "standard_error": {
                "type": "number",
                "minimum": 0
              },
              "confidence_level_permille": {
                "const": 950
              },
              "lower_95": {
                "type": "number"
              },
              "upper_95": {
                "type": "number"
              }
            }
          },
          "per_replicate_bounds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "replicate_id",
                "accepted_subset_effect_permille",
                "full_candidate_lower_effect_permille",
                "full_candidate_upper_effect_permille"
              ],
              "properties": {
                "replicate_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "accepted_subset_effect_permille": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": -1000,
                  "maximum": 1000
                },
                "full_candidate_lower_effect_permille": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "full_candidate_upper_effect_permille": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                }
              }
            }
          }
        }
      }
    },
    "independently_authenticated": {
      "const": false
    },
    "confirmatory_eligible": {
      "const": false
    },
    "analysis_status": {
      "const": "exploratory_partial_identification"
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "attrition_study_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intervals_multiplicity_adjusted": {
      "const": false
    }
  }
}
