{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/policy-rigidity-controls-report-v1.json",
  "title": "Matched policy rigidity controls report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "method_id",
    "study_id",
    "benchmark_id",
    "benchmark_version",
    "model_regime",
    "model_checkpoint_sha256",
    "tokenizer_sha256",
    "prompt_harness_sha256",
    "runtime_environment_sha256",
    "calibration_protocol_sha256",
    "probe_registry_sha256",
    "request_sha256",
    "clean_control_manifest_sha256",
    "evaluation_manifest_sha256",
    "target_alpha_permille",
    "multiple_testing_method",
    "fdr_control_conditional_on_exchangeability",
    "evaluation_unit_count",
    "flagged_count",
    "no_flag_count",
    "abstained_count",
    "score_rows",
    "group_summaries",
    "independently_authenticated",
    "confirmatory_eligible",
    "analysis_status",
    "assumptions",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.policy_rigidity_controls_report.v1"
    },
    "method_id": {
      "const": "matched_clean_control_empirical_ranks_by_v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "model_regime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "model_checkpoint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tokenizer_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_harness_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_environment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calibration_protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "probe_registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "clean_control_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluation_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_alpha_permille": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "multiple_testing_method": {
      "const": "benjamini_yekutieli"
    },
    "fdr_control_conditional_on_exchangeability": {
      "const": true
    },
    "evaluation_unit_count": {
      "type": "integer",
      "minimum": 1
    },
    "flagged_count": {
      "type": "integer",
      "minimum": 0
    },
    "no_flag_count": {
      "type": "integer",
      "minimum": 0
    },
    "abstained_count": {
      "type": "integer",
      "minimum": 0
    },
    "score_rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evaluation_unit_id",
          "task_family",
          "difficulty_band",
          "path_multiplicity",
          "exposure_label",
          "baseline_mean_entropy_nats",
          "global_path_rigidity_score",
          "response_conditioned_excess",
          "global_entropy_lower_tail_p",
          "global_rigidity_upper_tail_p",
          "response_conditioned_excess_upper_tail_p",
          "by_adjusted_excess_p",
          "by_family_size",
          "minimum_clean_rank_p_value",
          "decision",
          "pattern"
        ],
        "properties": {
          "evaluation_unit_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "task_family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "difficulty_band": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "path_multiplicity": {
            "type": "string",
            "enum": [
              "single_or_few_valid_paths",
              "multiple_valid_paths",
              "indeterminate"
            ]
          },
          "exposure_label": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "known_clean",
                  "known_exposed",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "baseline_mean_entropy_nats": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "global_path_rigidity_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "response_conditioned_excess": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -1,
            "maximum": 1
          },
          "global_entropy_lower_tail_p": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "global_rigidity_upper_tail_p": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "response_conditioned_excess_upper_tail_p": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "by_adjusted_excess_p": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "by_family_size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "minimum_clean_rank_p_value": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "decision": {
            "type": "string",
            "enum": [
              "flag_response_conditioned_excess",
              "no_response_conditioned_excess_flag",
              "abstain_indeterminate_path_multiplicity",
              "abstain_unsupported_clean_control_group",
              "abstain_insufficient_calibration_resolution"
            ]
          },
          "pattern": {
            "type": "string",
            "enum": [
              "broad_policy_rigidity",
              "task_or_path_rigidity",
              "response_conditioned_specificity",
              "no_marked_rigidity_pattern",
              "insufficient_evidence"
            ]
          }
        }
      }
    },
    "group_summaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_family",
          "difficulty_band",
          "path_multiplicity",
          "clean_control_unit_count",
          "evaluation_unit_count",
          "eligible_unit_count",
          "flagged_response_conditioned_excess_count",
          "no_flag_count",
          "abstained_count",
          "known_clean_count",
          "known_exposed_count",
          "false_positive_count",
          "true_positive_count",
          "false_negative_count",
          "empirical_fpr_permille",
          "empirical_tpr_permille",
          "decision_coverage_permille",
          "minimum_clean_rank_p_value",
          "target_alpha_permille"
        ],
        "properties": {
          "task_family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "difficulty_band": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "path_multiplicity": {
            "type": "string",
            "enum": [
              "single_or_few_valid_paths",
              "multiple_valid_paths",
              "indeterminate"
            ]
          },
          "clean_control_unit_count": {
            "type": "integer",
            "minimum": 0
          },
          "evaluation_unit_count": {
            "type": "integer",
            "minimum": 1
          },
          "eligible_unit_count": {
            "type": "integer",
            "minimum": 0
          },
          "flagged_response_conditioned_excess_count": {
            "type": "integer",
            "minimum": 0
          },
          "no_flag_count": {
            "type": "integer",
            "minimum": 0
          },
          "abstained_count": {
            "type": "integer",
            "minimum": 0
          },
          "known_clean_count": {
            "type": "integer",
            "minimum": 0
          },
          "known_exposed_count": {
            "type": "integer",
            "minimum": 0
          },
          "false_positive_count": {
            "type": "integer",
            "minimum": 0
          },
          "true_positive_count": {
            "type": "integer",
            "minimum": 0
          },
          "false_negative_count": {
            "type": "integer",
            "minimum": 0
          },
          "empirical_fpr_permille": {
            "type": [
              "number",
              "null"
            ]
          },
          "empirical_tpr_permille": {
            "type": [
              "number",
              "null"
            ]
          },
          "decision_coverage_permille": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "minimum_clean_rank_p_value": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "target_alpha_permille": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        }
      }
    },
    "independently_authenticated": {
      "const": false
    },
    "confirmatory_eligible": {
      "const": false
    },
    "analysis_status": {
      "const": "exploratory_matched_control_decomposition"
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
