{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "procedure-proposal-v0.1.schema.json",
  "title": "MACE Procedure Proposal v0.1 (untrusted candidate output)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "skill_name",
    "summary",
    "objective",
    "task_family",
    "scope",
    "created_at_utc",
    "applicability",
    "required_permissions",
    "steps",
    "postconditions",
    "failure_modes",
    "source_traces"
  ],
  "properties": {
    "schema_version": {
      "const": "mace_procedure_proposal_v0_1"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "skill_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "task_family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "purpose"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_constraints",
        "positive_conditions",
        "excluded_conditions"
      ],
      "properties": {
        "environment_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "positive_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "excluded_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supported_platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dependency_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "action",
          "purpose",
          "preconditions",
          "inputs",
          "expected_observations",
          "declared_effects",
          "failure_policy",
          "source_event_refs"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value_type",
                "required"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value_type": {
                  "enum": [
                    "string",
                    "integer",
                    "number",
                    "boolean",
                    "object",
                    "array",
                    "opaque_reference"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "expected_observations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "declared_effects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "read",
                "write",
                "delete",
                "execute",
                "network",
                "financial",
                "publish",
                "access_secret",
                "modify_access",
                "other"
              ]
            }
          },
          "failure_policy": {
            "enum": [
              "abort",
              "retry_bounded",
              "escalate",
              "rollback",
              "abstain"
            ]
          },
          "source_event_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "compensation_action": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "postconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition",
          "safe_response"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "safe_response": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "source_traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trace_id",
          "trace_digest_sha256",
          "event_ids"
        ],
        "properties": {
          "trace_id": {
            "type": "string",
            "minLength": 1
          },
          "trace_digest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "event_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "environment_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "runtime_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "repository_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolchain_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "rollback_suggestion": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "export_formats": {
      "type": "array",
      "items": {
        "enum": [
          "agentskills-skill-md",
          "mace-procedure-json"
        ]
      },
      "uniqueItems": true
    }
  }
}
