{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/symmetry-discovery-benchmark-001/schemas/proposal_submission.schema.json",
  "title": "Symmetry benchmark external proposal submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_track",
    "split",
    "method",
    "predictions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "LUMINOUS-SYMM-QUALIFIED-DISCOVERY-001"
    },
    "benchmark_track": {
      "enum": [
        "exact_finite_structural_stabilizer",
        "finite_reference_group_regression_discovery"
      ]
    },
    "split": {
      "enum": [
        "discovery",
        "calibration",
        "final_holdout"
      ]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "source_revision",
        "configuration_digest_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "disposition"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "predicted",
              "abstained"
            ]
          },
          "proposed_elements": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "abstention_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "predicted"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "required": [
                "proposed_elements"
              ],
              "properties": {
                "proposed_elements": {
                  "minItems": 1
                },
                "abstention_reason": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "abstained"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "required": [
                "abstention_reason"
              ],
              "properties": {
                "proposed_elements": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    }
  }
}
