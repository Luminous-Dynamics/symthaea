{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/symmetry-discovery-benchmark-001/schemas/symfp_nonidentifiability.schema.json",
  "title": "SymFP leakage non-identifiability regression fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "source",
    "degree_window",
    "regularization",
    "semantics",
    "cases",
    "benchmark_rule",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "fixture_id": {
      "const": "SYMFP-RANK-COMPATIBILITY-NONIDENTIFIABILITY-001"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "arxiv_id",
        "version",
        "submitted",
        "location",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "arxiv_id": {
          "const": "2611.07410"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "submitted": {
          "const": "2026-11-05"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "degree_window": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9
      },
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true
    },
    "regularization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epsilon_norm",
        "epsilon_log",
        "expected_p_ls_when_exact_zero_leakage"
      ],
      "properties": {
        "epsilon_norm": {
          "const": 1e-10
        },
        "epsilon_log": {
          "const": 1e-10
        },
        "expected_p_ls_when_exact_zero_leakage": {
          "const": 10
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spectral_leakage",
        "rank_template_match",
        "exact_group_truth",
        "authority"
      ],
      "properties": {
        "spectral_leakage": {
          "type": "string",
          "minLength": 1
        },
        "rank_template_match": {
          "type": "string",
          "minLength": 1
        },
        "exact_group_truth": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "source_reported",
          "actual_point_group",
          "leakage_target_group",
          "actual_representation_rank_sequence",
          "target_fixed_subspace_dimension_sequence",
          "expected_pooled_leakage_score",
          "expected_p_ls",
          "expected_full_rank_template_match",
          "target_group_is_actual",
          "must_not_infer_target_group_from_zero_leakage"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "source_reported": {
            "const": true
          },
          "actual_point_group": {
            "type": "string",
            "minLength": 1
          },
          "leakage_target_group": {
            "type": "string",
            "minLength": 1
          },
          "actual_representation_rank_sequence": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 10,
            "maxItems": 10
          },
          "target_fixed_subspace_dimension_sequence": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 10,
            "maxItems": 10
          },
          "expected_pooled_leakage_score": {
            "const": 0
          },
          "expected_p_ls": {
            "const": 10
          },
          "expected_full_rank_template_match": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "target_group_is_actual": {
            "const": false
          },
          "must_not_infer_target_group_from_zero_leakage": {
            "const": true
          }
        }
      }
    },
    "benchmark_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count_false_target_promotion",
        "retain_distinct_metrics",
        "no_pruning_from_spectral_score"
      ],
      "properties": {
        "count_false_target_promotion": {
          "type": "string",
          "minLength": 1
        },
        "retain_distinct_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "no_pruning_from_spectral_score": {
          "const": true
        }
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
