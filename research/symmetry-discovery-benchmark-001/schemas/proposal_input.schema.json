{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/symmetry-discovery-benchmark-001/schemas/proposal_input.schema.json",
  "title": "Finite-group symmetry proposal input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "execution_id",
    "split",
    "benchmark_track",
    "method",
    "proposals"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "LUMINOUS-SYMM-QUALIFIED-DISCOVERY-001"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "discovery",
        "calibration",
        "final_holdout",
        "fixture_sanity"
      ]
    },
    "benchmark_track": {
      "enum": [
        "exact_finite_structural_stabilizer",
        "finite_reference_group_regression_discovery"
      ]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "source_revision",
        "configuration_digest_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "proposed_subgroup_ids"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "proposed_subgroup_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
