{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/approximate-symmetry-envelope-001/fixtures/v0.1.schema.json",
  "title": "Approximate symmetry error envelope fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "scale",
    "units",
    "example",
    "claim_boundary",
    "affine_oracle_example"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "const": "approximate-symmetry-error-envelope-v0.1"
    },
    "scale": {
      "type": "integer",
      "minimum": 1
    },
    "units": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "initial_state_error",
        "one_step_equivariance_defect",
        "step_lipschitz_scaled",
        "horizon_steps",
        "domain_invariance_verified",
        "domain_boundary_margin",
        "objective_lipschitz_scaled",
        "direct_objective_defect",
        "constraint_lipschitz_scaled",
        "direct_constraint_defect",
        "constraint_slack",
        "max_state_error",
        "max_objective_error",
        "max_constraint_error",
        "objective_gap",
        "expected_upper_bounds",
        "expected_epsilon_lift_candidate",
        "expected_hard_prune_authorized",
        "state_unit_id",
        "objective_unit_id",
        "constraint_unit_id",
        "defect_evidence_id",
        "lipschitz_evidence_id",
        "domain_evidence_id"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "initial_state_error": {
          "type": "integer",
          "minimum": 0
        },
        "one_step_equivariance_defect": {
          "type": "integer",
          "minimum": 0
        },
        "step_lipschitz_scaled": {
          "type": "integer",
          "minimum": 0
        },
        "horizon_steps": {
          "type": "integer",
          "minimum": 0
        },
        "domain_invariance_verified": {
          "type": "boolean"
        },
        "domain_boundary_margin": {
          "type": "integer",
          "minimum": 0
        },
        "objective_lipschitz_scaled": {
          "type": "integer",
          "minimum": 0
        },
        "direct_objective_defect": {
          "type": "integer",
          "minimum": 0
        },
        "constraint_lipschitz_scaled": {
          "type": "integer",
          "minimum": 0
        },
        "direct_constraint_defect": {
          "type": "integer",
          "minimum": 0
        },
        "constraint_slack": {
          "type": "integer",
          "minimum": 0
        },
        "max_state_error": {
          "type": "integer",
          "minimum": 0
        },
        "max_objective_error": {
          "type": "integer",
          "minimum": 0
        },
        "max_constraint_error": {
          "type": "integer",
          "minimum": 0
        },
        "objective_gap": {
          "type": "integer",
          "minimum": 0
        },
        "expected_upper_bounds": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "expected_epsilon_lift_candidate": {
          "type": "boolean"
        },
        "expected_hard_prune_authorized": {
          "const": false
        },
        "state_unit_id": {
          "type": "string",
          "minLength": 1
        },
        "objective_unit_id": {
          "type": "string",
          "minLength": 1
        },
        "constraint_unit_id": {
          "type": "string",
          "minLength": 1
        },
        "defect_evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "lipschitz_evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "domain_evidence_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "affine_oracle_example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "step_map",
        "action",
        "reference_region",
        "certificate_domain",
        "expected",
        "claim_boundary"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "step_map": {
          "$ref": "#/$defs/affineMap"
        },
        "action": {
          "allOf": [
            {
              "$ref": "#/$defs/affineMap"
            },
            {
              "type": "object",
              "required": [
                "order"
              ],
              "properties": {
                "order": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                }
              }
            }
          ]
        },
        "reference_region": {
          "$ref": "#/$defs/box2"
        },
        "certificate_domain": {
          "$ref": "#/$defs/box2"
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "one_step_equivariance_defect_linf",
            "step_lipschitz_linf",
            "domain_boundary_margin_linf",
            "reference_region_invariant",
            "action_has_declared_finite_order"
          ],
          "properties": {
            "one_step_equivariance_defect_linf": {
              "type": "integer",
              "minimum": 0
            },
            "step_lipschitz_linf": {
              "type": "integer",
              "minimum": 0
            },
            "domain_boundary_margin_linf": {
              "type": "integer",
              "minimum": 0
            },
            "reference_region_invariant": {
              "const": true
            },
            "action_has_declared_finite_order": {
              "const": true
            }
          }
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "matrix2Integer": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer"
        }
      }
    },
    "vector2Integer": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer"
      }
    },
    "affineMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix",
        "offset"
      ],
      "properties": {
        "matrix": {
          "$ref": "#/$defs/matrix2Integer"
        },
        "offset": {
          "$ref": "#/$defs/vector2Integer"
        }
      }
    },
    "box2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper"
      ],
      "properties": {
        "lower": {
          "$ref": "#/$defs/vector2Integer"
        },
        "upper": {
          "$ref": "#/$defs/vector2Integer"
        }
      }
    }
  }
}
