{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/research/ig-coord-select-001/COORD_SELECT_FIXTURES_V0_1.schema.json",
  "title": "IG-COORD-SELECT-001 fixture set v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "fixtures"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol_id": {
      "const": "IG-COORD-SELECT-001"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_id",
        "quality_mean_milli",
        "quality_lower_milli",
        "quality_upper_milli",
        "token_cost",
        "latency_ms",
        "risk_milli",
        "calibration_blocks",
        "out_of_distribution",
        "available"
      ],
      "properties": {
        "architecture_id": {
          "type": "string",
          "minLength": 1
        },
        "quality_mean_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "quality_lower_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "quality_upper_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "token_cost": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "risk_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "calibration_blocks": {
          "type": "integer",
          "minimum": 0
        },
        "out_of_distribution": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_calibration_blocks",
        "max_quality_interval_width_milli",
        "min_robust_quality_gain_milli",
        "min_robust_net_utility_gain_milli",
        "token_penalty_milli_per_1000",
        "latency_penalty_milli_per_second",
        "risk_penalty_milli_per_1000"
      ],
      "properties": {
        "min_calibration_blocks": {
          "type": "integer",
          "minimum": 1
        },
        "max_quality_interval_width_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "min_robust_quality_gain_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "min_robust_net_utility_gain_milli": {
          "type": "integer"
        },
        "token_penalty_milli_per_1000": {
          "type": "integer",
          "minimum": 0
        },
        "latency_penalty_milli_per_second": {
          "type": "integer",
          "minimum": 0
        },
        "risk_penalty_milli_per_1000": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "selectorInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_decomposability",
        "sequential_coupling",
        "latent_information_asymmetry",
        "distribution_shift",
        "single_agent",
        "candidate_architectures",
        "policy"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "task_decomposability": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "sequential_coupling": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "latent_information_asymmetry": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "distribution_shift": {
          "type": "boolean"
        },
        "single_agent": {
          "$ref": "#/$defs/estimate"
        },
        "candidate_architectures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/estimate"
          }
        },
        "policy": {
          "$ref": "#/$defs/policy"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "selected_architecture_id",
        "reason",
        "robust_net_gain_milli"
      ],
      "properties": {
        "decision": {
          "enum": [
            "SELECT",
            "SINGLE",
            "CALIBRATE"
          ]
        },
        "selected_architecture_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "robust_net_gain_milli": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input",
        "evaluation_only",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "#/$defs/selectorInput"
        },
        "evaluation_only": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "oracle_architecture_id",
            "realized_quality_milli_by_architecture"
          ],
          "properties": {
            "oracle_architecture_id": {
              "type": "string",
              "minLength": 1
            },
            "realized_quality_milli_by_architecture": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            }
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    }
  }
}
