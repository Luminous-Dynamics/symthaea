    },
    {
      "policy_id": "P1_FIXED_SOLIDARITY",
      "name": "Fixed solidarity transfer",
      "controller": "request north-to-south transfer each tick",
      "request_per_tick": {
        "water_m3": 60,
        "energy_kwh": 250,
        "food_kg": 80
      },
      "ledger_transfer_policy": "unrestricted",
      "description": "A predeclared constant transfer is made every tick, regardless of observed deficits."
    },
    {
      "policy_id": "P2_ADAPTIVE_SERVICE_DEFICIT",
      "name": "Adaptive essential-service deficit",
      "controller": "current-tick-deficit-with-donor-buffer",
      "donor_region": "synthetic_north",
      "receiver_region": "synthetic_south",
      "donor_buffer_ticks": 0.5,
      "formula": {
        "receiver_deficit": "max(0, receiver_essential_demand - receiver_opening_stock - receiver_production)",
        "donor_surplus": "max(0, donor_opening_stock + donor_production - donor_essential_demand * (1 + donor_buffer_ticks))",
        "transfer": "componentwise_min(receiver_deficit, donor_surplus)"
      },
      "ledger_transfer_policy": "unrestricted",
      "description": "Transfer only the receiver's current-tick essential-service deficit, bounded by donor stock after its own demand and a half-tick reserve buffer."
    }
  ],
