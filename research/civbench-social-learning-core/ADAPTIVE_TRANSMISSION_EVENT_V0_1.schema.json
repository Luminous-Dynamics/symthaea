{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.luminousdynamics.org/civbench/adaptive-transmission-event/0.1",
  "title": "Adaptive Transmission Event v0.1",
  "description": "Cross-project event envelope referencing existing skill-capsule, evidence and model-run contracts. Structural validity is not claim truth or authorization.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_time",
    "task",
    "sender_ref",
    "recipient_ref",
    "payload",
    "program",
    "recipient_state_basis",
    "consent",
    "route",
    "budget",
    "lifecycle",
    "evidence_refs",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "task": {
      "type": "object",
      "required": [
        "task_family_id",
        "task_version",
        "environment_digest"
      ],
      "properties": {
        "task_family_id": {
          "type": "string",
          "minLength": 1
        },
        "task_version": {
          "type": "string",
          "minLength": 1
        },
        "environment_digest": {
          "type": "string",
          "pattern": "^sha-256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "sender_ref": {
      "type": "string",
      "minLength": 1
    },
    "recipient_ref": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "payload_kind",
        "object_ref",
        "content_digest",
        "scope_ref"
      ],
      "properties": {
        "payload_kind": {
          "enum": [
            "positive_skill",
            "negative_result",
            "correction",
            "request",
            "contextual_warning"
          ]
        },
        "object_ref": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha-256:[a-f0-9]{64}$"
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "supersedes_event_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licence_or_custody_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "program": {
      "type": "object",
      "required": [
        "program_id",
        "program_version",
        "program_digest",
        "program_class",
        "decision_reason_codes"
      ],
      "properties": {
        "program_id": {
          "type": "string",
          "minLength": 1
        },
        "program_version": {
          "type": "string",
          "minLength": 1
        },
        "program_digest": {
          "type": "string",
          "pattern": "^sha-256:[a-f0-9]{64}$"
        },
        "program_class": {
          "enum": [
            "fixed_schedule",
            "random",
            "state_aware_heuristic",
            "bounded_dsl",
            "evolved_program",
            "receiver_pull",
            "federated_match"
          ]
        },
        "decision_reason_codes": {
          "type": "array",
          "items": {
            "enum": [
              "recipient_missing_prerequisite",
              "recipient_task_need",
              "collective_novelty",
              "downstream_unlock",
              "correction",
              "peer_request",
              "redundancy_avoidance",
              "fixed_schedule",
              "random_control",
              "other"
            ]
          }
        },
        "feature_schema_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "recipient_state_basis": {
      "type": "object",
      "required": [
        "disclosure_mode",
        "feature_schema_ref",
        "signal_ref",
        "consent_required"
      ],
      "properties": {
        "disclosure_mode": {
          "enum": [
            "none",
            "recipient_pull",
            "coarse_need_signal",
            "federated_match",
            "centralized_full_state"
          ]
        },
        "feature_schema_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "signal_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "consent_required": {
          "type": "boolean"
        },
        "expiry": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "consent": {
      "type": "object",
      "required": [
        "consent_status",
        "consent_or_mandate_ref",
        "sharing_scope"
      ],
      "properties": {
        "consent_status": {
          "enum": [
            "not_required_fixed_control",
            "granted",
            "denied",
            "withdrawn",
            "expired",
            "unknown"
          ]
        },
        "consent_or_mandate_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "sharing_scope": {
          "enum": [
            "experiment_only",
            "community_scope",
            "federation_scope",
            "public",
            "restricted_custody",
            "unknown"
          ]
        },
        "custodian_restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": [
        "channel",
        "schedule_index",
        "route_class"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "schedule_index": {
          "type": "integer",
          "minimum": 0
        },
        "route_class": {
          "enum": [
            "peer",
            "mediated",
            "broadcast",
            "pull",
            "federated",
            "local"
          ]
        },
        "sender_group_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "receiver_group_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": [
        "message_units",
        "attention_units",
        "compute_units"
      ],
      "properties": {
        "message_units": {
          "type": "number",
          "minimum": 0
        },
        "attention_units": {
          "type": "number",
          "minimum": 0
        },
        "compute_units": {
          "type": "number",
          "minimum": 0
        },
        "unit_profile_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "scheduled",
        "authorization_status",
        "delivery_status",
        "observation_status",
        "acquisition_status",
        "integration_status",
        "execution_status",
        "retention_status",
        "transfer_status"
      ],
      "properties": {
        "scheduled": {
          "type": "boolean"
        },
        "authorization_status": {
          "enum": [
            "not_checked",
            "authorized",
            "blocked",
            "revoked",
            "unknown"
          ]
        },
        "delivery_status": {
          "enum": [
            "not_attempted",
            "delivered",
            "failed",
            "unknown",
            "not_applicable"
          ]
        },
        "observation_status": {
          "enum": [
            "not_measured",
            "observed",
            "not_observed",
            "unknown",
            "not_applicable"
          ]
        },
        "acquisition_status": {
          "enum": [
            "not_measured",
            "acquired",
            "not_acquired",
            "unknown",
            "not_applicable"
          ]
        },
        "integration_status": {
          "enum": [
            "not_measured",
            "integrated",
            "not_integrated",
            "unknown",
            "not_applicable"
          ]
        },
        "execution_status": {
          "enum": [
            "not_attempted",
            "succeeded",
            "failed",
            "unknown",
            "not_applicable"
          ]
        },
        "retention_status": {
          "enum": [
            "not_measured",
            "retained",
            "lost",
            "unknown",
            "not_applicable"
          ]
        },
        "correction_status": {
          "enum": [
            "not_reviewed",
            "accepted",
            "corrected",
            "rejected",
            "disputed",
            "unknown",
            "not_applicable"
          ]
        },
        "transfer_status": {
          "enum": [
            "not_tested",
            "transferred",
            "not_transferred",
            "unknown",
            "not_applicable"
          ]
        },
        "outcome_receipt_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parent_event_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
