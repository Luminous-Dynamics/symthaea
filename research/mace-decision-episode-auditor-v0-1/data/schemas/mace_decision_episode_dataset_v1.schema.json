{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mace-decision-episode-dataset-v1.schema.json",
  "title": "MACE Decision Episode Dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest", "pairs"],
  "properties": {
    "schema_version": { "const": "mace.decision-episode-dataset.v1" },
    "manifest": { "$ref": "#/$defs/manifest" },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pair" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_id",
        "benchmark_revision",
        "adapter_revision",
        "harness_revision_sha256",
        "split_sha256",
        "protocol_sha256",
        "bootstrap_seed",
        "bootstrap_resamples"
      ],
      "properties": {
        "benchmark_id": { "$ref": "#/$defs/identifier" },
        "benchmark_revision": { "$ref": "#/$defs/identifier" },
        "adapter_revision": { "$ref": "#/$defs/identifier" },
        "harness_revision_sha256": { "$ref": "#/$defs/sha256" },
        "split_sha256": { "$ref": "#/$defs/sha256" },
        "protocol_sha256": { "$ref": "#/$defs/sha256" },
        "bootstrap_seed": { "type": "integer", "minimum": 0 },
        "bootstrap_resamples": { "type": "integer", "minimum": 1000, "maximum": 100000 }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_id",
        "memory_condition",
        "retrieval_policy_id",
        "retrieval_policy_sha256",
        "memory_snapshot_sha256",
        "decision_receipt_sha256",
        "outcome_receipt_sha256",
        "task_success",
        "utility_milli",
        "harm_milli",
        "unauthorized_exposure_count",
        "unauthorized_action_count",
        "input_tokens",
        "output_tokens",
        "latency_ms",
        "total_cost_microusd",
        "selected_evidence_ids"
      ],
      "properties": {
        "arm_id": { "$ref": "#/$defs/identifier" },
        "memory_condition": {
          "enum": ["none", "clean", "poisoned", "repaired", "baseline", "candidate"]
        },
        "retrieval_policy_id": { "$ref": "#/$defs/identifier" },
        "retrieval_policy_sha256": { "$ref": "#/$defs/sha256" },
        "memory_snapshot_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "decision_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "outcome_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "task_success": { "type": "boolean" },
        "utility_milli": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "harm_milli": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "unauthorized_exposure_count": { "type": "integer", "minimum": 0 },
        "unauthorized_action_count": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "total_cost_microusd": { "type": "integer", "minimum": 0 },
        "selected_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id",
        "independent_cluster_id",
        "task_family",
        "task_sha256",
        "model_revision_sha256",
        "prompt_template_sha256",
        "evaluator_revision_sha256",
        "environment_revision_sha256",
        "stochastic_seed",
        "context_budget_tokens",
        "output_budget_tokens",
        "contrast",
        "control",
        "treatment"
      ],
      "properties": {
        "pair_id": { "$ref": "#/$defs/identifier" },
        "independent_cluster_id": { "$ref": "#/$defs/identifier" },
        "task_family": { "$ref": "#/$defs/identifier" },
        "task_sha256": { "$ref": "#/$defs/sha256" },
        "model_revision_sha256": { "$ref": "#/$defs/sha256" },
        "prompt_template_sha256": { "$ref": "#/$defs/sha256" },
        "evaluator_revision_sha256": { "$ref": "#/$defs/sha256" },
        "environment_revision_sha256": { "$ref": "#/$defs/sha256" },
        "stochastic_seed": { "type": "integer", "minimum": 0 },
        "context_budget_tokens": { "type": "integer", "minimum": 1 },
        "output_budget_tokens": { "type": "integer", "minimum": 1 },
        "contrast": {
          "enum": [
            "memory_vs_no_memory",
            "clean_vs_poisoned",
            "poisoned_vs_repaired",
            "baseline_vs_candidate"
          ]
        },
        "control": { "$ref": "#/$defs/arm" },
        "treatment": { "$ref": "#/$defs/arm" }
      }
    }
  }
}
