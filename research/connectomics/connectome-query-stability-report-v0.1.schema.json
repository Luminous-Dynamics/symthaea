{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/connectome-query-stability-report-v0.1.schema.json",
  "title": "Connectome query stability audit report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "query_id",
    "query_definition_sha256",
    "analysis_code_sha256",
    "uncertainty_set_sha256",
    "source_volume_id",
    "first_checkpoint_id",
    "latest_checkpoint_id",
    "first_graph_snapshot_sha256",
    "latest_graph_snapshot_sha256",
    "latest_edit_history_manifest_sha256",
    "graph_builder_config_sha256",
    "structural_uncertainty_manifest_sha256",
    "first_edit_count",
    "latest_edit_count",
    "checkpoint_count",
    "status",
    "metrics",
    "future_stability_certified",
    "universal_connectome_completeness_claimed"
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metric_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper"
      ],
      "properties": {
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        }
      }
    }
  },
  "properties": {
    "report_version": {
      "const": "0.1"
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "query_definition_sha256": {
      "$ref": "#/$defs/sha"
    },
    "analysis_code_sha256": {
      "$ref": "#/$defs/sha"
    },
    "uncertainty_set_sha256": {
      "$ref": "#/$defs/sha"
    },
    "source_volume_id": {
      "type": "string",
      "minLength": 1
    },
    "first_checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "latest_checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "first_graph_snapshot_sha256": {
      "$ref": "#/$defs/sha"
    },
    "latest_graph_snapshot_sha256": {
      "$ref": "#/$defs/sha"
    },
    "latest_edit_history_manifest_sha256": {
      "$ref": "#/$defs/sha"
    },
    "graph_builder_config_sha256": {
      "$ref": "#/$defs/sha"
    },
    "structural_uncertainty_manifest_sha256": {
      "$ref": "#/$defs/sha"
    },
    "first_edit_count": {
      "type": "integer",
      "minimum": 0
    },
    "latest_edit_count": {
      "type": "integer",
      "minimum": 0
    },
    "checkpoint_count": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "InsufficientHistory",
        "StableOverObservedWindow",
        "UnstableOverObservedWindow"
      ]
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "unit_id",
          "absolute_tolerance",
          "latest_identified_set_hull",
          "latest_identified_set_width",
          "latest_scenario_bounds",
          "worst_observed_temporal_drift_upper",
          "stable_over_observed_window"
        ],
        "properties": {
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "absolute_tolerance": {
            "type": "number",
            "minimum": 0
          },
          "latest_identified_set_hull": {
            "$ref": "#/$defs/metric_interval"
          },
          "latest_identified_set_width": {
            "type": "number",
            "minimum": 0
          },
          "latest_scenario_bounds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scenario_id",
                "bounds"
              ],
              "properties": {
                "scenario_id": {
                  "type": "string",
                  "minLength": 1
                },
                "bounds": {
                  "$ref": "#/$defs/metric_interval"
                }
              }
            }
          },
          "worst_observed_temporal_drift_upper": {
            "type": "number",
            "minimum": 0
          },
          "stable_over_observed_window": {
            "type": "boolean"
          }
        }
      }
    },
    "future_stability_certified": {
      "const": false
    },
    "universal_connectome_completeness_claimed": {
      "const": false
    }
  }
}
