{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/connectome-query-impact-fixture-v0.1.schema.json",
  "title": "Synthetic connectome query impact fixture v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic_only",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "synthetic_only": {
      "const": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "input"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "$ref": "connectome-query-impact-input-v0.1.schema.json"
          },
          "expected_report": {
            "$ref": "connectome-query-impact-report-v0.1.schema.json"
          },
          "expected_error": {
            "enum": [
              "InvalidIdentifier",
              "InvalidSampleHash",
              "InvalidSha256",
              "EmptyCollection",
              "QueryNotPreRegistered",
              "InvalidInterval",
              "InvalidMaterialityThreshold",
              "InvalidDecisionThreshold",
              "DuplicateQueryScenario",
              "QueryDefinitionMismatch",
              "MetricIdentityMismatch",
              "UnitMismatch",
              "MaterialityThresholdMismatch",
              "DecisionThresholdMismatch",
              "NonFiniteDerivedValue",
              "NoQueryScenarios",
              "PairedEffectOutsideConservativeBound",
              "PairedDecisionWorldsEmpty",
              "PairedDecisionWorldsRequireThreshold",
              "DuplicatePairedDecisionWorld",
              "PairedDecisionValueOutsideMarginal",
              "PairedDecisionDifferenceOutsideEffect",
              "PairedWorldCoverageRequiresDecisionWorlds",
              "EmptyExpectedWorldSet",
              "DuplicateExpectedWorldId",
              "ExpectedWorldSetMismatch",
              "WorldSetCoverageNotVerified"
            ]
          }
        },
        "oneOf": [
          {
            "required": [
              "expected_report"
            ],
            "not": {
              "required": [
                "expected_error"
              ]
            }
          },
          {
            "required": [
              "expected_error"
            ],
            "not": {
              "required": [
                "expected_report"
              ]
            }
          }
        ]
      }
    }
  }
}
