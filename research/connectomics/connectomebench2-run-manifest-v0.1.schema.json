{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/connectomebench2-run-manifest-v0.1.schema.json",
  "title": "ConnectomeBench2 immutable benchmark run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "dataset",
    "artifact_identity",
    "dataset_row_counts",
    "task_operation_counts",
    "published_external_reference",
    "reconciliation",
    "license_review_status",
    "task_view_policies"
  ],
  "properties": {
    "manifest_version": {
      "const": "connectomebench2-run-manifest-v0.1"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "requested_revision",
        "revision_resolution_status",
        "resolved_commit_sha"
      ],
      "properties": {
        "repository_id": {
          "const": "jeffbbrown2/ConnectomeBench2"
        },
        "requested_revision": {
          "const": "v2"
        },
        "revision_resolution_status": {
          "enum": [
            "UNRESOLVED",
            "PINNED"
          ]
        },
        "resolved_commit_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "revision_resolution_status": {
                "const": "PINNED"
              }
            },
            "required": [
              "revision_resolution_status"
            ]
          },
          "then": {
            "properties": {
              "resolved_commit_sha": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "revision_resolution_status": {
                "const": "UNRESOLVED"
              }
            },
            "required": [
              "revision_resolution_status"
            ]
          },
          "then": {
            "properties": {
              "resolved_commit_sha": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "artifact_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_status",
        "dataset_card_sha256",
        "shards_csv_sha256",
        "source_file_manifest_sha256",
        "declared_parquet_shard_count"
      ],
      "properties": {
        "digest_status": {
          "enum": [
            "UNRESOLVED",
            "PINNED"
          ]
        },
        "dataset_card_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "shards_csv_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "source_file_manifest_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "declared_parquet_shard_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "digest_status": {
                "const": "PINNED"
              }
            },
            "required": [
              "digest_status"
            ]
          },
          "then": {
            "properties": {
              "dataset_card_sha256": {
                "type": "string"
              },
              "shards_csv_sha256": {
                "type": "string"
              },
              "source_file_manifest_sha256": {
                "type": "string"
              },
              "declared_parquet_shard_count": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "dataset_row_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_total_rows",
        "split_rows",
        "sample_type_rows",
        "em_rows",
        "geometry_rows"
      ],
      "properties": {
        "declared_total_rows": {
          "type": "integer",
          "minimum": 0
        },
        "split_rows": {
          "$ref": "#/$defs/splitCounts"
        },
        "sample_type_rows": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adjacent_control",
            "junction_control",
            "synapse_control",
            "merge_edit",
            "split_edit"
          ],
          "properties": {
            "adjacent_control": {
              "type": "integer",
              "minimum": 0
            },
            "junction_control": {
              "type": "integer",
              "minimum": 0
            },
            "synapse_control": {
              "type": "integer",
              "minimum": 0
            },
            "merge_edit": {
              "type": "integer",
              "minimum": 0
            },
            "split_edit": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "em_rows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "geometry_rows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "task_operation_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "unique_source_rows",
        "routed_operation_instances",
        "per_task",
        "per_split",
        "count_artifact_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_MATERIALIZED",
            "RECONCILED"
          ]
        },
        "unique_source_rows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "routed_operation_instances": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "per_task": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "false_split_correction",
            "false_merge_identification",
            "split_mask_generation"
          ],
          "properties": {
            "false_split_correction": {
              "type": "integer",
              "minimum": 0
            },
            "false_merge_identification": {
              "type": "integer",
              "minimum": 0
            },
            "split_mask_generation": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "per_split": {
          "anyOf": [
            {
              "$ref": "#/$defs/splitCounts"
            },
            {
              "type": "null"
            }
          ]
        },
        "count_artifact_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "RECONCILED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "unique_source_rows": {
                "type": "integer"
              },
              "routed_operation_instances": {
                "type": "integer"
              },
              "per_task": {
                "type": "object"
              },
              "per_split": {
                "$ref": "#/$defs/splitCounts"
              },
              "count_artifact_sha256": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "published_external_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "unit_definition",
        "train_operations",
        "validation_operations",
        "test_operations",
        "total_operations"
      ],
      "properties": {
        "source_url": {
          "const": "https://arxiv.org/abs/2609.36492"
        },
        "unit_definition": {
          "const": "task-operation instances reported by the external VLM study; not assumed equivalent to unique dataset rows"
        },
        "train_operations": {
          "type": "integer",
          "minimum": 0
        },
        "validation_operations": {
          "type": "integer",
          "minimum": 0
        },
        "test_operations": {
          "type": "integer",
          "minimum": 0
        },
        "total_operations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sample_type_count_sum",
        "sample_type_count_delta",
        "split_count_sum",
        "split_count_delta",
        "audit_note"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNASSESSED",
            "DOCUMENTED_MISMATCH",
            "RECONCILED"
          ]
        },
        "sample_type_count_sum": {
          "type": "integer",
          "minimum": 0
        },
        "sample_type_count_delta": {
          "type": "integer"
        },
        "split_count_sum": {
          "type": "integer",
          "minimum": 0
        },
        "split_count_delta": {
          "type": "integer"
        },
        "audit_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "license_review_status": {
      "enum": [
        "PENDING",
        "QUALIFIED",
        "REJECTED"
      ]
    },
    "task_view_policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "false_split_correction",
        "false_merge_identification",
        "split_mask_generation"
      ],
      "properties": {
        "false_split_correction": {
          "$ref": "#/$defs/viewPolicy"
        },
        "false_merge_identification": {
          "$ref": "#/$defs/viewPolicy"
        },
        "split_mask_generation": {
          "$ref": "#/$defs/viewPolicy"
        }
      }
    }
  },
  "$defs": {
    "nullableSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "splitCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train",
        "validation",
        "test"
      ],
      "properties": {
        "train": {
          "type": "integer",
          "minimum": 0
        },
        "validation": {
          "type": "integer",
          "minimum": 0
        },
        "test": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "viewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_mask_layout",
        "allowed_em_views",
        "excluded_em_views",
        "policy_source"
      ],
      "properties": {
        "required_mask_layout": {
          "enum": [
            "dual",
            "single",
            "geometry_target_mask"
          ]
        },
        "allowed_em_views": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "xy",
              "xz",
              "yz",
              "best"
            ]
          }
        },
        "excluded_em_views": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "xy",
              "xz",
              "yz",
              "best"
            ]
          }
        },
        "policy_source": {
          "enum": [
            "DATASET_CARD",
            "PUBLISHED_VLM_PROTOCOL",
            "PREREGISTERED_LOCAL_POLICY"
          ]
        }
      }
    }
  }
}
