{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/connectome-fusion-frame-closure-v0.1.schema.json",
  "title": "Connectome Fusion Frame Closure Input V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "scope",
    "scope_sha256",
    "fusion_policy_projection",
    "source_exports",
    "declared_frame",
    "reconciliation_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "scope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "fusion_policy_projection": {
      "$ref": "#/$defs/projection"
    },
    "source_exports": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/source_export"
      }
    },
    "declared_frame": {
      "$ref": "#/$defs/frame"
    },
    "reconciliation_policy": {
      "$ref": "#/$defs/reconciliation_policy"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringId": {
      "type": "string",
      "minLength": 1
    },
    "uniqueIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stringId"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "start_at",
        "end_at",
        "event_time_basis",
        "query_ids",
        "release_ids"
      ],
      "properties": {
        "scope_id": {
          "$ref": "#/$defs/stringId"
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "event_time_basis": {
          "enum": [
            "EVENT_TIME",
            "INGESTION_TIME"
          ]
        },
        "query_ids": {
          "$ref": "#/$defs/uniqueIds"
        },
        "release_ids": {
          "$ref": "#/$defs/uniqueIds"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_id",
        "projection_sha256",
        "rule"
      ],
      "properties": {
        "projection_id": {
          "$ref": "#/$defs/stringId"
        },
        "projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rule": {
          "enum": [
            "ALL_UNORDERED_EVIDENCE_PAIRS"
          ]
        }
      }
    },
    "source_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_role",
        "custodian_ref",
        "scope_sha256",
        "extraction_sha256",
        "sequence_start",
        "sequence_end",
        "record_count",
        "unique_use_count",
        "ordered_events_sha256",
        "coverage_disposition",
        "shared_controls",
        "events"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/stringId"
        },
        "source_role": {
          "enum": [
            "FUSION_EXECUTION_LEDGER",
            "CLAIM_CERTIFICATE_LEDGER"
          ]
        },
        "custodian_ref": {
          "$ref": "#/$defs/stringId"
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "extraction_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sequence_start": {
          "type": "integer",
          "minimum": 0
        },
        "sequence_end": {
          "type": "integer",
          "minimum": 0
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "unique_use_count": {
          "type": "integer",
          "minimum": 0
        },
        "ordered_events_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "coverage_disposition": {
          "enum": [
            "QUALIFIED_COMPLETE_WITHIN_DECLARED_SCOPE",
            "UNKNOWN",
            "INCOMPLETE"
          ]
        },
        "shared_controls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stringId"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence",
        "event_at",
        "ingested_at",
        "canonical_use_key",
        "operation_id",
        "claim_id",
        "query_id",
        "certificate_id",
        "fusion_policy_sha256",
        "verifier_sha256",
        "dependence_bundle_sha256",
        "source_release_ids",
        "evidence_ids",
        "outcome"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/stringId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_use_key": {
          "$ref": "#/$defs/sha256"
        },
        "operation_id": {
          "$ref": "#/$defs/stringId"
        },
        "claim_id": {
          "$ref": "#/$defs/stringId"
        },
        "query_id": {
          "$ref": "#/$defs/stringId"
        },
        "certificate_id": {
          "$ref": "#/$defs/stringId"
        },
        "fusion_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verifier_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dependence_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_release_ids": {
          "$ref": "#/$defs/uniqueIds"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stringId"
          }
        },
        "outcome": {
          "enum": [
            "CONTRIBUTED",
            "FAILED_BEFORE_CLAIM",
            "CANCELLED",
            "RETRY_OF_PRIOR_EVENT"
          ]
        },
        "event_at": {
          "type": "string",
          "format": "date-time"
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "canonical_use_key",
        "claim_id",
        "query_id",
        "left_evidence_id",
        "right_evidence_id",
        "fusion_policy_sha256",
        "dependence_bundle_sha256"
      ],
      "properties": {
        "assertion_id": {
          "$ref": "#/$defs/stringId"
        },
        "canonical_use_key": {
          "$ref": "#/$defs/sha256"
        },
        "claim_id": {
          "$ref": "#/$defs/stringId"
        },
        "query_id": {
          "$ref": "#/$defs/stringId"
        },
        "left_evidence_id": {
          "$ref": "#/$defs/stringId"
        },
        "right_evidence_id": {
          "$ref": "#/$defs/stringId"
        },
        "fusion_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dependence_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_sha256",
        "assertion_count",
        "assertions"
      ],
      "properties": {
        "frame_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "assertion_count": {
          "type": "integer",
          "minimum": 0
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        }
      }
    },
    "reconciliation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_source_roles",
        "shared_control_policy"
      ],
      "properties": {
        "required_source_roles": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "FUSION_EXECUTION_LEDGER",
              "CLAIM_CERTIFICATE_LEDGER"
            ]
          }
        },
        "shared_control_policy": {
          "enum": [
            "FAIL_CLOSED_ON_DECLARED_SHARED_CONTROL"
          ]
        }
      }
    }
  }
}
