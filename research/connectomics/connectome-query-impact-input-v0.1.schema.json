{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/connectome-query-impact-input-v0.1.schema.json",
  "title": "Connectome proofreading query-impact input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "operation_id",
    "sample_hash",
    "task_route",
    "source_volume_id",
    "base_graph_snapshot_sha256",
    "hypothetical_result_graph_snapshot_sha256",
    "candidate_patch_sha256",
    "query_evaluations"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sample_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper"
      ],
      "properties": {
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "query_definition_sha256",
        "pre_registered",
        "metric_id",
        "unit_id",
        "materiality_threshold",
        "decision_threshold",
        "scenario_id",
        "baseline",
        "hypothetical_after_edit",
        "paired_effect",
        "paired_world_set_coverage"
      ],
      "properties": {
        "query_id": {
          "$ref": "#/$defs/id"
        },
        "query_definition_sha256": {
          "$ref": "#/$defs/sha"
        },
        "pre_registered": {
          "const": true
        },
        "metric_id": {
          "$ref": "#/$defs/id"
        },
        "unit_id": {
          "$ref": "#/$defs/id"
        },
        "materiality_threshold": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "decision_threshold": {
          "type": [
            "number",
            "null"
          ]
        },
        "scenario_id": {
          "$ref": "#/$defs/id"
        },
        "baseline": {
          "$ref": "#/$defs/interval"
        },
        "hypothetical_after_edit": {
          "$ref": "#/$defs/interval"
        },
        "paired_effect": {
          "oneOf": [
            {
              "$ref": "#/$defs/paired_effect"
            },
            {
              "type": "null"
            }
          ]
        },
        "paired_world_set_coverage": {
          "oneOf": [
            {
              "$ref": "#/$defs/paired_world_set_coverage"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "paired_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_interval",
        "evidence_sha256",
        "decision_worlds"
      ],
      "properties": {
        "effect_interval": {
          "$ref": "#/$defs/interval"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha"
        },
        "decision_worlds": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/paired_decision_world"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "paired_decision_world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_id",
        "baseline_value",
        "after_edit_value"
      ],
      "properties": {
        "world_id": {
          "$ref": "#/$defs/id"
        },
        "baseline_value": {
          "type": "number"
        },
        "after_edit_value": {
          "type": "number"
        }
      }
    },
    "paired_world_set_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe_id",
        "universe_manifest_sha256",
        "admissibility_policy_sha256",
        "enumeration_input_sha256",
        "enumerator_sha256",
        "expected_world_manifest_sha256",
        "closure_proof_sha256",
        "verifier_sha256",
        "verification_receipt_sha256",
        "expected_world_ids",
        "closure_verified",
        "query_definition_sha256",
        "metric_id",
        "unit_id",
        "decision_threshold",
        "materiality_threshold",
        "source_volume_id",
        "base_graph_snapshot_sha256",
        "hypothetical_result_graph_snapshot_sha256",
        "candidate_patch_sha256",
        "candidate_id",
        "operation_id",
        "sample_hash",
        "task_route",
        "query_id",
        "scenario_id"
      ],
      "properties": {
        "universe_id": {
          "$ref": "#/$defs/id"
        },
        "universe_manifest_sha256": {
          "$ref": "#/$defs/sha"
        },
        "admissibility_policy_sha256": {
          "$ref": "#/$defs/sha"
        },
        "enumeration_input_sha256": {
          "$ref": "#/$defs/sha"
        },
        "enumerator_sha256": {
          "$ref": "#/$defs/sha"
        },
        "expected_world_manifest_sha256": {
          "$ref": "#/$defs/sha"
        },
        "closure_proof_sha256": {
          "$ref": "#/$defs/sha"
        },
        "verifier_sha256": {
          "$ref": "#/$defs/sha"
        },
        "verification_receipt_sha256": {
          "$ref": "#/$defs/sha"
        },
        "expected_world_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "closure_verified": {
          "type": "boolean"
        },
        "query_definition_sha256": {
          "$ref": "#/$defs/sha"
        },
        "metric_id": {
          "$ref": "#/$defs/id"
        },
        "unit_id": {
          "$ref": "#/$defs/id"
        },
        "decision_threshold": {
          "type": "number"
        },
        "materiality_threshold": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_volume_id": {
          "$ref": "#/$defs/id"
        },
        "base_graph_snapshot_sha256": {
          "$ref": "#/$defs/sha"
        },
        "hypothetical_result_graph_snapshot_sha256": {
          "$ref": "#/$defs/sha"
        },
        "candidate_patch_sha256": {
          "$ref": "#/$defs/sha"
        },
        "candidate_id": {
          "$ref": "#/$defs/id"
        },
        "operation_id": {
          "$ref": "#/$defs/id"
        },
        "sample_hash": {
          "$ref": "#/$defs/sample_hash"
        },
        "task_route": {
          "enum": [
            "FalseSplitCorrection",
            "FalseMergeIdentification",
            "SplitMaskGeneration"
          ]
        },
        "query_id": {
          "$ref": "#/$defs/id"
        },
        "scenario_id": {
          "$ref": "#/$defs/id"
        }
      }
    }
  },
  "properties": {
    "candidate_id": {
      "$ref": "#/$defs/id"
    },
    "operation_id": {
      "$ref": "#/$defs/id"
    },
    "sample_hash": {
      "$ref": "#/$defs/sample_hash"
    },
    "task_route": {
      "enum": [
        "FalseSplitCorrection",
        "FalseMergeIdentification",
        "SplitMaskGeneration"
      ]
    },
    "source_volume_id": {
      "$ref": "#/$defs/id"
    },
    "base_graph_snapshot_sha256": {
      "$ref": "#/$defs/sha"
    },
    "hypothetical_result_graph_snapshot_sha256": {
      "$ref": "#/$defs/sha"
    },
    "candidate_patch_sha256": {
      "$ref": "#/$defs/sha"
    },
    "query_evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evaluation"
      }
    }
  }
}
