    "ecutrho_multipliers_of_sssp_recommendation": [0.75, 1.0, 1.25, 1.5],
    "run_all_samples_even_if_early_plateau_is_observed": true,
    "acceptance": {
      "energy_tolerance_ev_per_atom": 0.001,
