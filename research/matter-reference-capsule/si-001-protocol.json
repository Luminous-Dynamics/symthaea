    "kpoint_offset_fractional": [0.5, 0.5, 0.5]
  },
  "relaxation": {
    "calculation": "vc-relax",
    "qe_ibrav": 2,
    "ion_dynamics": "bfgs",
    "cell_dynamics": "bfgs",
    "cell_dofree": "ibrav",
    "target_pressure_kbar": 0.0,
    "press_conv_thr_kbar": 0.5,
    "forc_conv_thr_ry_per_bohr": 0.0003,
    "etot_conv_thr_ry": 1e-5,
