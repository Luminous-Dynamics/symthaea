  "evaluation_modes": [
    {
      "mode": "canonical_pool_control",
      "purpose": "Compare QA readers with the same reviewed sample-local memory pool; isolates downstream use when memory construction is held constant."
    },
    {
      "mode": "raw_native",
      "purpose": "Require each system to ingest raw sessions and build governed memory before answering; primary measure of full memory pipeline behavior."
    }
