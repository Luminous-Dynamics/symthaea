# Holochain Conductor Dockerfile for Mycelix EduNet
# Currently for future use when Holochain integration is complete (v0.2.0+)

FROM rust:1.75-bookworm AS builder

# Install Holochain dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install Holochain CLI tools
RUN cargo install holochain --version ~0.3 --locked
RUN cargo install lair_keystore --version ~0.4 --locked

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
COPY zomes/ ./zomes/

# Build all zomes (when HDK is integrated)
# RUN cargo build --release --workspace

# Stage 2: Runtime image
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy Holochain binaries from builder
COPY --from=builder /usr/local/cargo/bin/holochain /usr/local/bin/
COPY --from=builder /usr/local/cargo/bin/lair-keystore /usr/local/bin/

# Copy built zomes (when ready)
# COPY --from=builder /app/target/release/*.wasm /app/zomes/

# Create data directory
RUN mkdir -p /data
WORKDIR /data

# Expose ports
# 4444: Admin interface
# 8888: App interface
EXPOSE 4444 8888

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD holochain --version || exit 1

# Note: Actual conductor launch will be configured via docker-compose
CMD ["holochain", "--version"]
