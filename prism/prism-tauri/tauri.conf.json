{
  "$schema": "https://raw.githubusercontent.com/nicovell3/tauri/refs/heads/v2/packages/tauri-cli/schema.json",
  "productName": "Mycelix Prism",
  "version": "0.2.0",
  "identifier": "net.mycelix.prism",
  "build": {
    "frontendDist": "../prism-ui/dist",
    "devUrl": "http://localhost:8130",
    "beforeDevCommand": "",
    "beforeBuildCommand": "cd ../prism-ui && trunk build --release"
  },
  "app": {
    "windows": [
      {
        "title": "Mycelix Prism",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "center": true,
        "decorations": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: http: ws:; img-src 'self' https: data:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/prism-icon.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
