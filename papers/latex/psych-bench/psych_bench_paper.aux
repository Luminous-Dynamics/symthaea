\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Forest plot of normative z-scores for 76 benchmarks with matched human baselines (z-scores clamped to $\pm 3$ for readability; 4 benchmarks exceed this range in raw values). Background shading indicates clinical interpretation bands \citep  {cicchetti1994guidelines}. Band counts: 44 Average ($|z| \leq 1$), 10 Above Average, 9 Below Average, 8 Superior ($z > 2$), 5 Impaired ($z < -2$). Data loaded from \texttt  {normative\_zscores.csv}.}}{24}{figure.caption.36}\protected@file@percent }
\newlabel{fig:forest}{{7}{24}{Forest plot of normative z-scores for 76 benchmarks with matched human baselines (z-scores clamped to $\pm 3$ for readability; 4 benchmarks exceed this range in raw values). Background shading indicates clinical interpretation bands \citep {cicchetti1994guidelines}. Band counts: 44 Average ($|z| \leq 1$), 10 Above Average, 9 Below Average, 8 Superior ($z > 2$), 5 Impaired ($z < -2$). Data loaded from \texttt {normative\_zscores.csv}}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Ablation comparison across six presets and eight cognitive domains. Memory shows the clearest differentiation: \texttt  {ReducedWm} and \texttt  {HdcOnly} both drop from 0.779 to 0.648 ($\Delta = 0.131$). Language shows meaningful FEP sensitivity ($\Delta = 0.078$ for \texttt  {HdcOnly}). Attention ($\Delta = 0.037$), Executive ($\Delta = 0.021$), and Metacognition ($\Delta = 0.020$) show moderate sensitivity. Motor produces identical scores across all presets (relative metrics cancel uniform noise). Reasoning ($\Delta = 0.004$) and Social ($\Delta = 0.003$) show negligible differentiation. These small effects reflect the encoding-noise ablation model (Section~\ref {sec:discussion}): actual subsystem removal would likely produce larger, more domain-specific deficits. Data loaded from \texttt  {ablation\_domains.csv}.}}{25}{figure.caption.38}\protected@file@percent }
\newlabel{fig:ablation}{{8}{25}{Ablation comparison across six presets and eight cognitive domains. Memory shows the clearest differentiation: \texttt {ReducedWm} and \texttt {HdcOnly} both drop from 0.779 to 0.648 ($\Delta = 0.131$). Language shows meaningful FEP sensitivity ($\Delta = 0.078$ for \texttt {HdcOnly}). Attention ($\Delta = 0.037$), Executive ($\Delta = 0.021$), and Metacognition ($\Delta = 0.020$) show moderate sensitivity. Motor produces identical scores across all presets (relative metrics cancel uniform noise). Reasoning ($\Delta = 0.004$) and Social ($\Delta = 0.003$) show negligible differentiation. These small effects reflect the encoding-noise ablation model (Section~\ref {sec:discussion}): actual subsystem removal would likely produce larger, more domain-specific deficits. Data loaded from \texttt {ablation\_domains.csv}}{figure.caption.38}{}}
