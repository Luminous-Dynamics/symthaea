\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {K-index trajectory across episodes.} Rolling mean K-index for SAC($K$) controller episodes (blue, $N = 48$) versus open-loop baseline episodes (orange, $N = 8$). Shaded regions indicate 95\% confidence bands. Dotted horizontal line marks the Youden-optimal corridor threshold $K^* = 1.00$. Vertical gray lines indicate 7-episode training cycle boundaries. SAC($K$) maintains coherence near or above $K^*$ throughout training, while baseline drifts below threshold.}}{7}{figure.caption.19}\protected@file@percent }
\newlabel{fig:k_trajectory}{{1}{7}{\textbf {K-index trajectory across episodes.} Rolling mean K-index for SAC($K$) controller episodes (blue, $N = 48$) versus open-loop baseline episodes (orange, $N = 8$). Shaded regions indicate 95\% confidence bands. Dotted horizontal line marks the Youden-optimal corridor threshold $K^* = 1.00$. Vertical gray lines indicate 7-episode training cycle boundaries. SAC($K$) maintains coherence near or above $K^*$ throughout training, while baseline drifts below threshold}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Ablation of K-feedback on corridor discovery.} SAC($K$) achieves 50.0\% corridor discovery (95\% BCa CI [46.1\%, 54.4\%], $N = 48$) versus 12.5\% without K-feedback (95\% BCa CI [8.0\%, 17.0\%], $N = 48$), a +37.5 pp (+300\% relative) improvement. Error bars show 95\% BCa confidence intervals (10,000 stratified bootstrap resamples). Seeds: SAC($K$) 225--9999; No-$K$ 10000--19999.}}{8}{figure.caption.21}\protected@file@percent }
\newlabel{fig:ablation}{{2}{8}{\textbf {Ablation of K-feedback on corridor discovery.} SAC($K$) achieves 50.0\% corridor discovery (95\% BCa CI [46.1\%, 54.4\%], $N = 48$) versus 12.5\% without K-feedback (95\% BCa CI [8.0\%, 17.0\%], $N = 48$), a +37.5 pp (+300\% relative) improvement. Error bars show 95\% BCa confidence intervals (10,000 stratified bootstrap resamples). Seeds: SAC($K$) 225--9999; No-$K$ 10000--19999}{figure.caption.21}{}}
