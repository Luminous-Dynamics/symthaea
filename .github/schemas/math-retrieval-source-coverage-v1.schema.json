{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/math-retrieval-source-coverage-v1.schema.json",
  "title": "Symthaea Mathematical Retrieval Source Coverage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","coverage_id","authority","candidate_universe","parser","normalizer","coverage_policy","targets","rows"],
  "properties": {
    "version": {"const": "math-retrieval-source-coverage-v1"},
    "coverage_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authority": {"const": "MeasurementOnly"},
    "candidate_universe": {"$ref": "#/$defs/candidateUniverse"},
    "parser": {"$ref": "#/$defs/parser"},
    "normalizer": {"$ref": "#/$defs/normalizer"},
    "coverage_policy": {"const": "CommonIntersectionRequired"},
    "targets": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/target"}},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidateUniverse": {
      "type": "object", "additionalProperties": false,
      "required": ["corpus_snapshot_sha256","knowledge_boundary_sha256","candidate_eligibility_policy_sha256","candidate_set_sha256","candidate_count","source_identity_kind","canonical_candidate_order"],
      "properties": {
        "corpus_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "knowledge_boundary_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_eligibility_policy_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_set_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_count": {"type": "integer", "minimum": 1},
        "source_identity_kind": {"const": "SourceObjectDigest"},
        "canonical_candidate_order": {"const": "SourceObjectDigestAscending"}
      }
    },
    "parser": {
      "type": "object", "additionalProperties": false,
      "required": ["source_object_contract_sha256","parser_contract_sha256","parser_implementation_sha256","parsed_object_kind","parsed_object_serialization_sha256"],
      "properties": {
        "source_object_contract_sha256": {"$ref": "#/$defs/sha256"},
        "parser_contract_sha256": {"$ref": "#/$defs/sha256"},
        "parser_implementation_sha256": {"$ref": "#/$defs/sha256"},
        "parsed_object_kind": {"const": "FolFormulaExt"},
        "parsed_object_serialization_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "normalizer": {
      "type": "object", "additionalProperties": false,
      "required": ["normalization_contract_sha256","normalization_implementation_sha256","normalized_object_kind","normalized_object_serialization_sha256"],
      "properties": {
        "normalization_contract_sha256": {"$ref": "#/$defs/sha256"},
        "normalization_implementation_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_object_kind": {"const": "ExactNormalForm"},
        "normalized_object_serialization_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id","channel","representation_family","representation_sha256","item_serialization_sha256","input_stage","max_serialized_item_bytes"],
      "properties": {
        "target_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
        "channel": {"enum": ["Syntax","ExactNormalForm"]},
        "representation_family": {"enum": ["Lexical","CanonicalSparse","HDC"]},
        "representation_sha256": {"$ref": "#/$defs/sha256"},
        "item_serialization_sha256": {"$ref": "#/$defs/sha256"},
        "input_stage": {"enum": ["SourceObject","ParsedFolFormulaExt","ExactNormalForm"]},
        "max_serialized_item_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "representationRow": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id","status","representation_object_sha256","serialized_bytes"],
      "properties": {
        "target_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
        "status": {"const": "Ready"},
        "representation_object_sha256": {"$ref": "#/$defs/sha256"},
        "serialized_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["source_object_sha256","parse_status","parsed_object_sha256","normalization_status","normalized_object_sha256","representations"],
      "properties": {
        "source_object_sha256": {"$ref": "#/$defs/sha256"},
        "parse_status": {"const": "Parsed"},
        "parsed_object_sha256": {"$ref": "#/$defs/sha256"},
        "normalization_status": {"const": "Normalized"},
        "normalized_object_sha256": {"$ref": "#/$defs/sha256"},
        "representations": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/representationRow"}}
      }
    }
  }
}
