{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/math-retrieval-fusion-v1.schema.json",
  "title": "Symthaea Mathematical Retrieval Fusion Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fusion_id", "authority", "inputs", "fusion", "global_budget", "output"],
  "properties": {
    "version": { "const": "math-retrieval-fusion-v1" },
    "fusion_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "authority": { "const": "MeasurementOnly" },
    "inputs": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/input" } },
    "fusion": { "$ref": "#/$defs/fusion" },
    "global_budget": { "$ref": "#/$defs/budget" },
    "output": { "$ref": "#/$defs/output" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "index_manifest_sha256", "max_input_items", "max_input_bytes", "rank_weight"],
      "properties": {
        "channel": { "enum": ["Syntax", "ExactNormalForm"] },
        "index_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "max_input_items": { "type": "integer", "minimum": 1 },
        "max_input_bytes": { "type": "integer", "minimum": 1 },
        "rank_weight": { "const": 1 }
      }
    },
    "fusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "tie_break", "dedup_key", "duplicate_merge_policy", "channel_underfill_policy", "unused_quota_reallocation", "deterministic"],
      "properties": {
        "method": { "enum": ["ReciprocalRankFusion", "DeterministicInterleave"] },
        "rrf_k": { "type": "integer", "minimum": 1 },
        "tie_break": { "const": "SourceObjectDigestAscending" },
        "dedup_key": { "const": "SourceObjectDigest" },
        "duplicate_merge_policy": { "const": "OneOutputUnionChannelProvenance" },
        "channel_underfill_policy": { "const": "NoReallocation" },
        "unused_quota_reallocation": { "const": false },
        "deterministic": { "const": true }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_output_items", "max_output_bytes", "max_output_item_bytes", "byte_accounting", "partial_item_policy", "packing_policy"],
      "properties": {
        "max_output_items": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "max_output_item_bytes": { "type": "integer", "minimum": 1 },
        "byte_accounting": { "const": "CanonicalUtf8Bytes" },
        "partial_item_policy": { "const": "RejectWholeItem" },
        "packing_policy": { "const": "FusedRankOrderWholeItems" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_kind", "payload_serialization_sha256", "source_provenance_required", "channel_provenance_required", "duplicate_source_counts_once"],
      "properties": {
        "payload_kind": { "const": "CanonicalSourceObject" },
        "payload_serialization_sha256": { "$ref": "#/$defs/sha256" },
        "source_provenance_required": { "const": true },
        "channel_provenance_required": { "const": true },
        "duplicate_source_counts_once": { "const": true }
      }
    }
  }
}
