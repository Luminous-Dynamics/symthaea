{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/math-retrieval-index-build-validation-report-v1.schema.json",
  "title": "Symthaea Mathematical Retrieval Index Build Validation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","authority","receipt_sha256","coverage_sha256","candidate_set_sha256","index_manifest_sha256","index_artifact_sha256","input_set_sha256","item_count","target_id","all_payload_hashes_match","all_coverage_rows_match","all_checks_passed"],
  "properties": {
    "version": {"const": "math-retrieval-index-build-validation-report-v1"},
    "authority": {"const": "MeasurementOnly"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "coverage_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_set_sha256": {"$ref": "#/$defs/sha256"},
    "index_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "index_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "input_set_sha256": {"$ref": "#/$defs/sha256"},
    "item_count": {"type": "integer", "minimum": 1},
    "target_id": {"type": "string", "minLength": 1},
    "all_payload_hashes_match": {"const": true},
    "all_coverage_rows_match": {"const": true},
    "all_checks_passed": {"const": true}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
