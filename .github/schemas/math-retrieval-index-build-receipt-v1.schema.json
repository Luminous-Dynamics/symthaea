{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/math-retrieval-index-build-receipt-v1.schema.json",
  "title": "Symthaea Mathematical Retrieval Index Build Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","receipt_id","authority","coverage_sha256","candidate_set_sha256","index_manifest_sha256","index_artifact_sha256","target_id","index_build_policy_sha256","builder_implementation_sha256","toolchain_manifest_sha256","index_seed","input_set_sha256","build_mode"],
  "properties": {
    "version": {"const": "math-retrieval-index-build-receipt-v1"},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authority": {"const": "MeasurementOnly"},
    "coverage_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_set_sha256": {"$ref": "#/$defs/sha256"},
    "index_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "index_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "target_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
    "index_build_policy_sha256": {"$ref": "#/$defs/sha256"},
    "builder_implementation_sha256": {"$ref": "#/$defs/sha256"},
    "toolchain_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "index_seed": {"type": "integer", "minimum": 0},
    "input_set_sha256": {"$ref": "#/$defs/sha256"},
    "build_mode": {"const": "ExactDeterministicMaterializedScan"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
