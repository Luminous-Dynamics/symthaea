{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/math-retrieval-exact-index-artifact-v1.schema.json",
  "title": "Symthaea Mathematical Retrieval Exact Index Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","index_id","authority","candidate_set_sha256","target_id","representation_sha256","item_serialization_sha256","payload_encoding","item_order","item_count","items"],
  "properties": {
    "version": {"const": "math-retrieval-exact-index-artifact-v1"},
    "index_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authority": {"const": "MeasurementOnly"},
    "candidate_set_sha256": {"$ref": "#/$defs/sha256"},
    "target_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
    "representation_sha256": {"$ref": "#/$defs/sha256"},
    "item_serialization_sha256": {"$ref": "#/$defs/sha256"},
    "payload_encoding": {"const": "Base64"},
    "item_order": {"const": "SourceObjectDigestAscending"},
    "item_count": {"type": "integer", "minimum": 1},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_object_sha256","representation_object_sha256","serialized_bytes","payload_base64"],
      "properties": {
        "source_object_sha256": {"$ref": "#/$defs/sha256"},
        "representation_object_sha256": {"$ref": "#/$defs/sha256"},
        "serialized_bytes": {"type": "integer", "minimum": 1},
        "payload_base64": {"type": "string", "minLength": 4}
      }
    }
  }
}
