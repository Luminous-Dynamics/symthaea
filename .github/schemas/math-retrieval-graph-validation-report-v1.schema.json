{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/math-retrieval-graph-validation-report-v1.schema.json",
  "title": "Symthaea Mathematical Retrieval Graph Validation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "authority",
    "experiment_id",
    "retrieval_arm_count",
    "artifact_count",
    "shared_candidate_set_sha256",
    "shared_candidate_count",
    "shared_context_packer_sha256",
    "normalization_contract_sha256",
    "normalization_implementation_sha256",
    "budget",
    "all_checks_passed",
    "bundle_sha256",
    "experiment_sha256"
  ],
  "properties": {
    "version": {"const": "math-retrieval-graph-validation-report-v1"},
    "authority": {"const": "MeasurementOnly"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "retrieval_arm_count": {"type": "integer", "minimum": 1},
    "artifact_count": {"type": "integer", "minimum": 2},
    "shared_candidate_set_sha256": {"$ref": "#/$defs/sha256"},
    "shared_candidate_count": {"type": "integer", "minimum": 1},
    "shared_context_packer_sha256": {"$ref": "#/$defs/sha256"},
    "normalization_contract_sha256": {"$ref": "#/$defs/sha256"},
    "normalization_implementation_sha256": {"$ref": "#/$defs/sha256"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieved_items_max", "retrieved_item_bytes_max", "retrieval_context_bytes_max"],
      "properties": {
        "retrieved_items_max": {"type": "integer", "minimum": 0},
        "retrieved_item_bytes_max": {"type": "integer", "minimum": 0},
        "retrieval_context_bytes_max": {"type": "integer", "minimum": 0}
      }
    },
    "all_checks_passed": {"const": true},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "experiment_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
