{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/math-equivalence-property-report-v1.schema.json",
  "title": "Symthaea Exact Polynomial Property Evaluation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "evaluator_id",
    "generator_id",
    "normalizer_id",
    "authority",
    "split",
    "seeds_hex",
    "total_cases",
    "passed_cases",
    "all_passed",
    "report"
  ],
  "properties": {
    "version": { "const": "math-equivalence-property-report-v1" },
    "evaluator_id": { "const": "math-equivalence-property-evaluator-v1" },
    "generator_id": { "const": "math-equivalence-property-q0-v2" },
    "normalizer_id": { "const": "symthaea-exact-polynomial-term-v2" },
    "authority": { "const": "MeasurementOnly" },
    "split": { "enum": ["development", "evaluation"] },
    "seeds_hex": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
    },
    "total_cases": { "const": 608 },
    "passed_cases": { "type": "integer", "minimum": 0, "maximum": 608 },
    "all_passed": { "type": "boolean" },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_normal_form",
        "different_normal_form",
        "refusal_contract",
        "pair_families",
        "refusal_families"
      ],
      "properties": {
        "same_normal_form": {
          "allOf": [
            { "$ref": "#/$defs/stats" },
            { "properties": { "total": { "const": 392 } } }
          ]
        },
        "different_normal_form": {
          "allOf": [
            { "$ref": "#/$defs/stats" },
            { "properties": { "total": { "const": 120 } } }
          ]
        },
        "refusal_contract": {
          "allOf": [
            { "$ref": "#/$defs/stats" },
            { "properties": { "total": { "const": 96 } } }
          ]
        },
        "pair_families": {
          "type": "object",
          "minProperties": 24,
          "maxProperties": 24,
          "additionalProperties": { "$ref": "#/$defs/stats" }
        },
        "refusal_families": {
          "type": "object",
          "minProperties": 8,
          "maxProperties": 8,
          "additionalProperties": { "$ref": "#/$defs/stats" }
        }
      }
    }
  },
  "$defs": {
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "unexpected_normalization_errors"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "unexpected_normalization_errors": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
