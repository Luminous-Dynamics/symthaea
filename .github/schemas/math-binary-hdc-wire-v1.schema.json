{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/math-binary-hdc-wire-v1.schema.json",
  "title": "Symthaea BinaryHV 16K Wire v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "dimension_bits", "byte_count", "bit_semantics", "payload_encoding", "bytes_base64"],
  "properties": {
    "version": {"const": "math-binary-hdc-wire-v1"},
    "dimension_bits": {"const": 16384},
    "byte_count": {"const": 2048},
    "bit_semantics": {"const": "BinaryHVRawByteArray"},
    "payload_encoding": {"const": "StandardBase64"},
    "bytes_base64": {"type": "string", "minLength": 2732, "maxLength": 2732}
  }
}
