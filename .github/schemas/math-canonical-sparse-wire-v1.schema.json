{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/math-canonical-sparse-wire-v1.schema.json",
  "title": "Symthaea Canonical Sparse Integer Feature Wire v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "feature_order", "features"],
  "properties": {
    "version": {"const": "math-canonical-sparse-wire-v1"},
    "feature_order": {"const": "FeatureIdUtf8Ascending"},
    "features": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["feature_id", "count"],
        "properties": {
          "feature_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.:/-]+$"},
          "count": {"type": "integer", "minimum": 1, "maximum": 2147483647}
        }
      }
    }
  }
}
