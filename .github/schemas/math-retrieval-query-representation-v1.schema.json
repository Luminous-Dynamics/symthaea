{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/math-retrieval-query-representation-v1.schema.json",
  "title": "Symthaea Mathematical Retrieval Query Representation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "receipt_id",
    "authority",
    "query_id",
    "query_source_object_sha256",
    "source_object_contract_sha256",
    "input_stage",
    "input_object_sha256",
    "representation_sha256",
    "item_serialization_sha256",
    "wire_kind",
    "producer_implementation_sha256",
    "toolchain_manifest_sha256",
    "query_wire_sha256",
    "serialized_bytes"
  ],
  "properties": {
    "version": {"const": "math-retrieval-query-representation-v1"},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authority": {"const": "MeasurementOnly"},
    "query_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "query_source_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_object_contract_sha256": {"$ref": "#/$defs/sha256"},
    "input_stage": {"enum": ["SourceObject", "ParsedFolFormulaExt", "ExactNormalForm"]},
    "input_object_sha256": {"$ref": "#/$defs/sha256"},
    "normalization_contract_sha256": {"$ref": "#/$defs/sha256"},
    "normalization_implementation_sha256": {"$ref": "#/$defs/sha256"},
    "representation_sha256": {"$ref": "#/$defs/sha256"},
    "item_serialization_sha256": {"$ref": "#/$defs/sha256"},
    "wire_kind": {"enum": ["CanonicalSparseV1", "BinaryHV16K"]},
    "producer_implementation_sha256": {"$ref": "#/$defs/sha256"},
    "toolchain_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "query_wire_sha256": {"$ref": "#/$defs/sha256"},
    "serialized_bytes": {"type": "integer", "minimum": 1}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
