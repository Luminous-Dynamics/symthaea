{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/math-retrieval-context-packer-v1.schema.json",
  "title": "Symthaea Mathematical Retrieval Context Packer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "packer_id", "authority", "source", "visibility", "packing", "budget"],
  "properties": {
    "version": {"const": "math-retrieval-context-packer-v1"},
    "packer_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authority": {"const": "MeasurementOnly"},
    "source": {"$ref": "#/$defs/source"},
    "visibility": {"$ref": "#/$defs/visibility"},
    "packing": {"$ref": "#/$defs/packing"},
    "budget": {"$ref": "#/$defs/budget"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_kind", "source_object_contract_sha256", "source_fetch_policy_sha256", "payload_serialization_sha256"],
      "properties": {
        "payload_kind": {"const": "CanonicalSourceObject"},
        "source_object_contract_sha256": {"$ref": "#/$defs/sha256"},
        "source_fetch_policy_sha256": {"$ref": "#/$defs/sha256"},
        "payload_serialization_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval_score_visible_to_downstream",
        "retrieval_rank_visible_to_downstream",
        "retrieval_channel_visible_to_downstream",
        "representation_bytes_visible_to_downstream",
        "normal_form_visible_to_downstream",
        "provenance_sidecar_required",
        "provenance_sidecar_visible_to_downstream"
      ],
      "properties": {
        "retrieval_score_visible_to_downstream": {"const": false},
        "retrieval_rank_visible_to_downstream": {"const": false},
        "retrieval_channel_visible_to_downstream": {"const": false},
        "representation_bytes_visible_to_downstream": {"const": false},
        "normal_form_visible_to_downstream": {"const": false},
        "provenance_sidecar_required": {"const": true},
        "provenance_sidecar_visible_to_downstream": {"const": false}
      }
    },
    "packing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_kind", "dedup_key", "order_policy", "byte_accounting", "partial_item_policy", "nonfitting_item_policy", "unused_budget_reallocation", "deterministic"],
      "properties": {
        "input_kind": {"const": "RankedSourceObjectDigests"},
        "dedup_key": {"const": "SourceObjectDigest"},
        "order_policy": {"const": "PreserveRetrievedRank"},
        "byte_accounting": {"const": "CanonicalUtf8Bytes"},
        "partial_item_policy": {"const": "RejectWholeItem"},
        "nonfitting_item_policy": {"const": "StopBeforeFirstNonFittingItem"},
        "unused_budget_reallocation": {"const": false},
        "deterministic": {"const": true}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_output_items", "max_output_bytes", "max_output_item_bytes"],
      "properties": {
        "max_output_items": {"type": "integer", "minimum": 1},
        "max_output_bytes": {"type": "integer", "minimum": 1},
        "max_output_item_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
