{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/math-retrieval-ranking-replay-validation-report-v1.schema.json",
  "title": "Symthaea Retrieval Ranking Replay Validation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "authority",
    "receipt_sha256",
    "trace_sha256",
    "trace_selector",
    "metric",
    "query_representation_report_sha256",
    "index_build_report_sha256",
    "scoring_policy_bundle_sha256",
    "requested_k",
    "eligible_count",
    "expected_top_k",
    "runtime_top_k",
    "full_ranking_sha256",
    "witness_sha256",
    "all_checks_passed"
  ],
  "properties": {
    "version": {
      "const": "math-retrieval-ranking-replay-validation-report-v1"
    },
    "authority": {
      "const": "MeasurementOnly"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "trace_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "trace_selector": {
      "enum": [
        "SingleIndex",
        "Syntax",
        "ExactNormalForm"
      ]
    },
    "metric": {
      "enum": [
        "Cosine",
        "HammingSimilarity"
      ]
    },
    "query_representation_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "index_build_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "scoring_policy_bundle_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "requested_k": {
      "type": "integer",
      "minimum": 1
    },
    "eligible_count": {
      "type": "integer",
      "minimum": 0
    },
    "expected_top_k": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "runtime_top_k": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "full_ranking_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "witness_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "all_checks_passed": {
      "const": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
