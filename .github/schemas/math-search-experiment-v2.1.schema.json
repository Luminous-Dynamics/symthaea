{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/math-search-experiment-v2.1.schema.json",
  "title": "Symthaea Mathematical Search Experiment Manifest v2.1",
  "description": "v2 causal contract with explicit retrieval-binding identities; the stdlib semantic validator is normative for inherited v2 invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "authority", "stage", "frozen_before_evaluation",
    "shared_contract", "budget", "statistical_plan_sha256", "seeds", "primary_endpoints",
    "secondary_endpoints", "manipulation_checks", "strategy_controls", "evolutionary_search",
    "arms", "planned_contrasts"
  ],
  "properties": {
    "schema_version": {"const": "symthaea.math-search-experiment.v2.1"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authority": {"const": "MeasurementOnly"},
    "stage": {"enum": ["Q0RepresentationRetrieval", "Q1BlindSolvedTransfer", "Q2CrossDomainTransfer", "Q3FormalConjecturesRediscovery", "Q4ResearchHeldOut"]},
    "frozen_before_evaluation": {"const": true},
    "shared_contract": {"type": "object"},
    "budget": {"type": "object"},
    "statistical_plan_sha256": {"$ref": "#/$defs/sha256"},
    "seeds": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "primary_endpoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "secondary_endpoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "manipulation_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "strategy_controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evolutionary_search": {"const": false},
    "arms": {"type": "array", "minItems": 3, "maxItems": 32, "items": {"$ref": "#/$defs/arm"}},
    "planned_contrasts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_id", "arm_role", "representation_channels", "representation_family",
        "representation_sha256", "retriever_family", "retriever_sha256", "control_kind",
        "negative_search_memory"
      ],
      "properties": {
        "arm_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
        "arm_role": {"enum": ["Baseline", "Treatment", "Control", "MemoryAugmented"]},
        "representation_channels": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["Syntax", "ExactNormalForm"]}},
        "representation_family": {"enum": ["None", "Lexical", "CanonicalSparse", "HDC", "FusionConventional", "FusionHDC"]},
        "representation_sha256": {"$ref": "#/$defs/sha256"},
        "retriever_family": {"enum": ["None", "Conventional", "HDC", "Fusion", "Control"]},
        "retriever_sha256": {"$ref": "#/$defs/sha256"},
        "retrieval_binding_sha256": {"$ref": "#/$defs/sha256"},
        "fusion_policy_sha256": {"$ref": "#/$defs/sha256"},
        "control_kind": {"enum": ["None", "LexicalRetrieval", "RandomRetrieval", "ShuffledHdcVectors", "PermutedChallengeAssociations"]},
        "negative_search_memory": {"type": "boolean"},
        "parent_arm_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"}
      }
    }
  }
}
