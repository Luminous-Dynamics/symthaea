{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/math-retrieval-ranking-replay-receipt-v1.schema.json",
  "title": "Symthaea Retrieval Ranking Replay Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "receipt_id",
    "authority",
    "trace_selector",
    "scoring_policy_bundle_sha256",
    "query_representation_receipt_sha256",
    "query_representation_report_sha256",
    "index_build_report_sha256",
    "index_manifest_sha256",
    "index_artifact_sha256",
    "trace_sha256",
    "trace_validation_report_sha256"
  ],
  "properties": {
    "version": {
      "const": "math-retrieval-ranking-replay-receipt-v1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authority": {
      "const": "MeasurementOnly"
    },
    "trace_selector": {
      "enum": [
        "SingleIndex",
        "Syntax",
        "ExactNormalForm"
      ]
    },
    "scoring_policy_bundle_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "query_representation_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "query_representation_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "index_build_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "index_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "index_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "trace_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "trace_validation_report_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
