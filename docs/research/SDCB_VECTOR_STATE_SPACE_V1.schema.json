{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/SDCB_VECTOR_STATE_SPACE_V1.schema.json",
  "title": "SDCB vector state-space fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_ids",
    "generator",
    "diffusion_covariance",
    "elapsed_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": "sdcb_vector_state_space.v1"
    },
    "state_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generator": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "diffusion_covariance": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
