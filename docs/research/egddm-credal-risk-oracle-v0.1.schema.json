{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-credal-risk-oracle-v0.1.schema.json",
  "title": "EGDDM D6.16 evaluator oracle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actual_hypothesis_id",
    "decision_cutoff",
    "actions",
    "hypothesis_bounds",
    "hypotheses",
    "options"
  ],
  "properties": {
    "actual_hypothesis_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "irreversible",
          "hard_gate",
          "max_residual_risk_bps"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "irreversible": {
            "type": "boolean"
          },
          "hard_gate": {
            "type": "boolean"
          },
          "max_residual_risk_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    "hypothesis_bounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "lower_probability_bps",
          "upper_probability_bps",
          "nominal_probability_bps"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "minLength": 1
          },
          "lower_probability_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "upper_probability_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "nominal_probability_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "safe_actions",
          "observations"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "minLength": 1
          },
          "safe_actions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observations": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "available_at"
        ],
        "properties": {
          "option_id": {
            "type": "string"
          },
          "available_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
