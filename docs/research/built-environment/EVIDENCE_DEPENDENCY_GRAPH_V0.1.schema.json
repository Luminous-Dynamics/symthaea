{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/built-environment/EVIDENCE_DEPENDENCY_GRAPH_V0.1.schema.json",
  "title": "Evidence dependency graph fixture v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "graph_revision",
    "nodes",
    "expected_cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "graph_revision": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "content_payload",
          "depends_on",
          "evidence_receipt_payload"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "content_payload": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_receipt_payload": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "expected_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "changed_node_ids",
          "invalidated_node_ids",
          "preserved_evidence_node_ids"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "changed_node_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "invalidated_node_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "preserved_evidence_node_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
