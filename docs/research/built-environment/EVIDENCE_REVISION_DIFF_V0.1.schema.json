{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/built-environment/EVIDENCE_REVISION_DIFF_V0.1.schema.json",
  "title": "Evidence revision diff fixture v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "prior_graph",
    "current_graph",
    "expected_changed_node_ids",
    "expected_invalidated_node_ids",
    "expected_preserved_evidence_node_ids",
    "expected_change_reasons"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "prior_graph": {
      "$ref": "#/$defs/graph"
    },
    "current_graph": {
      "$ref": "#/$defs/graph"
    },
    "expected_changed_node_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_invalidated_node_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_preserved_evidence_node_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_change_reasons": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "ADDED",
            "REMOVED",
            "CONTENT_CHANGED",
            "DEPENDENCIES_CHANGED",
            "EVIDENCE_RECEIPT_CHANGED"
          ]
        }
      }
    }
  },
  "$defs": {
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_id",
        "graph_revision",
        "nodes"
      ],
      "properties": {
        "graph_id": {
          "type": "string",
          "minLength": 1
        },
        "graph_revision": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "content_payload",
              "depends_on",
              "evidence_receipt_payload"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "content_payload": {
                "type": "string",
                "minLength": 1
              },
              "depends_on": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_receipt_payload": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
