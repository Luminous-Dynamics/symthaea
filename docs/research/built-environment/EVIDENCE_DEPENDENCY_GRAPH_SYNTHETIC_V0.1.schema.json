{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic evidence dependency graph fixture v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "graph_revision",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "graph_id": {
      "const": "SYNTH-HOME-EVIDENCE-GRAPH-001"
    },
    "graph_revision": {
      "const": "REV-A"
    },
    "nodes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "content_payload",
          "depends_on",
          "evidence_receipt_payload"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "content_payload": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_receipt_payload": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
