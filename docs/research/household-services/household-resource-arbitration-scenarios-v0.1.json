    "receipt_completeness_and_replayability"
  ],
  "interpretation_guardrails": [
    "All scenarios are synthetic and do not represent measured household conditions.",
    "A manifest pass is not physical service or safety evidence.",
    "No scenario grants an actuator permission or bypasses local controls.",
    "Missing evidence remains Unknown; it is not converted to zero demand or full reserve.",
    "Electric and useful thermal energy remain separate carriers.",
    "No scalar score may compensate for hard-gate violations."
  ],
