{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/dynamapbench-manifest-v0.1.json",
  "title": "DynaMapBench Corpus Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "release",
    "split_policy",
    "corpus_artifact",
    "evaluator",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "DynaMapBench"
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "corpus_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_family_holdout",
        "temporal_holdout",
        "test_after"
      ],
      "properties": {
        "repository_family_holdout": {
          "const": true
        },
        "temporal_holdout": {
          "const": true
        },
        "test_after": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^([a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start_line",
        "end_line"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "blob_oid"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "blob_oid": {
          "$ref": "#/$defs/oid"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "available_at",
        "object_oid"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "object_oid": {
          "$ref": "#/$defs/oid"
        }
      }
    },
    "forbidden": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "reason"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "enum": [
            "future",
            "unauthorized",
            "wrong_revision",
            "wrong_world",
            "superseded",
            "expired",
            "incomplete"
          ]
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "object_oid": {
          "$ref": "#/$defs/oid"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "lane",
        "task_family",
        "split",
        "case_time",
        "repository",
        "source_objects",
        "decision_cutoff",
        "available_inputs",
        "forbidden_inputs",
        "budget",
        "harness",
        "gold"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "lane": {
          "enum": [
            "D1",
            "D2",
            "D3",
            "D4",
            "D5",
            "D6",
            "F"
          ]
        },
        "task_family": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "train",
            "dev",
            "test"
          ]
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "full_name",
            "family_id",
            "commit_oid",
            "tree_oid"
          ],
          "properties": {
            "full_name": {
              "type": "string",
              "minLength": 1
            },
            "family_id": {
              "type": "string",
              "minLength": 1
            },
            "commit_oid": {
              "$ref": "#/$defs/oid"
            },
            "tree_oid": {
              "$ref": "#/$defs/oid"
            }
          }
        },
        "source_objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "decision_cutoff": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "available_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "forbidden_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forbidden"
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tokenizer_id",
            "token_limit",
            "line_limit",
            "tool_call_limit",
            "time_limit_ms"
          ],
          "properties": {
            "tokenizer_id": {
              "type": "string",
              "minLength": 1
            },
            "token_limit": {
              "type": "integer",
              "minimum": 1
            },
            "line_limit": {
              "type": "integer",
              "minimum": 1
            },
            "tool_call_limit": {
              "type": "integer",
              "minimum": 1
            },
            "time_limit_ms": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent",
            "model",
            "harness",
            "prompt_sha256",
            "evaluator_sha256"
          ],
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "harness": {
              "type": "string",
              "minLength": 1
            },
            "prompt_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "evaluator_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "gold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disposition",
            "authority",
            "review_count",
            "adjudicated",
            "relevant_spans",
            "forbidden_spans"
          ],
          "properties": {
            "disposition": {
              "enum": [
                "positive",
                "natural_no_gold",
                "counterfactual_no_gold"
              ]
            },
            "authority": {
              "enum": [
                "independently_adjudicated",
                "synthetic_exact"
              ]
            },
            "review_count": {
              "type": "integer",
              "minimum": 0
            },
            "adjudicated": {
              "type": "boolean"
            },
            "relevant_spans": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/span"
              }
            },
            "forbidden_spans": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/span"
              }
            }
          }
        },
        "case_time": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
