{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EGDDM D6.16 adaptive acquisition bundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_view",
    "oracle"
  ],
  "properties": {
    "candidate_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "trusted_contract",
        "policies"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "trusted_contract": {
          "$ref": "#/$defs/contract"
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policy_id",
              "root_node_id",
              "nodes"
            ],
            "properties": {
              "policy_id": {
                "type": "string",
                "minLength": 1
              },
              "root_node_id": {
                "type": "string",
                "minLength": 1
              },
              "nodes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "node_id",
                        "kind",
                        "option_id",
                        "at",
                        "outcome_edges"
                      ],
                      "properties": {
                        "node_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "const": "acquire"
                        },
                        "option_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "outcome_edges": {
                          "type": "object",
                          "minProperties": 1,
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "node_id",
                        "kind",
                        "action_id"
                      ],
                      "properties": {
                        "node_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "const": "act"
                        },
                        "action_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "node_id",
                        "kind",
                        "reason_code"
                      ],
                      "properties": {
                        "node_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "const": "defer"
                        },
                        "reason_code": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trusted_contract",
        "worlds",
        "observation_models"
      ],
      "properties": {
        "trusted_contract": {
          "$ref": "#/$defs/contract"
        },
        "worlds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "world_id",
              "prior_probability_bps",
              "safe_actions"
            ],
            "properties": {
              "world_id": {
                "type": "string",
                "minLength": 1
              },
              "prior_probability_bps": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "safe_actions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "observation_models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option_id",
              "cost_samples_micros",
              "by_world"
            ],
            "properties": {
              "option_id": {
                "type": "string",
                "minLength": 1
              },
              "cost_samples_micros": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cold"
                ],
                "properties": {
                  "cold": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "by_world": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "world_id",
                    "outcomes"
                  ],
                  "properties": {
                    "world_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "outcomes": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_cutoff",
        "budget_micros",
        "defer_penalty_micros",
        "max_acquisitions",
        "actions",
        "options"
      ],
      "properties": {
        "decision_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "budget_micros": {
          "type": "integer",
          "minimum": 0
        },
        "defer_penalty_micros": {
          "type": "integer",
          "minimum": 0
        },
        "max_acquisitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action_id",
              "hard_gate",
              "irreversible",
              "max_residual_risk_bps"
            ],
            "properties": {
              "action_id": {
                "type": "string",
                "minLength": 1
              },
              "hard_gate": {
                "type": "boolean"
              },
              "irreversible": {
                "type": "boolean"
              },
              "max_residual_risk_bps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            }
          }
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option_id",
              "available_at"
            ],
            "properties": {
              "option_id": {
                "type": "string",
                "minLength": 1
              },
              "available_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
