{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/symthaea-benchmark-passport-v1.schema.json",
  "title": "Symthaea Benchmark Passport v1",
  "description": "A provenance-bound record for one benchmark run. A passport records evidence and limitations; it does not certify truth, licensing, model identity, or hardware attestation by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "benchmark", "subject", "dataset", "evaluator", "execution", "measurement", "results", "claims"],
  "properties": {
    "schema_version": { "const": "symthaea-benchmark-passport-v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "benchmark": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "protocol_digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "protocol_digest": { "$ref": "#/$defs/digest" },
        "leaderboard_stratum": { "type": ["string", "null"] }
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["system_name", "system_version", "model_digest", "configuration_digest", "architecture"],
      "properties": {
        "system_name": { "type": "string", "minLength": 1 },
        "system_version": { "type": "string", "minLength": 1 },
        "model_digest": { "$ref": "#/$defs/digest" },
        "configuration_digest": { "$ref": "#/$defs/digest" },
        "architecture": { "type": "string", "minLength": 1 },
        "weights_source": { "type": ["string", "null"] }
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_name", "version", "manifest_digest", "split", "item_count", "license_record_digest", "consent_scope"],
      "properties": {
        "dataset_name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "split": { "enum": ["train", "dev", "validation", "test", "hidden_test", "challenge", "other"] },
        "item_count": { "type": "integer", "minimum": 0 },
        "license_record_digest": { "$ref": "#/$defs/digest" },
        "consent_scope": { "type": "string", "minLength": 1 },
        "subject_overlap_policy": { "type": "string", "minLength": 1 },
        "known_exclusions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evaluator": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "source_commit", "binary_digest", "grader_configuration_digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "binary_digest": { "$ref": "#/$defs/digest" },
        "grader_configuration_digest": { "$ref": "#/$defs/digest" },
        "human_annotator_protocol_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["started_at_utc", "completed_at_utc", "hardware", "software", "seed", "network_mode", "run_status"],
      "properties": {
        "started_at_utc": { "type": "string", "format": "date-time" },
        "completed_at_utc": { "type": "string", "format": "date-time" },
        "hardware": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["component", "model"], "properties": { "component": { "type": "string" }, "model": { "type": "string" }, "memory_bytes": { "type": ["integer", "null"], "minimum": 0 } } } },
        "software": { "type": "array", "items": { "type": "string" } },
        "seed": { "type": ["integer", "null"] },
        "network_mode": { "enum": ["offline", "local", "hosted", "hybrid", "unknown"] },
        "run_status": { "enum": ["complete", "partial", "failed", "aborted"] },
        "environment_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["latency_start_event", "latency_end_event", "clock_domains", "includes_network", "warmup_policy", "aggregation"],
      "properties": {
        "latency_start_event": { "type": "string", "minLength": 1 },
        "latency_end_event": { "type": "string", "minLength": 1 },
        "clock_domains": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "includes_network": { "type": "boolean" },
        "warmup_policy": { "type": "string", "minLength": 1 },
        "aggregation": { "type": "string", "minLength": 1 },
        "percentile_method": { "type": ["string", "null"] },
        "sampling_rate_hz": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "results": {
      "type": "object", "additionalProperties": false,
      "required": ["metrics", "raw_outputs_digest", "per_item_records_digest", "failure_counts"],
      "properties": {
        "metrics": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "value", "unit", "direction"], "properties": { "name": { "type": "string" }, "value": { "type": ["number", "null"] }, "unit": { "type": "string" }, "direction": { "enum": ["higher_is_better", "lower_is_better", "target_range", "descriptive"] }, "confidence_interval": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "denominator": { "type": ["integer", "null"], "minimum": 0 } } } },
        "raw_outputs_digest": { "$ref": "#/$defs/digest" },
        "per_item_records_digest": { "$ref": "#/$defs/digest" },
        "failure_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_status", "limitations", "independent_replication"],
      "properties": {
        "claim_status": { "enum": ["exploratory", "internally_reproduced", "externally_reproduced", "independently_audited"] },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "independent_replication": { "type": ["string", "null"] },
        "baseline_passports": { "type": "array", "items": { "$ref": "#/$defs/digest" } },
        "safety_invariants": { "type": "object", "additionalProperties": { "type": ["boolean", "integer", "number", "string", "null"] } }
      }
    },
    "signature": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": { "algorithm": { "type": "string" }, "key_id": { "type": "string" }, "value": { "type": "string" } }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^(sha256|blake3):[0-9a-f]{64}$" }
  }
}