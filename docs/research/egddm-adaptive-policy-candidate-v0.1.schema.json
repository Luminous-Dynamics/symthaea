{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-adaptive-policy-candidate-v0.1.schema.json",
  "title": "EGDDM D6.17.2.1 adaptive policy candidate view v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "decision_cutoff",
    "budget_micros",
    "max_depth",
    "actions",
    "hypothesis_bounds",
    "options",
    "factors",
    "policy_tree"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "budget_micros": {
      "type": "integer",
      "minimum": 1
    },
    "max_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-candidate-v0.1.schema.json#/properties/actions/items"
      }
    },
    "hypothesis_bounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-candidate-v0.1.schema.json#/properties/hypothesis_bounds/items"
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-candidate-v0.1.schema.json#/properties/options/items"
      }
    },
    "factors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-candidate-v0.1.schema.json#/properties/factors/items"
      }
    },
    "policy_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_node_id",
        "nodes"
      ],
      "properties": {
        "root_node_id": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "node_id",
                  "kind",
                  "option_id",
                  "at",
                  "branches"
                ],
                "properties": {
                  "node_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "acquire"
                  },
                  "option_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "branches": {
                    "type": "object",
                    "minProperties": 2,
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "node_id",
                  "kind",
                  "decision_kind",
                  "action_id",
                  "claimed_residual_risk_bps"
                ],
                "properties": {
                  "node_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "stop"
                  },
                  "decision_kind": {
                    "enum": [
                      "act",
                      "defer"
                    ]
                  },
                  "action_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "claimed_residual_risk_bps": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
