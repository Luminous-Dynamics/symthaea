{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/eqc-observer-run-expectation-v0.1.schema.json",
  "title": "EQC Observer Run Expectation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "task_digest_sha256",
    "policy_digest_sha256",
    "expected_actor_id",
    "expected_subject_id",
    "expected_authorization_decision",
    "expected_task_success",
    "state_must_remain_unchanged",
    "expected_inputs",
    "max_elapsed_ms",
    "max_cpu_time_ms",
    "max_peak_memory_bytes",
    "max_tool_calls",
    "network_policy",
    "max_human_interventions"
  ],
  "properties": {
    "schema": {
      "const": "luminous.eqc.observer-run-expectation.v0.1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^eqc-[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "task_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expected_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_subject_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_authorization_decision": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "expected_task_success": {
      "type": "boolean"
    },
    "state_must_remain_unchanged": {
      "type": "boolean"
    },
    "expected_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_id",
          "sha256"
        ],
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "max_elapsed_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_cpu_time_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_peak_memory_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_tool_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "network_policy": {
      "const": "none"
    },
    "max_human_interventions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
