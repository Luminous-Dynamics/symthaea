{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic paired acoustic counterfactual vectors",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_state",
    "purpose",
    "policy",
    "vectors"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "evidence_state": {
      "const": "SYNTHETIC_ONLY"
    },
    "purpose": {
      "type": "string"
    },
    "policy": {
      "type": "object"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "trials",
          "pair",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "TEXT_NUISANCE",
              "AUDIO_RELEVANT",
              "AUDIO_NUISANCE"
            ]
          },
          "trials": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "trial_id",
                "pair_id",
                "source_audio_sha256",
                "audio_truth",
                "outcome",
                "evidence_span_present"
              ]
            }
          },
          "pair": {
            "type": "object",
            "required": [
              "pair_id",
              "baseline_trial_id",
              "variant_trial_id",
              "intervention_kind",
              "baseline_condition_manifest_sha256",
              "variant_condition_manifest_sha256",
              "intervention_manifest_sha256",
              "changed_dimensions"
            ]
          },
          "expected": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
