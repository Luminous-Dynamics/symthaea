{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/voice/phonological_feature_profile_v1.schema.json",
  "title": "Versioned phonological feature profile",
  "description": "A scoped, authority-backed description of the feature dimensions used by FER/TER. This schema validates structure, not phonological truth or licensing.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "profile_revision",
    "profile_status",
    "language_scope",
    "orthography_scope",
    "dimensions",
    "tone_dimension_ids",
    "value_semantics",
    "annotation_authority",
    "annotation_protocol",
    "reference_revision",
    "source_lineage",
    "rights_and_purpose",
    "reviewers",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_revision": {
      "type": "string",
      "minLength": 1
    },
    "profile_status": {
      "enum": [
        "SYNTHETIC_ONLY",
        "RESEARCH_DRAFT",
        "NATIVE_REVIEWED",
        "QUALIFIED",
        "RETIRED"
      ]
    },
    "language_scope": {
      "type": "object",
      "required": [
        "language_tag",
        "language_name",
        "variety_name",
        "scope_note",
        "exclusions"
      ],
      "properties": {
        "language_tag": {
          "type": "string",
          "minLength": 1
        },
        "language_name": {
          "type": "string",
          "minLength": 1
        },
        "variety_name": {
          "type": "string",
          "minLength": 1
        },
        "country_or_region": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope_note": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "orthography_scope": {
      "type": "object",
      "required": [
        "orthography_name",
        "orthography_revision",
        "normalization_policy",
        "source_mapping_policy"
      ],
      "properties": {
        "orthography_name": {
          "type": "string",
          "minLength": 1
        },
        "orthography_revision": {
          "type": "string",
          "minLength": 1
        },
        "normalization_policy": {
          "type": "string",
          "minLength": 1
        },
        "source_mapping_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "dimension_index",
          "dimension_id",
          "name",
          "definition",
          "category",
          "applicability",
          "value_semantics"
        ],
        "properties": {
          "dimension_index": {
            "type": "integer",
            "minimum": 0
          },
          "dimension_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "SEGMENTAL",
              "TONE",
              "PHONATION",
              "CLICK",
              "AIRSTREAM",
              "PROSODIC",
              "OTHER"
            ]
          },
          "applicability": {
            "enum": [
              "APPLICABLE",
              "NOT_APPLICABLE",
              "UNREVIEWED"
            ]
          },
          "value_semantics": {
            "type": "object",
            "required": [
              "negative_one",
              "zero",
              "positive_one"
            ],
            "properties": {
              "negative_one": {
                "type": "string"
              },
              "zero": {
                "const": "NOT_APPLICABLE_ONLY"
              },
              "positive_one": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "source_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "expert_review_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "tone_dimension_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "value_semantics": {
      "type": "object",
      "required": [
        "encoding",
        "unknown_annotation",
        "missing_annotation",
        "zero"
      ],
      "properties": {
        "encoding": {
          "const": {
            "negative_one": -1,
            "zero": 0,
            "positive_one": 1
          }
        },
        "unknown_annotation": {
          "const": "MUST_REMAIN_UNRESOLVED_NOT_ZERO"
        },
        "missing_annotation": {
          "const": "MISSING_NOT_ZERO"
        },
        "zero": {
          "const": "NOT_APPLICABLE_ONLY"
        }
      },
      "additionalProperties": false
    },
    "annotation_authority": {
      "enum": [
        "SYNTHETIC_FEATURE_LABELS_ONLY",
        "EXPERT_NATIVE_PHONETIC_ANNOTATION",
        "NATIVE_RULE_G2P",
        "EQUIVALENT_RULE_G2P",
        "DONOR_RULE_G2P",
        "MODEL_PREDICTED",
        "UNKNOWN"
      ]
    },
    "annotation_protocol": {
      "type": "object",
      "required": [
        "protocol_id",
        "protocol_revision",
        "segment_definition",
        "adjudication_policy"
      ],
      "properties": {
        "protocol_id": {
          "type": "string",
          "minLength": 1
        },
        "protocol_revision": {
          "type": "string",
          "minLength": 1
        },
        "segment_definition": {
          "type": "string",
          "minLength": 1
        },
        "adjudication_policy": {
          "type": "string",
          "minLength": 1
        },
        "annotator_training_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "inter_annotator_agreement": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "reference_revision": {
      "type": "string",
      "minLength": 1
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "revision",
          "role"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "rights_and_purpose": {
      "type": "object",
      "required": [
        "permission_status",
        "permitted_purpose",
        "source_rights_ref",
        "redistribution_policy"
      ],
      "properties": {
        "permission_status": {
          "enum": [
            "SYNTHETIC_ONLY",
            "REVIEW_REQUIRED",
            "ADMITTED",
            "RESTRICTED",
            "BLOCKED"
          ]
        },
        "permitted_purpose": {
          "type": "string",
          "minLength": 1
        },
        "source_rights_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "redistribution_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reviewer_role",
          "independent_of_other_reviewers",
          "review_scope",
          "review_ref"
        ],
        "properties": {
          "reviewer_role": {
            "type": "string",
            "minLength": 1
          },
          "independent_of_other_reviewers": {
            "type": "boolean"
          },
          "review_scope": {
            "type": "string",
            "minLength": 1
          },
          "review_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile_status": {
            "const": "QUALIFIED"
          }
        },
        "required": [
          "profile_status"
        ]
      },
      "then": {
        "properties": {
          "reviewers": {
            "type": "array",
            "minItems": 2,
            "contains": {
              "type": "object",
              "required": [
                "independent_of_other_reviewers"
              ],
              "properties": {
                "independent_of_other_reviewers": {
                  "const": true
                }
              }
            },
            "minContains": 2
          },
          "annotation_authority": {
            "const": "EXPERT_NATIVE_PHONETIC_ANNOTATION"
          },
          "rights_and_purpose": {
            "properties": {
              "permission_status": {
                "const": "ADMITTED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile_status": {
            "const": "SYNTHETIC_ONLY"
          }
        },
        "required": [
          "profile_status"
        ]
      },
      "then": {
        "properties": {
          "annotation_authority": {
            "const": "SYNTHETIC_FEATURE_LABELS_ONLY"
          },
          "rights_and_purpose": {
            "properties": {
              "permission_status": {
                "const": "SYNTHETIC_ONLY"
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
