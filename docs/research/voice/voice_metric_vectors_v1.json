{
  "schema_version": "0.1.0",
  "classification": "SYNTHETIC_ONLY",
  "purpose": "Cross-implementation regression vectors for WER, PIER, SETER, SPER@k and per-language masked error. These examples are not speech data and provide no language capability evidence.",
  "metric_contract": {
    "tokenization": "Already-tokenized exact strings; no implicit normalization, transliteration, case-folding or diacritic stripping.",
    "wer": {
      "unit": "fraction",
      "numerator": "substitutions + deletions + insertions",
      "denominator": "reference token count"
    },
    "pier": {
      "unit": "percent",
      "numerator": "POI substitutions + POI deletions + POI-attributed insertions",
      "denominator": "POI hits + POI substitutions + POI deletions"
    },
    "seter": {
      "unit": "fraction",
      "numerator": "substitutions + deletions at switch-entry reference positions",
      "denominator": "number of switch-entry reference positions"
    },
    "sper": {
      "unit": "fraction",
      "numerator": "substitutions + deletions in the union of reference-token windows around all switch entries",
      "denominator": "number of unique reference positions in that union"
    },
    "language_error": {
      "unit": "fraction",
      "numerator": "substitutions + deletions in the language-tagged reference group",
      "denominator": "reference tokens carrying that language tag"
    }
  },
  "alignment_policy": {
    "source": "symthaea_stt::eval::levenshtein_align",
    "operations": [
      "MATCH",
      "SUBSTITUTE",
      "DELETE",
      "INSERT"
    ],
    "insertion_source_position": "Number of reference tokens consumed before the insertion; zero-based boundary index.",
    "trailing_pier_insertion_rule": "If the final reference token is a POI, insertions at source_position == reference_length are attributed to the POI set.",
    "tie_break": "Deterministic implementation-specific backtracking. These vectors avoid ambiguous optimal-alignment ties; tie cases require separate differential fixtures.",
    "compatibility_note": "PIER all-POI references are estimable in the Rust contract; zero-POI references are explicitly non-estimable. This differs from the current reference Python helper's skip behavior for all-POI or no-POI utterances."
  },
