    "true_positives": "Intersection of reference and predicted switch-entry positions.",
    "false_positives": "Predicted switch-entry positions not present in the reference.",
    "false_negatives": "Reference switch-entry positions not predicted.",
    "precision": "TP / (TP + FP), non-estimable if there are no predicted boundaries.",
    "recall": "TP / (TP + FN), non-estimable if there are no reference boundaries.",
    "f1": "2TP / (2TP + FP + FN), non-estimable when both boundary sets are empty."
  },
