{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/voice/voice_experiment_receipt_v1.schema.json",
  "title": "Luminous Speech Experiment Receipt",
  "description": "Reproducibility contract for ASR, code-switch, semantic speech, adaptation and historical-language benchmark experiments. Schema validation checks structure, not truth, rights, execution or scientific validity.",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "evidence_state",
    "synthetic_only",
    "created_at",
    "benchmark",
    "source_admission",
    "inputs",
    "code",
    "model",
    "inference",
    "evaluation",
    "statistics",
    "efficiency",
    "controls",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 8
    },
    "evidence_state": {
      "enum": [
        "DESIGN_ONLY",
        "EXECUTED",
        "REPRODUCED",
        "INDEPENDENTLY_VERIFIED",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "synthetic_only": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes_receipt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_receipt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "benchmark": {
      "type": "object",
      "required": [
        "track_id",
        "manifest_revision",
        "manifest_sha256",
        "task",
        "evaluation_protocol_revision"
      ],
      "properties": {
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_revision": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_protocol_revision": {
          "type": "string",
          "minLength": 1
        },
        "primary_claim": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "source_admission": {
      "type": "object",
      "required": [
        "status",
        "governance_issue",
        "purpose",
        "sources"
      ],
      "properties": {
        "status": {
          "enum": [
            "APPROVED",
            "RESTRICTED",
            "BLOCKED",
            "NOT_REVIEWED",
            "SYNTHETIC_ONLY"
          ]
        },
        "governance_issue": {
          "type": "integer",
          "minimum": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "permission_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dataset_id",
              "revision",
              "config",
              "split",
              "status"
            ],
            "properties": {
              "dataset_id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "config": {
                "type": "string"
              },
              "split": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "APPROVED",
                  "RESTRICTED",
                  "BLOCKED",
                  "NOT_REVIEWED",
                  "SYNTHETIC_ONLY"
                ]
              },
              "file_manifest_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "source_genealogy_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "permitted_purpose_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "speaker_identity_prohibited": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": [
        "utterance_count",
        "audio_duration_seconds",
        "input_manifest_sha256",
        "excluded_count",
        "failed_count",
        "split_units",
        "leakage_audit"
      ],
      "properties": {
        "utterance_count": {
          "type": "integer",
          "minimum": 0
        },
        "audio_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "input_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "excluded_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "split_units": {
          "type": "array",
          "items": {
            "enum": [
              "speaker",
              "session",
              "source_collection",
              "source_program",
              "recordist",
              "domain",
              "device",
              "derivative_family",
              "witness",
              "edition"
            ]
          }
        },
        "split_disjointness_audit": {
          "type": [
            "string",
            "null"
          ]
        },
        "leakage_audit": {
          "type": "object",
          "required": [
            "status",
            "details_ref"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "NOT_RUN",
                "NOT_APPLICABLE",
                "UNKNOWN"
              ]
            },
            "details_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "duplicate_scan_revision": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "required": [
        "repository",
        "commit_sha",
        "dirty_tree",
        "pipeline_config_sha256"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "dirty_tree": {
          "type": "boolean"
        },
        "pipeline_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "container_or_environment_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependency_lock_sha256": {
          "type": [
            "string",
            "null"
          ],
          "allOf": [
            {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/sha256"
                }
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "provider",
        "model_id",
        "model_revision",
        "checkpoint_sha256",
        "tokenizer_revision",
        "architecture",
        "parameter_count"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_sha256": {
          "type": [
            "string",
            "null"
          ],
          "allOf": [
            {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/sha256"
                }
              ]
            }
          ]
        },
        "tokenizer_revision": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "parameter_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "adapter_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter_sha256": {
          "type": [
            "string",
            "null"
          ],
          "allOf": [
            {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/sha256"
                }
              ]
            }
          ]
        },
        "trainable_parameter_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "quantization": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "type": "string",
          "minLength": 1
        },
        "language_support_claim": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "required": [
        "language_input_mode",
        "language_id_system",
        "preprocessing_revision",
        "sample_rate_hz",
        "channel_policy",
        "resampling_policy",
        "decoder_config_sha256",
        "prompt_sha256",
        "chunk_schedule",
        "streaming"
      ],
      "properties": {
        "language_input_mode": {
          "enum": [
            "ORACLE",
            "PROVIDED",
            "PREDICTED",
            "OPEN_SET",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "language_id_system": {
          "type": [
            "string",
            "null"
          ]
        },
        "preprocessing_revision": {
          "type": "string",
          "minLength": 1
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1
        },
        "channel_policy": {
          "type": "string",
          "minLength": 1
        },
        "resampling_policy": {
          "type": "string",
          "minLength": 1
        },
        "decoder_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "allOf": [
            {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/sha256"
                }
              ]
            }
          ]
        },
        "chunk_schedule": {
          "type": "object",
          "required": [
            "chunk_ms",
            "overlap_ms",
            "endpointing"
          ],
          "properties": {
            "chunk_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "overlap_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "endpointing": {
              "type": "string",
              "minLength": 1
            },
            "vad_revision": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "streaming": {
          "type": "boolean"
        },
        "provider_api_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "provider_region": {
          "type": [
            "string",
            "null"
          ]
        },
        "retention_policy_snapshot_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "price_basis_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": [
        "scorer_revision",
        "normalization_revision",
        "tokenization_revision",
        "alignment_policy_revision",
        "reference_revision",
        "metrics",
        "non_estimable"
      ],
      "properties": {
        "scorer_revision": {
          "type": "string",
          "minLength": 1
        },
        "normalization_revision": {
          "type": "string",
          "minLength": 1
        },
        "tokenization_revision": {
          "type": "string",
          "minLength": 1
        },
        "alignment_policy_revision": {
          "type": "string",
          "minLength": 1
        },
        "reference_revision": {
          "type": "string",
          "minLength": 1
        },
        "annotation_adjudication_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "annotator_agreement": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "unit",
              "numerator",
              "denominator",
              "value",
              "estimable"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "numerator": {
                "type": [
                  "integer",
                  "number"
                ],
                "minimum": 0
              },
              "denominator": {
                "type": [
                  "integer",
                  "number"
                ],
                "minimum": 0
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "estimable": {
                "type": "boolean"
              },
              "non_estimable_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "aggregation": {
                "enum": [
                  "MICRO",
                  "MACRO",
                  "PER_UTTERANCE",
                  "PER_GROUP",
                  "NOT_APPLICABLE"
                ]
              },
              "group_key": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "non_estimable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "metric",
              "count",
              "reason"
            ],
            "properties": {
              "metric": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "per_group_metrics_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "statistics": {
      "type": "object",
      "required": [
        "cluster_unit",
        "method",
        "seed",
        "replicates",
        "confidence_level",
        "multiplicity_policy",
        "paired_comparison"
      ],
      "properties": {
        "cluster_unit": {
          "enum": [
            "speaker",
            "session",
            "source_collection",
            "source_program",
            "witness",
            "utterance",
            "none",
            "NOT_ESTIMATED"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "replicates": {
          "type": "integer",
          "minimum": 0
        },
        "confidence_level": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "multiplicity_policy": {
          "type": "string",
          "minLength": 1
        },
        "paired_comparison": {
          "type": "boolean"
        },
        "comparison_receipt_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "efficiency": {
      "type": "object",
      "required": [
        "execution_mode",
        "hardware",
        "measurement_method",
        "latency_ms",
        "rtfx",
        "peak_ram_bytes",
        "peak_vram_bytes",
        "energy_joules",
        "cost"
      ],
      "properties": {
        "execution_mode": {
          "enum": [
            "LOCAL_OFFLINE",
            "REMOTE_API",
            "HYBRID",
            "SYNTHETIC_ONLY",
            "NOT_RUN"
          ]
        },
        "hardware": {
          "type": "object",
          "required": [
            "accelerator",
            "driver",
            "cpu",
            "memory_bytes"
          ],
          "properties": {
            "accelerator": {
              "type": [
                "string",
                "null"
              ]
            },
            "driver": {
              "type": [
                "string",
                "null"
              ]
            },
            "cpu": {
              "type": [
                "string",
                "null"
              ]
            },
            "memory_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "measurement_method": {
          "type": "string",
          "minLength": 1
        },
        "latency_ms": {
          "type": "object",
          "required": [
            "p50",
            "p95",
            "p99"
          ],
          "properties": {
            "p50": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "p95": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "p99": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "rtfx": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peak_ram_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "peak_vram_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "energy_joules": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "required": [
        "baseline_receipt_ids",
        "ablations",
        "negative_controls",
        "calibration_status",
        "claim_limits"
      ],
      "properties": {
        "baseline_receipt_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ablations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negative_controls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "expected",
              "observed",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "observed": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_RUN",
                  "BLOCKED"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "calibration_status": {
          "enum": [
            "CALIBRATED",
            "UNCALIBRATED",
            "NOT_APPLICABLE",
            "NOT_RUN"
          ]
        },
        "selective_risk_coverage_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": [
        "prediction_manifest_sha256",
        "logs_sha256",
        "scorer_output_sha256",
        "artifact_refs"
      ],
      "properties": {
        "prediction_manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "allOf": [
            {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/sha256"
                }
              ]
            }
          ]
        },
        "logs_sha256": {
          "type": [
            "string",
            "null"
          ],
          "allOf": [
            {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/sha256"
                }
              ]
            }
          ]
        },
        "scorer_output_sha256": {
          "type": [
            "string",
            "null"
          ],
          "allOf": [
            {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/sha256"
                }
              ]
            }
          ]
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    }
  },
  "additionalProperties": false
}
