{
  "schema_version": "0.1.0",
  "evidence_state": "SYNTHETIC_ONLY",
  "description": "Hand-computed token-level examples for conventional WER, PIER, SETER and SPER@k. These vectors are metric fixtures, not speech data or language evidence.",
  "token_indexing": "zero_based",
  "alignment_policy": "Use deterministic Levenshtein alignment from symthaea-stt::eval::levenshtein_align. The exact tie-break behaviour is implementation-specific and must be differentially checked before asserting RapidFuzz parity.",
  "normalization_policy": "No normalization, case folding, transliteration or diacritic stripping occurs in these fixtures or metrics. Tokens are compared exactly.",
  "metric_definitions": {
    "wer": "(substitutions + deletions + insertions) / reference_token_count",
    "pier": "100 * (POI substitutions + POI deletions + POI-attributed insertions) / (POI hits + POI substitutions + POI deletions)",
    "seter": "(substitutions + deletions at switch-entry reference positions) / number of switch-entry positions",
    "sper_at_k": "(substitutions + deletions over the union of reference positions within radius k of any switch entry) / number of selected reference positions",
    "switch_entry": "Reference position i > 0 where language_tags[i] differs from language_tags[i-1]",
    "insertion_policy": "Insertions count in WER. PIER attributes insertion operations using reference/source positions and the documented final-POI trailing rule. SETER/SPER do not attribute insertions to reference positions."
  },
