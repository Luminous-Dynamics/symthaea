{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/rea-proof-obligation-acquisition-grader-v0.schema.json",
  "title": "REA proof-obligation acquisition grader-only fixture v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "status",
    "source_policy",
    "access_policy",
    "not_human_adjudicated",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "dataset_id": {
      "const": "rea-proof-obligation-acquisition"
    },
    "status": {
      "const": "design_fixture_only"
    },
    "source_policy": {
      "const": "grader_only_synthetic_labels"
    },
    "access_policy": {
      "const": "never_mount_in_agent_workspace"
    },
    "not_human_adjudicated": {
      "const": true
    },
    "cases": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "satisfied",
        "unsatisfied",
        "conflicted",
        "unknown",
        "incomplete",
        "contradicted"
      ]
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "obligation_id",
        "resulting_status",
        "evidence_class",
        "source_family_id"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "obligation_id": {
          "type": "string",
          "minLength": 2
        },
        "resulting_status": {
          "$ref": "#/$defs/status"
        },
        "evidence_class": {
          "type": "string",
          "minLength": 2
        },
        "source_family_id": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_candidate_id",
        "readiness_after",
        "blocking_obligations",
        "rationale"
      ],
      "properties": {
        "preferred_candidate_id": {
          "type": "string",
          "minLength": 2
        },
        "readiness_after": {
          "type": "string",
          "minLength": 2
        },
        "blocking_obligations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "candidateEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "effects"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "minLength": 2
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "world_state_oracle",
        "expected_policy",
        "candidate_effects"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^REA-POA-[0-9]{3}$"
        },
        "world_state_oracle": {
          "type": "string",
          "minLength": 2
        },
        "expected_policy": {
          "$ref": "#/$defs/policy"
        },
        "candidate_effects": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/candidateEffects"
          }
        }
      }
    }
  }
}
