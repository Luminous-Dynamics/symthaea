{
  "schema_version": "beverage-engineering-scenarios-v1",
  "status": "synthetic_contract_fixtures_not_beverage_measurements",
  "description": "Synthetic evaluator scenarios for leakage resistance, evidence separation, uncertainty, and cross-beverage claim discipline. No row represents a real production batch.",
