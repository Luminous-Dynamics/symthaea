  "scenarios": [
    {
      "id": "BEV-001",
      "name": "beer_trajectory_positive_control",
      "product": "beer",
      "task": "trajectory_forecast",
      "evidence_class": "MEASURED_INPUTS_WITH_DECLARED_TARGET",
      "expected_disposition": "ACCEPT_FOR_EVALUATION",
      "guards": [
        "timestamped_inputs",
        "prediction_cutoff",
        "batch_group_split",
        "target_units"
      ],
      "primary_metrics": [
        "MAE_physical_units",
        "RMSE_physical_units"
      ],
      "claim_ceiling": "synthetic fixture; no predictive performance established"
    },
    {
      "id": "BEV-002",
      "name": "post_outcome_feature_leakage",
      "product": "beer",
      "task": "trajectory_forecast",
      "evidence_class": "MIXED",
      "expected_disposition": "REJECT",
      "guards": [
        "no_final_lab_feature_before_cutoff",
        "no_packaging_result_feature",
        "no_post_hoc_quality_label_feature"
      ],
      "primary_metrics": [],
      "claim_ceiling": "leakage rejection only"
    },
    {
