{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:development-map:0.1.0",
  "title": "Evidence-Grounded Dynamical Development Map snapshot",
  "description": "Provisional v0.1 contract. Describes a revision-scoped graph snapshot; not an execution receipt, authority grant, or proof that claims are true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "map_id",
    "repository",
    "snapshot",
    "extractor",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "map_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_name",
        "visibility"
      ],
      "properties": {
        "canonical_name": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "internal",
            "unknown"
          ]
        },
        "default_branch": {
          "type": "string"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "tree_digest",
        "observed_at",
        "tree_digest_algorithm"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 7
        },
        "tree_digest": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "parent_snapshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_event_high_watermark": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_world": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "boolean",
              "integer",
              "array",
              "null"
            ]
          }
        },
        "tree_digest_algorithm": {
          "enum": [
            "git_tree_oid_sha1",
            "sha256"
          ]
        }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "build_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-f0-9]{64})?$"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "description": "Optional append-only event slice associated with this snapshot. Event replay and immutability are semantic requirements, not enforced by JSON Schema alone.",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uri",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "repository_file",
            "commit",
            "issue",
            "pull_request",
            "workflow_run",
            "benchmark_result",
            "external_document",
            "human_review",
            "other"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})?$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "sources",
        "extracted_by",
        "observed_at"
      ],
      "properties": {
        "authority": {
          "enum": [
            "source_declared",
            "syntax_extracted",
            "manifest_resolved",
            "compiler_resolved",
            "runtime_observed",
            "benchmark_observed",
            "independently_adjudicated",
            "inferred",
            "proposed"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "extracted_by": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^([a-f0-9]{64})?$"
            }
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_for_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_for_world": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "current",
            "stale",
            "superseded",
            "revoked",
            "unknown",
            "missing",
            "disputed"
          ]
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "invalidated_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "claim_state",
        "label",
        "provenance",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "project",
            "workspace",
            "package",
            "crate",
            "module",
            "symbol",
            "interface",
            "configuration_world",
            "dependency",
            "test",
            "benchmark",
            "runtime",
            "deployment",
            "objective",
            "capability",
            "requirement",
            "invariant",
            "decision",
            "hypothesis",
            "milestone",
            "acceptance_criterion",
            "risk",
            "evidence",
            "change_event",
            "development_action",
            "external_system",
            "authority_boundary",
            "domain_cluster",
            "application"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "claim_state": {
          "enum": [
            "observed",
            "inferred",
            "proposed",
            "attempted",
            "passed_local",
            "ci_pending",
            "ci_passed",
            "independently_qualified",
            "rejected",
            "blocked",
            "unknown"
          ]
        },
        "attributes": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "relation",
        "to",
        "provenance",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "contains",
            "exports",
            "imports",
            "depends_on",
            "calls",
            "implements",
            "requires",
            "validates",
            "tested_by",
            "observed_by",
            "introduced_by",
            "removed_by",
            "supersedes",
            "invalidates",
            "affects",
            "blocked_by",
            "contradicts",
            "derived_from",
            "compatible_with",
            "configured_by",
            "built_by",
            "deployed_as"
          ]
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "observed_at",
        "effective_revision",
        "targets",
        "provenance",
        "payload",
        "state_effect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "repository_revision_observed",
            "source_introduced",
            "source_changed",
            "source_removed",
            "contract_changed",
            "configuration_world_changed",
            "test_evidence_recorded",
            "benchmark_evidence_recorded",
            "evidence_invalidated",
            "evidence_superseded",
            "capability_link_changed",
            "decision_recorded",
            "development_action_proposed",
            "development_action_observed",
            "risk_opened",
            "risk_closed"
          ]
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "effective_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,64}$"
        },
        "prior_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-f0-9]{7,64})?$"
        },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "state_effect": {
          "enum": [
            "introduces",
            "changes",
            "invalidates",
            "supersedes",
            "observes",
            "proposes",
            "no_state_change"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "payload": {
          "type": "object"
        },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from_revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "through_revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "world_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "decision_recorded"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/decision_payload"
              }
            }
          }
        }
      ]
    },
    "decision_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "available_to_actor_at",
        "admissibility",
        "reason"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "available_to_actor_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_through": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "admissibility": {
          "enum": [
            "admissible",
            "inadmissible",
            "indeterminate"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_at",
        "knowledge_cutoff_at",
        "actor_id",
        "authority_scope",
        "policy_version",
        "outcome",
        "consulted_evidence",
        "excluded_evidence"
      ],
      "properties": {
        "decision_at": {
          "type": "string",
          "format": "date-time"
        },
        "knowledge_cutoff_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "authority_scope": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "rationale_summary": {
          "type": "string"
        },
        "consulted_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_evidence"
          }
        },
        "excluded_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_evidence"
          }
        },
        "later_corrections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "abstention_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
