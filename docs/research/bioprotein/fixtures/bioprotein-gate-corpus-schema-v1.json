{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/bioprotein/fixtures/bioprotein-gate-corpus-schema-v1.json",
  "title": "Bioprotein synthetic gate corpus",
  "description": "Container schema for synthetic research fixtures. It asserts fixture structure only; it does not validate biological facts, safety, nutrition, costs, or eligibility semantics.",
  "type": "object",
  "required": [
    "corpus_id",
    "schema_version",
    "status",
    "created_at",
    "disclaimer",
    "schema_file",
    "case_schema_file",
    "case_count",
    "cases"
  ],
  "properties": {
    "corpus_id": {
      "const": "BIOPROTEIN-GATE-CORPUS-V1"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "const": "synthetic_design_fixture_only"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "schema_file": {
      "const": "bioprotein-gate-corpus-schema-v1.json"
    },
    "case_schema_file": {
      "const": "bioprotein-gate-schema-v1.json"
    },
    "case_count": {
      "type": "integer",
      "minimum": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "bioprotein-gate-schema-v1.json"
      }
    }
  },
  "additionalProperties": false
}
