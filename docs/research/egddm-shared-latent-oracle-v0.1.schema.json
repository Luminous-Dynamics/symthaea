{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-shared-latent-oracle-v0.1.schema.json",
  "title": "EGDDM D6.17.2.2.3 shared-latent conditional joint-kernel oracle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_cutoff",
    "latent_states",
    "conditional_kernels"
  ],
  "properties": {
    "decision_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "latent_states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "latent_state_id",
          "lower_probability_bps",
          "upper_probability_bps",
          "nominal_probability_bps",
          "authority",
          "valid_from",
          "valid_until",
          "revoked_at"
        ],
        "properties": {
          "latent_state_id": {
            "type": "string",
            "minLength": 1
          },
          "lower_probability_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "upper_probability_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "nominal_probability_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "conditional_kernels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "latent_state_id",
          "kernel_id",
          "authority",
          "valid_from",
          "valid_until",
          "revoked_at",
          "joint_outcomes"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "minLength": 1
          },
          "latent_state_id": {
            "type": "string",
            "minLength": 1
          },
          "kernel_id": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "joint_outcomes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcomes",
                "probability_bps"
              ],
              "properties": {
                "outcomes": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "probability_bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              }
            }
          }
        }
      }
    },
    "risk_queries": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_id",
          "action_id",
          "safe_hypotheses",
          "prior_bounds",
          "observed_outcomes"
        ],
        "properties": {
          "query_id": {
            "type": "string",
            "minLength": 1
          },
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "safe_hypotheses": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prior_bounds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hypothesis_id",
                "lower_probability_bps",
                "upper_probability_bps",
                "nominal_probability_bps"
              ],
              "properties": {
                "hypothesis_id": {
                  "type": "string",
                  "minLength": 1
                },
                "lower_probability_bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "upper_probability_bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "nominal_probability_bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              }
            }
          },
          "observed_outcomes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "decision_voi_queries": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_id",
          "loss_currency",
          "prior_bounds",
          "action_losses",
          "action_constraints",
          "option_costs"
        ],
        "properties": {
          "query_id": {
            "type": "string",
            "minLength": 1
          },
          "loss_currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "prior_bounds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hypothesis_id",
                "lower_probability_bps",
                "upper_probability_bps",
                "nominal_probability_bps"
              ],
              "properties": {
                "hypothesis_id": {
                  "type": "string",
                  "minLength": 1
                },
                "lower_probability_bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "upper_probability_bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "nominal_probability_bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              }
            }
          },
          "action_losses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hypothesis_id",
                "action_id",
                "loss_micros"
              ],
              "properties": {
                "hypothesis_id": {
                  "type": "string"
                },
                "action_id": {
                  "type": "string"
                },
                "loss_micros": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000
                }
              }
            }
          },
          "action_constraints": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action_id",
                "read_only",
                "irreversible",
                "hard_gate",
                "max_residual_risk_bps",
                "safe_hypotheses"
              ],
              "properties": {
                "action_id": {
                  "type": "string"
                },
                "read_only": {
                  "type": "boolean"
                },
                "irreversible": {
                  "type": "boolean"
                },
                "hard_gate": {
                  "type": "boolean"
                },
                "max_residual_risk_bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "safe_hypotheses": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "option_costs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "option_id",
                "cost_micros"
              ],
              "properties": {
                "option_id": {
                  "type": "string"
                },
                "cost_micros": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
