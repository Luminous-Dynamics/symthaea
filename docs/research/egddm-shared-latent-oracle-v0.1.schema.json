{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-shared-latent-oracle-v0.1.schema.json",
  "title": "EGDDM D6.17.2.2.3 shared-latent conditional joint-kernel oracle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_cutoff",
    "latent_states",
    "conditional_kernels"
  ],
  "properties": {
    "decision_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "latent_states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "latent_state_id",
          "lower_probability_bps",
          "upper_probability_bps",
          "nominal_probability_bps",
          "authority",
          "valid_from",
          "valid_until",
          "revoked_at"
        ],
        "properties": {
          "latent_state_id": {
            "type": "string",
            "minLength": 1
          },
          "lower_probability_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "upper_probability_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "nominal_probability_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "conditional_kernels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "latent_state_id",
          "kernel_id",
          "authority",
          "valid_from",
          "valid_until",
          "revoked_at",
          "joint_outcomes"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "minLength": 1
          },
          "latent_state_id": {
            "type": "string",
            "minLength": 1
          },
          "kernel_id": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "joint_outcomes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcomes",
                "probability_bps"
              ],
              "properties": {
                "outcomes": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "probability_bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              }
            }
          }
        }
      }
    }
  }
}
