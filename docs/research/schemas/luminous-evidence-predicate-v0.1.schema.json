{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/evidence-predicate-v0.1.schema.json",
  "title": "Luminous Evidence Profile predicate v0.1",
  "description": "Domain-neutral evidence metadata intended as a custom predicate on an in-toto Statement. This schema validates structure only; target binding, claim semantics, signatures, and artifact contents require separate verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "claim", "target", "execution", "verification", "evidence", "limitations"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "statement", "scope"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "enum": ["normative", "implementation", "test_result", "measurement", "simulation", "inference", "hypothesis", "aspiration"] },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "target": { "$ref": "#/$defs/target" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "result", "runId"],
      "properties": {
        "status": { "enum": ["not_run", "queued", "running", "completed", "failed", "cancelled"] },
        "result": { "enum": ["not_run", "passed", "failed", "inconclusive"] },
        "runId": { "type": ["string", "null"], "maxLength": 300 },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "finishedAt": { "type": ["string", "null"], "format": "date-time" },
        "runner": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["not_run", "queued", "running", "cancelled"] } }, "required": ["status"] },
          "then": { "properties": { "result": { "const": "not_run" } } }
        },
        {
          "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": { "properties": { "result": { "enum": ["passed", "failed", "inconclusive"] } } }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": { "properties": { "result": { "enum": ["failed", "inconclusive", "not_run"] } } }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "verifier", "checkedTarget", "checks"],
      "properties": {
        "outcome": { "enum": ["not_run", "passed", "failed", "inconclusive"] },
        "verifier": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "checkedTarget": { "oneOf": [{ "$ref": "#/$defs/target" }, { "type": "null" }] },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "passed" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "verifier": { "type": "object" },
              "checkedTarget": { "$ref": "#/$defs/target" },
              "checks": {
                "minItems": 1,
                "items": {
                  "properties": { "outcome": { "const": "passed" } },
                  "required": ["outcome"]
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "not_run" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "verifier": { "type": "null" },
              "checkedTarget": { "type": "null" },
              "checks": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension keys only; extensions cannot alter core field semantics.",
      "propertyNames": { "pattern": "^https://[^ ]+$" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verification": { "properties": { "outcome": { "const": "passed" } }, "required": ["outcome"] } }, "required": ["verification"] },
      "then": {
        "properties": {
          "execution": {
            "properties": { "status": { "const": "completed" }, "result": { "const": "passed" } },
            "required": ["status", "result"]
          }
        }
      }
    }
  ],
  "$defs": {
    "digestSet": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$" },
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sha512": { "type": "string", "pattern": "^[a-f0-9]{128}$" },
        "blake3": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]+$" }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "configurationDigest", "inputs"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "revision"],
          "properties": {
            "repository": { "type": "string", "format": "uri" },
            "revision": { "type": "string", "minLength": 7, "maxLength": 128, "pattern": "^[A-Za-z0-9._/-]+$" }
          }
        },
        "configurationDigest": { "$ref": "#/$defs/digestSet" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["source", "configuration", "dataset_manifest", "raw_result", "test_report", "measurement", "simulation_trace", "log", "certificate", "other"] },
        "uri": { "type": "string", "format": "uri" },
        "mediaType": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digestSet" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["passed", "failed", "inconclusive", "not_run"] },
        "details": { "type": "string", "maxLength": 2000 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
      }
    }
  }
}