{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/research/hlb-memory-engine-20261107/docs/research/schemas/hme_query_receipt_v0.schema.json",
  "title": "HME Query Receipt v0",
  "description": "Structural schema for bounded HME query results. Cross-field candidate-count arithmetic and exactness claims require an independent semantic verifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query",
    "generation",
    "eligibility",
    "requested",
    "status",
    "stop_reason",
    "resource_usage",
    "candidate_accounting",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "payload_sha256",
        "representation",
        "dimension",
        "metric",
        "score_contract_id",
        "top_k",
        "tie_policy"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "minLength": 1
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "representation": {
          "enum": [
            "continuous_f32",
            "binary_packed"
          ]
        },
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "metric": {
          "enum": [
            "cosine",
            "hamming_similarity"
          ]
        },
        "score_contract_id": {
          "type": "string",
          "minLength": 1
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "tie_policy": {
          "const": "score_desc_item_id_asc"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_generation",
        "manifest_sha256"
      ],
      "properties": {
        "segment_generation": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactness",
        "resource_budget"
      ],
      "properties": {
        "exactness": {
          "enum": [
            "exact_only",
            "approximate_allowed",
            "best_effort"
          ]
        },
        "approximation_profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "resource_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_candidate_evaluations",
            "max_payload_bytes",
            "max_coordinates"
          ],
          "properties": {
            "max_candidate_evaluations": {
              "type": "integer",
              "minimum": 0
            },
            "max_payload_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "max_coordinates": {
              "type": "integer",
              "minimum": 0
            },
            "deadline_unix_ns": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "ExactComplete",
        "ApproximateComplete",
        "Incomplete",
        "UnavailableOrInvalid"
      ]
    },
    "stop_reason": {
      "enum": [
        "Completed",
        "BudgetExhausted",
        "DeadlineReached",
        "Cancelled",
        "StaleGeneration",
        "CorruptSegment",
        "InvalidProfile",
        "NumericalUncertainty",
        "ResourceAdmissionFailed"
      ]
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_evaluations",
        "payload_bytes_inspected",
        "coordinates_evaluated",
        "elapsed_ns",
        "peak_temporary_bytes"
      ],
      "properties": {
        "candidate_evaluations": {
          "type": "integer",
          "minimum": 0
        },
        "payload_bytes_inspected": {
          "type": "integer",
          "minimum": 0
        },
        "coordinates_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ns": {
          "type": "integer",
          "minimum": 0
        },
        "peak_temporary_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "candidate_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_count",
        "fully_scored_count",
        "safely_pruned_count",
        "approximate_candidates_scored_count",
        "excluded_by_approximate_policy_count",
        "unprocessed_count"
      ],
      "properties": {
        "eligible_count": {
          "type": "integer",
          "minimum": 0
        },
        "fully_scored_count": {
          "type": "integer",
          "minimum": 0
        },
        "safely_pruned_count": {
          "type": "integer",
          "minimum": 0
        },
        "approximate_candidates_scored_count": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_by_approximate_policy_count": {
          "type": "integer",
          "minimum": 0
        },
        "unprocessed_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "approximation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "quality_receipt_id",
        "candidate_policy_completed",
        "exact_rerank"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "quality_receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_policy_completed": {
          "type": "boolean"
        },
        "exact_rerank": {
          "type": "boolean"
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "item_id",
          "score",
          "score_kind",
          "provisional"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number"
          },
          "score_kind": {
            "enum": [
              "exact",
              "approximate"
            ]
          },
          "provisional": {
            "type": "boolean"
          }
        }
      }
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_sha256",
        "authorization_generation",
        "source_ledger_generation",
        "valid_at",
        "known_at",
        "principal_scope_sha256",
        "hme_manifest_sha256",
        "physical_count",
        "eligible_count",
        "excluded_count",
        "primary_exclusion_counts",
        "exclusion_set_sha256",
        "payload_reads_for_excluded_count",
        "snapshot_consistent"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authorization_generation": {
          "type": "integer",
          "minimum": 0
        },
        "source_ledger_generation": {
          "type": "integer",
          "minimum": 0
        },
        "valid_at": {
          "type": "string",
          "format": "date-time"
        },
        "known_at": {
          "type": "string",
          "format": "date-time"
        },
        "principal_scope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "hme_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "physical_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_count": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_count": {
          "type": "integer",
          "minimum": 0
        },
        "primary_exclusion_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outside_valid_time",
            "not_known_at_known_time",
            "retracted_or_superseded",
            "quarantined",
            "out_of_scope",
            "unauthorized_or_revoked",
            "forgotten_from_active_index",
            "privacy_erased_or_unavailable",
            "retention_expired",
            "invalid_metadata"
          ],
          "properties": {
            "outside_valid_time": {
              "type": "integer",
              "minimum": 0
            },
            "not_known_at_known_time": {
              "type": "integer",
              "minimum": 0
            },
            "retracted_or_superseded": {
              "type": "integer",
              "minimum": 0
            },
            "quarantined": {
              "type": "integer",
              "minimum": 0
            },
            "out_of_scope": {
              "type": "integer",
              "minimum": 0
            },
            "unauthorized_or_revoked": {
              "type": "integer",
              "minimum": 0
            },
            "forgotten_from_active_index": {
              "type": "integer",
              "minimum": 0
            },
            "privacy_erased_or_unavailable": {
              "type": "integer",
              "minimum": 0
            },
            "retention_expired": {
              "type": "integer",
              "minimum": 0
            },
            "invalid_metadata": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "exclusion_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload_reads_for_excluded_count": {
          "const": 0
        },
        "snapshot_consistent": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ExactComplete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stop_reason": {
            "const": "Completed"
          },
          "candidate_accounting": {
            "properties": {
              "approximate_candidates_scored_count": {
                "const": 0
              },
              "excluded_by_approximate_policy_count": {
                "const": 0
              },
              "unprocessed_count": {
                "const": 0
              }
            }
          },
          "results": {
            "items": {
              "properties": {
                "score_kind": {
                  "const": "exact"
                },
                "provisional": {
                  "const": false
                }
              }
            }
          }
        },
        "not": {
          "required": [
            "approximation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ApproximateComplete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "approximation"
        ],
        "properties": {
          "stop_reason": {
            "const": "Completed"
          },
          "candidate_accounting": {
            "properties": {
              "unprocessed_count": {
                "const": 0
              }
            }
          },
          "approximation": {
            "properties": {
              "candidate_policy_completed": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "Incomplete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stop_reason": {
            "enum": [
              "BudgetExhausted",
              "DeadlineReached",
              "Cancelled",
              "NumericalUncertainty"
            ]
          },
          "results": {
            "items": {
              "properties": {
                "provisional": {
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "UnavailableOrInvalid"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stop_reason": {
            "enum": [
              "StaleGeneration",
              "CorruptSegment",
              "InvalidProfile",
              "ResourceAdmissionFailed"
            ]
          },
          "results": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ExactComplete",
              "ApproximateComplete"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "eligibility": {
            "properties": {
              "snapshot_consistent": {
                "const": true
              },
              "payload_reads_for_excluded_count": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query": {
            "properties": {
              "representation": {
                "const": "continuous_f32"
              },
              "metric": {
                "const": "cosine"
              }
            },
            "required": [
              "representation",
              "metric"
            ]
          }
        },
        "required": [
          "query"
        ]
      },
      "then": {
        "properties": {
          "query": {
            "properties": {
              "score_contract_id": {
                "const": "continuous_hv_cosine_full_f32_group8_v1"
              }
            }
          }
        }
      }
    }
  ],
  "x-semantic-invariants": [
    "ExactComplete requires fully_scored_count + safely_pruned_count == eligible_count.",
    "ExactComplete requires unprocessed_count == 0 and both approximate/excluded counts == 0.",
    "ApproximateComplete is never an exactness claim, even when the candidate policy happens to examine every item.",
    "Incomplete best-so-far results are provisional and must never be promoted to completed top-k.",
    "UnavailableOrInvalid must not return memory payloads or silently fall back to an unqualified query path.",
    "Counts must be reconciled against the pinned manifest and active eligibility filters by an independent verifier.",
    "A receipt digest binds fields; it does not prove that a pruning bound or residual certificate is mathematically valid.",
    "eligibility.physical_count == eligibility.eligible_count + eligibility.excluded_count.",
    "The sum of mutually exclusive primary_exclusion_counts equals eligibility.excluded_count.",
    "eligibility.eligible_count == candidate_accounting.eligible_count.",
    "eligibility.hme_manifest_sha256 equals generation.manifest_sha256.",
    "ExactComplete and ApproximateComplete require a consistent pinned eligibility snapshot; stale or unavailable policy generations fail closed.",
    "payload_reads_for_excluded_count must be zero; filtering by scope, valid/known time, revocation, tombstone and retention happens before payload access.",
    "Excluded item identities/reasons are not exposed to principals lacking permission to inspect them; exclusion_set_sha256 is not a proof of policy correctness.",
    "Query exclusion, logical forgetting, physical purge and cryptographic erasure are distinct lifecycle states.",
    "For continuous_f32 + cosine, query.score_contract_id must be continuous_hv_cosine_full_f32_group8_v1; the identifier pins full-coordinate f32 group-of-eight accumulation and the declared near-zero denominator rule.",
    "ContinuousHV payload and query admission for this score contract rejects non-finite components and components outside the closed interval [-1, 1] before score evaluation; invalid vectors are unavailable/invalid, not silently sanitized."
  ]
}
