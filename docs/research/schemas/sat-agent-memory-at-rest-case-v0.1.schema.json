{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/sat/schemas/agent-memory-at-rest-case/0.1",
  "title": "SAT Agent Memory-at-Rest Native Case Adapter v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "upstream_case",
    "test_kind",
    "family",
    "description",
    "procedure",
    "mutation",
    "expected"
  ],
  "properties": {
    "schema_version": {
      "const": "sat-agent-memory-at-rest-case/v0.1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^SAT-MAR-(T([1-9]|10)|C[1-3])$"
    },
    "upstream_case": {
      "type": "string",
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6",
        "T7",
        "T8",
        "T9",
        "T10",
        "C1",
        "C2",
        "C3"
      ]
    },
    "test_kind": {
      "type": "string",
      "enum": [
        "native_edit",
        "mandatory_control"
      ]
    },
    "family": {
      "type": "string",
      "enum": [
        "content_tamper",
        "tail_truncation",
        "middle_deletion",
        "reordering",
        "forged_insertion",
        "cross_context_replay",
        "rollback_replay",
        "metadata_tamper",
        "whole_store_rollback",
        "erasure_resurrection",
        "no_op_reload_control",
        "genuine_write_control",
        "edit_landed_control"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 12,
      "maxLength": 500
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sut_stopped_before_edit",
        "mutation_tool",
        "restart_before_observation",
        "observation_path"
      ],
      "properties": {
        "sut_stopped_before_edit": {
          "type": "boolean"
        },
        "mutation_tool": {
          "type": "string",
          "enum": [
            "generic_storage_tool_no_sut_code",
            "sut_write_path",
            "sut_erasure_interface",
            "none"
          ]
        },
        "restart_before_observation": {
          "type": "boolean"
        },
        "observation_path": {
          "type": "string",
          "enum": [
            "sut_read_path",
            "sut_audit_path",
            "raw_store_snapshot",
            "sut_read_path_and_store_snapshot"
          ]
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "target",
        "requirements",
        "whole_store_restore"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "replace_content",
            "delete_tail",
            "delete_middle",
            "swap_order",
            "insert_record",
            "cross_context_replay",
            "rollback_record",
            "change_metadata",
            "restore_pre_write_store",
            "restore_pre_erasure_store",
            "no_op",
            "write_genuine_record",
            "compare_pre_post_store"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "whole_store_restore": {
          "type": "boolean"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict_requirement",
        "detection_points",
        "edit_landed_required",
        "counts_in_native_denominator",
        "control_effect"
      ],
      "properties": {
        "verdict_requirement": {
          "type": "string",
          "enum": [
            "REJECTED_OR_REPORTED",
            "SERVE_UNCHANGED_WITHOUT_SIGNAL",
            "SERVE_NEW_RECORD",
            "EXACT_EDIT_LANDED",
            "NOT_SCORED"
          ]
        },
        "detection_points": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "read",
              "audit",
              "none"
            ]
          }
        },
        "edit_landed_required": {
          "type": "boolean"
        },
        "counts_in_native_denominator": {
          "type": "boolean"
        },
        "control_effect": {
          "type": "string",
          "enum": [
            "none",
            "invalidate_campaign_if_failed",
            "case_error_excluded_if_failed"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "test_kind": {
            "const": "native_edit"
          }
        },
        "required": [
          "test_kind"
        ]
      },
      "then": {
        "properties": {
          "procedure": {
            "properties": {
              "sut_stopped_before_edit": {
                "const": true
              },
              "mutation_tool": {
                "const": "generic_storage_tool_no_sut_code"
              },
              "restart_before_observation": {
                "const": true
              }
            }
          },
          "expected": {
            "properties": {
              "verdict_requirement": {
                "const": "REJECTED_OR_REPORTED"
              },
              "edit_landed_required": {
                "const": true
              },
              "counts_in_native_denominator": {
                "const": true
              },
              "control_effect": {
                "const": "case_error_excluded_if_failed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "test_kind": {
            "const": "mandatory_control"
          }
        },
        "required": [
          "test_kind"
        ]
      },
      "then": {
        "properties": {
          "expected": {
            "properties": {
              "counts_in_native_denominator": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
