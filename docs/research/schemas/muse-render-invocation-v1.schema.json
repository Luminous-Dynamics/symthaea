{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/schemas/muse-render-invocation-v1.schema.json",
  "title": "MUSE Render Invocation v1",
  "description": "Structured, content-bound record of the renderer process invocation. It records claimed execution inputs/outputs but is not by itself trusted process attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attempt_id",
    "renderer_id",
    "renderer_version",
    "executable_sha256",
    "environment_sha256",
    "configuration_sha256",
    "asset_sha256",
    "input_midi_path",
    "input_midi_sha256",
    "output_audio_path",
    "output_audio_sha256",
    "arguments",
    "started_at",
    "finished_at",
    "exit_code"
  ],
  "properties": {
    "schema": {
      "const": "muse-render-invocation-v1"
    },
    "renderer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "renderer_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asset_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_midi_path": {
      "const": "performance.mid"
    },
    "input_midi_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_audio_path": {
      "const": "output.wav"
    },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 2048
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "exit_code": {
      "type": "integer"
    },
    "output_audio_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
