{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:mel-closed-loop-episode-v1",
  "title": "Melothaea closed-loop musical interaction episode v1",
  "description": "A join envelope for existing forecast, musician-disposition, action-effect, capture-closure and event-observer receipts. This schema does not authenticate or independently verify those receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "episode_id",
    "session",
    "execution_identity",
    "forecast",
    "disposition",
    "decision",
    "effect",
    "capture",
    "observation",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "mel-closed-loop-episode-v1"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "turn_id",
        "input_sequence",
        "target_window"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "turn_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "input_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "target_window": {
          "$ref": "#/$defs/time_window"
        }
      }
    },
    "execution_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "policy_id",
        "policy_version",
        "backend_id",
        "identity_sha256",
        "configuration_sha256",
        "adapter_sha256",
        "runtime_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "production_model",
            "synthetic_rule_fixture"
          ]
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "backend_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_artifact_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tokenizer_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "adapter_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "production_model"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "model_artifact_sha256": {
                "$ref": "#/$defs/sha256"
              }
            },
            "required": [
              "model_artifact_sha256"
            ]
          }
        }
      ]
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forecast_id",
        "revision",
        "committed_sequence",
        "input_through_sequence",
        "target_window",
        "expires_at_sequence",
        "uncertainty",
        "receipt"
      ],
      "properties": {
        "forecast_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "committed_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "input_through_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "target_window": {
          "$ref": "#/$defs/time_window"
        },
        "expires_at_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "uncertainty": {
          "enum": [
            "calibrated",
            "uncalibrated",
            "unavailable"
          ]
        },
        "receipt": {
          "$ref": "#/$defs/receipt_ref"
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "forecast_id",
        "forecast_revision",
        "sequence",
        "actor_identity",
        "scope_sha256",
        "receipt"
      ],
      "properties": {
        "action": {
          "enum": [
            "accept",
            "steer",
            "veto",
            "branch",
            "ignore",
            "clarify",
            "abstain"
          ]
        },
        "forecast_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "forecast_revision": {
          "type": "integer",
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "actor_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "superseding_forecast_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "receipt": {
          "$ref": "#/$defs/receipt_ref"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "steer"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "superseding_forecast_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "superseding_forecast_id"
            ]
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "sequence",
        "observed_through_input_sequence",
        "forecast_id",
        "forecast_revision",
        "receipt"
      ],
      "properties": {
        "action": {
          "enum": [
            "WAIT",
            "RESPOND",
            "CONTINUE",
            "YIELD"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "observed_through_input_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "forecast_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "forecast_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "receipt": {
          "$ref": "#/$defs/receipt_ref"
        }
      }
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reported_stage",
            "forecast_id",
            "forecast_revision",
            "decision_sequence",
            "producer_identity",
            "receipt",
            "capture_id"
          ],
          "properties": {
            "reported_stage": {
              "enum": [
                "not_requested",
                "authorized",
                "queue_applied",
                "application_enqueued",
                "callback_observed",
                "cpal_predicted",
                "loopback_observed",
                "not_applied",
                "outcome_unknown"
              ]
            },
            "forecast_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "forecast_revision": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "decision_sequence": {
              "type": "integer",
              "minimum": 0
            },
            "producer_identity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "output_artifact_sha256": {
              "$ref": "#/$defs/nullable_sha256"
            },
            "receipt": {
              "$ref": "#/$defs/receipt_ref"
            },
            "capture_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "veto_race": {
              "$ref": "#/$defs/veto_race"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "reported_stage": {
                    "const": "loopback_observed"
                  }
                },
                "required": [
                  "reported_stage"
                ]
              },
              "then": {
                "properties": {
                  "capture_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "capture_id"
                ]
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "capture_id",
        "payload_sha256",
        "recorder_identity",
        "target_window",
        "reported_closure",
        "sequence_accounting",
        "frame_accounting",
        "heartbeat_accounting",
        "terminal_watermark",
        "receipt"
      ],
      "properties": {
        "capture_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "recorder_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target_window": {
          "$ref": "#/$defs/time_window"
        },
        "reported_closure": {
          "enum": [
            "eligible",
            "ineligible",
            "unknown"
          ]
        },
        "sequence_accounting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected",
            "observed",
            "missing",
            "duplicate"
          ],
          "properties": {
            "expected": {
              "type": "integer",
              "minimum": 0
            },
            "observed": {
              "type": "integer",
              "minimum": 0
            },
            "missing": {
              "type": "integer",
              "minimum": 0
            },
            "duplicate": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "frame_accounting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected",
            "observed",
            "dropped",
            "xrun_count"
          ],
          "properties": {
            "expected": {
              "type": "integer",
              "minimum": 0
            },
            "observed": {
              "type": "integer",
              "minimum": 0
            },
            "dropped": {
              "type": "integer",
              "minimum": 0
            },
            "xrun_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "terminal_watermark": {
          "type": "integer",
          "minimum": 0
        },
        "receipt": {
          "$ref": "#/$defs/receipt_ref"
        },
        "source_kind": {
          "enum": [
            "rendered_audio_loopback",
            "midi_output_monitor"
          ]
        },
        "heartbeat_accounting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected",
            "observed",
            "missing",
            "duplicate"
          ],
          "properties": {
            "expected": {
              "type": "integer",
              "minimum": 0
            },
            "observed": {
              "type": "integer",
              "minimum": 0
            },
            "missing": {
              "type": "integer",
              "minimum": 0
            },
            "duplicate": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detector_result",
        "capture_id",
        "capture_payload_sha256",
        "observer_identity",
        "detector_build_sha256",
        "detector_config_sha256",
        "qualification_status",
        "qualification_receipt",
        "receipt"
      ],
      "properties": {
        "detector_result": {
          "enum": [
            "present",
            "absent",
            "ambiguous",
            "not_estimable",
            "unobserved"
          ]
        },
        "capture_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capture_payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observer_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "detector_build_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "detector_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "qualification_status": {
          "enum": [
            "qualified",
            "unqualified",
            "unknown"
          ]
        },
        "qualification_receipt": {
          "$ref": "#/$defs/nullable_receipt_ref"
        },
        "event_manifest_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "receipt": {
          "$ref": "#/$defs/receipt_ref"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "detector_result": {
                "enum": [
                  "present",
                  "absent"
                ]
              }
            },
            "required": [
              "detector_result"
            ]
          },
          "then": {
            "properties": {
              "qualification_status": {
                "const": "qualified"
              },
              "qualification_receipt": {
                "$ref": "#/$defs/receipt_ref"
              },
              "event_manifest_sha256": {
                "$ref": "#/$defs/sha256"
              }
            },
            "required": [
              "event_manifest_sha256"
            ]
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_verifier_profile",
        "manifest_version"
      ],
      "properties": {
        "episode_verifier_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "manifest_version": {
          "const": 1
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_sha256",
        "verifier_profile_id",
        "verification_receipt_sha256"
      ],
      "properties": {
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verifier_profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "verification_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nullable_receipt_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/receipt_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock_domain",
        "start_ns",
        "end_ns"
      ],
      "properties": {
        "clock_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_ns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "veto_race": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "admission_stage",
        "admission_event_sequence",
        "veto_event_sequence",
        "reported_stage_event_sequence",
        "prior_output_epoch",
        "veto_output_epoch",
        "callback_disposition",
        "callback_event_sequence",
        "callback_observed_epoch",
        "callback_admitted_frames",
        "stale_callback_discarded_frames",
        "invalidated_application_frames",
        "discarded_unconsumed_notes",
        "post_veto_new_admissions",
        "receipt"
      ],
      "properties": {
        "authorization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "admission_stage": {
          "enum": [
            "queue_applied",
            "application_enqueued"
          ]
        },
        "admission_event_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "veto_event_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "reported_stage_event_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "prior_output_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "veto_output_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "callback_disposition": {
          "enum": [
            "not_observed",
            "admitted_before_veto",
            "stale_discarded_after_veto"
          ]
        },
        "callback_event_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "callback_observed_epoch": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "callback_admitted_frames": {
          "type": "integer",
          "minimum": 0
        },
        "stale_callback_discarded_frames": {
          "type": "integer",
          "minimum": 0
        },
        "invalidated_application_frames": {
          "type": "integer",
          "minimum": 0
        },
        "discarded_unconsumed_notes": {
          "type": "integer",
          "minimum": 0
        },
        "post_veto_new_admissions": {
          "type": "integer",
          "minimum": 0
        },
        "receipt": {
          "$ref": "#/$defs/receipt_ref"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "observation": {
            "properties": {
              "detector_result": {
                "enum": [
                  "present",
                  "absent"
                ]
              }
            },
            "required": [
              "detector_result"
            ]
          }
        },
        "required": [
          "observation"
        ]
      },
      "then": {
        "properties": {
          "capture": {
            "properties": {
              "reported_closure": {
                "const": "eligible"
              }
            },
            "required": [
              "reported_closure"
            ]
          }
        }
      }
    }
  ]
}
