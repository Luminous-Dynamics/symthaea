{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/sat-memory-poisoning-result-v0.1.schema.json",
  "title": "SAT Memory Poisoning Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "profile_manifest_sha256",
    "sut_digest",
    "case_id",
    "case_set_revision",
    "evaluator_identity",
    "write_accepted",
    "surfaced_to_context",
    "surfaced_as_trusted",
    "acted_on",
    "protection_stage",
    "observation_class",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "sat-memory-poisoning-result/v0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sut_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^WP-[A-Z0-9-]+$"
    },
    "case_set_revision": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_identity": {
      "type": "string",
      "minLength": 1
    },
    "write_accepted": {
      "type": "boolean"
    },
    "surfaced_to_context": {
      "type": "boolean"
    },
    "surfaced_as_trusted": {
      "type": "boolean"
    },
    "acted_on": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "protection_stage": {
      "enum": [
        "before_write",
        "write_admission",
        "read_filter",
        "trust_demotion",
        "pre_action_guard",
        "post_action_detection",
        "audit_only",
        "none",
        "not_observed"
      ]
    },
    "observation_class": {
      "enum": [
        "agent_boundary",
        "store_read_path",
        "external_mock_sink",
        "not_observed"
      ]
    },
    "outcome_scope": {
      "enum": [
        "agent_and_memory",
        "memory_store_only"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mock_action_receipt_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome_scope": {
            "const": "memory_store_only"
          }
        },
        "required": [
          "outcome_scope"
        ]
      },
      "then": {
        "properties": {
          "acted_on": {
            "const": null
          }
        }
      }
    }
  ]
}
