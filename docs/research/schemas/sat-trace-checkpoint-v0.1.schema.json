{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/sat/schemas/trace-checkpoint-receipt/0.1",
  "title": "SAT Trace Checkpoint Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "issued_at",
    "run_id",
    "manifest_digest",
    "head_sequence",
    "head_event_digest",
    "trace_head_statement",
    "statement_digest",
    "transparency_entries",
    "witness_attestations",
    "trust_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "sat-trace-checkpoint-receipt/v0.1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "head_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "head_event_digest": {
      "$ref": "#/$defs/digest"
    },
    "trace_head_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "manifest_digest",
        "head_sequence",
        "head_event_digest",
        "checkpointed_at"
      ],
      "properties": {
        "schema_version": {
          "const": "sat-trace-head-statement/v0.1"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "head_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "head_event_digest": {
          "$ref": "#/$defs/digest"
        },
        "checkpointed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "statement_digest": {
      "$ref": "#/$defs/digest"
    },
    "transparency_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service_profile",
          "service_id",
          "log_id",
          "entry_index",
          "tree_size",
          "signed_checkpoint_ref",
          "inclusion_proof_ref",
          "root_hash",
          "root_hash_algorithm",
          "root_hash_encoding"
        ],
        "properties": {
          "service_profile": {
            "enum": [
              "scitt-rfc9943",
              "sigstore-rekor-v2",
              "signed-note",
              "private-transparency-service"
            ]
          },
          "service_id": {
            "type": "string",
            "format": "uri"
          },
          "log_id": {
            "type": "string",
            "minLength": 1
          },
          "entry_index": {
            "type": "integer",
            "minimum": 0
          },
          "tree_size": {
            "type": "integer",
            "minimum": 1
          },
          "root_hash": {
            "type": "string",
            "minLength": 1
          },
          "signed_checkpoint_ref": {
            "type": "string",
            "minLength": 1
          },
          "inclusion_proof_ref": {
            "type": "string",
            "minLength": 1
          },
          "consistency_proof_ref": {
            "type": "string"
          },
          "signed_statement_ref": {
            "type": "string",
            "minLength": 1
          },
          "checkpoint_key_id": {
            "type": "string",
            "minLength": 1
          },
          "verification_policy_ref": {
            "type": "string",
            "minLength": 1
          },
          "root_hash_algorithm": {
            "type": "string",
            "minLength": 1
          },
          "root_hash_encoding": {
            "enum": [
              "hex",
              "base64",
              "base64url",
              "provider-defined"
            ]
          },
          "previous_checkpoint_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "witness_attestations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "witness_id",
          "service_id",
          "tree_size",
          "observed_at",
          "signature_ref",
          "key_id",
          "trust_policy_digest",
          "root_hash",
          "root_hash_algorithm",
          "root_hash_encoding",
          "log_id"
        ],
        "properties": {
          "witness_id": {
            "type": "string",
            "minLength": 1
          },
          "service_id": {
            "type": "string",
            "format": "uri"
          },
          "tree_size": {
            "type": "integer",
            "minimum": 1
          },
          "root_hash": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "signature_ref": {
            "type": "string",
            "minLength": 1
          },
          "key_id": {
            "type": "string",
            "minLength": 1
          },
          "trust_policy_digest": {
            "$ref": "#/$defs/digest"
          },
          "independence_basis_ref": {
            "type": "string"
          },
          "root_hash_algorithm": {
            "type": "string",
            "minLength": 1
          },
          "root_hash_encoding": {
            "enum": [
              "hex",
              "base64",
              "base64url",
              "provider-defined"
            ]
          },
          "log_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "trust_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "version",
        "policy_digest",
        "minimum_independent_witnesses",
        "key_status_evidence_ref"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "minimum_independent_witnesses": {
          "type": "integer",
          "minimum": 1
        },
        "key_status_evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "revocation_snapshot_ref": {
          "type": "string",
          "minLength": 1
        },
        "governance_policy_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transparency_entries": {
            "contains": {
              "properties": {
                "previous_checkpoint_ref": {
                  "type": "string"
                }
              },
              "required": [
                "previous_checkpoint_ref"
              ]
            }
          }
        },
        "required": [
          "transparency_entries"
        ]
      },
      "then": {
        "properties": {
          "transparency_entries": {
            "items": {
              "if": {
                "required": [
                  "previous_checkpoint_ref"
                ]
              },
              "then": {
                "required": [
                  "consistency_proof_ref"
                ]
              }
            }
          }
        }
      }
    }
  ]
}