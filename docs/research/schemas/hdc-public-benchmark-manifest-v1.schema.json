{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/schemas/hdc-public-benchmark-manifest-v1.schema.json",
  "title": "Symthaea public HDC/VSA benchmark manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "status",
    "created_date",
    "purpose",
    "reference_protocol",
    "policies",
    "metrics",
    "comparison_tracks",
    "methods",
    "datasets"
  ],
  "properties": {
    "schema_version": {
      "const": "hdc-public-benchmark-manifest-v1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "metadata_only",
        "ingestion_in_progress",
        "ready_for_evaluation"
      ]
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "reference_protocol": {
      "$ref": "#/$defs/reference_protocol"
    },
    "policies": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "comparison_tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/comparison_track"
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/method"
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/dataset"
      }
    }
  },
  "$defs": {
    "reference_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_title",
        "published_date",
        "doi",
        "paper_url",
        "reference_code_url",
        "benchmark_dimensions",
        "repetitions",
        "reference_hdc_task_count",
        "reference_uci_task_count",
        "reference_defaults",
        "reproduction_status"
      ],
      "properties": {
        "paper_title": {
          "type": "string",
          "minLength": 1
        },
        "published_date": {
          "type": "string",
          "format": "date"
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        },
        "paper_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "reference_code_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "benchmark_dimensions": {
          "type": "integer",
          "minimum": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "reference_hdc_task_count": {
          "const": 7
        },
        "reference_uci_task_count": {
          "const": 121
        },
        "reference_defaults": {
          "type": "string",
          "minLength": 1
        },
        "reproduction_status": {
          "enum": [
            "protocol_identified_code_revision_not_yet_pinned",
            "source_revision_pinned",
            "reproduced"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "url",
        "citation",
        "license_claim",
        "license_evidence_url",
        "license_review_status"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "license_claim": {
          "type": "string",
          "minLength": 1
        },
        "license_evidence_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "license_review_status": {
          "enum": [
            "upstream_metadata",
            "review_required",
            "reviewed_for_declared_use"
          ]
        }
      }
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation",
        "status",
        "notes"
      ],
      "properties": {
        "representation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "needs_exact_reference_transform",
            "source_features_described",
            "reference_structure_known",
            "reproduced"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "notes"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "needs_source_audit",
            "reference_structure_known",
            "source_split_described",
            "reproduced"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sha256",
        "bytes"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_materialized",
            "materialized_unverified",
            "verified"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_materialized"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "null"
              },
              "bytes": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "benchmark_group",
        "display_name",
        "task",
        "reference_observations",
        "classes",
        "sources",
        "reference_preprocessing",
        "split_policy",
        "artifact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "benchmark_group": {
          "const": "hdc_application_suite"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "reference_observations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "classes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "reference_preprocessing": {
          "$ref": "#/$defs/preprocessing"
        },
        "split_policy": {
          "$ref": "#/$defs/split_policy"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "comparison_track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "tuning_budget",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tuning_budget": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "in_progress",
            "qualified"
          ]
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "reference",
        "status",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "family": {
          "enum": [
            "prototype",
            "vsa",
            "published_hdc",
            "conventional_ml"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "implementation_under_review",
            "qualified"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
