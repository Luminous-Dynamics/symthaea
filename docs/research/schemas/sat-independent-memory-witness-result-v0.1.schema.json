{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/sat-independent-memory-witness-result-v0.1.schema.json",
  "title": "SAT Independent Memory Witness Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "sut_digest",
    "memory_profile_digest",
    "witness_profile_digest",
    "quorum_size",
    "required_quorum",
    "independent_operator_count",
    "state_id_digest",
    "generation_before",
    "generation_after",
    "stale_state_served",
    "conflicting_successor_committed",
    "operation_outcome",
    "reconciliation_state",
    "witness_receipts",
    "evidence_refs",
    "third_party_verification"
  ],
  "properties": {
    "schema_version": {
      "const": "sat-independent-memory-witness-result/v0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "pattern": "^MW-[A-Z0-9-]+$"
    },
    "sut_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "memory_profile_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "witness_profile_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "quorum_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "required_quorum": {
      "const": 3
    },
    "independent_operator_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "state_id_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generation_before": {
      "type": "integer",
      "minimum": 0
    },
    "generation_after": {
      "type": "integer",
      "minimum": 0
    },
    "stale_state_served": {
      "type": "boolean"
    },
    "conflicting_successor_committed": {
      "type": "boolean"
    },
    "erased_record_served": {
      "type": "boolean"
    },
    "operation_outcome": {
      "enum": [
        "committed",
        "rejected",
        "held",
        "reconciled",
        "ambiguous",
        "not_evaluable"
      ]
    },
    "reconciliation_state": {
      "enum": [
        "not_required",
        "completed_to_witness",
        "held_for_operator",
        "failed"
      ]
    },
    "witness_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operator_id",
          "organization_id",
          "generation",
          "transition_digest",
          "signature_verified"
        ],
        "properties": {
          "operator_id": {
            "type": "string",
            "minLength": 1
          },
          "organization_id": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "transition_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "signature_verified": {
            "type": "boolean"
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "third_party_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_status",
        "decision",
        "verifier_identity",
        "verifier_build_digest",
        "transparency_log_used",
        "nonce_challenge_digest",
        "response_set_digest",
        "checks",
        "evidence_refs"
      ],
      "properties": {
        "verification_status": {
          "enum": [
            "not_performed",
            "partial",
            "complete"
          ]
        },
        "decision": {
          "enum": [
            "not_assessed",
            "qualified",
            "rejected",
            "inconclusive"
          ]
        },
        "verifier_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "verifier_build_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "transparency_log_used": {
          "type": "boolean"
        },
        "nonce_challenge_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "response_set_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "witness_signatures_verified",
            "matching_quorum_verified",
            "nonce_freshness_verified",
            "transparency_inclusion_verified",
            "transparency_consistency_verified",
            "split_view_checked",
            "operator_independence_reviewed",
            "current_state_reconciled",
            "t10_erasure_state_verified"
          ],
          "properties": {
            "witness_signatures_verified": {
              "type": "boolean"
            },
            "matching_quorum_verified": {
              "type": "boolean"
            },
            "nonce_freshness_verified": {
              "type": "boolean"
            },
            "transparency_inclusion_verified": {
              "type": "boolean"
            },
            "transparency_consistency_verified": {
              "type": "boolean"
            },
            "split_view_checked": {
              "type": "boolean"
            },
            "operator_independence_reviewed": {
              "type": "boolean"
            },
            "current_state_reconciled": {
              "type": "boolean"
            },
            "t10_erasure_state_verified": {
              "type": "boolean"
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation_outcome": {
            "const": "committed"
          }
        },
        "required": [
          "operation_outcome"
        ]
      },
      "then": {
        "properties": {
          "quorum_size": {
            "minimum": 3
          },
          "independent_operator_count": {
            "minimum": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "third_party_verification": {
            "properties": {
              "decision": {
                "const": "qualified"
              }
            },
            "required": [
              "decision"
            ]
          }
        },
        "required": [
          "third_party_verification"
        ]
      },
      "then": {
        "properties": {
          "third_party_verification": {
            "properties": {
              "verification_status": {
                "const": "complete"
              },
              "verifier_identity": {
                "type": "string",
                "minLength": 1
              },
              "verifier_build_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "transparency_log_used": {
                "const": true
              },
              "nonce_challenge_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "response_set_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "checks": {
                "properties": {
                  "witness_signatures_verified": {
                    "const": true
                  },
                  "matching_quorum_verified": {
                    "const": true
                  },
                  "nonce_freshness_verified": {
                    "const": true
                  },
                  "transparency_inclusion_verified": {
                    "const": true
                  },
                  "transparency_consistency_verified": {
                    "const": true
                  },
                  "split_view_checked": {
                    "const": true
                  },
                  "operator_independence_reviewed": {
                    "const": true
                  },
                  "current_state_reconciled": {
                    "const": true
                  },
                  "t10_erasure_state_verified": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
