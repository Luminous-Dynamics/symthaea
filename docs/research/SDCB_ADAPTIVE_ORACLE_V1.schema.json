{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SDCB_ADAPTIVE_ORACLE_V1.schema.json",
  "title": "SDCB exact two-stage adaptive paired-world design v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "world_a_id", "world_b_id", "prior_world_a", "abstain_utility", "budget_units", "experiments"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "fixture_id": {"type": "string", "minLength": 1},
    "world_a_id": {"type": "string", "minLength": 1},
    "world_b_id": {"type": "string", "minLength": 1},
    "prior_world_a": {"type": "number", "minimum": 0, "maximum": 1},
    "abstain_utility": {"type": "number", "minimum": 0, "maximum": 1},
    "budget_units": {"type": "integer", "minimum": 0},
    "experiments": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/experiment"}}
  },
  "$defs": {
    "probabilityVector": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cost_units", "likelihood_world_a", "likelihood_world_b"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "cost_units": {"type": "integer", "minimum": 1},
        "likelihood_world_a": {"$ref": "#/$defs/probabilityVector"},
        "likelihood_world_b": {"$ref": "#/$defs/probabilityVector"}
      }
    }
  },
  "x-runtime-invariants": [
    "experiment IDs unique",
    "likelihood vectors for each world have equal dimensions",
    "all experiments have a common categorical outcome count",
    "each likelihood vector sums to one",
    "every contingent second-stage path obeys the hard budget"
  ]
}
