{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SDCB_RIDEA_PROXY_TRAINING_V1.schema.json",
  "title": "SDCB R-IDeA proxy training episode v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "features",
    "targets",
    "current_predictions",
    "initial_weights",
    "config"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/vector"
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "current_predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "initial_weights": {
      "$ref": "#/$defs/vector"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "margin_tau",
        "margin_alpha",
        "l2",
        "learning_rate",
        "steps"
      ],
      "properties": {
        "margin_tau": {
          "type": "number",
          "minimum": 0
        },
        "margin_alpha": {
          "type": "number",
          "minimum": 0
        },
        "l2": {
          "type": "number",
          "minimum": 0
        },
        "learning_rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    }
  },
  "$defs": {
    "vector": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "number"
      }
    }
  },
  "$comment": "Semantic validation must require equal row counts for features, targets and current_predictions, and each feature row width equal to initial_weights length. current_predictions are frozen f_hat values, not optimized."
}
