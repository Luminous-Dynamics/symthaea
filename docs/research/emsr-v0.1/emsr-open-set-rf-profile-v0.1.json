      "weapons_integration",
      "physical_actuation"
    ]
  },
  "decision_vocabulary": {
    "known_class": "A class covered by the frozen training label vocabulary.",
    "unknown": "An input outside the known class support; do not force it into a known label.",
    "indeterminate": "Insufficient, corrupt, low-quality or contradictory evidence to classify or reject reliably.",
    "rule": "unknown and indeterminate are distinct outcomes; neither implies maliciousness or emitter identity."
  },
  "comparator": {
    "id": "RF-RPL-2026",
