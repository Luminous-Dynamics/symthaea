    "available_online": "2026-09-02",
    "method_summary": [
      "RF-consistency representation pretraining",
      "EMA teacher aggregation across RF-preserving transformations",
      "reliability gate using confidence, transformation stability and energy-based knownness",
      "known-class pseudo-label routing with rejection of uncertain/unknown windows"
    ],
    "reported_conditions": {
      "label_availability": 0.05,
      "datasets": [
        "RadioML2016.10A",
        "RadioML2016.10B",
        "simulated electromagnetic-monitoring benchmark"
