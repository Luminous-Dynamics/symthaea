  "formula_contract": {
    "annual_fixed_cost": "capex_upfront * CRF(annual_discount_rate, capital_life_years) + sum(annual_fixed_costs)",
    "crf": "if rate == 0 then 1 / life; otherwise rate * (1 + rate)^life / ((1 + rate)^life - 1)",
    "variable_cost_per_attempt": "sum(variable_cost_per_attempt_components); any missing component makes cost evidence incomplete, never zero",
    "variable_cost_per_accepted_unit": "variable_cost_per_attempt / yield_fraction",
    "total_annual_cost_per_accepted_unit": "annual_fixed_cost / demand_good_units_per_year + variable_cost_per_accepted_unit",
    "break_even_demand": "(buy_annual_fixed_cost - make_annual_fixed_cost) / (make_variable_cost_per_good - buy_variable_cost_per_good); report a positive break-even only when result > 0",
    "eligibility_gate": "cost comparison cannot select an alternative whose qualification_status is not qualified_for_profile",
    "expected_decisions_are_independent_test_labels": true
  },
