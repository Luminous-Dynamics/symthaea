{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/textile-route-cases/v0.1/corpus.json",
  "title": "Synthetic textile recovery route contract corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "fixture_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "corpus_id": {
      "const": "TEXTILE-ROUTE-CASES-001"
    },
    "fixture_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 41,
      "maxItems": 41,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "mutation",
          "expected"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "mutation": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "disposition",
              "reason"
            ],
            "properties": {
              "disposition": {
                "enum": [
                  "eligible",
                  "insufficient_evidence",
                  "ineligible"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
