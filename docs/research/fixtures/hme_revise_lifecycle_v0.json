      "restart_control": {
        "old_hme_generation": 8,
        "current_ledger_generation": 9,
        "stale_index_hit_ids": [
          "hme-vector-diet-r1",
          "hme-vector-meal-plan-r1",
          "hme-summary-shopping-list-r1"
        ],
        "expected": "stale generation is rejected before payload decode or scoring; no old item or descendant is emitted",
        "physical_erasure_note": "Logical ineligibility is not proof of physical erasure. Apply the existing deletion/retention owner and report physical purge or cryptographic erasure separately."
      },
      "invariants": [
        "Deletion is applied to source and every dependent derived view.",
        "A stale HME hit is a hint only and cannot override ledger generation.",
        "No descendant may be returned after invalidation merely because it has its own embedding.",
        "Compaction, restore and replay cannot resurrect a deleted item.",
        "Logical deletion, physical purge and cryptographic erasure remain distinct statuses."
      ]
    },
    {
      "id": "alternative_proof_preserves_conclusion_when_one_justification_is_retracted",
      "description": "A conclusion has two independent proof alternatives. Invalidating one proof must not invalidate the other complete, still-eligible proof.",
      "source_events": [
        {
          "id": "permit-r1",
          "kind": "assertion",
          "subject": "project-1",
          "attribute": "site_access",
          "value": "allowed",
          "recorded_at": "2026-05-01T00:00:00Z"
        },
        {
          "id": "owner-r1",
          "kind": "assertion",
          "subject": "project-1",
          "attribute": "site_owner_approval",
          "value": "approved",
          "recorded_at": "2026-05-01T00:01:00Z"
        },
        {
          "id": "regulator-r1",
          "kind": "assertion",
          "subject": "project-1",
          "attribute": "regulatory_exemption",
          "value": "active",
          "recorded_at": "2026-05-02T00:00:00Z"
        },
        {
          "id": "permit-retract-r2",
          "kind": "retraction",
          "target": "permit-r1",
          "recorded_at": "2026-06-01T00:00:00Z"
        }
      ],
      "conclusion": {
        "id": "access-conclusion-r1",
        "attribute": "site_access_eligibility",
        "value": "eligible",
        "proof_alternatives": [
          {
            "proof_id": "proof-a",
            "requires_all": [
              "permit-r1",
              "owner-r1"
            ]
          },
          {
            "proof_id": "proof-b",
            "requires_all": [
              "regulator-r1"
            ]
          }
        ]
      },
      "expected_after_retraction": {
        "conclusion_status": "supported",
        "valid_proof_ids": [
          "proof-b"
        ],
        "invalid_proof_ids": [
          "proof-a"
        ],
        "must_not_happen": [
          "delete conclusion while a complete independent proof remains",
          "treat two correlated references to regulator-r1 as independent proofs"
        ]
      },
      "invariants": [
        "Alternative justifications are OR-of-AND proof sets, not an undifferentiated dependency list.",
        "A conclusion is eligible when at least one complete, authorized, temporally valid proof remains.",
        "Source independence must be represented; duplicated citations to the same source do not create independent corroboration."
      ]
    },
    {
      "id": "absence_is_not_falsehood_and_unknown_is_typed",
