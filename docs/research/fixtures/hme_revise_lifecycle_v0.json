          ],
          "created_at": "2026-04-02T00:01:00Z"
        }
      ],
      "materialized_views": [
        {
          "id": "hme-vector-diet-r1",
          "source_id": "diet-r1",
          "generation": 8
        },
        {
          "id": "hme-vector-meal-plan-r1",
          "source_id": "meal-plan-r1",
          "generation": 8
        },
        {
          "id": "hme-summary-shopping-list-r1",
          "source_id": "shopping-list-r1",
          "generation": 8
        }
      ],
      "queries": [
        {
          "id": "before_delete",
          "valid_at": "2026-05-01T00:00:00Z",
          "known_at": "2026-05-02T00:00:00Z",
          "expected": {
            "dietary_constraint": {
