  "semantics": {
    "valid_time": "When an assertion applies in the modeled world",
    "knowledge_time": "When the system admitted, superseded, retracted or deleted the assertion",
    "query_shape": "query(valid_at, known_at, principal_scope, policy_generation)",
    "distinction": "HME vector/index records are rebuildable materialized views; source events and proof dependencies remain authoritative outside HME",
    "answer_states": [
      "supported",
      "contested",
      "unknown",
      "stale",
      "superseded",
      "retracted",
      "not_authorized",
      "not_observed"
    ]
  },
  "cases": [
    {
      "id": "late_arriving_retrospective_correction_invalidates_dependent_claim",
      "description": "A correction received later applies to an earlier valid-time interval. As-known queries must not leak it backward; current-belief queries must not reuse dependent conclusions derived from the superseded assertion.",
      "source_events": [
        {
          "id": "home-r1",
          "kind": "assertion",
          "subject": "user-1",
          "attribute": "home_area",
          "value": "Northside",
          "valid_from": "2026-01-01T00:00:00Z",
          "valid_to": null,
          "recorded_at": "2026-01-02T09:00:00Z",
          "supersedes": null
        },
        {
          "id": "office-r1",
          "kind": "assertion",
          "subject": "user-1",
          "attribute": "office_area",
          "value": "Central",
          "valid_from": "2026-01-01T00:00:00Z",
          "valid_to": null,
          "recorded_at": "2026-01-02T09:05:00Z",
          "supersedes": null
        },
        {
          "id": "home-r2",
          "kind": "correction",
          "subject": "user-1",
          "attribute": "home_area",
          "value": "Riverside",
          "valid_from": "2026-01-10T00:00:00Z",
          "valid_to": null,
          "recorded_at": "2026-03-01T12:00:00Z",
          "supersedes": "home-r1"
        }
      ],
      "derived_claims": [
        {
          "id": "commute-r1",
          "attribute": "estimated_commute_minutes",
          "value": 20,
          "derived_from": [
            "home-r1",
            "office-r1"
          ],
          "rule_id": "commute-estimator-v1",
          "created_at": "2026-01-03T10:00:00Z"
        },
        {
          "id": "commute-r2",
          "attribute": "estimated_commute_minutes",
          "value": 12,
          "derived_from": [
            "home-r2",
            "office-r1"
          ],
          "rule_id": "commute-estimator-v1",
          "created_at": "2026-03-02T10:00:00Z"
        }
      ],
      "queries": [
        {
          "id": "as_known_before_correction",
          "valid_at": "2026-01-15T00:00:00Z",
          "known_at": "2026-02-01T00:00:00Z",
          "expected": {
            "home_area": {
              "status": "supported",
              "value": "Northside",
              "support": [
                "home-r1"
              ]
            },
            "estimated_commute_minutes": {
              "status": "supported",
              "value": 20,
              "support": [
                "commute-r1"
              ]
            }
          }
        },
        {
          "id": "as_known_after_correction_before_recompute",
          "valid_at": "2026-01-15T00:00:00Z",
          "known_at": "2026-03-01T18:00:00Z",
          "expected": {
            "home_area": {
              "status": "supported",
              "value": "Riverside",
              "support": [
                "home-r2"
              ]
            },
            "estimated_commute_minutes": {
              "status": "unknown",
              "reason": "dependency_superseded_no_replacement_yet",
              "must_not_return": [
                "commute-r1"
              ]
            }
          }
        },
        {
          "id": "as_known_after_recompute",
          "valid_at": "2026-01-15T00:00:00Z",
          "known_at": "2026-03-03T00:00:00Z",
          "expected": {
            "home_area": {
              "status": "supported",
              "value": "Riverside",
              "support": [
                "home-r2"
              ]
            },
            "estimated_commute_minutes": {
              "status": "supported",
              "value": 12,
              "support": [
                "commute-r2"
              ]
            }
          }
        }
      ],
      "invariants": [
        "The late correction is invisible to known_at before its recorded_at timestamp.",
        "The correction can change the current belief about an earlier valid date.",
        "A dependent conclusion is not valid merely because its vector remains indexed.",
        "Between correction and recomputation, the dependent conclusion is unknown, not the old value and not false.",
        "The audit retains the old revision without making it eligible for current retrieval."
      ]
    },
    {
      "id": "deletion_cascades_through_derived_views_and_survives_reopen",
      "description": "A source item is deleted under the governing erasure/retention contract. All dependent derived results and HME materialized views must cease to be retrievable; stale indexes cannot resurrect them after restart.",
      "source_events": [
        {
          "id": "diet-r1",
          "kind": "assertion",
          "subject": "user-1",
          "attribute": "dietary_constraint",
          "value": "peanut-free",
