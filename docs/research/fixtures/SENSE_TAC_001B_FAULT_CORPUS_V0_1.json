{
  "schema_id": "https://luminousdynamics.io/schemas/sense-tac-001b-fault-corpus-v0.1.schema.json",
  "corpus_id": "SENSE-TAC-001B-FAULT-CORPUS",
  "version": "0.1.0",
  "status": "synthetic_reference_only",
  "claim_ceiling": "The corpus defines deterministic synthetic cases only. It does not estimate real tactile sensor physics, calibration, fault rates, hardware coverage, or task performance.",
  "model": {
    "signal_unit": "arb (dimensionless synthetic unit; not an SI measurand)",
    "normal_equation": "normal_raw = gain_normal * normal_truth + shear_to_normal * shear_truth + bias_normal + drift_normal * elapsed_ms + temp_coeff_normal * (temperature_c - reference_temperature_c) + shared_offset + deterministic_noise_normal",
    "shear_equation": "shear_raw = gain_shear * shear_truth + normal_to_shear * normal_truth + bias_shear + drift_shear * elapsed_ms + temp_coeff_shear * (temperature_c - reference_temperature_c) + shared_offset + deterministic_noise_shear",
    "order": [
      "linear_response",
      "history_or_environment_effect",
      "dead_zone",
      "clip_to_range",
      "quantize_to_nearest_step"
    ],
    "rounding": "For non-zero quantum q: sign(x) * floor(abs(x) / q + 0.5) * q. The rule is deterministic and symmetric around zero.",
    "fault_overrides": [
      "dropout",
      "stuck_at",
      "intermittent_open",
      "channel_swap",
      "unit_scale_mismatch",
      "clock_offset",
      "readout_latency",
      "timestamp_jitter",
      "duplicate_or_conflicting_replay"
    ],
    "truth_visibility": "physical_truth, injected_fault and expected are evaluator-only. Candidate code may consume candidate_input only.",
    "independence": "raw channels, event features and HDC projections derived from one physical acquisition share the same physical evidence root unless a separate sensor/reference path is independently established.",
    "reference_temperature_c": 20,
    "drift_epoch_ms": 0,
    "default_channel_gain": 1,
    "default_channel_bias": 0,
    "drift_elapsed_time_basis": "time_ms - drift_epoch_ms",
    "parameter_semantics": {
      "bias": "Additive offset in arb on the named channel; omitted other-channel parameters are zero.",
      "gain": "Multiplicative gain on the named channel; omitted other-channel gains are 1.",
      "normal_to_shear_crosstalk": "shear_raw receives parameter * normal_truth.",
      "shear_to_normal_crosstalk": "normal_raw receives parameter * shear_truth.",
      "saturation": "Upper clipping limit in arb on the named channel.",
      "dead_zone": "Values with absolute magnitude below parameter become zero.",
      "quantization": "Quantization step in arb; nearest step, ties away from zero.",
      "linear_drift": "Additive offset slope in arb/ms after drift_epoch_ms.",
      "temperature_coefficient": "Additive offset slope in arb/degC relative to reference_temperature_c.",
      "hysteresis": "Additive branch offset in arb; event field identifies the branch.",
      "shared_adc_offset": "Same additive offset in arb on all declared channels sharing the named ADC/reference roots.",
      "shared_reference_gain": "Same multiplicative gain on all declared channels sharing the named reference roots.",
      "clock_offset": "Device timestamp minus independent reference timestamp, in ms.",
      "readout_latency": "Collector receipt time minus source acquisition time, in ms.",
      "timestamp_jitter": "One bounded timestamp residual in ms relative to the independent reference; full distribution is not inferred from one sample."
    }
  },
