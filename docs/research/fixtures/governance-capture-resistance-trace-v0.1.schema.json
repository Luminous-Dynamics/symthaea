{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/fixtures/governance-capture-resistance-trace-v0.1.schema.json",
  "title": "GCRB structured action-trace input",
  "description": "Untrusted structured trace submitted to the rule-based GCRB auditor. Schema validity is not event authenticity, capture completeness, authority validation, legal adjudication, or qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "trace_id",
    "recorder_id",
    "capture_profile_sha256",
    "fixture_sha256",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "gcrb-action-trace-v0.1"
    },
    "benchmark_id": {
      "const": "GOV-CAP-001"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "recorder_id": {
      "type": "string",
      "minLength": 1
    },
    "capture_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "capture_status",
          "events"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "capture_status": {
            "enum": [
              "complete",
              "incomplete",
              "unknown"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_id",
                "sequence",
                "kind",
                "actor_id",
                "actor_role"
              ],
              "properties": {
                "event_id": {
                  "type": "string",
                  "minLength": 1
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "kind": {
                  "enum": [
                    "commitment_revision",
                    "evidence_class_transition",
                    "rights_restriction",
                    "punishment",
                    "appeal_resolution",
                    "emergency_bypass",
                    "evaluation_config_changed"
                  ]
                },
                "actor_id": {
                  "type": "string",
                  "minLength": 1
                },
                "actor_role": {
                  "enum": [
                    "model",
                    "public_official",
                    "system",
                    "citizen",
                    "independent_reviewer",
                    "unknown"
                  ]
                },
                "before_commitment_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "after_commitment_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "prior_version_retained": {
                  "type": "boolean"
                },
                "authority_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "reason_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_class_from": {
                  "enum": [
                    "simulated",
                    "reported",
                    "inferred",
                    "observed",
                    "unknown"
                  ]
                },
                "evidence_class_to": {
                  "enum": [
                    "simulated",
                    "reported",
                    "inferred",
                    "observed",
                    "unknown"
                  ]
                },
                "independent_observation_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "human_authorization_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "adjudication_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "challenged_authority_id": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewer_id": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewer_independent": {
                  "type": "boolean"
                },
                "action_scope_declared": {
                  "type": "boolean"
                },
                "expires_at": {
                  "type": "string",
                  "minLength": 1
                },
                "follow_up_review_required": {
                  "type": "boolean"
                },
                "outcome_visible": {
                  "type": "boolean"
                },
                "previous_config_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "new_config_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
