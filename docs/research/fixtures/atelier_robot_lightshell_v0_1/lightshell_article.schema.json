{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/atelier_robot_lightshell_article_v0_1.schema.json",
  "title": "Atelier Robot Lightshell Article Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "article_id",
    "design_state",
    "platform",
    "application_profile",
    "zones",
    "components",
    "evidence",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "article_id": {
      "type": "string",
      "minLength": 1
    },
    "design_state": {
      "enum": [
        "concept",
        "pattern_draft",
        "cad_draft",
        "fabricated",
        "as_built_inspected",
        "module_tested",
        "integrated_tested",
        "independently_qualified"
      ]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_id",
        "revision",
        "geometry_status"
      ],
      "properties": {
        "platform_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "geometry_status": {
          "enum": [
            "unknown",
            "simplified_fixture",
            "cad_revision_bound",
            "as_built_metrology_bound"
          ]
        },
        "geometry_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[a-fA-F0-9]{64})?$"
        },
        "coordinate_frame_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "application_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intended_use",
        "operating_domain",
        "hazards",
        "ballistic_scope"
      ],
      "properties": {
        "intended_use": {
          "type": "string",
          "minLength": 1
        },
        "operating_domain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hazards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ballistic_scope": {
          "const": "out_of_scope"
        },
        "cleaning_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_contact_context": {
          "enum": [
            "none_declared",
            "nearby_people",
            "shared_workspace",
            "direct_contact_intended",
            "unknown"
          ]
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "zone_id",
          "robot_region",
          "functions",
          "coverage_state",
          "keep_outs"
        ],
        "properties": {
          "zone_id": {
            "type": "string",
            "minLength": 1
          },
          "robot_region": {
            "type": "string",
            "minLength": 1
          },
          "functions": {
            "type": "array",
            "items": {
              "enum": [
                "abrasion_skin",
                "environmental_cover",
                "compliant_cushion",
                "local_guard",
                "joint_gaiter",
                "sensor_mount",
                "service_panel"
              ]
            }
          },
          "coverage_state": {
            "enum": [
              "proposed",
              "patterned",
              "fitted",
              "measured",
              "qualified",
              "not_covered"
            ]
          },
          "coordinate_frame_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "keep_outs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_rom_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "thermal_constraint_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "sensor_constraint_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "role",
          "zone_ids",
          "material_ref",
          "attachment_state"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "outer_textile",
              "spacer_textile",
              "inner_liner",
              "local_lattice",
              "rigid_guard",
              "joint_gaiter",
              "attachment",
              "sensor_ready_feature"
            ]
          },
          "zone_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "material_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "pattern_revision_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "process_recipe_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "attachment_state": {
            "enum": [
              "concept",
              "interface_defined",
              "retention_tested",
              "installed",
              "removed",
              "replaced"
            ]
          },
          "mass_g": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "inspection_required": {
            "type": "boolean"
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "material_id",
          "construction",
          "identity_state",
          "lot_ref",
          "evidence_refs"
        ],
        "properties": {
          "material_id": {
            "type": "string",
            "minLength": 1
          },
          "construction": {
            "enum": [
              "woven",
              "warp_knit",
              "weft_knit",
              "spacer_3d",
              "coated_woven",
              "laminated",
              "nonwoven",
              "elastomer",
              "printed_lattice",
              "other"
            ]
          },
          "fibre_yarn_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "finish_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "identity_state": {
            "enum": [
              "unknown",
              "supplier_declared",
              "lot_verified",
              "independently_characterized"
            ]
          },
          "lot_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "kind",
          "status",
          "scope",
          "source_revision"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "supplier_declaration",
              "simulation",
              "coupon_test",
              "fit_inspection",
              "module_test",
              "integrated_test",
              "independent_qualification",
              "lifecycle_event"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "not_run",
              "inconclusive",
              "failed",
              "passed",
              "revoked",
              "stale"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "method": {
            "type": [
              "string",
              "null"
            ]
          },
          "instrument_calibration_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw_data_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(sha256:[a-fA-F0-9]{64})?$"
          },
          "uncertainty_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewer_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "array",
      "items": {
        "enum": [
          "concept_only",
          "no_physical_test",
          "no_human_contact_safety_claim",
          "no_ingress_rating",
          "no_fire_rating",
          "no_hygienic_qualification",
          "no_ballistic_claim",
          "no_whole_robot_qualification"
        ]
      }
    }
  }
}
