{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sym-rsi-state-routing-fixtures-v0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "sym-rsi-state-routing-fixtures-v0"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "const": "SYNTHETIC_FIXTURE_DESCRIPTIONS_NOT_BENCHMARK_RESULTS"
    },
    "source_issue": {
      "const": "#10844"
    },
    "source_protocol": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "expected_fixture_count": {
      "const": 16
    },
    "expected_negative_count": {
      "const": 10
    },
    "expected_positive_count": {
      "const": 4
    },
    "expected_abstention_count": {
      "const": 2
    },
    "fixtures": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "fixture_id": {
            "type": "string",
            "pattern": "^SR-(N[0-9]{2}|P[0-9]{2}|A[0-9]{2})$"
          },
          "control_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "REJECT_CROSS_SCOPE_SHARE",
              "REJECT_UNRECEIPTED_TRANSFER",
              "REJECT_STALE_CURRENTNESS",
              "REJECT_HIDDEN_LABEL_ROUTING",
              "REJECT_TOOL_SPACE_TRANSFER",
              "REJECT_GLOBAL_SCOPE_MERGE",
              "REJECT_EXCESSIVE_FRAGMENTATION",
              "REJECT_CONTRADICTION_COLLAPSE",
              "REJECT_OUTCOME_LEAKAGE",
              "REJECT_UNGROUNDED_SHARING",
              "ALLOW_SCOPED_REUSE",
              "ALLOW_RECEIPTED_TRANSFER",
              "REVALIDATE_BEFORE_REUSE",
              "PRESERVE_SCOPED_CONTRADICTION",
              "ABSTAIN_SCOPE_UNIDENTIFIED",
              "ABSTAIN_INSUFFICIENT_PROVENANCE"
            ]
          },
          "hard_gate": {
            "type": "boolean"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "fixture_class": {
            "enum": [
              "adversarial_negative_control",
              "positive_control",
              "abstention_control"
            ]
          }
        },
        "required": [
          "fixture_id",
          "control_id",
          "category",
          "scenario",
          "disposition",
          "hard_gate",
          "fields",
          "fixture_class"
        ],
        "additionalProperties": false
      }
    },
    "scoring_policy": {
      "type": "object",
      "properties": {
        "hard_gate_rule": {
          "type": "string",
          "minLength": 1
        },
        "positive_control_rule": {
          "type": "string",
          "minLength": 1
        },
        "abstention_rule": {
          "type": "string",
          "minLength": 1
        },
        "denominator_rule": {
          "type": "string",
          "minLength": 1
        },
        "replication_unit": {
          "type": "string",
          "minLength": 1
        },
        "authority_boundary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "hard_gate_rule",
        "positive_control_rule",
        "abstention_rule",
        "denominator_rule",
        "replication_unit",
        "authority_boundary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "date",
    "status",
    "source_issue",
    "source_protocol",
    "purpose",
    "expected_fixture_count",
    "expected_negative_count",
    "expected_positive_count",
    "expected_abstention_count",
    "fixtures",
    "scoring_policy"
  ],
  "additionalProperties": false
}
