    "b_marginal": "((y01 + y11) - (y00 + y10)) / 2",
    "ab_interaction": "y11 - y10 - y01 + y00",
    "a_when_b_zero": "y10 - y00",
    "a_when_b_one": "y11 - y01",
    "b_when_a_zero": "y01 - y00",
    "b_when_a_one": "y11 - y10"
  },
  "fixtures": [
