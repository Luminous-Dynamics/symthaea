{
  "fixture_version": "sym-rsi-causal-lineage-2x2-v0",
  "purpose": "Deterministic, synthetic, non-executable reference fixtures for validating two-factor causal contrasts and claim gating.",
  "claim_boundary": "These examples validate arithmetic and structural rejection behavior only. They are not empirical Symthaea results, benchmark receipts, or evidence that any real patch is causal.",
  "outcome": {
    "name": "synthetic_outcome",
    "scale": "higher_is_better",
    "unit": "arbitrary_synthetic_units"
  },
  "contrasts": {
