  "metric_definitions": [
    {
      "id": "DELIVERED_COST_PER_ACCEPTED_UNIT",
      "formula": "total attributed material + yield loss + labor + tooling/capacity + QA + maintenance + facility/utilities + packaging + freight + return/warranty cost / accepted units",
      "unit": "currency per accepted unit",
      "notes": "Declare allocation method, currency/date and exclusions; no inferred lifetime savings."
    },
    {
      "id": "ENERGY_PER_ACCEPTED_UNIT",
      "formula": "measured or modeled energy inside declared boundary / accepted functional units within same boundary",
      "unit": "kWh per accepted unit",
      "notes": "Distinguish process energy and facility base load; rejected units do not enter denominator."
    },
    {
      "id": "FIRST_PASS_YIELD",
      "formula": "units accepted at first pass / units entering final acceptance",
      "unit": "ratio",
      "notes": "Define the cohort and rework treatment; do not omit scrapped units."
    },
    {
      "id": "LOT_GENEALOGY_COMPLETENESS",
      "formula": "selected critical received lots linked to all descendant accepted units and recorded scrap/rework / all selected critical received lots",
      "unit": "ratio",
      "notes": "Report missing/ambiguous links separately; completeness alone does not prove material grade."
    },
    {
      "id": "RECOVERY_RATE",
      "formula": "mass verified as actually accepted by a named recovery route / mass eligible for end-of-life disposition in the declared cohort",
      "unit": "ratio",
      "notes": "Separate repair, reuse, refurbishment, material recycling and disposal."
    },
    {
      "id": "ON_TIME_IN_FULL",
      "formula": "orders delivered by the declared due date with full accepted quantity / orders due",
      "unit": "ratio",
      "notes": "State cancellations, partials, and due-date changes."
    }
  ],
