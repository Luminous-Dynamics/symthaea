      ]
    }
  ],
  "negative_controls": [
    {
      "case_id": "NC-01-GRADE-UNKNOWN",
      "scenario": "Lot identity exists but exact material grade/source document is missing.",
      "expected_disposition": "not_evaluable_for_material_specific_claim",
      "invariant": "Lot identity does not establish grade."
    },
    {
      "case_id": "NC-02-SAME-LABEL-DIFFERENT-GRADE",
      "scenario": "Alternate supplier has same marketing label but a different unqualified grade.",
      "expected_disposition": "blocked_pending_requalification",
      "invariant": "Supplier substitution cannot inherit qualification by label."
    },
    {
      "case_id": "NC-03-UNOBSERVED-TRANSFORMATION",
      "scenario": "Operation is marked completed but the required postcondition measurement is absent.",
      "expected_disposition": "not_qualified",
      "invariant": "A production event does not prove the intended state transformation."
    },
    {
      "case_id": "NC-04-LOT-DESCENDANT-CONTAINMENT",
      "scenario": "Rejected lot reaches two finished units and one rework branch.",
      "expected_disposition": "exact_affected_descendant_set_required",
      "invariant": "Containment returns all and only descendant articles and WIP."
    },
    {
      "case_id": "NC-05-STALE-RESOURCE",
      "scenario": "Resource capability or calibration has expired.",
      "expected_disposition": "infeasible_or_indeterminate",
      "invariant": "Stale capability cannot be treated as current qualification."
    },
    {
      "case_id": "NC-06-MISSING-SKILL-OR-HOLD",
      "scenario": "Routing lacks a required qualified skill or inspection hold point.",
      "expected_disposition": "schedule_infeasible",
      "invariant": "All required operations, capabilities and gates must be scheduled."
    },
    {
      "case_id": "NC-07-INCOMPLETE-COST",
      "scenario": "Cost model excludes labor, yield loss, freight, maintenance or returns.",
      "expected_disposition": "not_evaluable_for_delivered_cost",
      "invariant": "Ex-factory material price is not delivered cost."
    },
    {
      "case_id": "NC-08-WRONG-ENERGY-DENOMINATOR",
      "scenario": "Energy per unit divides by all attempted units, including rejected output.",
      "expected_disposition": "invalid_metric",
      "invariant": "Accepted-functional-unit denominator must be defined and consistent."
    },
    {
      "case_id": "NC-09-COMMON-MODE-UTILITY",
      "scenario": "Power interruption disables production and inspection/calibration together.",
      "expected_disposition": "common_mode_must_be_reported",
      "invariant": "Independent subsystem counts must not hide shared utility dependencies."
    },
    {
      "case_id": "NC-10-RECYCLED-UNKNOWN",
      "scenario": "Input described as recycled but provenance, grade or contamination state is unknown.",
      "expected_disposition": "no_verified_recycled_content_or_lca_claim",
      "invariant": "Marketing label does not establish source or environmental performance."
    },
    {
      "case_id": "NC-11-NO-RECOVERY-ROUTE",
      "scenario": "Nominally recyclable mixed construction has no local route accepting actual grade/condition.",
      "expected_disposition": "no_demonstrated_recovery",
      "invariant": "Potential recyclability does not mean recovery happened or can happen locally."
    },
    {
      "case_id": "NC-12-FACILITY-OMISSIONS",
      "scenario": "Layout rendering omits required ventilation, guarding, egress or professional review.",
      "expected_disposition": "facility_approval_not_evaluable",
      "invariant": "Visual plausibility is not safety/code/commissioning evidence."
    },
    {
      "case_id": "NC-13-STALE-DESIGN-QUALIFICATION",
      "scenario": "New design changes seam/layer/fastener or source grade while old qualification is reused.",
      "expected_disposition": "requalification_required",
      "invariant": "Qualification applies only to its declared exact configuration and change envelope."
    },
    {
      "case_id": "NC-14-STOCK-DISCREPANCY",
      "scenario": "Inventory event says stock exists but receiving finds none.",
      "expected_disposition": "hold_and_preserve_discrepancy",
      "invariant": "Stale stock cannot silently satisfy material availability."
    },
    {
      "case_id": "NC-15-CONFIDENTIAL-SUPPLIER",
      "scenario": "Supplier withholds commercial detail needed by a cost claim but shares allowed provenance.",
      "expected_disposition": "share_only_authorized_facts_and_mark_cost_unknown",
      "invariant": "Privacy may limit disclosure, not justify inventing missing evidence."
    },
    {
      "case_id": "NC-16-REPAIRABLE-NO-SPARE",
      "scenario": "Returned product is labeled repairable but no spare, skill or capacity is available.",
      "expected_disposition": "repair_not_completed",
      "invariant": "Design repairability is not a completed repair event."
    },
    {
      "case_id": "NC-17-EVENT-PHYSICAL-CONFLICT",
      "scenario": "Signed delivery/inventory event conflicts with physical receipt measurement.",
      "expected_disposition": "unresolved_discrepancy",
      "invariant": "Preserve source events and avoid automatically preferring a signature over measurement."
    },
    {
      "case_id": "NC-18-SYNTHETIC-AS-MEASURED",
      "scenario": "Synthetic values are presented as real production or physical measurements.",
      "expected_disposition": "evidence_integrity_failure",
      "invariant": "Synthetic, modeled, measured, human-evaluated and replicated statuses remain distinct."
    },
    {
      "case_id": "NC-19-COST-CATEGORY-MISSING",
      "scenario": "A synthetic cost scenario omits a mandatory cost category.",
      "expected_disposition": "not_evaluable_for_delivered_cost",
      "invariant": "A scenario cannot pass on a partial cost stack."
    },
    {
      "case_id": "NC-20-COST-ZERO-OUTPUT",
      "scenario": "A scenario reports zero accepted units.",
      "expected_disposition": "invalid_cost_denominator",
      "invariant": "Cost per accepted unit is undefined without a positive accepted-unit count."
    },
    {
      "case_id": "NC-21-COST-CURRENCY-MISMATCH",
      "scenario": "Candidate and reference costs use different unconverted currencies.",
      "expected_disposition": "comparison_not_evaluable",
      "invariant": "A ratio requires the same currency and declared time/price basis."
    },
    {
      "case_id": "NC-22-MASS-BALANCE-UNACCOUNTED",
      "scenario": "A mass-balance case omits 2 percent of input mass but claims zero unaccounted mass.",
      "expected_disposition": "mass_balance_invalid",
      "invariant": "Input mass must reconcile to accepted output, scrap, WIP, residue and explicitly reported unaccounted mass within a declared tolerance."
    }
