    "quantity_unit": "mg",
    "uncertainty_semantics": "declared nonnegative integer expanded bound; use [value - bound, value + bound] only as a deterministic interval challenge, not a probability distribution or statement of statistical confidence",
    "conforming": "measurement interval is wholly contained inside the specification interval",
    "nonconforming": "measurement interval is disjoint from the specification interval",
    "indeterminate": "measurement interval overlaps the specification interval but is not wholly contained",
    "blocked": "invalid specification/unit, expired or not-yet-valid calibration interval, or explicitly broken traceability chain",
    "not_evaluable": "missing or malformed observation, uncertainty, date, or required certificate/validity metadata",
    "calibration_gate": "synthetic_reference_only certificate and declared_synthetic_chain are acceptable only for the synthetic oracle; never treat these strings as actual calibration evidence",
    "boundary_policy": "inclusive endpoints; exact interval arithmetic; integer milligrams only; overflow and underflow are not clamped",
    "time_policy": "ISO YYYY-MM-DD UTC dates; calibration interval endpoints are inclusive"
  },
