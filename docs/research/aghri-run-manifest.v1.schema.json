{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:schema:aghri-run-manifest:v1",
  "title": "AGHRI Benchmark Run Manifest V1",
  "description": "Metadata and provenance contract only; it is not a machine-safety certificate or dataset result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset",
    "sources",
    "acquisition",
    "run",
    "claim_scope"
  ],
  "properties": {
    "schema_version": {
      "const": "aghri-run-manifest/v1"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "doi",
        "license",
        "attribution",
        "reported_sequence_count",
        "reported_split_counts",
        "reported_size_gb",
        "reported_duration_seconds"
      ],
      "properties": {
        "name": {
          "const": "AGHRI"
        },
        "doi": {
          "const": "10.24385/lincoln.32982638"
        },
        "license": {
          "const": "CC-BY-4.0"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "reported_sequence_count": {
          "const": 65
        },
        "reported_split_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "train",
            "validation",
            "test"
          ],
          "properties": {
            "train": {
              "const": 52
            },
            "validation": {
              "const": 7
            },
            "test": {
              "const": 6
            }
          }
        },
        "reported_size_gb": {
          "type": "number",
          "const": 70
        },
        "reported_duration_seconds": {
          "type": "number",
          "const": 1642.515
        },
        "dataset_summary_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_doi_url",
        "benchmark_repository",
        "dataset_tools_repository"
      ],
      "properties": {
        "dataset_doi_url": {
          "const": "https://doi.org/10.24385/lincoln.32982638"
        },
        "benchmark_repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "license",
            "commit_sha"
          ],
          "properties": {
            "url": {
              "const": "https://github.com/LCAS/AGHRI-dataset-benchmark"
            },
            "license": {
              "const": "Apache-2.0"
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{40}$"
            }
          }
        },
        "dataset_tools_repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "license",
            "commit_sha"
          ],
          "properties": {
            "url": {
              "const": "https://github.com/LCAS/AGHRI-dataset-tools"
            },
            "license": {
              "const": "MIT"
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{40}$"
            }
          }
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "acquired_at",
        "source_archive_sha256",
        "source_files",
        "selected_sequence_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_acquired",
            "metadata_only",
            "subset_acquired",
            "full_release_acquired"
          ]
        },
        "acquired_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_archive_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "source_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relative_path",
              "sha256"
            ],
            "properties": {
              "relative_path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        },
        "selected_sequence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "task",
        "mode",
        "evidence_stage",
        "official_split",
        "container_digest",
        "model_id",
        "model_sha256",
        "config_sha256",
        "evaluator_id",
        "evaluator_commit_sha",
        "report_sha256",
        "result_status",
        "metrics"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "enum": [
            "2d_detection",
            "2d_tracking",
            "3d_detection",
            "3d_tracking",
            "camera_lidar_fusion",
            "runtime_observability",
            "physical_safety"
          ]
        },
        "mode": {
          "enum": [
            "baseline_reproduction",
            "in_domain_eval",
            "transfer_eval",
            "fault_replay",
            "physical_test"
          ]
        },
        "evidence_stage": {
          "enum": [
            "metadata_only",
            "offline_replay",
            "digital_twin",
            "bench_test",
            "supervised_field",
            "multi_site",
            "multi_season"
          ]
        },
        "official_split": {
          "enum": [
            "train",
            "validation",
            "test",
            "not_applicable"
          ]
        },
        "container_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "config_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "evaluator_id": {
          "type": "string",
          "minLength": 1
        },
        "evaluator_commit_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "report_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "result_status": {
          "enum": [
            "template_unqualified",
            "not_run",
            "pass",
            "fail",
            "blocked",
            "inconclusive"
          ]
        },
        "metrics": {
          "type": [
            "object",
            "null"
          ],
          "description": "Metric names/units/denominators must be declared by the task-specific evaluator."
        }
      }
    },
    "claim_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perception_claim",
        "tracking_claim",
        "runtime_monitoring_claim",
        "physical_safety_qualification",
        "field_validation",
        "notes"
      ],
      "properties": {
        "perception_claim": {
          "type": "boolean"
        },
        "tracking_claim": {
          "type": "boolean"
        },
        "runtime_monitoring_claim": {
          "type": "boolean"
        },
        "physical_safety_qualification": {
          "const": false
        },
        "field_validation": {
          "const": false
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "acquisition": {
            "properties": {
              "status": {
                "const": "not_acquired"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "acquisition": {
            "properties": {
              "source_archive_sha256": {
                "type": "null"
              },
              "source_files": {
                "maxItems": 0
              },
              "selected_sequence_ids": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
