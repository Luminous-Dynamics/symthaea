{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/cropfoundry-nutrition-accounting-input-v1.schema.json",
  "title": "CropFoundry nutrition accounting input v1",
  "description": "One batch × nutrient accounting record. Values are not nutrition recommendations, and evidence/rights are reviewed separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "nutrient_id",
    "concentration_mg_per_kg",
    "concentration_mass_basis",
    "concentration_stage",
    "concentration_provenance",
    "concentration_evidence_uri",
    "edible_mass_kg_at_concentration_stage",
    "edible_mass_basis_at_concentration_stage"
  ],
  "properties": {
    "schema_version": {
      "const": "cropfoundry-nutrition-accounting-input-v1"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "nutrient_id": {
      "type": "string",
      "minLength": 1
    },
    "concentration_mg_per_kg": {
      "type": "number",
      "minimum": 0
    },
    "concentration_mass_basis": {
      "enum": [
        "fresh_edible_mass",
        "dry_edible_mass"
      ]
    },
    "concentration_stage": {
      "enum": [
        "measured_at_serving",
        "measured_before_preparation"
      ]
    },
    "concentration_provenance": {
      "enum": [
        "direct_assay",
        "literature_value",
        "model_estimate"
      ]
    },
    "concentration_evidence_uri": {
      "type": "string",
      "minLength": 1
    },
    "assay_method": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "concentration_lower_mg_per_kg": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "concentration_upper_mg_per_kg": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "edible_mass_kg_at_concentration_stage": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "edible_mass_basis_at_concentration_stage": {
      "enum": [
        "fresh_edible_mass",
        "dry_edible_mass"
      ]
    },
    "edible_mass_lower_kg_at_concentration_stage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "edible_mass_upper_kg_at_concentration_stage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "servings_in_batch": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "retention_fraction": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "retention_evidence_uri": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "retention_lower_fraction": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "retention_upper_fraction": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "bioavailability_fraction": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "bioavailability_evidence_uri": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "bioavailability_lower_fraction": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "bioavailability_upper_fraction": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty_interval_kind": {
      "enum": [
        "confidence_interval95",
        "credible_interval95",
        "measurement_tolerance",
        "sensitivity_bounds",
        "observed_range",
        null
      ]
    },
    "uncertainty_evidence_uri": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "water_liters": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "land_square_meters": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "energy_kwh": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost_amount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "currency_code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z]{3}$"
    },
    "source_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Fa-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "concentration_provenance": {
            "const": "direct_assay"
          }
        },
        "required": [
          "concentration_provenance"
        ]
      },
      "then": {
        "required": [
          "assay_method",
          "source_sha256"
        ],
        "properties": {
          "assay_method": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "concentration_stage": {
            "const": "measured_before_preparation"
          }
        },
        "required": [
          "concentration_stage"
        ]
      },
      "then": {
        "required": [
          "retention_fraction",
          "retention_evidence_uri"
        ],
        "properties": {
          "retention_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "retention_evidence_uri": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "concentration_stage": {
            "const": "measured_at_serving"
          }
        },
        "required": [
          "concentration_stage"
        ]
      },
      "then": {
        "properties": {
          "retention_fraction": {
            "type": "null"
          },
          "retention_lower_fraction": {
            "type": "null"
          },
          "retention_upper_fraction": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "concentration_lower_mg_per_kg"
            ],
            "properties": {
              "concentration_lower_mg_per_kg": {
                "type": "number"
              }
            }
          },
          {
            "required": [
              "concentration_upper_mg_per_kg"
            ],
            "properties": {
              "concentration_upper_mg_per_kg": {
                "type": "number"
              }
            }
          },
          {
            "required": [
              "edible_mass_lower_kg_at_concentration_stage"
            ],
            "properties": {
              "edible_mass_lower_kg_at_concentration_stage": {
                "type": "number"
              }
            }
          },
          {
            "required": [
              "edible_mass_upper_kg_at_concentration_stage"
            ],
            "properties": {
              "edible_mass_upper_kg_at_concentration_stage": {
                "type": "number"
              }
            }
          },
          {
            "required": [
              "retention_lower_fraction"
            ],
            "properties": {
              "retention_lower_fraction": {
                "type": "number"
              }
            }
          },
          {
            "required": [
              "retention_upper_fraction"
            ],
            "properties": {
              "retention_upper_fraction": {
                "type": "number"
              }
            }
          },
          {
            "required": [
              "bioavailability_lower_fraction"
            ],
            "properties": {
              "bioavailability_lower_fraction": {
                "type": "number"
              }
            }
          },
          {
            "required": [
              "bioavailability_upper_fraction"
            ],
            "properties": {
              "bioavailability_upper_fraction": {
                "type": "number"
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "concentration_lower_mg_per_kg",
          "concentration_upper_mg_per_kg",
          "edible_mass_lower_kg_at_concentration_stage",
          "edible_mass_upper_kg_at_concentration_stage",
          "uncertainty_interval_kind",
          "uncertainty_evidence_uri"
        ],
        "properties": {
          "concentration_lower_mg_per_kg": {
            "type": "number",
            "minimum": 0
          },
          "concentration_upper_mg_per_kg": {
            "type": "number",
            "minimum": 0
          },
          "edible_mass_lower_kg_at_concentration_stage": {
            "type": "number",
            "minimum": 0
          },
          "edible_mass_upper_kg_at_concentration_stage": {
            "type": "number",
            "minimum": 0
          },
          "uncertainty_interval_kind": {
            "enum": [
              "confidence_interval95",
              "credible_interval95",
              "measurement_tolerance",
              "sensitivity_bounds",
              "observed_range"
            ]
          },
          "uncertainty_evidence_uri": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "bioavailability_lower_fraction": {
            "type": "number"
          }
        },
        "required": [
          "bioavailability_lower_fraction"
        ]
      },
      "then": {
        "required": [
          "bioavailability_fraction",
          "bioavailability_upper_fraction",
          "bioavailability_evidence_uri"
        ],
        "properties": {
          "bioavailability_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bioavailability_upper_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bioavailability_evidence_uri": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "bioavailability_upper_fraction": {
            "type": "number"
          }
        },
        "required": [
          "bioavailability_upper_fraction"
        ]
      },
      "then": {
        "required": [
          "bioavailability_fraction",
          "bioavailability_lower_fraction",
          "bioavailability_evidence_uri"
        ],
        "properties": {
          "bioavailability_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bioavailability_lower_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bioavailability_evidence_uri": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cost_amount": {
            "type": "number"
          }
        },
        "required": [
          "cost_amount"
        ]
      },
      "then": {
        "required": [
          "currency_code"
        ],
        "properties": {
          "currency_code": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$"
          }
        }
      }
    }
  ]
}
