  "negative_control_policy": {
    "every_mutation_must": [
      "be_detected",
      "or_produce_explicit_abstention"
    ],
    "forbidden_dispositions": [
      "pass",
      "complete",
      "equivalent",
      "verified",
      "attested"
    ],
    "when_evidence_is_missing_or_unsupported": "abstain"
  },
  "reporting": {
    "keep_platforms_separate": true,
    "report_confidence_intervals": true,
    "report_median_and_tail_latency": true,
    "report_per_family_results": true,
    "report_ablation_results": true,
    "publish_exact_artifact_and_tool_digests": true,
    "never_pool_simulator_and_physical_device_performance": true
