  "invariants": [
    "REA is an optional external evidence producer; it is not a Symthaea core dependency.",
    "Raw provider evidence is immutable and retains its exact digest.",
    "Read-only Android device commands are allowlisted; target-mutating REA tools are disabled.",
    "Unsupported, encrypted, missing, partial and unknown remain explicit non-success states.",
    "A structural parse cannot establish runtime behavior, hardware attestation or causal equivalence.",
    "No firmware execution, flashing, bootloader modification, jailbreak or device write is permitted."
  ],
  "evidence_tiers": [
    "raw_observation",
    "structural_parse",
    "independently_semantically_checked",
    "controlled_runtime_observation",
    "authenticated_hardware_evidence",
    "causal_support"
  ],
