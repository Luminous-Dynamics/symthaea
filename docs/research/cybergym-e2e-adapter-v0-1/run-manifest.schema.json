{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyberGym-E2E run manifest v0.1",
  "description": "Input/configuration manifest only. Run outcomes and execution claims belong in separately verified receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_state",
    "created_at",
    "benchmark",
    "selection",
    "agent",
    "execution",
    "authority",
    "oracle",
    "receipt_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.cybergym-e2e.run-manifest.v0.1"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$"
    },
    "manifest_state": {
      "enum": [
        "planning",
        "frozen",
        "superseded"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "mode",
        "website",
        "code_repository",
        "dataset_repository",
        "dataset_revision",
        "dataset_update_date",
        "source_readme_blob_sha",
        "dataset_download_state"
      ],
      "properties": {
        "name": {
          "const": "CyberGym-E2E"
        },
        "mode": {
          "enum": [
            "e2e",
            "patch-only"
          ]
        },
        "website": {
          "const": "https://www.cybergym.io/cybergym-e2e/"
        },
        "code_repository": {
          "const": "https://github.com/sunblaze-ucb/cybergym-e2e"
        },
        "dataset_repository": {
          "const": "sunblaze-ucb/cybergym-e2e"
        },
        "dataset_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dataset_update_date": {
          "const": "2026-11-16"
        },
        "source_readme_blob_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dataset_download_state": {
          "enum": [
            "not-downloaded",
            "retrieved",
            "integrity-checked"
          ]
        },
        "retrieval_record_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "artifact_manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-f0-9]{64})?$"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_ids",
        "excluded_tasks",
        "selection_policy"
      ],
      "properties": {
        "task_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "excluded_tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "reason"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "reason": {
                "enum": [
                  "license-not-cleared",
                  "unsupported-environment",
                  "infrastructure-unavailable",
                  "duplicate-task",
                  "predeclared-scope-exclusion",
                  "other"
                ]
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        },
        "selection_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "confirmatory_split_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-f0-9]{64})?$"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "model_version",
        "harness_name",
        "harness_revision",
        "system_prompt_sha256",
        "tool_profile_id"
      ],
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "harness_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "harness_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})?$"
        },
        "system_prompt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-f0-9]{64})?$"
        },
        "tool_profile_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "decoding_profile": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_identity",
        "runner_revision",
        "container_image",
        "host",
        "isolation",
        "budget"
      ],
      "properties": {
        "runner_identity": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "runner_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})?$"
        },
        "container_image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "digest"
          ],
          "properties": {
            "reference": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            },
            "digest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "kernel",
            "architecture",
            "cpu",
            "gpu",
            "ram_bytes"
          ],
          "properties": {
            "os": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "kernel": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "architecture": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "cpu": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "gpu": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "ram_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network_firewall_enabled",
            "firewall_bypass",
            "allowed_egress_domains",
            "host_network",
            "host_secret_mounts",
            "cloud_metadata_access",
            "privileged_container"
          ],
          "properties": {
            "network_firewall_enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "firewall_bypass": {
              "const": false
            },
            "allowed_egress_domains": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              }
            },
            "host_network": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "host_secret_mounts": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "cloud_metadata_access": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "privileged_container": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wall_time_limit_seconds",
            "max_parallel_tasks",
            "token_limit",
            "cost_limit_usd"
          ],
          "properties": {
            "wall_time_limit_seconds": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "max_parallel_tasks": {
              "type": "integer",
              "minimum": 1
            },
            "token_limit": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "cost_limit_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "permitted_operations",
        "allowed_external_targets",
        "production_credentials_present",
        "local_task_effects_only"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "permitted_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read-task-source",
              "build-task",
              "run-candidate-poc",
              "apply-candidate-patch",
              "run-project-tests",
              "collect-benchmark-logs"
            ]
          }
        },
        "allowed_external_targets": {
          "type": "array",
          "maxItems": 0
        },
        "production_credentials_present": {
          "const": false
        },
        "local_task_effects_only": {
          "const": true
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_custody",
        "ground_truth_poc_visible_to_agent",
        "ground_truth_patch_visible_to_agent",
        "candidate_can_modify_oracle",
        "oracle_digest_commitment"
      ],
      "properties": {
        "evaluator_custody": {
          "enum": [
            "separate-process",
            "separate-service",
            "independent-operator",
            "not-yet-configured"
          ]
        },
        "ground_truth_poc_visible_to_agent": {
          "type": "boolean"
        },
        "ground_truth_patch_visible_to_agent": {
          "const": false
        },
        "candidate_can_modify_oracle": {
          "const": false
        },
        "oracle_digest_commitment": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-f0-9]{64})?$"
        }
      }
    },
    "receipt_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_receipt_profile",
        "result_receipt_required",
        "raw_artifact_retention"
      ],
      "properties": {
        "execution_receipt_profile": {
          "const": "Symthaea-D6.3-in-toto-DSSE-conditional-v0.1"
        },
        "result_receipt_required": {
          "const": true
        },
        "raw_artifact_retention": {
          "enum": [
            "content-addressed-retained",
            "rights-restricted-retained",
            "ephemeral-with-digest",
            "not-yet-decided"
          ]
        },
        "external_reproduction_receipt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "manifest_state": {
            "const": "frozen"
          }
        }
      },
      "then": {
        "properties": {
          "benchmark": {
            "properties": {
              "dataset_download_state": {
                "const": "integrity-checked"
              },
              "artifact_manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "selection": {
            "properties": {
              "task_ids": {
                "minItems": 1
              }
            }
          },
          "agent": {
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "model_version": {
                "type": "string",
                "minLength": 1
              },
              "harness_name": {
                "type": "string",
                "minLength": 1
              },
              "harness_revision": {
                "type": "string",
                "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
              },
              "system_prompt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "tool_profile_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "execution": {
            "properties": {
              "runner_identity": {
                "type": "string",
                "minLength": 1
              },
              "runner_revision": {
                "type": "string",
                "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
              },
              "container_image": {
                "properties": {
                  "reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                }
              },
              "host": {
                "properties": {
                  "os": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kernel": {
                    "type": "string",
                    "minLength": 1
                  },
                  "architecture": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cpu": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ram_bytes": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "isolation": {
                "properties": {
                  "network_firewall_enabled": {
                    "const": true
                  },
                  "host_network": {
                    "const": false
                  },
                  "host_secret_mounts": {
                    "const": false
                  },
                  "cloud_metadata_access": {
                    "const": false
                  },
                  "privileged_container": {
                    "const": false
                  }
                }
              },
              "budget": {
                "properties": {
                  "wall_time_limit_seconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "oracle": {
            "properties": {
              "evaluator_custody": {
                "enum": [
                  "separate-process",
                  "separate-service",
                  "independent-operator"
                ]
              },
              "oracle_digest_commitment": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "benchmark": {
            "properties": {
              "mode": {
                "const": "e2e"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "oracle": {
            "properties": {
              "ground_truth_poc_visible_to_agent": {
                "const": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "oracle": {
            "properties": {
              "ground_truth_poc_visible_to_agent": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
