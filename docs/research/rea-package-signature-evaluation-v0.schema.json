{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/rea-package-signature-evaluation-v0.schema.json",
  "title": "REA platform package-signature evaluation",
  "description": "Versioned platform-scoped evidence for package signature, signer identity, trust policy and authorization. These propositions are intentionally independent; no generic trust boolean is defined.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package",
    "platform",
    "scheme_evaluations",
    "signers",
    "trust_policy",
    "authorization",
    "nested_code",
    "installability",
    "runtime",
    "provenance",
    "claim_scope",
    "attestation"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "whole_package_sha256",
        "size_bytes"
      ],
      "properties": {
        "format": {
          "enum": [
            "apk",
            "ipa",
            "app_bundle",
            "unknown"
          ]
        },
        "whole_package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "bundle_or_application_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecosystem",
        "os_version",
        "architecture",
        "evaluation_environment"
      ],
      "properties": {
        "ecosystem": {
          "enum": [
            "android",
            "apple",
            "unknown"
          ]
        },
        "os_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "api_or_platform_build": {
          "type": [
            "string",
            "null"
          ]
        },
        "architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "evaluation_environment": {
          "enum": [
            "offline_parser",
            "official_tool",
            "platform_api",
            "device_package_manager",
            "simulator",
            "unknown"
          ]
        },
        "device_or_runtime_model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scheme_evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scheme",
          "presence",
          "cryptographic_result",
          "coverage_scope",
          "verifier"
        ],
        "properties": {
          "scheme": {
            "enum": [
              "apk_v1_jar",
              "apk_v2",
              "apk_v3",
              "apk_v3_1",
              "apk_v4",
              "apple_code_directory",
              "apple_cms_signature",
              "apple_resource_envelope",
              "apple_der_entitlements",
              "apple_provisioning_profile_cms",
              "unknown"
            ]
          },
          "presence": {
            "enum": [
              "present",
              "absent",
              "unknown"
            ]
          },
          "cryptographic_result": {
            "enum": [
              "valid",
              "invalid",
              "unsupported",
              "not_evaluated",
              "unknown"
            ]
          },
          "coverage_scope": {
            "type": "string",
            "minLength": 1
          },
          "protected_digest_algorithm": {
            "type": [
              "string",
              "null"
            ]
          },
          "signature_algorithm": {
            "type": [
              "string",
              "null"
            ]
          },
          "signer_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "verifier": {
            "$ref": "#/$defs/verifier"
          }
        }
      }
    },
    "signers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "certificate_sha256",
          "public_key_sha256",
          "signature_result",
          "identity_attribution"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "certificate_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([0-9a-f]{64})?$"
          },
          "public_key_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([0-9a-f]{64})?$"
          },
          "subject_display": {
            "type": [
              "string",
              "null"
            ]
          },
          "issuer_display": {
            "type": [
              "string",
              "null"
            ]
          },
          "signature_result": {
            "enum": [
              "valid",
              "invalid",
              "unsupported",
              "not_evaluated",
              "unknown"
            ]
          },
          "identity_attribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result",
              "attribution_claim",
              "evidence_references"
            ],
            "properties": {
              "result": {
                "enum": [
                  "verified_under_policy",
                  "unverified",
                  "conflicting",
                  "not_evaluated",
                  "unknown"
                ]
              },
              "attribution_claim": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_references": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "rotation_lineage": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "result",
              "steps"
            ],
            "properties": {
              "result": {
                "enum": [
                  "valid",
                  "invalid",
                  "unsupported",
                  "not_present",
                  "not_evaluated",
                  "unknown"
                ]
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "certificate_sha256",
                    "algorithm",
                    "verified"
                  ],
                  "properties": {
                    "certificate_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "algorithm": {
                      "type": "string"
                    },
                    "verified": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "trust_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "policy_id",
        "policy_version",
        "evaluation_time",
        "trust_anchor_set_sha256",
        "revocation_policy",
        "revocation_result"
      ],
      "properties": {
        "result": {
          "enum": [
            "accepted",
            "rejected",
            "not_evaluated",
            "indeterminate",
            "unknown"
          ]
        },
        "policy_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "evaluation_time": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "trust_anchor_set_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{64})?$"
        },
        "revocation_policy": {
          "enum": [
            "required",
            "best_effort",
            "not_checked",
            "not_applicable",
            "unknown"
          ]
        },
        "revocation_result": {
          "enum": [
            "good",
            "revoked",
            "unknown",
            "not_checked",
            "not_applicable"
          ]
        },
        "chain_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "signer_index",
              "result",
              "detail"
            ],
            "properties": {
              "signer_index": {
                "type": "integer",
                "minimum": 0
              },
              "result": {
                "enum": [
                  "valid",
                  "invalid",
                  "untrusted",
                  "expired",
                  "not_yet_valid",
                  "revoked",
                  "unknown"
                ]
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "policy_id",
        "application_or_bundle_id",
        "team_or_signing_id",
        "entitlement_evaluation",
        "distribution_constraints"
      ],
      "properties": {
        "result": {
          "enum": [
            "authorized",
            "denied",
            "not_evaluated",
            "indeterminate",
            "unknown"
          ]
        },
        "policy_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "application_or_bundle_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "team_or_signing_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "entitlement_evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "claimed_entitlements_sha256",
            "allowed_entitlements_sha256",
            "violations"
          ],
          "properties": {
            "result": {
              "enum": [
                "authorized",
                "denied",
                "not_evaluated",
                "indeterminate",
                "unknown"
              ]
            },
            "claimed_entitlements_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^([0-9a-f]{64})?$"
            },
            "allowed_entitlements_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^([0-9a-f]{64})?$"
            },
            "violations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "distribution_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nested_code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_result",
        "components"
      ],
      "properties": {
        "coverage_result": {
          "enum": [
            "complete_for_declared_scope",
            "partial",
            "unsupported",
            "not_evaluated",
            "unknown"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relative_path",
              "component_sha256",
              "component_kind",
              "evaluation_result"
            ],
            "properties": {
              "relative_path": {
                "type": "string"
              },
              "component_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^([0-9a-f]{64})?$"
              },
              "component_kind": {
                "enum": [
                  "main_executable",
                  "framework",
                  "extension",
                  "watch_app",
                  "resource_bundle",
                  "plugin",
                  "other",
                  "unknown"
                ]
              },
              "signer_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "evaluation_result": {
                "enum": [
                  "valid",
                  "invalid",
                  "unsupported",
                  "not_evaluated",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    "installability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "platform_context",
        "detail"
      ],
      "properties": {
        "result": {
          "enum": [
            "installable_in_tested_context",
            "not_installable_in_tested_context",
            "not_tested",
            "unknown"
          ]
        },
        "platform_context": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "test_context",
        "observations"
      ],
      "properties": {
        "result": {
          "enum": [
            "observed_expected_behavior",
            "observed_unexpected_behavior",
            "not_tested",
            "unknown"
          ]
        },
        "test_context": {
          "type": [
            "string",
            "null"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/verifier"
    },
    "claim_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asserted_claims",
        "not_established"
      ],
      "properties": {
        "asserted_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "package_content_integrity",
              "signature_cryptographic_validity",
              "signer_certificate_key_digest",
              "signer_identity_attribution",
              "trust_policy_acceptance",
              "package_authorization",
              "installability_in_tested_context",
              "runtime_behavior_in_tested_context"
            ]
          }
        },
        "not_established": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "publisher_benevolence",
              "code_safety",
              "absence_of_malicious_behavior",
              "future_runtime_behavior",
              "user_intent_alignment",
              "all_platforms_compatibility",
              "unobserved_signing_schemes",
              "unobserved_nested_code",
              "global_trustworthiness"
            ]
          }
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "in_toto_dsse_reference"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_provided",
            "separate_envelope_reference"
          ]
        },
        "in_toto_dsse_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version",
        "source_commit",
        "toolchain",
        "target",
        "dependency_lock_sha256"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "dependency_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
