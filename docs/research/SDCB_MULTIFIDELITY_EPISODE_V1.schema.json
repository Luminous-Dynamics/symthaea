{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SDCB_MULTIFIDELITY_EPISODE_V1.schema.json",
  "title": "SDCB robust multi-fidelity decision episode v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "prior",
    "action_ids",
    "scenarios",
    "fidelity_options"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "prior": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "action_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "utility_by_hypothesis"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "utility_by_hypothesis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "fidelity_options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "design_id",
          "fidelity_id",
          "resource_cost",
          "likelihoods_by_scenario"
        ],
        "properties": {
          "design_id": {
            "type": "string",
            "minLength": 1
          },
          "fidelity_id": {
            "type": "string",
            "minLength": 1
          },
          "resource_cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "money_units",
              "instrument_minutes",
              "compute_seconds",
              "energy_watt_hours"
            ],
            "properties": {
              "money_units": {
                "type": "number",
                "minimum": 0
              },
              "instrument_minutes": {
                "type": "number",
                "minimum": 0
              },
              "compute_seconds": {
                "type": "number",
                "minimum": 0
              },
              "energy_watt_hours": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "likelihoods_by_scenario": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "money_units",
        "instrument_minutes",
        "compute_seconds",
        "energy_watt_hours"
      ],
      "properties": {
        "money_units": {
          "type": "number",
          "minimum": 0
        },
        "instrument_minutes": {
          "type": "number",
          "minimum": 0
        },
        "compute_seconds": {
          "type": "number",
          "minimum": 0
        },
        "energy_watt_hours": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "$comment": "Cross-field validation: prior sums to 1; scenario IDs and design_id/fidelity_id pairs are unique; utility rows equal prior count and have action width; fidelity likelihood scenario count equals scenarios; each scenario matrix has one normalized row per hypothesis and equal outcome width across scenarios for the same fidelity option. Resource dimensions and units are declared by the task; never sum or compare across unlike dimensions."
}
