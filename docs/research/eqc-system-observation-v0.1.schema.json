{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/eqc-system-observation-v0.1.schema.json",
  "title": "Evidence-Qualified Capability System Observation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "system",
    "actor_id",
    "subject_id",
    "authorization_decision",
    "task_success",
    "input_digests",
    "authority_snapshot_sha256",
    "state_mutation_count",
    "action_log_sha256",
    "result_digest_sha256",
    "verifier",
    "resource_usage"
  ],
  "properties": {
    "schema": {
      "const": "luminous.eqc.system-observation.v0.1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^eqc-[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "version",
        "harness_version",
        "source_sha256",
        "environment_sha256"
      ],
      "properties": {
        "system_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "harness_version": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_decision": {
      "enum": [
        "allow",
        "deny",
        "unresolved"
      ]
    },
    "task_success": {
      "type": "boolean"
    },
    "input_digests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_id",
          "sha256"
        ],
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "authority_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_mutation_count": {
      "type": "integer",
      "minimum": 0
    },
    "action_log_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_id",
        "verifier_sha256",
        "replay",
        "independent",
        "replay_result_sha256"
      ],
      "properties": {
        "verifier_id": {
          "type": "string",
          "minLength": 1
        },
        "verifier_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "replay": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "independent": {
          "type": "boolean"
        },
        "replay_result_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_ms",
        "cpu_time_ms",
        "peak_memory_bytes",
        "tool_calls",
        "network_bytes",
        "network_endpoints",
        "human_interventions",
        "energy_millijoules",
        "cost_microusd"
      ],
      "properties": {
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "peak_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "network_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "network_endpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "human_interventions": {
          "type": "integer",
          "minimum": 0
        },
        "energy_millijoules": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_microusd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
