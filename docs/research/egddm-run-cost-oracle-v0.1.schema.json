{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-run-cost-oracle-v0.1.schema.json",
  "title": "EGDDM D6.17.2.3 evaluator-approved run context v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approved_context",
    "approved_option_ids"
  ],
  "properties": {
    "approved_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_full_name",
        "branch",
        "commit_sha",
        "worktree_digest_sha256",
        "model_provider",
        "model_version",
        "model_config_digest_sha256",
        "harness_digest_sha256",
        "toolset_digest_sha256",
        "permissions_digest_sha256",
        "runner_class",
        "hardware_class",
        "runner_image_digest_sha256",
        "region",
        "billing_currency"
      ],
      "properties": {
        "repository_full_name": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "worktree_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "model_provider": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "model_config_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "harness_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "toolset_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "permissions_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "runner_class": {
          "type": "string",
          "minLength": 1
        },
        "hardware_class": {
          "type": "string",
          "minLength": 1
        },
        "runner_image_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "billing_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "approved_option_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "billing_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  }
}
