{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:aqua-pressure-transient-event:0.1.0",
  "title": "Luminous Aqua pressure transient event profile",
  "description": "Provenance-bound manifest for a site-observed or explicitly synthetic supply/demand event replay. A schema-valid manifest is not metrology admission or physical qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_revision",
    "profile_kind",
    "event_family",
    "task_profile_id",
    "conditions_sha256",
    "protocol_sha256",
    "event_start",
    "event_duration_ms",
    "command",
    "acquisition",
    "raw_artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "profile_revision": {
      "type": "integer",
      "minimum": 1
    },
    "profile_kind": {
      "enum": [
        "site_observed",
        "synthetic"
      ]
    },
    "event_family": {
      "enum": [
        "supply_sag",
        "supply_ramp",
        "concurrent_demand_step",
        "intermittent_supply",
        "repeated_demand_cycling",
        "rapid_valve_event"
      ]
    },
    "task_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "conditions_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "protocol_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "event_start": {
      "type": "string",
      "format": "date-time"
    },
    "event_duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "site_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "site_profile_revision": {
      "type": "integer",
      "minimum": 1
    },
    "site_conditions_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "observation_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "coverage_statement"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "coverage_statement": {
          "type": "string",
          "minLength": 1
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "site_survey_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "generator_id": {
      "type": "string",
      "minLength": 1
    },
    "generator_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "generator_parameters_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_kind",
        "channel_id",
        "unit",
        "samples"
      ],
      "properties": {
        "input_kind": {
          "enum": [
            "upstream_pressure_command",
            "branch_demand_command",
            "valve_state_command"
          ]
        },
        "channel_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "enum": [
            "kPa",
            "L/min",
            "boolean"
          ]
        },
        "samples": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": [
                  "number",
                  "boolean"
                ]
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock_id",
        "timestamp_basis",
        "clock_sync_uncertainty_us",
        "clock_sync_receipt_sha256",
        "channels"
      ],
      "properties": {
        "clock_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_basis": {
          "enum": [
            "monotonic",
            "utc_disciplined",
            "ptp",
            "other_declared"
          ]
        },
        "clock_sync_uncertainty_us": {
          "type": "number",
          "minimum": 0
        },
        "clock_sync_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "channels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/channel"
          }
        }
      }
    },
    "raw_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "sha256",
          "byte_length"
        ],
        "properties": {
          "role": {
            "enum": [
              "unfiltered_trace",
              "event_log",
              "calibration_bundle",
              "clock_sync_receipt",
              "site_observation_record"
            ]
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 1
          },
          "media_type": {
            "type": "string"
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analysis_code_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "filter_definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "exclusion_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile_kind": {
            "const": "site_observed"
          }
        },
        "required": [
          "profile_kind"
        ]
      },
      "then": {
        "required": [
          "site_profile_id",
          "site_profile_revision",
          "site_conditions_sha256",
          "observation_window",
          "site_survey_receipt_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "profile_kind": {
            "const": "synthetic"
          }
        },
        "required": [
          "profile_kind"
        ]
      },
      "then": {
        "required": [
          "generator_id",
          "generator_sha256",
          "generator_parameters_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "profile_kind": {
            "const": "site_observed"
          }
        },
        "required": [
          "profile_kind"
        ]
      },
      "then": {
        "properties": {
          "raw_artifacts": {
            "contains": {
              "type": "object",
              "properties": {
                "role": {
                  "const": "site_observation_record"
                }
              },
              "required": [
                "role"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "role",
        "location",
        "datum",
        "unit",
        "instrument_id",
        "calibration_receipt_sha256",
        "measurement_uncertainty",
        "quality_state"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1
        },
        "quality_state": {
          "enum": [
            "valid",
            "clipped",
            "saturated",
            "out_of_range",
            "unknown"
          ]
        },
        "role": {
          "enum": [
            "upstream_static_pressure",
            "upstream_residual_pressure",
            "terminal_dynamic_pressure",
            "point_of_discharge_pressure",
            "hot_inlet_pressure",
            "cold_inlet_pressure",
            "faceplate_center_pressure",
            "branch_pressure",
            "primary_flow",
            "secondary_branch_flow",
            "outlet_temperature"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "datum": {
          "enum": [
            "static_supply",
            "upstream_service_point",
            "terminal_fitting_inlet",
            "point_of_discharge",
            "hot_mixer_inlet",
            "cold_mixer_inlet",
            "faceplate_center",
            "branch_point",
            "fixture_outlet",
            "not_applicable"
          ]
        },
        "unit": {
          "enum": [
            "kPa",
            "L/min",
            "degC"
          ]
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1
        },
        "calibration_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "measurement_uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "sample_rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "effective_bandwidth_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "anti_alias_filter_id": {
          "type": "string",
          "minLength": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "dropped_sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "sample_gap_report_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dropped_sample_count": {
                "minimum": 1
              }
            },
            "required": [
              "dropped_sample_count"
            ]
          },
          "then": {
            "required": [
              "sample_gap_report_sha256"
            ]
          }
        }
      ]
    }
  }
}
