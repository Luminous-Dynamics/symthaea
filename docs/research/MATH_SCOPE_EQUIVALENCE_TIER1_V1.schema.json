{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/MATH_SCOPE_EQUIVALENCE_TIER1_V1.schema.json",
  "title": "ScopeEquivalenceTier1DatasetV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pairs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pair"
      }
    }
  },
  "$defs": {
    "formula": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "name"
          ],
          "properties": {
            "op": {
              "const": "atom"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arg"
          ],
          "properties": {
            "op": {
              "const": "not"
            },
            "arg": {
              "$ref": "#/$defs/formula"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "const": "and"
            },
            "left": {
              "$ref": "#/$defs/formula"
            },
            "right": {
              "$ref": "#/$defs/formula"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "const": "or"
            },
            "left": {
              "$ref": "#/$defs/formula"
            },
            "right": {
              "$ref": "#/$defs/formula"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "const": "implies"
            },
            "left": {
              "$ref": "#/$defs/formula"
            },
            "right": {
              "$ref": "#/$defs/formula"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "const": "iff"
            },
            "left": {
              "$ref": "#/$defs/formula"
            },
            "right": {
              "$ref": "#/$defs/formula"
            }
          }
        }
      ]
    },
    "sequent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypotheses",
        "premises",
        "conclusion"
      ],
      "properties": {
        "hypotheses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formula"
          }
        },
        "premises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formula"
          }
        },
        "conclusion": {
          "$ref": "#/$defs/formula"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id",
        "source",
        "base",
        "variant"
      ],
      "properties": {
        "pair_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "revision",
            "declaration",
            "task_family"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "declaration": {
              "type": "string",
              "minLength": 1
            },
            "task_family": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "base": {
          "$ref": "#/$defs/sequent"
        },
        "variant": {
          "$ref": "#/$defs/sequent"
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalizer_version",
        "expected_relation",
        "adjudication_authority",
        "evidence_refs"
      ],
      "properties": {
        "normalizer_version": {
          "const": "scope-tier1-unordered-hypotheses-v1"
        },
        "expected_relation": {
          "enum": [
            "exact_identity",
            "tier1_hypothesis_permutation_equivalent",
            "not_tier1_equivalent"
          ]
        },
        "adjudication_authority": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "evaluator_only"
      ],
      "properties": {
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "evaluator_only": {
          "$ref": "#/$defs/evaluator"
        }
      }
    }
  }
}
