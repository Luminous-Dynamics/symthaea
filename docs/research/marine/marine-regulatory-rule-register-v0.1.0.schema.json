{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:marine-regulatory-rule-register:0.1.0",
  "title": "Luminous Marine Regulatory Rule Register v0.1.0",
  "description": "Versioned snapshot of maritime rules, adopted measures, official guidance and proposals. A conforming register is not a legal applicability determination.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "snapshot_date",
    "status_policy",
    "rules",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "status_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_statuses",
        "promotion_policy",
        "limitations"
      ],
      "properties": {
        "rule_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "proposed",
              "under_review",
              "adopted",
              "in_force",
              "applicable",
              "superseded",
              "withdrawn",
              "guidance_adopted"
            ]
          }
        },
        "promotion_policy": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "date_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adopted_on": {
          "type": "string",
          "format": "date"
        },
        "entry_into_force_on": {
          "type": "string",
          "format": "date"
        },
        "applies_from": {
          "type": "string",
          "format": "date"
        },
        "applies_from_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        },
        "applies_through": {
          "type": "string",
          "format": "date"
        },
        "review_scheduled_from": {
          "type": "string",
          "format": "date"
        },
        "review_scheduled_through": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "authority",
        "instrument",
        "rule_status",
        "legal_character",
        "dates",
        "applicability",
        "output_scope",
        "source_ids",
        "limitations"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "revision_or_resolution": {
          "type": "string",
          "minLength": 1
        },
        "rule_status": {
          "enum": [
            "proposed",
            "under_review",
            "adopted",
            "in_force",
            "applicable",
            "superseded",
            "withdrawn",
            "guidance_adopted"
          ]
        },
        "legal_character": {
          "enum": [
            "binding_regulation",
            "marpol_requirement",
            "adopted_amendment_future_application",
            "official_guideline",
            "committee_workplan",
            "negotiation_proposal",
            "class_society_requirement",
            "unknown"
          ]
        },
        "dates": {
          "$ref": "#/$defs/date_window"
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ship_scope",
            "geographic_scope",
            "voyage_scope",
            "conditions"
          ],
          "properties": {
            "ship_scope": {
              "type": "string",
              "minLength": 1
            },
            "geographic_scope": {
              "type": "string",
              "minLength": 1
            },
            "voyage_scope": {
              "type": "string",
              "minLength": 1
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclusions_or_unknowns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "engine_power_kw_min_exclusive": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ship_construction_triggers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "milestone",
                  "threshold_date",
                  "meaning"
                ],
                "properties": {
                  "milestone": {
                    "enum": [
                      "building_contract_placed",
                      "keel_laid_or_similar_stage",
                      "ship_delivery"
                    ]
                  },
                  "threshold_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "output_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "calculation_contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metric_id": {
              "type": "string",
              "minLength": 1
            },
            "reference_value": {
              "type": "number"
            },
            "reference_unit": {
              "type": "string",
              "minLength": 1
            },
            "formula_or_method": {
              "type": "string",
              "minLength": 1
            },
            "phase_in": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "year",
                  "value",
                  "unit",
                  "meaning"
                ],
                "properties": {
                  "year": {
                    "type": "integer",
                    "minimum": 1900,
                    "maximum": 2200
                  },
                  "value": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "publisher",
        "uri",
        "evidence_class",
        "limitations"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "publication_date": {
          "type": "string",
          "format": "date"
        },
        "evidence_class": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
