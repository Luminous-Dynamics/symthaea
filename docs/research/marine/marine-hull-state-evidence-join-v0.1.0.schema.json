{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:marine-hull-state-evidence-join:0.1.0",
  "title": "Luminous Marine Hull-State Evidence Join v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "join_id",
    "record_status",
    "claim_mode",
    "vessel_identity",
    "service_fingerprint",
    "acoustic_link",
    "hull_inspection_link",
    "cleaning_link",
    "performance_links",
    "time_alignment_policy",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "join_id": {
      "type": "string",
      "minLength": 1
    },
    "record_status": {
      "enum": [
        "synthetic",
        "measured",
        "modelled"
      ]
    },
    "claim_mode": {
      "const": "contextual_linkage_only"
    },
    "vessel_identity": {
      "$ref": "#/$defs/identity"
    },
    "service_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "acoustic_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "raw_trace_sha256",
        "measurement_start",
        "measurement_end"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_trace_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "measurement_start": {
          "type": "string",
          "format": "date-time"
        },
        "measurement_end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "hull_inspection_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "inspection_id",
        "raw_data_sha256",
        "inspection_date"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "inspection_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_data_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inspection_date": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "cleaning_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleaning_id",
        "start",
        "end"
      ],
      "properties": {
        "cleaning_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "performance_links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_observation_id",
        "before_trace_sha256",
        "after_observation_id",
        "after_trace_sha256"
      ],
      "properties": {
        "before_observation_id": {
          "type": "string",
          "minLength": 1
        },
        "before_trace_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "after_observation_id": {
          "type": "string",
          "minLength": 1
        },
        "after_trace_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "time_alignment_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_acoustic_inspection_separation_seconds",
        "acoustic_must_precede_cleaning",
        "post_observation_must_follow_cleaning"
      ],
      "properties": {
        "max_acoustic_inspection_separation_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "acoustic_must_precede_cleaning": {
          "const": true
        },
        "post_observation_must_follow_cleaning": {
          "const": true
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
