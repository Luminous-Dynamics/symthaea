{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:marine-port-call-energy:0.1.0",
  "title": "Luminous Marine Port Call Energy Contract v0.1.0",
  "description": "Deterministic ship-port OPS/charging energy-delivery case. Not a grid or legal approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "service_fingerprint",
    "port_call_id",
    "port_id",
    "berth_id",
    "vessel_id",
    "berth_window",
    "connection",
    "demand",
    "port_supply",
    "ghg_comparison",
    "evidence_sources",
    "record_status",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "service_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "port_call_id": {
      "type": "string",
      "minLength": 1
    },
    "port_id": {
      "type": "string",
      "minLength": 1
    },
    "berth_id": {
      "type": "string",
      "minLength": 1
    },
    "vessel_id": {
      "type": "string",
      "minLength": 1
    },
    "berth_window": {
      "$ref": "#/$defs/berth_window"
    },
    "connection": {
      "$ref": "#/$defs/connection"
    },
    "demand": {
      "$ref": "#/$defs/demand"
    },
    "port_supply": {
      "$ref": "#/$defs/port_supply"
    },
    "ghg_comparison": {
      "$ref": "#/$defs/ghg_comparison"
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_source"
      }
    },
    "record_status": {
      "enum": [
        "synthetic",
        "measured",
        "modelled",
        "permissioned_operational"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "berth_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "berth_start",
        "berth_end",
        "planned_arrival",
        "planned_departure",
        "connection_time_seconds",
        "disconnection_time_seconds"
      ],
      "properties": {
        "berth_start": {
          "type": "string",
          "format": "date-time"
        },
        "berth_end": {
          "type": "string",
          "format": "date-time"
        },
        "planned_arrival": {
          "type": "string",
          "format": "date-time"
        },
        "planned_departure": {
          "type": "string",
          "format": "date-time"
        },
        "connection_time_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "disconnection_time_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibility",
        "port_availability",
        "connector_standard",
        "connector_identity",
        "voltage_v",
        "frequency_hz",
        "phase_count",
        "ship_max_input_power_w",
        "berth_connection_limit_w"
      ],
      "properties": {
        "compatibility": {
          "enum": [
            "compatible",
            "incompatible",
            "unknown"
          ]
        },
        "port_availability": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "connector_standard": {
          "type": "string",
          "minLength": 1
        },
        "connector_identity": {
          "type": "string",
          "minLength": 1
        },
        "voltage_v": {
          "type": "integer",
          "minimum": 1
        },
        "frequency_hz": {
          "type": "integer",
          "minimum": 1
        },
        "phase_count": {
          "type": "integer",
          "minimum": 1
        },
        "ship_max_input_power_w": {
          "type": "integer",
          "minimum": 0
        },
        "berth_connection_limit_w": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_energy_wh",
        "requested_max_power_w"
      ],
      "properties": {
        "requested_energy_wh": {
          "type": "integer",
          "minimum": 0
        },
        "requested_max_power_w": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "port_supply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reserved_power_w",
        "available_energy_wh",
        "reservation_id",
        "reservation_status"
      ],
      "properties": {
        "reserved_power_w": {
          "type": "integer",
          "minimum": 0
        },
        "available_energy_wh": {
          "type": "integer",
          "minimum": 0
        },
        "reservation_id": {
          "type": "string",
          "minLength": 1
        },
        "reservation_status": {
          "enum": [
            "confirmed",
            "provisional",
            "revoked",
            "unknown"
          ]
        }
      }
    },
    "ghg_factor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor_id",
        "revision",
        "micro_kg_co2e_per_kwh",
        "boundary_id",
        "source_id",
        "method",
        "limitations"
      ],
      "properties": {
        "factor_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "micro_kg_co2e_per_kwh": {
          "type": "integer",
          "minimum": 0
        },
        "boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ghg_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grid_factor",
        "onboard_generator_factor"
      ],
      "properties": {
        "grid_factor": {
          "$ref": "#/$defs/ghg_factor"
        },
        "onboard_generator_factor": {
          "$ref": "#/$defs/ghg_factor"
        }
      }
    },
    "evidence_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "evidence_class",
        "rights_status",
        "limitations"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "synthetic",
            "measured",
            "official",
            "supplier",
            "operator",
            "modelled"
          ]
        },
        "rights_status": {
          "enum": [
            "public",
            "permissioned",
            "restricted",
            "unknown",
            "not_applicable"
          ]
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
