{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:marine-measurement-adequacy:0.1.0",
  "title": "Marine Measurement Adequacy and Identifiability Case v0.1.0",
  "description": "Pre-calibration observation dependency and sensitivity-rank contract. A conforming record is not proof of physical truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "data_class",
    "parameters",
    "observations",
    "sensitivity_matrix",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "data_class": {
      "enum": [
        "synthetic",
        "observed",
        "modelled",
        "mixed"
      ]
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "sensitivity_matrix": {
      "$ref": "#/$defs/sensitivity_matrix"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "meaning",
        "unit"
      ],
      "properties": {
        "parameter_id": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "physical_quantity",
        "unit",
        "observation_operator_id",
        "independence_class",
        "calibration_status",
        "timebase_status",
        "limitations"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "physical_quantity": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "observation_operator_id": {
          "type": "string",
          "minLength": 1
        },
        "independence_class": {
          "enum": [
            "independent_measured",
            "derived",
            "inferred",
            "manual",
            "unknown"
          ]
        },
        "derived_from_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "calibration_status": {
          "enum": [
            "in_tolerance",
            "stale",
            "out_of_tolerance",
            "unknown",
            "not_applicable"
          ]
        },
        "timebase_status": {
          "enum": [
            "qualified",
            "incomplete",
            "unknown",
            "not_applicable"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sensitivity_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_ids",
        "row_observation_ids",
        "values",
        "rank_tolerance"
      ],
      "properties": {
        "parameter_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "row_observation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        },
        "rank_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.1
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "sensitivity_matrix": {
          "properties": {
            "values": {
              "minItems": 1
            }
          }
        }
      }
    }
  ]
}
