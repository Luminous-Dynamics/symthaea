{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:marine-propulsion-case:0.1.0",
  "title": "Luminous Marine Propulsion Benchmark Case",
  "description": "Evidence-bound vessel, service, route, environment, architecture and comparison manifest. A conforming document is a data-contract pass, not a physical or regulatory qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "record_status",
    "comparison",
    "service",
    "vessel",
    "route",
    "environment",
    "architecture",
    "economics",
    "evidence",
    "hard_gates"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "source_id",
        "method",
        "limitations"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "measured",
            "published",
            "derived",
            "synthetic",
            "assumed",
            "vendor_nominal"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "raw_data_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rights_status": {
          "type": "string",
          "enum": [
            "public",
            "permissioned",
            "restricted",
            "unknown",
            "not_applicable"
          ]
        }
      }
    },
    "uncertainty": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lower",
            "upper",
            "method",
            "basis"
          ],
          "properties": {
            "kind": {
              "const": "interval"
            },
            "lower": {
              "type": "number"
            },
            "upper": {
              "type": "number"
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "standard_uncertainty",
            "distribution",
            "method",
            "basis"
          ],
          "properties": {
            "kind": {
              "const": "standard"
            },
            "standard_uncertainty": {
              "type": "number",
              "minimum": 0
            },
            "distribution": {
              "type": "string",
              "enum": [
                "normal",
                "lognormal",
                "uniform",
                "triangular",
                "empirical",
                "other_declared"
              ]
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ],
      "description": "One of a declared interval, standard uncertainty or explicit unknown. Cross-field validation must check lower <= upper and that uncertainty units match the parent quantity unit; JSON Schema structural validation alone cannot establish those equalities."
    },
    "quantity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "provenance",
            "uncertainty"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            },
            "uncertainty": {
              "$ref": "#/$defs/uncertainty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "unknown_reason",
            "provenance"
          ],
          "properties": {
            "value": {
              "type": "null"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "unknown_reason": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          }
        }
      ],
      "description": "A known finite value with explicit unit/provenance/uncertainty, or an explicit unknown with a reason. Cross-field dimensional consistency is enforced by the semantic validator, not inferred from free-text unit labels."
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "hard_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "status",
        "scope_note",
        "evidence_ids"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unknown",
            "not_applicable",
            "blocked"
          ]
        },
        "scope_note": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "publisher",
        "publication_date",
        "evidence_class",
        "limitations"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "publication_date": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "evidence_class": {
          "type": "string",
          "enum": [
            "peer_reviewed_model",
            "peer_reviewed_experiment",
            "standard",
            "regulator",
            "class_society",
            "industry_trial",
            "vendor_case",
            "vendor_claim",
            "synthetic"
          ]
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rights_status": {
          "type": "string",
          "enum": [
            "public",
            "permissioned",
            "restricted",
            "unknown",
            "not_applicable"
          ]
        }
      }
    },
    "measurement_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "physical_quantity",
        "unit",
        "instrument_identity",
        "measurement_location",
        "sample_rate_hz",
        "calibration_record_id",
        "calibration_status",
        "timebase_id",
        "time_alignment_uncertainty",
        "sample_window_start",
        "sample_window_end",
        "missing_sample_count",
        "raw_trace_sha256",
        "uncertainty",
        "provenance",
        "limitations"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1
        },
        "physical_quantity": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "instrument_identity": {
          "$ref": "#/$defs/identity"
        },
        "measurement_location": {
          "type": "string",
          "minLength": 1
        },
        "sample_rate_hz": {
          "$ref": "#/$defs/quantity"
        },
        "calibration_record_id": {
          "type": "string",
          "minLength": 1
        },
        "calibration_status": {
          "type": "string",
          "enum": [
            "in_tolerance",
            "out_of_tolerance",
            "stale",
            "unknown",
            "not_applicable"
          ]
        },
        "timebase_id": {
          "type": "string",
          "minLength": 1
        },
        "time_alignment_uncertainty": {
          "$ref": "#/$defs/quantity"
        },
        "sample_window_start": {
          "type": "string",
          "format": "date-time"
        },
        "sample_window_end": {
          "type": "string",
          "format": "date-time"
        },
        "missing_sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "raw_trace_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "derived_from_channel_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "A sensor or measurement channel tied to calibration, timebase, sample window, raw trace digest and explicit uncertainty. Channel units must agree with uncertainty and sample-rate quantities; cross-field checks belong to the semantic validator."
    },
    "trial_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "protocol_id",
        "protocol_revision",
        "service_fingerprint",
        "disposition",
        "validation_stage",
        "time_sync_method",
        "channels",
        "raw_dataset_sha256",
        "limitations"
      ],
      "properties": {
        "trial_id": {
          "type": "string",
          "minLength": 1
        },
        "protocol_id": {
          "type": "string",
          "minLength": 1
        },
        "protocol_revision": {
          "type": "string",
          "minLength": 1
        },
        "service_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "baseline_case_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_case_id": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "enum": [
            "raw",
            "corrected",
            "reduced",
            "incomplete",
            "rejected",
            "unknown"
          ]
        },
        "validation_stage": {
          "type": "string",
          "enum": [
            "instrumented_bench",
            "model_test",
            "sea_trial",
            "in_service",
            "published_only",
            "synthetic_only",
            "unknown"
          ]
        },
        "time_sync_method": {
          "type": "string",
          "minLength": 1
        },
        "time_alignment_uncertainty": {
          "$ref": "#/$defs/quantity"
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/measurement_channel"
          }
        },
        "raw_dataset_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "processed_dataset_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "calibration_set_id": {
          "type": "string",
          "minLength": 1
        },
        "environmental_correction_method_id": {
          "type": "string",
          "minLength": 1
        },
        "environmental_correction_revision": {
          "type": "string",
          "minLength": 1
        },
        "excluded_intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "reason"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "end": {
                "type": "string",
                "format": "date-time"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Trial-level evidence must bind to the same service fingerprint as the compared case. Timestamp alignment, calibration, missing samples, exclusions and raw trace identity are explicit. This schema does not itself establish sensor authenticity or trial validity."
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,95}$"
    },
    "record_status": {
      "type": "string",
      "enum": [
        "synthetic",
        "published_reference_reconstruction",
        "design_study",
        "physical_trial"
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_group_id",
        "candidate_id",
        "role",
        "service_fingerprint"
      ],
      "properties": {
        "comparison_group_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "baseline",
            "candidate",
            "reference_only"
          ]
        },
        "service_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "paired_case_id": {
          "type": "string",
          "minLength": 1
        },
        "matching_deviations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cargo_class",
        "functional_unit",
        "service_contract_id",
        "annual_delivered_work",
        "arrival_policy"
      ],
      "properties": {
        "cargo_class": {
          "type": "string",
          "enum": [
            "container",
            "dry_bulk",
            "liquid_bulk",
            "general_cargo",
            "ro_ro",
            "other_declared"
          ]
        },
        "functional_unit": {
          "type": "string",
          "enum": [
            "tonne-nautical-mile",
            "TEU-nautical-mile",
            "vehicle-nautical-mile",
            "declared_other"
          ]
        },
        "declared_other_unit": {
          "type": "string"
        },
        "service_contract_id": {
          "type": "string",
          "minLength": 1
        },
        "annual_delivered_work": {
          "$ref": "#/$defs/quantity"
        },
        "annual_delivered_cargo_mass": {
          "$ref": "#/$defs/quantity"
        },
        "annual_delivered_teu": {
          "$ref": "#/$defs/quantity"
        },
        "required_arrival_window_hours": {
          "$ref": "#/$defs/quantity"
        },
        "arrival_policy": {
          "type": "string",
          "enum": [
            "fixed_schedule",
            "windowed",
            "best_effort",
            "declared_other"
          ]
        },
        "service_availability_target": {
          "$ref": "#/$defs/quantity"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "vessel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vessel_class",
        "configuration",
        "loading_condition",
        "principal_dimensions"
      ],
      "properties": {
        "vessel_class": {
          "type": "string",
          "enum": [
            "container_ship",
            "bulk_carrier",
            "general_cargo",
            "ro_ro",
            "coastal_cargo",
            "inland_cargo",
            "other_declared"
          ]
        },
        "configuration": {
          "$ref": "#/$defs/identity"
        },
        "loading_condition": {
          "type": "string",
          "minLength": 1
        },
        "principal_dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length_overall",
            "beam",
            "design_draft"
          ],
          "properties": {
            "length_overall": {
              "$ref": "#/$defs/quantity"
            },
            "length_between_perpendiculars": {
              "$ref": "#/$defs/quantity"
            },
            "beam": {
              "$ref": "#/$defs/quantity"
            },
            "design_draft": {
              "$ref": "#/$defs/quantity"
            },
            "air_draft": {
              "$ref": "#/$defs/quantity"
            },
            "displacement": {
              "$ref": "#/$defs/quantity"
            },
            "deadweight": {
              "$ref": "#/$defs/quantity"
            },
            "cargo_capacity": {
              "$ref": "#/$defs/quantity"
            },
            "cargo_volume": {
              "$ref": "#/$defs/quantity"
            }
          }
        },
        "stability_report_id": {
          "type": "string"
        },
        "structural_report_id": {
          "type": "string"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "route_revision",
        "segments"
      ],
      "properties": {
        "route_id": {
          "type": "string",
          "minLength": 1
        },
        "route_revision": {
          "type": "string",
          "minLength": 1
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment_id",
              "distance",
              "speed_policy"
            ],
            "properties": {
              "segment_id": {
                "type": "string",
                "minLength": 1
              },
              "distance": {
                "$ref": "#/$defs/quantity"
              },
              "speed_policy": {
                "type": "string",
                "minLength": 1
              },
              "target_speed": {
                "$ref": "#/$defs/quantity"
              },
              "arrival_time_window": {
                "$ref": "#/$defs/quantity"
              },
              "port_or_waypoint_id": {
                "type": "string"
              }
            }
          }
        },
        "route_data_provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_revision",
        "time_basis",
        "provenance"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_revision": {
          "type": "string",
          "minLength": 1
        },
        "time_basis": {
          "type": "string",
          "enum": [
            "observed",
            "hindcast",
            "forecast",
            "synthetic",
            "climatology",
            "mixed"
          ]
        },
        "wind_reference_height": {
          "$ref": "#/$defs/quantity"
        },
        "wind_series_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "wave_series_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "current_series_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "water_depth_series_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "out_of_domain_policy": {
          "type": "string",
          "enum": [
            "reject",
            "unknown",
            "qualified_fallback"
          ]
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hull_propulsor",
        "powertrain",
        "energy_sources",
        "wind_devices",
        "storage",
        "waste_heat_recovery"
      ],
      "properties": {
        "hull_propulsor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hull_configuration",
            "propulsor_family",
            "propulsor_configuration"
          ],
          "properties": {
            "hull_configuration": {
              "$ref": "#/$defs/identity"
            },
            "propulsor_family": {
              "type": "string",
              "enum": [
                "fixed_pitch_open_propeller",
                "controllable_pitch_open_propeller",
                "ducted_propeller",
                "contra_rotating",
                "azimuthing",
                "waterjet",
                "other_declared"
              ]
            },
            "propulsor_configuration": {
              "$ref": "#/$defs/identity"
            },
            "propeller_diameter": {
              "$ref": "#/$defs/quantity"
            },
            "shaft_rpm_map_id": {
              "type": "string"
            },
            "wake_or_inflow_map_id": {
              "type": "string"
            },
            "resistance_model_id": {
              "type": "string"
            },
            "propulsion_model_id": {
              "type": "string"
            }
          }
        },
        "powertrain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topology",
            "shaft_boundary_id",
            "electrical_boundary_id",
            "stages"
          ],
          "properties": {
            "topology": {
              "type": "string",
              "enum": [
                "direct_mechanical",
                "mechanical_with_pto_pti",
                "diesel_electric",
                "hybrid_electric",
                "fuel_cell_electric",
                "nuclear_electric_interface",
                "multi_source_hybrid"
              ]
            },
            "shaft_boundary_id": {
              "type": "string",
              "minLength": 1
            },
            "electrical_boundary_id": {
              "type": "string",
              "minLength": 1
            },
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stage_id",
                  "role",
                  "configuration",
                  "model_id"
                ],
                "properties": {
                  "stage_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "prime_mover",
                      "generator",
                      "motor",
                      "inverter",
                      "rectifier",
                      "dc_dc_converter",
                      "gearbox",
                      "shaft_generator",
                      "boost_motor",
                      "other_declared"
                    ]
