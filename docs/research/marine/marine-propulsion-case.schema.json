  "allOf": [
    {
      "if": {
        "properties": {
          "service": {
            "properties": {
              "functional_unit": {
                "const": "declared_other"
              }
            },
            "required": [
              "functional_unit"
            ]
          }
        },
        "required": [
          "service"
        ]
      },
      "then": {
        "properties": {
          "service": {
            "required": [
              "declared_other_unit"
            ]
          }
        }
      }
    }
  ]
