{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:pwc-waterjet-pump-loop-reference:0.1.0",
  "title": "PWC waterjet pump-loop arithmetic reference input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_status",
    "method",
    "test_boundary",
    "measurement_window",
    "fluid",
    "pump_loop",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "record_status": {
      "const": "synthetic"
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "revision",
        "effective_year",
        "test_type",
        "scope_note"
      ],
      "properties": {
        "document": {
          "const": "ITTC 7.5-02-05-03.2"
        },
        "revision": {
          "const": "02"
        },
        "effective_year": {
          "const": 2017
        },
        "test_type": {
          "const": "pump_loop"
        },
        "scope_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "test_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drive_power_boundary",
        "torque_source",
        "friction_correction_method",
        "electrical_conversion_losses_included"
      ],
      "properties": {
        "drive_power_boundary": {
          "const": "impeller_shaft"
        },
        "torque_source": {
          "const": "shaft_dynamometer"
        },
        "friction_correction_method": {
          "const": "separately_measured_and_subtracted"
        },
        "electrical_conversion_losses_included": {
          "const": false
        }
      }
    },
    "measurement_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_utc",
        "end_utc"
      ],
      "properties": {
        "start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "end_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "fluid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "density"
      ],
      "properties": {
        "density": {
          "$ref": "#/$defs/measurement",
          "properties": {
            "unit": {
              "const": "kg/m3"
            }
          }
        }
      }
    },
    "pump_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volume_flow_rate",
        "pump_total_head_rise",
        "shaft_speed",
        "measured_shaft_torque",
        "shaft_friction_torque"
      ],
      "properties": {
        "volume_flow_rate": {
          "$ref": "#/$defs/measurement",
          "properties": {
            "unit": {
              "const": "m3/s"
            }
          }
        },
        "pump_total_head_rise": {
          "$ref": "#/$defs/measurement",
          "properties": {
            "unit": {
              "const": "m"
            }
          }
        },
        "shaft_speed": {
          "$ref": "#/$defs/measurement",
          "properties": {
            "unit": {
              "const": "rpm"
            }
          }
        },
        "measured_shaft_torque": {
          "$ref": "#/$defs/measurement",
          "properties": {
            "unit": {
              "const": "N*m"
            }
          }
        },
        "shaft_friction_torque": {
          "$ref": "#/$defs/measurement",
          "properties": {
            "unit": {
              "const": "N*m"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "lower",
        "upper",
        "unit",
        "observed_at_utc",
        "available_at_utc",
        "calibration_status"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "observed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "available_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "calibration_status": {
          "const": "synthetic"
        }
      }
    }
  }
}
