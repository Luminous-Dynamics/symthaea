{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.org/schemas/monetary-composition-v1.schema.json",
  "title":"Monetary Composition Graph v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","composition_id","semantic_version","nodes","edges","topology","routing","shared_dependencies","generation","claim_ceiling"],
  "properties":{
    "schema_version":{"const":"monetary-composition-v1"},
    "composition_id":{"type":"string","minLength":1},
    "semantic_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "nodes":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["profile_id","profile_digest"],"properties":{"profile_id":{"type":"string","minLength":1},"profile_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
    "edges":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["edge_id","edge_digest","source","target"],"properties":{"edge_id":{"type":"string","minLength":1},"edge_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"source":{"type":"string","minLength":1},"target":{"type":"string","minLength":1}}}},
    "topology":{"type":"object","additionalProperties":false,"required":["topology_id","topology_digest"],"properties":{"topology_id":{"type":"string","minLength":1},"topology_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "routing":{"type":"object","additionalProperties":false,"required":["policy_id","policy_digest"],"properties":{"policy_id":{"type":"string","minLength":1},"policy_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "shared_dependencies":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["dependency_id","kind","digest"],"properties":{"dependency_id":{"type":"string","minLength":1},"kind":{"enum":["settlement_asset","liquidity_pool","backstop","governance","identity","oracle","other"]},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
    "generation":{"type":"object","additionalProperties":false,"required":["generation_id","composition_digest"],"properties":{"generation_id":{"type":"string","minLength":1},"composition_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "claim_ceiling":{"type":"string","minLength":1}
  }
}