{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.org/schemas/monetary-crn-supersession-v1.schema.json",
  "title":"Monetary CRN Supersession Ledger v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","namespace","entries","claim_ceiling"],
  "properties":{
    "schema_version":{"const":"monetary-crn-supersession-v1"},
    "namespace":{"const":"world:{shock}:{seed}:obligation:{index}"},
    "entries":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["experiment","superseded_digest","replacement_digest","status","reason"],"properties":{
      "experiment":{"type":"string","minLength":1},
      "superseded_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
      "replacement_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
      "status":{"enum":["superseded","confirmed"]},
      "reason":{"type":"string","minLength":1}
    }}},
    "claim_ceiling":{"type":"string","minLength":1}
  }
}