{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.org/schemas/monetary-operational-workflow-v1.schema.json",
  "title":"Monetary Interoperability Operational Workflow v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","states","terminal_states","experiment_factors","metrics","adversarial_boundaries","claim_ceiling","observation_binding","exogenous_random_namespace"],
  "properties":{
    "schema_version":{"const":"monetary-operational-workflow-v1"},
    "states":{"type":"array","items":{"type":"string"}},
    "terminal_states":{"type":"array","items":{"type":"string"}},
    "experiment_factors":{"type":"array"},
    "metrics":{"type":"array"},
    "adversarial_boundaries":{"type":"array"},
    "claim_ceiling":{"type":"string","minLength":1},
    "observation_binding":{"type":"object","additionalProperties":false,"required":["required_fields"],"properties":{"required_fields":{"type":"array","items":{"type":"string","enum":["scenario_id","policy_digest","settlement_receipt_digest","seed","trace_digest"]}}}},
    "exogenous_random_namespace":{"const":"world:{shock}:{seed}:obligation:{index}"}
  }
}
