{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.org/schemas/monetary-strategic-response-v1.schema.json",
  "title":"Monetary Strategic Participant Response v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","experiment_id","factorial_size","batch_size","factors","participant_policies","fixed_dimensions","claim_ceiling"],
  "properties":{
    "schema_version":{"const":"monetary-strategic-response-v1"},
    "experiment_id":{"type":"string","minLength":1},
    "factorial_size":{"const":1080,"type":"integer"},
    "batch_size":{"const":3,"type":"integer"},
    "factors":{"type":"object","additionalProperties":false,"required":["monetary_pair","adapter","shock","seed","participant_policy"],"properties":{
      "monetary_pair":{"const":["bank_mutual","bank_stablecoin","tokenized_deposit_stablecoin"]},
      "adapter":{"const":["redeem_reissue","escrowed_atomic_swap","multilateral_net_settlement","absent"]},
      "shock":{"const":["normal","liquidity_shock","network_partition","issuer_default","bridge_failure","stale_quote"]},
      "seed":{"const":[11,23,47,89,131]},
      "participant_policy":{"const":["fixed_submission","liquidity_aware_stagger","critical_payment_acceleration"]}
    }},
    "participant_policies":{"type":"object","additionalProperties":false,"required":["fixed_submission","liquidity_aware_stagger","critical_payment_acceleration"],"properties":{
      "fixed_submission":{"$ref":"#/$defs/policy"},
      "liquidity_aware_stagger":{"$ref":"#/$defs/policy"},
      "critical_payment_acceleration":{"$ref":"#/$defs/policy"}
    }},
    "fixed_dimensions":{"type":"object","additionalProperties":false,"required":["topology_digest","resource_regime","resource_digest","allocation_policy_digest","obligations","common_random_number_identity","exogenous_random_namespace","behavioral_boundary"],"properties":{
      "topology_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
      "resource_regime":{"const":"bounded_shared_settlement_liquidity"},
      "resource_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
      "allocation_policy_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
      "obligations":{"type":"array","const":[{"obligation_index":0,"amount":15,"criticality":2},{"obligation_index":1,"amount":5,"criticality":1},{"obligation_index":2,"amount":10,"criticality":3}]},
      "common_random_number_identity":{"type":"string","minLength":1},
      "exogenous_random_namespace":{"const":"world:{shock}:{seed}:obligation:{index}"},
      "behavioral_boundary":{"const":"participant policy may change submission time only; monetary, adapter, topology, resource and allocation contracts remain fixed"}
    }},
    "claim_ceiling":{"type":"string","minLength":1}
  },
  "$defs":{"policy":{"type":"object","additionalProperties":false,"required":["policy_id","digest","rule"],"properties":{
    "policy_id":{"type":"string","minLength":1},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"rule":{"type":"string","minLength":1}
  }}}
}
