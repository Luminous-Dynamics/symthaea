{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.org/schemas/monetary-topology-factorial-v1.schema.json",
  "title":"Monetary Interoperability Topology Factorial v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","experiment_id","factorial_size","factors","topologies","fixed_dimensions","claim_ceiling"],
  "properties":{
    "schema_version":{"const":"monetary-topology-factorial-v1"},
    "experiment_id":{"type":"string","minLength":1},
    "factorial_size":{"const":1080,"type":"integer"},
    "factors":{"type":"object","additionalProperties":false,"required":["topology","monetary_pair","adapter","shock","seed"],"properties":{
      "topology":{"const":["full_mesh","routing_only_hub","redundant_two_hub"]},"monetary_pair":{"const":["bank_mutual","bank_stablecoin","tokenized_deposit_stablecoin"]},"adapter":{"const":["redeem_reissue","escrowed_atomic_swap","multilateral_net_settlement","absent"]},"shock":{"const":["normal","liquidity_shock","network_partition","issuer_default","bridge_failure","stale_quote"]},"seed":{"const":[11,23,47,89,131]}
    }},
    "topologies":{"type":"object","additionalProperties":false,"required":["full_mesh","routing_only_hub","redundant_two_hub"],"properties":{"full_mesh":{"$ref":"#/$defs/topology"},"routing_only_hub":{"$ref":"#/$defs/topology"},"redundant_two_hub":{"$ref":"#/$defs/topology"}}},
    "fixed_dimensions":{"type":"object","additionalProperties":false,"required":["routing_policy_digest","profile_digests","edge_digests","common_random_number_identity","exogenous_random_namespace","no_financial_hub_inference","technical_settlement_semantics","composition_identity_rule"],"properties":{
      "routing_policy_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
      "profile_digests":{"type":"object","additionalProperties":false,"required":["conventional-bank-money-v1","sovereign-money-v1","mutual-credit-v1","tokenized-deposit-v1","reserve-backed-stablecoin-v1"],"properties":{"conventional-bank-money-v1":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sovereign-money-v1":{"type":"string","pattern":"^[a-f0-9]{64}$"},"mutual-credit-v1":{"type":"string","pattern":"^[a-f0-9]{64}$"},"tokenized-deposit-v1":{"type":"string","pattern":"^[a-f0-9]{64}$"},"reserve-backed-stablecoin-v1":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
      "edge_digests":{"type":"object","additionalProperties":false,"required":["bank_mutual","bank_stablecoin","tokenized_deposit_stablecoin"],"properties":{"bank_mutual":{"type":"string","pattern":"^[a-f0-9]{64}$"},"bank_stablecoin":{"type":"string","pattern":"^[a-f0-9]{64}$"},"tokenized_deposit_stablecoin":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
      "common_random_number_identity":{"type":"string","minLength":1},
      "exogenous_random_namespace":{"const":"world:{shock}:{seed}:obligation:{index}"},
      "no_financial_hub_inference":{"const":true},
      "technical_settlement_semantics":{"const":"topology must not mutate adapter-declared technical settlement semantics except explicit routing-overhead effects are operational, not settlement finality"},
      "composition_identity_rule":{"const":"topology change requires new topology and composition generation identities"}
    }},
    "claim_ceiling":{"type":"string","minLength":1}
  },
  "$defs":{"topology":{"type":"object","additionalProperties":false,"required":["digest","generation","route_overhead","centrality","partition_recovery","financial_powers"],"properties":{"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"generation":{"type":"string","minLength":1},"route_overhead":{"type":"integer","minimum":0},"centrality":{"type":"number","minimum":0,"maximum":1},"partition_recovery":{"type":"integer","minimum":0},"financial_powers":{"const":[]}}}}
}
