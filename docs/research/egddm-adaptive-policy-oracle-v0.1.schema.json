{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-adaptive-policy-oracle-v0.1.schema.json",
  "title": "EGDDM D6.17.2.1 adaptive policy evaluator oracle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actual_hypothesis_id",
    "decision_cutoff",
    "budget_micros",
    "actions",
    "hypothesis_bounds",
    "options",
    "factors",
    "hypothesis_safety",
    "calibrations",
    "factorization_certificates",
    "worlds",
    "cost_options"
  ],
  "properties": {
    "actual_hypothesis_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "budget_micros": {
      "type": "integer",
      "minimum": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-oracle-v0.1.schema.json#/properties/actions/items"
      }
    },
    "hypothesis_bounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-oracle-v0.1.schema.json#/properties/hypothesis_bounds/items"
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-oracle-v0.1.schema.json#/properties/options/items"
      }
    },
    "factors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-oracle-v0.1.schema.json#/properties/factors/items"
      }
    },
    "hypothesis_safety": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-oracle-v0.1.schema.json#/properties/hypothesis_safety/items"
      }
    },
    "calibrations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-oracle-v0.1.schema.json#/properties/calibrations/items"
      }
    },
    "factorization_certificates": {
      "type": "array",
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-oracle-v0.1.schema.json#/properties/factorization_certificates/items"
      }
    },
    "worlds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "world_id",
          "safe_actions",
          "observations"
        ],
        "properties": {
          "world_id": {
            "type": "string",
            "minLength": 1
          },
          "safe_actions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observations": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "cost_options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "available_at",
          "cost_samples_micros"
        ],
        "properties": {
          "option_id": {
            "type": "string",
            "minLength": 1
          },
          "available_at": {
            "type": "string",
            "format": "date-time"
          },
          "cost_samples_micros": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cold"
            ],
            "properties": {
              "cold": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
