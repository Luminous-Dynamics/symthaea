  "computation_contract": {
    "outcome_probability": "P(o) = sum_s prior(s) * P(o | s)",
    "posterior": "P(s | o) = prior(s) * P(o | s) / P(o), for P(o) > 0",
    "state_value": "V(posterior) = max_d sum_s posterior(s) * utility(d,s)",
    "gross_evsi": "sum_o P(o) * V(posterior_after_o) - V(prior)",
    "net_decision_value": "gross_evsi - direct_cost_units - declared_opportunity_cost_units",
    "purchase_rule": "action must have positive net decision value and pass every predeclared risk/legality/budget gate",
    "unknown_policy": "If outcome probabilities, likelihoods, costs, or utilities are not calibrated/declared for the episode, do not invent them; emit bounded/ranked qualitative forecast or UNRESOLVED."
  }
