{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/sawem/v1/sawem-bess-benchmark-corpus-v1.schema.json",
  "title": "SAWEM BESS Benchmark Case Corpus v1",
  "description": "Finite case register for the SAWEM BESS underwriting benchmark. Cases are not performance results; unit-test mappings are limited to the named synthetic Rust reference tests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_version",
    "corpus_state",
    "benchmark_id",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "corpus_version": {
      "const": "1.0"
    },
    "corpus_state": {
      "enum": [
        "draft_case_register",
        "oracle_frozen_for_review",
        "independently_adjudicated"
      ]
    },
    "benchmark_id": {
      "const": "SAWEM-BESS-MATCHED-001"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 50
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "track",
        "title",
        "scenario",
        "owner",
        "expected_disposition",
        "implementation_state",
        "oracle_state",
        "test_names",
        "required_evidence",
        "stress_tags"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "track": {
          "enum": [
            "physical_feasibility",
            "market_rule_conformance",
            "dispatch_and_forecast",
            "settlement_and_liquidity",
            "evidence_and_lifecycle"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "scenario": {
          "type": "string",
          "minLength": 20
        },
        "owner": {
          "enum": [
            "Symtropy",
            "Symthaea",
            "Sol-Atlas",
            "Mycelix",
            "cross-system"
          ]
        },
        "expected_disposition": {
          "enum": [
            "feasible",
            "infeasible",
            "indeterminate",
            "mixed_by_subcase",
            "not_run"
          ]
        },
        "implementation_state": {
          "enum": [
            "kernel_unit_tested",
            "declared_not_implemented",
            "synthetic_fixture_only"
          ]
        },
        "oracle_state": {
          "enum": [
            "draft_expected_disposition",
            "independently_adjudicated"
          ]
        },
        "test_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "stress_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "implementation_state": {
                "const": "kernel_unit_tested"
              }
            }
          },
          "then": {
            "properties": {
              "test_names": {
                "minItems": 1
              },
              "expected_disposition": {
                "not": {
                  "const": "not_run"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "implementation_state": {
                "const": "declared_not_implemented"
              }
            }
          },
          "then": {
            "properties": {
              "expected_disposition": {
                "const": "not_run"
              },
              "test_names": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
