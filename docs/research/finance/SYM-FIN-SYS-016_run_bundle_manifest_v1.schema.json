{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civos:socioeconomic-interoperability:run-bundle-manifest:v1",
  "title": "CivOS Socioeconomic Research Run Bundle Manifest v1",
  "description": "Inventory of exact-byte research payloads referenced by a synthetic run receipt. The manifest itself is bound by the receipt and must not inventory itself or the receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "claim_ceiling",
    "hash_policy",
    "run_id",
    "receipt_path",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "civos.socioeconomic_interoperability.run_bundle_manifest.v1"
    },
    "status": {
      "const": "research"
    },
    "claim_ceiling": {
      "const": "synthetic_deterministic_only"
    },
    "hash_policy": {
      "const": "sha256_exact_bytes_v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "receipt_path": {
      "type": "string",
      "minLength": 1,
      "description": "Relative POSIX path to the receipt file; it is excluded from artifacts to prevent a digest cycle."
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "path",
        "digest",
        "byte_length",
        "receipt_pointers"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the exact payload bytes. The verifier rejects absolute paths, parent traversal and symlinks."
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "receipt_pointers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/"
          },
          "description": "JSON Pointers of receipt digest fields bound to these exact artifact bytes. Every receipt digest field except /run/artifact_manifest_digest must occur exactly once across all artifacts."
        }
      }
    }
  }
}
