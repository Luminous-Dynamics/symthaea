{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civos:socioeconomic-interoperability:validator-execution-record:v1",
  "title": "CivOS Run Bundle Validator Execution Record v1",
  "description": "Metadata emitted by a CI job after its run-bundle validator tests succeed. This record is suitable as a custom in-toto attestation predicate, but is non-authoritative without verification of the external signature and builder identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_ceiling",
    "result",
    "scope",
    "repository",
    "source_revision",
    "workflow",
    "job",
    "event",
    "run_id",
    "run_attempt",
    "runner_os",
    "python_version",
    "test_commands",
    "authored_test_function_count",
    "artifacts",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "civos.socioeconomic_interoperability.validator_execution_record.v1"
    },
    "claim_ceiling": {
      "const": "synthetic_deterministic_only"
    },
    "result": {
      "const": "passed"
    },
    "scope": {
      "const": "run_bundle_validator_and_execution_record_unit_tests"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "job": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "enum": [
        "pull_request",
        "push",
        "workflow_dispatch",
        "merge_group",
        "schedule"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "run_attempt": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "runner_os": {
      "enum": ["Linux", "Windows", "macOS"]
    },
    "python_version": {
      "type": "string",
      "pattern": "^Python [0-9]+\\.[0-9]+\\.[0-9]+"
    },
    "test_commands": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authored_test_function_count": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proves_simulation_truth",
        "can_authorize_real_actions",
        "can_reserve_real_resources",
        "can_settle_real_assets",
        "production_ledger_import_allowed"
      ],
      "properties": {
        "proves_simulation_truth": {"const": false},
        "can_authorize_real_actions": {"const": false},
        "can_reserve_real_resources": {"const": false},
        "can_settle_real_assets": {"const": false},
        "production_ledger_import_allowed": {"const": false}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "byte_length", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": ["test_input", "test_log"]
        }
      }
    }
  }
}
