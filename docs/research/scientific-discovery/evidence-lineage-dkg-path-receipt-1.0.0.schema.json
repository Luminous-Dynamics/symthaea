{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://symthaea.dev/schema/evidence-lineage-dkg-path-receipt-1.0.0.schema.json",
  "title": "Evidence-Lineage DKG Path Receipt",
  "description": "Content-addressed receipt proving an ordered provenance path in one exact manifest-bound canonical DKG projection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version","projection_schema_version","canonicalization_id","digest_algorithm","manifest_digest","projection_digest","nodes","edges","receipt_digest"],
  "properties": {
    "receipt_version": {"const":"1.0.0"},
    "projection_schema_version": {"const":"1.2.0"},
    "canonicalization_id": {"const":"symthaea:dkg-node-edge-order:v1"},
    "digest_algorithm": {"const":"sha256"},
    "manifest_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "projection_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "nodes": {
      "type":"array","minItems":1,
      "items":{"type":"object","additionalProperties":false,"required":["node_id","node_type","record_digest"],
        "properties":{
          "node_id":{"type":"string","minLength":1},
          "node_type":{"type":"string","enum":["candidate_commitment","external_observation","independent_assessment","replication","criterion_evidence","evidence_chain_audit"]},
          "record_digest":{"type":"string","minLength":1}
        }}
    },
    "edges": {
      "type":"array",
      "items":{"type":"object","additionalProperties":false,"required":["source_node_id","edge_type","target_node_id"],
        "properties":{
          "source_node_id":{"type":"string","minLength":1},
          "edge_type":{"type":"string","enum":["commits_to","observed_from","assesses","replicates","eligible_for","audited_by","supersedes"]},
          "target_node_id":{"type":"string","minLength":1}
        }}
    },
    "receipt_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "x-authority":"canonical-provenance-path-receipt-only",
  "x-non-equivalences":[
    "path continuity != scientific truth",
    "path completeness != criterion completion",
    "audit presence != authenticated authority",
    "receipt digest != digital signature",
    "path membership != consensus"
  ],
  "x-source-of-truth":["immutable evidence records","append-only evidence events","the manifest-bound canonical DKG projection"],
  "x-path-semantics":{
    "node_order":"human-readable ancestry order from root toward terminal evidence",
    "ordinary_edges":"canonical DKG edges are verified in descendant-to-parent direction between adjacent nodes",
    "audit_edge":"AuditedBy may extend the terminal evidence node to its audit node in forward graph direction"
  }
}