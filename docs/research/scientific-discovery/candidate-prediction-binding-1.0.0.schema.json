{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate Prediction Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "source_candidate_id",
    "test_specification_id",
    "measurement_specification_id",
    "prediction_payload"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "source_candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "test_specification_id": {
      "type": "string",
      "minLength": 1
    },
    "measurement_specification_id": {
      "type": "string",
      "minLength": 1
    },
    "prediction_payload": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  },
  "x-authority": "prospective_commitment_only",
  "x-non_equivalences": [
    "candidate specification is not test execution",
    "prediction commitment is not an observation",
    "prediction commitment is not replication",
    "prediction commitment is not official criterion evidence",
    "model-implied likelihood is not a calibrated experimental probability"
  ]
}
