{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://symthaea.org/schemas/scientific-discovery/evidence-lineage-dkg-projection-1.0.0.schema.json",
  "title":"Evidence Lineage DKG Projection 1.0.0",
  "description":"Canonical projection contract for indexing immutable scientific evidence records in a distributed knowledge graph. The graph represents provenance and relationships; it does not establish scientific truth.",
  "type":"object",
  "required":["projection_version","nodes","edges"],
  "properties":{
    "projection_version":{"const":"1.0.0"},
    "nodes":{"type":"array","items":{"type":"object","required":["node_id","node_type","record_digest"],"properties":{
      "node_id":{"type":"string","minLength":1},
      "node_type":{"enum":["candidate_commitment","external_observation","independent_assessment","replication","criterion_evidence","evidence_chain_audit"]},
      "record_digest":{"type":"string","minLength":1},
      "supersedes_node_id":{"type":["string","null"]}
    },"additionalProperties":false}},
    "edges":{"type":"array","items":{"type":"object","required":["source_node_id","edge_type","target_node_id"],"properties":{
      "source_node_id":{"type":"string","minLength":1},
      "edge_type":{"enum":["commits_to","observed_from","assesses","replicates","eligible_for","audited_by","supersedes"]},
      "target_node_id":{"type":"string","minLength":1}
    },"additionalProperties":false}}
  },
  "additionalProperties":false,
  "x-authority":"provenance_projection_only",
  "x-non-equivalences":["graph_presence != scientific_truth","graph_connectivity != criterion_completion","node_agreement != consensus","audit_complete != scientific_validity"],
  "x-source-of-truth":"immutable evidence records and append-only events",
  "x-federation":"Independent indexers should derive equivalent edges from the same canonical records."
}