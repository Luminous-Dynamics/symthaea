{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://symthaea.dev/schema/evidence-lineage-dkg-merkle-membership-proof-1.0.0.schema.json",
  "title":"Evidence-Lineage DKG Merkle Membership Proof",
  "description":"Compact proof that one exact federation source record belongs to the canonical manifest source set.",
  "type":"object","additionalProperties":false,
  "required":["proof_version","digest_algorithm","manifest_digest","projection_digest","node_id","node_type","record_digest","leaf_index","leaf_count","merkle_root","siblings","proof_digest"],
  "properties":{
    "proof_version":{"const":"1.0.0"},
    "digest_algorithm":{"const":"sha256"},
    "manifest_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "projection_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "node_id":{"type":"string","minLength":1},
    "node_type":{"type":"string","enum":["candidate_commitment","external_observation","independent_assessment","replication","criterion_evidence","evidence_chain_audit"]},
    "record_digest":{"type":"string","minLength":1},
    "leaf_index":{"type":"integer","minimum":0},
    "leaf_count":{"type":"integer","minimum":1},
    "merkle_root":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "siblings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["side","digest"],"properties":{"side":{"enum":["left","right"]},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
    "proof_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "x-authority":"federation-membership-proof-only",
  "x-non-equivalences":["membership != scientific truth","membership != criterion completion","membership != consensus","proof digest != digital signature"],
  "x-source-of-truth":["immutable evidence records","canonical federation source_records"],
  "x-merkle-convention":{"odd_level":"duplicate the final node","leaf_domain":"symthaea:evidence-lineage-federation-merkle-leaf:v1","parent_domain":"symthaea:evidence-lineage-federation-merkle-parent:v1"}
}