{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://symthaea.org/schemas/scientific-discovery/evidence-chain-audit-1.0.0.schema.json",
  "title": "Symthaea Evidence Chain Audit 1.0.0",
  "description": "Deterministic structural audit projection. Complete means structurally consistent only.",
  "type": "object",
  "required": [
    "status",
    "challenge_id",
    "criterion_id",
    "criterion_generation",
    "observation_id",
    "assessment_id",
    "replication_id",
    "evidence_id",
    "diagnostics"
  ],
  "properties": {
    "status": {
      "enum": [
        "complete",
        "invalid"
      ]
    },
    "challenge_id": {
      "type": "string",
      "minLength": 1
    },
    "criterion_id": {
      "type": "string",
      "minLength": 1
    },
    "criterion_generation": {
      "type": "string",
      "minLength": 1
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "replication_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-authority": "structural_integrity_audit_only",
  "x-non-equivalences": [
    "complete != scientific_truth",
    "complete != criterion_completed",
    "complete != authenticated_authority",
    "diagnostic != scientific_judgment"
  ]
}
