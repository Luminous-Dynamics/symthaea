  "episode_semantics": {
    "authoritative_state_owner": "independent_evaluator",
    "decision_tick_order": [
      "apply_exogenous_event_batch",
      "generate_timestamped_observations",
      "invoke_policy_with_only_available_observations",
      "validate_action_authority_and_remaining_budgets",
      "execute_or_record_rejected_failed_or_unknown_outcome",
      "emit_receipt_and_post_state_digest"
    ],
    "causal_constraints": [
      "policy_cannot_read_future_events_or_future_demand",
      "observations_must_include_source_time_age_and_missingness",
      "accepted_edits_persist_until_explicitly_changed_or_failed",
      "episode_budgets_are_cumulative_unless_explicitly_replenished",
      "unknown_execution_outcome_blocks_further_mutation_until_reconciliation"
    ],
    "simultaneous_event_rule": "apply_nonconflicting_events_as_one_batch; reject conflicting same-resource events unless an explicit composition rule is declared",
    "duplicate_action_rule": "stable action IDs are idempotent; duplicate accepted mutations are never applied or charged twice"
  },
