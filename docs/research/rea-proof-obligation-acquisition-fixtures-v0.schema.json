{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/rea-proof-obligation-acquisition-fixtures-v0.schema.json",
  "title": "REA claim-obligation-directed evidence acquisition fixture v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "status",
    "source_policy",
    "use",
    "not_human_adjudicated",
    "cases",
    "oracle_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "dataset_id": {
      "const": "rea-proof-obligation-acquisition"
    },
    "status": {
      "const": "design_fixture_only"
    },
    "source_policy": {
      "const": "original_synthetic_text_only"
    },
    "use": {
      "const": "development_and_protocol_conformance"
    },
    "not_human_adjudicated": {
      "const": true
    },
    "cases": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "oracle_policy": {
      "const": "grader_only_not_for_agent_input"
    }
  },
  "$defs": {
    "obligationStatus": {
      "enum": [
        "satisfied",
        "unsatisfied",
        "conflicted",
        "unknown",
        "incomplete",
        "contradicted"
      ]
    },
    "evidenceClass": {
      "type": "string",
      "minLength": 2
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "kind",
        "required",
        "status",
        "admissible_evidence_classes",
        "notes"
      ],
      "properties": {
        "obligation_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "kind": {
          "type": "string",
          "minLength": 2
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/obligationStatus"
        },
        "admissible_evidence_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceClass"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "obligation_id",
        "resulting_status",
        "evidence_class",
        "source_family_id"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "obligation_id": {
          "type": "string",
          "minLength": 2
        },
        "resulting_status": {
          "$ref": "#/$defs/obligationStatus"
        },
        "evidence_class": {
          "$ref": "#/$defs/evidenceClass"
        },
        "source_family_id": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "authorization",
        "reversible",
        "destructive",
        "target_impact",
        "cost_units",
        "description",
        "outcomes",
        "effects"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "minLength": 2
        },
        "authorization": {
          "enum": [
            "authorized",
            "denied",
            "unknown"
          ]
        },
        "reversible": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        },
        "target_impact": {
          "enum": [
            "read_only",
            "temporary_configuration",
            "service_restart",
            "data_mutation",
            "physical_actuation",
            "isolated_test"
          ]
        },
        "cost_units": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    },
    "expectedPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_candidate_id",
        "readiness_after",
        "blocking_obligations",
        "rationale"
      ],
      "properties": {
        "preferred_candidate_id": {
          "type": "string",
          "minLength": 2
        },
        "readiness_after": {
          "type": "string",
          "minLength": 2
        },
        "blocking_obligations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "domain",
        "fault_family",
        "source_family_id",
        "world_state_oracle",
        "claim_text",
        "obligations",
        "candidates",
        "expected_policy"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^REA-POA-[0-9]{3}$"
        },
        "domain": {
          "type": "string",
          "minLength": 2
        },
        "fault_family": {
          "type": "string",
          "minLength": 2
        },
        "source_family_id": {
          "type": "string",
          "minLength": 2
        },
        "world_state_oracle": {
          "enum": [
            "vulnerable",
            "digest_matches",
            "population_complete",
            "issuer_withheld_statements",
            "archive_has_uninspected_members",
            "current_version_not_affected",
            "cache_cause_unresolved",
            "configuration_dependent",
            "exact_decimal_value_0_10",
            "torque_not_energy",
            "not_observable",
            "faulty",
            "migration_incompatible",
            "one_member_processing_failed",
            "undisclosed_omission_possible",
            "one_acquisition_two_tools",
            "behavior_reproduced_on_exact_build"
          ]
        },
        "claim_text": {
          "type": "string",
          "minLength": 20
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/obligation"
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "expected_policy": {
          "$ref": "#/$defs/expectedPolicy"
        }
      }
    }
  }
}
