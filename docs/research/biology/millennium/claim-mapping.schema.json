{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://symthaea.luminousdynamics.io/schemas/millennium/claim-mapping-1.0.0.json",
  "title": "Symthaea Millennium Biology Claim Mapping Profile",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "mapping_generation",
    "status",
    "source_contract",
    "authority_ceiling",
    "evidence_ladder",
    "transition_rules",
    "non_promotion_fixtures",
    "criteria",
    "integrity_requirements"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.research.millennium_biology.claim_mapping"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "mapping_generation": {
      "type": "string",
      "pattern": "^BIO-MILLENNIUM-001B-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "const": "source_bound_claim_mapping_profile"
    },
    "source_contract": {
      "type": "object",
      "required": [
        "publisher",
        "source_url",
        "announcement_url",
        "publication_date",
        "retrieved_at",
        "official_criteria_generation",
        "source_authority"
      ]
    },
    "authority_ceiling": {
      "type": "object",
      "required": [
        "local_mapping_is_not_official_criterion",
        "local_mapping_does_not_declare_solved",
        "local_mapping_does_not_grant_experimental_authority",
        "local_surrogate_is_not_official_evidence",
        "model_agreement_is_not_independent_corroboration",
        "formal_model_proof_is_not_physical_biological_evidence"
      ],
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "evidence_ladder": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "transition_rules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "non_promotion_fixtures": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "minimum_official_evidence",
          "completion_requires",
          "local_computational_role",
          "explicit_nonpromotion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MPB-2026-09-23-(0[1-9]|1[0-2])$"
          },
          "slug": {
            "type": "string"
          },
          "minimum_official_evidence": {
            "const": "ExternalExperimentalObservation"
          },
          "completion_requires": {
            "const": "OfficialChallengeCriterionEvidence"
          },
          "local_computational_role": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "explicit_nonpromotion": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "integrity_requirements": {
      "type": "object",
      "required": [
        "exact_criterion_generation_binding",
        "exact_candidate_identity",
        "exact_model_lineage_when_available",
        "knowledge_exposure_cutoff",
        "provenance_complete_result_identity",
        "terminal_disposition_census",
        "negative_and_null_results_retained",
        "independent_scorer_when_claimed",
        "external_execution_requires_human_or_institutional_authority"
      ],
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "additionalProperties": false
}
