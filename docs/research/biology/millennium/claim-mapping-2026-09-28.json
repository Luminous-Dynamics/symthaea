  "evidence_ladder": [
    "HypothesisProposal",
    "InSilicoPrediction",
    "SimulationResult",
    "RetrospectiveBenchmarkResult",
    "ProspectiveCommittedPrediction",
    "ExternalExperimentalObservation",
    "IndependentReplication",
    "OfficialChallengeCriterionEvidence"
  ],
  "transition_rules": {
    "HypothesisProposal -> InSilicoPrediction": "requires a declared executable/model evaluation with immutable input and model lineage.",
    "InSilicoPrediction -> RetrospectiveBenchmarkResult": "requires frozen target/outcome data and post-hoc evaluation; never grants prospective credit.",
    "InSilicoPrediction -> ProspectiveCommittedPrediction": "requires commitment before answer/outcome exposure and immutable prediction identity.",
    "ProspectiveCommittedPrediction -> ExternalExperimentalObservation": "requires independently instrumented external observation; prediction alone cannot create an observation.",
    "ExternalExperimentalObservation -> IndependentReplication": "requires a separately attributable replication satisfying the applicable replication contract.",
    "IndependentReplication -> OfficialChallengeCriterionEvidence": "only when the official source's complete criterion predicate and required evidence are satisfied; local confidence cannot substitute."
  },
  "non_promotion_fixtures": [
    "A high-confidence model prediction cannot satisfy an experimental criterion.",
    "A simulation result cannot satisfy a living-organism criterion unless the official source explicitly permits simulation for that criterion.",
    "A retrospective rediscovery cannot receive prospective credit after candidate or scoring mutation.",
    "Multiple models sharing training/data/structure ancestry are not independent replications.",
    "A publication citation alone cannot be promoted to an experimental observation.",
    "A formal proof of a model consequence cannot be promoted to proof that the biological model matches reality.",
    "A partial-success artifact cannot be promoted to complete criterion evidence.",
    "Missing provenance or unresolved exposure prevents prospective qualification."
  ],
