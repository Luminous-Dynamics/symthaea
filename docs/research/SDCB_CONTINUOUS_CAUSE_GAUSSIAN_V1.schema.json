{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SDCB_CONTINUOUS_CAUSE_GAUSSIAN_V1.schema.json",
  "title": "SDCB continuous common-cause Gaussian design oracle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "latent_ids",
    "prior_variances",
    "science_index",
    "budget_units",
    "actions"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "fixture_id": { "type": "string", "minLength": 1 },
    "latent_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "prior_variances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "number", "exclusiveMinimum": 1e-12 }
    },
    "science_index": { "type": "integer", "minimum": 0 },
    "budget_units": { "type": "integer", "minimum": 0 },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cost_units", "loadings", "noise_variance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "cost_units": { "type": "integer", "minimum": 1 },
        "loadings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "number" }
        },
        "noise_variance": { "type": "number", "exclusiveMinimum": 1e-12 }
      }
    }
  }
}
