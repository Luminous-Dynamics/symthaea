{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SDCB_ROBUST_DECISION_EPISODE_V1.schema.json",
  "title": "SDCB robust decision episode v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "prior",
    "action_ids",
    "scenarios",
    "experiments",
    "cost_rate_per_unit"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "prior": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "action_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "utility_by_hypothesis"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "utility_by_hypothesis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "experiments": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experiment_id",
          "cost_units",
          "likelihoods_by_scenario"
        ],
        "properties": {
          "experiment_id": {
            "type": "string",
            "minLength": 1
          },
          "cost_units": {
            "type": "integer",
            "minimum": 1
          },
          "likelihoods_by_scenario": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "cost_rate_per_unit": {
      "type": "number",
      "minimum": 0
    }
  },
  "$comment": "Cross-field validation must enforce prior sum 1; scenario utility row count=prior length and row width=action count; scenario IDs unique; every experiment has one likelihood matrix per scenario; each matrix has one row per hypothesis, consistent outcome width, and row sums 1; experiment IDs unique."
}
