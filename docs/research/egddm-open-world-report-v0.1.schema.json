{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-open-world-report-v0.1.schema.json",
  "title": "EGDDM D6.18 open-world contamination report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "adjudication_status",
    "unknown_hypothesis_id",
    "contamination_reserve_bps",
    "policy_version",
    "actual_hypothesis_is_unknown",
    "closed_world_comparison_available",
    "unknown_world_safe_action_ids",
    "closed_world_report",
    "open_world_report",
    "summary",
    "traces",
    "claim_ceiling"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "adjudication_status": {
      "const": "synthetic_known_answer_open_world_contamination_evaluation_only"
    },
    "unknown_hypothesis_id": {
      "type": "string",
      "minLength": 1
    },
    "contamination_reserve_bps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "actual_hypothesis_is_unknown": {
      "type": "boolean"
    },
    "closed_world_comparison_available": {
      "type": "boolean"
    },
    "unknown_world_safe_action_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "closed_world_report": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-report-v0.1.schema.json"
        }
      ]
    },
    "open_world_report": {
      "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-report-v0.1.schema.json"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closed_world_unadjudicable_actual_hypothesis",
        "closed_world_false_assurance_trace_count",
        "closed_world_justified_trace_count",
        "open_world_justified_trace_count",
        "open_world_rejected_trace_count"
      ],
      "properties": {
        "closed_world_unadjudicable_actual_hypothesis": {
          "type": "boolean"
        },
        "closed_world_false_assurance_trace_count": {
          "type": "integer",
          "minimum": 0
        },
        "closed_world_justified_trace_count": {
          "type": "integer",
          "minimum": 0
        },
        "open_world_justified_trace_count": {
          "type": "integer",
          "minimum": 0
        },
        "open_world_rejected_trace_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trace_id",
          "closed_world_risk_bps",
          "open_world_risk_bps",
          "open_world_risk_uplift_bps",
          "closed_world_action_justified",
          "open_world_action_justified",
          "closed_world_false_assurance",
          "actual_unsafe_action",
          "open_world_evidence_status",
          "open_world_evidence_support_lower_bps",
          "decision_kind"
        ],
        "properties": {
          "trace_id": {
            "type": "string",
            "minLength": 1
          },
          "closed_world_risk_bps": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 10000
          },
          "open_world_risk_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "open_world_risk_uplift_bps": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 10000
          },
          "closed_world_action_justified": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "open_world_action_justified": {
            "type": "boolean"
          },
          "closed_world_false_assurance": {
            "type": "boolean"
          },
          "actual_unsafe_action": {
            "type": "boolean"
          },
          "open_world_evidence_status": {
            "type": "string",
            "minLength": 1
          },
          "open_world_evidence_support_lower_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "decision_kind": {
            "enum": [
              "act",
              "defer"
            ]
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
