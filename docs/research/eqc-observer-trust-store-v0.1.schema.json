{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/eqc-observer-trust-store-v0.1.schema.json",
  "title": "EQC Evaluator-Provisioned Observer Trust Store v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "trust_store_id",
    "keys",
    "max_receipt_lifetime_seconds"
  ],
  "properties": {
    "schema": {
      "const": "luminous.eqc.observer-trust-store.v0.1"
    },
    "trust_store_id": {
      "type": "string",
      "minLength": 1
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "observer_id",
          "public_key_hex",
          "observer_binary_sha256",
          "observer_environment_sha256",
          "allowed_domains",
          "status",
          "valid_from",
          "valid_until",
          "revoked_at"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1
          },
          "observer_id": {
            "type": "string",
            "minLength": 1
          },
          "public_key_hex": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observer_binary_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observer_environment_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "allowed_domains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "active",
              "revoked",
              "disabled"
            ]
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "max_receipt_lifetime_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    }
  }
}
