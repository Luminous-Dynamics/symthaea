{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-open-world-candidate-v0.1.schema.json",
  "title": "EGDDM D6.18 open-world candidate view v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "decision_cutoff",
    "actions",
    "hypothesis_bounds",
    "options",
    "factors",
    "traces"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-candidate-v0.1.schema.json#/properties/actions/items"
      }
    },
    "hypothesis_bounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-candidate-v0.1.schema.json#/properties/hypothesis_bounds/items"
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-candidate-v0.1.schema.json#/properties/options/items"
      }
    },
    "factors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-candidate-v0.1.schema.json#/properties/factors/items"
      }
    },
    "traces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/egddm-noisy-channel-candidate-v0.1.schema.json#/properties/traces/items"
      }
    }
  }
}
