{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SDCB_ROBUST_COVARIANCE_V1.schema.json",
  "title": "SDCB finite-scenario robust full-covariance design v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "latent_ids", "science_index", "budget_units", "actions", "scenarios"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "fixture_id": {"type": "string", "minLength": 1},
    "latent_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "science_index": {"type": "integer", "minimum": 0},
    "budget_units": {"type": "integer", "minimum": 0},
    "actions": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/action"}},
    "scenarios": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "matrix": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "number"}}
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cost_units", "loadings"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "cost_units": {"type": "integer", "minimum": 1},
        "loadings": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "number"}}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prior_covariance", "residual_covariance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "prior_covariance": {"$ref": "#/$defs/matrix"},
        "residual_covariance": {"$ref": "#/$defs/matrix"}
      }
    }
  },
  "x-runtime-invariants": [
    "all scenario IDs are unique",
    "prior covariance dimensions equal latent_ids length",
    "residual covariance dimensions equal actions length",
    "all scenario covariance matrices are symmetric positive-definite",
    "one common selected action subset is evaluated in every scenario"
  ]
}
