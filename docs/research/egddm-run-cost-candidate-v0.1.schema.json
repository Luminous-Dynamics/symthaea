{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-run-cost-candidate-v0.1.schema.json",
  "title": "EGDDM D6.17.2.3 run-level receipt candidate view v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_receipts"
  ],
  "properties": {
    "run_receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "run_id",
          "task_family",
          "paired_seed",
          "repository_full_name",
          "branch",
          "commit_sha",
          "worktree_digest_sha256",
          "model_provider",
          "model_version",
          "model_config_digest_sha256",
          "harness_digest_sha256",
          "toolset_digest_sha256",
          "permissions_digest_sha256",
          "runner_class",
          "hardware_class",
          "runner_image_digest_sha256",
          "region",
          "runner_identity",
          "runner_attestation_ref",
          "runner_attestation_digest_sha256",
          "queued_at",
          "run_started_at",
          "run_finished_at",
          "attempts",
          "receipt_sha256"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "task_family": {
            "type": "string",
            "minLength": 1
          },
          "paired_seed": {
            "type": "integer",
            "minimum": 0
          },
          "repository_full_name": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "worktree_digest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "model_provider": {
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "model_config_digest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "harness_digest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "toolset_digest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "permissions_digest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "runner_class": {
            "type": "string",
            "minLength": 1
          },
          "hardware_class": {
            "type": "string",
            "minLength": 1
          },
          "runner_image_digest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "runner_identity": {
            "type": "string",
            "minLength": 1
          },
          "runner_attestation_ref": {
            "type": "string",
            "minLength": 1
          },
          "runner_attestation_digest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "queued_at": {
            "type": "string",
            "format": "date-time"
          },
          "run_started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "run_finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "attempts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_id",
                "sequence",
                "option_id",
                "attempt_no",
                "mode",
                "status",
                "result",
                "queued_at",
                "started_at",
                "completed_at",
                "elapsed_ms",
                "cpu_ms",
                "gpu_ms",
                "network_bytes",
                "price_micros",
                "retry_of_event_id",
                "evidence_digest_sha256",
                "billing_record_ref",
                "billing_record_sha256",
                "previous_event_sha256",
                "event_sha256"
              ],
              "properties": {
                "event_id": {
                  "type": "string",
                  "minLength": 1
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 0
                },
                "option_id": {
                  "type": "string",
                  "minLength": 1
                },
                "attempt_no": {
                  "type": "integer",
                  "minimum": 1
                },
                "mode": {
                  "enum": [
                    "cold",
                    "warm",
                    "retry"
                  ]
                },
                "status": {
                  "enum": [
                    "completed",
                    "failed",
                    "timeout",
                    "cancelled",
                    "skipped",
                    "queued",
                    "unknown"
                  ]
                },
                "result": {
                  "enum": [
                    "pass",
                    "fail",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "queued_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "started_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "completed_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "elapsed_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "cpu_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "gpu_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "network_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "price_micros": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "retry_of_event_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence_digest_sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "billing_record_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "billing_record_sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "previous_event_sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "event_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                }
              }
            }
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    }
  }
}
