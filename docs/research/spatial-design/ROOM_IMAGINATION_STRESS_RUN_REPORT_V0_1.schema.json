{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/spatial-design/ROOM_IMAGINATION_STRESS_RUN_REPORT_V0_1.schema.json",
  "title": "Room Stress Result Report v0.1",
  "description": "Candidate-system observation envelope; schema validity alone does not prove observation truth or artifact authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "implementation",
    "benchmark_sha256",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "room-stress-result-report-v0.1"
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "revision"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "benchmark_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "results": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/case_result"
      }
    }
  },
  "$defs": {
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "observations",
        "evidence_refs"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^ROOM-STRESS-[0-9]{3}$"
        },
        "observations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_key",
        "artifact_sha256",
        "artifact_revision",
        "artifact_path"
      ],
      "properties": {
        "observation_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_revision": {
          "type": "string",
          "minLength": 1
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
