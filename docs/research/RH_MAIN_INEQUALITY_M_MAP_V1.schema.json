{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/RH_MAIN_INEQUALITY_M_MAP_V1.schema.json",
  "title": "RH main inequality M source map v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "status",
    "source_identity",
    "formal_scope",
    "main_inequality",
    "proof_bridge",
    "explicit_non_used_or_ambiguous",
    "remaining_obligations",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "source_inspected_composition_map_not_complete_reconstruction",
        "expert_reviewed",
        "complete_reconstruction"
      ]
    },
    "source_identity": {
      "type": "object",
      "required": [
        "repository",
        "revision",
        "revision_date",
        "provenance",
        "cited_exposition"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "revision_date": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "type": "string"
        },
        "cited_exposition": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "formal_scope": {
      "type": "object",
      "required": [
        "target",
        "final_effect",
        "not_a_claim"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "final_effect": {
          "type": "string"
        },
        "not_a_claim": {
          "type": "string"
        }
      }
    },
    "main_inequality": {
      "type": "object",
      "required": [
        "paper_identity",
        "statement_lhs",
        "statement_rhs",
        "normalized_error",
        "normalization",
        "parameter_orders_from_the_exposition",
        "conceptual_role"
      ],
      "properties": {
        "paper_identity": {
          "type": "string"
        },
        "statement_lhs": {
          "type": "string"
        },
        "statement_rhs": {
          "type": "string"
        },
        "normalized_error": {
          "type": "string"
        },
        "normalization": {
          "type": "string"
        },
        "parameter_orders_from_the_exposition": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "conceptual_role": {
          "type": "string"
        }
      }
    },
    "quantities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "meaning"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          },
          "paper_equation": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "proof_bridge": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "source_file",
          "blob_sha",
          "cited_pdf_reference",
          "source_lines",
          "declarations",
          "observed_role",
          "extraction_status"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "source_file": {
            "type": "string"
          },
          "blob_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "cited_pdf_reference": {
            "type": "string"
          },
          "source_lines": {
            "type": "object"
          },
          "declarations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observed_role": {
            "type": "string"
          },
          "extraction_status": {
            "type": "string"
          }
        }
      }
    },
    "explicit_non_used_or_ambiguous": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "declaration",
          "reason"
        ],
        "properties": {
          "declaration": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "remaining_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "centering_bridge": {
      "type": "object",
      "required": [
        "paper_section",
        "source_formulas",
        "density",
        "constants",
        "weighted_recombination",
        "evidence_status"
      ],
      "properties": {
        "paper_section": {
          "type": "string"
        },
        "source_formulas": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "density": {
          "type": "object",
          "required": [
            "raw_prime_density_per_cell",
            "weight_coefficient",
            "weighted_density",
            "caveat"
          ],
          "properties": {
            "raw_prime_density_per_cell": {
              "type": "string"
            },
            "weight_coefficient": {
              "type": "string"
            },
            "weighted_density": {
              "type": "string"
            },
            "caveat": {
              "type": "string"
            }
          }
        },
        "constants": {
          "type": "object",
          "required": [
            "identity",
            "source_reason",
            "cell_count"
          ],
          "properties": {
            "identity": {
              "type": "string"
            },
            "source_reason": {
              "type": "string"
            },
            "cell_count": {
              "type": "string"
            }
          }
        },
        "weighted_recombination": {
          "type": "object",
          "required": [
            "identity",
            "main_terms",
            "logarithmic_part",
            "linear_constant_part",
            "conclusion",
            "precise_M"
          ],
          "properties": {
            "identity": {
              "type": "string"
            },
            "main_terms": {
              "type": "string"
            },
            "logarithmic_part": {
              "type": "string"
            },
            "linear_constant_part": {
              "type": "string"
            },
            "conclusion": {
              "type": "string"
            },
            "precise_M": {
              "type": "string"
            }
          }
        },
        "evidence_status": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "translation_average": {
      "type": "object",
      "required": [
        "paper_section",
        "identity",
        "reason",
        "weighted_consequence",
        "residual_consequence",
        "caveats",
        "evidence_status"
      ],
      "properties": {
        "paper_section": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "weighted_consequence": {
          "type": "string"
        },
        "residual_consequence": {
          "type": "string"
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_status": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "finite_translation_oracle": {
      "type": "object",
      "required": [
        "method",
        "group_sizes",
        "subsets",
        "group_target_cases",
        "row_indicator_cases",
        "checked_identity",
        "test_function",
        "status",
        "limitations"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "group_sizes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 2
          }
        },
        "subsets": {
          "type": "string"
        },
        "group_target_cases": {
          "type": "integer",
          "minimum": 0
        },
        "row_indicator_cases": {
          "type": "integer",
          "minimum": 0
        },
        "checked_identity": {
          "type": "string"
        },
        "test_function": {
          "type": "string"
        },
        "status": {
          "enum": [
            "source_added_exact_head_ci_pending",
            "passed_exact_head_ci",
            "failed_exact_head_ci",
            "not_run"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "upstream_graph_crosschecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "declaration",
          "source_file",
          "source_lines",
          "upstream_file",
          "upstream_blob_sha",
          "upstream_row",
          "upstream_semantics",
          "interpretation",
          "limit"
        ],
        "properties": {
          "declaration": {
            "type": "string"
          },
          "source_file": {
            "type": "string"
          },
          "source_lines": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "upstream_file": {
            "type": "string"
          },
          "upstream_blob_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "upstream_row": {
            "type": "string"
          },
          "upstream_semantics": {
            "type": "string"
          },
          "interpretation": {
            "type": "string"
          },
          "limit": {
            "type": "string"
          }
        }
      }
    },
    "uniform_error_bridges": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "paper_equation": {
            "type": "string"
          },
          "bound": {
            "type": "string"
          },
          "consequence": {
            "type": "string"
          },
          "source_identity": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}
