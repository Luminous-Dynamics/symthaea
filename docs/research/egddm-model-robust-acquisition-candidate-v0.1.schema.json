{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-model-robust-acquisition-candidate-v0.1.schema.json",
  "title": "D6.16 candidate-view schema v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "decision_cutoff",
    "budget_micros",
    "actions",
    "measurements",
    "traces"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "budget_micros": {
      "type": "integer",
      "minimum": 0
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "irreversible",
          "hard_gate",
          "max_residual_risk_bps"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "irreversible": {
            "type": "boolean"
          },
          "hard_gate": {
            "type": "boolean"
          },
          "max_residual_risk_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "measurement_id",
          "available_at",
          "estimated_cost_upper_micros"
        ],
        "properties": {
          "measurement_id": {
            "type": "string",
            "minLength": 1
          },
          "available_at": {
            "type": "string",
            "format": "date-time"
          },
          "estimated_cost_upper_micros": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "traces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trace_id",
          "acquisitions",
          "decision"
        ],
        "properties": {
          "trace_id": {
            "type": "string",
            "minLength": 1
          },
          "acquisitions": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "measurement_id",
                "outcome_id",
                "mode",
                "at"
              ],
              "properties": {
                "measurement_id": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome_id": {
                  "type": "string",
                  "minLength": 1
                },
                "mode": {
                  "enum": [
                    "cold",
                    "warm",
                    "retry"
                  ]
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "action_id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "act",
                  "defer"
                ]
              },
              "action_id": {
                "type": "string",
                "minLength": 1
              },
              "claimed_worst_case_risk_bps": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10000
              }
            }
          }
        }
      }
    }
  }
}
