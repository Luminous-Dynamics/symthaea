{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/SDCB_INTERVAL_OBSERVATION_V1.schema.json",
  "title": "SDCB interval observation fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "process",
    "windows",
    "acquisition_noise_covariance",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "sdcb_interval_observation.v1"
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "diffusion_covariance",
        "initial_mean",
        "initial_covariance"
      ],
      "properties": {
        "generator": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "diffusion_covariance": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "initial_mean": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "initial_covariance": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_seconds",
          "end_seconds",
          "loadings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start_seconds": {
            "type": "number"
          },
          "end_seconds": {
            "type": "number"
          },
          "loadings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "acquisition_noise_covariance": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
