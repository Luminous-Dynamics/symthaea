{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-identifiability-bundle-v0.1.schema.json",
  "title": "EGDDM D6.11 causal-identifiability bundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_id",
    "bundle_visibility",
    "candidate_view",
    "gold_overlay",
    "candidate_traces"
  ],
  "properties": {
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "bundle_visibility": {
      "const": "evaluator_only_never_candidate_visible"
    },
    "candidate_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "events",
        "observation_boundaries",
        "pair_tasks"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "producer_id",
              "sequence_number",
              "event_time",
              "available_at"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "producer_id": {
                "type": "string",
                "minLength": 1
              },
              "sequence_number": {
                "type": "integer",
                "minimum": 0
              },
              "event_time": {
                "type": "string",
                "format": "date-time"
              },
              "available_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "observation_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "producer_id",
              "expected_sequence_numbers",
              "observed_sequence_numbers",
              "attested_complete",
              "signature_status",
              "issuer_key_digest",
              "observer_identity_digest"
            ],
            "properties": {
              "producer_id": {
                "type": "string",
                "minLength": 1
              },
              "expected_sequence_numbers": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "observed_sequence_numbers": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "attested_complete": {
                "type": "boolean"
              },
              "signature_status": {
                "enum": [
                  "valid",
                  "invalid",
                  "unknown"
                ]
              },
              "issuer_key_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "observer_identity_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "pair_tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pair_id",
              "left_event_id",
              "right_event_id",
              "relevant_producers",
              "decision_cutoff",
              "critical"
            ],
            "properties": {
              "pair_id": {
                "type": "string",
                "minLength": 1
              },
              "left_event_id": {
                "type": "string",
                "minLength": 1
              },
              "right_event_id": {
                "type": "string",
                "minLength": 1
              },
              "relevant_producers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "decision_cutoff": {
                "type": "string",
                "format": "date-time"
              },
              "critical": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "gold_overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudication_status",
        "boundary_truths",
        "pair_truths"
      ],
      "properties": {
        "adjudication_status": {
          "const": "synthetic_known_answer_not_independently_adjudicated"
        },
        "boundary_truths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "producer_id",
              "expected_state"
            ],
            "properties": {
              "producer_id": {
                "type": "string"
              },
              "expected_state": {
                "enum": [
                  "complete",
                  "gap",
                  "compromised",
                  "unknown"
                ]
              }
            }
          }
        },
        "pair_truths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pair_id",
              "admissible_relations"
            ],
            "properties": {
              "pair_id": {
                "type": "string"
              },
              "admissible_relations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "before",
                    "after",
                    "concurrent"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "candidate_traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trace_id",
          "boundary_claims",
          "pair_claims"
        ],
        "properties": {
          "trace_id": {
            "type": "string",
            "minLength": 1
          },
          "boundary_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "producer_id",
                "claimed_state"
              ],
              "properties": {
                "producer_id": {
                  "type": "string"
                },
                "claimed_state": {
                  "enum": [
                    "complete",
                    "gap",
                    "compromised",
                    "unknown"
                  ]
                }
              }
            }
          },
          "pair_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pair_id",
                "claimed_relation",
                "evidence_event_ids"
              ],
              "properties": {
                "pair_id": {
                  "type": "string"
                },
                "claimed_relation": {
                  "enum": [
                    "before",
                    "after",
                    "concurrent",
                    "underdetermined",
                    "compromised"
                  ]
                },
                "evidence_event_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
