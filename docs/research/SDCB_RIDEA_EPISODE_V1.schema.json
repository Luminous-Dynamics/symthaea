{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SDCB_RIDEA_EPISODE_V1.schema.json",
  "title": "SDCB R-I/R-IDeA episode v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "history_designs",
    "target_distribution",
    "candidates",
    "config"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "history_designs": {
      "$ref": "#/$defs/designSet"
    },
    "target_distribution": {
      "$ref": "#/$defs/designSet"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "design",
          "expected_information_gain",
          "cost_units",
          "current_prediction",
          "proxy_prediction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "design": {
            "$ref": "#/$defs/designVector"
          },
          "expected_information_gain": {
            "type": "number",
            "minimum": 0
          },
          "cost_units": {
            "type": "integer",
            "minimum": 1
          },
          "current_prediction": {
            "type": "number"
          },
          "proxy_prediction": {
            "type": "number"
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representativeness_weight",
        "deamplification_threshold",
        "sigmoid_scale",
        "rbf_sigma"
      ],
      "properties": {
        "representativeness_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "deamplification_threshold": {
          "type": "number",
          "minimum": 0
        },
        "sigmoid_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rbf_sigma": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "ranking_kind": {
      "enum": [
        "representative_informative",
        "representative_informative_deamplifying"
      ]
    }
  },
  "$defs": {
    "designVector": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "number"
      }
    },
    "designSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/designVector"
      }
    }
  },
  "$comment": "Semantic validation must enforce a consistent design-vector dimension across both datasets and all candidates, unique nonempty candidate IDs, finite values, and the same target design distribution for all candidates in an episode."
}
