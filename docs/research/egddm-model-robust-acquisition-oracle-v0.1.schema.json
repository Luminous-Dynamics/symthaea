{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-model-robust-acquisition-oracle-v0.1.schema.json",
  "title": "D6.16 evaluator-oracle schema v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_cutoff",
    "budget_micros",
    "actions",
    "measurements",
    "models"
  ],
  "properties": {
    "decision_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "budget_micros": {
      "type": "integer",
      "minimum": 0
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "irreversible",
          "hard_gate",
          "max_residual_risk_bps"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "irreversible": {
            "type": "boolean"
          },
          "hard_gate": {
            "type": "boolean"
          },
          "max_residual_risk_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "measurement_id",
          "available_at",
          "cost_samples_micros"
        ],
        "properties": {
          "measurement_id": {
            "type": "string",
            "minLength": 1
          },
          "available_at": {
            "type": "string",
            "format": "date-time"
          },
          "cost_samples_micros": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cold",
              "warm",
              "retry"
            ],
            "properties": {
              "cold": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "warm": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "retry": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "states",
          "likelihoods"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state_id",
                "prior_bps",
                "safe_actions"
              ],
              "properties": {
                "state_id": {
                  "type": "string",
                  "minLength": 1
                },
                "prior_bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "safe_actions": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "likelihoods": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "history",
                "measurement_id",
                "outcomes"
              ],
              "properties": {
                "history": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "measurement_id",
                      "outcome_id"
                    ],
                    "properties": {
                      "measurement_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "outcome_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "measurement_id": {
                  "type": "string",
                  "minLength": 1
                },
                "outcomes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "outcome_id",
                      "state_likelihoods"
                    ],
                    "properties": {
                      "outcome_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "state_likelihoods": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "state_id",
                            "probability_bps"
                          ],
                          "properties": {
                            "state_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "probability_bps": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 10000
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
