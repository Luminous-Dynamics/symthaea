{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/CASTING_BENCHMARK_TRACE.schema.json",
  "title": "CASTING-MO-BO-001 evaluation trace row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_index",
    "candidate_id",
    "status",
    "objectives"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "evaluation_index": {
      "type": "integer",
      "minimum": 1,
      "description": "1-based sequential objective-oracle call index."
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": [
        "feasible",
        "infeasible",
        "invalid",
        "failed"
      ]
    },
    "objectives": {
      "description": "Exactly two finite numeric objectives for a valid objective result, or null when unavailable.",
      "anyOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "feasible"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "objectives": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "invalid",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "objectives": {
            "type": "null"
          }
        }
      }
    }
  ]
}
