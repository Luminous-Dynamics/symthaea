  "claim_boundaries": [
    "Outcomes derive from a transient JavaScript reference preflight, not the Rust graph generator or runner.",
    "This reports finite-sample subsets of 16 observed restart outcomes. It is not a model of unlimited future restarts and is not a comparison against the QAOA-informed algorithm.",
    "Selecting a best-of-k outcome requires k trajectories; do not compare best-of-k with a single run as if costs matched.",
    "The pooled average is an instance-weighted mixture of the stated size strata; per-size values are reported to reveal heterogeneity.",
    "The graph-level bootstrap interval is exploratory and post-hoc, and is not adjusted for multiple endpoints or algorithm selection.",
    "No wall-clock timings, quantum output, SOTA improvement or quantum advantage are claimed."
  ],
  "literature_reference": {
    "title": "Large independent sets on random d-regular graphs with fixed degree d",
    "authors": "Raffaele Marino and Scott Kirkpatrick",
    "arxiv": "https://arxiv.org/abs/2003.12293",
    "degree": 3,
    "reported_asymptotic_ratio": 0.44533,
    "reported_uncertainty": 0.000003,
    "interpretation": "Paper-reported asymptotic independence ratio of the deferred-decision prioritized algorithm as N grows. It is not an upper bound on the maximum independent-set ratio and not a controlled finite-N runtime comparison.",
    "source_note": "The QGreedy 2026 preprint uses this as the classical linear-time prioritized-search reference."
  }
