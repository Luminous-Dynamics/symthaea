{
  "schema": "org.luminousdynamics.symthaea.qcomp.random-regular-mis-cohort.v1",
  "status": "cohort-specification-only-graphs-not-generated",
  "research_track": "QCOMP-RRG-COHORT-001",
  "generator": {
    "algorithm": "configuration-pair-reject-v1",
    "crate_api": "generate_random_regular_mis_graph",
    "source_prng": "Symthaea XorShift64* (deterministic, non-cryptographic)",
    "construction": "Create degree copies (stubs) for each labeled vertex; Fisher-Yates shuffle with rejection-sampled bounded integers; pair consecutive stubs; reject any self-loop or repeated undirected edge; sort/canonicalize accepted edges; validate every vertex has exact requested degree.",
    "output_format": "DIMACS edge format, one-based vertices, canonical sorted edges",
    "retry_policy": "maximum 100000 pairings per instance; exhaustions are explicit failures and must not be silently retried with a new seed",
    "caveat": "Deterministic generation is not itself evidence that a sample is independent or distributionally representative. Test generator statistics before confirmatory use."
  },
  "motivation": {
    "primary_reference": "Wybo et al., Scalable quantum-enhanced greedy algorithm for maximum independent set problems, accepted by Physical Review Research on 2026-10-19",
    "doi": "10.1103/ds1n-wsdm",
    "reference_url": "https://doi.org/10.1103/ds1n-wsdm",
    "scope": "Independent random-regular graph benchmark track; not a reproduction claim until the accepted paper's complete methods and parameter files are captured."
  },
  "split_design": {
    "train_sizes": [
      128,
      256,
      512
    ],
    "validation_sizes": [
      1024
    ],
    "test_sizes": [
      2048,
      4096
    ],
    "degrees": [
      3,
      4
    ],
    "replicates_per_size_degree": 8,
    "size_holdout": "Validation and test sizes are never used for selector tuning. Test sizes 2048/4096 target graph-size generalization beyond train sizes.",
    "counts": {
      "train": 48,
      "validation": 16,
      "test": 32,
      "total": 96
    },
    "leakage_caveat": "All instances share a random-regular generator family; this measures size generalization within the chosen graph family, not out-of-distribution generalization to other graph distributions."
  },
  "seed_derivation": {
    "base_seed_hex": "0x51524d4953000000",
    "formula": "seed = base_seed + vertex_count * 100000 + degree * 1000 + (replicate_index - 1)",
    "purpose": "Stable, non-overlapping deterministic workload seeds; seed values are recorded explicitly per workload below."
  },
