{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SDCB_PARETO_DECISION_EPISODE_V1.schema.json",
  "title": "SDCB Pareto decision episode v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "prior",
    "action_ids",
    "objective_ids",
    "hypotheses",
    "minimum_by_objective",
    "experiments"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "prior": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "action_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objective_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "utility_by_action"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "minLength": 1
          },
          "utility_by_action": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "minimum_by_objective": {
      "type": "array",
      "items": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "experiments": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experiment_id",
          "cost_units",
          "outcome_likelihoods"
        ],
        "properties": {
          "experiment_id": {
            "type": "string",
            "minLength": 1
          },
          "cost_units": {
            "type": "integer",
            "minimum": 1
          },
          "outcome_likelihoods": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  },
  "$comment": "All objectives are maximized; encode risk as a signed safety margin or negative loss. Cross-field validation: prior sum 1; one hypothesis row per prior; utility shape [hypotheses][actions][objectives]; one minimum entry per objective; likelihood matrix rows=prior entries, equal outcome width and row sums=1; IDs unique. Hard lower bounds apply to each action under every nonzero-prior hypothesis."
}
