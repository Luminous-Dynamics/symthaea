{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-risk-cost-oracle-v0.1.schema.json",
  "title": "EGDDM D6.17.2 evaluator cost oracle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_cutoff",
    "budget_micros",
    "options"
  ],
  "properties": {
    "decision_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "budget_micros": {
      "type": "integer",
      "minimum": 1
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "available_at",
          "cost_samples_micros"
        ],
        "properties": {
          "option_id": {
            "type": "string"
          },
          "available_at": {
            "type": "string",
            "format": "date-time"
          },
          "cost_samples_micros": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cold",
              "warm",
              "retry"
            ],
            "properties": {
              "cold": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "warm": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "retry": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
