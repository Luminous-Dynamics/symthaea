{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/MATHLIB_ELABORATED_DEPENDENCY_GRAPH_V1.schema.json",
  "title": "Mathlib Elaborated Dependency Graph Extraction V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_repository",
    "source_revision",
    "lean_toolchain",
    "lean_revision",
    "declaration",
    "declaration_kind",
    "level_parameters",
    "proof_value_available",
    "type_dependencies",
    "proof_value_dependencies",
    "constant_info_dependency_closure",
    "unresolved_dependencies",
    "edges",
    "helper_nodes",
    "trust_profile",
    "value_kind",
    "value_dependencies",
    "definition_value_dependencies",
    "opaque_value_dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source_repository": {
      "const": "leanprover-community/mathlib4"
    },
    "source_revision": {
      "const": "6ebcce37335bcb6bca64596e5d57bb3035648030"
    },
    "lean_toolchain": {
      "const": "leanprover/lean4:v4.37.0-rc1"
    },
    "lean_revision": {
      "const": "0b77e12952ad39077d80d8bd6b66d601f225c321"
    },
    "declaration": {
      "type": "string",
      "minLength": 1
    },
    "declaration_kind": {
      "enum": [
        "axiom",
        "definition",
        "theorem",
        "opaque",
        "quotient",
        "inductive",
        "constructor",
        "recursor"
      ]
    },
    "level_parameters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_value_available": {
      "type": "boolean"
    },
    "type_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_value_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constant_info_dependency_closure": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "relation",
          "origin"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "type_dependency",
              "proof_dependency",
              "inductive_constructor",
              "mutual_inductive_member",
              "constructor_of",
              "recursor_for_inductive",
              "recursor_rule_constructor",
              "recursor_reduction_dependency",
              "definition_dependency",
              "opaque_value_dependency",
              "other_value_dependency"
            ]
          },
          "origin": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "helper_nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/helperNode"
      }
    },
    "trust_profile": {
      "$ref": "#/$defs/trustProfile"
    },
    "value_kind": {
      "enum": [
        "theorem_proof",
        "definition_body",
        "opaque_value",
        "unavailable",
        "other_value"
      ]
    },
    "value_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "definition_value_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "opaque_value_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "helperNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_declaration",
        "node_role",
        "declaration",
        "declaration_kind",
        "proof_value_available",
        "type_dependencies",
        "proof_value_dependencies",
        "constant_info_dependency_closure",
        "unresolved_dependencies",
        "edges",
        "trust_profile",
        "value_kind",
        "value_dependencies",
        "definition_value_dependencies",
        "opaque_value_dependencies"
      ],
      "properties": {
        "root_declaration": {
          "type": "string",
          "minLength": 1
        },
        "node_role": {
          "const": "generated_or_private_helper"
        },
        "declaration": {
          "type": "string",
          "minLength": 1
        },
        "declaration_kind": {
          "enum": [
            "axiom",
            "definition",
            "theorem",
            "opaque",
            "quotient",
            "inductive",
            "constructor",
            "recursor"
          ]
        },
        "proof_value_available": {
          "type": "boolean"
        },
        "type_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proof_value_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constant_info_dependency_closure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target",
              "relation",
              "origin"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "enum": [
                  "type_dependency",
                  "proof_dependency",
                  "inductive_constructor",
                  "mutual_inductive_member",
                  "constructor_of",
                  "recursor_for_inductive",
                  "recursor_rule_constructor",
                  "recursor_reduction_dependency"
                ]
              },
              "origin": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "trust_profile": {
          "$ref": "#/$defs/trustProfile"
        },
        "value_kind": {
          "enum": [
            "theorem_proof",
            "definition_body",
            "opaque_value",
            "unavailable",
            "other_value"
          ]
        },
        "value_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "definition_value_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "opaque_value_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trustProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closure_status",
        "transitive_declaration_count",
        "axiom_declarations",
        "unsafe_declarations",
        "partial_declarations",
        "opaque_declarations",
        "sorry_ax_present",
        "unresolved_declarations"
      ],
      "properties": {
        "closure_status": {
          "enum": [
            "complete",
            "unresolved"
          ]
        },
        "transitive_declaration_count": {
          "type": "integer",
          "minimum": 0
        },
        "axiom_declarations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsafe_declarations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partial_declarations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "opaque_declarations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sorry_ax_present": {
          "type": "boolean"
        },
        "unresolved_declarations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "description": " Includes generated/private helper declarations referenced by the root theorem proof value. Includes recursive trust-boundary inventory for every theorem and generated helper. Includes recursive trust-boundary inventory for theorem and helper declarations."
}
