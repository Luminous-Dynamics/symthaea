    "intervention_families": [
      {
        "family_id": "requirement_addition",
        "change_surface": "A new user, security, compatibility or operational requirement becomes active mid-task.",
        "gold_impact": "Independently adjudicated obligations whose acceptance contract changes or is newly introduced.",
        "negative_control": "Add explanatory prose that does not alter any acceptance criterion.",
        "expected_recovery": "Update the active requirement set, identify newly affected obligations, acquire scoped evidence and retain unaffected receipts.",
        "critical_risk": "New critical obligation omitted or falsely treated as already verified."
      },
      {
        "family_id": "requirement_removal_or_deprecation",
        "change_surface": "A requirement is removed, narrowed or replaced by a newer requirement.",
        "gold_impact": "Obligations made inactive, replaced or still active under revised semantics.",
        "negative_control": "A deprecated label changes but the normative requirement remains in force.",
        "expected_recovery": "Stop spending effort on obsolete obligations without discarding still-active constraints; preserve a supersession link.",
        "critical_risk": "Old requirement treated as current or still-active requirement silently dropped."
      },
      {
        "family_id": "dependency_api_break",
        "change_surface": "Dependency version or API contract changes incompatibly while work is in progress.",
        "gold_impact": "Consumers, contracts, tests and deployment obligations that rely on the changed API.",
        "negative_control": "An unrelated dependency is upgraded with no path to the affected contract.",
        "expected_recovery": "Invalidate dependent evidence, refresh impacted contracts and preserve unrelated build/test evidence when exact scope supports reuse.",
        "critical_risk": "Stale pass reused for a changed interface or unsafe broad invalidation."
      },
      {
        "family_id": "toolchain_upgrade",
        "change_surface": "Compiler, linker, package manager, build system or test-runner version changes.",
        "gold_impact": "Checks whose execution semantics or artifacts depend on the changed toolchain.",
        "negative_control": "Documentation-only version string update with no executable toolchain change.",
        "expected_recovery": "Pin the new toolchain world, identify affected evidence and rerun only checks whose validity depends on it.",
        "critical_risk": "Results from an old compiler/test runner represented as current."
      },
      {
        "family_id": "configuration_world_drift",
        "change_surface": "Feature flags, environment variables, deployment configuration or configuration secrets rotate.",
        "gold_impact": "Obligations whose semantics or runtime behaviour depend on changed configuration.",
        "negative_control": "An unused setting changes outside every active dependency path.",
        "expected_recovery": "Create a new configuration-world identity and invalidate evidence that depends on it.",
        "critical_risk": "Evidence from a different configuration world reused."
      },
      {
        "family_id": "runtime_external_state",
        "change_surface": "Runtime state or an external service changes independently of repository source.",
        "gold_impact": "Runtime, integration and service-level obligations affected by the observed state change.",
        "negative_control": "An external status update unrelated to the exercised service contract.",
        "expected_recovery": "Separate source correctness from environment-dependent observations and reacquire live evidence where needed.",
        "critical_risk": "A historical runtime pass is treated as proof of current external availability."
      },
      {
        "family_id": "session_tool_identity",
        "change_surface": "Agent session, tool implementation, credentials or execution context is replaced.",
        "gold_impact": "Evidence whose validity is bound to the prior tool, identity, credentials or session state.",
        "negative_control": "A display-only session label changes without execution identity change.",
        "expected_recovery": "Reconcile session state, re-establish authorized identity and distrust receipts bound to invalidated execution context.",
        "critical_risk": "Tool/session-bound evidence or permissions silently carried into a different context."
      },
      {
        "family_id": "authority_policy_change",
        "change_surface": "Authority, scope, approval, policy or delegation is revoked or narrowed.",
        "gold_impact": "Actions and evidence acquisition paths no longer permitted under the active policy.",
        "negative_control": "An unrelated policy section is edited without changing the relevant authority boundary.",
        "expected_recovery": "Fail closed, stop newly unauthorized actions and obtain fresh authority evidence; EVSI cannot override the hard gate.",
        "critical_risk": "Unauthorized irreversible action after a revocation."
      },
      {
        "family_id": "evidence_invalidation_contradiction",
        "change_surface": "A source observation is retracted, superseded, challenged or contradicted by later evidence.",
        "gold_impact": "Claims whose source receipt is invalidated or whose confidence/epistemic status must change.",
        "negative_control": "A duplicate observation agrees with and does not supersede the original source.",
        "expected_recovery": "Preserve history, mark the assertion stale/disputed, acquire discriminating evidence or abstain.",
        "critical_risk": "Contradicted or revoked evidence remains represented as current fact."
      },
      {
        "family_id": "test_oracle_revision",
        "change_surface": "Tests, grading criteria, acceptance oracle or fixture contracts are corrected or expanded.",
        "gold_impact": "Obligations whose validity depends on the changed test/oracle definition.",
        "negative_control": "Test formatting/refactoring that preserves executable semantics.",
        "expected_recovery": "Version the oracle and regrade in a pristine environment; prevent candidate edits from altering grader truth.",
        "critical_risk": "A self-modified or stale oracle determines a false pass."
      },
      {
        "family_id": "common_cause_environment",
        "change_surface": "A shared image, base library, network dependency, infrastructure or time service changes several components at once.",
        "gold_impact": "All obligations shown by independently curated causal/scope adjudication to share the changed environmental dependency.",
        "negative_control": "A component-local change with no common-cause exposure.",
        "expected_recovery": "Avoid treating correlated failures as independent; update common-cause cut sets and revalidate affected obligations together.",
        "critical_risk": "Underestimating correlated failures or falsely attributing them to individual changes."
      },
      {
        "family_id": "cross_repository_contract",
        "change_surface": "A schema, API, message protocol, data contract or service version changes in a neighbouring repository.",
        "gold_impact": "Consumer obligations across repository boundaries pinned to the changed contract version.",
        "negative_control": "An adjacent repository changes an unrelated module without changing the shared contract.",
        "expected_recovery": "Reconcile cross-repository identities, version the contract and qualify consumers against the exact compatible pair.",
        "critical_risk": "A locally passing repository is incompatible with the deployed neighbour."
      }
    ],
