{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-noisy-channel-oracle-v0.1.schema.json",
  "title": "EGDDM D6.17 evaluator oracle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actual_hypothesis_id",
    "decision_cutoff",
    "actions",
    "hypothesis_bounds",
    "options",
    "factors",
    "hypothesis_safety",
    "calibrations",
    "factorization_certificates"
  ],
  "properties": {
    "actual_hypothesis_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "irreversible",
          "hard_gate",
          "max_residual_risk_bps"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "irreversible": {
            "type": "boolean"
          },
          "hard_gate": {
            "type": "boolean"
          },
          "max_residual_risk_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    "hypothesis_bounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "lower_probability_bps",
          "upper_probability_bps",
          "nominal_probability_bps"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "minLength": 1
          },
          "lower_probability_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "upper_probability_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "nominal_probability_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "available_at",
          "factor_id"
        ],
        "properties": {
          "option_id": {
            "type": "string"
          },
          "available_at": {
            "type": "string",
            "format": "date-time"
          },
          "factor_id": {
            "type": "string"
          }
        }
      }
    },
    "factors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "factor_id",
          "dependence_group",
          "source_ids",
          "calibration_ref",
          "likelihoods"
        ],
        "properties": {
          "factor_id": {
            "type": "string"
          },
          "dependence_group": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "calibration_ref": {
            "type": "string"
          },
          "likelihoods": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hypothesis_id",
                "outcomes"
              ],
              "properties": {
                "hypothesis_id": {
                  "type": "string"
                },
                "outcomes": {
                  "type": "object",
                  "minProperties": 2,
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "lower_likelihood_bps",
                      "upper_likelihood_bps",
                      "nominal_likelihood_bps"
                    ],
                    "properties": {
                      "lower_likelihood_bps": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      },
                      "upper_likelihood_bps": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      },
                      "nominal_likelihood_bps": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "hypothesis_safety": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "safe_actions"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string"
          },
          "safe_actions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "calibrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calibration_id",
          "authority",
          "valid_from",
          "valid_until",
          "revoked_at",
          "factor_ids"
        ],
        "properties": {
          "calibration_id": {
            "type": "string"
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "factor_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "factorization_certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "certificate_id",
          "authority",
          "dependence_groups",
          "conditioning_scope",
          "factor_ids",
          "action_ids",
          "valid_from",
          "valid_until",
          "revoked_at",
          "mutual_conditional_independence"
        ],
        "properties": {
          "certificate_id": {
            "type": "string"
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "dependence_groups": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "action_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "mutual_conditional_independence": {
            "const": true
          },
          "factor_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "conditioning_scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "contains": {
              "const": "hypothesis"
            }
          }
        }
      }
    }
  }
}
