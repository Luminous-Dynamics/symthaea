{
  "protocol_id": "SCI-NOISE-001",
  "version": "0.1.0",
  "status": "proposal_only",
  "linked_issue": "https://github.com/Luminous-Dynamics/symthaea/issues/8607",
  "protocol_document": "docs/research/SCIENTIFIC_DISCOVERY_NOISE_ROBUSTNESS_V0_1.md",
  "claim_ceiling": "Protocol and scenario manifest only; no implementation, validation, statistical guarantee, or performance result is established by this file. The interleaved anchor schedule is a fixed-design diagnostic control, not a causal attribution guarantee.",
  "design": {
    "unit_of_pairing": "world_seed_design_mode_noise_regime",
    "independent_rng_streams": [
      "public_design",
      "target_law",
      "noise_process",
      "in_domain_evaluation",
      "marginal_shift_evaluation",
      "joint_extrapolation_evaluation",
      "near_boundary_evaluation"
    ],
    "hidden_from_policy": [
      "target_law",
      "noise_regime_label",
      "latent_noise_draw",
      "true_residual",
      "evaluator_labels",
      "evaluator_holdouts"
    ],
    "design_modes": [
      "fixed",
      "adaptive"
    ],
    "law_status_cells": [
      "law_correct_noise_matched",
      "law_correct_noise_mismatched",
      "law_wrong_noise_matched",
      "law_wrong_noise_mismatched",
      "non_identifiable"
    ],
    "noise_regimes": [
      {
        "id": "gaussian_homoscedastic",
        "role": "matched_control",
        "parameters_frozen": true,
        "dependencies": []
      },
      {
        "id": "gaussian_heteroscedastic",
        "role": "single_factor_shift",
        "parameters_frozen": true,
        "dependencies": [
          "pre_outcome_covariates"
        ]
      },
      {
        "id": "student_t_heavy_tail",
        "role": "single_factor_shift",
        "parameters_frozen": true,
        "dependencies": [
          "fixed_degrees_of_freedom",
          "fixed_scale"
        ]
      },
      {
        "id": "contamination_outliers",
        "role": "single_factor_shift",
        "parameters_frozen": true,
        "dependencies": [
          "contamination_probability",
          "contamination_magnitude_law"
        ]
      },
      {
        "id": "ar1_residuals",
        "role": "single_factor_shift",
        "parameters_frozen": true,
        "dependencies": [
          "serial_dependence_parameter"
        ]
      },
      {
        "id": "censored_or_missing",
        "role": "measurement_process_shift",
        "parameters_frozen": true,
        "dependencies": [
          "admission_mechanism",
          "censoring_rule"
        ]
      },
      {
        "id": "scale_drift",
        "role": "time_or_regime_shift",
        "parameters_frozen": true,
        "dependencies": [
          "drift_schedule",
          "scale_ratio"
        ]
      },
      {
        "id": "combined_shift",
        "role": "stress_only_after_single_factor_controls",
        "parameters_frozen": true,
        "dependencies": [
          "preregistered_component_regimes"
        ]
      }
    ],
    "split_roles": [
      "discovery",
      "method_tuning",
      "calibration_if_applicable",
      "fresh_policy_visible_post_recovery_validation",
      "evaluator_only_in_domain",
      "evaluator_only_marginal_shift",
      "evaluator_only_joint_extrapolation",
      "evaluator_only_near_boundary"
    ],
    "confirmatory_targets": {
      "minimum_held_out_worlds": 60,
      "minimum_structural_families": 6,
      "paired_seeds_per_world": 20,
      "noise_regime_precision_target_required": true,
      "full_factorial_denominators_required": true
    },
    "diagnostic_controls": {
      "fixed_design": "interleaved_anchor_schedule",
      "anchor_rule": "Every block includes every candidate covariate once and a fixed count of repeated anchor measurements; shuffle within block with a recorded seed.",
      "adaptive_design": "If enabled, use predeclared budgeted anchor audits at fixed or randomized cadence, shared across matched policies.",
      "purpose": [
        "diagnose time/order drift",
        "reduce confounding between covariate shift and noise drift"
      ],
      "limitations": [
        "anchor shift alone does not prove the scientific law is correct",
        "anchor design does not guarantee identifiability",
        "anchor measurements count against each policy's budget"
      ],
      "report": [
        "anchor residual by block",
        "anchor residual by randomized within-block position",
        "residual by covariate",
        "diagnostic cause set or explicit unresolved attribution"
      ]
    }
  },
  "metrics": {
    "discovery": [
      "initial_pool_equivalence_hits",
      "equivalence_class_recovery",
      "false_confident_singleton_rate",
      "unresolved_rate",
      "rejected_rate",
      "not_evaluable_rate"
    ],
    "generalization": [
      "in_domain_error",
      "marginal_shift_error",
      "joint_extrapolation_error",
      "near_boundary_error"
    ],
    "monitoring": [
      "clean_world_false_alarm_rate",
      "structural_discrepancy_detection_rate",
      "detection_delay_paid_observations",
      "proper_predictive_score_when_defined",
      "coverage_and_interval_width_when_applicable",
      "prequential_pit_or_rank_when_assumptions_valid"
    ],
    "attribution": [
      "noise_regime_attribution_when_identifiable",
      "ambiguity_when_not_identifiable"
    ],
    "cost": [
      "measurements_to_validated_recovery_or_unresolved",
      "candidate_evaluations",
      "generation_attempts",
      "wall_clock",
      "cpu_gpu_resource_use",
      "external_tool_cost"
    ]
  },
  "gates": {
    "tests_for_each_noise_generator_known_answer_and_replay": true,
    "evaluator_truth_unavailable_to_policy": true,
    "distinguish_noise_mismatch_false_alarms_from_wrong_law_detection": true,
    "adaptive_selection_assumptions_explicit": true,
    "invalid_or_censored_observation_not_encoded_as_zero_residual": true,
    "recovered_singleton_requires_fresh_validation": true,
    "report_complete_denominators_by_world_family_regime_and_design": true,
    "false_alarm_rate_target": 0.05,
    "false_alarm_confidence_level": 0.95,
    "false_alarm_upper_bound_must_meet_target": true,
    "exact_head_tests_required_for_implementation_qualification": true
  },
  "comparators": [
    "fixed_gaussian_prequential_pit_where_contract_applies",
    "robust_predictive_likelihood",
    "randomized_predictive_rank_or_pit_where_valid",
    "calibration_split_or_conformal_interval_where_assumptions_apply",
    "block_aware_score_for_dependent_observations",
    "no_monitor",
    "stop_as_unresolved",
    "nominal_expected_information_gain",
    "random_query_selection",
    "fixed_grid_or_round_robin",
    "current_typed_residual_guided_recovery",
    "compatible_pinned_pysr_ai_feynman_erbench_srbench_tracks"
  ],
  "reporting_rules": {
    "no_single_composite_score": true,
    "never_drop_non_evaluable_worlds_without_reporting": true,
    "seeds_within_world_not_independent_worlds": true,
    "queued_skipped_stale_head_checks_are_not_passes": true,
    "published_external_results_are_not_matched_replications": true
  }
}
