{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/bioprotein-experiment-value-corpus-v1.json",
  "title": "Bioprotein experiment value corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_id",
    "schema_version",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "corpus_id": {
      "const": "BIOPROTEIN-EXPERIMENT-VALUE-CORPUS-V1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "prior_weight"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "prior_weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "utilities"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "utilities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          }
        }
      }
    },
    "likelihoodRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "outcomes"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "outcomes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "cost_utility",
        "authorization",
        "evidence_state",
        "scenario_digest",
        "likelihoods"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "minLength": 1
        },
        "cost_utility": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "authorization": {
          "enum": [
            "permitted",
            "restricted",
            "unknown"
          ]
        },
        "evidence_state": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "scenario_digest": {
          "type": "string",
          "minLength": 1
        },
        "likelihoods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/likelihoodRow"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "selected_experiment_id",
        "reason_codes"
      ],
      "properties": {
        "status": {
          "enum": [
            "selected",
            "no_positive_evsi",
            "blocked",
            "indeterminate",
            "invalid_input"
          ]
        },
        "selected_experiment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "scenario_digest",
        "probability_scale",
        "states",
        "actions",
        "experiments",
        "expected"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_digest": {
          "type": "string",
          "minLength": 1
        },
        "probability_scale": {
          "const": 10000
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "experiments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/experiment"
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    }
  }
}
