{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-risk-cost-candidate-v0.1.schema.json",
  "title": "EGDDM D6.17.2 candidate cost view v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "decision_cutoff",
    "budget_micros",
    "cost_estimates",
    "execution_traces",
    "comparison_groups"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "budget_micros": {
      "type": "integer",
      "minimum": 1
    },
    "cost_estimates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "estimated_cost_upper_micros"
        ],
        "properties": {
          "option_id": {
            "type": "string"
          },
          "estimated_cost_upper_micros": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "execution_traces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trace_id",
          "acquisitions"
        ],
        "properties": {
          "trace_id": {
            "type": "string"
          },
          "acquisitions": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "option_id",
                "modes"
              ],
              "properties": {
                "option_id": {
                  "type": "string"
                },
                "modes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "enum": [
                      "cold",
                      "warm",
                      "retry"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "comparison_groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "comparison_id",
          "trace_ids"
        ],
        "properties": {
          "comparison_id": {
            "type": "string"
          },
          "trace_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
