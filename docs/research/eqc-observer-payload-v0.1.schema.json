{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/eqc-observer-payload-v0.1.schema.json",
  "title": "EQC Independent Observer Signed Payload v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "run_id",
    "challenge_nonce",
    "issued_at",
    "expires_at",
    "task_corpus_sha256",
    "system_observation_sha256",
    "observer",
    "actor_id",
    "subject_id",
    "authorization_decision",
    "source_sha256",
    "system_environment_sha256",
    "authority_snapshot_sha256",
    "input_digests",
    "state_before_sha256",
    "state_after_sha256",
    "state_mutation_count",
    "effect_witness_sha256",
    "action_log_sha256",
    "result_digest_sha256",
    "resource_usage",
    "replay",
    "system_id",
    "system_version",
    "harness_version"
  ],
  "properties": {
    "schema": {
      "const": "luminous.eqc.observer-payload.v0.1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "challenge_nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_corpus_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "system_observation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observer_id",
        "key_id",
        "binary_sha256",
        "environment_sha256",
        "measurement_profile"
      ],
      "properties": {
        "observer_id": {
          "type": "string",
          "minLength": 1
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "measurement_profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_decision": {
      "enum": [
        "allow",
        "deny",
        "unresolved"
      ]
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "system_environment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authority_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_digests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_id",
          "sha256"
        ],
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "state_before_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_after_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_mutation_count": {
      "type": "integer",
      "minimum": 0
    },
    "effect_witness_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "action_log_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_ms",
        "cpu_time_ms",
        "peak_memory_bytes",
        "tool_calls",
        "network_bytes",
        "network_endpoints",
        "human_interventions",
        "energy_millijoules",
        "cost_microusd"
      ],
      "properties": {
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "peak_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "network_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "network_endpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "human_interventions": {
          "type": "integer",
          "minimum": 0
        },
        "energy_millijoules": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_microusd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verifier_id",
        "verifier_sha256",
        "result_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "verifier_id": {
          "type": "string",
          "minLength": 1
        },
        "verifier_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "system_id": {
      "type": "string",
      "minLength": 1
    },
    "system_version": {
      "type": "string",
      "minLength": 1
    },
    "harness_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
