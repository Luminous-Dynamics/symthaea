{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-stochastic-kernel-candidate-v0.1.schema.json",
  "title": "EGDDM D6.17.2.2 stochastic joint-kernel candidate view v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "decision_cutoff",
    "options",
    "factors"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "factor_id"
        ],
        "properties": {
          "option_id": {
            "type": "string",
            "minLength": 1
          },
          "factor_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "factors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "factor_id",
          "likelihoods"
        ],
        "properties": {
          "factor_id": {
            "type": "string",
            "minLength": 1
          },
          "dependence_group": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "calibration_ref": {
            "type": "string",
            "minLength": 1
          },
          "likelihoods": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hypothesis_id",
                "outcomes"
              ],
              "properties": {
                "hypothesis_id": {
                  "type": "string",
                  "minLength": 1
                },
                "outcomes": {
                  "type": "object",
                  "minProperties": 2,
                  "maxProperties": 4,
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "lower_likelihood_bps",
                      "upper_likelihood_bps",
                      "nominal_likelihood_bps"
                    ],
                    "properties": {
                      "lower_likelihood_bps": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      },
                      "upper_likelihood_bps": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      },
                      "nominal_likelihood_bps": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
