{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Symthaea synthetic cyber hunt evaluator oracle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "profile",
    "seed",
    "event_count",
    "event_store_sha256",
    "labels",
    "expected_relations",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "cyber-hunt-truth-v1"
    },
    "scenario_id": {
      "enum": [
        "synthetic-identity-to-egress-v1",
        "synthetic-artifact-lifecycle-v1",
        "synthetic-cloud-data-movement-v1",
        "synthetic-cross-domain-trust-chain-v1",
        "synthetic-benign-only-control-v1"
      ]
    },
    "profile": {
      "enum": [
        "public-synthetic-smoke-v1",
        "public-benign-only-control-v1"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "event_count": {
      "type": "integer",
      "minimum": 64,
      "maximum": 250000
    },
    "event_store_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "labels": {
      "type": "array",
      "minItems": 64,
      "maxItems": 250000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "label",
          "rationale"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^evt-[0-9a-f]{16}$"
          },
          "label": {
            "enum": [
              "positive",
              "negative"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "expected_relations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_event_id",
          "to_event_id",
          "relation"
        ],
        "properties": {
          "from_event_id": {
            "type": "string",
            "pattern": "^evt-[0-9a-f]{16}$"
          },
          "to_event_id": {
            "type": "string",
            "pattern": "^evt-[0-9a-f]{16}$"
          },
          "relation": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 20
    }
  }
}
