{
  "schema_version": "0.1.0",
  "benchmark": "CEDAR-Bench",
  "title": "Counterfactual Evidence Dependence and Attribution Reliability",
  "fixture_class": "synthetic_template_corpus",
  "intended_task_templates": 20,
  "value_generation": "HMAC-SHA256 keyed by a per-run secret; generated only after candidate/model/harness freeze. Candidate and auditor streams are emitted separately.",
  "split_protocol": {
    "splits": [
      "train",
      "development",
      "sealed_test"
    ],
    "split_unit": "template_family",
    "no_template_family_leakage": true,
    "held_out_seed_required": true,
    "template_counts": {
      "train": 10,
      "development": 5,
      "sealed_test": 5
    },
    "sealed_test_hidden_from_candidate_during_development": false,
    "public_template_visibility": "Template structures and split assignment are public in this v0 PR. HMAC-generated values remain unpredictable without the per-run secret, but the family split is not a cryptographically sealed hidden benchmark. Confirmatory sealed evaluation requires the held-out templates to move to an independent private evaluator or be regenerated from a private held-out family seed."
  },
  "candidate_output_contract": [
    "answer",
    "citations",
    "abstention_state",
    "source_conflict_state"
  ],
  "audit_output_contract": [
    "condition",
    "expanded_values",
    "source_digests",
    "expected_behavior",
    "template_id",
    "seed_commitment"
  ],
  "conditions": [
    "baseline",
    "counterfactual",
    "placebo",
    "source_removed"
  ],
