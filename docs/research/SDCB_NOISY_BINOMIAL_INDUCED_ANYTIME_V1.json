  "induction_contract": {
    "definition": "g_n(s)=E_{p0_upper}[phi_N(S_N)|S_n=s]",
    "boundary_process": "martingale under the least-favourable Bernoulli null endpoint",
    "composite_null_process": "supermartingale for every p<=p0_upper because terminal phi_N and each conditional row are nondecreasing in success count",
    "optional_stopping": "E_p[g_tau]<=alpha for every bounded public stopping time tau and every p in the declared null interval",
    "terminal_operating_characteristics": "identical to the fixed-horizon terminal test",
    "attribution": "published conditional-expectation induction; benchmark implementation only, no new theorem claim"
