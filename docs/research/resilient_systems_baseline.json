      "B2_metamorphic_and_negative_controls": [
        "single independent source loss preserves declared service floor when residual capacity is sufficient",
        "common-mode source loss removes redundancy credit",
        "slower restoration does not reduce cumulative deficit",
        "more severe capacity loss does not improve cumulative deficit",
        "more nominal capacity does not worsen fulfillment",
        "unknown dependency and dependency cycle fail closed",
        "service input order does not change per-service results",
        "recovery beyond horizon remains unknown"
      ],
      "B3_observed_trace_calibration": "At least 3 observed outage/recovery traces; at least 1 held-out event/window; compare with a simple baseline; pre-register domain-specific error tolerances.",
      "B4_intervention_comparison": "Compare against a declared reference configuration; report Pareto trade-offs and test common-mode dependencies.",
      "B5_decision_grade": "Independent domain review, traceable data, uncertainty, representative validation, and domain-specific approval."
    },
