{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SDCB_FULL_COVARIANCE_GAUSSIAN_V1.schema.json",
  "title": "SDCB full-covariance Gaussian design input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "latent_ids", "prior_covariance", "science_index", "budget_units", "actions", "residual_covariance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "fixture_id": {"type": "string", "minLength": 1},
    "latent_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prior_covariance": {"$ref": "#/$defs/priorMatrix"},
    "science_index": {"type": "integer", "minimum": 0},
    "budget_units": {"type": "integer", "minimum": 0},
    "actions": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/action"}},
    "residual_covariance": {"$ref": "#/$defs/residualMatrix"}
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cost_units", "loadings"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "cost_units": {"type": "integer", "minimum": 1},
        "loadings": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "number"}}
      }
    },
    "priorMatrix": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "number"}}
    },
    "residualMatrix": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "number"}}
    }
  },
  "x-runtime-invariants": [
    "prior_covariance dimensions equal latent_ids length",
    "residual_covariance dimensions equal actions length",
    "every loading vector dimension equals latent_ids length",
    "both covariance matrices are symmetric positive-definite",
    "science_index is less than latent_ids length"
  ]
}
