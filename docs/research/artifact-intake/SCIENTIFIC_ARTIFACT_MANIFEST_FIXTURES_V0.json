  "cross_field_invariants": [
    "artifact_id must equal 'sha256:' + raw.sha256",
    "acquisition.receipt_content_sha256 must equal raw.sha256",
    "parse.usage.bytes_read must not exceed parse.limits.max_input_bytes",
    "parse.usage.elapsed_ms must not exceed parse.limits.max_elapsed_ms",
    "parse.usage.observations_emitted must equal parse.observations.length and not exceed parse.limits.max_observations",
    "For CSV_CELL, byte_start must be strictly less than byte_end and the span must resolve inside raw.byte_length",
    "A non-PARSED disposition is never sufficient for downstream claim support or decision use",
    "PARTIAL observations and derived payloads are diagnostic only and cannot be promoted into claim support or decision inputs.",
    "SHA-256(UTF-8(fixture_artifact_bytes_utf8)) must equal manifest.raw.sha256",
    "manifest.raw.byte_length must equal the UTF-8 byte length of fixture_artifact_bytes_utf8",
    "For PARSED and PARTIAL cases, SHA-256(UTF-8(fixture_derived_payload_utf8)) must equal parse.derived_payload_sha256",
    "Every CSV_CELL byte span must select exactly the declared raw_lexeme bytes from fixture_artifact_bytes_utf8",
    "The receipt_digest_mismatch case is intentionally the sole fixture where acquisition.receipt_content_sha256 differs from raw.sha256"
  ],
  "hash_contract": "fixture_artifact_bytes_utf8 and fixture_derived_payload_utf8 are UTF-8 byte strings; their SHA-256 digests must equal raw.sha256 and parse.derived_payload_sha256 respectively, except for the intentional receipt digest mismatch case."
}
