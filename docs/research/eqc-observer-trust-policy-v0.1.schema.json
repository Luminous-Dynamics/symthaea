{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/research/eqc-observer-trust-policy-v0.1.schema.json",
  "title": "EQC Observer Trust Policy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "trusted_observers"
  ],
  "properties": {
    "schema": {
      "const": "luminous.eqc.observer-trust-policy.v0.1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "trusted_observers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "observer_id",
          "public_key_hex",
          "workflow_identity",
          "measurement_profile",
          "active"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1
          },
          "observer_id": {
            "type": "string",
            "minLength": 1
          },
          "public_key_hex": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "workflow_identity": {
            "type": "string",
            "minLength": 1
          },
          "measurement_profile": {
            "const": "linux-cgroup-v2-netns-deny-v1"
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
