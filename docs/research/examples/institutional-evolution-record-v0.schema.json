{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Institutional Evolution Record v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mechanism_profile_hash",
    "seed_state_hash",
    "problem_schedule_hash",
    "mutation_grammar_hash",
    "agent_model_hash",
    "adoption_rule_hash",
    "random_seed",
    "oracle_version",
    "institution_lineage",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "institutional-evolution-record-v0"
    },
    "mechanism_profile_hash": {
      "type": "string",
      "minLength": 1
    },
    "seed_state_hash": {
      "type": "string",
      "minLength": 1
    },
    "problem_schedule_hash": {
      "type": "string",
      "minLength": 1
    },
    "mutation_grammar_hash": {
      "type": "string",
      "minLength": 1
    },
    "agent_model_hash": {
      "type": "string",
      "minLength": 1
    },
    "adoption_rule_hash": {
      "type": "string",
      "minLength": 1
    },
    "random_seed": {
      "type": "integer",
      "minimum": 0
    },
    "oracle_version": {
      "type": "string",
      "minLength": 1
    },
    "institution_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lineage_event"
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_qualification",
        "currentness",
        "political_legitimacy",
        "universal_optimality"
      ],
      "properties": {
        "historical_qualification": {
          "type": "boolean"
        },
        "currentness": {
          "type": "boolean"
        },
        "political_legitimacy": {
          "const": false
        },
        "universal_optimality": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "lineage_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_institution_hash",
        "candidate_institution_hash",
        "mutation_id",
        "rule_level",
        "transition",
        "semantic_delta"
      ],
      "properties": {
        "parent_institution_hash": {
          "type": "string",
          "minLength": 1
        },
        "candidate_institution_hash": {
          "type": "string",
          "minLength": 1
        },
        "mutation_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_level": {
          "type": "string",
          "enum": [
            "operational",
            "collective_choice",
            "constitutional",
            "meta_constitutional"
          ]
        },
        "authorizing_rule_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorizing_rule_level": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "operational",
            "collective_choice",
            "constitutional",
            "meta_constitutional",
            null
          ]
        },
        "transition": {
          "type": "string",
          "enum": [
            "proposed",
            "presented",
            "deliberated",
            "adopted",
            "implemented",
            "amended",
            "rejected",
            "repealed",
            "superseded"
          ]
        },
        "semantic_delta": {
          "type": "object",
          "additionalProperties": true
        },
        "proposer": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "trigger": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implementation_outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersession": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "dependentRequired": {
        "authorizing_rule_hash": [
          "authorizing_rule_level"
        ]
      }
    }
  }
}
