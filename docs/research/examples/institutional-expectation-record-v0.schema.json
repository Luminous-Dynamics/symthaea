{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Institutional Expectation Record v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expectation_id",
    "subject_id",
    "observation_time",
    "referenced_institution_hash",
    "referenced_institution_status",
    "expectation_rule_hash",
    "information_set",
    "representation",
    "belief_value",
    "belief_current"
  ],
  "properties": {
    "schema_version": {
      "const": "institutional-expectation-record-v0"
    },
    "expectation_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "observation_time": {
      "type": "integer",
      "minimum": 0
    },
    "referenced_institution_hash": {
      "type": "string",
      "minLength": 1
    },
    "expectation_rule_hash": {
      "type": "string",
      "minLength": 1
    },
    "information_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash",
        "as_of"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "representation": {
      "type": "string",
      "enum": [
        "probability",
        "interval",
        "ordinal",
        "categorical",
        "deterministic_forecast",
        "bounded_heuristic",
        "unknown"
      ]
    },
    "belief_value": {},
    "confidence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "signal_identity": {
      "type": [
        "string",
        "null"
      ]
    },
    "belief_current": {
      "type": "boolean"
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "referenced_institution_status": {
      "type": "string",
      "enum": [
        "current",
        "historical",
        "future",
        "unknown"
      ]
    }
  }
}
