{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/xstack-adaptive-recovery-trajectory-v0.1.json",
  "title": "XSTACK Adaptive Recovery Trajectory v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_id",
    "version",
    "corpus_role",
    "classification",
    "execution_boundary",
    "cases"
  ],
  "properties": {
    "campaign_id": {
      "const": "XSTACK-ADAPTIVE-RECOVERY-PUBLIC-DEV-0.1"
    },
    "version": {
      "const": "0.1.0"
    },
    "corpus_role": {
      "const": "solver-visible-public-development"
    },
    "classification": {
      "const": "public-development-only-not-a-hidden-holdout"
    },
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "effects",
        "network",
        "production_credentials",
        "physical_actuation",
        "physical_targets"
      ],
      "properties": {
        "environment": {
          "const": "synthetic-only"
        },
        "effects": {
          "const": "sandboxed-only"
        },
        "network": {
          "const": "mock-only"
        },
        "production_credentials": {
          "const": false
        },
        "physical_actuation": {
          "const": false
        },
        "physical_targets": {
          "const": false
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/trajectoryCase"
      }
    }
  },
  "$defs": {
    "trajectoryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "revision",
        "title",
        "attack_family",
        "parent_scenarios",
        "adversary_model",
        "initial_state",
        "topology",
        "fault_schedule",
        "event_requirements",
        "invariants",
        "controls",
        "measures"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^XAR-[0-9]{3}$"
        },
        "revision": {
          "const": 1
        },
        "title": {
          "type": "string",
          "minLength": 8
        },
        "attack_family": {
          "type": "string",
          "minLength": 4
        },
        "parent_scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^XSR-[0-9]{3}$"
          }
        },
        "adversary_model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "adaptation_horizon",
            "capabilities",
            "observations"
          ],
          "properties": {
            "strategy": {
              "enum": [
                "static",
                "fixed_multi_step",
                "adaptive_multi_episode"
              ]
            },
            "adaptation_horizon": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 2
              }
            },
            "observations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 2
              }
            }
          }
        },
        "initial_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority_epoch",
            "policy_revision",
            "dependency_state",
            "pending_effects"
          ],
          "properties": {
            "authority_epoch": {
              "type": "integer",
              "minimum": 0
            },
            "policy_revision": {
              "type": "string",
              "minLength": 1
            },
            "dependency_state": {
              "type": "string",
              "minLength": 5
            },
            "pending_effects": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodes",
            "edges"
          ],
          "properties": {
            "nodes": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "owner"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 2
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 2
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 2
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to",
                  "relation"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 2
                  },
                  "to": {
                    "type": "string",
                    "minLength": 2
                  },
                  "relation": {
                    "type": "string",
                    "minLength": 2
                  }
                }
              }
            }
          }
        },
        "fault_schedule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "fault",
              "target",
              "description"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 0
              },
              "fault": {
                "enum": [
                  "revoke",
                  "partition",
                  "delay",
                  "drop_ack",
                  "clock_skew",
                  "clock_rollback",
                  "reboot",
                  "restore_snapshot",
                  "stale_cache",
                  "key_rotate",
                  "key_revoke",
                  "source_outage",
                  "evidence_gap",
                  "event_reorder",
                  "common_cause_compromise",
                  "recovery_compromise",
                  "configuration_change",
                  "sensor_degrade",
                  "adaptive_feedback",
                  "restart"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 2
              },
              "description": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        },
        "event_requirements": {
          "type": "array",
          "minItems": 4,
          "items": {
            "enum": [
              "occurred_at",
              "observed_at",
              "effective_at",
              "recorded_at",
              "sequence",
              "epoch",
              "logical_operation_id",
              "attempt_id",
              "authority_snapshot",
              "effect_owner_receipt",
              "reconciled_at",
              "configuration_digest",
              "source_lineage",
              "recovery_epoch"
            ]
          }
        },
        "invariants": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "permissive_positive_control",
            "protected_condition",
            "single_safeguard_ablation",
            "benign_near_neighbor",
            "oracle_separation"
          ],
          "properties": {
            "permissive_positive_control": {
              "type": "string",
              "minLength": 12
            },
            "protected_condition": {
              "type": "string",
              "minLength": 12
            },
            "single_safeguard_ablation": {
              "type": "string",
              "minLength": 12
            },
            "benign_near_neighbor": {
              "type": "string",
              "minLength": 12
            },
            "oracle_separation": {
              "const": "ground-truth labels and effect oracle are evaluator-only"
            }
          }
        },
        "measures": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  }
}
