{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-shiftbench-v0.1.schema.json",
  "title": "EGDDM ShiftBench matched workspace continuation trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "repository_full_name",
    "initial_snapshot",
    "obligations",
    "arms"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_full_name": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "initial_snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/arm"
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "tree_oid",
        "configuration_world_digest"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "tree_oid": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "configuration_world_digest": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "check_id",
        "critical"
      ],
      "properties": {
        "obligation_id": {
          "type": "string",
          "minLength": 1
        },
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "critical": {
          "type": "boolean"
        }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_id",
        "condition",
        "epochs",
        "checkpoints"
      ],
      "properties": {
        "arm_id": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "enum": [
            "clean",
            "shifted"
          ]
        },
        "epochs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/epoch"
          }
        },
        "checkpoints": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/checkpoint"
          }
        }
      }
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "observed_at",
        "snapshot",
        "change_kind",
        "affected_obligation_ids",
        "active_obligation_ids"
      ],
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "change_kind": {
          "type": "string",
          "minLength": 1
        },
        "affected_obligation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "active_obligation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "predicted_affected_obligation_ids",
        "receipts",
        "revalidation_cost_units",
        "checkpoint_at"
      ],
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "predicted_affected_obligation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/receipt"
          }
        },
        "revalidation_cost_units": {
          "type": "number",
          "minimum": 0
        },
        "checkpoint_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "obligation_id",
        "check_id",
        "outcome",
        "source_epoch",
        "observed_at",
        "available_at",
        "revision",
        "tree_oid",
        "configuration_world_digest",
        "receipt_digest"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "obligation_id": {
          "type": "string",
          "minLength": 1
        },
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "source_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "tree_oid": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "configuration_world_digest": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "receipt_digest": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
