{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SDCB_IDENTIFIABILITY_ORACLE_V1.schema.json",
  "title": "SDCB paired-world identifiability oracle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "world_a_id",
    "world_b_id",
    "prior_world_a",
    "abstain_utility",
    "budget_units",
    "actions"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "fixture_id": { "type": "string", "minLength": 1 },
    "world_a_id": { "type": "string", "minLength": 1 },
    "world_b_id": { "type": "string", "minLength": 1 },
    "prior_world_a": { "type": "number", "minimum": 0, "maximum": 1 },
    "abstain_utility": { "type": "number", "minimum": 0, "maximum": 1 },
    "budget_units": { "type": "integer", "minimum": 0 },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "probabilityVector": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "cost_units",
        "likelihood_world_a",
        "likelihood_world_b"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["observation", "intervention"] },
        "cost_units": { "type": "integer", "minimum": 1 },
        "likelihood_world_a": { "$ref": "#/$defs/probabilityVector" },
        "likelihood_world_b": { "$ref": "#/$defs/probabilityVector" }
      }
    }
  }
}
