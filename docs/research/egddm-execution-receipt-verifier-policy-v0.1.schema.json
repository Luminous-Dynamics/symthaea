{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/egddm-execution-receipt-verifier-policy-v0.1.schema.json",
  "title": "EGDDM execution receipt expected-context policy v0.1",
  "description": "Independent verifier input. This policy is not inferred from or authorized by the receipt being checked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository_full_name",
    "revision_oid",
    "tree_oid",
    "configuration_world_digest",
    "subject_digests",
    "obligation_id",
    "check_id",
    "claim_kind",
    "workload_identity",
    "identity_provider",
    "authority_policy_digest"
  ],
  "properties": {
    "repository_full_name": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "revision_oid": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "tree_oid": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "configuration_world_digest": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "subject_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$"
      }
    },
    "obligation_id": {
      "type": "string",
      "minLength": 1
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_kind": {
      "enum": [
        "agent_observation",
        "runner_execution",
        "independent_regrade",
        "authority_decision"
      ]
    },
    "workload_identity": {
      "type": "string",
      "minLength": 1
    },
    "identity_provider": {
      "type": "string",
      "minLength": 1
    },
    "authority_policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "expected_outcome": {
      "enum": [
        "pass",
        "fail",
        "unknown",
        "not_run"
      ]
    }
  }
}
