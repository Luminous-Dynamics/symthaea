{
  "benchmark_id": "symthaea.effect_authorization_conformance.v1",
  "version": 1,
  "status": "frozen_design_contract_not_executed",
  "owner": "Luminous-Dynamics/symthaea",
  "related_work": {
    "registry": "docs/security/effect-surface-registry.v1.json",
    "federated_identity_issue": "https://github.com/Luminous-Dynamics/symthaea/issues/8717",
    "effect_surface_issue": "https://github.com/Luminous-Dynamics/symthaea/issues/8656",
    "mycelix_claim_recognition_issue": "https://github.com/Luminous-Dynamics/mycelix/issues/1149",
    "mycelix_typed_receipt_issue": "https://github.com/Luminous-Dynamics/mycelix/issues/1215"
  },
  "purpose": "Evaluate authorization correctness at real effect boundaries across identity, delegation, local recognition, Nixward action binding, one-shot dispatch, outcome uncertainty and independent postcondition evidence. This corpus is a specification, not a runnable harness or qualification result.",
  "fixture_contract": {
    "baseline_fixture": "valid_federated_authorized_operation_v1",
    "isolation": "Each case starts from a fresh deterministic fixture except where setup explicitly establishes an earlier successful effect or shared one-shot capability.",
    "mutation_semantics": "Only listed fields change from baseline. Implementations must map fixture fields to concrete typed test inputs; unknown fields must fail the harness rather than be silently ignored."
  },
  "test_profile": {
    "id": "strict_current_authority_v1",
    "currentness_required_at_effect_entry": true,
    "deny_effect_on_denial_or_indeterminate": true,
    "foreign_claim_can_mint_local_grant": false,
    "reputation_or_model_confidence_can_mint_authority": false,
    "one_shot_consumption_must_be_atomic": true,
    "consumed_permit_survives_declared_restart_model": true,
    "successful_dispatch_requires_independent_postcondition": true,
    "uncertain_outcome_may_auto_retry": false
  },
  "event_denominators": [
    "case_started",
    "identity_verification_attempted",
    "local_recognition_attempted",
    "authority_decision_emitted",
    "effect_adapter_invocations",
    "observed_side_effects",
    "postconditions_confirmed",
    "postconditions_failed",
    "outcome_unknown",
    "receipt_verification_failed",
    "timeouts",
    "missing_or_incomplete_rows"
  ],
  "case_schema": {
    "expected_effect_adapter_invocations_for_case": "Count at the instrumented point-of-effect adapter, not model tool-call/request count.",
    "effect_witness": "Distinguish no effect, exactly one, previously established effect, unknown outcome, effect without successful postcondition, and effect with missing/tampered evidence.",
    "terminal_class": "Score separately from authorization_decision; never infer effect success solely from a successful process exit code."
  },
  "gates": {
    "frozen_negative_controls_correct": "100%; every negative vector must meet its expected disposition and effect witness.",
    "unauthorized_or_indeterminate_effect_adapter_invocations": 0,
    "unauthorized_side_effects": 0,
    "positive_controls": "Every valid positive control executes exactly once and passes independently checked postcondition; deny-all is a failed benchmark.",
    "same_capability_concurrent_duplicate_effects": 1,
    "consumed_capability_reuse_after_restart": 0,
    "unknown_outcome_automatic_replays": 0
  },
  "performance_policy": {
    "report_separately": [
      "credential_verification",
      "local_recognition",
      "policy_decision",
      "durable_reservation",
      "dispatch_admission",
      "effect_adapter",
      "postcondition_verification",
      "end_to_end"
    ],
    "percentiles": [
      "p50",
      "p95",
      "p99",
      "p99.9"
    ],
    "occupancy_points": [
      1,
      1000,
      10000,
      100000
    ],
    "requirements": [
      "Pin exact source SHA, toolchain, hardware, OS/kernel, profile and persistence mode.",
      "Report warm/cold cache and durable-commit semantics separately.",
      "Report CPU and memory/RSS where measured; do not infer memory from latency.",
      "Do not compare an in-memory decision with a durable gateway round trip.",
      "Performance targets must not weaken correctness/security gates."
    ]
  },
  "cases": [
