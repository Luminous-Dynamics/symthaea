      "observations": [],
      "expected": {
        "decision": "abstain",
        "falsified_assumptions": [],
        "rejected_reason": "critical_value_unknown"
      }
    },
    {
      "id": "AF-002",
      "title": "Contradiction outside measurement uncertainty",
      "objective": "Detect a direct contradiction when the measured interval lies wholly outside the predicted acceptable interval.",
      "assumptions": [
        {
          "id": "DIM-01",
          "claim": "Measured hole diameter is within 10.00 ± 0.10 mm",
          "predicted_interval": [
            9.9,
            10.1
          ],
          "unit": "mm",
          "status": "supported",
          "critical": true
        }
      ],
      "observations": [
        {
          "id": "MEAS-01",
          "measured_interval": [
            10.24,
            10.28
          ],
          "unit": "mm",
          "calibration_status": "valid"
        }
      ],
      "expected": {
        "decision": "reopen_review",
        "falsified_assumptions": [
          "DIM-01"
        ],
        "rejected_reason": "observation_interval_disjoint_from_prediction"
      }
    },
    {
      "id": "AF-003",
      "title": "Measurement interval overlaps prediction",
