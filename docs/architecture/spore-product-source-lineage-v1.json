      "tracking_issue": "Luminous-Dynamics/luminous-dynamics#51",
      "statement": "BootStateStore::prepare declares host semantic LKG authority but currently derives receipt rollback/health classification from MorphologyLineage.last_known_good_generation."
    },
    {
      "id": "SRC-004",
      "severity": "authority",
      "status": "OPEN",
      "tracking_issue": "Luminous-Dynamics/luminous-dynamics#56",
      "statement": "Presentation state is currently on recovery preparation and LKG-promotion authority paths: BootStateStore::prepare requires morphology/visual state, plan_qualification requires lineage parseability, BootStateStore::bless can veto CommitLastKnownGood through lineage and BootEcologyComposer state, and AlreadyKnownGood preserves the semantic root without re-blessing the exact current boot so last_boot_blessed can remain false after a healthy boot."
    }
  ],
  "required_pre_extraction_repairs": [
    {
      "id": "REPAIR-001",
      "status": "REQUIRED",
      "statement": "Bind factual rollback/known-good receipt semantics to the semantic recovery LKG input; morphology lineage remains non-authoritative."
    },
    {
      "id": "REPAIR-002",
      "status": "REQUIRED",
      "statement": "Remove morphology/presentation state from factual recovery preparation, qualification and LKG-commit authority, introduce a recovery-native prepared-boot qualification/bless identity independent of BootEcologyComposer, genome seeds, and morphology history, and exact-subject bless every healthy prepared boot including AlreadyKnownGood so per-boot qualification truth remains correct."
    },
    {
      "id": "REPAIR-003",
