{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/hak/plan-conformance-v1.schema.json",
  "title": "HAK Plan Conformance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conformance_id",
    "subject",
    "plan",
    "receipt",
    "evaluator",
    "status",
    "checks",
    "negative_cases",
    "limitations",
    "conformance_digest"
  ],
  "properties": {
    "schema_version": {"const": "hak.plan-conformance.v1"},
    "conformance_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "base_commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "branch": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_ref", "plan_digest"],
      "properties": {
        "plan_ref": {"type": "string", "minLength": 1},
        "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "receipt_digest"],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "policy_ref", "model_assisted", "model_ref"],
      "properties": {
        "kind": {"enum": ["DeterministicPolicy", "HumanReviewer", "ReviewCommittee"]},
        "identity": {"type": "string", "minLength": 1},
        "policy_ref": {"type": "string", "minLength": 1},
        "model_assisted": {"type": "boolean"},
        "model_ref": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"model_assisted": {"const": true}}, "required": ["model_assisted"]},
          "then": {"properties": {"model_ref": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"model_ref": {"type": "null"}}}
        }
      ]
    },
    "status": {"enum": ["Satisfied", "NotSatisfied", "Indeterminate"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "evidence_refs"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["Passed", "Failed", "Missing"]},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "negative_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "status", "evidence_refs"],
        "properties": {
          "case": {"type": "string", "minLength": 1},
          "status": {"enum": ["Passed", "Failed", "Missing"]},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "conformance_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
