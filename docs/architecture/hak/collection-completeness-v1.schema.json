{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hak.collection-completeness.v1",
  "title": "HAK Collection Completeness v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","canonicalization_profile","digest_domain","source_collection","scope","pagination","counts","collection_status","reasons","collection_digest"],
  "properties": {
    "schema_version": {"const": "hak.collection-completeness.v1"},
    "canonicalization_profile": {
      "type":"object","additionalProperties":false,
      "required":["profile_id","artifact_ref","raw_sha256"],
      "properties": {
        "profile_id":{"const":"hak.canonical-json.v1"},
        "artifact_ref":{"const":"git:Luminous-Dynamics/symthaea@cf440ce4f813bb30a6b1948e5caac96feda10610:docs/architecture/hak/canonical-json-v1.profile.json"},
        "raw_sha256":{"const":"sha256:f76152db3cce567bb4d24ca46b5ed94d95db698daa8882a6fcdb38828d40e830"}
      }
    },
    "digest_domain":{"const":"hak.collection-completeness.v1"},
    "source_collection": {
      "type":"object","additionalProperties":false,
      "required":["provider","resource_kind","collection_ref","query_scope_ref"],
      "properties": {
        "provider":{"type":"string","minLength":1},
        "resource_kind":{"type":"string","minLength":1},
        "collection_ref":{"type":"string","minLength":1},
        "query_scope_ref":{"type":"string","minLength":1}
      }
    },
    "scope": {
      "type":"object","additionalProperties":false,
      "required":["population_extent","scope_ref","constraints"],
      "properties": {
        "population_extent":{"enum":["FullProviderPopulation","DefinedSubset","Unknown"]},
        "scope_ref":{"type":"string","minLength":1},
        "constraints": {
          "type":"object","additionalProperties":false,
          "required":["filtered","sampled","time_windowed","permission_limited"],
          "properties": {
            "filtered":{"type":"boolean"},
            "sampled":{"type":"boolean"},
            "time_windowed":{"type":"boolean"},
            "permission_limited":{"type":"boolean"}
          }
        }
      }
    },
    "pagination": {
      "type":"object","additionalProperties":false,
      "required":["model","contract_ref","pages_observed","page_size","exhaustion"],
      "properties": {
        "model":{"enum":["LinkHeader","PageNumber","Cursor","NonPaginated","Unknown"]},
        "contract_ref":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "pages_observed":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "page_size":{"anyOf":[{"type":"integer","minimum":1,"maximum":9007199254740991},{"type":"null"}]},
        "exhaustion": {
          "type":"object","additionalProperties":false,
          "required":["kind","evidence_refs"],
          "properties": {
            "kind":{"enum":["NoContinuationByProviderContract","CursorExhausted","NonPaginatedEndpoint","ProviderExplicitComplete","Unknown"]},
            "evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}
          }
        }
      }
    },
    "counts": {
      "type":"object","additionalProperties":false,
      "required":["retained_raw_count","retained_unique_count","duplicate_count","deduplication","provider_reported_total"],
      "properties": {
        "retained_raw_count":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "retained_unique_count":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "duplicate_count":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "deduplication": {
          "type":"object","additionalProperties":false,
          "required":["identity_ref","rule_ref"],
          "properties": {
            "identity_ref":{"type":"string","minLength":1},
            "rule_ref":{"type":"string","minLength":1}
          }
        },
        "provider_reported_total": {
          "anyOf":[
            {"type":"null"},
            {
              "type":"object","additionalProperties":false,
              "required":["value","scope_ref"],
              "properties": {
                "value":{"type":"integer","minimum":0,"maximum":9007199254740991},
                "scope_ref":{"type":"string","minLength":1}
              }
            }
          ]
        }
      }
    },
    "collection_status":{"enum":["DeclaredComplete","Partial","Unknown","Failed","NotApplicable"]},
    "reasons":{"type":"array","items":{"type":"string","minLength":1}},
    "collection_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
