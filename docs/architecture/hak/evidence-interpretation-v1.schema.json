{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/hak/evidence-interpretation-v1.schema.json",
  "title": "HAK Evidence Interpretation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "subject", "interpreter", "claims",
    "interpretation_digest"
  ],
  "properties": {
    "schema_version": {"const": "hak.evidence-interpretation.v1"},
    "record_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "required": ["repository", "commit_sha"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "interpreter": {
      "type": "object",
      "required": ["kind", "identity", "policy_ref", "model_assisted"],
      "properties": {
        "kind": {
          "enum": ["DeterministicPolicy", "HumanReviewer", "ReviewCommittee", "ModelAssistedReview"]
        },
        "identity": {"type": "string", "minLength": 1},
        "policy_ref": {"type": "string", "minLength": 1},
        "model_assisted": {"type": "boolean"}
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id", "status", "supported_tier", "supporting_conformance_ids",
          "supporting_receipt_ids", "limitations", "blockers"
        ],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["Qualified", "NotSatisfied", "InsufficientEvidence", "BlockedBy", "Revoked"]
          },
          "supported_tier": {
            "type": ["string", "null"],
            "enum": [null, "E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8"]
          },
          "supporting_conformance_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "supporting_receipt_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "revocation_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "interpretation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
