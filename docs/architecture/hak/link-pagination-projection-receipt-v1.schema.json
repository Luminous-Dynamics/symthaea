{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hak.link-pagination-projection-receipt.v1",
  "title": "HAK Link Pagination Projection Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_profile", "digest_domain", "envelope", "policy", "parser", "projection_scope", "projection_verification", "provider_authentication", "http_wire_verification", "link_header_field_count", "parsed_links", "next_relation", "exhaustion_verification", "receipt_digest"],
  "properties": {
    "schema_version": {"const": "hak.link-pagination-projection-receipt.v1"},
    "canonicalization_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "artifact_ref", "raw_sha256"],
      "properties": {
        "profile_id": {"const": "hak.canonical-json.v1"},
        "artifact_ref": {"const": "git:Luminous-Dynamics/symthaea@cf440ce4f813bb30a6b1948e5caac96feda10610:docs/architecture/hak/canonical-json-v1.profile.json"},
        "raw_sha256": {"const": "sha256:f76152db3cce567bb4d24ca46b5ed94d95db698daa8882a6fcdb38828d40e830"}
      }
    },
    "digest_domain": {"const": "hak.link-pagination-projection-receipt.v1"},
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope_digest", "response_ref", "headers_digest"],
      "properties": {
        "envelope_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "response_ref": {"type": "string", "minLength": 1},
        "headers_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "policy_digest", "artifact_ref"],
      "properties": {
        "policy_id": {"const": "hak019a-github-rest-link-pagination-v1"},
        "policy_digest": {"const": "sha256:8ab07e7c06f15aa75b71da7c7f9713d897763691f356e3b473781e2c4f0fce2e"},
        "artifact_ref": {"type": "string", "pattern": "^git:[^@]+@[0-9a-f]{40}:.+$"}
      }
    },
    "parser": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "artifact_ref", "content_digest"],
      "properties": {
        "id": {"const": "hak.rfc8288-link-pagination.strict"},
        "version": {"const": 1},
        "artifact_ref": {"type": "string", "pattern": "^git:[^@]+@[0-9a-f]{40}:.+$"},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "projection_scope": {"const": "RetainedLinkHeaderFieldValuesOnly"},
    "projection_verification": {"const": "VerifiedAgainstRetainedEnvelope"},
    "provider_authentication": {"const": "NotEstablished"},
    "http_wire_verification": {"const": "NotEstablished"},
    "link_header_field_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "parsed_links": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target_ref", "target", "relations"],
        "properties": {
          "target_ref": {"type": "string", "minLength": 1},
          "target": {"type": "string", "pattern": "^https://[^\\s]+$"},
          "relations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "next_relation": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "target_ref", "target"],
          "properties": {
            "state": {"const": "Present"},
            "target_ref": {"type": "string", "minLength": 1},
            "target": {"type": "string", "pattern": "^https://[^\\s]+$"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "target_ref", "target"],
          "properties": {
            "state": {"const": "Absent"},
            "target_ref": {"type": "null"},
            "target": {"type": "null"}
          }
        }
      ]
    },
    "exhaustion_verification": {"const": "NotEstablished"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
