# Luminous Nix Pipeline — NixOS Configuration Intelligence
# Professional Tier 1 Diagram

direction: down

title: {
  label: Luminous Nix — Causal NixOS Intelligence Pipeline
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

# ═══════════════════════════════════════════
# INPUT
# ═══════════════════════════════════════════
input: NixOS Configuration Request {
  shape: parallelogram
  style.fill: "#374151"
  style.font-color: "#e5e7eb"
  label: Nix expression / system query / package request
}

# ═══════════════════════════════════════════
# STRATEGY SELECTION
# ═══════════════════════════════════════════
strategy: Strategy Selection {
  style.fill: "#3a1e3a"
  style.stroke: "#a855f7"
  style.font-color: "#d8b4fe"
  style.border-radius: 8

  confident: "Confident\nHigh causal certainty\nDirect execution" {
    style.fill: "#581c87"
    style.font-color: "#e9d5ff"
    style.stroke: "#a855f7"
  }
  curious: "Curious\nLow certainty\nExploration mode" {
    style.fill: "#581c87"
    style.font-color: "#e9d5ff"
  }

  confident -> curious: "surprise > 0.5\ndowngrade" {
    style.stroke: "#ef4444"
    style.stroke-dash: 3
  }
}

# ═══════════════════════════════════════════
# CAUSAL GRAPH
# ═══════════════════════════════════════════
causal: NixCausalGraph {
  style.fill: "#1a1a2e"
  style.stroke: "#818cf8"
  style.font-color: "#c7d2fe"
  style.border-radius: 12

  bootstrap: "Bootstrap\n~210 NixOS Patterns" {
    style.fill: "#312e81"
    style.font-color: "#c7d2fe"
    label: |md
      Pre-loaded causal relationships:
      services -> networking
      hardware -> kernel modules
      users -> groups -> permissions
    |
  }

  learn: "Hebbian Learning\n(every cycle)" {
    style.fill: "#312e81"
    style.font-color: "#c7d2fe"
    label: |md
      Strengthen edges: co-occurring changes
      Weaken edges: contradicted predictions
      Edge weight decay over time
    |
  }

  discover: "Structure Discovery\n(every 50 cycles)" {
    style.fill: "#312e81"
    style.font-color: "#a5b4fc"
    style.stroke: "#818cf8"
    label: |md
      Detect new causal edges
      Prune weak connections
      Checkpoint save after discovery
    |
  }

  checkpoint: "Checkpoint\nSave / Load" {
    style.fill: "#312e81"
    style.font-color: "#c7d2fe"
    label: |md
      Auto-saves after discovery
      Loads on startup
      Preserves learned structure
    |
  }

  bootstrap -> learn -> discover -> checkpoint
}

# ═══════════════════════════════════════════
# PIPELINE EXECUTION
# ═══════════════════════════════════════════
execution: Pipeline Execution {
  style.fill: "#1e3a5f"
  style.stroke: "#3b82f6"
  style.font-color: "#93c5fd"
  style.border-radius: 8

  parse: "Parse\nNix expression analysis" {style.fill: "#1e40af"; style.font-color: "#93c5fd"}
  plan: "Plan\nCausal DAG traversal" {style.fill: "#1e40af"; style.font-color: "#93c5fd"}
  execute: "Execute\nNix build / eval" {style.fill: "#1e40af"; style.font-color: "#93c5fd"}
  observe: "Observe\nOutcome verification" {style.fill: "#1e40af"; style.font-color: "#93c5fd"}

  parse -> plan -> execute -> observe
}

# ═══════════════════════════════════════════
# SURPRISE FEEDBACK
# ═══════════════════════════════════════════
surprise: Causal Surprise Feedback {
  style.fill: "#3a1e1e"
  style.stroke: "#f87171"
  style.font-color: "#fecaca"
  style.border-radius: 8

  compute: "Compute Surprise\npredicted vs observed outcomes" {
    style.fill: "#7f1d1d"
    style.font-color: "#fca5a5"
  }
  threshold: "Surprise > 0.5?\nTrigger strategy downgrade" {
    shape: diamond
    style.fill: "#7f1d1d"
    style.font-color: "#fca5a5"
  }

  compute -> threshold
}

# ═══════════════════════════════════════════
# OBSERVABILITY
# ═══════════════════════════════════════════
observability: Observability {
  style.fill: "#1e3a2e"
  style.stroke: "#22c55e"
  style.font-color: "#86efac"
  style.border-radius: 8

  metrics: "9 Prometheus Metrics\n/metrics endpoint" {
    style.fill: "#14532d"
    style.font-color: "#86efac"
    label: |md
      nix_causal_edge_count
      nix_causal_surprise
      phase timers (4 phases)
      gauge + counter updates
    |
  }
  tracing: "JSON Tracing\nStructured logs" {style.fill: "#14532d"; style.font-color: "#86efac"}
  timer: "PhaseTimer\n4-phase timing" {style.fill: "#14532d"; style.font-color: "#86efac"}
}

# ═══════════════════════════════════════════
# SYMTHAEA INTEGRATION
# ═══════════════════════════════════════════
symthaea: Symthaea Integration {
  shape: hexagon
  style.fill: "#4a1942"
  style.stroke: "#c084fc"
  style.font-color: "#e9d5ff"
  label: |md
    NixPipelineHook
    (feature: nixward)
    Wired into ConsciousPipeline
  |
}

# ═══════════════════════════════════════════
# FLOW
# ═══════════════════════════════════════════
input -> strategy {style.stroke: "#a855f7"}
strategy -> execution.parse {style.stroke: "#3b82f6"; style.stroke-width: 2}
causal -> execution.plan: "DAG edges\nfor planning" {style.stroke: "#818cf8"; style.stroke-width: 2}
execution.observe -> surprise.compute {style.stroke: "#f87171"}
surprise.threshold -> strategy.confident: "downgrade\nto Curious" {
  style.stroke: "#ef4444"
  style.stroke-dash: 5
}
surprise.threshold -> causal.learn: "update\nedge weights" {
  style.stroke: "#818cf8"
  style.stroke-dash: 3
}
execution -> observability {style.stroke: "#22c55e"; style.stroke-dash: 3}
symthaea -> execution: "pipeline hook" {style.stroke: "#c084fc"; style.stroke-width: 2}
surprise -> symthaea: "causal surprise\nto reasoning" {style.stroke: "#c084fc"; style.stroke-dash: 3}
