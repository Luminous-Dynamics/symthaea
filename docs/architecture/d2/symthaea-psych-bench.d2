# Symthaea Psych-Bench — Cognitive Benchmark Suite
# Professional Tier 1 Diagram

direction: down

title: {
  label: Psych-Bench — 16-Domain Cognitive Benchmark Suite
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

# ═══════════════════════════════════════════
# BENCHMARK HARNESS
# ═══════════════════════════════════════════
harness: Benchmark Harness {
  style.fill: "#1a1a2e"
  style.stroke: "#818cf8"
  style.font-color: "#c7d2fe"
  style.border-radius: 8

  trait_def: "PsychBenchmark trait\nrun(config) -> BenchmarkResult\nrun_ablation(configs) -> Results\nprovenance() -> BenchmarkProvenance" {
    style.fill: "#312e81"
    style.font-color: "#c7d2fe"
    style.stroke: "#818cf8"
  }

  config: "BenchmarkConfig\nHDC dim | trials | WM capacity\nseed | social/FEP flags\ntime pressure | difficulty" {
    style.fill: "#312e81"
    style.font-color: "#c7d2fe"
  }

  adapter: "StimulusAdapter\nspatial | semantic | scenario\nsequence | reward encoders\n-> ContinuousHV" {
    style.fill: "#312e81"
    style.font-color: "#c7d2fe"
  }
}

# ═══════════════════════════════════════════
# 16 BENCHMARK DOMAINS
# ═══════════════════════════════════════════
domains: 16 Cognitive Domains (80+ benchmarks) {
  style.fill: "#0f0f1e"
  style.stroke: "#6366f1"
  style.font-color: "#e0e0e0"
  style.border-radius: 12

  exec: "Executive (7)\nStroop, Flanker, WCST\nIowa, Ravens, Tower, Dual" {style.fill: "#7f1d1d"; style.font-color: "#fca5a5"}
  wm: "Working Memory (6)\nN-back, Change Detection\nSerial Recall, Binding" {style.fill: "#7f1d1d"; style.font-color: "#fca5a5"}
  inhib: "Inhibition (2)\nGo/No-Go, Stop Signal" {style.fill: "#7f1d1d"; style.font-color: "#fca5a5"}

  attn: "Attention (2)\nAttentional Blink\nVisual Search" {style.fill: "#78350f"; style.font-color: "#fde68a"}
  sustained: "Sustained Attn (3)\nSART, PVT, CPT" {style.fill: "#78350f"; style.font-color: "#fde68a"}

  memory: "Memory Agent (5)\nRetrieval, Long-range\nConflict, Prospective" {style.fill: "#14532d"; style.font-color: "#86efac"}
  reason: "Reasoning (11)\nFluid, Analogy, ARC\nAbductive, Chain, RSA" {style.fill: "#14532d"; style.font-color: "#86efac"}

  social: "Social (7)\nRME, Ultimatum, PD\nPublic Goods, MACH" {style.fill: "#1e3a5f"; style.font-color: "#93c5fd"}
  tom: "Theory of Mind (5)\nFalse Belief, Faux-pas\nPersuasion, Hinting" {style.fill: "#1e3a5f"; style.font-color: "#93c5fd"}

  affect: "Affect (3)\nValence, Mood-congruent\nEmotional Stroop" {style.fill: "#4a1942"; style.font-color: "#e9d5ff"}
  creative: "Creativity (2)\nRAT, Alternate Uses" {style.fill: "#4a1942"; style.font-color: "#e9d5ff"}

  language: "Language (4)\nGarden Path, Semantic\nLexical, Priming" {style.fill: "#831843"; style.font-color: "#f9a8d4"}
  motor: "Motor (3)\nSRTT, Fitts Law\nBimanual" {style.fill: "#831843"; style.font-color: "#f9a8d4"}

  cogbench: "CogBench/FEP (8)\nBandits, Reversal\nBART, Two-step" {style.fill: "#065f46"; style.font-color: "#6ee7b7"}
  neuromod: "Neuromod (11)\nReward, Yerkes-Dodson\nPharmacological Ablation" {style.fill: "#065f46"; style.font-color: "#6ee7b7"}
  butlin: "Butlin (1)\n14 consciousness indicators\nfrom 6 theories" {style.fill: "#065f46"; style.font-color: "#6ee7b7"}
}

# ═══════════════════════════════════════════
# RESULTS PIPELINE
# ═══════════════════════════════════════════
results: Results Pipeline {
  style.fill: "#1a1a2e"
  style.stroke: "#818cf8"
  style.font-color: "#c7d2fe"
  style.border-radius: 8

  metrics: "BenchmarkResult\nmetrics: BTreeMap<String, MetricValue>\nMetricValue: mean, std_dev, n, CI" {
    style.fill: "#312e81"
    style.font-color: "#c7d2fe"
  }

  rt: "RtSummary\nEx-Gaussian fitting (mu, sigma, tau)\nReaction time analysis" {
    style.fill: "#312e81"
    style.font-color: "#c7d2fe"
  }

  zscore: "Z-Score Normalization\nPerformance vs human baselines\nPer-domain normative scores" {
    style.fill: "#312e81"
    style.font-color: "#a5b4fc"
    style.stroke: "#818cf8"
  }
}

# ═══════════════════════════════════════════
# NEUROMOD PROFILES
# ═══════════════════════════════════════════
profiles: 5 Neuromodulator Profiles {
  style.fill: "#3a1e3a"
  style.stroke: "#a855f7"
  style.font-color: "#d8b4fe"
  style.border-radius: 8

  balanced: "Balanced\n(baseline)" {style.fill: "#581c87"; style.font-color: "#e9d5ff"}
  high_da: "High-DA\n(reward-sensitive)" {style.fill: "#581c87"; style.font-color: "#e9d5ff"}
  high_ne: "High-NE\n(alert/anxious)" {style.fill: "#581c87"; style.font-color: "#e9d5ff"}
  high_5ht: "High-5HT\n(mood-stable)" {style.fill: "#581c87"; style.font-color: "#e9d5ff"}
  high_ach: "High-ACh\n(attention-focused)" {style.fill: "#581c87"; style.font-color: "#e9d5ff"}
}

# ═══════════════════════════════════════════
# CALIBRATION BRIDGE
# ═══════════════════════════════════════════
calibration: Neuromod Calibration Bridge {
  style.fill: "#1e3a2e"
  style.stroke: "#22c55e"
  style.font-color: "#86efac"
  style.border-radius: 8

  correlation: "NeuromodCorrelationMatrix\nBenchmark x Profile -> performance\nDouble dissociation detection" {
    style.fill: "#14532d"
    style.font-color: "#86efac"
    style.stroke: "#22c55e"
  }

  receptor: "Receptor Sensitivity Adjustment\nz-scores -> transmitter sensitivity\nApplied on sleep->wake or always-awake" {
    style.fill: "#14532d"
    style.font-color: "#86efac"
  }
}

# ═══════════════════════════════════════════
# DOWNSTREAM: NEUROMOD BATH
# ═══════════════════════════════════════════
bath: Neuromodulator Bath {
  shape: cylinder
  style.fill: "#4a1942"
  style.font-color: "#f0abfc"
  label: "9 transmitters\nreceptor_sensitivity tuned\nby calibration bridge"
}

# ═══════════════════════════════════════════
# FLOW
# ═══════════════════════════════════════════
harness.trait_def -> domains {style.stroke: "#6366f1"; style.stroke-width: 2}
harness.config -> domains {style.stroke: "#818cf8"; style.stroke-dash: 3}
harness.adapter -> domains {style.stroke: "#818cf8"; style.stroke-dash: 3}

domains -> results.metrics {style.stroke: "#818cf8"; style.stroke-width: 2}
results.metrics -> results.rt -> results.zscore

profiles -> domains: "run each profile\nacross all benchmarks" {style.stroke: "#a855f7"; style.stroke-width: 2}

results.zscore -> calibration.correlation {style.stroke: "#22c55e"; style.stroke-width: 2}
profiles -> calibration.correlation: "profile x benchmark\nperformance matrix" {style.stroke: "#a855f7"; style.stroke-dash: 3}
calibration.correlation -> calibration.receptor {style.stroke: "#22c55e"}
calibration.receptor -> bath {style.stroke: "#22c55e"; style.stroke-width: 2}
