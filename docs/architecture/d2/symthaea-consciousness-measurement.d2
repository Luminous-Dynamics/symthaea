# Symthaea Consciousness Measurement Pipeline
# Professional Tier 1 Diagram

direction: down

title: {
  label: Consciousness Measurement Pipeline
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

# ═══════════════════════════════════════════
# RAW SIGNALS (from Dynamics Phase)
# ═══════════════════════════════════════════
signals: Raw Cognitive Signals {
  style.fill: "#1a1a2e"
  style.stroke: "#818cf8"
  style.font-color: "#c7d2fe"
  style.border-radius: 8

  cfc_state: CfC Hidden State {style.fill: "#312e81"; style.font-color: "#c7d2fe"}
  prediction_error: Prediction Error {style.fill: "#312e81"; style.font-color: "#c7d2fe"}
  binding: Phenomenal Binding\nConfidence {style.fill: "#312e81"; style.font-color: "#c7d2fe"}
  attention: GWT Coalition\nSize & Broadcast {style.fill: "#312e81"; style.font-color: "#c7d2fe"}
  neuromod: Neuromodulator\nBath State {style.fill: "#312e81"; style.font-color: "#c7d2fe"}
}

# ═══════════════════════════════════════════
# PRIMITIVE CONSCIOUSNESS (fast, every cycle)
# ═══════════════════════════════════════════
primitives: Primitive Consciousness System {
  style.fill: "#3a1e1e"
  style.stroke: "#f87171"
  style.font-color: "#fecaca"
  style.border-radius: 8

  psi: "Primitive Psi Scoring\n9 tiers: Reflex -> Executive" {
    style.fill: "#7f1d1d"
    style.font-color: "#fca5a5"
  }
  temporal: "Temporal Causal Chains\nContinuity detection" {
    style.fill: "#7f1d1d"
    style.font-color: "#fca5a5"
  }
  lattice: "Lattice Coherence\nCross-module agreement" {
    style.fill: "#7f1d1d"
    style.font-color: "#fca5a5"
  }
  compositionality: "Compositionality\nFeature binding verification" {
    style.fill: "#7f1d1d"
    style.font-color: "#fca5a5"
  }
}

# ═══════════════════════════════════════════
# IIT PHI COMPUTATION (interval 97)
# ═══════════════════════════════════════════
phi: IIT Phi Computation {
  style.fill: "#1e3a5f"
  style.stroke: "#3b82f6"
  style.font-color: "#93c5fd"
  style.border-radius: 8

  mip: SpectralMIPFinder {
    style.fill: "#1e40af"
    style.stroke: "#3b82f6"
    style.font-color: "#93c5fd"
    label: "Minimum Information Partition\nFiedler ordering (spectral shortcut)\nr = 0.99 vs exhaustive MIP\nInterval: every 97 cycles"
  }

  multimodal: MultiModalIntegrator {
    style.fill: "#1e40af"
    style.font-color: "#93c5fd"
    label: "Cross-Modal Binding Phi\nDamasio convergence zones\nInterval: every 13 cycles"
  }

  hierarchical: Hierarchical LTC Phi {
    style.fill: "#1e40af"
    style.font-color: "#93c5fd"
    label: "Multi-Scale Integration\nMicro / Meso / Macro tiers\nInterval: every 11 cycles"
  }
}

# ═══════════════════════════════════════════
# CONSCIOUSNESS MONITORS (Normal/Critical only)
# ═══════════════════════════════════════════
