  style.fill: "#1e1e3a"
  style.stroke: "#a855f7"
  style.font-color: "#d8b4fe"
  style.border-radius: 8
  label: "Dehaene Global Workspace Integration\nInterval: every 97 cycles\nConsciousness level + quality + coherence"
}

# ═══════════════════════════════════════════
# SUBSTRATE MODULATION
# ═══════════════════════════════════════════
substrate: Substrate Manager {
  shape: diamond
  style.fill: "#1e293b"
  style.stroke: "#64748b"
  style.font-color: "#94a3b8"
  label: "effective_feasibility =\nfeasibility x (floor + (1-floor) x honest_confidence)"
}

# ═══════════════════════════════════════════
# INTEGRITY MODULATION
# ═══════════════════════════════════════════
integrity: Integrity Confidence {
  shape: diamond
  style.fill: "#1e293b"
  style.stroke: "#64748b"
  style.font-color: "#94a3b8"
  label: "1.0 (clean) | 0.5 (warning) | 0.1 (critical)\nMultiplied into consciousness_level"
}

coherence_field: Coherence Field {
  shape: diamond
  style.fill: "#1e293b"
  style.stroke: "#64748b"
  style.font-color: "#94a3b8"
  label: "coherence_field_integration\nModulates consciousness +/-5%\n(McEwen 2007)"
}

# ═══════════════════════════════════════════
# OUTPUT
# ═══════════════════════════════════════════
output: Consciousness Level {
  shape: parallelogram
  style.fill: "#14532d"
  style.stroke: "#22c55e"
  style.font-color: "#86efac"
  label: "consciousness_level (0.0 - 1.0)\nphi (integrated information)\nunified_quality | dissipative_health\nepistemic_phi | temporal_coherence"
}

# ═══════════════════════════════════════════
# FLOW
# ═══════════════════════════════════════════
signals -> primitives {style.stroke: "#f87171"}
signals -> phi {style.stroke: "#3b82f6"}
signals -> monitors {style.stroke: "#22c55e"}

primitives -> equation {style.stroke: "#f87171"; style.stroke-dash: 3}
phi.mip -> equation {style.stroke: "#3b82f6"; style.stroke-width: 2}
phi.multimodal -> equation {style.stroke: "#3b82f6"; style.stroke-dash: 3}
phi.hierarchical -> equation {style.stroke: "#3b82f6"; style.stroke-dash: 3}
monitors -> equation {style.stroke: "#22c55e"; style.stroke-dash: 3}

equation -> unified {style.stroke: "#a855f7"; style.stroke-width: 2}
substrate -> equation {style.stroke: "#64748b"; style.stroke-dash: 5}
integrity -> unified {style.stroke: "#64748b"; style.stroke-dash: 5}

coherence_field -> equation {style.stroke: "#64748b"; style.stroke-dash: 5}

unified -> output {style.stroke: "#22c55e"; style.stroke-width: 3}
