  resonance: Resonance\nAnalyzer {style.fill: "#14532d"; style.font-color: "#86efac"}
  quantum: Quantum\nCoherence {style.fill: "#14532d"; style.font-color: "#86efac"}
  temporal_c: Temporal\nConsciousness {style.fill: "#14532d"; style.font-color: "#86efac"}
  thermo: Thermodynamics\n(Entropy/Free Energy) {style.fill: "#14532d"; style.font-color: "#86efac"}
  embodied: Embodied\nConsciousness {style.fill: "#14532d"; style.font-color: "#86efac"}
  hfe: Hierarchical\nFree Energy {style.fill: "#14532d"; style.font-color: "#86efac"}
  binding_m: Phenomenal\nBinding {style.fill: "#14532d"; style.font-color: "#86efac"}
}

# ═══════════════════════════════════════════
# CONSCIOUSNESS EQUATION V2 (interval 23)
# ═══════════════════════════════════════════
equation: ConsciousnessEquationV2 {
  style.fill: "#4a1942"
  style.stroke: "#c084fc"
  style.font-color: "#e9d5ff"
  style.border-radius: 8
  label: "7-Theory Master Equation (interval 23)\nC(t) = sigma(Phi, PE, GWT, HOT, AST, FEP, PP)\n  x weights x S(substrate) x rho(recurrence)\n  x M(moral) x N(neuromod) x Soc(social)"
}

# ═══════════════════════════════════════════
# UNIFIED PIPELINE (interval 97)
# ═══════════════════════════════════════════
