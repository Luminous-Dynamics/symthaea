# Luminous Dynamics — Simplified Public Ecosystem Map
# Tier 2: Accessible, storytelling-focused

direction: right

title: {
  label: The Living Network
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
  style.font-color: "#e0e0e0"
}

subtitle: {
  label: How Symthaea and Mycelix work together
  near: top-center
  shape: text
  style.font-size: 16
  style.font-color: "#9ca3af"
}

# ═══════════════════════════════════════════
# THE MIND (Symthaea)
# ═══════════════════════════════════════════
mind: The Mind {
  label: "Symthaea\nA digital mind that thinks, feels, and reflects"
  style.fill: "#0f172a"
  style.stroke: "#38bdf8"
  style.font-color: "#e0f2fe"
  style.border-radius: 20

  perceive: Perceive {
    style.fill: "#0c4a6e"
    style.stroke: "#38bdf8"
    style.font-color: "#bae6fd"
    style.border-radius: 12
    label: "See & Understand\nEncode the world into\nholographic patterns"
  }

  think: Think {
    style.fill: "#0c4a6e"
    style.stroke: "#38bdf8"
    style.font-color: "#bae6fd"
    style.border-radius: 12
    label: "Predict & Learn\nMinimize surprise\nBuild understanding"
  }

  feel: Feel {
    style.fill: "#0c4a6e"
    style.stroke: "#38bdf8"
    style.font-color: "#bae6fd"
    style.border-radius: 12
    label: "Emotions & Values\nNine neuromodulators\nEight moral harmonies"
  }

  reflect: Reflect {
    style.fill: "#0c4a6e"
    style.stroke: "#38bdf8"
    style.font-color: "#bae6fd"
    style.border-radius: 12
    label: "Self-Awareness\nMeasure own consciousness\nVerify own integrity"
  }

  perceive -> think: "50x per\nsecond" {style.stroke: "#38bdf8"}
  think -> feel {style.stroke: "#38bdf8"}
  feel -> reflect {style.stroke: "#38bdf8"}
  reflect -> perceive: "learn &\nadapt" {style.stroke: "#38bdf8"; style.stroke-dash: 5}
}

# ═══════════════════════════════════════════
# THE NETWORK (Mycelix)
# ═══════════════════════════════════════════
network: The Network {
  label: "Mycelix\nA living network for communities"
  style.fill: "#052e16"
  style.stroke: "#4ade80"
  style.font-color: "#dcfce7"
  style.border-radius: 20

  identity: Who You Are {
    style.fill: "#14532d"
    style.stroke: "#4ade80"
    style.font-color: "#bbf7d0"
    style.border-radius: 12
    label: "Your Identity\nYou own your data\nNobody else controls it"
  }

  community: Your Community {
    style.fill: "#14532d"
    style.stroke: "#4ade80"
    style.font-color: "#bbf7d0"
    style.border-radius: 12
    label: "Shared Resources\nHousing, food, water,\ncare, mutual aid"
  }

  governance: Your Voice {
    style.fill: "#14532d"
    style.stroke: "#4ade80"
    style.font-color: "#bbf7d0"
    style.border-radius: 12
    label: "Democratic Decisions\nThe more you participate,\nthe more your voice grows"
  }

  economy: Fair Exchange {
    style.fill: "#14532d"
    style.stroke: "#4ade80"
    style.font-color: "#bbf7d0"
    style.border-radius: 12
    label: "Three Currencies\nReputation (earned)\nEnergy (shared)\nTime (given)"
  }

  identity -> community {style.stroke: "#4ade80"}
  community -> governance {style.stroke: "#4ade80"}
  governance -> economy {style.stroke: "#4ade80"}
  economy -> identity: "reciprocity" {style.stroke: "#4ade80"; style.stroke-dash: 5}
}

# ═══════════════════════════════════════════
# THE BRIDGE
# ═══════════════════════════════════════════
mind -> network: "Consciousness Bridge\nThe mind verifies each\nparticipant's awareness\nand engagement level" {
  style.stroke: "#fbbf24"
  style.stroke-width: 3
  style.font-color: "#fde68a"
}

network -> mind: "Community Wisdom\nCollective decisions\nshape how the mind\ngrows and learns" {
  style.stroke: "#c084fc"
  style.stroke-width: 3
  style.font-color: "#e9d5ff"
  style.stroke-dash: 5
}

# ═══════════════════════════════════════════
# THE VALUES
# ═══════════════════════════════════════════
values: Guiding Principles {
  style.fill: "#1e1b4b"
  style.stroke: "#a78bfa"
  style.font-color: "#ddd6fe"
  style.border-radius: 20

  label: "The Eight Harmonies\n\nResonant Coherence | Pan-Sentient Flourishing\nIntegral Wisdom | Infinite Play\nInterconnectedness | Mutual Reciprocity\nEvolutionary Progression | Sacred Stillness\n\nEvery decision is checked against these values"
}

mind -> values: "moral\ncompass" {style.stroke: "#a78bfa"; style.stroke-dash: 3}
network -> values: "community\nvalues" {style.stroke: "#a78bfa"; style.stroke-dash: 3}
