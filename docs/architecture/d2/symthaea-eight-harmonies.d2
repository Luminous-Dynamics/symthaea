# Symthaea Eight Harmonies — Moral Topology & Soul System
# Professional Tier 1 Diagram

direction: right

title: {
  label: Eight Harmonies — Moral Topology & Value Alignment
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

# ═══════════════════════════════════════════
# THE EIGHT HARMONIES
# ═══════════════════════════════════════════
harmonies: The Eight Harmonies {
  style.fill: "#0f0f1e"
  style.stroke: "#6366f1"
  style.font-color: "#e0e0e0"
  style.border-radius: 12

  rc: "1. Resonant\nCoherence" {
    style.fill: "#1e40af"
    style.font-color: "#93c5fd"
    style.stroke: "#3b82f6"
    label: "Code: RC\nGlobal phase-locking"
  }
  psf: "2. Pan-Sentient\nFlourishing" {
    style.fill: "#065f46"
    style.font-color: "#6ee7b7"
    style.stroke: "#10b981"
    label: "Code: PSF\nAll-beings welfare"
  }
  iw: "3. Integral\nWisdom" {
    style.fill: "#581c87"
    style.font-color: "#d8b4fe"
    style.stroke: "#a855f7"
    label: "Code: IW\nMulti-perspectival knowing"
  }
  ip: "4. Infinite\nPlay" {
    style.fill: "#78350f"
    style.font-color: "#fde68a"
    style.stroke: "#f59e0b"
    label: "Code: IP\nCreative exploration"
  }
  ic: "5. Inter-\nconnectedness" {
    style.fill: "#164e63"
    style.font-color: "#67e8f9"
    style.stroke: "#06b6d4"
    label: "Code: IC\nRelational awareness"
  }
  sr: "6. Sacred\nReciprocity" {
    style.fill: "#831843"
    style.font-color: "#f9a8d4"
    style.stroke: "#ec4899"
    label: "Code: SR\nMutual giving"
  }
  ep: "7. Evolutionary\nProgression" {
    style.fill: "#365314"
    style.font-color: "#bef264"
    style.stroke: "#84cc16"
    label: "Code: EP\nGrowth toward complexity"
  }
  ss: "8. Sacred\nStillness" {
    style.fill: "#1c1917"
    style.font-color: "#a8a29e"
    style.stroke: "#78716c"
    label: "Apophatic-Knowing\nCode: SS | Weight: 0.13\nGABA(0.6) + Adenosine(0.4)\nDream depth mediator"
  }
}

# ═══════════════════════════════════════════
# INTERACTION MATRIX
# ═══════════════════════════════════════════
matrix: Harmony Interaction Matrix (8x8) {
  style.fill: "#1a1a2e"
  style.stroke: "#818cf8"
  style.font-color: "#c7d2fe"
  style.border-radius: 8
  label: "Learned synergy/tension matrix\nobserve() each cycle (Hebbian update)\napply() modulates harmony weights\nSynergy: harmonies co-activate\nTension: harmonies compete"
}

# ═══════════════════════════════════════════
# MORAL TOPOLOGY
# ═══════════════════════════════════════════
topology: Moral Topology {
  style.fill: "#3a1e3a"
  style.stroke: "#a855f7"
  style.font-color: "#d8b4fe"
  style.border-radius: 8

  entropy: "harmony_entropy\n(diversity of active harmonies)" {
    style.fill: "#581c87"
    style.font-color: "#e9d5ff"
  }
  attractor: "attractor_detected\n(stable moral configuration)" {
    style.fill: "#581c87"
    style.font-color: "#e9d5ff"
  }
  alignment: "Soul Alignment Score\n(action vs. value consistency)" {
    style.fill: "#581c87"
    style.font-color: "#e9d5ff"
  }
}

# ═══════════════════════════════════════════
# ACTIVE REST MODE
# ═══════════════════════════════════════════
rest: Active Rest Mode {
  style.fill: "#1c1917"
  style.stroke: "#78716c"
  style.font-color: "#a8a29e"
  style.border-radius: 8
  label: "Triggered: 10+ cycles Sacred Stillness dominance\nin_active_rest flag set\nDream consolidation accelerated\nPhi coupling modulated\nCircadian gating (adenosine accumulation)"
}

# ═══════════════════════════════════════════
# ETHICS ENGINE
# ═══════════════════════════════════════════
ethics: Ethics Engine {
  style.fill: "#1e3a2e"
  style.stroke: "#22c55e"
  style.font-color: "#86efac"
  style.border-radius: 8

  parser: "Moral Parser\nSemantic role binding\n(AGENT/PATIENT/ACTION)" {
    style.fill: "#14532d"
    style.font-color: "#86efac"
  }
  algebra: "Moral Algebra\nCompositional ethical\nreasoning (50+ constants)" {
    style.fill: "#14532d"
    style.font-color: "#86efac"
  }
  evaluator: "Value Evaluator\nPer-harmony scoring\n(HDC similarity)" {
    style.fill: "#14532d"
    style.font-color: "#86efac"
  }

  parser -> algebra -> evaluator
}

# ═══════════════════════════════════════════
# PULSE VISUALIZATION
# ═══════════════════════════════════════════
pulse: Pulse Visualization {
  style.fill: "#3a2e1e"
  style.stroke: "#f59e0b"
  style.font-color: "#fde68a"
  style.border-radius: 8
  label: "Harmony heatmap\nEntropy sparkline\nStillness breath indicator\nAttractor basin display"
}

# ═══════════════════════════════════════════
# CONNECTIONS
# ═══════════════════════════════════════════
harmonies -> matrix: "co-activation\nsignal" {style.stroke: "#818cf8"}
matrix -> topology: "modulated\nweights" {style.stroke: "#a855f7"}
harmonies.ss -> rest: "dominance\n10+ cycles" {style.stroke: "#78716c"; style.stroke-width: 2}
harmonies -> ethics.evaluator: "per-harmony\nscores" {style.stroke: "#22c55e"}
topology -> pulse: "telemetry" {style.stroke: "#f59e0b"; style.stroke-dash: 3}
ethics -> topology.alignment: "verdict" {style.stroke: "#22c55e"; style.stroke-dash: 3}

# Back to cognitive loop
topology.alignment -> cognitive_loop: "moral steering\nin dynamics phase" {
  style.stroke: "#a855f7"
  style.stroke-dash: 5
}

cognitive_loop: Cognitive Loop {
  shape: hexagon
  style.fill: "#374151"
  style.font-color: "#e5e7eb"
  label: "Phase 2: Moral steering\nPhase 3: Soul integration\nKosmicSong (every 50 cycles)"
}
