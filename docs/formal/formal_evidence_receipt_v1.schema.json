{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/symthaea/formal-evidence-receipt-v1.schema.json",
  "title": "Symthaea Formal Evidence Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tracking_issue",
    "authority",
    "primary_evidence_class",
    "subject",
    "claim",
    "toolchain",
    "artifacts",
    "trust_boundary",
    "controls",
    "qualification",
    "immutability",
    "composition"
  ],
  "properties": {
    "schema": {
      "const": "symthaea.formal-evidence.receipt.v1"
    },
    "tracking_issue": {
      "type": "integer",
      "minimum": 1
    },
    "authority": {
      "const": "EvidenceOnly"
    },
    "primary_evidence_class": {
      "enum": [
        "AbstractFormalTheorem",
        "ExtractedSourceRefinement",
        "DeductiveImplementationProof",
        "BoundedModelSafety",
        "TemporalModelEvidence",
        "BoundedTraceConformance",
        "RuntimeQualification"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "path",
        "blob",
        "symbol"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "statement_sha256",
        "claim_ceiling",
        "nonclaims"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "statement_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "elaborated_statement_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "nonclaims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "identity",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path_or_name",
          "sha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path_or_name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "trust_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumptions",
        "external_models",
        "axiom_or_assumption_census"
      ],
      "properties": {
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "external_models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity",
              "sha256",
              "status"
            ],
            "properties": {
              "identity": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "status": {
                "enum": [
                  "Proved",
                  "Trusted",
                  "Unmodeled",
                  "UnsupportedBoundary"
                ]
              }
            }
          }
        },
        "axiom_or_assumption_census": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutations"
      ],
      "properties": {
        "mutations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "expected_detection",
              "observed_result"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "expected_detection": {
                "type": "string",
                "minLength": 1
              },
              "observed_result": {
                "enum": [
                  "ExpectedFail",
                  "UnexpectedPass",
                  "NotRun",
                  "InfrastructureFailure"
                ]
              }
            }
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "workflow",
        "run_id",
        "head_sha"
      ],
      "properties": {
        "result": {
          "enum": [
            "Pass",
            "Fail",
            "Blocked",
            "EnvironmentFailure"
          ]
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "immutability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_subject_sha256",
        "post_subject_sha256",
        "checkout_clean"
      ],
      "properties": {
        "pre_subject_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "post_subject_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checkout_clean": {
          "type": "boolean"
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencies",
        "composition_rule"
      ],
      "properties": {
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "receipt_sha256",
              "evidence_class",
              "relation"
            ],
            "properties": {
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "evidence_class": {
                "enum": [
                  "AbstractFormalTheorem",
                  "ExtractedSourceRefinement",
                  "DeductiveImplementationProof",
                  "BoundedModelSafety",
                  "TemporalModelEvidence",
                  "BoundedTraceConformance",
                  "RuntimeQualification"
                ]
              },
              "relation": {
                "enum": [
                  "depends_on",
                  "refines",
                  "conforms_to",
                  "qualified_by",
                  "imports_assurance_from"
                ]
              }
            }
          }
        },
        "composition_rule": {
          "const": "DependenciesDoNotPromotePrimaryEvidenceClass"
        }
      }
    }
  }
}
