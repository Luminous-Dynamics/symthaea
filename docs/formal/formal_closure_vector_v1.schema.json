{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminous-dynamics.example/schemas/formal-closure-vector-v1.schema.json",
  "title": "Symthaea Formal Closure Vector V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "subject",
    "claim_ceiling",
    "dimensions"
  ],
  "properties": {
    "schema": {"const": "symthaea.formal.closure-vector.v1"},
    "claim_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "semantic_subject"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "semantic_subject": {"type": "string", "minLength": 1}
      }
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "TheoremStatementIdentity",
        "MathematicalSpecification",
        "CheckerIndependence",
        "SourceRefinement",
        "OptimizedImplementationRelation",
        "CompilerSemantics",
        "DependencyClosure",
        "BuildIdentity",
        "ArtifactIdentity",
        "ReleaseIdentity",
        "RuntimeIdentity",
        "EnvironmentRealization",
        "DistributedAssumptions",
        "CrossRepositorySubjectClosure"
      ],
      "properties": {
        "TheoremStatementIdentity": {"$ref": "#/$defs/dimension"},
        "MathematicalSpecification": {"$ref": "#/$defs/dimension"},
        "CheckerIndependence": {"$ref": "#/$defs/dimension"},
        "SourceRefinement": {"$ref": "#/$defs/dimension"},
        "OptimizedImplementationRelation": {"$ref": "#/$defs/dimension"},
        "CompilerSemantics": {"$ref": "#/$defs/dimension"},
        "DependencyClosure": {"$ref": "#/$defs/dimension"},
        "BuildIdentity": {"$ref": "#/$defs/dimension"},
        "ArtifactIdentity": {"$ref": "#/$defs/dimension"},
        "ReleaseIdentity": {"$ref": "#/$defs/dimension"},
        "RuntimeIdentity": {"$ref": "#/$defs/dimension"},
        "EnvironmentRealization": {"$ref": "#/$defs/dimension"},
        "DistributedAssumptions": {"$ref": "#/$defs/dimension"},
        "CrossRepositorySubjectClosure": {"$ref": "#/$defs/dimension"}
      }
    }
  },
  "$defs": {
    "supportRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "evidence_class": {"type": "string", "minLength": 1},
        "claim_ceiling": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": ["Closed", "Open", "NotApplicable", "ImportedAssurance", "BoundedOnly", "Unknown"]
        },
        "support": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/supportRef"}
        },
        "obligation": {"type": "string", "minLength": 1},
        "followup_issue": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "minLength": 1},
        "bound": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "claim_ceiling": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
