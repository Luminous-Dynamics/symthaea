{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/formal/rea-formal-provider-observation-v1.schema.json",
  "title": "REA formal provider-observation envelope v1",
  "description": "A conservative typed projection of an REA provider-reported-observation result. It preserves the complete REA result and exact request binding. It is not producer authentication or independent replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mapping_rule",
    "evidence_class",
    "semantic_polarity",
    "rea_disposition",
    "binding",
    "rea_evaluation",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "luminous.rea.formal-provider-observation.v1"
    },
    "mapping_rule": {
      "const": "rea-provider-observation-projection/v1"
    },
    "evidence_class": {
      "const": "provider_observation"
    },
    "semantic_polarity": {
      "enum": [
        "positive_support",
        "semantic_counterevidence",
        "no_semantic_conclusion"
      ]
    },
    "rea_disposition": {
      "enum": [
        "supported_within_scope",
        "refuted_within_scope",
        "underdetermined",
        "conflicted",
        "inapplicable",
        "unverified"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_request_sha256",
        "derivation_sha256",
        "request_schema",
        "result_schema",
        "evaluator_version",
        "evaluator_rule_id",
        "claim_id",
        "predicate",
        "subject_sha256",
        "operation",
        "platform",
        "platform_version",
        "environment_id",
        "asserted_value",
        "source_predicate_type",
        "requested_evidence_ids",
        "assumptions",
        "falsification_condition"
      ],
      "properties": {
        "claim_request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "derivation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_schema": {
          "const": "luminous.rea.claim.v0"
        },
        "result_schema": {
          "const": "luminous.rea.claim-evaluation.v0"
        },
        "evaluator_version": {
          "const": "rea-claim-evaluator/v0"
        },
        "evaluator_rule_id": {
          "enum": [
            "provider-reported-observation/exact-normalized-result/v0",
            "no-registered-predicate-rule/v0"
          ]
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "const": "provider_reported_observation"
        },
        "subject_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": ["string", "null"]
        },
        "platform_version": {
          "type": ["string", "null"]
        },
        "environment_id": {
          "type": ["string", "null"]
        },
        "asserted_value": {},
        "source_predicate_type": {
          "type": ["string", "null"]
        },
        "requested_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ev_[0-9a-f]{64}$"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "falsification_condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rea_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "evaluator_version",
        "rule_id",
        "claim_id",
        "claim_request_sha256",
        "predicate",
        "disposition",
        "scope",
        "asserted_value",
        "source_predicate_type",
        "requested_evidence_ids",
        "assumptions",
        "evidence_assessments",
        "missing_evidence_ids",
        "unmet_obligations",
        "falsification_condition",
        "claim_ceiling",
        "derivation_sha256"
      ],
      "properties": {
        "schema": {
          "const": "luminous.rea.claim-evaluation.v0"
        },
        "evaluator_version": {
          "const": "rea-claim-evaluator/v0"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "predicate": {
          "const": "provider_reported_observation"
        },
        "disposition": {
          "enum": [
            "supported_within_scope",
            "refuted_within_scope",
            "underdetermined",
            "conflicted",
            "inapplicable",
            "unverified"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject_sha256",
            "operation",
            "platform",
            "platform_version",
            "environment_id"
          ],
          "properties": {
            "subject_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "type": ["string", "null"]
            },
            "platform_version": {
              "type": ["string", "null"]
            },
            "environment_id": {
              "type": ["string", "null"]
            }
          }
        },
        "asserted_value": {},
        "source_predicate_type": {
          "type": ["string", "null"]
        },
        "requested_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev_[0-9a-f]{64}$"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "kind",
              "provider_id",
              "provider_name",
              "provider_version",
              "confidence",
              "authority",
              "reason"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "pattern": "^ev_[0-9a-f]{64}$"
              },
              "kind": {
                "enum": [
                  "supports",
                  "contradicts",
                  "inapplicable",
                  "scope_unverifiable",
                  "not_evaluated"
                ]
              },
              "provider_id": {
                "type": ["string", "null"]
              },
              "provider_name": {
                "type": ["string", "null"]
              },
              "provider_version": {
                "type": ["string", "null"]
              },
              "confidence": {
                "type": ["string", "null"]
              },
              "authority": {
                "type": ["string", "null"]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "missing_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev_[0-9a-f]{64}$"
          }
        },
        "unmet_obligations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "falsification_condition": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "derivation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "rea_disposition": {
            "const": "supported_within_scope"
          }
        },
        "required": ["rea_disposition"]
      },
      "then": {
        "properties": {
          "semantic_polarity": {
            "const": "positive_support"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rea_disposition": {
            "const": "refuted_within_scope"
          }
        },
        "required": ["rea_disposition"]
      },
      "then": {
        "properties": {
          "semantic_polarity": {
            "const": "semantic_counterevidence"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rea_disposition": {
            "enum": [
              "conflicted",
              "underdetermined",
              "inapplicable",
              "unverified"
            ]
          }
        },
        "required": ["rea_disposition"]
      },
      "then": {
        "properties": {
          "semantic_polarity": {
            "const": "no_semantic_conclusion"
          }
        }
      }
    }
  ]
}
