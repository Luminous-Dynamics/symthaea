{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/neuroscience/CONNECTOME_QUERY_CONDITIONED_STOPPING.schema.json",
  "title": "Query-conditioned connectome proofreading stopping benchmark run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "claim_scope",
    "source_reproduction",
    "query_stop_rule",
    "global_baseline",
    "tracks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_scope": {
      "enum": [
        "synthetic_known_answer",
        "retrospective_biological",
        "prospective_biological"
      ]
    },
    "source_reproduction": {
      "$ref": "#/$defs/source_reproduction"
    },
    "query_stop_rule": {
      "$ref": "#/$defs/query_stop_rule"
    },
    "global_baseline": {
      "$ref": "#/$defs/global_baseline"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/track"
      }
    }
  },
  "$defs": {
    "sha64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_version",
        "publication_status",
        "snapshot_pin_status",
        "exact_data_reproduction"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "publication_status": {
          "enum": [
            "peer_reviewed",
            "preprint",
            "synthetic_fixture"
          ]
        },
        "snapshot_pin_status": {
          "enum": [
            "PINNED_IMMUTABLE",
            "UNPINNED",
            "SYNTHETIC"
          ]
        },
        "exact_data_reproduction": {
          "type": "boolean"
        }
      }
    },
    "query_stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_missed_candidate_upper_bound",
        "requires_closed_boundary",
        "requires_identifiable_observation_model",
        "world_frame_claim_ceiling"
      ],
      "properties": {
        "maximum_missed_candidate_upper_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "requires_closed_boundary": {
          "const": true
        },
        "requires_identifiable_observation_model": {
          "const": true
        },
        "world_frame_claim_ceiling": {
          "const": "DECLARED_SCOPE_ONLY"
        }
      }
    },
    "global_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_id",
        "invariant_count",
        "fit_method",
        "checkpoint_protocol",
        "claim_scope"
      ],
      "properties": {
        "baseline_id": {
          "type": "string",
          "minLength": 1
        },
        "invariant_count": {
          "type": "integer",
          "minimum": 1
        },
        "fit_method": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_protocol": {
          "type": "string",
          "minLength": 1
        },
        "claim_scope": {
          "const": "GLOBAL_STABILIZATION_PROXY_NOT_QUERY_CERTIFICATE"
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id",
        "query_id",
        "query_spec_sha256",
        "maximum_missed_candidate_upper_bound",
        "snapshots",
        "certificate_invalidation_events"
      ],
      "properties": {
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "query_id": {
          "type": "string",
          "minLength": 1
        },
        "query_spec_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "maximum_missed_candidate_upper_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "snapshots": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/snapshot"
          }
        },
        "certificate_invalidation_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invalidation_event"
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "cumulative_edits",
        "snapshot_sha256",
        "edit_strategy",
        "global_status",
        "global_invariant_count",
        "global_invariant_sha256",
        "global_forecast_status",
        "query_evaluation"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "minLength": 1
        },
        "cumulative_edits": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "edit_strategy": {
          "enum": [
            "MERGE_FOCUSED",
            "SPLIT_FOCUSED",
            "AUTOMATED",
            "MIXED"
          ]
        },
        "global_status": {
          "enum": [
            "GLOBAL_CONVERGED",
            "GLOBAL_NOT_CONVERGED",
            "GLOBAL_NOT_ESTIMABLE"
          ]
        },
        "global_invariant_count": {
          "type": "integer",
          "minimum": 1
        },
        "global_invariant_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "global_forecast_status": {
          "enum": [
            "VALID",
            "RESET_REQUIRED",
            "NOT_ESTIMABLE",
            "SYNTHETIC_FIXTURE"
          ]
        },
        "query_evaluation": {
          "$ref": "#/$defs/query_evaluation"
        }
      }
    },
    "query_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admissible_world_ids",
        "query_decisions",
        "world_frame_status",
        "observation_identifiability",
        "missed_candidate_upper_bound",
        "boundary_status",
        "query_status",
        "safe_to_stop_for_query",
        "certificate_sha256",
        "certificate_generation",
        "unresolved_graph_world_count",
        "unresolved_query_decision_world_count"
      ],
      "properties": {
        "admissible_world_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "query_decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "world_frame_status": {
          "enum": [
            "COMPLETE_WITHIN_DECLARED_SCOPE",
            "SAMPLED_WITH_ACCEPTED_BOUND",
            "INCOMPLETE"
          ]
        },
        "observation_identifiability": {
          "enum": [
            "IDENTIFIABLE",
            "NOT_IDENTIFIABLE",
            "NOT_ASSESSED"
          ]
        },
        "missed_candidate_upper_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "boundary_status": {
          "enum": [
            "CLOSED_WITH_DECLARED_MARGIN",
            "OPEN_OR_UNVERIFIED"
          ]
        },
        "query_status": {
          "enum": [
            "QUERY_STABLE_WITHIN_DECLARED_SCOPE",
            "QUERY_UNSTABLE",
            "QUERY_NOT_IDENTIFIABLE",
            "INSUFFICIENT_COVERAGE"
          ]
        },
        "safe_to_stop_for_query": {
          "type": "boolean"
        },
        "certificate_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha64"
            },
            {
              "type": "null"
            }
          ]
        },
        "certificate_generation": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_graph_world_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_query_decision_world_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "invalidation_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "at_checkpoint_id",
        "new_alternative_id",
        "changes_query_decision",
        "prior_certificate_sha256",
        "prior_certificate_invalidated"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "at_checkpoint_id": {
          "type": "string",
          "minLength": 1
        },
        "new_alternative_id": {
          "type": "string",
          "minLength": 1
        },
        "changes_query_decision": {
          "type": "boolean"
        },
        "prior_certificate_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "prior_certificate_invalidated": {
          "type": "boolean"
        }
      }
    }
  }
}
