{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/CONNECTOME_EVIDENCE_TRUST_POLICY.schema.json",
  "title": "Role-bound trust policy for connectome evidence statements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "minimum_signatures",
    "required_roles",
    "trusted_keys"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "minimum_signatures": {
      "type": "integer",
      "minimum": 1
    },
    "required_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trusted_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "public_key_hex",
          "role",
          "valid_from_unix",
          "valid_until_unix",
          "revoked_at_unix"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1
          },
          "public_key_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "valid_from_unix": {
            "type": "integer",
            "minimum": 1
          },
          "valid_until_unix": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "revoked_at_unix": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    }
  }
}
