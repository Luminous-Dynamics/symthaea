{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/CONNECTOME_JOINT_OBSERVATION_SUPPORT_V1.json",
  "title": "Connectome joint observation-support relation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "dataset_revision_commit_sha",
    "query_id",
    "query_spec_sha256",
    "scenario_set_scope",
    "scenario_set_sha256",
    "action_set_sha256",
    "joint_support_scope",
    "joint_support_set_sha256",
    "effort_unit",
    "max_total_effort_units",
    "scenarios",
    "actions",
    "joint_supports"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_revision_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "query_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenario_set_scope": {
      "enum": [
        "exhaustive_declared_scenario_space",
        "sampled_sensitivity_set"
      ],
      "description": "Describes submitted worlds only; does not prove biological completeness."
    },
    "scenario_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "action_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "joint_support_scope": {
      "enum": [
        "exhaustive_declared_joint_support",
        "sampled_joint_sensitivity_set"
      ],
      "description": "Describes the supplied finite joint support only; neither value proves all real outcomes are present."
    },
    "joint_support_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effort_unit": {
      "type": "string",
      "minLength": 1
    },
    "max_total_effort_units": {
      "type": "integer",
      "minimum": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "graph_sha256",
          "decision_met"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "graph_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "decision_met": {
            "type": "boolean"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "action_kind",
          "effort_units",
          "source_evidence_sha256",
          "dependence_groups"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "action_kind": {
            "enum": [
              "image_inspection",
              "morphology_review",
              "synapse_adjudication",
              "orthogonal_measurement",
              "other"
            ]
          },
          "effort_units": {
            "type": "integer",
            "minimum": 1
          },
          "source_evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "dependence_groups": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Shared source/ancestry labels only; they do not imply a statistical dependence model."
          }
        }
      }
    },
    "joint_supports": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "joint_observation_model_sha256",
          "source_evidence_sha256",
          "dependence_groups",
          "rows"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "joint_observation_model_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "dependence_groups": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcomes"
              ],
              "properties": {
                "outcomes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "action_id",
                      "value"
                    ],
                    "properties": {
                      "action_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {},
  "$comment": "Each joint row must contain exactly one categorical outcome for every action ID. Rows are admissible correlated configurations, not Cartesian products, likelihoods, or independent marginals. Rust validates completeness and uniqueness plus canonical digests."
}
