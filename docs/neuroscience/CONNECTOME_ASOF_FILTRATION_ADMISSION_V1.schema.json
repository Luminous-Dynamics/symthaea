{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/neuroscience/CONNECTOME_ASOF_FILTRATION_ADMISSION_V1.schema.json",
  "title": "Connectome as-of evidence ledger and filtration admission V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_scope",
    "campaign_id",
    "global_filtration_id",
    "global_filtration_sha256",
    "entries",
    "admissions",
    "oracle_expectations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claim_scope": {
      "const": "synthetic_known_truth"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "global_filtration_id": {
      "type": "string",
      "minLength": 1
    },
    "global_filtration_sha256": {
      "$ref": "#/$defs/sha64"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "admissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/admission"
      }
    },
    "oracle_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_statuses",
        "admission_statuses",
        "final_sequence"
      ],
      "properties": {
        "decision_statuses": {
          "type": "array",
          "items": {
            "enum": [
              "ACCEPTED",
              "LOOKAHEAD_DETECTED",
              "PREFIX_MISMATCH",
              "LOCKBOX_LEAKAGE",
              "INVALID_RECEIPT"
            ]
          }
        },
        "admission_statuses": {
          "type": "array",
          "items": {
            "enum": [
              "ADMITTED_DIRECT_GLOBAL",
              "ADMITTED_AFTER_LIFT",
              "NOT_COMBINABLE_LOCAL_ONLY",
              "NOT_COMBINABLE_INCOMPARABLE",
              "INVALID_RECEIPT"
            ]
          }
        },
        "final_sequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "sha64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_int": {
      "type": [
        "integer",
        "null"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "evidence_family_id",
        "source_stream",
        "source_artifact_sha256",
        "revision",
        "supersedes_event_id",
        "event_time_ms",
        "acquired_at_ms",
        "annotated_at_ms",
        "qc_at_ms",
        "availability_state",
        "split",
        "confirmatory_family_id"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_family_id": {
          "type": "string",
          "minLength": 1
        },
        "source_stream": {
          "type": "string",
          "minLength": 1
        },
        "source_artifact_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "supersedes_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_time_ms": {
          "$ref": "#/$defs/nullable_int"
        },
        "acquired_at_ms": {
          "$ref": "#/$defs/nullable_int"
        },
        "annotated_at_ms": {
          "$ref": "#/$defs/nullable_int"
        },
        "qc_at_ms": {
          "$ref": "#/$defs/nullable_int"
        },
        "availability_state": {
          "enum": [
            "APPROVED",
            "PROVISIONAL",
            "DISPUTED",
            "FAILED",
            "MISSING",
            "OUT_OF_SUPPORT",
            "NOT_ASSESSED"
          ]
        },
        "split": {
          "enum": [
            "EXPLORATION",
            "FIT",
            "CALIBRATION",
            "CONFIRMATION"
          ]
        },
        "confirmatory_family_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "campaign_id",
        "kind",
        "policy_version_sha256",
        "input_prefix_sha256",
        "driver_receipt_sha256",
        "history_prefix_sha256",
        "action_sha256",
        "feasibility_receipt_sha256",
        "available_event_ids",
        "consumed_event_ids",
        "confirmatory_family_id"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "DISCOVERY",
            "CONFIRMATION"
          ]
        },
        "policy_version_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "input_prefix_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "driver_receipt_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "history_prefix_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "action_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "feasibility_receipt_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "available_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "consumed_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "confirmatory_family_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "family_commitment_sha256",
        "confirmation_lockbox_closed"
      ],
      "properties": {
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "family_commitment_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "confirmation_lockbox_closed": {
          "const": true
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "entry_commitment_sha256",
        "kind",
        "payload"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "entry_commitment_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "kind": {
          "enum": [
            "EVIDENCE",
            "DECISION",
            "FAMILY_FREEZE"
          ]
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "#/$defs/event"
            },
            {
              "$ref": "#/$defs/decision"
            },
            {
              "$ref": "#/$defs/freeze"
            }
          ]
        }
      }
    },
    "adjuster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjuster_id",
        "adjuster_version",
        "parameter_sha256",
        "theorem_assumptions_sha256",
        "lifted_output_sha256"
      ],
      "properties": {
        "adjuster_id": {
          "type": "string",
          "minLength": 1
        },
        "adjuster_version": {
          "type": "string",
          "minLength": 1
        },
        "parameter_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "theorem_assumptions_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "lifted_output_sha256": {
          "$ref": "#/$defs/sha64"
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "process_id",
        "null_spec_sha256",
        "input_process_sha256",
        "output_process_sha256",
        "source_filtration_id",
        "source_filtration_sha256",
        "target_filtration_id",
        "target_filtration_sha256",
        "observed_event_ids",
        "mode",
        "proof_receipt_sha256",
        "assumption_sha256",
        "adjuster",
        "process_output_sequence"
      ],
      "properties": {
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "process_id": {
          "type": "string",
          "minLength": 1
        },
        "null_spec_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "input_process_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "output_process_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "source_filtration_id": {
          "type": "string",
          "minLength": 1
        },
        "source_filtration_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "target_filtration_id": {
          "type": "string",
          "minLength": 1
        },
        "target_filtration_sha256": {
          "$ref": "#/$defs/sha64"
        },
        "observed_event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "enum": [
            "DIRECT_GLOBAL_SUPERMARTINGALE",
            "ADJUSTER_LIFTED",
            "LOCAL_ONLY",
            "INCOMPARABLE_OR_UNKNOWN"
          ]
        },
        "proof_receipt_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "assumption_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "adjuster": {
          "oneOf": [
            {
              "$ref": "#/$defs/adjuster"
            },
            {
              "type": "null"
            }
          ]
        },
        "process_output_sequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
