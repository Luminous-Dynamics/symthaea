{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/neuroscience/CONNECTOME_CANDIDATE_COVERAGE_AUDIT.schema.json",
  "title": "Connectome candidate-generation coverage audit",
  "description": "Evaluation-only, probability-sampled exhaustive search outcomes from the declared spatial/neuron sampling frame. Never provide this file to proposal generation or ranking.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_input_sha256",
    "source_ranking_report_sha256",
    "sampling_protocol_sha256",
    "sample_seed",
    "sample_seed_commitment_sha256",
    "error_families",
    "strata",
    "population_frame",
    "sampled_units"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_ranking_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sampling_protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sample_seed": {
      "type": "string",
      "minLength": 16
    },
    "sample_seed_commitment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stratum_id",
          "sampled_psu_count"
        ],
        "properties": {
          "stratum_id": {
            "type": "string",
            "minLength": 1
          },
          "sampled_psu_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "population_frame": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "psu_id",
          "stratum_id"
        ],
        "properties": {
          "psu_id": {
            "type": "string",
            "minLength": 1
          },
          "stratum_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sampled_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "psu_id",
          "exhaustive_search_completed",
          "audit_panel_person_minutes",
          "errors"
        ],
        "properties": {
          "psu_id": {
            "type": "string",
            "minLength": 1
          },
          "exhaustive_search_completed": {
            "const": true
          },
          "audit_panel_person_minutes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/verifiedError"
            }
          }
        }
      }
    },
    "error_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Complete preregistered error-family vocabulary. Families absent from sampled outcomes remain in the report with zero estimates."
    }
  },
  "$defs": {
    "verifiedError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_error_id",
        "error_family",
        "impact_weight",
        "proposal_candidate_ids"
      ],
      "properties": {
        "verified_error_id": {
          "type": "string",
          "minLength": 1
        },
        "error_family": {
          "type": "string",
          "minLength": 1
        },
        "impact_weight": {
          "type": "number",
          "minimum": 0,
          "description": "Evaluator-only, preregistered impact weight from the independent scientific query contract."
        },
        "proposal_candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Frozen proposal IDs independently determined to cover this verified error. Empty means the error was not proposed."
        }
      }
    }
  }
}
