{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/CONNECTOME_QUERY_FLIPPING_WITNESS_V1.json",
  "title": "Exact connectome query-flipping witness audit input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "dataset_revision_commit_sha",
    "edit_universe_scope",
    "baseline_graph_sha256",
    "baseline_graph",
    "query",
    "effort_unit",
    "max_total_effort_units",
    "edits"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "analysis_id": { "type": "string", "minLength": 1 },
    "dataset_revision_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "edit_universe_scope": {
      "enum": ["exhaustive_declared_edit_universe", "bounded_candidate_subset"],
      "description": "Exhaustive is relative only to the explicitly declared finite edit universe; it is not proof that all biologically plausible edits are included."
    },
    "baseline_graph_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "baseline_graph": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "query": { "$ref": "#/$defs/query" },
    "effort_unit": { "type": "string", "minLength": 1 },
    "max_total_effort_units": { "type": "integer", "minimum": 1 },
    "edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/edit_atom" }
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "weight"],
      "properties": {
        "source": { "type": "integer", "minimum": 0 },
        "target": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "metric", "decision"],
      "properties": {
        "query_id": { "type": "string", "minLength": 1 },
        "metric": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "source", "target"],
              "properties": {
                "kind": { "const": "edge_weight" },
                "source": { "type": "integer", "minimum": 0 },
                "target": { "type": "integer", "minimum": 0 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "node"],
              "properties": {
                "kind": { "const": "in_degree" },
                "node": { "type": "integer", "minimum": 0 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "node"],
              "properties": {
                "kind": { "const": "out_degree" },
                "node": { "type": "integer", "minimum": 0 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "source", "target"],
              "properties": {
                "kind": { "const": "path_exists" },
                "source": { "type": "integer", "minimum": 0 },
                "target": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        },
        "decision": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": { "const": "boolean_is" },
                "value": { "type": "boolean" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "threshold"],
              "properties": {
                "kind": { "enum": ["greater_than", "greater_or_equal", "less_than", "less_or_equal"] },
                "threshold": { "type": "number" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "lower", "upper"],
              "properties": {
                "kind": { "const": "between_inclusive" },
                "lower": { "type": "number" },
                "upper": { "type": "number" }
              }
            }
          ]
        }
      }
    },
    "edge_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "expected_weight", "replacement_weight"],
      "properties": {
        "source": { "type": "integer", "minimum": 0 },
        "target": { "type": "integer", "minimum": 0 },
        "expected_weight": { "type": "number", "minimum": 0 },
        "replacement_weight": { "type": "number", "minimum": 0 },
        "description": "Zero means absent edge / deletion. Every change precondition is evaluated against the same frozen baseline graph."
      }
    },
    "edit_atom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edit_id",
        "kind",
        "effort_units",
        "evidence_sha256",
        "requires",
        "conflicts_with",
        "changes"
      ],
      "properties": {
        "edit_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["graph_edit", "evidence_gate"] },
        "effort_units": { "type": "integer", "minimum": 1 },
        "evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "conflicts_with": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Conflict edges must be symmetric. Multiple edit atoms touching the same directed edge must explicitly conflict."
        },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge_change" }
        }
      }
    }
  }
}
