  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_tier": {
            "const": "synthetic_known_answer"
          }
        },
        "required": [
          "evidence_tier"
        ]
      },
      "then": {
        "properties": {
          "claim_ceiling": {
            "const": "synthetic_only"
          },
          "source": {
            "properties": {
              "source_kind": {
                "const": "synthetic"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_tier": {
            "const": "observational_structure_function"
          }
        },
        "required": [
          "evidence_tier"
        ]
      },
      "then": {
        "properties": {
          "claim_ceiling": {
            "const": "observational_prediction_only"
          },
          "source": {
            "properties": {
              "source_kind": {
                "const": "observational"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_tier": {
            "const": "in_silico_intervention"
          }
        },
        "required": [
          "evidence_tier"
        ]
      },
      "then": {
        "properties": {
          "claim_ceiling": {
            "const": "model_counterfactual_only"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_tier": {
            "const": "measured_intervention"
          }
        },
        "required": [
          "evidence_tier"
        ]
      },
      "then": {
        "properties": {
          "claim_ceiling": {
            "const": "measured_intervention_prediction"
          },
          "source": {
            "properties": {
              "source_kind": {
                "const": "measured_intervention"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_state": {
            "const": "complete"
          }
        },
        "required": [
          "run_state"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "source_manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "split": {
            "properties": {
              "status": {
                "const": "qualified"
              },
              "split_manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "train_membership_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "test_membership_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "preprocessing_fit_on_train_only": {
                "const": true
              },
              "feature_selection_fit_on_train_only": {
                "const": true
              },
              "model_selection_blind_to_test": {
                "const": true
              },
              "target_identity_split_before_preprocessing": {
                "const": true
              },
              "overlap_audit_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "results": {
            "properties": {
              "status": {
                "const": "complete"
              },
              "observed_outcomes_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "heldout_prediction_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "artifacts": {
            "properties": {
              "run_receipt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "resolved_config_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "environment_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "raw_output_manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_state": {
            "const": "planned"
          }
        },
        "required": [
          "run_state"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "properties": {
              "status": {
                "const": "not_run"
              }
            }
          }
        }
      }
    }
  ]
}
