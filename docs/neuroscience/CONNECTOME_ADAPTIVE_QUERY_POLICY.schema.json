{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/CONNECTOME_ADAPTIVE_QUERY_POLICY.schema.json",
  "title": "Adaptive query-directed connectome observation policy input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "dataset_revision_commit_sha",
    "query_id",
    "query_spec_sha256",
    "scenario_set_scope",
    "scenario_set_sha256",
    "action_set_sha256",
    "joint_support_scope",
    "joint_support_sha256",
    "effort_unit",
    "max_total_effort_units",
    "scenarios",
    "actions",
    "joint_world_supports"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_revision_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "query_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenario_set_scope": {
      "enum": [
        "exhaustive_declared_scenario_space",
        "sampled_sensitivity_set"
      ]
    },
    "scenario_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "action_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "joint_support_scope": {
      "enum": [
        "exhaustive_declared_joint_support",
        "sampled_sensitivity_support"
      ]
    },
    "joint_support_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effort_unit": {
      "type": "string",
      "minLength": 1
    },
    "max_total_effort_units": {
      "type": "integer",
      "minimum": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "joint_world_supports": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/worldSupport"
      }
    },
    "support_challenges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supportChallenge"
      },
      "description": "Optional independent additive-only sensitivity branches. Each is applied to the same frozen base support; challenges are not cumulatively applied to one another."
    },
    "scenario_challenges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenarioExpansionChallenge"
      },
      "description": "Optional append-only alternative-world expansions; each is independently evaluated against the same frozen base scenario and joint-support universe."
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "graph_sha256",
        "decision_met"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "graph_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision_met": {
          "type": "boolean"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action_kind",
        "effort_units",
        "source_evidence_sha256",
        "observation_model_sha256",
        "dependence_groups"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "action_kind": {
          "enum": [
            "image_inspection",
            "morphology_review",
            "synapse_adjudication",
            "orthogonal_measurement",
            "other"
          ]
        },
        "effort_units": {
          "type": "integer",
          "minimum": 1
        },
        "source_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observation_model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependence_groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "jointOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcomes"
      ],
      "properties": {
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action_id",
              "outcome"
            ],
            "properties": {
              "action_id": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "worldSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "source_evidence_sha256",
        "joint_observation_model_sha256",
        "dependence_groups",
        "possible_joint_outcomes"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "source_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "joint_observation_model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependence_groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "possible_joint_outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/jointOutcome"
          }
        }
      }
    },
    "supportChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_id",
        "challenger_evidence_sha256",
        "challenger_model_sha256",
        "additions"
      ],
      "properties": {
        "challenge_id": {
          "type": "string",
          "minLength": 1
        },
        "challenger_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "challenger_model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "additions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/supportAddition"
          }
        }
      }
    },
    "supportAddition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "source_evidence_sha256",
        "joint_observation_model_sha256",
        "dependence_groups",
        "possible_joint_outcomes"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "source_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "joint_observation_model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependence_groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "possible_joint_outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/jointOutcome"
          }
        }
      }
    },
    "scenarioExpansionChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_id",
        "challenger_evidence_sha256",
        "challenger_model_sha256",
        "additions"
      ],
      "properties": {
        "challenge_id": {
          "type": "string",
          "minLength": 1
        },
        "challenger_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "challenger_model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "additions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/scenarioWorldAddition"
          }
        }
      }
    },
    "scenarioWorldAddition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "support"
      ],
      "properties": {
        "scenario": {
          "$ref": "#/$defs/scenario"
        },
        "support": {
          "$ref": "#/$defs/worldSupport"
        }
      }
    }
  }
}
