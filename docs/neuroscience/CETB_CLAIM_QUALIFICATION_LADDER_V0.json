{
  "schema_version": "cetb.claim-qualification/0.1.0",
  "status": "proposed_internal_qualification_framework",
  "no_global_model_grade": true,
  "tiers": [
    {
      "tier": "Q0",
      "name": "synthetic_implementation_evidence",
