      "not_established": [
        "independent replication",
        "new generalization",
        "clinical validity"
      ]
    },
    {
      "tier": "Q2",
      "name": "held_out_participant_evaluation",
      "scope": "frozen model evaluated on participants not used for selection or tuning",
      "not_established": [
        "cross-site transport",
        "cross-device transport",
        "independent cohort replication"
      ]
    },
    {
      "tier": "Q3",
      "name": "independent_cohort_site_device_replication",
      "scope": "genuinely independent participants/acquisition with frozen procedure",
