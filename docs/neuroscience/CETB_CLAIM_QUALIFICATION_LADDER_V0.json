        "unrestricted population transport",
        "clinical intended-use validity"
      ]
    },
    {
      "tier": "Q4",
      "name": "prospective_preregistered_multisite_evaluation",
      "scope": "future outcomes collected after protocol/model lock",
      "not_established": [
        "clinical utility",
        "regulatory authorization"
      ]
    },
    {
      "tier": "Q5",
      "name": "clinical_utility_intended_use_qualification",
      "scope": "prospective target-population decision utility and intended-use evaluation",
      "not_established": [
        "claims beyond the defined endpoint and authorization"
      ]
    }
  ],
  "cross_cutting_gates": [
