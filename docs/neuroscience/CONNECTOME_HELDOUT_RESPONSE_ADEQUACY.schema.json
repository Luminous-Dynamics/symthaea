{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/neuroscience/CONNECTOME_HELDOUT_RESPONSE_ADEQUACY.schema.json",
  "title": "Held-out intervention-response trajectory evaluation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "claim_scope",
    "dataset_binding",
    "split_manifest",
    "time_grid_ms",
    "models",
    "interventions",
    "units",
    "predictions",
    "expected_outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_scope": {
      "const": "synthetic_known_truth"
    },
    "dataset_binding": {
      "$ref": "#/$defs/dataset_binding"
    },
    "split_manifest": {
      "$ref": "#/$defs/split_manifest"
    },
    "time_grid_ms": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "number"
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "interventions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/intervention"
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/prediction"
      }
    },
    "expected_outcomes": {
      "$ref": "#/$defs/expected_outcomes"
    }
  },
  "$defs": {
    "dataset_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_revision_sha256",
        "species",
        "evidence_tier",
        "source_access_receipt_sha256"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_revision_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "species": {
          "type": "string",
          "minLength": 1
        },
        "evidence_tier": {
          "const": "SYNTHETIC"
        },
        "source_access_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "split_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split_unit",
        "training_units",
        "calibration_units",
        "lockbox_units",
        "split_sha256"
      ],
      "properties": {
        "split_unit": {
          "enum": [
            "animal",
            "specimen",
            "session",
            "target_neuron",
            "animal_session",
            "synthetic_unit"
          ]
        },
        "training_units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "calibration_units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "lockbox_units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "split_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_family",
        "model_sha256",
        "observation_kernel_sha256",
        "training_data_sha256"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_family": {
          "type": "string",
          "minLength": 1
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observation_kernel_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "training_data_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intervention_id",
        "intervention_kind",
        "feasibility_status",
        "intervention_receipt_sha256"
      ],
      "properties": {
        "intervention_id": {
          "type": "string",
          "minLength": 1
        },
        "intervention_kind": {
          "enum": [
            "OPTOGENETIC",
            "ELECTRICAL",
            "PHARMACOLOGICAL",
            "SENSORY",
            "BEHAVIORAL",
            "SIMULATED",
            "OTHER"
          ]
        },
        "feasibility_status": {
          "enum": [
            "FEASIBLE",
            "DISALLOWED",
            "INACCESSIBLE"
          ]
        },
        "intervention_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "split",
        "observation_status",
        "source_receipt_sha256"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "CALIBRATION",
            "LOCKBOX"
          ]
        },
        "observation_status": {
          "enum": [
            "OBSERVED",
            "FAILED",
            "INACCESSIBLE",
            "NOT_ATTEMPTED"
          ]
        },
        "source_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_trajectory_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "observation_status": {
                "const": "OBSERVED"
              }
            },
            "required": [
              "observation_status"
            ]
          },
          "then": {
            "required": [
              "observed_trajectory_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "observation_status": {
                "enum": [
                  "FAILED",
                  "INACCESSIBLE",
                  "NOT_ATTEMPTED"
                ]
              }
            },
            "required": [
              "observation_status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "observed_trajectory_id"
              ]
            }
          }
        }
      ]
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "intervention_id",
        "unit_id",
        "predicted_trajectories"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "intervention_id": {
          "type": "string",
          "minLength": 1
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "predicted_trajectories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/trajectory_forecast"
          }
        }
      }
    },
    "trajectory_forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trajectory_id",
        "values",
        "probability"
      ],
      "properties": {
        "trajectory_id": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "expected_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_unit_count",
        "lockbox_observed_unit_count",
        "lockbox_failed_unit_count",
        "baseline_lockbox_zero_support_count",
        "challenger_lockbox_zero_support_count",
        "baseline_lockbox_coverage_90_count",
        "challenger_lockbox_coverage_90_count",
        "calibration_claim_status"
      ],
      "properties": {
        "calibration_unit_count": {
          "type": "integer",
          "minimum": 1
        },
        "lockbox_observed_unit_count": {
          "type": "integer",
          "minimum": 1
        },
        "lockbox_failed_unit_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_lockbox_zero_support_count": {
          "type": "integer",
          "minimum": 0
        },
        "challenger_lockbox_zero_support_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_lockbox_coverage_90_count": {
          "type": "integer",
          "minimum": 0
        },
        "challenger_lockbox_coverage_90_count": {
          "type": "integer",
          "minimum": 0
        },
        "calibration_claim_status": {
          "const": "SYNTHETIC_KNOWN_ANSWER_ONLY_NOT_A_CALIBRATION_CLAIM"
        }
      }
    }
  }
}
