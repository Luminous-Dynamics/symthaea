{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/neuroscience/CONNECTOME_PERTURBATION_INTERACTION_REPORT.schema.json",
  "title": "Connectome Perturbation Factorial Interaction Report",
  "description": "Strict schema for the deterministic synthetic nonlinear/state-conditioned factorial reference suite. Synthetic evidence only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "claim_ceiling", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_class": {"const": "synthetic_known_answer"},
    "claim_ceiling": {"const": "SYNTHETIC_ONLY"},
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "context", "interaction", "expected", "status"],
        "properties": {
          "id": {
            "enum": [
              "pairwise_threshold_synergy",
              "pairwise_additive_null",
              "saturation_subadditivity",
              "third_order_threshold_synergy",
              "state_gated_edge_resting",
              "state_gated_edge_active"
            ]
          },
          "context": {"enum": ["resting", "active"]},
          "interaction": {"type": "array", "minItems": 1, "items": {"type": "number"}},
          "expected": {"type": "array", "minItems": 1, "items": {"type": "number"}},
          "status": {"enum": ["PASS", "FAIL"]}
        }
      },
      "allOf": [
        {"contains": {"type": "object", "properties": {"id": {"const": "pairwise_threshold_synergy"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"id": {"const": "pairwise_additive_null"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"id": {"const": "saturation_subadditivity"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"id": {"const": "third_order_threshold_synergy"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"id": {"const": "state_gated_edge_resting"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"id": {"const": "state_gated_edge_active"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  }
}
