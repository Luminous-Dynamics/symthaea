{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/neuroscience/CONNECTOME_COLINEAR_BOUNDARY_TRUTH.schema.json",
  "title": "Evaluator-only co-linear merge boundary truth",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_sha256", "tracks"],
  "properties": {
    "schema_version": { "const": 1 },
    "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["track_id", "boundaries_nm"],
        "properties": {
          "track_id": { "type": "string", "minLength": 1 },
          "boundaries_nm": { "type": "array", "uniqueItems": true, "items": { "type": "number" } }
        }
      }
    }
  }
}
