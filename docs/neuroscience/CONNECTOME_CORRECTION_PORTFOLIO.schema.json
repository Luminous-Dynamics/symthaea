{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/CONNECTOME_CORRECTION_PORTFOLIO_V1.json",
  "title": "Connectome joint correction portfolio benchmark input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_revision_commit_sha",
    "source_graph_sha256",
    "graph",
    "queries",
    "candidates",
    "review_budgets_minutes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_revision_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_graph_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "graph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "weight"],
        "properties": {
          "source": { "type": "integer", "minimum": 0 },
          "target": { "type": "integer", "minimum": 0 },
          "weight": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_id", "weight", "normalization_scale", "reference_value", "metric"],
        "properties": {
          "query_id": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0 },
          "normalization_scale": { "type": "number", "exclusiveMinimum": 0 },
          "reference_value": { "type": "number" },
          "metric": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "source", "target"],
                "properties": {
                  "kind": { "const": "edge_weight" },
                  "source": { "type": "integer", "minimum": 0 },
                  "target": { "type": "integer", "minimum": 0 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "node"],
                "properties": {
                  "kind": { "const": "in_degree" },
                  "node": { "type": "integer", "minimum": 0 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "node"],
                "properties": {
                  "kind": { "const": "out_degree" },
                  "node": { "type": "integer", "minimum": 0 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "source", "target"],
                "properties": {
                  "kind": { "const": "path_exists" },
                  "source": { "type": "integer", "minimum": 0 },
                  "target": { "type": "integer", "minimum": 0 }
                }
              }
            ]
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "estimated_error_probability", "review_minutes", "evidence_sha256", "changes"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "estimated_error_probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "review_minutes": { "type": "number", "exclusiveMinimum": 0 },
          "evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["operation", "source", "target", "weight"],
                  "properties": {
                    "operation": { "const": "add_weight" },
                    "source": { "type": "integer", "minimum": 0 },
                    "target": { "type": "integer", "minimum": 0 },
                    "weight": { "type": "number", "exclusiveMinimum": 0 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["operation", "source", "target", "weight"],
                  "properties": {
                    "operation": { "const": "remove_weight" },
                    "source": { "type": "integer", "minimum": 0 },
                    "target": { "type": "integer", "minimum": 0 },
                    "weight": { "type": "number", "exclusiveMinimum": 0 }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "review_budgets_minutes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "number", "exclusiveMinimum": 0 }
    }
  }
}
