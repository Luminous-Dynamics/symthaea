{
  "schema_version": "fep-efe-action-002a-reference-v1",
  "status": "frozen_unqualified_reference_source",
  "intended_issue": "https://github.com/Luminous-Dynamics/symthaea/issues/6223",
  "profile": "FiniteCategoricalExpectedInformationGainV1",
  "formulas": {
    "predictive_observation": "q(o|a)=sum_s q(s) q(o|s,a)",
    "posterior": "q(s|o,a)=q(s)q(o|s,a)/q(o|a), only when q(o|a)>0",
    "expected_kl": "EIG(a)=sum_o q(o|a) KL(q(s|o,a)||q(s))",
    "entropy_identity": "EIG(a)=H(q(s))-sum_o q(o|a)H(q(s|o,a))",
    "score_orientation": "E_info(a)=-EIG(a) under the EFE minimization convention",
    "entropy_notation": "H(p) = -sum_i p_i ln(p_i), with 0 ln 0 defined as 0"
  },
  "identity_contract": [
    "profile ID and version",
    "ordered or canonicalized state support and prior",
    "observation support and action-conditioned likelihood matrix",
    "numeric/tolerance policy",
    "model/profile generation",
    "exact corpus/schema version"
  ],
  "numeric_policy": {
    "probabilities": "decimal strings; raw numeric JSON values are intentionally rejected in the malformed-shape controls",
    "normalization_tolerance": 1e-12,
    "expected": "symbolic expression where simple, otherwise relation/identity against paired cases",
    "log_base": "natural logarithm",
    "impossible_branch": "zero predictive mass contributes zero; do not manufacture a posterior for it",
    "no_silent_renormalization": true
  },
