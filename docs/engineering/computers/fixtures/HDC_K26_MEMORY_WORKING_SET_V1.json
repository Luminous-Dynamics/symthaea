  "workload_definition": {
    "representation": "canonical 16,384-bit BinaryHV",
    "vector_bits": 16384,
    "vector_payload_bytes": 2048,
    "score": "exact Hamming distance",
    "selection": "exact top-1 with canonical lowest-stable-ID tie break",
    "corpus_sizes": [
      256,
      1024,
      4096,
      16384,
      65536,
      262144,
      1048576,
      2097152,
      4194304
    ],
    "query_batch_sizes": [
      1,
      4,
      16,
      64
    ]
  },
  "target_published_capacity_context": {
    "platform_candidate": "AMD Kria K26 SOM",
    "som_host_dram_bytes": 4294967296,
    "som_onchip_memory_bits_published": 26600000,
    "som_onchip_memory_bytes_theoretical_upper_bound": 3325000,
    "sources": [
      "https://www.amd.com/en/products/system-on-modules/kria/k26/k26c-commercial.html",
      "https://docs.amd.com/r/en-US/ds987-k26-som"
    ],
    "caveats": [
      "The on-chip-memory figure is a total published upper bound, not capacity available exclusively to the HDC tile.",
      "Actual BRAM/URAM availability depends on other logic, buffering, port count, width, timing and implementation.",
      "The 4 GB DDR4 figure is SOM capacity, not free memory; operating system, applications, metadata and buffering consume memory.",
      "Evaluation-kit SOM SKU and boot storage differ from the commercial K26C SKU; freeze exact board and SOM identity."
    ]
  },
  "architectural_hypothesis": {
    "name": "candidate-major batched query streaming",
    "description": "Keep Q query vectors resident on-chip; stream each corpus candidate once; compute Q exact Hamming distances and update Q independent exact top-1 reducers before advancing.",
    "ideal_candidate_payload_read_amortization": "Q-fold versus rescanning the whole corpus separately for each query, under a no-cache model with all Q queries processed per candidate load.",
    "tradeoffs": [
      "Q parallel arithmetic paths or enough time/buffer to reuse a candidate across Q query comparisons",
      "Q reducer states and query residency",
      "batching latency and request scheduling",
      "memory-port and DMA/stream throughput limits",
      "host/device and on-chip/off-chip transfer overhead"
    ],
    "negative_control": "If the corpus is cache-resident or the CPU reuses cached corpus lines effectively, candidate-major FPGA streaming may not outperform the optimized CPU; measure both paths.",
    "status": "hypothesis_not_measured"
  },
