{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/research/vis-tech-001-program-2026-10-17/docs/engineering/display-manufacturing-route-profiles.schema.json",
  "title": "Visual technology display manufacturing route profiles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_id",
    "schema_version",
    "created_on",
    "status",
    "purpose",
    "ownership",
    "reference_sources",
    "routes"
  ],
  "properties": {
    "corpus_id": {
      "const": "VIS-MFG-ROUTE-CORPUS-001"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "created_on": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "UNQUALIFIED"
    },
    "purpose": {
      "type": "string",
      "minLength": 40
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_flow_semantics",
        "generic_manufacturing_semantics",
        "qualification_composition",
        "display_yield_benchmark",
        "display_manufacturing_routes",
        "evidence_profile"
      ],
      "properties": {
        "process_flow_semantics": {
          "type": "string",
          "format": "uri"
        },
        "generic_manufacturing_semantics": {
          "type": "string",
          "format": "uri"
        },
        "qualification_composition": {
          "type": "string",
          "format": "uri"
        },
        "display_yield_benchmark": {
          "type": "string",
          "format": "uri"
        },
        "display_manufacturing_routes": {
          "type": "string",
          "format": "uri"
        },
        "evidence_profile": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "reference_sources": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/reference_source"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/route_profile"
      }
    }
  },
  "$defs": {
    "reference_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "year",
        "url",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SRC-[A-Z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 8
        },
        "year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2026
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "role": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "sequence",
        "stage_name",
        "operation_class",
        "canonical_family_key",
        "process_semantics_owner",
        "conditionality",
        "condition",
        "input_state",
        "intended_output_state",
        "predecessor_groups",
        "inspection_gate",
        "required_evidence",
        "known_failure_modes",
        "evidence_status"
      ],
      "properties": {
        "stage_id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-[0-9]{2}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "stage_name": {
          "type": "string",
          "minLength": 4
        },
        "operation_class": {
          "type": "string",
          "minLength": 4
        },
        "canonical_family_key": {
          "type": "string",
          "minLength": 4
        },
        "process_semantics_owner": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github.com/Luminous-Dynamics/symthaea/issues/"
        },
        "conditionality": {
          "enum": [
            "required",
            "conditional",
            "architecture_dependent"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 8
        },
        "input_state": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "intended_output_state": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "inspection_gate": {
          "enum": [
            "required_hold",
            "conditional_hold",
            "monitor_only"
          ]
        },
        "required_evidence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "known_failure_modes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "evidence_status": {
          "const": "UNQUALIFIED"
        },
        "predecessor_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "predecessors"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "all_of",
                  "one_of_conditioned"
                ]
              },
              "predecessors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "stage_id",
                    "condition"
                  ],
                  "properties": {
                    "stage_id": {
                      "type": "string",
                      "pattern": "^[A-Z0-9]+-[0-9]{2}$"
                    },
                    "condition": {
                      "type": "string",
                      "minLength": 8
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "route_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "technology_family",
        "target_module",
        "architecture_variants",
        "scope_note",
        "source_ids",
        "stages",
        "component_interfaces"
      ],
      "properties": {
        "route_id": {
          "type": "string",
          "pattern": "^DISPLAY-[A-Z0-9-]+-001$"
        },
        "technology_family": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "target_module": {
          "type": "string",
          "minLength": 8
        },
        "architecture_variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "scope_note": {
          "type": "string",
          "minLength": 30
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9-]+$"
          }
        },
        "stages": {
          "type": "array",
          "minItems": 7,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "component_interfaces": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/component_interface"
          }
        }
      }
    },
    "component_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "component_name",
        "component_scope",
        "process_semantics_owners",
        "reference_source_ids",
        "incoming_acceptance_evidence",
        "interface_characteristics",
        "known_failure_modes",
        "evidence_status"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+-[0-9]{2}$"
        },
        "component_name": {
          "type": "string",
          "minLength": 4
        },
        "component_scope": {
          "type": "string",
          "minLength": 30
        },
        "process_semantics_owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github.com/Luminous-Dynamics/symthaea/issues/"
          }
        },
        "reference_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9-]+$"
          }
        },
        "incoming_acceptance_evidence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "interface_characteristics": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "known_failure_modes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "evidence_status": {
          "const": "UNQUALIFIED"
        }
      }
    }
  }
}
