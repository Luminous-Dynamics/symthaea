{
  "schema_version": "1.0.0",
  "benchmark_id": "LUMINOUS-CHEM-PROC-QUAL",
  "corpus_version": "1.1.0",
  "created_utc": "2026-10-17",
  "baseline_commit": "5e83cea4986ba3845aa50e0d5dd03493c5adeddf",
  "source_specification": "docs/engineering/CHEMICAL_PROCESS_END_TO_END_QUALIFICATION_BENCHMARK_2026-10-17.md",
  "purpose": "Deterministic contract corpus for testing expected evidence dispositions and fail-closed semantics. This file contains synthetic bookkeeping/evidence cases only.",
  "scope_boundary": {
    "data_class": "synthetic_non_operational",
    "contains_hazardous_operating_recipes": false,
    "establishes_chemical_route_feasibility": false,
    "establishes_physical_model_accuracy": false,
    "authorizes_process_control_or_plant_operation": false
  },
  "allowed_dispositions": [
    "ACCEPTED_WITHIN_SCOPE",
    "BLOCKED",
    "UNRESOLVED",
    "OUT_OF_DOMAIN"
  ],
  "evaluation_rules": [
    "Compare the observed disposition to the frozen expected_disposition for every case.",
    "ACCEPTED_WITHIN_SCOPE applies only to the explicitly named synthetic proposition and never promotes downstream claims.",
    "BLOCKED, UNRESOLVED, and OUT_OF_DOMAIN are valid expected outcomes; they are not benchmark failures when expected.",
    "A queued, skipped, missing, stale, non-converged, or unverified external result must never be counted as an independent pass.",
    "The evaluator must report all cases, including errors and malformed inputs; it must not silently drop failures.",
    "Acceptance thresholds and expected dispositions must not be tuned after observing candidate results.",
    "Different solver implementations sharing any evidence-data dependency cannot be counted as independent corroboration; missing dependency provenance remains unresolved."
  ],
  "residual_profile": {
    "name": "synthetic-analytic-v1",
    "formula": "abs(accounted_in - accounted_out - declared_generation) / max(reference_scale, sum(abs(accounting_terms)))",
    "target_max": 1e-8,
    "scope": "Only the simplest analytically solvable synthetic fixtures; component, elemental, charge and energy balances use separate equations and declared sign conventions.",
    "caveat": "No single residual threshold proves model validity, physical truth, product purity, safety, or industrial feasibility."
  },
  "cases": [
    {
      "id": "CHEM-PROC-001",
      "class": "positive-control",
      "scenario": "Balanced abstract mixer",
      "claim_under_test": "Component balance closes for a non-reactive mixer.",
      "fixture": {
        "unit": "mixer",
        "inlets": [
          {
            "component": "A",
            "flow": 2,
            "unit": "mol/s"
          },
          {
            "component": "A",
            "flow": 3,
            "unit": "mol/s"
          }
        ],
        "outlets": [
          {
            "component": "A",
            "flow": 5,
            "unit": "mol/s"
          }
        ],
        "reaction": false
      },
      "expected_disposition": "ACCEPTED_WITHIN_SCOPE",
      "required_findings": [
        "component_balance_closed"
      ],
      "prohibited_promotions": [
        "process_safety_qualified",
        "plant_capability_qualified"
      ]
    },
