  "purpose": "Machine-readable inventory of candidate Tier-B process-engineering benchmarks. This file is a selection and freeze checklist, not a record of executed simulations or validated plant models.",
  "safety_and_claim_policy": {
    "candidate_registry_is_not_a_simulation_receipt": true,
    "tutorial_approximate_values_are_never_exact_gold_outputs": true,
    "not_run_or_unavailable_never_counts_as_pass": true,
    "solver_exit_code_alone_is_not_model_validation": true,
    "cross_solver_agreement_is_not_independent_if_evidence_dependencies_are_shared": true,
    "no_operational_authority": true,
    "prohibited_claims_without_separate_evidence": [
      "physical validation",
      "plant or product qualification",
      "safety certification",
      "industrial purity or yield qualification",
      "economic feasibility"
    ]
  },
  "result_statuses": [
    "PASS",
    "FAIL",
    "SKIPPED",
    "NOT_RUN",
    "OUT_OF_DOMAIN",
    "REFERENCE_UNAVAILABLE",
    "UNRESOLVED"
  ],
  "freeze_receipt_required_fields": [
    "primary_source_url_and_revision",
    "retrieved_at",
    "native_input_files_and_transitive_data_hashes",
    "component_identity_and_order",
    "units_and_composition_basis",
    "phase_and_reference_state_conventions",
    "property_package_or_mechanism_and_parameter_provenance",
    "solver_build_and_runtime_versions",
    "numerical_methods_tolerances_and_convergence_status",
    "stdout_stderr_and_raw_output_hashes",
    "independent_checker_version_and_result",
    "shared_dependency_audit",
    "preregistered_case_specific_tolerance_and_rationale",
    "claim_ceiling"
  ],
