  "factory_architectures": [
    {
      "architecture_id": "DEDICATED_LINE",
      "description": "Dedicated line optimized for one product family or stable product mix",
      "main_tradeoff": "High nominal flow with high asset-stranding risk under product evolution"
    },
    {
      "architecture_id": "FUNCTIONAL_JOB_SHOP",
      "description": "General-purpose work centers scheduled by operation and capability",
      "main_tradeoff": "Routing flexibility with potentially longer queues and travel"
    },
    {
      "architecture_id": "PRODUCT_FAMILY_U_CELL",
      "description": "Grouped workcells for related product/operation families",
      "main_tradeoff": "Short local flow where product families are compatible"
    },
    {
      "architecture_id": "FLEXIBLE_MANUFACTURING_SYSTEM",
      "description": "Shared automated resources and routing across a defined product envelope",
      "main_tradeoff": "Requires qualified material handling, routing, control and diagnostics"
    },
    {
      "architecture_id": "RECONFIGURABLE_MANUFACTURING_SYSTEM",
      "description": "Modular capacity/functionality changes with declared reconfiguration process",
      "main_tradeoff": "Reconfiguration and qualification burden must be counted"
    },
    {
      "architecture_id": "MULTIPURPOSE_MICROFACTORY",
      "description": "Small facility with configurable specialist cells and shared support modules",
      "main_tradeoff": "Limited scale and shared-resource bottlenecks"
    },
    {
      "architecture_id": "DISTRIBUTED_PARTNER_NETWORK",
      "description": "Multiple qualified specialist or contract production nodes",
      "main_tradeoff": "Lower owned capital with transport, interface and partner-dependency exposure"
    },
    {
      "architecture_id": "HYBRID_LOCAL_PARTNER_NETWORK",
      "description": "Core local production/repair cells with specialist outsourced or partner processes",
      "main_tradeoff": "Balance control and capital with external capability dependence"
    },
    {
      "architecture_id": "MOBILE_CONTAINERIZED_FACTORY",
      "description": "Transportable modules deployed at remote or temporary sites",
      "main_tradeoff": "Deployment footprint, environmental utilities and logistics"
    },
    {
      "architecture_id": "STAGED_INDUSTRIAL_SEED_FACTORY",
      "description": "Phased capability growth where early equipment supports later productive capacity",
      "main_tradeoff": "Bootstrap dependencies, imported spares and recursive capability closure"
    }
  ],
