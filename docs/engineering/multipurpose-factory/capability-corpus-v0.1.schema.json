{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/engineering/multipurpose-factory/capability-corpus-v0.1.schema.json",
  "title": "Multipurpose Factory Capability and Reconfiguration Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "claim_ceiling",
    "warning",
    "authority_partition",
    "factory_architectures",
    "product_families",
    "modules",
    "scenario_families",
    "conformance_cases",
    "comparison_policies",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "multipurpose-factory-capability-corpus/0.1"
    },
    "study_id": {
      "const": "MULTIPURPOSE-FACTORY-SYNTHETIC-v0.1"
    },
    "claim_ceiling": {
      "const": "SYNTHETIC_CAPABILITY_AND_RECONFIGURATION_CONFORMANCE_ONLY"
    },
    "warning": {
      "type": "string",
      "minLength": 60
    },
    "authority_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_reasoning",
        "process_and_factory_execution",
        "canonical_process_and_product_qualification",
        "independent_verification",
        "physical_commissioning",
        "release_authority"
      ],
      "properties": {
        "design_reasoning": {
          "const": "SYMTHAEA_PROPOSAL_ONLY"
        },
        "process_and_factory_execution": {
          "const": "SYMTROPY_EXISTING_FACTORY_OWNERS"
        },
        "canonical_process_and_product_qualification": {
          "const": "EXISTING_DOMAIN_OWNERS"
        },
        "independent_verification": {
          "const": "SEPARATE_VERIFIER"
        },
        "physical_commissioning": {
          "const": "INDEPENDENT_MEASUREMENT_AND_COMPETENT_REVIEW_REQUIRED"
        },
        "release_authority": {
          "const": "COMPETENT_HUMAN_AUTHORITY"
        }
      }
    },
    "factory_architectures": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/architecture"
      }
    },
    "product_families": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "modules": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "scenario_families": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conformance_cases": {
      "type": "array",
      "minItems": 18,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "comparison_policies": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_id",
        "description",
        "main_tradeoff"
      ],
      "properties": {
        "architecture_id": {
          "enum": [
            "DEDICATED_LINE",
            "FUNCTIONAL_JOB_SHOP",
            "PRODUCT_FAMILY_U_CELL",
            "FLEXIBLE_MANUFACTURING_SYSTEM",
            "RECONFIGURABLE_MANUFACTURING_SYSTEM",
            "MULTIPURPOSE_MICROFACTORY",
            "DISTRIBUTED_PARTNER_NETWORK",
            "HYBRID_LOCAL_PARTNER_NETWORK",
            "MOBILE_CONTAINERIZED_FACTORY",
            "STAGED_INDUSTRIAL_SEED_FACTORY"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "main_tradeoff": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "required_capabilities",
        "claim_ceiling"
      ],
      "properties": {
        "product_id": {
          "enum": [
            "MECHANICAL_BRACKET",
            "STRUCTURAL_BUILDING_MODULE",
            "POWER_ELECTRONICS_ASSEMBLY",
            "TEXTILE_GARMENT",
            "PUMP_VALVE_MODULE",
            "ROBOTICS_REPLACEMENT_PART",
            "REPAIRED_OR_REMANUFACTURED_UNIT",
            "OFF_EARTH_NONPRESSURE_MEMBER",
            "PROCESS_INTERMEDIATE"
          ]
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_ceiling": {
          "enum": [
            "SYNTHETIC_ROUTE_ONLY",
            "FUTURE_MODEL_GATED_SYNTHETIC_ONLY"
          ]
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "process_family",
        "capabilities",
        "required_interfaces",
        "required_zones",
        "required_skills",
        "requires_calibration",
        "evidence_state"
      ],
      "properties": {
        "module_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]*$"
        },
        "process_family": {
          "enum": [
            "DISCRETE_ASSEMBLY",
            "SUBTRACTIVE_MACHINING",
            "POLYMER_ADDITIVE",
            "THERMAL_BATCH",
            "HIGH_VOLTAGE_TEST",
            "TEXTILE_CUT_SEW",
            "METROLOGY_INSPECTION",
            "REPAIR_REMANUFACTURE",
            "CONTINUOUS_CHEMICAL_PROCESS"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_interfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_zones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires_calibration": {
          "type": "boolean"
        },
        "evidence_state": {
          "const": "SYNTHETIC_PROFILE_ONLY"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "architecture_id",
        "product_id",
        "mutation",
        "expected_disposition",
        "expected_reason_codes"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]*$"
        },
        "architecture_id": {
          "type": "string",
          "minLength": 1
        },
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "mutation": {
          "type": "string",
          "minLength": 1
        },
        "expected_disposition": {
          "enum": [
            "ADMISSIBLE_SYNTHETIC",
            "NEEDS_EVIDENCE",
            "REJECT",
            "NOT_RECONFIGURED",
            "NOT_TRACEABLE",
            "OUT_OF_DOMAIN"
          ]
        },
        "expected_reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_]*$"
          }
        }
      }
    }
  }
}
