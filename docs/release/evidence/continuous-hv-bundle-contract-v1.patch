diff --git a/crates/core/symthaea-core/tests/continuous_hv_bundle_contract.rs b/crates/core/symthaea-core/tests/continuous_hv_bundle_contract.rs
new file mode 100644
--- /dev/null
+++ b/crates/core/symthaea-core/tests/continuous_hv_bundle_contract.rs
@@ -0,0 +1,120 @@
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+use symthaea_core::hdc::ContinuousHV;
+
+fn hv(values: &[f32]) -> ContinuousHV {
+    ContinuousHV::from_vec(values.to_vec())
+}
+
+fn panics(f: impl FnOnce()) -> bool {
+    catch_unwind(AssertUnwindSafe(f)).is_err()
+}
+
+#[test]
+fn borrowed_bundle_rejects_mixed_dimensions() {
+    let a = hv(&[1.0, 2.0, 3.0]);
+    let b = hv(&[4.0, 5.0]);
+    assert!(panics(|| {
+        let _ = ContinuousHV::bundle(&[&a, &b]);
+    }));
+}
+
+#[test]
+fn owned_bundle_rejects_mixed_dimensions() {
+    let a = hv(&[1.0, 2.0, 3.0]);
+    let b = hv(&[4.0, 5.0]);
+    assert!(panics(|| {
+        let _ = ContinuousHV::bundle_owned(&[a, b]);
+    }));
+}
+
+#[test]
+fn weighted_bundle_rejects_count_mismatch_in_both_directions() {
+    let a = hv(&[1.0, 2.0]);
+    let b = hv(&[3.0, 4.0]);
+    assert!(panics(|| {
+        let _ = ContinuousHV::weighted_bundle(&[&a, &b], &[1.0]);
+    }));
+    assert!(panics(|| {
+        let _ = ContinuousHV::weighted_bundle(&[&a], &[1.0, 2.0]);
+    }));
+    assert!(panics(|| {
+        let _ = ContinuousHV::weighted_bundle(&[], &[1.0]);
+    }));
+    assert!(panics(|| {
+        let _ = ContinuousHV::weighted_bundle(&[&a], &[]);
+    }));
+}
+
+#[test]
+fn weighted_bundle_rejects_mixed_dimensions() {
+    let a = hv(&[1.0, 2.0, 3.0]);
+    let b = hv(&[4.0, 5.0]);
+    assert!(panics(|| {
+        let _ = ContinuousHV::weighted_bundle(&[&a, &b], &[1.0, 1.0]);
+    }));
+}
+
+#[test]
+fn weighted_bundle_rejects_non_finite_weights() {
+    let a = hv(&[1.0, 2.0]);
+    for bad in [f32::NAN, f32::INFINITY, f32::NEG_INFINITY] {
+        assert!(panics(|| {
+            let _ = ContinuousHV::weighted_bundle(&[&a], &[bad]);
+        }));
+    }
+}
+
+#[test]
+fn weighted_bundle_rejects_zero_and_near_zero_signed_sum() {
+    let a = hv(&[1.0, 2.0]);
+    let b = hv(&[3.0, 4.0]);
+    assert!(panics(|| {
+        let _ = ContinuousHV::weighted_bundle(&[&a, &b], &[1.0, -1.0]);
+    }));
+    assert!(panics(|| {
+        let _ = ContinuousHV::weighted_bundle(&[&a], &[1.0e-11]);
+    }));
+}
+
+#[test]
+fn weighted_bundle_retains_finite_negative_weight_support() {
+    let a = hv(&[1.0, 2.0]);
+    let b = hv(&[3.0, 4.0]);
+    let result = ContinuousHV::weighted_bundle(&[&a, &b], &[2.0, -1.0]);
+    assert_eq!(result.values, vec![-1.0, 0.0]);
+}
+
+#[test]
+fn valid_bundle_and_weighted_bundle_keep_expected_math() {
+    let a = hv(&[1.0, 3.0]);
+    let b = hv(&[3.0, 5.0]);
+    assert_eq!(ContinuousHV::bundle(&[&a, &b]).values, vec![2.0, 4.0]);
+    assert_eq!(
+        ContinuousHV::weighted_bundle(&[&a, &b], &[1.0, 3.0]).values,
+        vec![2.5, 4.5]
+    );
+}
+
+#[test]
+fn empty_weighted_bundle_contract_remains_zero_default_dimension() {
+    let result = ContinuousHV::weighted_bundle(&[], &[]);
+    assert_eq!(result.dim(), ContinuousHV::DEFAULT_DIM);
+    assert!(result.values.iter().all(|value| *value == 0.0));
+}
+
+#[cfg(feature = "simd")]
+#[test]
+fn direct_simd_bundle_rejects_undefined_normalization() {
+    use symthaea_core::hdc::simd_continuous::bundle_simd;
+
+    let a = [1.0f32, 2.0];
+    let b = [3.0f32, 4.0];
+    let refs: [&[f32]; 2] = [&a, &b];
+    assert!(panics(|| {
+        let _ = bundle_simd(&refs, &[1.0, -1.0]);
+    }));
+    assert!(panics(|| {
+        let _ = bundle_simd(&refs, &[1.0]);
+    }));
+}
