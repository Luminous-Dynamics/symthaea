{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://luminousdynamics.org/schemas/wcare43-rfc3161-backend-policy-v1.json","title":"WCARE-43 RFC3161 Backend Policy","type":"object","additionalProperties":false,"properties":{"protocol_version":{"const":"wcare43-rfc3161-preregistration-verifier-v1"},"policy_id":{"type":"string","pattern":"^[A-Za-z0-9._:-]+$"},"backend_id":{"type":"string","pattern":"^[A-Za-z0-9._:-]+$"},"openssl_executable_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"openssl_version_output_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"trust_anchor_bundle_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"untrusted_bundle_sha256":{"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},"expected_tsa_signer_certificate_der_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"accepted_tsa_policy_labels":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"message_imprint_algorithm":{"const":"sha256"},"certificate_purpose":{"const":"timestampsign"},"revocation_mode":{"const":"OfflineStaticNoRevocation"},"allow_empty_untrusted_bundle":{"type":"boolean"},"synthetic_fixture_policy":{"type":"boolean"},"notes":{"type":"string"}},"required":["protocol_version","policy_id","backend_id","openssl_executable_sha256","openssl_version_output_sha256","trust_anchor_bundle_sha256","untrusted_bundle_sha256","expected_tsa_signer_certificate_der_sha256","accepted_tsa_policy_labels","message_imprint_algorithm","certificate_purpose","revocation_mode","allow_empty_untrusted_bundle","synthetic_fixture_policy"]}