{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/development-map/federation-v0.1.schema.json",
  "title": "EGDDM federation manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "federation_id",
    "observed_at",
    "hub",
    "shared_contract",
    "members",
    "relationships",
    "join_policy",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "federation_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "hub": {
      "$ref": "#/$defs/hub"
    },
    "shared_contract": {
      "$ref": "#/$defs/contract"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/member"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "join_policy": {
      "$ref": "#/$defs/join_policy"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "git_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_full_name",
        "default_branch",
        "subject_revision",
        "subject_tree_oid",
        "self_map_id",
        "self_map_path",
        "self_map_blob_oid"
      ],
      "properties": {
        "repository_full_name": {
          "type": "string",
          "minLength": 1
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "subject_revision": {
          "$ref": "#/$defs/git_oid"
        },
        "subject_tree_oid": {
          "$ref": "#/$defs/git_oid"
        },
        "self_map_id": {
          "type": "string",
          "minLength": 1
        },
        "self_map_path": {
          "type": "string",
          "minLength": 1
        },
        "self_map_blob_oid": {
          "$ref": "#/$defs/git_oid"
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "schema_path",
        "schema_blob_oid",
        "schema_artifact_commit_sha",
        "status",
        "claim_ceiling"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "schema_path": {
          "type": "string",
          "minLength": 1
        },
        "schema_blob_oid": {
          "$ref": "#/$defs/git_oid"
        },
        "schema_artifact_commit_sha": {
          "$ref": "#/$defs/git_oid"
        },
        "status": {
          "enum": [
            "provisional_unqualified",
            "schema_shape_checked",
            "independently_qualified"
          ]
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "tree_digest",
        "tree_digest_algorithm",
        "observed_at",
        "configuration_world"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/git_oid"
        },
        "tree_digest": {
          "$ref": "#/$defs/git_oid"
        },
        "tree_digest_algorithm": {
          "const": "git_tree_oid_sha1"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "configuration_world": {
          "type": "object"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository_full_name",
        "visibility",
        "default_branch",
        "role_summaries",
        "map"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "repository_full_name": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "internal",
            "unknown"
          ]
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "role_summaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "map": {
          "$ref": "#/$defs/map_artifact"
        }
      }
    },
    "map_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map_id",
        "path",
        "blob_oid",
        "artifact_branch",
        "artifact_commit_sha",
        "artifact_tree_oid",
        "artifact_url",
        "subject_snapshot",
        "authority_summary",
        "node_count",
        "edge_count",
        "claim_ceiling"
      ],
      "properties": {
        "map_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "blob_oid": {
          "$ref": "#/$defs/git_oid"
        },
        "artifact_branch": {
          "type": "string",
          "minLength": 1
        },
        "artifact_commit_sha": {
          "$ref": "#/$defs/git_oid"
        },
        "artifact_tree_oid": {
          "$ref": "#/$defs/git_oid"
        },
        "artifact_url": {
          "type": "string",
          "format": "uri"
        },
        "subject_snapshot": {
          "$ref": "#/$defs/source_snapshot"
        },
        "authority_summary": {
          "enum": [
            "source_declared_projection",
            "mixed_source_authority_projection",
            "unknown"
          ]
        },
        "node_count": {
          "type": "integer",
          "minimum": 1
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_project_id",
        "relation",
        "to_project_id",
        "status",
        "authority",
        "source_refs",
        "contract_binding",
        "claim_limitations"
      ],
      "properties": {
        "from_project_id": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "source_declared_integration",
            "declares_role_for",
            "shared_schema_candidate",
            "benchmark_composition"
          ]
        },
        "to_project_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "source_declared_unverified",
            "contract_versioned_unqualified",
            "independently_qualified"
          ]
        },
        "authority": {
          "enum": [
            "source_declared",
            "manifest_resolved",
            "compiler_resolved",
            "runtime_observed",
            "independently_adjudicated"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository_full_name",
              "path",
              "blob_oid",
              "line_start",
              "line_end"
            ],
            "properties": {
              "repository_full_name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "blob_oid": {
                "$ref": "#/$defs/git_oid"
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "contract_binding": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "contract_id",
            "version",
            "contract_blob_oid",
            "status"
          ],
          "properties": {
            "contract_id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "declared",
                "two_sided_match",
                "independently_conformance_tested"
              ]
            },
            "contract_blob_oid": {
              "$ref": "#/$defs/git_oid"
            }
          }
        },
        "claim_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "join_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map_identity",
        "cross_project_join",
        "authority_non_transfer",
        "claim_promotion",
        "staleness"
      ],
      "properties": {
        "map_identity": {
          "type": "string",
          "minLength": 1
        },
        "cross_project_join": {
          "type": "string",
          "minLength": 1
        },
        "authority_non_transfer": {
          "type": "string",
          "minLength": 1
        },
        "claim_promotion": {
          "type": "string",
          "minLength": 1
        },
        "staleness": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
