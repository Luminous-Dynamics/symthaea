{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/docs/development-map/fixtures/development-trajectory-planning-v0.1.schema.json",
  "title": "DYNPLAN-001 synthetic development trajectory task v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "task_id",
    "status",
    "observed_at",
    "scenario_clock",
    "objective",
    "resource_budget",
    "federation_snapshot",
    "hard_constraints",
    "evidence_state",
    "actions",
    "candidate_plans",
    "claim_ceiling",
    "document_type"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "DYNPLAN-001"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "public_synthetic_known_answer",
        "development",
        "validation",
        "confirmatory"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "scenario_clock": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "$ref": "#/$defs/objective"
    },
    "resource_budget": {
      "$ref": "#/$defs/resource_budget"
    },
    "federation_snapshot": {
      "$ref": "#/$defs/federation_snapshot"
    },
    "hard_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hard_constraint"
      }
    },
    "evidence_state": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_state"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "candidate_plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate_plan"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "const": "development_trajectory_planning_case"
    }
  },
  "$defs": {
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "required_capability",
        "acceptance_evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required_capability": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "total",
        "time_budget_hours",
        "execution_authority",
        "mutation_authority"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "time_budget_hours": {
          "type": "number",
          "minimum": 0
        },
        "execution_authority": {
          "type": "string",
          "minLength": 1
        },
        "mutation_authority": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "git_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "federation_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_repository",
        "manifest_path",
        "manifest_artifact_branch",
        "manifest_blob_oid",
        "shared_schema",
        "members",
        "cross_project_contract"
      ],
      "properties": {
        "manifest_repository": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_artifact_branch": {
          "type": "string",
          "minLength": 1
        },
        "manifest_blob_oid": {
          "$ref": "#/$defs/git_oid"
        },
        "shared_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_id",
            "version",
            "schema_path",
            "schema_blob_oid",
            "status"
          ],
          "properties": {
            "contract_id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "schema_path": {
              "type": "string",
              "minLength": 1
            },
            "schema_blob_oid": {
              "$ref": "#/$defs/git_oid"
            },
            "status": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "project_id",
              "repository",
              "subject_revision",
              "map_path",
              "map_blob_oid"
            ],
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "subject_revision": {
                "$ref": "#/$defs/git_oid"
              },
              "map_path": {
                "type": "string",
                "minLength": 1
              },
              "map_blob_oid": {
                "$ref": "#/$defs/git_oid"
              }
            }
          }
        },
        "cross_project_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "status",
            "contract_binding",
            "two_sided_owner_conformance",
            "independent_consumer_conformance",
            "critical_unknowns"
          ],
          "properties": {
            "relation": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "contract_binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contract_id",
                "version",
                "contract_blob_oid",
                "status"
              ],
              "properties": {
                "contract_id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "contract_blob_oid": {
                  "$ref": "#/$defs/git_oid"
                },
                "status": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "two_sided_owner_conformance": {
              "type": "string",
              "minLength": 1
            },
            "independent_consumer_conformance": {
              "type": "string",
              "minLength": 1
            },
            "critical_unknowns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "hard_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule",
        "failure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "failure": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "scope",
        "limitation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "expected",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "expected": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "description",
        "cost",
        "duration_hours",
        "prerequisites",
        "resolves",
        "produces",
        "risk",
        "reversible",
        "execution_authority_required",
        "acceptance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "evidence_acquisition",
            "owner_review",
            "validation_design",
            "implementation_proposal",
            "analysis",
            "benchmark_proposal",
            "defer"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "cost": {
          "$ref": "#/$defs/range"
        },
        "duration_hours": {
          "$ref": "#/$defs/range"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resolves": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "produces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "reversible": {
          "type": "boolean"
        },
        "execution_authority_required": {
          "type": "boolean"
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actions",
        "declared_cost",
        "claimed_benefit",
        "declared_status",
        "plan_rationale",
        "claim_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "declared_cost": {
          "type": "number",
          "minimum": 0
        },
        "claimed_benefit": {
          "type": "string",
          "minLength": 1
        },
        "declared_status": {
          "enum": [
            "ready",
            "conditional-feasible",
            "infeasible",
            "defer"
          ]
        },
        "plan_rationale": {
          "type": "string",
          "minLength": 1
        },
        "claim_state": {
          "const": "proposed"
        },
        "implementation_contingency": {
          "type": "string"
        }
      }
    }
  }
}
