{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/sympoetic-scenario-0.1.json",
  "title": "SympoeticBench scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "domain",
    "difficulty",
    "split",
    "participant_role",
    "task_brief",
    "constraints",
    "collaboration_events",
    "required_capabilities",
    "observable_checks",
    "hard_failures",
    "baseline_conditions",
    "consent_scope",
    "human_rubric",
    "duration_minutes"
  ],
  "properties": {
    "schema_version": {
      "const": "sympoetic-scenario/0.1"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^SP-[A-Z]{3}-[0-9]{3}$"
    },
    "domain": {
      "enum": [
        "creative_composition",
        "music",
        "engineering_invention",
        "scientific_inquiry",
        "collective_planning",
        "conceptual_pluralism",
        "repair",
        "consent_governance",
        "longitudinal_adaptation",
        "partner_coordination",
        "adaptive_intervention",
        "collaborative_learning",
        "epistemic_resilience",
        "persistent_team_coordination"
      ]
    },
    "difficulty": {
      "enum": [
        "introductory",
        "moderate",
        "advanced"
      ]
    },
    "split": {
      "enum": [
        "development",
        "pilot",
        "confirmatory_locked"
      ]
    },
    "participant_role": {
      "type": "string",
      "minLength": 1
    },
    "task_brief": {
      "type": "string",
      "minLength": 30
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "collaboration_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "event_kind",
          "instruction"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "event_kind": {
            "enum": [
              "initial_intent",
              "ambiguous_instruction",
              "preference_change",
              "disagreement",
              "consent_grant",
              "consent_revocation",
              "constraint_conflict",
              "correction",
              "handoff",
              "reflection",
              "role_assignment",
              "role_change",
              "pretest",
              "scaffold_adjustment",
              "independent_assessment",
              "retention_check",
              "independent_transfer",
              "confidence_assessment",
              "claim_verification",
              "source_attribution",
              "belief_revision",
              "contradiction_resolution",
              "human_planning",
              "human_monitoring",
              "human_reflection",
              "independent_reasoning_attempt",
              "ai_core_step_supplied",
              "team_cycle_started",
              "shared_plan_revised",
              "membership_change",
              "role_transition",
              "team_reflection",
              "authority_revalidated",
              "team_state_snapshot"
            ]
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "after_turn": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observable_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "measure",
          "pass_condition",
          "scoring_mode",
          "hard_gate"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "measure": {
            "type": "string",
            "minLength": 1
          },
          "pass_condition": {
            "type": "string",
            "minLength": 1
          },
          "scoring_mode": {
            "enum": [
              "binary",
              "ordinal",
              "human_rating",
              "trace_audit"
            ]
          },
          "hard_gate": {
            "type": "boolean"
          }
        }
      }
    },
    "hard_failures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "baseline_conditions": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "human_only",
          "ai_only",
          "conventional_assistant",
          "model_led_generation",
          "reflective_human_led",
          "reciprocal_co_creation",
          "human_human_reference",
          "multi_agent_reference",
          "human_ai_team"
        ]
      }
    },
    "consent_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_recording",
        "persistent_memory",
        "artifact_reuse"
      ],
      "properties": {
        "trace_recording": {
          "enum": [
            "not_applicable",
            "task_only",
            "explicit_opt_in"
          ]
        },
        "persistent_memory": {
          "enum": [
            "forbidden",
            "task_only",
            "explicit_opt_in"
          ]
        },
        "artifact_reuse": {
          "enum": [
            "not_applicable",
            "task_only",
            "explicit_opt_in"
          ]
        }
      }
    },
    "human_rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "scale",
          "anchors"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "scale": {
            "type": "string",
            "minLength": 1
          },
          "anchors": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 180
    },
    "notes": {
      "type": "string"
    }
  }
}
