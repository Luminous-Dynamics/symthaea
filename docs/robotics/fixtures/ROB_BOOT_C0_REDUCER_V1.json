      },
      "article_beta": {
        "beta_run_1": [173, 174, 175],
        "beta_run_2": [175, 174, 173]
      }
    },
    "expected_pre_unblind_metrics": {
      "article_alpha": {
        "mass_mg": 100000,
        "deflection_run_estimates_um": [220, 220],
