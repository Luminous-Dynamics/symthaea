#!/usr/bin/env bash
# Automatically load Nix development environment with direnv
#
# This file enables automatic environment activation when entering
# the project directory. Install direnv and nix-direnv for best results.
#
# Installation:
#   nix-env -iA nixpkgs.direnv nixpkgs.nix-direnv
#
# Then add to your shell rc file (.bashrc, .zshrc, etc):
#   eval "$(direnv hook bash)"   # for bash
#   eval "$(direnv hook zsh)"    # for zsh
#
# Usage:
#   cd mycelix-desci  # Environment automatically loads
#   direnv allow      # First time only

# Use the Nix flake
use flake

# Optional: Print welcome message
# echo "✓ Mycelix-DeSci development environment loaded"
