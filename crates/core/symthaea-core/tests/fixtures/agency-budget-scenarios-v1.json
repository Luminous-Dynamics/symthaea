        "autonomy_preference_probabilities": [0.05, 0.1, 0.85],
        "agency_budget": 0.25
      },
      "expected_status": "autonomy_proposal_constrained",
      "expected_user_only_candidate_id": "reach",
      "expected_unconstrained_autonomy_candidate_id": "rest",
      "expected_selected_candidate_id": "place",
      "expected_selected_agency_loss_index": 0.25
    },
    {
      "id": "AGY-003-zero-budget-preserves-top-intent",
