      "expected_status": "autonomy_proposal_admitted",
      "expected_user_only_candidate_id": "left",
      "expected_unconstrained_autonomy_candidate_id": "right",
      "expected_selected_candidate_id": "right",
      "expected_selected_agency_loss_index": 0.0
    },
    {
      "id": "AGY-004-full-budget-admits-unconstrained-proposal",
      "request": {
        "schema_version": 1,
        "candidate_ids": ["reach", "place", "rest"],
