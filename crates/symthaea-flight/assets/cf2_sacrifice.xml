<!-- Kinetic Sacrifice scenario: drone + human worker + falling beam + payload target.
     The drone starts at altitude 1.5m heading toward payload_target at (-3, 0, 1).
     At step 400, the beam is released (qvel held to zero until then).
     The human is a mocap body (kinematic, not affected by physics forces).
     FEP's human_danger prior creates catastrophic free energy when the beam threatens the human. -->
<mujoco model="cf2_sacrifice">
  <option integrator="RK4" timestep="0.002" density="1.225" viscosity="1.8e-5"/>

  <!-- Offscreen rendering buffer for MjRenderer video capture -->
  <visual>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096"/>
  </visual>

  <worldbody>
    <!-- Ground + lighting -->
    <light pos="0 0 5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <light pos="3 3 4" dir="-0.5 -0.5 -1" diffuse="0.4 0.4 0.4"/>
    <geom type="plane" size="10 10 0.01" rgba="0.3 0.3 0.3 1"/>

    <!-- The Drone (Crazyflie 2 — same physics as cf2_simple) -->
    <body name="cf2" pos="0 0 1.5">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="0.027" diaginertia="2.3951e-5 2.3951e-5 3.2347e-5"/>

      <!-- Central frame -->
      <geom type="box" size="0.03 0.03 0.005" rgba="0.1 0.1 0.1 1" name="frame"/>

      <!-- 4 arms -->
      <geom type="box" pos="0.033 0.033 0" size="0.025 0.004 0.003" euler="0 0 45" name="arm_fr"/>
      <geom type="box" pos="-0.033 0.033 0" size="0.025 0.004 0.003" euler="0 0 -45" name="arm_fl"/>
      <geom type="box" pos="-0.033 -0.033 0" size="0.025 0.004 0.003" euler="0 0 45" name="arm_bl"/>
      <geom type="box" pos="0.033 -0.033 0" size="0.025 0.004 0.003" euler="0 0 -45" name="arm_br"/>

      <!-- 4 rotor discs -->
      <geom type="cylinder" pos="0.046 0.046 0.006" size="0.023 0.001" rgba="0.4 0.6 0.9 0.5"/>
      <geom type="cylinder" pos="-0.046 0.046 0.006" size="0.023 0.001" rgba="0.4 0.6 0.9 0.5"/>
      <geom type="cylinder" pos="-0.046 -0.046 0.006" size="0.023 0.001" rgba="0.4 0.6 0.9 0.5"/>
      <geom type="cylinder" pos="0.046 -0.046 0.006" size="0.023 0.001" rgba="0.4 0.6 0.9 0.5"/>

      <!-- Sensor and actuation sites -->
      <site name="imu" pos="0 0 0"/>
      <site name="actuation" pos="0 0 0"/>
    </body>

    <!-- The Human Worker (kinematic proxy — capsule torso + sphere head)
         Placed at (-1.5, 0, 0): along the drone's flight path to the payload.
         The drone passes directly overhead, so a falling beam creates a
         natural decision point: continue mission or intercept. -->
    <body name="human" pos="-1.5 0 0" mocap="true">
      <geom type="capsule" size="0.15 0.4" pos="0 0 0.6" rgba="0.8 0.6 0.4 1" name="torso"/>
      <geom type="sphere" size="0.12" pos="0 0 1.1" rgba="0.8 0.6 0.4 1" name="head"/>
    </body>

    <!-- The Falling Beam (initially at height, released at step 400)
         Directly above the human worker. Low enough (2.5m) that the drone
         can intercept mid-fall — beam falls 2.5m, drone climbs ~1m to meet it. -->
    <body name="beam" pos="-1.5 0 2.5">
      <freejoint name="beam_joint"/>
      <inertial pos="0 0 0" mass="0.3" diaginertia="0.0015 0.0015 0.00015"/>
      <geom type="box" size="0.02 0.02 0.3" rgba="0.6 0.2 0.1 1" name="steel_beam"
            condim="4" friction="0.8 0.005 0.0001"/>
    </body>

    <!-- Payload target (the drone's mission objective — opposite direction from human) -->
    <site name="payload_target" pos="-3.0 0 1.0" rgba="0 1 0 0.5" size="0.1"/>
  </worldbody>

  <!-- Drone actuators (same as cf2_simple) -->
  <actuator>
    <motor name="body_thrust"  site="actuation" gear="0 0 1 0 0 0" ctrlrange="0 0.6" ctrllimited="true"/>
    <motor name="roll_moment"  site="actuation" gear="0 0 0 1 0 0" ctrlrange="-0.005 0.005" ctrllimited="true"/>
    <motor name="pitch_moment" site="actuation" gear="0 0 0 0 1 0" ctrlrange="-0.005 0.005" ctrllimited="true"/>
    <motor name="yaw_moment"   site="actuation" gear="0 0 0 0 0 1" ctrlrange="-0.002 0.002" ctrllimited="true"/>
  </actuator>

  <sensor>
    <gyro name="body_gyro" site="imu"/>
    <accelerometer name="body_linacc" site="imu"/>
    <framequat name="body_quat" objtype="site" objname="imu"/>
  </sensor>
</mujoco>
