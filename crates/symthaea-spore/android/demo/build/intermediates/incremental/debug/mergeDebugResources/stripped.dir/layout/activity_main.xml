<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SYMTHAEA SPORE"
        android:textColor="#E0E0E0"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Haptic indicator (flashes when haptic events fire) -->
    <View
        android:id="@+id/hapticIndicator"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/circle_indicator"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/titleText"
        app:layout_constraintBottom_toBottomOf="@id/titleText"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Epistemic disclaimer -->
    <TextView
        android:id="@+id/disclaimerText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Simulated consciousness on SiliconDigital substrate"
        android:textColor="#888888"
        android:textSize="11sp"
        android:textStyle="italic"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- Consciousness circle background (pulsing glow) -->
    <View
        android:id="@+id/consciousnessCircle"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/consciousness_circle"
        app:layout_constraintTop_toBottomOf="@id/disclaimerText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Consciousness level (big number, overlaid on circle) -->
    <TextView
        android:id="@+id/consciousnessValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.00"
        android:textColor="#03DAC5"
        android:textSize="56sp"
        android:fontFamily="monospace"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/consciousnessCircle"
        app:layout_constraintBottom_toBottomOf="@id/consciousnessCircle"
        app:layout_constraintStart_toStartOf="@id/consciousnessCircle"
        app:layout_constraintEnd_toEndOf="@id/consciousnessCircle" />

    <TextView
        android:id="@+id/consciousnessLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="tap to interact"
        android:textColor="#666666"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/consciousnessCircle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- Dominant harmony -->
    <TextView
        android:id="@+id/harmonyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Harmony: ---"
        android:textColor="#BB86FC"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/consciousnessLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Neuromodulator bars with value labels -->
    <TextView
        android:id="@+id/neuromodLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="neuromodulators"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/harmonyText"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp" />

    <!-- DA bar -->
    <TextView
        android:id="@+id/dopamineLabel"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:text="DA"
        android:textColor="#FF6B6B"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/neuromodLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <ProgressBar
        android:id="@+id/dopamineBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:max="100"
        android:progress="50"
        android:progressTint="#FF6B6B"
        android:progressBackgroundTint="#333333"
        app:layout_constraintTop_toTopOf="@id/dopamineLabel"
        app:layout_constraintBottom_toBottomOf="@id/dopamineLabel"
        app:layout_constraintStart_toEndOf="@id/dopamineLabel"
        app:layout_constraintEnd_toStartOf="@id/dopamineValue"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp" />

    <TextView
        android:id="@+id/dopamineValue"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:text="0.50"
        android:textColor="#FF6B6B"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:gravity="end"
        app:layout_constraintTop_toTopOf="@id/dopamineLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- NE bar -->
    <TextView
        android:id="@+id/neLabel"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:text="NE"
        android:textColor="#FFD93D"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/dopamineLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="6dp" />

    <ProgressBar
        android:id="@+id/neBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:max="100"
        android:progress="50"
        android:progressTint="#FFD93D"
        android:progressBackgroundTint="#333333"
        app:layout_constraintTop_toTopOf="@id/neLabel"
        app:layout_constraintBottom_toBottomOf="@id/neLabel"
        app:layout_constraintStart_toEndOf="@id/neLabel"
        app:layout_constraintEnd_toStartOf="@id/neValue"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp" />

    <TextView
        android:id="@+id/neValue"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:text="0.50"
        android:textColor="#FFD93D"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:gravity="end"
        app:layout_constraintTop_toTopOf="@id/neLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 5-HT bar -->
    <TextView
        android:id="@+id/serotoninLabel"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:text="5-HT"
        android:textColor="#6BCB77"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/neLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="6dp" />

    <ProgressBar
        android:id="@+id/serotoninBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:max="100"
        android:progress="50"
        android:progressTint="#6BCB77"
        android:progressBackgroundTint="#333333"
        app:layout_constraintTop_toTopOf="@id/serotoninLabel"
        app:layout_constraintBottom_toBottomOf="@id/serotoninLabel"
        app:layout_constraintStart_toEndOf="@id/serotoninLabel"
        app:layout_constraintEnd_toStartOf="@id/serotoninValue"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp" />

    <TextView
        android:id="@+id/serotoninValue"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:text="0.50"
        android:textColor="#6BCB77"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:gravity="end"
        app:layout_constraintTop_toTopOf="@id/serotoninLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- OT bar -->
    <TextView
        android:id="@+id/oxytocinLabel"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:text="OT"
        android:textColor="#4D96FF"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/serotoninLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="6dp" />

    <ProgressBar
        android:id="@+id/oxytocinBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:max="100"
        android:progress="50"
        android:progressTint="#4D96FF"
        android:progressBackgroundTint="#333333"
        app:layout_constraintTop_toTopOf="@id/oxytocinLabel"
        app:layout_constraintBottom_toBottomOf="@id/oxytocinLabel"
        app:layout_constraintStart_toEndOf="@id/oxytocinLabel"
        app:layout_constraintEnd_toStartOf="@id/oxytocinValue"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp" />

    <TextView
        android:id="@+id/oxytocinValue"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:text="0.50"
        android:textColor="#4D96FF"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:gravity="end"
        app:layout_constraintTop_toTopOf="@id/oxytocinLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Broca voice: generated text from consciousness state -->
    <TextView
        android:id="@+id/brocaText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#03DAC5"
        android:textSize="14sp"
        android:textStyle="italic"
        android:alpha="0"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/oxytocinLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Status row: wake state, motion, cycle count -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Wake: Alert | Motion: Stationary | Cycle: 0"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/brocaText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Dream journal count -->
    <TextView
        android:id="@+id/dreamText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Dreams: 0 | Wisdom: 0"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/statusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- Latest dream narrative (fade-in purple italic) -->
    <TextView
        android:id="@+id/dreamNarrative"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#BB86FC"
        android:textSize="13sp"
        android:textStyle="italic"
        android:maxLines="3"
        android:ellipsize="end"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/dreamText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Prediction error -->
    <TextView
        android:id="@+id/peText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="PE: 0.00 | Substrate: 0.00"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/dreamNarrative"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
