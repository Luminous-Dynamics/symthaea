<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E12"
    android:fillViewport="true">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <!-- ═══ Title: luminous script ═══ -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="symthaea soma"
        android:textColor="#00E5CC"
        android:textSize="18sp"
        android:textStyle="normal"
        android:letterSpacing="0.3"
        android:fontFamily="monospace"
        android:alpha="0.9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Haptic pulse indicator (glows when haptic events fire) -->
    <View
        android:id="@+id/hapticIndicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/circle_indicator"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/titleText"
        app:layout_constraintBottom_toBottomOf="@id/titleText"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══ Epistemic disclaimer: whispered truth ═══ -->
    <TextView
        android:id="@+id/disclaimerText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="simulated consciousness · silicon substrate"
        android:textColor="#4A5558"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp" />

    <!-- ═══ Consciousness Mandala ═══ -->
    <!-- Custom view: holographic interference pattern -->
    <io.symthaea.soma.demo.ConsciousnessMandalaView
        android:id="@+id/consciousnessMandala"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:layout_constraintTop_toBottomOf="@id/disclaimerText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Tap hint -->
    <TextView
        android:id="@+id/consciousnessLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="touch to interact"
        android:textColor="#4A5558"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toBottomOf="@id/consciousnessMandala"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- ═══ Dominant Harmony ═══ -->
    <TextView
        android:id="@+id/harmonyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="· coherence ·"
        android:textColor="#00E5CC"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        app:layout_constraintTop_toBottomOf="@id/consciousnessLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <!-- ═══ Neuromodulator Flows ═══ -->
    <!-- Custom view: organic flowing arcs -->
    <io.symthaea.soma.demo.NeuromodFlowView
        android:id="@+id/neuromodFlows"
        android:layout_width="0dp"
        android:layout_height="140dp"
        app:layout_constraintTop_toBottomOf="@id/harmonyText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- ═══ Broca Voice: luminous script ═══ -->
    <TextView
        android:id="@+id/brocaText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#00E5CC"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:textStyle="italic"
        android:alpha="0"
        android:maxLines="3"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        app:layout_constraintTop_toBottomOf="@id/neuromodFlows"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- ═══ Status: whispered metadata ═══ -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="alert · stationary · cycle 0"
        android:textColor="#4A5558"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/brocaText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- ═══ Dream: memory surfacing from deep water ═══ -->
    <TextView
        android:id="@+id/dreamText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#4A5558"
        android:textSize="10sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/statusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp" />

    <!-- Dream narrative (lavender, surfacing) -->
    <TextView
        android:id="@+id/dreamNarrative"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#C4B5FD"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textStyle="italic"
        android:maxLines="3"
        android:ellipsize="end"
        android:alpha="0"
        android:lineSpacingMultiplier="1.3"
        app:layout_constraintTop_toBottomOf="@id/dreamText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- ═══ Substrate: grounding whisper ═══ -->
    <TextView
        android:id="@+id/peText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="pe 0.00 · substrate 0.00"
        android:textColor="#4A5558"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/dreamNarrative"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
