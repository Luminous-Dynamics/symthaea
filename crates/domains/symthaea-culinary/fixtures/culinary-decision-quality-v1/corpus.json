{
  "corpus_id": "culinary-decision-quality-voi-v1",
  "corpus_version": "1.0.0",
  "evidence_class": "synthetic_contract_fixture",
  "not_real_world_data": true,
  "warning": "This corpus defines deterministic contract behavior only. Values, markets, candidates, and hidden truths are synthetic; it establishes no nutritional adequacy, food safety, calibration, or household benefit claim.",
