{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/NutrientProcessBindingV1.schema.json",
  "title": "NutrientProcessBindingV1",
  "description": "Cross-reference manifest binding ingredient nutrient accounting to process-trace input/output streams. Does not qualify nutrition or mass balance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "final_product_stream_id", "ingredient_stream_bindings"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "trace_id": { "type": "string", "minLength": 1 },
    "final_product_stream_id": { "type": "string", "minLength": 1 },
    "ingredient_stream_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ingredient_id", "stream_id"],
        "properties": {
          "ingredient_id": { "type": "string", "minLength": 1 },
          "stream_id": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}