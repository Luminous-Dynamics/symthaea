{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CulinaryEvidenceBundleV1.schema.json",
  "title": "Culinary Content-Addressed Evidence Bundle V1",
  "description": "Exact-byte manifest binding a paired culinary experiment to protocol, process traces, and outcome evidence. Integrity verification is distinct from issuer authentication or scientific validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "experiment_id",
    "protocol_sha256",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_kind",
        "path",
        "source_ref",
        "source_version",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_kind": {
          "enum": [
            "protocol",
            "process_trace",
            "raw_measurement",
            "derived_outcome",
            "instrument_calibration",
            "other"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!~)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*\\/$)(?!.*(?:^|/)\\.\\.?($|/))[^\\x00-\\x1F\\x7F]+$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
