{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CulinaryExperimentV1.schema.json",
  "title": "Culinary paired experiment v1",
  "description": "A preregistered paired control/variant cooking experiment. Structural conformance does not establish causality, source authenticity, or food safety.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "protocol_id",
    "protocol_version",
    "protocol_sha256",
    "preregistered_at",
    "control_condition_id",
    "variant_condition_id",
    "outcome_definitions",
    "blocks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "preregistered_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "control_condition_id": {
      "type": "string",
      "minLength": 1
    },
    "variant_condition_id": {
      "type": "string",
      "minLength": 1
    },
    "outcome_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/outcomeDefinition"
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "source_version",
        "known_at",
        "evidence_status"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "known_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "evidence_status": {
          "enum": [
            "synthetic",
            "unreviewed",
            "reviewed",
            "qualified"
          ]
        }
      }
    },
    "outcomeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id",
        "unit",
        "direction",
        "target_value",
        "description"
      ],
      "properties": {
        "outcome_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "minimize",
            "maximize",
            "target",
            "observe"
          ]
        },
        "target_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id",
        "status",
        "value",
        "lower",
        "upper",
        "unit",
        "method",
        "unknown_reason",
        "evidence"
      ],
      "properties": {
        "outcome_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "observed",
            "estimated",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "lower": {
          "type": [
            "number",
            "null"
          ]
        },
        "upper": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "unknown_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "condition_id",
        "execution_order",
        "process_trace_id",
        "started_at",
        "ended_at",
        "outcomes"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "condition_id": {
          "type": "string",
          "minLength": 1
        },
        "execution_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "process_trace_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/measurement"
          }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "randomization_seed",
        "randomized_order",
        "runs",
        "randomization_method"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "randomization_seed": {
          "type": "string",
          "minLength": 1
        },
        "randomized_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "randomization_method": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
