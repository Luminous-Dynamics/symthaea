    "general_voi_issue": 10143,
    "cave_sensing_issue": 10822,
    "battery_voi_reference_issue": 11277
  },
  "baseline_ladder": [
    "no_test_current_evidence",
    "fixed_periodic_or_fixed_coverage",
    "deterministic_risk_threshold_rule",
    "random_eligible_observation",
    "maximum_predictive_entropy",
    "expected_information_gain",
    "myopic_evsi",
    "finite_horizon_contingent_evsi",
    "same_policy_independent_multi_model_referee",
    "human_or_specialist_matched_budget"
  ],
  "task_adapters": [
    {
      "id": "PIPE-CABLE",
      "issue": 12609,
      "hypotheses": [
        "serviceable_within_declared_scope",
        "low_severity_defect",
        "consequential_defect",
        "multiple_or_interacting_defects",
        "unknown_or_unobservable"
      ],
      "candidate_observations": [
        "additional_rgb_depth_lidar_view",
        "thermal_scan",
        "acoustic_vibration",
        "qualified_electromagnetic_inspection",
        "separate_sensor_pose",
        "human_specialist_review"
      ],
      "decision_options": [
        "monitor_until_expiry",
        "gather_additional_evidence",
        "unknown_hold",
        "specialist_review",
        "present_approved_maintenance_package"
      ],
      "non_authorities": [
        "electrical_isolation",
        "repair_authorization",
        "field_closeout"
      ]
    },
    {
      "id": "DRAWPOINT-VOLUME",
      "issue": 12609,
      "hypotheses": [
        "no_blockage_in_declared_coverage",
        "small_blockage_band",
        "large_blockage_band",
        "ambiguous_topology",
        "unknown_due_to_occlusion_or_invalid_geometry"
      ],
      "candidate_observations": [
        "new_stand_off_viewpoint",
        "alternate_scan_geometry",
        "second_lidar_depth_observation",
        "specialist_volumetric_assessment"
      ],
      "decision_options": [
        "retain_unknown_blocked",
        "gather_additional_views",
        "human_review",
        "bounded_volume_estimate_for_downstream_decision"
      ],
      "non_authorities": [
        "entry_permission",
        "blasting",
        "dislodging",
        "manipulation",
        "clearance_to_proceed"
      ]
    },
    {
      "id": "SUPPORT-VERIFICATION",
      "issue": 12606,
      "hypotheses": [
        "postcondition_met",
        "measurable_nonconformance",
        "partial_installation",
        "damaged_element",
        "insufficient_or_occluded_evidence"
      ],
      "candidate_observations": [
        "independent_metrology",
        "alternate_modality",
        "separate_inspection_pose",
        "specialist_review"
      ],
      "decision_options": [
        "accept_declared_postconditions_only",
        "reject",
        "gather_additional_evidence",
        "hold_for_engineering_disposition"
      ],
      "non_authorities": [
        "structural_adequacy_signoff",
        "design_change",
        "self_closeout"
      ]
    }
  ],
  "scenario_cases": [
