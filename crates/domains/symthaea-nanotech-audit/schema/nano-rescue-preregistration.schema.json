{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:symthaea:nano-rescue-preregistration:v1",
  "title": "NANO-013 pre-run evaluation receipt",
  "description": "The receipt binds policy revision, sampling frame, method and seed commitment. A local hash is not an independent timestamp or signature.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "policy_revision_sha256", "sampling_frame_sha256", "seed_commitment_sha256", "sampling_method", "frame_population_size", "frozen_before_policy_run", "policy_blind"],
  "properties": {
    "schema_version": {"const": "nano-rescue-preregistration-v1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "policy_revision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sampling_frame_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "seed_commitment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sampling_method": {"enum": ["simple_random_without_replacement", "stratified_random_without_replacement"]},
    "frame_population_size": {"type": "integer", "minimum": 1},
    "frozen_before_policy_run": {"const": true},
    "policy_blind": {"const": true}
  }
}
