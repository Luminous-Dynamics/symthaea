{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:symthaea:nano-rescue-audit-sampling:v1",
  "title": "NANO-013 independent, policy-blind audit sampling manifest",
  "description": "The manifest declares a probability sample independent from controller-triggered requests. The Rust verifier reconstructs counts and inclusion probabilities. Local declarations do not independently attest when the manifest was frozen.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "evaluation_id", "policy_revision_sha256", "sampling_frame_path", "sampling_frame_sha256", "preregistration_receipt_path", "manifest_visibility", "seed_reveal_path", "seed_commitment_sha256", "frame_population_size", "sampling_method", "frozen_before_policy_run", "policy_blind", "strata", "sampled_windows"],
  "properties": {
    "schema_version": {"const": "nano-rescue-audit-sampling-v1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "evaluation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "policy_revision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sampling_frame_path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "sampling_frame_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "preregistration_receipt_path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "manifest_visibility": {"const": "evaluator_sealed_until_policy_run_complete"},
    "seed_reveal_path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "seed_commitment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "frame_population_size": {"type": "integer", "minimum": 1},
    "sampling_method": {"enum": ["simple_random_without_replacement", "stratified_random_without_replacement"]},
    "frozen_before_policy_run": {"const": true},
    "policy_blind": {"const": true},
    "strata": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stratum_id", "eligible_count", "sampled_count", "inclusion_probability"],
        "properties": {
          "stratum_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "eligible_count": {"type": "integer", "minimum": 1},
          "sampled_count": {"type": "integer", "minimum": 1},
          "inclusion_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "For simple random sampling without replacement within this stratum, n_h/N_h."}
        }
      }
    },
    "sampled_windows": {
      "type": "array", "minItems": 1, "maxItems": 1000000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["window_id", "parent_group_id", "trajectory_id", "stratum_id", "inclusion_probability"],
        "properties": {
          "window_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "parent_group_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "trajectory_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "stratum_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "inclusion_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"sampling_method": {"const": "simple_random_without_replacement"}}, "required": ["sampling_method"]}, "then": {"properties": {"strata": {"maxItems": 1}}}}
  ]
}
