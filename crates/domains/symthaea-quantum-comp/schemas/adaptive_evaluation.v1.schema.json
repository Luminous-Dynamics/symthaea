{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "symthaea.quantum_comp.adaptive_evaluation.v1",
  "title": "QARCH-017 adaptive evaluation reservation",
  "description": "External ledger envelope. The Rust policy types in this increment are dependency-free and require an adapter to serialize this wire contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan", "request", "expected_ledger_revision"],
  "properties": {
    "schema_version": {
      "const": "symthaea.quantum_comp.adaptive_evaluation.v1"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_family_id",
        "comparison_protocol_digest",
        "baseline_digest",
        "acceptance_verifier_digest",
        "confirmatory_family_set_digest",
        "frozen_candidate_manifest_digest",
        "max_validation_queries_per_family_set"
      ],
      "properties": {
        "claim_family_id": { "type": "string", "minLength": 1 },
        "comparison_protocol_digest": { "type": "string", "minLength": 1 },
        "baseline_digest": { "type": "string", "minLength": 1 },
        "acceptance_verifier_digest": { "type": "string", "minLength": 1 },
        "confirmatory_family_set_digest": { "type": "string", "minLength": 1 },
        "frozen_candidate_manifest_digest": { "type": "string", "minLength": 1 },
        "max_validation_queries_per_family_set": { "type": "integer", "minimum": 1 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_id",
        "claim_family_id",
        "lane",
        "candidate_manifest_digest",
        "parent_candidate_manifest_digest",
        "benchmark_family_set_digest",
        "comparison_protocol_digest",
        "baseline_digest",
        "acceptance_verifier_digest",
        "query_ordinal"
      ],
      "properties": {
        "evaluation_id": { "type": "string", "minLength": 1 },
        "claim_family_id": { "type": "string", "minLength": 1 },
        "lane": {
          "enum": ["development", "validation", "confirmatory", "sequential"]
        },
        "candidate_manifest_digest": { "type": "string", "minLength": 1 },
        "parent_candidate_manifest_digest": {
          "type": ["string", "null"]
        },
        "benchmark_family_set_digest": { "type": "string", "minLength": 1 },
        "comparison_protocol_digest": { "type": "string", "minLength": 1 },
        "baseline_digest": { "type": "string", "minLength": 1 },
        "acceptance_verifier_digest": { "type": "string", "minLength": 1 },
        "query_ordinal": { "type": "integer", "minimum": 1 }
      }
    },
    "expected_ledger_revision": {
      "type": "integer",
      "minimum": 0
    }
  }
}
