{
  "schemaVersion": "0.1",
  "title": "HDC Store vector payload page-locality model",
  "evidenceClass": "analytical_virtual_page_intersection_model_not_benchmark",
  "purpose": "Exact count of virtual page intersections for fixed-length BinaryHV payload accesses in current HdcStore format-v2 versus a hypothetical page-aligned packed payload layout.",
  "sourceConstants": {
    "headerPageSizeBytes": 4096,
    "headerPages": 2,
    "dataOffsetBytes": 8192,
    "entrySizeBytes": 2080,
    "payloadOffsetWithinEntryBytes": 32,
    "payloadBytes": 2048
  },
  "limitations": [
    "This counts virtual-page intersections for the payload byte range only; it does not predict page-cache misses, page faults, filesystem block reads, NVMe physical I/O, NAND read amplification, latency, throughput, energy or speedup.",
    "The packed candidate keeps the same logical records but puts the 2048-byte payloads in a page-aligned array and moves metadata/ID mapping elsewhere; metadata RAM and lookup/indirection overhead are not modeled.",
    "Current v2 on-disk format remains unchanged. This model does not authorize a migration or a format-v3 implementation.",
    "A 2 MiB page-size case is theoretical only. Do not assume transparent huge pages apply to file-backed mmap; verify the actual host mapping behavior.",
    "Different architectures have different base page sizes; use the appropriate profile and actual OS page size when measuring.",
    "Per-payload page intersections count touched virtual pages for each individual vector access and can count a page more than once across adjacent records. Separate unique-page counts are included for a full sequential scan. Neither metric is a page-fault or physical-I/O count.",
    "The structure-of-arrays (SoA) candidate's open-time metadata page-count improvement assumes the read-only opener can validate IDs/status from the packed metadata section without touching the payload section. Actual page faults and device I/O are not modeled."
  ],
  "calculation": {
    "payloadPageIntersections": "floor((offset + payload_bytes - 1) / page_size) - floor(offset / page_size) + 1",
    "v2StartOffset": "(data_offset_bytes + payload_offset_within_entry_bytes + index * entry_size_bytes) mod page_size",
    "candidateStartOffset": "index * payload_bytes mod page_size",
    "v2PeriodEntries": "page_size / gcd(entry_size_bytes, page_size)",
    "candidatePeriodEntries": "page_size / gcd(payload_bytes, page_size)",
    "uniquePagesFullSequentialScan": "floor((last_payload_byte) / page_size) - floor((first_payload_byte) / page_size) + 1",
    "v2MetadataScanUniquePages": "floor((data_offset + (vector_count - 1) * entry_size + 8) / page_size) - floor(data_offset / page_size) + 1; assumes each status/ID probe lands in every page across the metadata scan span (true for the supplied profiles because entry stride is less than page size).",
    "soaMetadataScanUniquePages": "floor((data_offset + vector_count * metadata_record_bytes - 1) / page_size) - floor(data_offset / page_size) + 1",
    "soaPayloadBase": "ceil((data_offset + vector_count * metadata_record_bytes) / page_size) * page_size",
    "soaPayloadUniquePages": "ceil(vector_count * payload_bytes / page_size), assuming payload_base is page-aligned and page_size is a multiple of payload_bytes"
  },
