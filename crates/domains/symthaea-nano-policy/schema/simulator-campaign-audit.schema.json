{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:symthaea:nano:simulator-campaign-audit:v1",
  "title": "Nanotechnology simulator-budget campaign audit",
  "description": "Report for campaign seed roster, run-ledger digest, identity and actual-call budget reconciliation. Does not establish statistical power or scientific validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_sha256",
    "campaign_id",
    "benchmark_id",
    "expected_simulator_calls",
    "proposal_attempt_cap",
    "cost_unit",
    "expected_seeds",
    "expected_seed_count",
    "expected_run_count",
    "referenced_run_count",
    "verified_run_count",
    "duplicate_run_ids",
    "arms",
    "audit_pass",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "nano-simulator-campaign-audit-v1"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_simulator_calls": {
      "type": "integer",
      "minimum": 1
    },
    "proposal_attempt_cap": {
      "type": "integer",
      "minimum": 1
    },
    "cost_unit": {
      "type": "string",
      "minLength": 1
    },
    "expected_seeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "expected_seed_count": {
      "type": "integer",
      "minimum": 1
    },
    "expected_run_count": {
      "type": "integer",
      "minimum": 1
    },
    "referenced_run_count": {
      "type": "integer",
      "minimum": 0
    },
    "verified_run_count": {
      "type": "integer",
      "minimum": 0
    },
    "duplicate_run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "arms": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/arm_audit"
      }
    },
    "audit_pass": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "arm_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_id",
        "policy_id",
        "policy_revision",
        "expected_seed_count",
        "referenced_run_count",
        "verified_run_count",
        "missing_seed_references",
        "missing_verified_seeds",
        "duplicate_seed_references",
        "unexpected_seed_references",
        "runs",
        "audit_pass"
      ],
      "properties": {
        "arm_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "expected_seed_count": {
          "type": "integer",
          "minimum": 1
        },
        "referenced_run_count": {
          "type": "integer",
          "minimum": 0
        },
        "verified_run_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_seed_references": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "missing_verified_seeds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "duplicate_seed_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "unexpected_seed_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run_audit"
          }
        },
        "audit_pass": {
          "type": "boolean"
        }
      }
    },
    "run_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "expected_seed",
        "observed_seed",
        "expected_sha256",
        "observed_sha256",
        "digest_matches",
        "run_id",
        "observed_simulator_calls",
        "run_disposition",
        "status",
        "blockers"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "expected_seed": {
          "type": "integer",
          "minimum": 0
        },
        "observed_seed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observed_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "digest_matches": {
          "type": "boolean"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_simulator_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "run_disposition": {
          "enum": [
            "equal_budget_complete",
            "incomplete_under_budget",
            "over_budget",
            "budget_consumed_but_unresolved",
            "completed_claim_mismatch",
            "failed_run",
            "incomplete_run",
            null
          ]
        },
        "status": {
          "enum": [
            "verified",
            "missing_file",
            "digest_mismatch",
            "invalid_ledger",
            "run_audit_failed",
            "identity_mismatch"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
