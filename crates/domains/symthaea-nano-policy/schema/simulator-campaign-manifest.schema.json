{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:symthaea:nano:simulator-campaign-manifest:v1",
  "title": "Nanotechnology simulator-budget campaign manifest",
  "description": "Frozen set of paired per-seed simulator run ledgers. This contract checks identity and seed coverage, not scientific superiority or statistical power.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "campaign_id",
    "expected_simulator_calls",
    "proposal_attempt_cap",
    "cost_unit",
    "task_contract_sha256",
    "evaluation_manifest_sha256",
    "simulator_recipe_sha256",
    "expected_seeds",
    "arms"
  ],
  "properties": {
    "schema_version": {
      "const": "nano-simulator-campaign-manifest-v1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "expected_simulator_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000,
      "description": "Expected actual simulator process invocations per run, including failed/non-finite calls."
    },
    "proposal_attempt_cap": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000,
      "description": "Must be at least expected_simulator_calls."
    },
    "cost_unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "task_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evaluation_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "simulator_recipe_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "expected_seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/arm"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_id",
        "policy_id",
        "policy_revision",
        "ledgers"
      ],
      "properties": {
        "arm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "policy_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "ledgers": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/ledger_reference"
          }
        }
      }
    },
    "ledger_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "relative_path",
        "sha256"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Manifest-relative path below the CLI ledger root. The Rust validator rejects absolute paths, backslashes, empty components, dot components and parent traversal."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
