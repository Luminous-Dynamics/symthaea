{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:symthaea:nano-policy-request:v1",
  "title": "Symthaea nano-policy request",
  "description": "Frozen normalized descriptors only; no targets, test labels, oracle outcomes, predictions or post-outcome fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy",
    "budget",
    "seed",
    "feature_contract_sha256",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "nano-policy-request-v1"
    },
    "policy": {
      "enum": [
        "random_seeded",
        "farthest_first",
        "group_balanced_farthest_first",
        "cost_aware_farthest_first"
      ]
    },
    "budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "feature_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "family_id",
          "normalized_features"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "family_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "normalized_features": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "estimated_cost": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "Optional externally declared positive cost in a single frozen cost unit. Required for cost_aware_farthest_first."
          }
        }
      }
    },
    "cost_unit": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "description": "Unit for every estimated_cost; required by cost_aware_farthest_first."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "policy": {
            "const": "cost_aware_farthest_first"
          }
        },
        "required": [
          "policy"
        ]
      },
      "then": {
        "properties": {
          "candidates": {
            "items": {
              "required": [
                "estimated_cost"
              ],
              "properties": {
                "estimated_cost": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "cost_unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "cost_unit"
        ]
      }
    }
  ]
}
