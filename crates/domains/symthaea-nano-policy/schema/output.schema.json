{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:symthaea:nano-selection-output-v1",
  "title": "Symthaea nano-policy selector output",
  "description": "Selection receipt from the deterministic research-only selector. Scores are descriptor-space selection diagnostics, not probabilities or physical properties.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "input_blake3",
    "policy",
    "candidate_count",
    "feature_count",
    "budget_requested",
    "already_selected",
    "normalization",
    "selected"
  ],
  "properties": {
    "schema_version": {
      "const": "nano-selection-input-v1"
    },
    "policy_version": {
      "const": "nano-selector-v1"
    },
    "policy": {
      "enum": [
        "maximin",
        "random"
      ]
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "feature_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "budget_requested": {
      "type": "integer",
      "minimum": 1
    },
    "already_selected": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "normalization": {
      "enum": [
        "per_feature_min_max_over_candidate_pool",
        "not_used_by_random_policy"
      ]
    },
    "selected": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rank",
          "score_kind",
          "score"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "score_kind": {
            "enum": [
              "distance_to_pool_centroid",
              "min_distance_to_selected",
              "random_order"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "input_blake3": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "BLAKE3 digest of the exact raw request bytes, including whitespace"
    }
  },
  "$comment": "The runtime must additionally verify selected.length equals budget_requested, IDs are unique and from the supplied candidate pool, and score/score_kind match the chosen policy. Hash exact request/response bytes in the orchestrator receipt; no digest is emitted by this CLI."
}
