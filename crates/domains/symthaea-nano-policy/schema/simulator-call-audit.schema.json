{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:symthaea:nano:simulator-call-audit:v1",
  "title": "Nanotechnology simulator-call budget audit report",
  "description": "Computed structural audit of a frozen simulator-call ledger. It does not prove simulation correctness or authenticate external receipt contents unless a separate artifact verifier does so.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_sha256",
    "benchmark_id",
    "run_id",
    "seed",
    "arm_id",
    "policy_id",
    "run_status",
    "expected_simulator_calls",
    "reported_simulator_calls",
    "observed_simulator_calls",
    "reported_count_matches_observed",
    "exact_call_budget_match",
    "proposal_attempts",
    "proposal_attempt_cap",
    "generated_candidates",
    "generation_failures",
    "preflight_passed",
    "preflight_rejected",
    "eligible_candidates_not_called",
    "proposal_attempts_after_budget_reached",
    "unique_candidate_digests",
    "repeated_candidate_attempts",
    "returned_finite_results",
    "returned_nonfinite_results",
    "simulator_failures",
    "simulator_timeouts",
    "unresolved_simulator_calls",
    "total_proposal_cost",
    "total_simulator_cost",
    "total_cost",
    "total_proposal_elapsed_ms",
    "total_simulator_elapsed_ms",
    "disposition",
    "audit_pass",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "nano-simulator-call-audit-v1" },
    "ledger_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "benchmark_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "seed": { "type": "integer", "minimum": 0, "description": "Exact per-run random seed; compare seed sets across arms for paired comparisons." },
    "arm_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "policy_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "run_status": { "enum": ["completed", "incomplete", "failed"] },
    "expected_simulator_calls": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "reported_simulator_calls": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "observed_simulator_calls": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "reported_count_matches_observed": { "type": "boolean" },
    "exact_call_budget_match": { "type": "boolean" },
    "proposal_attempts": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "proposal_attempt_cap": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "generated_candidates": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "generation_failures": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "preflight_passed": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "preflight_rejected": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "eligible_candidates_not_called": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "proposal_attempts_after_budget_reached": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "unique_candidate_digests": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "repeated_candidate_attempts": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "returned_finite_results": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "returned_nonfinite_results": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "simulator_failures": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "simulator_timeouts": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "unresolved_simulator_calls": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "total_proposal_cost": { "type": "number", "minimum": 0, "maximum": 1e17 },
    "total_simulator_cost": { "type": "number", "minimum": 0, "maximum": 1e17 },
    "total_cost": { "type": "number", "minimum": 0, "maximum": 2e17 },
    "total_proposal_elapsed_ms": { "type": "integer", "minimum": 0 },
    "total_simulator_elapsed_ms": { "type": "integer", "minimum": 0 },
    "disposition": {
      "enum": [
        "equal_budget_complete",
        "incomplete_under_budget",
        "over_budget",
        "budget_consumed_but_unresolved",
        "completed_claim_mismatch",
        "failed_run",
        "incomplete_run"
      ]
    },
    "audit_pass": { "type": "boolean" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
