{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/crates/domains/symthaea-silicon/schemas/end_to_end_receipt_v0_1.schema.json",
  "title": "Symthaea NEURO-SILICON-003 end-to-end benchmark receipt",
  "description": "Evidence receipt for end-to-end HDC workload measurements. Missing measurements are omitted, not encoded as zero. A structurally valid receipt does not itself prove hardware correctness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "claim_ceiling",
    "source",
    "workload",
    "profile",
    "execution",
    "correctness",
    "metrics",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "incomplete",
        "not_comparable"
      ]
    },
    "claim_ceiling": {
      "enum": [
        "software_only",
        "rtl_simulation",
        "synthesis_estimate",
        "fpga_observed",
        "analogue_device_observed"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "$ref": "#/$defs/sha40"
        },
        "tree_sha": {
          "$ref": "#/$defs/sha40"
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_id",
        "vector_dimension_bits",
        "store_vector_count",
        "query_batch_size",
        "operations",
        "tie_break_policy"
      ],
      "properties": {
        "workload_id": {
          "type": "string",
          "minLength": 1
        },
        "input_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expected_results_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "vector_dimension_bits": {
          "type": "integer",
          "minimum": 1
        },
        "store_vector_count": {
          "type": "integer",
          "minimum": 1
        },
        "query_batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "query_count": {
          "type": "integer",
          "minimum": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "encode",
              "bind",
              "permute",
              "hamming_distance",
              "similarity",
              "retrieve",
              "classify",
              "bundle",
              "other"
            ]
          }
        },
        "tie_break_policy": {
          "type": "string",
          "minLength": 1
        },
        "task_quality_floor": {
          "type": "string"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "backend",
        "host_stages",
        "device_stages",
        "hardware_identity",
        "memory_profile"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "enum": [
            "cpu_scalar",
            "cpu_simd",
            "gpu",
            "rtl_simulator",
            "synthesis",
            "fpga_board",
            "analogue_device",
            "unknown"
          ]
        },
        "host_stages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "device_stages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hardware_identity": {
          "type": "string",
          "minLength": 1
        },
        "memory_profile": {
          "type": "string",
          "minLength": 1
        },
        "clock_power_profile": {
          "type": "string"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_boundary",
        "boundary_complete",
        "warmup_batches",
        "measured_batches",
        "commands"
      ],
      "properties": {
        "measurement_boundary": {
          "type": "string",
          "minLength": 1
        },
        "boundary_complete": {
          "type": "boolean"
        },
        "warmup_batches": {
          "type": "integer",
          "minimum": 0
        },
        "measured_batches": {
          "type": "integer",
          "minimum": 0
        },
        "run_order": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "exit_code",
              "stdout_sha256",
              "stderr_sha256"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "stdout_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "stderr_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "tool_name": {
                "type": "string"
              },
              "tool_version": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle_comparison"
      ],
      "properties": {
        "oracle_comparison": {
          "enum": [
            "exact_match",
            "mismatch",
            "not_run",
            "not_applicable"
          ]
        },
        "oracle_identity": {
          "type": "string"
        },
        "fixtures_attempted": {
          "type": "integer",
          "minimum": 0
        },
        "fixtures_passed": {
          "type": "integer",
          "minimum": 0
        },
        "mismatches": {
          "type": "integer",
          "minimum": 0
        },
        "malformed_frames_accepted": {
          "type": "integer",
          "minimum": 0
        },
        "task_quality_metric": {
          "type": "string"
        },
        "task_quality_value": {
          "type": "number"
        },
        "task_quality_floor": {
          "type": "number"
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "value",
          "unit",
          "kind",
          "scope"
        ],
        "properties": {
          "metric_id": {
            "enum": [
              "latency_p50",
              "latency_p95",
              "latency_p99",
              "throughput",
              "energy_per_query",
              "average_power",
              "peak_power",
              "transfer_bytes_per_query",
              "transfer_time",
              "working_set_bytes",
              "memory_bandwidth",
              "lut_count",
              "ff_count",
              "bram_count",
              "dsp_count",
              "fmax",
              "task_quality",
              "other"
            ]
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "measured",
              "estimated",
              "derived"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "sample_count": {
            "type": "integer",
            "minimum": 0
          },
          "method": {
            "type": "string"
          },
          "instrument": {
            "type": "string"
          },
          "calibration": {
            "type": "string"
          },
          "uncertainty": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "metric_id": {
                  "enum": [
                    "energy_per_query",
                    "average_power",
                    "peak_power"
                  ]
                },
                "kind": {
                  "const": "measured"
                }
              },
              "required": [
                "metric_id",
                "kind"
              ]
            },
            "then": {
              "required": [
                "sample_count",
                "method",
                "instrument"
              ]
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "media_type",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:[\\\\\\\\/]).+"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "workload": {
            "required": [
              "input_manifest_sha256",
              "expected_results_sha256"
            ]
          },
          "execution": {
            "properties": {
              "boundary_complete": {
                "const": true
              },
              "measured_batches": {
                "minimum": 30
              }
            }
          },
          "correctness": {
            "properties": {
              "oracle_comparison": {
                "const": "exact_match"
              },
              "mismatches": {
                "const": 0
              },
              "malformed_frames_accepted": {
                "const": 0
              }
            },
            "required": [
              "oracle_comparison",
              "fixtures_attempted",
              "fixtures_passed",
              "mismatches",
              "malformed_frames_accepted"
            ]
          },
          "artifacts": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_comparable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
