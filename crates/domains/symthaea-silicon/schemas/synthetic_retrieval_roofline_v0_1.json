  "model_version": "0.1",
  "scope": "Packed 16,384-bit BinaryHV exact nearest-match scan; not ContinuousHV/LTC simulation",
  "evidence_class": "analytical_lower_bound_not_measurement",
  "assumptions": {
    "vector_dimension_bits": 16384,
    "bytes_per_vector": 2048,
    "hypothetical_clock_hz": 100000000,
    "hypothetical_decimal_memory_bandwidth_bytes_per_second": 8000000000,
    "ideal_cycles_formula": "ceil(vector_dimension_bits / lane_width_bits) * ceil(store_vectors / parallel_distance_lanes)",
    "assumes": [
      "one accepted lane beat per cycle",
      "all parallel distance lanes continuously supplied",
      "zero memory latency and no stalls",
      "no query encoding or result formatting cost",
      "no clock-domain crossing, DMA, host synchronization or device invocation overhead",
      "parallel lanes have sufficient independent memory ports/banks",
      "the timing frequency is hypothetical and is not a fitted FPGA/ASIC frequency"
    ],
    "excluded_from_model": [
      "actual FPGA resource usage and achievable timing",
      "memory-controller/bank conflicts and row effects",
      "codebook load/build time beyond the idealized transfer illustration",
      "energy and power",
      "real CPU/SIMD baseline measurements",
      "retrieval task accuracy/quality beyond exact deterministic minimum over supplied distances"
    ]
  },
