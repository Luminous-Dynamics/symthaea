index 0000000..a3aa4dc
--- /dev/null
+++ b/src/manova.rs
@@ -0,0 +1,296 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! One-factor multivariate analysis of variance with deterministic permutation inference.
+
+use crate::error::{StatsResult, StatisticsError};
+use crate::linalg::{CholeskyFactor, DenseMatrix};
+use crate::sampling::SplitMix64;
+use std::collections::BTreeMap;
+
+const MAXIMUM_WORK: u128 = 100_000_000;
+
+fn validate(observations: &[Vec<f64>], groups: &[usize], ridge: f64) -> StatsResult<usize> {
+    if observations.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    if observations.len() != groups.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: observations.len(),
+            right: groups.len(),
+        });
+    }
+    if !ridge.is_finite() || ridge < 0.0 {
+        return Err(StatisticsError::NegativeValue {
+            name: "MANOVA covariance ridge",
+            value: ridge,
+        });
+    }
+    let dimensions = observations[0].len();
+    if dimensions == 0 {
+        return Err(StatisticsError::InvalidShape {
+            rows: observations.len(),
+            columns: dimensions,
+        });
+    }
+    for (row_index, row) in observations.iter().enumerate() {
+        if row.len() != dimensions {
+            return Err(StatisticsError::DimensionMismatch {
+                context: "MANOVA observation row",
+                expected: dimensions,
+                actual: row.len(),
+            });
+        }
+        for (column, &value) in row.iter().enumerate() {
+            if !value.is_finite() {
+                return Err(StatisticsError::NonFiniteInput {
+                    index: row_index * dimensions + column,
+                    value,
+                });
+            }
+        }
+    }
+    Ok(dimensions)
+}
+
+fn mean(observations: &[Vec<f64>], indices: &[usize], dimensions: usize) -> Vec<f64> {
+    let mut result = vec![0.0; dimensions];
+    for &index in indices {
+        for (column, value) in result.iter_mut().enumerate() {
+            *value += observations[index][column];
+        }
+    }
+    let scale = 1.0 / indices.len() as f64;
+    for value in &mut result {
+        *value *= scale;
+    }
+    result
+}
+
+fn add_outer(matrix: &mut DenseMatrix, vector: &[f64], weight: f64) -> StatsResult<()> {
+    for row in 0..vector.len() {
+        for column in 0..=row {
+            let value = matrix.get(row, column) + weight * vector[row] * vector[column];
+            if !value.is_finite() {
+                return Err(StatisticsError::NumericalOverflow {
+                    operation: "MANOVA scatter matrix",
+                });
+            }
+            matrix.set(row, column, value);
+            matrix.set(column, row, value);
+        }
+    }
+    Ok(())
+}
+
+fn scatter_matrices(
+    observations: &[Vec<f64>],
+    groups: &[usize],
+    dimensions: usize,
+) -> StatsResult<(DenseMatrix, DenseMatrix, usize)> {
+    let mut by_group = BTreeMap::<usize, Vec<usize>>::new();
+    for (index, &group) in groups.iter().enumerate() {
+        by_group.entry(group).or_default().push(index);
+    }
+    if by_group.len() < 2 {
+        return Err(StatisticsError::DegenerateSample {
+            reason: "MANOVA requires at least two groups",
+        });
+    }
+    for indices in by_group.values() {
+        if indices.is_empty() {
+            return Err(StatisticsError::EmptySample);
+        }
+    }
+    let all_indices = (0..observations.len()).collect::<Vec<_>>();
+    let grand = mean(observations, &all_indices, dimensions);
+    let mut hypothesis = DenseMatrix::zeros(dimensions, dimensions)?;
+    let mut error = DenseMatrix::zeros(dimensions, dimensions)?;
+    for indices in by_group.values() {
+        let group_mean = mean(observations, indices, dimensions);
+        let difference = group_mean
+            .iter()
+            .zip(&grand)
+            .map(|(&value, &overall)| value - overall)
+            .collect::<Vec<_>>();
+        add_outer(&mut hypothesis, &difference, indices.len() as f64)?;
+        for &index in indices {
+            let residual = observations[index]
+                .iter()
+                .zip(&group_mean)
+                .map(|(&value, &center)| value - center)
+                .collect::<Vec<_>>();
+            add_outer(&mut error, &residual, 1.0)?;
+        }
+    }
+    Ok((hypothesis, error, by_group.len()))
+}
+
+fn add_matrices(left: &DenseMatrix, right: &DenseMatrix, ridge: f64) -> StatsResult<DenseMatrix> {
+    let mut total = DenseMatrix::zeros(left.rows(), left.columns())?;
+    for row in 0..left.rows() {
+        for column in 0..left.columns() {
+            let mut value = left.get(row, column) + right.get(row, column);
+            if row == column {
+                value += ridge;
+            }
+            if !value.is_finite() {
+                return Err(StatisticsError::NumericalOverflow {
+                    operation: "MANOVA total scatter",
+                });
+            }
+            total.set(row, column, value);
+        }
+    }
+    Ok(total)
+}
+
+fn regularized(matrix: &DenseMatrix, ridge: f64) -> StatsResult<DenseMatrix> {
+    let mut result = matrix.clone();
+    for index in 0..result.rows() {
+        let value = result.get(index, index) + ridge;
+        if !value.is_finite() {
+            return Err(StatisticsError::NumericalOverflow {
+                operation: "MANOVA covariance ridge",
+            });
+        }
+        result.set(index, index, value);
+    }
+    Ok(result)
+}
+
+fn trace_product(left: &DenseMatrix, right: &DenseMatrix) -> f64 {
+    let mut trace = 0.0;
+    for row in 0..left.rows() {
+        for column in 0..left.columns() {
+            trace = left.get(row, column).mul_add(right.get(column, row), trace);
+        }
+    }
+    trace
+}
+
+fn statistics(
+    observations: &[Vec<f64>],
+    groups: &[usize],
+    dimensions: usize,
+    ridge: f64,
+) -> StatsResult<(f64, f64, DenseMatrix, DenseMatrix, usize)> {
+    let (hypothesis, error, group_count) = scatter_matrices(observations, groups, dimensions)?;
+    let regularized_error = regularized(&error, ridge)?;
+    let total = add_matrices(&hypothesis, &error, ridge)?;
+    let error_factor = CholeskyFactor::try_factor(&regularized_error)?;
+    let total_factor = CholeskyFactor::try_factor(&total)?;
+    let log_wilks = error_factor.log_determinant() - total_factor.log_determinant();
+    let wilks_lambda = log_wilks.exp().clamp(0.0, 1.0);
+    let total_inverse = total_factor.try_inverse()?;
+    let pillai_trace = trace_product(&hypothesis, &total_inverse)
+        .max(0.0)
+        .min(dimensions.min(group_count - 1) as f64);
+    if !wilks_lambda.is_finite() || !pillai_trace.is_finite() {
+        return Err(StatisticsError::NumericalOverflow {
+            operation: "MANOVA statistic",
+        });
+    }
+    Ok((wilks_lambda, pillai_trace, hypothesis, error, group_count))
+}
+
+/// One-factor MANOVA summary.
+#[derive(Debug, Clone, PartialEq)]
+pub struct OneWayManova {
+    pub wilks_lambda: f64,
+    pub pillai_trace: f64,
+    pub permutation_p_value: Option<f64>,
+    pub hypothesis_sscp: DenseMatrix,
+    pub error_sscp: DenseMatrix,
+    pub groups: usize,
+    pub dimensions: usize,
+    pub observations: usize,
+    pub ridge: f64,
+    pub permutations: usize,
+    pub seed: u64,
+}
+
+/// Compute Wilks' lambda and Pillai's trace, optionally calibrating Pillai's
+/// trace through deterministic label permutation.
+pub fn try_one_way_manova(
+    observations: &[Vec<f64>],
+    groups: &[usize],
+    ridge: f64,
+    permutations: usize,
+    seed: u64,
+) -> StatsResult<OneWayManova> {
+    let dimensions = validate(observations, groups, ridge)?;
+    let (wilks_lambda, pillai_trace, hypothesis_sscp, error_sscp, group_count) =
+        statistics(observations, groups, dimensions, ridge)?;
+    let permutation_p_value = if permutations == 0 {
+        None
+    } else {
+        let work = (observations.len() as u128)
+            .saturating_mul(dimensions as u128)
+            .saturating_mul(dimensions as u128)
+            .saturating_mul(permutations as u128);
+        if work > MAXIMUM_WORK {
+            return Err(StatisticsError::ComputationTooLarge {
+                states: work,
+                maximum: MAXIMUM_WORK,
+            });
+        }
+        let mut rng = SplitMix64::new(seed);
+        let mut permuted = groups.to_vec();
+        let mut exceedances = 0_usize;
+        for _ in 0..permutations {
+            for index in (1..permuted.len()).rev() {
+                let swap = rng.index(index + 1)?;
+                permuted.swap(index, swap);
+            }
+            let (_, statistic, _, _, _) = statistics(observations, &permuted, dimensions, ridge)?;
+            if statistic + 1.0e-14 >= pillai_trace {
+                exceedances += 1;
+            }
+        }
+        Some((exceedances + 1) as f64 / (permutations + 1) as f64)
+    };
+    Ok(OneWayManova {
+        wilks_lambda,
+        pillai_trace,
+        permutation_p_value,
+        hypothesis_sscp,
+        error_sscp,
+        groups: group_count,
+        dimensions,
+        observations: observations.len(),
+        ridge,
+        permutations,
+        seed,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn separated_groups_have_small_wilks_lambda() {
+        let observations = vec![
+            vec![-2.0, -1.0], vec![-1.5, -0.8], vec![-1.0, -1.2],
+            vec![1.0, 1.1], vec![1.5, 0.8], vec![2.0, 1.2],
+        ];
+        let groups = vec![0, 0, 0, 1, 1, 1];
+        let result = try_one_way_manova(&observations, &groups, 1e-8, 199, 17).unwrap();
+        assert!(result.wilks_lambda < 0.05);
+        assert!(result.pillai_trace > 0.9);
+        assert!(result.permutation_p_value.unwrap() < 0.1);
+    }
+
+    #[test]
+    fn permutation_is_reproducible() {
+        let observations = vec![
+            vec![0.0, 1.0], vec![1.0, 0.0], vec![0.2, 0.9],
+            vec![0.8, 0.1], vec![0.4, 0.7], vec![0.7, 0.3],
+        ];
+        let groups = vec![0, 1, 0, 1, 0, 1];
+        let left = try_one_way_manova(&observations, &groups, 1e-6, 99, 9).unwrap();
+        let right = try_one_way_manova(&observations, &groups, 1e-6, 99, 9).unwrap();
+        assert_eq!(left.permutation_p_value, right.permutation_p_value);
+    }
+}
