@@ -0,0 +1,356 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Canonical correlation analysis for two multivariate observation blocks.
+
+use crate::error::{StatsResult, StatisticsError};
+use crate::linalg::DenseMatrix;
+use crate::pca::try_symmetric_eigen;
+
+fn validate_block(block: &[Vec<f64>], name: &'static str) -> StatsResult<usize> {
+    if block.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    let columns = block[0].len();
+    if columns == 0 {
+        return Err(StatisticsError::InvalidShape {
+            rows: block.len(),
+            columns,
+        });
+    }
+    for (row_index, row) in block.iter().enumerate() {
+        if row.len() != columns {
+            return Err(StatisticsError::DimensionMismatch {
+                context: name,
+                expected: columns,
+                actual: row.len(),
+            });
+        }
+        for (column, &value) in row.iter().enumerate() {
+            if !value.is_finite() {
+                return Err(StatisticsError::NonFiniteInput {
+                    index: row_index * columns + column,
+                    value,
+                });
+            }
+        }
+    }
+    Ok(columns)
+}
+
+fn centered_matrix(block: &[Vec<f64>]) -> StatsResult<(DenseMatrix, Vec<f64>)> {
+    let rows = block.len();
+    let columns = block[0].len();
+    let mut means = vec![0.0; columns];
+    for row in block {
+        for (column, &value) in row.iter().enumerate() {
+            means[column] += value;
+        }
+    }
+    for mean in &mut means {
+        *mean /= rows as f64;
+    }
+    let mut data = Vec::with_capacity(rows.checked_mul(columns).ok_or(
+        StatisticsError::NumericalOverflow {
+            operation: "canonical-correlation matrix size",
+        },
+    )?);
+    for row in block {
+        for (column, &value) in row.iter().enumerate() {
+            data.push(value - means[column]);
+        }
+    }
+    Ok((DenseMatrix::try_new(rows, columns, data)?, means))
+}
+
+fn covariance(left: &DenseMatrix, right: &DenseMatrix) -> StatsResult<DenseMatrix> {
+    if left.rows() != right.rows() {
+        return Err(StatisticsError::LengthMismatch {
+            left: left.rows(),
+            right: right.rows(),
+        });
+    }
+    if left.rows() < 2 {
+        return Err(StatisticsError::InsufficientSamples {
+            required: 2,
+            actual: left.rows(),
+        });
+    }
+    let mut output = DenseMatrix::zeros(left.columns(), right.columns())?;
+    let denominator = (left.rows() - 1) as f64;
+    for row in 0..left.columns() {
+        for column in 0..right.columns() {
+            let mut sum = 0.0;
+            for observation in 0..left.rows() {
+                sum = left
+                    .get(observation, row)
+                    .mul_add(right.get(observation, column), sum);
+            }
+            let value = sum / denominator;
+            if !value.is_finite() {
+                return Err(StatisticsError::NumericalOverflow {
+                    operation: "canonical covariance",
+                });
+            }
+            output.set(row, column, value);
+        }
+    }
+    Ok(output)
+}
+
+fn transpose(matrix: &DenseMatrix) -> StatsResult<DenseMatrix> {
+    let mut output = DenseMatrix::zeros(matrix.columns(), matrix.rows())?;
+    for row in 0..matrix.rows() {
+        for column in 0..matrix.columns() {
+            output.set(column, row, matrix.get(row, column));
+        }
+    }
+    Ok(output)
+}
+
+fn multiply(left: &DenseMatrix, right: &DenseMatrix) -> StatsResult<DenseMatrix> {
+    if left.columns() != right.rows() {
+        return Err(StatisticsError::DimensionMismatch {
+            context: "canonical matrix product",
+            expected: left.columns(),
+            actual: right.rows(),
+        });
+    }
+    let mut output = DenseMatrix::zeros(left.rows(), right.columns())?;
+    for row in 0..left.rows() {
+        for column in 0..right.columns() {
+            let mut sum = 0.0;
+            for inner in 0..left.columns() {
+                sum = left.get(row, inner).mul_add(right.get(inner, column), sum);
+            }
+            if !sum.is_finite() {
+                return Err(StatisticsError::NumericalOverflow {
+                    operation: "canonical matrix product",
+                });
+            }
+            output.set(row, column, sum);
+        }
+    }
+    Ok(output)
+}
+
+fn inverse_square_root(covariance: &DenseMatrix, ridge: f64) -> StatsResult<DenseMatrix> {
+    let mut regularized = covariance.clone();
+    for index in 0..regularized.rows() {
+        regularized.set(index, index, regularized.get(index, index) + ridge);
+    }
+    let eigen = try_symmetric_eigen(
+        &regularized,
+        1.0e-12,
+        regularized.rows().saturating_mul(regularized.rows()).saturating_mul(128),
+    )?;
+    let scale = eigen.values.first().copied().unwrap_or(0.0).abs().max(1.0);
+    let threshold = scale * f64::EPSILON * regularized.rows() as f64 * 128.0;
+    let mut output = DenseMatrix::zeros(regularized.rows(), regularized.columns())?;
+    for component in 0..eigen.values.len() {
+        let value = eigen.values[component];
+        if !value.is_finite() || value <= threshold {
+            return Err(StatisticsError::SingularMatrix {
+                reason: "canonical covariance is not positive definite",
+            });
+        }
+        let weight = value.sqrt().recip();
+        for row in 0..output.rows() {
+            for column in 0..output.columns() {
+                let next = output.get(row, column)
+                    + weight
+                        * eigen.vectors.get(row, component)
+                        * eigen.vectors.get(column, component);
+                output.set(row, column, next);
+            }
+        }
+    }
+    Ok(output)
+}
+
+fn matrix_column(matrix: &DenseMatrix, column: usize) -> Vec<f64> {
+    (0..matrix.rows()).map(|row| matrix.get(row, column)).collect()
+}
+
+fn normalize_variance(weight: &mut [f64], covariance: &DenseMatrix) -> StatsResult<()> {
+    let product = covariance.try_mul_vector(weight)?;
+    let variance = weight
+        .iter()
+        .zip(&product)
+        .fold(0.0, |sum, (&left, &right)| left.mul_add(right, sum));
+    if !variance.is_finite() || variance <= 0.0 {
+        return Err(StatisticsError::DegenerateSample {
+            reason: "canonical variate has zero variance",
+        });
+    }
+    let scale = variance.sqrt().recip();
+    for value in weight {
+        *value *= scale;
+    }
+    Ok(())
+}
+
+/// Fitted canonical-correlation decomposition.
+#[derive(Debug, Clone, PartialEq)]
+pub struct CanonicalCorrelationFit {
+    pub x_mean: Vec<f64>,
+    pub y_mean: Vec<f64>,
+    pub correlations: Vec<f64>,
+    /// Columns are coefficients for canonical variates of the X block.
+    pub x_weights: DenseMatrix,
+    /// Columns are coefficients for canonical variates of the Y block.
+    pub y_weights: DenseMatrix,
+    pub ridge: f64,
+    pub observations: usize,
+}
+
+impl CanonicalCorrelationFit {
+    pub fn components(&self) -> usize {
+        self.correlations.len()
+    }
+
+    pub fn try_transform_x(&self, observation: &[f64]) -> StatsResult<Vec<f64>> {
+        transform(observation, &self.x_mean, &self.x_weights)
+    }
+
+    pub fn try_transform_y(&self, observation: &[f64]) -> StatsResult<Vec<f64>> {
+        transform(observation, &self.y_mean, &self.y_weights)
+    }
+}
+
+fn transform(observation: &[f64], mean: &[f64], weights: &DenseMatrix) -> StatsResult<Vec<f64>> {
+    if observation.len() != mean.len() {
+        return Err(StatisticsError::DimensionMismatch {
+            context: "canonical transform",
+            expected: mean.len(),
+            actual: observation.len(),
+        });
+    }
+    for (index, &value) in observation.iter().enumerate() {
+        if !value.is_finite() {
+            return Err(StatisticsError::NonFiniteInput { index, value });
+        }
+    }
+    let mut scores = vec![0.0; weights.columns()];
+    for component in 0..weights.columns() {
+        for row in 0..weights.rows() {
+            scores[component] = (observation[row] - mean[row])
+                .mul_add(weights.get(row, component), scores[component]);
+        }
+    }
+    Ok(scores)
+}
+
+/// Fit canonical correlation analysis with optional diagonal covariance ridge.
+pub fn try_canonical_correlation(
+    x: &[Vec<f64>],
+    y: &[Vec<f64>],
+    ridge: f64,
+) -> StatsResult<CanonicalCorrelationFit> {
+    if x.len() != y.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: x.len(),
+            right: y.len(),
+        });
+    }
+    if !ridge.is_finite() || ridge < 0.0 {
+        return Err(StatisticsError::NegativeValue {
+            name: "canonical covariance ridge",
+            value: ridge,
+        });
+    }
+    let x_columns = validate_block(x, "canonical X block")?;
+    let y_columns = validate_block(y, "canonical Y block")?;
+    if x.len() < 3 {
+        return Err(StatisticsError::InsufficientSamples {
+            required: 3,
+            actual: x.len(),
+        });
+    }
+    let (x_centered, x_mean) = centered_matrix(x)?;
+    let (y_centered, y_mean) = centered_matrix(y)?;
+    let s_xx = covariance(&x_centered, &x_centered)?;
+    let s_yy = covariance(&y_centered, &y_centered)?;
+    let s_xy = covariance(&x_centered, &y_centered)?;
+    let x_inverse_root = inverse_square_root(&s_xx, ridge)?;
+    let y_inverse_root = inverse_square_root(&s_yy, ridge)?;
+    let whitened = multiply(&multiply(&x_inverse_root, &s_xy)?, &y_inverse_root)?;
+    let whitened_transpose = transpose(&whitened)?;
+    let left_gram = multiply(&whitened, &whitened_transpose)?;
+    let eigen = try_symmetric_eigen(
+        &left_gram,
+        1.0e-12,
+        left_gram.rows().saturating_mul(left_gram.rows()).saturating_mul(128),
+    )?;
+    let components = x_columns.min(y_columns);
+    let mut correlations = Vec::with_capacity(components);
+    let mut x_weights = DenseMatrix::zeros(x_columns, components)?;
+    let mut y_weights = DenseMatrix::zeros(y_columns, components)?;
+
+    for component in 0..components {
+        let correlation = eigen.values[component].max(0.0).sqrt().clamp(0.0, 1.0);
+        let u = matrix_column(&eigen.vectors, component);
+        let mut x_weight = x_inverse_root.try_mul_vector(&u)?;
+        normalize_variance(&mut x_weight, &s_xx)?;
+
+        let mut v = whitened_transpose.try_mul_vector(&u)?;
+        if correlation > 1.0e-14 {
+            for value in &mut v {
+                *value /= correlation;
+            }
+        } else {
+            v.fill(0.0);
+            v[component % y_columns] = 1.0;
+        }
+        let mut y_weight = y_inverse_root.try_mul_vector(&v)?;
+        normalize_variance(&mut y_weight, &s_yy)?;
+        for row in 0..x_columns {
+            x_weights.set(row, component, x_weight[row]);
+        }
+        for row in 0..y_columns {
+            y_weights.set(row, component, y_weight[row]);
+        }
+        correlations.push(correlation);
+    }
+
+    Ok(CanonicalCorrelationFit {
+        x_mean,
+        y_mean,
+        correlations,
+        x_weights,
+        y_weights,
+        ridge,
+        observations: x.len(),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn recovers_shared_latent_direction() {
+        let x = vec![
+            vec![-2.0, 0.5], vec![-1.0, -0.2], vec![0.0, 0.1],
+            vec![1.0, 0.3], vec![2.0, -0.4], vec![3.0, 0.2],
+        ];
+        let y = x
+            .iter()
+            .enumerate()
+            .map(|(index, row)| vec![2.0 * row[0] + index as f64 * 0.01, -row[0] + row[1]])
+            .collect::<Vec<_>>();
+        let fit = try_canonical_correlation(&x, &y, 1e-8).unwrap();
+        assert!(fit.correlations[0] > 0.999);
+        assert_eq!(fit.components(), 2);
+    }
+
+    #[test]
+    fn rejects_mismatched_blocks() {
+        let x = vec![vec![1.0], vec![2.0], vec![3.0]];
+        let y = vec![vec![1.0], vec![2.0]];
+        assert!(matches!(
+            try_canonical_correlation(&x, &y, 0.0),
+            Err(StatisticsError::LengthMismatch { .. })
+        ));
+    }
+}
diff --git a/src/censored_regression.rs b/src/censored_regression.rs
new file mode 100644
index 0000000..5238288
--- /dev/null
+++ b/src/censored_regression.rs
@@ -0,0 +1,459 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Gaussian Tobit regression for a shared left or right censoring boundary.
+
+use crate::distributions::{normal_cdf, normal_log_sf, normal_sf};
+use crate::error::{StatsResult, StatisticsError};
+use crate::model_matrix::{try_design_matrix, try_feature_vector};
+use crate::multiple_regression::try_multiple_linear_regression;
+
+/// Direction and boundary of censoring.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Censoring {
+    Left { boundary: f64 },
+    Right { boundary: f64 },
+}
+
+impl Censoring {
+    fn boundary(self) -> f64 {
+        match self {
+            Self::Left { boundary } | Self::Right { boundary } => boundary,
+        }
+    }
+}
+
+/// Controls for deterministic Tobit maximum-likelihood fitting.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct TobitOptions {
+    pub include_intercept: bool,
+    pub ridge: f64,
+    pub maximum_iterations: usize,
+    pub tolerance: f64,
+    pub initial_step: f64,
+}
+
+impl Default for TobitOptions {
+    fn default() -> Self {
+        Self {
+            include_intercept: true,
+            ridge: 1.0e-8,
+            maximum_iterations: 500,
+            tolerance: 1.0e-7,
+            initial_step: 0.1,
+        }
+    }
+}
+
+/// Fitted Gaussian Tobit model.
+#[derive(Debug, Clone, PartialEq)]
+pub struct TobitFit {
+    pub coefficients: Vec<f64>,
+    pub sigma: f64,
+    pub censoring: Censoring,
+    pub predictor_count: usize,
+    pub include_intercept: bool,
+    pub ridge: f64,
+    pub observations: usize,
+    pub censored_observations: usize,
+    pub iterations: usize,
+    pub converged: bool,
+    pub log_likelihood: f64,
+    pub aic: f64,
+    pub bic: f64,
+}
+
+impl TobitFit {
+    pub fn try_latent_mean(&self, predictors: &[f64]) -> StatsResult<f64> {
+        let features = try_feature_vector(predictors, self.predictor_count, self.include_intercept)?;
+        let value = dot(&features, &self.coefficients);
+        if value.is_finite() {
+            Ok(value)
+        } else {
+            Err(StatisticsError::NumericalOverflow {
+                operation: "Tobit latent prediction",
+            })
+        }
+    }
+
+    pub fn try_censoring_probability(&self, predictors: &[f64]) -> StatsResult<f64> {
+        let mean = self.try_latent_mean(predictors)?;
+        let z = (self.censoring.boundary() - mean) / self.sigma;
+        Ok(match self.censoring {
+            Censoring::Left { .. } => normal_cdf(z),
+            Censoring::Right { .. } => normal_sf(z),
+        })
+    }
+}
+
+fn dot(left: &[f64], right: &[f64]) -> f64 {
+    left.iter()
+        .zip(right)
+        .fold(0.0, |sum, (&a, &b)| a.mul_add(b, sum))
+}
+
+fn validate_options(options: TobitOptions) -> StatsResult<()> {
+    if !options.ridge.is_finite() || options.ridge < 0.0 {
+        return Err(StatisticsError::NegativeValue {
+            name: "Tobit ridge",
+            value: options.ridge,
+        });
+    }
+    if options.maximum_iterations == 0 {
+        return Err(StatisticsError::InvalidIterations {
+            iterations: options.maximum_iterations,
+        });
+    }
+    if !options.tolerance.is_finite() || options.tolerance <= 0.0 {
+        return Err(StatisticsError::NonPositiveValue {
+            name: "Tobit tolerance",
+            value: options.tolerance,
+        });
+    }
+    if !options.initial_step.is_finite() || options.initial_step <= 0.0 {
+        return Err(StatisticsError::NonPositiveValue {
+            name: "Tobit initial step",
+            value: options.initial_step,
+        });
+    }
+    Ok(())
+}
+
+fn log_standard_normal_pdf(z: f64) -> f64 {
+    -0.5 * (2.0 * std::f64::consts::PI).ln() - 0.5 * z * z
+}
+
+fn log_cdf(z: f64) -> f64 {
+    normal_log_sf(-z)
+}
+
+fn mills_left(z: f64) -> StatsResult<f64> {
+    let ratio = (log_standard_normal_pdf(z) - log_cdf(z)).exp();
+    if ratio.is_finite() {
+        Ok(ratio)
+    } else {
+        Err(StatisticsError::NumericalOverflow {
+            operation: "left-censored Mills ratio",
+        })
+    }
+}
+
+fn mills_right(z: f64) -> StatsResult<f64> {
+    let ratio = (log_standard_normal_pdf(z) - normal_log_sf(z)).exp();
+    if ratio.is_finite() {
+        Ok(ratio)
+    } else {
+        Err(StatisticsError::NumericalOverflow {
+            operation: "right-censored Mills ratio",
+        })
+    }
+}
+
+fn objective_and_gradient(
+    design: &crate::linalg::DenseMatrix,
+    outcomes: &[f64],
+    censored: &[bool],
+    censoring: Censoring,
+    parameters: &[f64],
+    ridge: f64,
+    include_intercept: bool,
+) -> StatsResult<(f64, Vec<f64>)> {
+    let coefficient_count = design.columns();
+    let coefficients = &parameters[..coefficient_count];
+    let log_sigma = parameters[coefficient_count];
+    let sigma = log_sigma.exp();
+    if !sigma.is_finite() || sigma <= 0.0 {
+        return Err(StatisticsError::NumericalOverflow {
+            operation: "Tobit scale",
+        });
+    }
+    let variance = sigma * sigma;
+    let boundary = censoring.boundary();
+    let mut log_likelihood = 0.0;
+    let mut gradient = vec![0.0; parameters.len()];
+    for row in 0..design.rows() {
+        let features = design.row(row);
+        let mean = dot(features, coefficients);
+        if censored[row] {
+            let z = (boundary - mean) / sigma;
+            match censoring {
+                Censoring::Left { .. } => {
+                    log_likelihood += log_cdf(z);
+                    let ratio = mills_left(z)?;
+                    for column in 0..coefficient_count {
+                        gradient[column] -= features[column] * ratio / sigma;
+                    }
+                    gradient[coefficient_count] -= z * ratio;
+                }
+                Censoring::Right { .. } => {
+                    log_likelihood += normal_log_sf(z);
+                    let ratio = mills_right(z)?;
+                    for column in 0..coefficient_count {
+                        gradient[column] += features[column] * ratio / sigma;
+                    }
+                    gradient[coefficient_count] += z * ratio;
+                }
+            }
+        } else {
+            let residual = outcomes[row] - mean;
+            let z = residual / sigma;
+            log_likelihood += log_standard_normal_pdf(z) - log_sigma;
+            for column in 0..coefficient_count {
+                gradient[column] += features[column] * residual / variance;
+            }
+            gradient[coefficient_count] += -1.0 + z * z;
+        }
+    }
+    for column in 0..coefficient_count {
+        if include_intercept && column == 0 {
+            continue;
+        }
+        log_likelihood -= 0.5 * ridge * coefficients[column] * coefficients[column];
+        gradient[column] -= ridge * coefficients[column];
+    }
+    if !log_likelihood.is_finite() || gradient.iter().any(|value| !value.is_finite()) {
+        return Err(StatisticsError::NumericalOverflow {
+            operation: "Tobit likelihood",
+        });
+    }
+    Ok((log_likelihood, gradient))
+}
+
+fn initial_parameters(
+    predictors: &[Vec<f64>],
+    outcomes: &[f64],
+    censored: &[bool],
+    options: TobitOptions,
+) -> StatsResult<Vec<f64>> {
+    let uncensored_indices = censored
+        .iter()
+        .enumerate()
+        .filter_map(|(index, &is_censored)| (!is_censored).then_some(index))
+        .collect::<Vec<_>>();
+    let predictor_count = predictors.first().map_or(0, Vec::len);
+    let coefficient_count = predictor_count + usize::from(options.include_intercept);
+    let mut coefficients = vec![0.0; coefficient_count];
+    let mut sigma = 1.0;
+    if uncensored_indices.len() > coefficient_count {
+        let uncensored_x = uncensored_indices
+            .iter()
+            .map(|&index| predictors[index].clone())
+            .collect::<Vec<_>>();
+        let uncensored_y = uncensored_indices
+            .iter()
+            .map(|&index| outcomes[index])
+            .collect::<Vec<_>>();
+        if let Ok(fit) = try_multiple_linear_regression(
+            &uncensored_x,
+            &uncensored_y,
+            options.include_intercept,
+            0.95,
+        ) {
+            coefficients = fit.coefficients;
+            sigma = fit.residual_standard_error.max(1.0e-4);
+        }
+    } else if options.include_intercept {
+        let mean = uncensored_indices
+            .iter()
+            .map(|&index| outcomes[index])
+            .sum::<f64>()
+            / uncensored_indices.len().max(1) as f64;
+        coefficients[0] = mean;
+    }
+    coefficients.push(sigma.ln());
+    Ok(coefficients)
+}
+
+/// Fit a shared-boundary Gaussian Tobit regression.
+pub fn try_tobit_regression(
+    predictors: &[Vec<f64>],
+    outcomes: &[f64],
+    censored: &[bool],
+    censoring: Censoring,
+    options: TobitOptions,
+) -> StatsResult<TobitFit> {
+    validate_options(options)?;
+    if outcomes.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    if outcomes.len() != censored.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: outcomes.len(),
+            right: censored.len(),
+        });
+    }
+    if !censoring.boundary().is_finite() {
+        return Err(StatisticsError::NonFiniteInput {
+            index: 0,
+            value: censoring.boundary(),
+        });
+    }
+    for (index, &value) in outcomes.iter().enumerate() {
+        if !value.is_finite() {
+            return Err(StatisticsError::NonFiniteInput { index, value });
+        }
+        if !censored[index] {
+            match censoring {
+                Censoring::Left { boundary } if value <= boundary => {
+                    return Err(StatisticsError::DegenerateSample {
+                        reason: "uncensored left-Tobit outcome must exceed the boundary",
+                    });
+                }
+                Censoring::Right { boundary } if value >= boundary => {
+                    return Err(StatisticsError::DegenerateSample {
+                        reason: "uncensored right-Tobit outcome must be below the boundary",
+                    });
+                }
+                _ => {}
+            }
+        }
+    }
+    let censored_observations = censored.iter().filter(|&&value| value).count();
+    if censored_observations == outcomes.len() {
+        return Err(StatisticsError::DegenerateSample {
+            reason: "Tobit regression requires at least one uncensored outcome",
+        });
+    }
+    let design = try_design_matrix(predictors, outcomes.len(), options.include_intercept)?;
+    if outcomes.len() <= design.columns() {
+        return Err(StatisticsError::InsufficientSamples {
+            required: design.columns() + 1,
+            actual: outcomes.len(),
+        });
+    }
+    let mut parameters = initial_parameters(predictors, outcomes, censored, options)?;
+    let mut current = objective_and_gradient(
+        &design,
+        outcomes,
+        censored,
+        censoring,
+        &parameters,
+        options.ridge,
+        options.include_intercept,
+    )?;
+    let mut converged = false;
+    let mut completed_iterations = 0;
+    for iteration in 0..options.maximum_iterations {
+        let gradient_norm = current.1.iter().map(|value| value * value).sum::<f64>().sqrt();
+        if gradient_norm <= options.tolerance * (1.0 + parameters.len() as f64) {
+            converged = true;
+            completed_iterations = iteration;
+            break;
+        }
+        let direction_scale = gradient_norm.max(1.0);
+        let mut step = options.initial_step;
+        let mut accepted = None;
+        while step >= 1.0e-12 {
+            let candidate = parameters
+                .iter()
+                .zip(&current.1)
+                .map(|(&parameter, &gradient)| parameter + step * gradient / direction_scale)
+                .collect::<Vec<_>>();
+            if let Ok(value) = objective_and_gradient(
+                &design,
+                outcomes,
+                censored,
+                censoring,
+                &candidate,
+                options.ridge,
+                options.include_intercept,
+            ) {
+                if value.0 >= current.0 + 1.0e-4 * step * gradient_norm {
+                    accepted = Some((candidate, value));
+                    break;
+                }
+            }
+            step *= 0.5;
+        }
+        let Some((candidate, value)) = accepted else {
+            completed_iterations = iteration + 1;
+            break;
+        };
+        let parameter_change = candidate
+            .iter()
+            .zip(&parameters)
+            .map(|(&left, &right)| (left - right).abs())
+            .fold(0.0_f64, f64::max);
+        parameters = candidate;
+        current = value;
+        completed_iterations = iteration + 1;
+        if parameter_change <= options.tolerance {
+            converged = true;
+            break;
+        }
+    }
+    if !converged {
+        return Err(StatisticsError::NonConvergence {
+            function: "Gaussian Tobit regression",
+            iterations: options.maximum_iterations,
+        });
+    }
+    let coefficient_count = design.columns();
+    let coefficients = parameters[..coefficient_count].to_vec();
+    let sigma = parameters[coefficient_count].exp();
+    let estimated_parameters = (coefficient_count + 1) as f64;
+    let n = outcomes.len() as f64;
+    Ok(TobitFit {
+        coefficients,
+        sigma,
+        censoring,
+        predictor_count: coefficient_count - usize::from(options.include_intercept),
+        include_intercept: options.include_intercept,
+        ridge: options.ridge,
+        observations: outcomes.len(),
+        censored_observations,
+        iterations: completed_iterations,
+        converged,
+        log_likelihood: current.0,
+        aic: 2.0 * estimated_parameters - 2.0 * current.0,
+        bic: estimated_parameters * n.ln() - 2.0 * current.0,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn left_tobit_recovers_positive_slope() {
+        let predictors = (-20..=20)
+            .map(|index| vec![index as f64 / 10.0])
+            .collect::<Vec<_>>();
+        let latent = predictors
+            .iter()
+            .enumerate()
+            .map(|(index, row)| 0.5 + 1.5 * row[0] + ((index % 5) as f64 - 2.0) * 0.08)
+            .collect::<Vec<_>>();
+        let boundary = 0.0;
+        let censored = latent.iter().map(|&value| value <= boundary).collect::<Vec<_>>();
+        let observed = latent.iter().map(|&value| value.max(boundary)).collect::<Vec<_>>();
+        let fit = try_tobit_regression(
+            &predictors,
+            &observed,
+            &censored,
+            Censoring::Left { boundary },
+            TobitOptions::default(),
+        )
+        .unwrap();
+        assert!(fit.coefficients[1] > 1.2);
+        assert!(fit.coefficients[1] < 1.8);
+        assert!(fit.try_censoring_probability(&[-2.0]).unwrap() > 0.9);
+    }
+
+    #[test]
+    fn rejects_all_censored_data() {
+        let predictors = vec![vec![0.0], vec![1.0], vec![2.0]];
+        let outcomes = vec![0.0, 0.0, 0.0];
+        let censored = vec![true, true, true];
+        assert!(matches!(
+            try_tobit_regression(
+                &predictors,
+                &outcomes,
+                &censored,
+                Censoring::Left { boundary: 0.0 },
+                TobitOptions::default(),
+            ),
+            Err(StatisticsError::DegenerateSample { .. })
+        ));
+    }
+}
diff --git a/src/clustering.rs b/src/clustering.rs
new file mode 100644
index 0000000..d1082b4
--- /dev/null
+++ b/src/clustering.rs
@@ -0,0 +1,354 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Deterministic k-means clustering and silhouette diagnostics.
+
+use crate::error::{StatsResult, StatisticsError};
+use crate::sampling::SplitMix64;
+
+const MAXIMUM_PAIRWISE_WORK: u128 = 50_000_000;
+
+fn validate_observations(observations: &[Vec<f64>]) -> StatsResult<usize> {
+    if observations.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    let dimensions = observations[0].len();
+    if dimensions == 0 {
+        return Err(StatisticsError::InvalidShape {
+            rows: observations.len(),
+            columns: 0,
+        });
+    }
+    for (row_index, row) in observations.iter().enumerate() {
+        if row.len() != dimensions {
+            return Err(StatisticsError::DimensionMismatch {
+                context: "clustering observation row",
+                expected: dimensions,
+                actual: row.len(),
+            });
+        }
+        for (column, &value) in row.iter().enumerate() {
+            if !value.is_finite() {
+                return Err(StatisticsError::NonFiniteInput {
+                    index: row_index * dimensions + column,
+                    value,
+                });
+            }
+        }
+    }
+    Ok(dimensions)
+}
+
+fn squared_distance(left: &[f64], right: &[f64]) -> f64 {
+    left.iter()
+        .zip(right)
+        .map(|(&a, &b)| (a - b) * (a - b))
+        .sum()
+}
+
+fn initialize_kmeans_plus_plus(
+    observations: &[Vec<f64>],
+    clusters: usize,
+    seed: u64,
+) -> StatsResult<Vec<Vec<f64>>> {
+    let mut rng = SplitMix64::new(seed);
+    let first = rng.index(observations.len())?;
+    let mut centroids = vec![observations[first].clone()];
+    let mut minimum_distances = vec![f64::INFINITY; observations.len()];
+    while centroids.len() < clusters {
+        let newest = centroids.last().ok_or(StatisticsError::DegenerateSample {
+            reason: "k-means initialization has no centroid",
+        })?;
+        let mut total = 0.0;
+        for (index, observation) in observations.iter().enumerate() {
+            minimum_distances[index] = minimum_distances[index].min(squared_distance(observation, newest));
+            total += minimum_distances[index];
+        }
+        if !total.is_finite() || total <= 0.0 {
+            let candidate = observations
+                .iter()
+                .enumerate()
+                .find(|(_, observation)| !centroids.iter().any(|center| center.as_slice() == observation.as_slice()))
+                .map(|(index, _)| index)
+                .ok_or(StatisticsError::DegenerateSample {
+                    reason: "fewer distinct observations than requested clusters",
+                })?;
+            centroids.push(observations[candidate].clone());
+            continue;
+        }
+        let threshold = rng.next_f64() * total;
+        let mut cumulative = 0.0;
+        let mut selected = observations.len() - 1;
+        for (index, &distance) in minimum_distances.iter().enumerate() {
+            cumulative += distance;
+            if cumulative >= threshold {
+                selected = index;
+                break;
+            }
+        }
+        centroids.push(observations[selected].clone());
+    }
+    Ok(centroids)
+}
+
+fn assign(observations: &[Vec<f64>], centroids: &[Vec<f64>]) -> StatsResult<(Vec<usize>, f64)> {
+    let mut assignments = Vec::with_capacity(observations.len());
+    let mut inertia = 0.0;
+    for observation in observations {
+        let (cluster, distance) = centroids
+            .iter()
+            .enumerate()
+            .map(|(index, centroid)| (index, squared_distance(observation, centroid)))
+            .min_by(|left, right| left.1.total_cmp(&right.1))
+            .ok_or(StatisticsError::DegenerateSample {
+                reason: "k-means has no centroids",
+            })?;
+        assignments.push(cluster);
+        inertia += distance;
+    }
+    if inertia.is_finite() {
+        Ok((assignments, inertia))
+    } else {
+        Err(StatisticsError::NumericalOverflow {
+            operation: "k-means inertia",
+        })
+    }
+}
+
+/// Controls for deterministic k-means fitting.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct KMeansOptions {
+    pub clusters: usize,
+    pub maximum_iterations: usize,
+    pub tolerance: f64,
+    pub seed: u64,
+}
+
+impl Default for KMeansOptions {
+    fn default() -> Self {
+        Self {
+            clusters: 2,
+            maximum_iterations: 300,
+            tolerance: 1.0e-8,
+            seed: 0,
+        }
+    }
+}
+
+/// Fitted k-means partition.
+#[derive(Debug, Clone, PartialEq)]
+pub struct KMeansFit {
+    pub centroids: Vec<Vec<f64>>,
+    pub assignments: Vec<usize>,
+    pub cluster_sizes: Vec<usize>,
+    pub inertia: f64,
+    pub iterations: usize,
+    pub converged: bool,
+    pub seed: u64,
+}
+
+impl KMeansFit {
+    pub fn try_predict(&self, observation: &[f64]) -> StatsResult<usize> {
+        if self.centroids.is_empty() {
+            return Err(StatisticsError::DegenerateSample {
+                reason: "k-means model has no centroids",
+            });
+        }
+        if observation.len() != self.centroids[0].len() {
+            return Err(StatisticsError::DimensionMismatch {
+                context: "k-means prediction",
+                expected: self.centroids[0].len(),
+                actual: observation.len(),
+            });
+        }
+        for (index, &value) in observation.iter().enumerate() {
+            if !value.is_finite() {
+                return Err(StatisticsError::NonFiniteInput { index, value });
+            }
+        }
+        self.centroids
+            .iter()
+            .enumerate()
+            .map(|(index, centroid)| (index, squared_distance(observation, centroid)))
+            .min_by(|left, right| left.1.total_cmp(&right.1))
+            .map(|(index, _)| index)
+            .ok_or(StatisticsError::DegenerateSample {
+                reason: "k-means model has no centroids",
+            })
+    }
+}
+
+/// Fit seeded k-means++ with deterministic tie-breaking.
+pub fn try_kmeans(observations: &[Vec<f64>], options: KMeansOptions) -> StatsResult<KMeansFit> {
+    let dimensions = validate_observations(observations)?;
+    if options.clusters < 2 || options.clusters > observations.len() {
+        return Err(StatisticsError::InvalidShape {
+            rows: observations.len(),
+            columns: options.clusters,
+        });
+    }
+    if options.maximum_iterations == 0 {
+        return Err(StatisticsError::InvalidIterations {
+            iterations: options.maximum_iterations,
+        });
+    }
+    if !options.tolerance.is_finite() || options.tolerance <= 0.0 {
+        return Err(StatisticsError::NonPositiveValue {
+            name: "k-means tolerance",
+            value: options.tolerance,
+        });
+    }
+    let mut centroids = initialize_kmeans_plus_plus(observations, options.clusters, options.seed)?;
+    let mut previous_assignments = Vec::new();
+    let mut iterations = 0;
+    let mut converged = false;
+    for iteration in 0..options.maximum_iterations {
+        let (assignments, _) = assign(observations, &centroids)?;
+        if assignments == previous_assignments {
+            converged = true;
+            iterations = iteration;
+            break;
+        }
+        let mut sums = vec![vec![0.0; dimensions]; options.clusters];
+        let mut counts = vec![0_usize; options.clusters];
+        for (observation, &cluster) in observations.iter().zip(&assignments) {
+            counts[cluster] += 1;
+            for column in 0..dimensions {
+                sums[cluster][column] += observation[column];
+            }
+        }
+        if counts.iter().any(|&count| count == 0) {
+            return Err(StatisticsError::DegenerateSample {
+                reason: "k-means produced an empty cluster",
+            });
+        }
+        let mut maximum_shift = 0.0_f64;
+        for cluster in 0..options.clusters {
+            for column in 0..dimensions {
+                let updated = sums[cluster][column] / counts[cluster] as f64;
+                maximum_shift = maximum_shift.max((updated - centroids[cluster][column]).abs());
+                centroids[cluster][column] = updated;
+            }
+        }
+        previous_assignments = assignments;
+        iterations = iteration + 1;
+        if maximum_shift <= options.tolerance {
+            converged = true;
+            break;
+        }
+    }
+    if !converged {
+        return Err(StatisticsError::NonConvergence {
+            function: "k-means",
+            iterations: options.maximum_iterations,
+        });
+    }
+    let (assignments, inertia) = assign(observations, &centroids)?;
+    let mut cluster_sizes = vec![0_usize; options.clusters];
+    for &cluster in &assignments {
+        cluster_sizes[cluster] += 1;
+    }
+    Ok(KMeansFit {
+        centroids,
+        assignments,
+        cluster_sizes,
+        inertia,
+        iterations,
+        converged,
+        seed: options.seed,
+    })
+}
+
+/// Mean silhouette coefficient for an externally supplied partition.
+pub fn try_silhouette_score(observations: &[Vec<f64>], assignments: &[usize]) -> StatsResult<f64> {
+    validate_observations(observations)?;
+    if observations.len() != assignments.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: observations.len(),
+            right: assignments.len(),
+        });
+    }
+    let cluster_count = assignments.iter().copied().max().map_or(0, |value| value + 1);
+    if cluster_count < 2 {
+        return Err(StatisticsError::DegenerateSample {
+            reason: "silhouette score requires at least two clusters",
+        });
+    }
+    let work = (observations.len() as u128).saturating_mul(observations.len() as u128);
+    if work > MAXIMUM_PAIRWISE_WORK {
+        return Err(StatisticsError::ComputationTooLarge {
+            states: work,
+            maximum: MAXIMUM_PAIRWISE_WORK,
+        });
+    }
+    let mut counts = vec![0_usize; cluster_count];
+    for &cluster in assignments {
+        if cluster >= cluster_count {
+            return Err(StatisticsError::DimensionMismatch {
+                context: "silhouette cluster label",
+                expected: cluster_count,
+                actual: cluster + 1,
+            });
+        }
+        counts[cluster] += 1;
+    }
+    if counts.iter().any(|&count| count == 0) {
+        return Err(StatisticsError::DegenerateSample {
+            reason: "silhouette labels must be contiguous and non-empty",
+        });
+    }
+    let mut total = 0.0;
+    for index in 0..observations.len() {
+        let own = assignments[index];
+        if counts[own] == 1 {
+            continue;
+        }
+        let mut sums = vec![0.0; cluster_count];
+        for other in 0..observations.len() {
+            if other != index {
+                sums[assignments[other]] += squared_distance(&observations[index], &observations[other]).sqrt();
+            }
+        }
+        let within = sums[own] / (counts[own] - 1) as f64;
+        let nearest = (0..cluster_count)
+            .filter(|&cluster| cluster != own)
+            .map(|cluster| sums[cluster] / counts[cluster] as f64)
+            .fold(f64::INFINITY, f64::min);
+        total += if within == 0.0 && nearest == 0.0 {
+            0.0
+        } else {
+            (nearest - within) / within.max(nearest)
+        };
+    }
+    let score = total / observations.len() as f64;
+    if score.is_finite() {
+        Ok(score.clamp(-1.0, 1.0))
+    } else {
+        Err(StatisticsError::NumericalOverflow {
+            operation: "silhouette score",
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn kmeans_finds_two_separated_clusters() {
+        let data = vec![
+            vec![-2.0, -2.0], vec![-1.8, -2.1], vec![-2.2, -1.9],
+            vec![2.0, 2.0], vec![1.8, 2.1], vec![2.2, 1.9],
+        ];
+        let fit = try_kmeans(&data, KMeansOptions { seed: 7, ..KMeansOptions::default() }).unwrap();
+        assert_eq!(fit.cluster_sizes, vec![3, 3]);
+        assert!(try_silhouette_score(&data, &fit.assignments).unwrap() > 0.9);
+    }
+
+    #[test]
+    fn kmeans_is_reproducible() {
+        let data = (0..20).map(|index| vec![index as f64, (index % 3) as f64]).collect::<Vec<_>>();
+        let options = KMeansOptions { clusters: 3, seed: 99, ..KMeansOptions::default() };
+        assert_eq!(try_kmeans(&data, options).unwrap(), try_kmeans(&data, options).unwrap());
+    }
+}
