@@ -0,0 +1,329 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Linear mediation analysis with Sobel and deterministic bootstrap inference.
+
+use crate::descriptive::try_quantile;
+use crate::distributions::normal_sf;
+use crate::error::{StatsResult, StatisticsError};
+use crate::inference::Interval;
+use crate::multiple_regression::{MultipleLinearFit, try_multiple_linear_regression};
+use crate::sampling::SplitMix64;
+
+fn validate_inputs(
+    treatment: &[f64],
+    mediator: &[f64],
+    outcome: &[f64],
+    covariates: &[Vec<f64>],
+) -> StatsResult<()> {
+    if treatment.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    if treatment.len() != mediator.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: treatment.len(),
+            right: mediator.len(),
+        });
+    }
+    if treatment.len() != outcome.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: treatment.len(),
+            right: outcome.len(),
+        });
+    }
+    if !covariates.is_empty() && covariates.len() != treatment.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: covariates.len(),
+            right: treatment.len(),
+        });
+    }
+    for (index, &value) in treatment.iter().chain(mediator).chain(outcome).enumerate() {
+        if !value.is_finite() {
+            return Err(StatisticsError::NonFiniteInput { index, value });
+        }
+    }
+    if !covariates.is_empty() {
+        let columns = covariates[0].len();
+        for (row_index, row) in covariates.iter().enumerate() {
+            if row.len() != columns {
+                return Err(StatisticsError::DimensionMismatch {
+                    context: "mediation covariate row",
+                    expected: columns,
+                    actual: row.len(),
+                });
+            }
+            for (column, &value) in row.iter().enumerate() {
+                if !value.is_finite() {
+                    return Err(StatisticsError::NonFiniteInput {
+                        index: row_index * columns + column,
+                        value,
+                    });
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+fn mediator_predictors(treatment: &[f64], covariates: &[Vec<f64>]) -> Vec<Vec<f64>> {
+    treatment
+        .iter()
+        .enumerate()
+        .map(|(index, &value)| {
+            let mut row = Vec::with_capacity(1 + covariates.first().map_or(0, Vec::len));
+            row.push(value);
+            if !covariates.is_empty() {
+                row.extend_from_slice(&covariates[index]);
+            }
+            row
+        })
+        .collect()
+}
+
+fn outcome_predictors(
+    treatment: &[f64],
+    mediator: Option<&[f64]>,
+    covariates: &[Vec<f64>],
+) -> Vec<Vec<f64>> {
+    treatment
+        .iter()
+        .enumerate()
+        .map(|(index, &value)| {
+            let mut row = Vec::with_capacity(
+                1 + usize::from(mediator.is_some()) + covariates.first().map_or(0, Vec::len),
+            );
+            row.push(value);
+            if let Some(mediator_values) = mediator {
+                row.push(mediator_values[index]);
+            }
+            if !covariates.is_empty() {
+                row.extend_from_slice(&covariates[index]);
+            }
+            row
+        })
+        .collect()
+}
+
+fn fit_paths(
+    treatment: &[f64],
+    mediator: &[f64],
+    outcome: &[f64],
+    covariates: &[Vec<f64>],
+) -> StatsResult<(MultipleLinearFit, MultipleLinearFit, MultipleLinearFit)> {
+    let mediator_model = try_multiple_linear_regression(
+        &mediator_predictors(treatment, covariates),
+        mediator,
+        true,
+        0.95,
+    )?;
+    let outcome_model = try_multiple_linear_regression(
+        &outcome_predictors(treatment, Some(mediator), covariates),
+        outcome,
+        true,
+        0.95,
+    )?;
+    let total_model = try_multiple_linear_regression(
+        &outcome_predictors(treatment, None, covariates),
+        outcome,
+        true,
+        0.95,
+    )?;
+    Ok((mediator_model, outcome_model, total_model))
+}
+
+/// Linear mediation decomposition.
+#[derive(Debug, Clone, PartialEq)]
+pub struct MediationResult {
+    /// Treatment-to-mediator coefficient `a`.
+    pub path_a: f64,
+    /// Mediator-to-outcome coefficient `b`, conditional on treatment.
+    pub path_b: f64,
+    /// Direct treatment effect `c'`.
+    pub direct_effect: f64,
+    /// Total treatment effect `c`.
+    pub total_effect: f64,
+    /// Product-of-coefficients indirect effect `a*b`.
+    pub indirect_effect: f64,
+    pub proportion_mediated: Option<f64>,
+    pub sobel_standard_error: f64,
+    pub sobel_z: f64,
+    pub sobel_p_two_sided: f64,
+    pub bootstrap_interval: Option<Interval>,
+    pub confidence: f64,
+    pub bootstrap_draws: usize,
+    pub seed: u64,
+    pub observations: usize,
+}
+
+/// Estimate a linear mediation model. Bootstrap intervals resample complete
+/// rows and are percentile intervals for the indirect effect.
+pub fn try_linear_mediation(
+    treatment: &[f64],
+    mediator: &[f64],
+    outcome: &[f64],
+    covariates: &[Vec<f64>],
+    confidence: f64,
+    bootstrap_draws: usize,
+    seed: u64,
+) -> StatsResult<MediationResult> {
+    validate_inputs(treatment, mediator, outcome, covariates)?;
+    if !confidence.is_finite() || !(0.0..1.0).contains(&confidence) {
+        return Err(StatisticsError::InvalidProbability { value: confidence });
+    }
+    let covariate_count = covariates.first().map_or(0, Vec::len);
+    let required = covariate_count + 4;
+    if treatment.len() < required {
+        return Err(StatisticsError::InsufficientSamples {
+            required,
+            actual: treatment.len(),
+        });
+    }
+    let (mediator_model, outcome_model, total_model) =
+        fit_paths(treatment, mediator, outcome, covariates)?;
+    let path_a = mediator_model.coefficients[1];
+    let path_b = outcome_model.coefficients[2];
+    let direct_effect = outcome_model.coefficients[1];
+    let total_effect = total_model.coefficients[1];
+    let indirect_effect = path_a * path_b;
+    let standard_error_a = mediator_model.standard_errors[1];
+    let standard_error_b = outcome_model.standard_errors[2];
+    let sobel_standard_error = (
+        path_b * path_b * standard_error_a * standard_error_a
+            + path_a * path_a * standard_error_b * standard_error_b
+    )
+        .sqrt();
+    let sobel_z = if sobel_standard_error == 0.0 {
+        if indirect_effect == 0.0 {
+            0.0
+        } else {
+            indirect_effect.signum() * f64::INFINITY
+        }
+    } else {
+        indirect_effect / sobel_standard_error
+    };
+    let sobel_p_two_sided = (2.0 * normal_sf(sobel_z.abs())).clamp(0.0, 1.0);
+    let proportion_mediated = if total_effect.abs() > f64::EPSILON {
+        Some(indirect_effect / total_effect)
+    } else {
+        None
+    };
+
+    let bootstrap_interval = if bootstrap_draws == 0 {
+        None
+    } else {
+        let work = (bootstrap_draws as u128).saturating_mul(treatment.len() as u128);
+        if work > 10_000_000 {
+            return Err(StatisticsError::ComputationTooLarge {
+                states: work,
+                maximum: 10_000_000,
+            });
+        }
+        let mut rng = SplitMix64::new(seed);
+        let mut effects = Vec::with_capacity(bootstrap_draws);
+        for _ in 0..bootstrap_draws {
+            let indices = (0..treatment.len())
+                .map(|_| rng.index(treatment.len()))
+                .collect::<StatsResult<Vec<_>>>()?;
+            let sampled_treatment = indices.iter().map(|&index| treatment[index]).collect::<Vec<_>>();
+            let sampled_mediator = indices.iter().map(|&index| mediator[index]).collect::<Vec<_>>();
+            let sampled_outcome = indices.iter().map(|&index| outcome[index]).collect::<Vec<_>>();
+            let sampled_covariates = if covariates.is_empty() {
+                Vec::new()
+            } else {
+                indices.iter().map(|&index| covariates[index].clone()).collect()
+            };
+            if let Ok((mediator_fit, outcome_fit, _)) = fit_paths(
+                &sampled_treatment,
+                &sampled_mediator,
+                &sampled_outcome,
+                &sampled_covariates,
+            ) {
+                effects.push(mediator_fit.coefficients[1] * outcome_fit.coefficients[2]);
+            }
+        }
+        if effects.len() < bootstrap_draws / 2 + 1 {
+            return Err(StatisticsError::NonConvergence {
+                function: "mediation bootstrap",
+                iterations: bootstrap_draws,
+            });
+        }
+        let alpha = 1.0 - confidence;
+        Some(Interval {
+            low: try_quantile(&effects, alpha / 2.0)?,
+            high: try_quantile(&effects, 1.0 - alpha / 2.0)?,
+        })
+    };
+
+    Ok(MediationResult {
+        path_a,
+        path_b,
+        direct_effect,
+        total_effect,
+        indirect_effect,
+        proportion_mediated,
+        sobel_standard_error,
+        sobel_z,
+        sobel_p_two_sided,
+        bootstrap_interval,
+        confidence,
+        bootstrap_draws,
+        seed,
+        observations: treatment.len(),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn recovers_constructed_mediation() {
+        let treatment = (-20..=20).map(|value| value as f64 / 10.0).collect::<Vec<_>>();
+        let mediator = treatment
+            .iter()
+            .enumerate()
+            .map(|(index, value)| 0.5 + 1.2 * value + ((index % 5) as f64 - 2.0) * 0.03)
+            .collect::<Vec<_>>();
+        let outcome = treatment
+            .iter()
+            .zip(&mediator)
+            .enumerate()
+            .map(|(index, (&treatment, &mediator))| {
+                1.0 + 0.4 * treatment + 1.5 * mediator + ((index % 7) as f64 - 3.0) * 0.02
+            })
+            .collect::<Vec<_>>();
+        let result = try_linear_mediation(
+            &treatment,
+            &mediator,
+            &outcome,
+            &[],
+            0.95,
+            99,
+            13,
+        )
+        .unwrap();
+        assert!((result.path_a - 1.2).abs() < 0.1);
+        assert!((result.path_b - 1.5).abs() < 0.1);
+        assert!((result.indirect_effect - 1.8).abs() < 0.2);
+        assert!(result.bootstrap_interval.unwrap().contains(1.8));
+    }
+
+    #[test]
+    fn bootstrap_is_reproducible() {
+        let treatment = (0..20).map(|value| value as f64).collect::<Vec<_>>();
+        let mediator = treatment
+            .iter()
+            .enumerate()
+            .map(|(index, value)| value + (index % 4) as f64 * 0.05)
+            .collect::<Vec<_>>();
+        let outcome = treatment
+            .iter()
+            .zip(&mediator)
+            .enumerate()
+            .map(|(index, (&x, &m))| x + m + (index % 3) as f64 * 0.01)
+            .collect::<Vec<_>>();
+        let left = try_linear_mediation(&treatment, &mediator, &outcome, &[], 0.9, 49, 7).unwrap();
+        let right = try_linear_mediation(&treatment, &mediator, &outcome, &[], 0.9, 49, 7).unwrap();
+        assert_eq!(left.bootstrap_interval, right.bootstrap_interval);
+    }
+}
diff --git a/src/partial_correlation.rs b/src/partial_correlation.rs
new file mode 100644
index 0000000..2dfc4e3
--- /dev/null
+++ b/src/partial_correlation.rs
@@ -0,0 +1,162 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Precision matrices and partial correlations for multivariate Gaussian geometry.
+
+use crate::error::{StatsResult, StatisticsError};
+use crate::linalg::{CholeskyFactor, DenseMatrix};
+use crate::multivariate::try_multivariate_moments;
+
+/// Precision-matrix summary with pairwise partial correlations.
+#[derive(Debug, Clone, PartialEq)]
+pub struct PartialCorrelationFit {
+    pub mean: Vec<f64>,
+    pub covariance: DenseMatrix,
+    pub precision: DenseMatrix,
+    pub partial_correlations: DenseMatrix,
+    pub ridge: f64,
+    pub observations: usize,
+}
+
+impl PartialCorrelationFit {
+    pub fn dimensions(&self) -> usize {
+        self.mean.len()
+    }
+
+    /// Partial correlation between two variables after conditioning on all others.
+    pub fn try_partial_correlation(&self, left: usize, right: usize) -> StatsResult<f64> {
+        if left >= self.dimensions() || right >= self.dimensions() {
+            return Err(StatisticsError::DimensionMismatch {
+                context: "partial-correlation variable index",
+                expected: self.dimensions(),
+                actual: left.max(right).saturating_add(1),
+            });
+        }
+        Ok(self.partial_correlations.get(left, right))
+    }
+
+    /// Gaussian conditional regression coefficients for `target` on every
+    /// other variable, ordered by the original variable index.
+    pub fn try_conditional_coefficients(&self, target: usize) -> StatsResult<Vec<f64>> {
+        if target >= self.dimensions() {
+            return Err(StatisticsError::DimensionMismatch {
+                context: "conditional target index",
+                expected: self.dimensions(),
+                actual: target.saturating_add(1),
+            });
+        }
+        let diagonal = self.precision.get(target, target);
+        if diagonal <= 0.0 || !diagonal.is_finite() {
+            return Err(StatisticsError::SingularMatrix {
+                reason: "precision diagonal is not positive",
+            });
+        }
+        let mut coefficients = Vec::with_capacity(self.dimensions().saturating_sub(1));
+        for variable in 0..self.dimensions() {
+            if variable != target {
+                coefficients.push(-self.precision.get(target, variable) / diagonal);
+            }
+        }
+        Ok(coefficients)
+    }
+
+    /// Conditional variance of one variable given all remaining variables.
+    pub fn try_conditional_variance(&self, target: usize) -> StatsResult<f64> {
+        if target >= self.dimensions() {
+            return Err(StatisticsError::DimensionMismatch {
+                context: "conditional variance target index",
+                expected: self.dimensions(),
+                actual: target.saturating_add(1),
+            });
+        }
+        let diagonal = self.precision.get(target, target);
+        if diagonal <= 0.0 || !diagonal.is_finite() {
+            return Err(StatisticsError::SingularMatrix {
+                reason: "precision diagonal is not positive",
+            });
+        }
+        Ok(diagonal.recip())
+    }
+}
+
+/// Estimate a covariance precision matrix and all-order partial correlations.
+pub fn try_partial_correlations(
+    observations: &[Vec<f64>],
+    ridge: f64,
+) -> StatsResult<PartialCorrelationFit> {
+    if !ridge.is_finite() || ridge < 0.0 {
+        return Err(StatisticsError::NegativeValue {
+            name: "precision ridge",
+            value: ridge,
+        });
+    }
+    let moments = try_multivariate_moments(observations)?;
+    if moments.count() < 2 {
+        return Err(StatisticsError::InsufficientSamples {
+            required: 2,
+            actual: moments.count() as usize,
+        });
+    }
+    let mut covariance = moments.sample_covariance()?;
+    for index in 0..covariance.rows() {
+        covariance.set(index, index, covariance.get(index, index) + ridge);
+    }
+    let factor = CholeskyFactor::try_factor(&covariance)?;
+    let precision = factor.try_inverse()?;
+    let mut partial_correlations = DenseMatrix::identity(covariance.rows())?;
+    for row in 0..covariance.rows() {
+        let row_diagonal = precision.get(row, row);
+        if row_diagonal <= 0.0 || !row_diagonal.is_finite() {
+            return Err(StatisticsError::SingularMatrix {
+                reason: "precision diagonal is not positive",
+            });
+        }
+        for column in 0..row {
+            let column_diagonal = precision.get(column, column);
+            let denominator = (row_diagonal * column_diagonal).sqrt();
+            if denominator <= 0.0 || !denominator.is_finite() {
+                return Err(StatisticsError::SingularMatrix {
+                    reason: "partial-correlation normalization failed",
+                });
+            }
+            let value = (-precision.get(row, column) / denominator).clamp(-1.0, 1.0);
+            partial_correlations.set(row, column, value);
+            partial_correlations.set(column, row, value);
+        }
+    }
+    Ok(PartialCorrelationFit {
+        mean: moments.mean().unwrap_or(&[]).to_vec(),
+        covariance,
+        precision,
+        partial_correlations,
+        ridge,
+        observations: moments.count() as usize,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn conditioning_removes_common_driver() {
+        let data = (-20..=20)
+            .map(|index| {
+                let z = index as f64 / 5.0;
+                vec![z + (index % 3) as f64 * 0.02, 2.0 * z - (index % 5) as f64 * 0.02, z]
+            })
+            .collect::<Vec<_>>();
+        let fit = try_partial_correlations(&data, 1e-5).unwrap();
+        assert!(fit.try_partial_correlation(0, 1).unwrap().abs() < 0.2);
+        assert!(fit.try_conditional_variance(0).unwrap() > 0.0);
+    }
+
+    #[test]
+    fn ridge_handles_collinearity() {
+        let data = vec![
+            vec![1.0, 2.0], vec![2.0, 4.0], vec![3.0, 6.0], vec![4.0, 8.0],
+        ];
+        assert!(try_partial_correlations(&data, 0.0).is_err());
+        assert!(try_partial_correlations(&data, 1e-3).is_ok());
+    }
+}
diff --git a/src/survival_scoring.rs b/src/survival_scoring.rs
new file mode 100644
index 0000000..d637045
--- /dev/null
+++ b/src/survival_scoring.rs
@@ -0,0 +1,329 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Survival discrimination and inverse-censoring-weighted prediction scores.
+
+use crate::error::{StatsResult, StatisticsError};
+
+const MAXIMUM_PAIRWISE_WORK: u128 = 50_000_000;
+
+fn validate_survival(times: &[f64], events: &[bool]) -> StatsResult<()> {
+    if times.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    if times.len() != events.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: times.len(),
+            right: events.len(),
+        });
+    }
+    for (index, &time) in times.iter().enumerate() {
+        if !time.is_finite() {
+            return Err(StatisticsError::NonFiniteInput { index, value: time });
+        }
+        if time < 0.0 {
+            return Err(StatisticsError::NegativeValue {
+                name: "survival time",
+                value: time,
+            });
+        }
+    }
+    Ok(())
+}
+
+/// Harrell concordance-index summary.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct ConcordanceIndex {
+    pub concordance: f64,
+    pub concordant_pairs: f64,
+    pub comparable_pairs: usize,
+    pub tied_risk_pairs: usize,
+}
+
+/// Harrell's C index where larger risk scores imply earlier events.
+pub fn try_concordance_index(
+    times: &[f64],
+    events: &[bool],
+    risk_scores: &[f64],
+) -> StatsResult<ConcordanceIndex> {
+    validate_survival(times, events)?;
+    if times.len() != risk_scores.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: times.len(),
+            right: risk_scores.len(),
+        });
+    }
+    for (index, &value) in risk_scores.iter().enumerate() {
+        if !value.is_finite() {
+            return Err(StatisticsError::NonFiniteInput { index, value });
+        }
+    }
+    let work = (times.len() as u128).saturating_mul(times.len() as u128);
+    if work > MAXIMUM_PAIRWISE_WORK {
+        return Err(StatisticsError::ComputationTooLarge {
+            states: work,
+            maximum: MAXIMUM_PAIRWISE_WORK,
+        });
+    }
+    let mut concordant = 0.0;
+    let mut comparable = 0_usize;
+    let mut tied_risk = 0_usize;
+    for left in 0..times.len() {
+        for right in left + 1..times.len() {
+            let earlier = if times[left] < times[right] && events[left] {
+                Some((left, right))
+            } else if times[right] < times[left] && events[right] {
+                Some((right, left))
+            } else {
+                None
+            };
+            if let Some((event_index, later_index)) = earlier {
+                comparable += 1;
+                match risk_scores[event_index].total_cmp(&risk_scores[later_index]) {
+                    std::cmp::Ordering::Greater => concordant += 1.0,
+                    std::cmp::Ordering::Equal => {
+                        concordant += 0.5;
+                        tied_risk += 1;
+                    }
+                    std::cmp::Ordering::Less => {}
+                }
+            }
+        }
+    }
+    if comparable == 0 {
+        return Err(StatisticsError::DegenerateSample {
+            reason: "concordance index has no comparable event pairs",
+        });
+    }
+    Ok(ConcordanceIndex {
+        concordance: concordant / comparable as f64,
+        concordant_pairs: concordant,
+        comparable_pairs: comparable,
+        tied_risk_pairs: tied_risk,
+    })
+}
+
+#[derive(Debug, Clone, Copy)]
+struct CensoringStep {
+    time: f64,
+    survival_before: f64,
+    survival_after: f64,
+}
+
+fn censoring_curve(times: &[f64], events: &[bool]) -> Vec<CensoringStep> {
+    let mut observations = times
+        .iter()
+        .zip(events)
+        .map(|(&time, &event)| (time, !event))
+        .collect::<Vec<_>>();
+    observations.sort_by(|left, right| left.0.total_cmp(&right.0));
+    let mut at_risk = observations.len();
+    let mut survival = 1.0;
+    let mut steps = Vec::new();
+    let mut index = 0;
+    while index < observations.len() {
+        let time = observations[index].0;
+        let mut censored_events = 0_usize;
+        let mut total = 0_usize;
+        while index + total < observations.len() && observations[index + total].0 == time {
+            if observations[index + total].1 {
+                censored_events += 1;
+            }
+            total += 1;
+        }
+        let before = survival;
+        if censored_events > 0 {
+            survival *= 1.0 - censored_events as f64 / at_risk as f64;
+        }
+        steps.push(CensoringStep {
+            time,
+            survival_before: before,
+            survival_after: survival,
+        });
+        at_risk -= total;
+        index += total;
+    }
+    steps
+}
+
+fn censoring_before(steps: &[CensoringStep], time: f64) -> f64 {
+    steps
+        .iter()
+        .find(|step| step.time == time)
+        .map_or_else(
+            || {
+                steps
+                    .iter()
+                    .take_while(|step| step.time < time)
+                    .last()
+                    .map_or(1.0, |step| step.survival_after)
+            },
+            |step| step.survival_before,
+        )
+}
+
+fn censoring_at(steps: &[CensoringStep], time: f64) -> f64 {
+    steps
+        .iter()
+        .take_while(|step| step.time <= time)
+        .last()
+        .map_or(1.0, |step| step.survival_after)
+}
+
+/// IPCW Brier score at one horizon.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct SurvivalBrierScore {
+    pub horizon: f64,
+    pub score: f64,
+    pub effective_weight: f64,
+}
+
+/// Inverse-probability-of-censoring weighted Brier score at fixed horizons.
+pub fn try_survival_brier_scores(
+    times: &[f64],
+    events: &[bool],
+    horizons: &[f64],
+    predicted_survival: &[Vec<f64>],
+) -> StatsResult<Vec<SurvivalBrierScore>> {
+    validate_survival(times, events)?;
+    if horizons.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    if predicted_survival.len() != times.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: predicted_survival.len(),
+            right: times.len(),
+        });
+    }
+    for (index, &horizon) in horizons.iter().enumerate() {
+        if !horizon.is_finite() {
+            return Err(StatisticsError::NonFiniteInput { index, value: horizon });
+        }
+        if horizon < 0.0 {
+            return Err(StatisticsError::NegativeValue {
+                name: "Brier-score horizon",
+                value: horizon,
+            });
+        }
+        if index > 0 && horizon <= horizons[index - 1] {
+            return Err(StatisticsError::DegenerateSample {
+                reason: "Brier-score horizons must be strictly increasing",
+            });
+        }
+    }
+    for (row_index, row) in predicted_survival.iter().enumerate() {
+        if row.len() != horizons.len() {
+            return Err(StatisticsError::DimensionMismatch {
+                context: "survival prediction row",
+                expected: horizons.len(),
+                actual: row.len(),
+            });
+        }
+        for (column, &value) in row.iter().enumerate() {
+            if !value.is_finite() {
+                return Err(StatisticsError::NonFiniteInput {
+                    index: row_index * horizons.len() + column,
+                    value,
+                });
+            }
+            if !(0.0..=1.0).contains(&value) {
+                return Err(StatisticsError::InvalidProbability { value });
+            }
+            if column > 0 && value > row[column - 1] + 1.0e-12 {
+                return Err(StatisticsError::DegenerateSample {
+                    reason: "survival probabilities must be non-increasing across horizons",
+                });
+            }
+        }
+    }
+    let censoring = censoring_curve(times, events);
+    let mut scores = Vec::with_capacity(horizons.len());
+    for (column, &horizon) in horizons.iter().enumerate() {
+        let censoring_horizon = censoring_at(&censoring, horizon);
+        let mut weighted_error = 0.0;
+        let mut total_weight = 0.0;
+        for index in 0..times.len() {
+            let prediction = predicted_survival[index][column];
+            if times[index] <= horizon && events[index] {
+                let probability = censoring_before(&censoring, times[index]);
+                if probability <= 0.0 {
+                    continue;
+                }
+                let weight = probability.recip();
+                weighted_error += weight * prediction * prediction;
+                total_weight += weight;
+            } else if times[index] > horizon {
+                if censoring_horizon <= 0.0 {
+                    continue;
+                }
+                let weight = censoring_horizon.recip();
+                weighted_error += weight * (1.0 - prediction) * (1.0 - prediction);
+                total_weight += weight;
+            }
+        }
+        if total_weight <= 0.0 || !total_weight.is_finite() {
+            return Err(StatisticsError::DegenerateSample {
+                reason: "Brier score has no observations with positive censoring weight",
+            });
+        }
+        scores.push(SurvivalBrierScore {
+            horizon,
+            score: weighted_error / times.len() as f64,
+            effective_weight: total_weight,
+        });
+    }
+    Ok(scores)
+}
+
+/// Trapezoidal integrated Brier score divided by the horizon span.
+pub fn try_integrated_brier_score(scores: &[SurvivalBrierScore]) -> StatsResult<f64> {
+    if scores.len() < 2 {
+        return Err(StatisticsError::InsufficientSamples {
+            required: 2,
+            actual: scores.len(),
+        });
+    }
+    let span = scores.last().map_or(0.0, |value| value.horizon) - scores[0].horizon;
+    if span <= 0.0 {
+        return Err(StatisticsError::DegenerateSample {
+            reason: "integrated Brier score requires increasing horizons",
+        });
+    }
+    let mut area = 0.0;
+    for pair in scores.windows(2) {
+        if pair[1].horizon <= pair[0].horizon {
+            return Err(StatisticsError::DegenerateSample {
+                reason: "integrated Brier score requires increasing horizons",
+            });
+        }
+        area += 0.5 * (pair[0].score + pair[1].score) * (pair[1].horizon - pair[0].horizon);
+    }
+    Ok(area / span)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn concordance_rewards_correct_ranking() {
+        let times = vec![1.0, 2.0, 3.0, 4.0];
+        let events = vec![true, true, true, false];
+        let result = try_concordance_index(&times, &events, &[4.0, 3.0, 2.0, 1.0]).unwrap();
+        assert!((result.concordance - 1.0).abs() < 1e-12);
+    }
+
+    #[test]
+    fn perfect_survival_predictions_have_zero_brier_score_without_censoring() {
+        let times = vec![1.0, 2.0, 3.0, 4.0];
+        let events = vec![true, true, true, true];
+        let horizons = vec![1.5, 2.5, 3.5];
+        let predictions = times
+            .iter()
+            .map(|&time| horizons.iter().map(|&horizon| if time > horizon { 1.0 } else { 0.0 }).collect())
+            .collect::<Vec<Vec<f64>>>();
+        let scores = try_survival_brier_scores(&times, &events, &horizons, &predictions).unwrap();
+        assert!(scores.iter().all(|score| score.score.abs() < 1e-12));
+        assert!(try_integrated_brier_score(&scores).unwrap().abs() < 1e-12);
+    }
+}
