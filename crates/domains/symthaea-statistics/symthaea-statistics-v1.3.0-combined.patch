new file mode 100644
index 0000000..e80e791
--- /dev/null
+++ b/src/copula.rs
@@ -0,0 +1,256 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Gaussian copulas for rank-based dependence modeling and deterministic sampling.
+
+use crate::distributions::{normal_cdf, try_normal_quantile};
+use crate::error::{StatsResult, StatisticsError};
+use crate::linalg::DenseMatrix;
+use crate::multivariate_normal::MultivariateNormal;
+use std::f64::consts::PI;
+
+fn validate_observations(observations: &[Vec<f64>]) -> StatsResult<usize> {
+    if observations.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    let dimensions = observations[0].len();
+    if dimensions < 2 {
+        return Err(StatisticsError::InsufficientSamples {
+            required: 2,
+            actual: dimensions,
+        });
+    }
+    for (row_index, row) in observations.iter().enumerate() {
+        if row.len() != dimensions {
+            return Err(StatisticsError::DimensionMismatch {
+                context: "copula observation row",
+                expected: dimensions,
+                actual: row.len(),
+            });
+        }
+        for (column, &value) in row.iter().enumerate() {
+            if !value.is_finite() {
+                return Err(StatisticsError::NonFiniteInput {
+                    index: row_index * dimensions + column,
+                    value,
+                });
+            }
+        }
+    }
+    Ok(dimensions)
+}
+
+fn average_ranks(values: &[f64]) -> Vec<f64> {
+    let mut order = values.iter().copied().enumerate().collect::<Vec<_>>();
+    order.sort_by(|left, right| left.1.total_cmp(&right.1));
+    let mut ranks = vec![0.0; values.len()];
+    let mut start = 0;
+    while start < order.len() {
+        let mut end = start + 1;
+        while end < order.len() && order[end].1 == order[start].1 {
+            end += 1;
+        }
+        let average = 0.5 * ((start + 1) as f64 + end as f64);
+        for position in start..end {
+            ranks[order[position].0] = average;
+        }
+        start = end;
+    }
+    ranks
+}
+
+fn correlation_from_latent(latent: &[Vec<f64>], ridge: f64) -> StatsResult<Vec<Vec<f64>>> {
+    let rows = latent.len();
+    let dimensions = latent[0].len();
+    let mut means = vec![0.0; dimensions];
+    for row in latent {
+        for (column, &value) in row.iter().enumerate() {
+            means[column] += value;
+        }
+    }
+    for mean in &mut means {
+        *mean /= rows as f64;
+    }
+    let mut covariance = vec![vec![0.0; dimensions]; dimensions];
+    for row in latent {
+        for left in 0..dimensions {
+            let left_centered = row[left] - means[left];
+            for right in 0..=left {
+                covariance[left][right] += left_centered * (row[right] - means[right]);
+            }
+        }
+    }
+    let denominator = (rows - 1) as f64;
+    for left in 0..dimensions {
+        for right in 0..=left {
+            let value = covariance[left][right] / denominator;
+            covariance[left][right] = value;
+            covariance[right][left] = value;
+        }
+    }
+    let mut correlation = vec![vec![0.0; dimensions]; dimensions];
+    for left in 0..dimensions {
+        let left_scale = covariance[left][left].sqrt();
+        if left_scale <= 0.0 || !left_scale.is_finite() {
+            return Err(StatisticsError::DegenerateSample {
+                reason: "copula variable has zero latent variance",
+            });
+        }
+        for right in 0..=left {
+            let right_scale = covariance[right][right].sqrt();
+            let mut value = covariance[left][right] / (left_scale * right_scale);
+            if left == right {
+                value = 1.0;
+            } else {
+                value *= 1.0 - ridge;
+            }
+            correlation[left][right] = value;
+            correlation[right][left] = value;
+        }
+    }
+    Ok(correlation)
+}
+
+fn validate_uniforms(values: &[f64], dimensions: usize) -> StatsResult<Vec<f64>> {
+    if values.len() != dimensions {
+        return Err(StatisticsError::DimensionMismatch {
+            context: "copula probability vector",
+            expected: dimensions,
+            actual: values.len(),
+        });
+    }
+    values
+        .iter()
+        .enumerate()
+        .map(|(index, &value)| {
+            if !value.is_finite() {
+                Err(StatisticsError::NonFiniteInput { index, value })
+            } else if !(0.0..1.0).contains(&value) {
+                Err(StatisticsError::InvalidProbability { value })
+            } else {
+                try_normal_quantile(value)
+            }
+        })
+        .collect()
+}
+
+/// Fitted Gaussian copula with a positive-definite latent correlation matrix.
+#[derive(Debug, Clone, PartialEq)]
+pub struct GaussianCopula {
+    correlation: DenseMatrix,
+    latent: MultivariateNormal,
+    pub ridge: f64,
+    pub observations: usize,
+}
+
+impl GaussianCopula {
+    pub fn dimensions(&self) -> usize {
+        self.correlation.rows()
+    }
+
+    pub fn correlation(&self) -> &DenseMatrix {
+        &self.correlation
+    }
+
+    /// Log copula density at an open-unit-cube point.
+    pub fn try_log_density(&self, uniforms: &[f64]) -> StatsResult<f64> {
+        let latent = validate_uniforms(uniforms, self.dimensions())?;
+        let joint = self.latent.try_log_pdf(&latent)?;
+        let marginal = latent
+            .iter()
+            .map(|value| -0.5 * (2.0 * PI).ln() - 0.5 * value * value)
+            .sum::<f64>();
+        let result = joint - marginal;
+        if result.is_finite() {
+            Ok(result)
+        } else {
+            Err(StatisticsError::NumericalOverflow {
+                operation: "Gaussian copula log-density",
+            })
+        }
+    }
+
+    pub fn try_density(&self, uniforms: &[f64]) -> StatsResult<f64> {
+        Ok(self.try_log_density(uniforms)?.exp())
+    }
+
+    /// Draw deterministic open-unit-cube samples from the copula.
+    pub fn try_sample(&self, draws: usize, seed: u64) -> StatsResult<Vec<Vec<f64>>> {
+        let latent = self.latent.try_sample(draws, seed)?;
+        Ok(latent
+            .into_iter()
+            .map(|row| {
+                row.into_iter()
+                    .map(|value| normal_cdf(value).clamp(f64::MIN_POSITIVE, 1.0 - f64::EPSILON))
+                    .collect()
+            })
+            .collect())
+    }
+}
+
+/// Fit a Gaussian copula from empirical marginal ranks. `ridge` shrinks
+/// off-diagonal latent correlations toward independence and must lie in `[0, 1)`.
+pub fn try_gaussian_copula(
+    observations: &[Vec<f64>],
+    ridge: f64,
+) -> StatsResult<GaussianCopula> {
+    if !ridge.is_finite() || !(0.0..1.0).contains(&ridge) {
+        return Err(StatisticsError::InvalidProbability { value: ridge });
+    }
+    let dimensions = validate_observations(observations)?;
+    if observations.len() < 3 {
+        return Err(StatisticsError::InsufficientSamples {
+            required: 3,
+            actual: observations.len(),
+        });
+    }
+    let mut latent = vec![vec![0.0; dimensions]; observations.len()];
+    for column in 0..dimensions {
+        let values = observations.iter().map(|row| row[column]).collect::<Vec<_>>();
+        let ranks = average_ranks(&values);
+        for row in 0..observations.len() {
+            let probability = ranks[row] / (observations.len() as f64 + 1.0);
+            latent[row][column] = try_normal_quantile(probability)?;
+        }
+    }
+    let correlation_rows = correlation_from_latent(&latent, ridge)?;
+    let correlation = DenseMatrix::try_from_rows(&correlation_rows)?;
+    let model = MultivariateNormal::try_new(vec![0.0; dimensions], correlation_rows)?;
+    Ok(GaussianCopula {
+        correlation,
+        latent: model,
+        ridge,
+        observations: observations.len(),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn recovers_positive_rank_dependence() {
+        let observations = (0..50)
+            .map(|index| {
+                let x = index as f64;
+                vec![x, 2.0 * x + (index % 7) as f64]
+            })
+            .collect::<Vec<_>>();
+        let copula = try_gaussian_copula(&observations, 1e-8).unwrap();
+        assert!(copula.correlation().try_get(0, 1).unwrap() > 0.95);
+        assert!(copula.try_log_density(&[0.8, 0.8]).unwrap() > 0.0);
+    }
+
+    #[test]
+    fn samples_are_reproducible_and_open() {
+        let observations = vec![
+            vec![0.0, 0.0], vec![1.0, 2.0], vec![2.0, 1.0],
+            vec![3.0, 4.0], vec![4.0, 3.0],
+        ];
+        let copula = try_gaussian_copula(&observations, 1e-6).unwrap();
+        let left = copula.try_sample(32, 42).unwrap();
+        let right = copula.try_sample(32, 42).unwrap();
+        assert_eq!(left, right);
+        assert!(left.iter().flatten().all(|value| (0.0..1.0).contains(value)));
+    }
+}
