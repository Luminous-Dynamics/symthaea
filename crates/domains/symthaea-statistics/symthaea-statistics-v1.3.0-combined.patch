@@ -0,0 +1,176 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+use symthaea_statistics::{
+    Censoring, KMeansOptions, StatisticsError, TobitOptions,
+    try_canonical_correlation, try_concordance_index, try_diebold_mariano,
+    try_forecast_accuracy, try_gaussian_copula, try_integrated_brier_score,
+    try_kmeans, try_linear_discriminant, try_linear_mediation,
+    try_one_way_manova, try_partial_correlations, try_quadratic_discriminant,
+    try_silhouette_score, try_survival_brier_scores, try_tobit_regression,
+    ForecastLoss, SurvivalBrierScore,
+};
+
+#[test]
+fn multivariate_models_reject_singular_or_malformed_inputs() {
+    assert!(matches!(
+        try_linear_discriminant(&[vec![1.0], vec![2.0]], &[0], 0.0),
+        Err(StatisticsError::LengthMismatch { .. })
+    ));
+    assert!(matches!(
+        try_quadratic_discriminant(
+            &[vec![1.0], vec![2.0], vec![3.0]],
+            &[0, 1, 1],
+            0.0,
+        ),
+        Err(StatisticsError::InsufficientSamples { .. })
+    ));
+    assert!(matches!(
+        try_canonical_correlation(
+            &[vec![1.0, 2.0], vec![2.0, 4.0], vec![3.0, 6.0]],
+            &[vec![1.0], vec![2.0], vec![3.0]],
+            0.0,
+        ),
+        Err(StatisticsError::SingularMatrix { .. })
+    ));
+    assert!(matches!(
+        try_one_way_manova(
+            &[vec![1.0], vec![2.0]],
+            &[0, 0],
+            0.0,
+            0,
+            0,
+        ),
+        Err(StatisticsError::DegenerateSample { .. })
+    ));
+    assert!(matches!(
+        try_partial_correlations(&[vec![1.0], vec![1.0]], 0.0),
+        Err(StatisticsError::SingularMatrix { .. })
+    ));
+}
+
+#[test]
+fn copula_contracts_preserve_open_unit_support() {
+    let observations = vec![
+        vec![0.0, 0.0], vec![1.0, 2.0], vec![2.0, 1.0],
+        vec![3.0, 4.0], vec![4.0, 3.0],
+    ];
+    assert!(matches!(
+        try_gaussian_copula(&observations, 1.0),
+        Err(StatisticsError::InvalidProbability { .. })
+    ));
+    let copula = try_gaussian_copula(&observations, 1.0e-6).unwrap();
+    assert!(matches!(
+        copula.try_log_density(&[0.0, 0.5]),
+        Err(StatisticsError::InvalidProbability { .. })
+    ));
+    let left = copula.try_sample(16, 77).unwrap();
+    let right = copula.try_sample(16, 77).unwrap();
+    assert_eq!(left, right);
+    assert!(left.iter().flatten().all(|value| (0.0..1.0).contains(value)));
+}
+
+#[test]
+fn censored_and_mediation_models_fail_closed() {
+    assert!(matches!(
+        try_tobit_regression(
+            &[vec![0.0], vec![1.0], vec![2.0]],
+            &[0.0, 0.0, 0.0],
+            &[true, true, true],
+            Censoring::Left { boundary: 0.0 },
+            TobitOptions::default(),
+        ),
+        Err(StatisticsError::DegenerateSample { .. })
+    ));
+    assert!(matches!(
+        try_tobit_regression(
+            &[vec![0.0], vec![1.0], vec![2.0]],
+            &[0.0, -1.0, 2.0],
+            &[true, false, false],
+            Censoring::Left { boundary: 0.0 },
+            TobitOptions::default(),
+        ),
+        Err(StatisticsError::DegenerateSample { .. })
+    ));
+    assert!(matches!(
+        try_linear_mediation(
+            &[0.0, 1.0, 2.0],
+            &[0.0, 1.0],
+            &[0.0, 1.0, 2.0],
+            &[],
+            0.95,
+            0,
+            0,
+        ),
+        Err(StatisticsError::LengthMismatch { .. })
+    ));
+}
+
+#[test]
+fn clustering_and_forecast_inputs_are_bounded() {
+    assert!(matches!(
+        try_kmeans(
+            &[vec![0.0], vec![1.0]],
+            KMeansOptions {
+                clusters: 3,
+                ..Default::default()
+            },
+        ),
+        Err(StatisticsError::InvalidShape { .. })
+    ));
+    assert!(matches!(
+        try_silhouette_score(&[vec![0.0], vec![1.0]], &[0, 0]),
+        Err(StatisticsError::DegenerateSample { .. })
+    ));
+    assert!(matches!(
+        try_forecast_accuracy(&[1.0], &[1.0], &[2.0, 2.0, 2.0], 1),
+        Err(StatisticsError::DegenerateSample { .. })
+    ));
+    assert!(matches!(
+        try_diebold_mariano(
+            &[1.0, 2.0, 3.0],
+            &[1.0, 2.0, 3.0],
+            &[1.0, 2.0, 3.0],
+            ForecastLoss::Squared,
+            0,
+        ),
+        Err(StatisticsError::DegenerateSample { .. })
+    ));
+}
+
+#[test]
+fn survival_scores_reject_invalid_probability_surfaces() {
+    assert!(matches!(
+        try_concordance_index(
+            &[1.0, 2.0],
+            &[false, false],
+            &[1.0, 0.0],
+        ),
+        Err(StatisticsError::DegenerateSample { .. })
+    ));
+    assert!(matches!(
+        try_survival_brier_scores(
+            &[1.0, 2.0],
+            &[true, true],
+            &[1.5],
+            &[vec![1.2], vec![0.0]],
+        ),
+        Err(StatisticsError::InvalidProbability { .. })
+    ));
+    assert!(matches!(
+        try_survival_brier_scores(
+            &[1.0, 2.0],
+            &[true, true],
+            &[1.0, 2.0],
+            &[vec![0.4, 0.6], vec![0.8, 0.7]],
+        ),
+        Err(StatisticsError::DegenerateSample { .. })
+    ));
+    assert!(matches!(
+        try_integrated_brier_score(&[
+            SurvivalBrierScore { horizon: 2.0, score: 0.1, effective_weight: 2.0 },
+            SurvivalBrierScore { horizon: 1.0, score: 0.2, effective_weight: 2.0 },
+        ]),
+        Err(StatisticsError::DegenerateSample { .. })
+    ));
+}
