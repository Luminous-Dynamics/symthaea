+    close(location_scale.log_likelihood, -14.800_710_367_012_256, 3.0e-10);
+
+    let mut mixed_predictors = Vec::new();
+    let mut mixed_outcomes = Vec::new();
+    let mut groups = Vec::new();
+    let offsets = [-1.5, -0.5, 0.75, 1.5];
+    let base_noise = [0.04, -0.03, 0.01, -0.02, 0.03, -0.01];
+    for (group, &offset) in offsets.iter().enumerate() {
+        for time in 0..6 {
