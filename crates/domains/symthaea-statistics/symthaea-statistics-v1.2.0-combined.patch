+#[test]
+fn location_scale_and_mixed_effect_references_match() {
+    let predictors = (0..30)
+        .map(|index| vec![index as f64 / 10.0])
+        .collect::<Vec<_>>();
+    let outcomes = predictors
+        .iter()
+        .enumerate()
+        .map(|(index, row)| {
+            2.0 + 0.5 * row[0]
+                + if index % 2 == 0 {
+                    -(0.2 + 0.15 * row[0])
+                } else {
+                    0.2 + 0.15 * row[0]
+                }
+        })
+        .collect::<Vec<_>>();
+    let location_scale = try_gaussian_location_scale(
+        &predictors,
+        &predictors,
+        &outcomes,
