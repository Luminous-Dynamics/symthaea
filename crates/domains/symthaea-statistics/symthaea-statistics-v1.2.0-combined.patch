+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Bayesian model comparison from exact conjugate evidence and posterior draws.
+
+use crate::error::{StatsResult, StatisticsError};
+use crate::special::ln_gamma;
+
+const MAX_EXACT_INTEGER_F64: u64 = 1_u64 << 53;
+
+/// Exact two-model evidence comparison.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct BayesFactorComparison {
+    pub log_bayes_factor_10: f64,
+    pub bayes_factor_10: f64,
+    pub prior_probability_alternative: f64,
+    pub posterior_probability_alternative: f64,
+}
+
+/// Widely applicable information criterion computed from pointwise posterior draws.
+#[derive(Debug, Clone, PartialEq)]
+pub struct WaicEstimate {
+    pub log_pointwise_predictive_density: f64,
+    pub effective_parameters: f64,
+    pub elpd_waic: f64,
+    pub waic: f64,
+    pub standard_error: f64,
+    pub pointwise_elpd: Vec<f64>,
+}
+
+fn ln_beta(alpha: f64, beta: f64) -> f64 {
+    ln_gamma(alpha) + ln_gamma(beta) - ln_gamma(alpha + beta)
+}
+
+fn validate_prior_probability(value: f64) -> StatsResult<()> {
+    if value.is_finite() && (0.0..1.0).contains(&value) {
+        Ok(())
+    } else {
+        Err(StatisticsError::InvalidProbability { value })
+    }
+}
+
+fn comparison_from_log_bayes_factor(
+    log_bayes_factor_10: f64,
+    prior_probability_alternative: f64,
+) -> StatsResult<BayesFactorComparison> {
+    validate_prior_probability(prior_probability_alternative)?;
+    if !log_bayes_factor_10.is_finite() {
+        return Err(StatisticsError::NumericalOverflow {
+            operation: "Bayes factor",
+        });
+    }
+    let log_prior_odds =
+        prior_probability_alternative.ln() - (1.0 - prior_probability_alternative).ln();
+    let log_posterior_odds = log_prior_odds + log_bayes_factor_10;
+    let posterior_probability_alternative = if log_posterior_odds >= 0.0 {
+        1.0 / (1.0 + (-log_posterior_odds).exp())
+    } else {
+        let odds = log_posterior_odds.exp();
+        odds / (1.0 + odds)
+    };
+    Ok(BayesFactorComparison {
+        log_bayes_factor_10,
+        bayes_factor_10: log_bayes_factor_10.exp(),
+        prior_probability_alternative,
+        posterior_probability_alternative,
+    })
+}
+
+/// Compare a point Bernoulli null against a beta-binomial alternative.
+///
+/// `BF10` favors the beta-prior alternative over the point null.
+pub fn try_beta_binomial_bayes_factor(
+    successes: u64,
+    trials: u64,
+    null_probability: f64,
+    prior_alpha: f64,
+    prior_beta: f64,
+    prior_probability_alternative: f64,
+) -> StatsResult<BayesFactorComparison> {
+    if successes > trials {
+        return Err(StatisticsError::InvalidCount { successes, trials });
+    }
+    if trials > MAX_EXACT_INTEGER_F64 {
+        return Err(StatisticsError::CountTooLarge {
+            value: trials as u128,
+            maximum: MAX_EXACT_INTEGER_F64 as u128,
+        });
+    }
+    if !null_probability.is_finite() || !(0.0..1.0).contains(&null_probability) {
+        return Err(StatisticsError::InvalidProbability {
+            value: null_probability,
+        });
+    }
+    for (name, value) in [
+        ("beta prior alpha", prior_alpha),
+        ("beta prior beta", prior_beta),
+    ] {
+        if !value.is_finite() || value <= 0.0 {
+            return Err(StatisticsError::NonPositiveValue { name, value });
+        }
+    }
+    let failures = trials - successes;
+    let successes_f = successes as f64;
+    let failures_f = failures as f64;
+    let log_alternative = ln_beta(prior_alpha + successes_f, prior_beta + failures_f)
+        - ln_beta(prior_alpha, prior_beta);
+    let log_null = successes_f * null_probability.ln()
+        + failures_f * (1.0 - null_probability).ln();
+    comparison_from_log_bayes_factor(
+        log_alternative - log_null,
+        prior_probability_alternative,
+    )
+}
+
+fn normal_log_density(value: f64, mean: f64, variance: f64) -> f64 {
+    -0.5
+        * ((2.0 * std::f64::consts::PI * variance).ln()
+            + (value - mean) * (value - mean) / variance)
+}
+
+/// Compare a point normal-mean null against a normal prior alternative.
+///
+/// The observation variance is known. The Bayes factor is computed from the
+/// sufficient statistic `sample_mean`, for which nuisance within-sample terms
+/// cancel exactly between models.
+pub fn try_normal_mean_bayes_factor(
+    sample_mean: f64,
+    sample_size: usize,
+    known_standard_deviation: f64,
+    null_mean: f64,
+    prior_mean: f64,
+    prior_standard_deviation: f64,
+    prior_probability_alternative: f64,
+) -> StatsResult<BayesFactorComparison> {
+    for (index, value) in [sample_mean, null_mean, prior_mean].into_iter().enumerate() {
+        if !value.is_finite() {
+            return Err(StatisticsError::NonFiniteInput { index, value });
+        }
+    }
+    if sample_size == 0 {
+        return Err(StatisticsError::EmptySample);
+    }
+    for (name, value) in [
+        ("known standard deviation", known_standard_deviation),
+        ("normal prior standard deviation", prior_standard_deviation),
+    ] {
+        if !value.is_finite() || value <= 0.0 {
+            return Err(StatisticsError::NonPositiveValue { name, value });
+        }
+    }
+    let null_variance = known_standard_deviation * known_standard_deviation / sample_size as f64;
+    let alternative_variance =
+        null_variance + prior_standard_deviation * prior_standard_deviation;
+    let log_bayes_factor_10 = normal_log_density(sample_mean, prior_mean, alternative_variance)
+        - normal_log_density(sample_mean, null_mean, null_variance);
+    comparison_from_log_bayes_factor(
+        log_bayes_factor_10,
+        prior_probability_alternative,
+    )
+}
+
+fn log_mean_exp(values: &[f64]) -> f64 {
+    let maximum = values.iter().copied().fold(f64::NEG_INFINITY, f64::max);
+    maximum
+        + (values
+            .iter()
+            .map(|value| (value - maximum).exp())
+            .sum::<f64>()
+            / values.len() as f64)
+            .ln()
+}
+
+fn sample_variance(values: &[f64]) -> f64 {
+    if values.len() < 2 {
+        return 0.0;
+    }
+    let mean = values.iter().sum::<f64>() / values.len() as f64;
+    values
+        .iter()
+        .map(|value| (value - mean) * (value - mean))
+        .sum::<f64>()
+        / (values.len() - 1) as f64
+}
+
+/// Compute WAIC from a draw-major matrix of pointwise log likelihoods.
+///
+/// Each outer row is one posterior draw and each inner column is one observed
+/// data point. At least two draws are required to estimate the variance term.
+pub fn try_waic(log_likelihood_draws: &[Vec<f64>]) -> StatsResult<WaicEstimate> {
+    if log_likelihood_draws.len() < 2 {
+        return Err(StatisticsError::InsufficientSamples {
+            required: 2,
+            actual: log_likelihood_draws.len(),
+        });
+    }
+    let observations = log_likelihood_draws[0].len();
+    if observations == 0 {
+        return Err(StatisticsError::EmptySample);
+    }
+    for (draw, row) in log_likelihood_draws.iter().enumerate() {
+        if row.len() != observations {
+            return Err(StatisticsError::DimensionMismatch {
+                context: "WAIC pointwise log likelihood",
+                expected: observations,
+                actual: row.len(),
+            });
+        }
+        for (observation, &value) in row.iter().enumerate() {
+            if !value.is_finite() {
+                return Err(StatisticsError::NonFiniteInput {
+                    index: draw * observations + observation,
+                    value,
+                });
+            }
+        }
+    }
+
+    let mut lppd = 0.0;
+    let mut effective_parameters = 0.0;
+    let mut pointwise_elpd = Vec::with_capacity(observations);
+    let mut values = vec![0.0; log_likelihood_draws.len()];
+    for observation in 0..observations {
+        for (draw, row) in log_likelihood_draws.iter().enumerate() {
+            values[draw] = row[observation];
+        }
+        let point_lppd = log_mean_exp(&values);
+        let penalty = sample_variance(&values);
+        lppd += point_lppd;
+        effective_parameters += penalty;
+        pointwise_elpd.push(point_lppd - penalty);
+    }
+    let elpd_waic = pointwise_elpd.iter().sum::<f64>();
+    let waic = -2.0 * elpd_waic;
+    let pointwise_deviance = pointwise_elpd
+        .iter()
+        .map(|value| -2.0 * value)
+        .collect::<Vec<_>>();
+    let standard_error = (observations as f64 * sample_variance(&pointwise_deviance)).sqrt();
+    if !waic.is_finite() || !standard_error.is_finite() {
+        return Err(StatisticsError::NumericalOverflow {
+            operation: "WAIC",
+        });
+    }
+    Ok(WaicEstimate {
+        log_pointwise_predictive_density: lppd,
+        effective_parameters,
+        elpd_waic,
+        waic,
+        standard_error,
+        pointwise_elpd,
+    })
+}
+
+/// Normalize log model evidence values into posterior model probabilities.
+pub fn try_posterior_model_probabilities(
+    log_evidence: &[f64],
+    prior_probabilities: &[f64],
+) -> StatsResult<Vec<f64>> {
+    if log_evidence.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    if log_evidence.len() != prior_probabilities.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: log_evidence.len(),
+            right: prior_probabilities.len(),
+        });
+    }
+    let mut log_weights = Vec::with_capacity(log_evidence.len());
+    let mut prior_sum = 0.0;
+    for index in 0..log_evidence.len() {
+        let evidence = log_evidence[index];
+        let prior = prior_probabilities[index];
+        if !evidence.is_finite() {
+            return Err(StatisticsError::NonFiniteInput {
+                index,
+                value: evidence,
+            });
+        }
+        if !prior.is_finite() || prior < 0.0 {
+            return Err(StatisticsError::InvalidProbability { value: prior });
+        }
+        prior_sum += prior;
+        log_weights.push(if prior == 0.0 {
+            f64::NEG_INFINITY
+        } else {
+            evidence + prior.ln()
+        });
+    }
+    if (prior_sum - 1.0).abs() > 1.0e-10 {
+        return Err(StatisticsError::InvalidProbabilityMass { sum: prior_sum });
+    }
+    let maximum = log_weights.iter().copied().fold(f64::NEG_INFINITY, f64::max);
+    if !maximum.is_finite() {
+        return Err(StatisticsError::DegenerateSample {
+            reason: "at least one model must have positive prior probability",
+        });
+    }
+    let denominator = log_weights
+        .iter()
+        .map(|value| (value - maximum).exp())
+        .sum::<f64>();
+    Ok(log_weights
+        .iter()
+        .map(|value| (value - maximum).exp() / denominator)
+        .collect())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn beta_binomial_evidence_favors_fair_coin_for_balanced_data() {
+        let comparison = try_beta_binomial_bayes_factor(10, 20, 0.5, 1.0, 1.0, 0.5).unwrap();
+        assert!(comparison.bayes_factor_10 < 1.0);
+        assert!(comparison.posterior_probability_alternative < 0.5);
+    }
+
+    #[test]
+    fn normal_mean_evidence_favors_shifted_alternative() {
+        let comparison = try_normal_mean_bayes_factor(2.0, 25, 1.0, 0.0, 0.0, 1.0, 0.5).unwrap();
+        assert!(comparison.bayes_factor_10 > 100.0);
+    }
+
+    #[test]
+    fn waic_is_finite_and_pointwise() {
+        let draws = vec![
+            vec![-1.0, -2.0, -0.5],
+            vec![-1.1, -1.8, -0.6],
+            vec![-0.9, -2.2, -0.4],
+        ];
+        let estimate = try_waic(&draws).unwrap();
+        assert_eq!(estimate.pointwise_elpd.len(), 3);
+        assert!(estimate.waic.is_finite());
+        assert!(estimate.effective_parameters > 0.0);
+    }
+
+    #[test]
+    fn model_probabilities_normalize() {
+        let probabilities = try_posterior_model_probabilities(&[-3.0, -1.0], &[0.5, 0.5]).unwrap();
+        assert!((probabilities.iter().sum::<f64>() - 1.0).abs() < 1.0e-12);
+        assert!(probabilities[1] > probabilities[0]);
+    }
+}
diff --git a/src/distributional_scoring.rs b/src/distributional_scoring.rs
new file mode 100644
index 0000000..6f312b3
--- /dev/null
+++ b/src/distributional_scoring.rs
@@ -0,0 +1,269 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Proper and task-specific scoring rules for distributional predictions.
+
+use crate::distributions::{normal_cdf, normal_pdf};
+use crate::error::{StatsResult, StatisticsError};
+
+/// Aggregated interval forecast diagnostics.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct IntervalForecastScore {
+    pub coverage: f64,
+    pub mean_width: f64,
+    pub mean_interval_score: f64,
+    pub nominal_coverage: f64,
+}
+
+fn validate_equal_finite(left: &[f64], right: &[f64]) -> StatsResult<()> {
+    if left.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    if left.len() != right.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: left.len(),
+            right: right.len(),
+        });
+    }
+    for (index, &value) in left.iter().chain(right).enumerate() {
+        if !value.is_finite() {
+            return Err(StatisticsError::NonFiniteInput { index, value });
+        }
+    }
+    Ok(())
+}
+
+/// Mean quantile/check loss. Lower is better.
+pub fn try_pinball_loss(
+    observations: &[f64],
+    predicted_quantiles: &[f64],
+    quantile: f64,
+) -> StatsResult<f64> {
+    validate_equal_finite(observations, predicted_quantiles)?;
+    if !quantile.is_finite() || !(0.0..1.0).contains(&quantile) {
+        return Err(StatisticsError::InvalidProbability { value: quantile });
+    }
+    let value = observations
+        .iter()
+        .zip(predicted_quantiles)
+        .map(|(&observed, &predicted)| {
+            let residual = observed - predicted;
+            if residual >= 0.0 {
+                quantile * residual
+            } else {
+                (quantile - 1.0) * residual
+            }
+        })
+        .sum::<f64>()
+        / observations.len() as f64;
+    if value.is_finite() {
+        Ok(value)
+    } else {
+        Err(StatisticsError::NumericalOverflow {
+            operation: "pinball loss",
+        })
+    }
+}
+
+/// Mean asymmetric squared expectile loss. Lower is better.
+pub fn try_expectile_loss(
+    observations: &[f64],
+    predicted_expectiles: &[f64],
+    expectile: f64,
+) -> StatsResult<f64> {
+    validate_equal_finite(observations, predicted_expectiles)?;
+    if !expectile.is_finite() || !(0.0..1.0).contains(&expectile) {
+        return Err(StatisticsError::InvalidProbability { value: expectile });
+    }
+    let value = observations
+        .iter()
+        .zip(predicted_expectiles)
+        .map(|(&observed, &predicted)| {
+            let residual = observed - predicted;
+            let weight = if residual >= 0.0 {
+                expectile
+            } else {
+                1.0 - expectile
+            };
+            weight * residual * residual
+        })
+        .sum::<f64>()
+        / observations.len() as f64;
+    if value.is_finite() {
+        Ok(value)
+    } else {
+        Err(StatisticsError::NumericalOverflow {
+            operation: "expectile loss",
+        })
+    }
+}
+
+/// Empirical coverage of predicted conditional quantiles.
+pub fn try_quantile_coverage(
+    observations: &[f64],
+    predicted_quantiles: &[f64],
+) -> StatsResult<f64> {
+    validate_equal_finite(observations, predicted_quantiles)?;
+    Ok(observations
+        .iter()
+        .zip(predicted_quantiles)
+        .filter(|(observed, predicted)| observed <= predicted)
+        .count() as f64
+        / observations.len() as f64)
+}
+
+/// Winkler interval score and coverage diagnostics for central intervals.
+pub fn try_interval_forecast_score(
+    observations: &[f64],
+    lower: &[f64],
+    upper: &[f64],
+    nominal_coverage: f64,
+) -> StatsResult<IntervalForecastScore> {
+    if observations.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    if lower.len() != observations.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: lower.len(),
+            right: observations.len(),
+        });
+    }
+    if upper.len() != observations.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: upper.len(),
+            right: observations.len(),
+        });
+    }
+    if !nominal_coverage.is_finite() || !(0.0..1.0).contains(&nominal_coverage) {
+        return Err(StatisticsError::InvalidProbability {
+            value: nominal_coverage,
+        });
+    }
+    let alpha = 1.0 - nominal_coverage;
+    let mut covered = 0_usize;
+    let mut width_sum = 0.0;
+    let mut score_sum = 0.0;
+    for index in 0..observations.len() {
+        let observed = observations[index];
+        let low = lower[index];
+        let high = upper[index];
+        for value in [observed, low, high] {
+            if !value.is_finite() {
+                return Err(StatisticsError::NonFiniteInput { index, value });
+            }
+        }
+        if low > high {
+            return Err(StatisticsError::DegenerateSample {
+                reason: "prediction interval lower bound exceeds upper bound",
+            });
+        }
+        let width = high - low;
+        width_sum += width;
+        let mut score = width;
+        if observed < low {
+            score += 2.0 / alpha * (low - observed);
+        } else if observed > high {
+            score += 2.0 / alpha * (observed - high);
+        } else {
+            covered += 1;
+        }
+        score_sum += score;
+    }
+    if !score_sum.is_finite() || !width_sum.is_finite() {
+        return Err(StatisticsError::NumericalOverflow {
+            operation: "interval forecast score",
+        });
+    }
+    Ok(IntervalForecastScore {
+        coverage: covered as f64 / observations.len() as f64,
+        mean_width: width_sum / observations.len() as f64,
+        mean_interval_score: score_sum / observations.len() as f64,
+        nominal_coverage,
+    })
+}
+
+/// Mean continuous ranked probability score for Gaussian forecasts.
+pub fn try_normal_crps(
+    observations: &[f64],
+    means: &[f64],
+    standard_deviations: &[f64],
+) -> StatsResult<f64> {
+    if observations.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    if means.len() != observations.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: means.len(),
+            right: observations.len(),
+        });
+    }
+    if standard_deviations.len() != observations.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: standard_deviations.len(),
+            right: observations.len(),
+        });
+    }
+    let mut score = 0.0;
+    for index in 0..observations.len() {
+        let observed = observations[index];
+        let mean = means[index];
+        let standard_deviation = standard_deviations[index];
+        if !observed.is_finite() {
+            return Err(StatisticsError::NonFiniteInput {
+                index,
+                value: observed,
+            });
+        }
+        if !mean.is_finite() {
+            return Err(StatisticsError::NonFiniteInput { index, value: mean });
+        }
+        if !standard_deviation.is_finite() || standard_deviation <= 0.0 {
+            return Err(StatisticsError::InvalidScale {
+                value: standard_deviation,
+            });
+        }
+        let z = (observed - mean) / standard_deviation;
+        score += standard_deviation
+            * (z * (2.0 * normal_cdf(z) - 1.0)
+                + 2.0 * normal_pdf(z)
+                - 1.0 / std::f64::consts::PI.sqrt());
+    }
+    score /= observations.len() as f64;
+    if score.is_finite() {
+        Ok(score)
+    } else {
+        Err(StatisticsError::NumericalOverflow {
+            operation: "Gaussian CRPS",
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn perfect_median_predictions_have_zero_pinball_loss() {
+        assert_eq!(
+            try_pinball_loss(&[1.0, 2.0, 3.0], &[1.0, 2.0, 3.0], 0.5).unwrap(),
+            0.0
+        );
+    }
+
+    #[test]
+    fn interval_score_penalizes_misses() {
+        let covered = try_interval_forecast_score(&[0.0], &[-1.0], &[1.0], 0.9).unwrap();
+        let missed = try_interval_forecast_score(&[3.0], &[-1.0], &[1.0], 0.9).unwrap();
+        assert!(missed.mean_interval_score > covered.mean_interval_score);
+        assert_eq!(covered.coverage, 1.0);
+        assert_eq!(missed.coverage, 0.0);
+    }
+
+    #[test]
+    fn gaussian_crps_is_small_at_the_mean() {
+        let centered = try_normal_crps(&[0.0], &[0.0], &[1.0]).unwrap();
+        let displaced = try_normal_crps(&[3.0], &[0.0], &[1.0]).unwrap();
+        assert!(centered < displaced);
+        assert!((centered - 0.23369497725510913).abs() < 1.0e-12);
+    }
+}
