+fn close(actual: f64, expected: f64, tolerance: f64) {
+    assert!(
+        (actual - expected).abs() <= tolerance,
+        "actual={actual}, expected={expected}, tolerance={tolerance}"
+    );
+}
+
+#[test]
+fn distributional_regression_references_match() {
+    let predictors = (0..9).map(|value| vec![value as f64]).collect::<Vec<_>>();
+    let mut outcomes = predictors
+        .iter()
+        .map(|row| 2.0 + 3.0 * row[0])
+        .collect::<Vec<_>>();
+    outcomes[8] += 100.0;
+    let quantile = try_quantile_regression(
+        &predictors,
+        &outcomes,
+        QuantileRegressionOptions::default(),
+    )
+    .unwrap();
+    close(quantile.coefficients[0], 1.999_999_750_000_022_2, 2.0e-5);
+    close(quantile.coefficients[1], 3.000_000_107_142_853, 2.0e-5);
+    close(quantile.objective, 50.000_000_624_999_98, 2.0e-4);
+
+    let values = [0.0, 0.0, 0.0, 1.0, 2.0, 10.0];
+    let low = try_expectile_regression(
+        &[],
