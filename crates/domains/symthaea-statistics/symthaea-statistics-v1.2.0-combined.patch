+    .unwrap();
+    close(location_scale.mean_coefficients[0], 1.973_253_154_124_676, 2.0e-7);
+    close(location_scale.mean_coefficients[1], 0.523_114_634_980_925_1, 2.0e-7);
+    close(location_scale.scale_coefficients[0], -2.962_786_125_664_741, 3.0e-7);
