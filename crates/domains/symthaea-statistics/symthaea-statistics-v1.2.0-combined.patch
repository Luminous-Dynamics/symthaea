@@ -0,0 +1,464 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Heteroskedastic Gaussian location-scale regression.
+//!
+//! The conditional mean is linear and the conditional variance is log-linear.
+//! Alternating Fisher scoring retains both predictor surfaces explicitly.
+
+use crate::distributions::{normal_sf, try_normal_quantile};
+use crate::error::{StatsResult, StatisticsError};
+use crate::inference::Interval;
+use crate::linalg::{CholeskyFactor, DenseMatrix};
+use crate::model_matrix::{try_design_matrix, try_feature_vector};
+use crate::qr::QrDecomposition;
+
+/// Controls for Gaussian location-scale fitting.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct LocationScaleOptions {
+    pub include_mean_intercept: bool,
+    pub include_scale_intercept: bool,
+    pub mean_ridge: f64,
+    pub scale_ridge: f64,
+    pub maximum_iterations: usize,
+    pub tolerance: f64,
+    pub confidence: f64,
+}
+
+impl Default for LocationScaleOptions {
+    fn default() -> Self {
+        Self {
+            include_mean_intercept: true,
+            include_scale_intercept: true,
+            mean_ridge: 0.0,
+            scale_ridge: 0.0,
+            maximum_iterations: 200,
+            tolerance: 1.0e-8,
+            confidence: 0.95,
+        }
+    }
+}
+
+/// Fitted heteroskedastic Gaussian model.
+#[derive(Debug, Clone, PartialEq)]
+pub struct GaussianLocationScaleFit {
+    pub mean_coefficients: Vec<f64>,
+    pub mean_standard_errors: Vec<f64>,
+    pub scale_coefficients: Vec<f64>,
+    pub scale_standard_errors: Vec<f64>,
+    pub mean_predictor_count: usize,
+    pub scale_predictor_count: usize,
+    pub include_mean_intercept: bool,
+    pub include_scale_intercept: bool,
+    pub n: usize,
+    pub iterations: usize,
+    pub log_likelihood: f64,
+    pub aic: f64,
+    pub bic: f64,
+    pub confidence: f64,
+}
+
+impl GaussianLocationScaleFit {
+    pub fn try_mean(&self, predictors: &[f64]) -> StatsResult<f64> {
+        let features = try_feature_vector(
+            predictors,
+            self.mean_predictor_count,
+            self.include_mean_intercept,
+        )?;
+        checked_dot(&features, &self.mean_coefficients, "location prediction")
+    }
+
+    pub fn try_log_variance(&self, predictors: &[f64]) -> StatsResult<f64> {
+        let features = try_feature_vector(
+            predictors,
+            self.scale_predictor_count,
+            self.include_scale_intercept,
+        )?;
+        checked_dot(&features, &self.scale_coefficients, "scale prediction")
+    }
+
+    pub fn try_variance(&self, predictors: &[f64]) -> StatsResult<f64> {
+        let value = self.try_log_variance(predictors)?.exp();
+        if value.is_finite() {
+            Ok(value)
+        } else {
+            Err(StatisticsError::NumericalOverflow {
+                operation: "location-scale predicted variance",
+            })
+        }
+    }
+
+    /// Conditional interval for one future Gaussian observation.
+    pub fn try_prediction_interval(
+        &self,
+        mean_predictors: &[f64],
+        scale_predictors: &[f64],
+        confidence: f64,
+    ) -> StatsResult<Interval> {
+        if !confidence.is_finite() || !(0.0..1.0).contains(&confidence) {
+            return Err(StatisticsError::InvalidProbability { value: confidence });
+        }
+        let mean = self.try_mean(mean_predictors)?;
+        let standard_deviation = self.try_variance(scale_predictors)?.sqrt();
+        let critical = try_normal_quantile(0.5 + confidence / 2.0)?;
+        Ok(Interval {
+            low: mean - critical * standard_deviation,
+            high: mean + critical * standard_deviation,
+        })
+    }
+}
+
+fn checked_dot(left: &[f64], right: &[f64], operation: &'static str) -> StatsResult<f64> {
+    let value = left
+        .iter()
+        .zip(right)
+        .fold(0.0, |sum, (&a, &b)| a.mul_add(b, sum));
+    if value.is_finite() {
+        Ok(value)
+    } else {
+        Err(StatisticsError::NumericalOverflow { operation })
+    }
+}
+
+fn validate_options(options: LocationScaleOptions) -> StatsResult<()> {
+    for (name, value) in [
+        ("location-scale mean ridge", options.mean_ridge),
+        ("location-scale scale ridge", options.scale_ridge),
+    ] {
+        if !value.is_finite() || value < 0.0 {
+            return Err(StatisticsError::NegativeValue { name, value });
+        }
+    }
+    if options.maximum_iterations == 0 {
+        return Err(StatisticsError::InvalidIterations { iterations: 0 });
+    }
+    if !options.tolerance.is_finite() || options.tolerance <= 0.0 {
+        return Err(StatisticsError::NonPositiveValue {
+            name: "location-scale convergence tolerance",
+            value: options.tolerance,
+        });
+    }
+    if !options.confidence.is_finite() || !(0.0..1.0).contains(&options.confidence) {
+        return Err(StatisticsError::InvalidProbability {
+            value: options.confidence,
+        });
+    }
+    Ok(())
+}
+
+fn add_ridge(
+    matrix: &mut DenseMatrix,
+    ridge: f64,
+    include_intercept: bool,
+) -> StatsResult<()> {
+    if ridge == 0.0 {
+        return Ok(());
+    }
+    for index in 0..matrix.rows() {
+        if !(include_intercept && index == 0) {
+            let value = matrix.get(index, index) + ridge;
+            if !value.is_finite() {
+                return Err(StatisticsError::NumericalOverflow {
+                    operation: "location-scale ridge stabilization",
+                });
+            }
+            matrix.set(index, index, value);
+        }
+    }
+    Ok(())
+}
+
+fn log_likelihood(
+    outcomes: &[f64],
+    means: &[f64],
+    log_variances: &[f64],
+) -> StatsResult<f64> {
+    let mut value = 0.0;
+    for index in 0..outcomes.len() {
+        let residual = outcomes[index] - means[index];
+        let variance = log_variances[index].clamp(-40.0, 40.0).exp();
+        value += -0.5
+            * ((2.0 * std::f64::consts::PI).ln()
+                + log_variances[index]
+                + residual * residual / variance);
+    }
+    if value.is_finite() {
+        Ok(value)
+    } else {
+        Err(StatisticsError::NumericalOverflow {
+            operation: "location-scale log likelihood",
+        })
+    }
+}
+
+/// Fit a Gaussian model with separate linear mean and log-variance predictors.
+pub fn try_gaussian_location_scale(
+    mean_predictors: &[Vec<f64>],
+    scale_predictors: &[Vec<f64>],
+    outcomes: &[f64],
+    options: LocationScaleOptions,
+) -> StatsResult<GaussianLocationScaleFit> {
+    validate_options(options)?;
+    if outcomes.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    for (index, &value) in outcomes.iter().enumerate() {
+        if !value.is_finite() {
+            return Err(StatisticsError::NonFiniteInput { index, value });
+        }
+    }
+    let mean_design = try_design_matrix(
+        mean_predictors,
+        outcomes.len(),
+        options.include_mean_intercept,
+    )?;
+    let scale_design = try_design_matrix(
+        scale_predictors,
+        outcomes.len(),
+        options.include_scale_intercept,
+    )?;
+    let total_parameters = mean_design.columns() + scale_design.columns();
+    if outcomes.len() <= total_parameters {
+        return Err(StatisticsError::InsufficientSamples {
+            required: total_parameters + 1,
+            actual: outcomes.len(),
+        });
+    }
+
+    let mean_factor = QrDecomposition::try_factor(&mean_design)?;
+    let mut mean_coefficients = mean_factor.try_solve_least_squares(outcomes)?;
+    let initial_means = mean_design.try_mul_vector(&mean_coefficients)?;
+    let initial_variance = outcomes
+        .iter()
+        .zip(&initial_means)
+        .map(|(&observed, &estimate)| (observed - estimate).powi(2))
+        .sum::<f64>()
+        / outcomes.len() as f64;
+    if !initial_variance.is_finite() || initial_variance <= f64::MIN_POSITIVE {
+        return Err(StatisticsError::DegenerateSample {
+            reason: "location-scale regression requires residual variation",
+        });
+    }
+    let mut scale_coefficients = vec![0.0; scale_design.columns()];
+    if options.include_scale_intercept {
+        scale_coefficients[0] = initial_variance.ln();
+    }
+    let unit_weights = vec![1.0; outcomes.len()];
+    let mut scale_information = scale_design.try_weighted_gram(&unit_weights)?;
+    add_ridge(
+        &mut scale_information,
+        options.scale_ridge,
+        options.include_scale_intercept,
+    )?;
+    let scale_factor = CholeskyFactor::try_factor(&scale_information)?;
+    let mut iterations = 0;
+
+    for iteration in 1..=options.maximum_iterations {
+        iterations = iteration;
+        let previous_mean = mean_coefficients.clone();
+        let previous_scale = scale_coefficients.clone();
+
+        let log_variances = scale_design.try_mul_vector(&scale_coefficients)?;
+        let weights = log_variances
+            .iter()
+            .map(|&value| (-value.clamp(-40.0, 40.0)).exp())
+            .collect::<Vec<_>>();
+        let mut mean_information = mean_design.try_weighted_gram(&weights)?;
+        add_ridge(
+            &mut mean_information,
+            options.mean_ridge,
+            options.include_mean_intercept,
+        )?;
+        let mean_rhs = mean_design.try_weighted_transpose_mul_vector(&weights, outcomes)?;
+        mean_coefficients = CholeskyFactor::try_factor(&mean_information)?.try_solve(&mean_rhs)?;
+
+        let means = mean_design.try_mul_vector(&mean_coefficients)?;
+        let log_variances = scale_design.try_mul_vector(&scale_coefficients)?;
+        let score_response = outcomes
+            .iter()
+            .zip(&means)
+            .zip(&log_variances)
+            .map(|((&observed, &estimate), &log_variance)| {
+                let residual = observed - estimate;
+                residual * residual / log_variance.clamp(-40.0, 40.0).exp() - 1.0
+            })
+            .collect::<Vec<_>>();
+        let score = scale_design.try_transpose_mul_vector(&score_response)?;
+        let delta = scale_factor.try_solve(&score)?;
+        let current_log_likelihood = log_likelihood(outcomes, &means, &log_variances)?;
+        let mut step = 1.0;
+        let mut accepted = false;
+        while step >= 1.0 / 1024.0 {
+            let candidate = scale_coefficients
+                .iter()
+                .zip(&delta)
+                .map(|(&coefficient, &change)| coefficient + step * change)
+                .collect::<Vec<_>>();
+            let candidate_log_variances = scale_design.try_mul_vector(&candidate)?;
+            let candidate_log_likelihood =
+                log_likelihood(outcomes, &means, &candidate_log_variances)?;
+            if candidate_log_likelihood >= current_log_likelihood - 1.0e-12 {
+                scale_coefficients = candidate;
+                accepted = true;
+                break;
+            }
+            step *= 0.5;
+        }
+        if !accepted {
+            return Err(StatisticsError::NonConvergence {
+                function: "location-scale Fisher scoring line search",
+                iterations: iteration,
+            });
+        }
+
+        let mean_change = mean_coefficients
+            .iter()
+            .zip(&previous_mean)
+            .map(|(&new, &old)| (new - old).abs())
+            .fold(0.0_f64, f64::max);
+        let scale_change = scale_coefficients
+            .iter()
+            .zip(&previous_scale)
+            .map(|(&new, &old)| (new - old).abs())
+            .fold(0.0_f64, f64::max);
+        let coefficient_scale = mean_coefficients
+            .iter()
+            .chain(&scale_coefficients)
+            .map(|value| value.abs())
+            .fold(0.0_f64, f64::max);
+        if mean_change.max(scale_change) <= options.tolerance * (1.0 + coefficient_scale) {
+            break;
+        }
+        if iteration == options.maximum_iterations {
+            return Err(StatisticsError::NonConvergence {
+                function: "Gaussian location-scale regression",
+                iterations,
+            });
+        }
+    }
+
+    let means = mean_design.try_mul_vector(&mean_coefficients)?;
+    let log_variances = scale_design.try_mul_vector(&scale_coefficients)?;
+    let weights = log_variances
+        .iter()
+        .map(|&value| (-value.clamp(-40.0, 40.0)).exp())
+        .collect::<Vec<_>>();
+    let mut mean_information = mean_design.try_weighted_gram(&weights)?;
+    add_ridge(
+        &mut mean_information,
+        options.mean_ridge,
+        options.include_mean_intercept,
+    )?;
+    let mean_covariance = CholeskyFactor::try_factor(&mean_information)?.try_inverse()?;
+    let scale_covariance_basis = scale_factor.try_inverse()?;
+    let mean_standard_errors = (0..mean_covariance.rows())
+        .map(|index| mean_covariance.get(index, index).max(0.0).sqrt())
+        .collect::<Vec<_>>();
+    let scale_standard_errors = (0..scale_covariance_basis.rows())
+        .map(|index| (2.0 * scale_covariance_basis.get(index, index)).max(0.0).sqrt())
+        .collect::<Vec<_>>();
+    let log_likelihood = log_likelihood(outcomes, &means, &log_variances)?;
+    let n = outcomes.len() as f64;
+    let parameters = total_parameters as f64;
+
+    Ok(GaussianLocationScaleFit {
+        mean_coefficients,
+        mean_standard_errors,
+        scale_coefficients,
+        scale_standard_errors,
+        mean_predictor_count: mean_design.columns()
+            - usize::from(options.include_mean_intercept),
+        scale_predictor_count: scale_design.columns()
+            - usize::from(options.include_scale_intercept),
+        include_mean_intercept: options.include_mean_intercept,
+        include_scale_intercept: options.include_scale_intercept,
+        n: outcomes.len(),
+        iterations,
+        log_likelihood,
+        aic: 2.0 * parameters - 2.0 * log_likelihood,
+        bic: parameters * n.ln() - 2.0 * log_likelihood,
+        confidence: options.confidence,
+    })
+}
+
+/// Wald z statistics and p-values for a coefficient vector.
+pub fn try_location_scale_wald(
+    coefficients: &[f64],
+    standard_errors: &[f64],
+) -> StatsResult<Vec<(f64, f64)>> {
+    if coefficients.len() != standard_errors.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: coefficients.len(),
+            right: standard_errors.len(),
+        });
+    }
+    coefficients
+        .iter()
+        .zip(standard_errors)
+        .enumerate()
+        .map(|(index, (&coefficient, &standard_error))| {
+            if !coefficient.is_finite() {
+                return Err(StatisticsError::NonFiniteInput {
+                    index,
+                    value: coefficient,
+                });
+            }
+            if !standard_error.is_finite() || standard_error < 0.0 {
+                return Err(StatisticsError::NegativeValue {
+                    name: "location-scale standard error",
+                    value: standard_error,
+                });
+            }
+            let z = if standard_error == 0.0 {
+                if coefficient == 0.0 { 0.0 } else { coefficient.signum() * f64::INFINITY }
+            } else {
+                coefficient / standard_error
+            };
+            Ok((z, (2.0 * normal_sf(z.abs())).clamp(0.0, 1.0)))
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn detects_increasing_conditional_variance() {
+        let mean_x = (0..30)
+            .map(|index| vec![index as f64 / 10.0])
+            .collect::<Vec<_>>();
+        let scale_x = mean_x.clone();
+        let outcomes = mean_x
+            .iter()
+            .enumerate()
+            .map(|(index, row)| {
+                let sign = if index % 2 == 0 { -1.0 } else { 1.0 };
+                2.0 + 0.5 * row[0] + sign * (0.2 + 0.15 * row[0])
+            })
+            .collect::<Vec<_>>();
+        let fit = try_gaussian_location_scale(
+            &mean_x,
+            &scale_x,
+            &outcomes,
+            LocationScaleOptions {
+                scale_ridge: 1.0e-8,
+                ..Default::default()
+            },
+        )
+        .unwrap();
+        assert!(fit.mean_coefficients[1] > 0.45 && fit.mean_coefficients[1] < 0.55);
+        assert!(fit.scale_coefficients[1] > 0.0);
+        assert!(fit.try_variance(&[2.5]).unwrap() > fit.try_variance(&[0.2]).unwrap());
+    }
+
+    #[test]
+    fn rejects_perfect_fit_without_variation() {
+        let x = (0..8).map(|index| vec![index as f64]).collect::<Vec<_>>();
+        let y = x.iter().map(|row| 1.0 + 2.0 * row[0]).collect::<Vec<_>>();
+        assert!(matches!(
+            try_gaussian_location_scale(&x, &x, &y, Default::default()),
+            Err(StatisticsError::DegenerateSample { .. })
+        ));
+    }
+}
