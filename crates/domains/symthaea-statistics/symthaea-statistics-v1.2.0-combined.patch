+    close(waic.log_pointwise_predictive_density, -3.480_049_736_921_640_3, 2.0e-13);
+    close(waic.effective_parameters, 0.060_000_000_000_000_026, 2.0e-14);
+    close(waic.waic, 7.080_099_473_843_28, 2.0e-13);
+    close(waic.standard_error, 2.683_658_098_455_959, 2.0e-13);
+
+    let star = WeightedGraph::try_from_adjacency(
+        &[
+            vec![0.0, 1.0, 1.0, 1.0, 1.0],
