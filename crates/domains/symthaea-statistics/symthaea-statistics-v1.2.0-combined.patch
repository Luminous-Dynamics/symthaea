+            expectile: 0.2,
+            ..Default::default()
+        },
+    )
+    .unwrap();
+    let high = try_expectile_regression(
+        &[],
+        &values,
+        ExpectileRegressionOptions {
+            expectile: 0.8,
+            ..Default::default()
+        },
+    )
+    .unwrap();
+    close(low.coefficients[0], 0.866_666_666_666_666_5, 2.0e-12);
+    close(high.coefficients[0], 4.777_777_777_777_778, 2.0e-12);
+
+    let gamma_predictors = (0..12)
+        .map(|index| vec![index as f64 / 4.0])
+        .collect::<Vec<_>>();
+    let gamma_outcomes = gamma_predictors
+        .iter()
+        .enumerate()
+        .map(|(index, row)| {
+            (1.0 + 0.03 * (index as f64 - 5.5)) * (1.2 + 0.45 * row[0]).exp()
+        })
+        .collect::<Vec<_>>();
+    let gamma = try_gamma_regression(
+        &gamma_predictors,
+        &gamma_outcomes,
