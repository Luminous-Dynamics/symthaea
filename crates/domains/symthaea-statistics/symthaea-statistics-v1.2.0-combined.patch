@@ -0,0 +1,474 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Gaussian random-intercept mixed-effects regression.
+//!
+//! Variance components are estimated by bounded profile maximum likelihood.
+//! The covariance structure is explicit compound symmetry within each group.
+
+use std::collections::BTreeMap;
+
+use crate::distributions::{normal_sf, try_normal_quantile};
+use crate::error::{StatsResult, StatisticsError};
+use crate::inference::Interval;
+use crate::linalg::{CholeskyFactor, DenseMatrix};
+use crate::model_matrix::{try_design_matrix, try_feature_vector};
+
+/// Controls for random-intercept mixed-effects fitting.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct RandomInterceptOptions {
+    pub include_intercept: bool,
+    pub confidence: f64,
+    /// Largest profiled ratio `random_intercept_variance / residual_variance`.
+    pub maximum_variance_ratio: f64,
+    /// Number of logarithmically spaced profile points before local refinement.
+    pub profile_points: usize,
+    pub tolerance: f64,
+}
+
+impl Default for RandomInterceptOptions {
+    fn default() -> Self {
+        Self {
+            include_intercept: true,
+            confidence: 0.95,
+            maximum_variance_ratio: 1.0e6,
+            profile_points: 121,
+            tolerance: 1.0e-9,
+        }
+    }
+}
+
+/// Estimated random intercept for one observed group.
+#[derive(Debug, Clone, PartialEq)]
+pub struct GroupRandomIntercept {
+    pub group: usize,
+    pub observations: usize,
+    pub estimate: f64,
+    pub posterior_variance: f64,
+}
+
+/// Fitted Gaussian random-intercept model.
+#[derive(Debug, Clone, PartialEq)]
+pub struct RandomInterceptFit {
+    pub coefficients: Vec<f64>,
+    pub standard_errors: Vec<f64>,
+    pub z_statistics: Vec<f64>,
+    pub p_values_two_sided: Vec<f64>,
+    pub confidence_intervals: Vec<Interval>,
+    pub residual_variance: f64,
+    pub random_intercept_variance: f64,
+    pub intraclass_correlation: f64,
+    pub variance_ratio: f64,
+    pub random_intercepts: Vec<GroupRandomIntercept>,
+    pub log_likelihood: f64,
+    pub aic: f64,
+    pub bic: f64,
+    pub n: usize,
+    pub group_count: usize,
+    pub predictor_count: usize,
+    pub include_intercept: bool,
+}
+
+impl RandomInterceptFit {
+    /// Fixed-effect prediction for a previously unseen group.
+    pub fn try_predict_population(&self, predictors: &[f64]) -> StatsResult<f64> {
+        let features = try_feature_vector(
+            predictors,
+            self.predictor_count,
+            self.include_intercept,
+        )?;
+        checked_dot(&features, &self.coefficients, "mixed-effects prediction")
+    }
+
+    /// Conditional prediction for an observed group.
+    pub fn try_predict_group(&self, predictors: &[f64], group: usize) -> StatsResult<f64> {
+        let fixed = self.try_predict_population(predictors)?;
+        let random = self
+            .random_intercepts
+            .iter()
+            .find(|effect| effect.group == group)
+            .map_or(0.0, |effect| effect.estimate);
+        let value = fixed + random;
+        if value.is_finite() {
+            Ok(value)
+        } else {
+            Err(StatisticsError::NumericalOverflow {
+                operation: "mixed-effects conditional prediction",
+            })
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+struct ProfileFit {
+    coefficients: Vec<f64>,
+    covariance_basis: DenseMatrix,
+    residual_variance: f64,
+    log_likelihood: f64,
+    variance_ratio: f64,
+}
+
+fn checked_dot(left: &[f64], right: &[f64], operation: &'static str) -> StatsResult<f64> {
+    let value = left
+        .iter()
+        .zip(right)
+        .fold(0.0, |sum, (&a, &b)| a.mul_add(b, sum));
+    if value.is_finite() {
+        Ok(value)
+    } else {
+        Err(StatisticsError::NumericalOverflow { operation })
+    }
+}
+
+fn validate_options(options: RandomInterceptOptions) -> StatsResult<()> {
+    if !options.confidence.is_finite() || !(0.0..1.0).contains(&options.confidence) {
+        return Err(StatisticsError::InvalidProbability {
+            value: options.confidence,
+        });
+    }
+    if !options.maximum_variance_ratio.is_finite() || options.maximum_variance_ratio <= 0.0 {
+        return Err(StatisticsError::InvalidScale {
+            value: options.maximum_variance_ratio,
+        });
+    }
+    if options.profile_points < 5 {
+        return Err(StatisticsError::InsufficientSamples {
+            required: 5,
+            actual: options.profile_points,
+        });
+    }
+    if !options.tolerance.is_finite() || options.tolerance <= 0.0 {
+        return Err(StatisticsError::NonPositiveValue {
+            name: "mixed-effects profile tolerance",
+            value: options.tolerance,
+        });
+    }
+    Ok(())
+}
+
+fn group_rows(groups: &[usize]) -> Vec<(usize, Vec<usize>)> {
+    let mut map = BTreeMap::<usize, Vec<usize>>::new();
+    for (row, &group) in groups.iter().enumerate() {
+        map.entry(group).or_default().push(row);
+    }
+    map.into_iter().collect()
+}
+
+fn try_profile_fit(
+    design: &DenseMatrix,
+    outcomes: &[f64],
+    grouped_rows: &[(usize, Vec<usize>)],
+    variance_ratio: f64,
+) -> StatsResult<ProfileFit> {
+    if !variance_ratio.is_finite() || variance_ratio < 0.0 {
+        return Err(StatisticsError::NegativeValue {
+            name: "mixed-effects variance ratio",
+            value: variance_ratio,
+        });
+    }
+    let parameters = design.columns();
+    let mut information = DenseMatrix::zeros(parameters, parameters)?;
+    let mut rhs = vec![0.0; parameters];
+    let mut log_determinant = 0.0;
+
+    for (_, rows) in grouped_rows {
+        let group_size = rows.len() as f64;
+        let shrink = variance_ratio / (1.0 + group_size * variance_ratio);
+        let mut sums = vec![0.0; parameters];
+        let mut outcome_sum = 0.0;
+        for &row in rows {
+            outcome_sum += outcomes[row];
+            for (column, sum) in sums.iter_mut().enumerate() {
+                *sum += design.get(row, column);
+            }
+        }
+        for left in 0..parameters {
+            let mut xy = 0.0;
+            for &row in rows {
+                xy = design.get(row, left).mul_add(outcomes[row], xy);
+            }
+            rhs[left] += xy - shrink * sums[left] * outcome_sum;
+            for right in 0..=left {
+                let mut xx = 0.0;
+                for &row in rows {
+                    xx = design.get(row, left).mul_add(design.get(row, right), xx);
+                }
+                let value = information.get(left, right)
+                    + xx
+                    - shrink * sums[left] * sums[right];
+                if !value.is_finite() {
+                    return Err(StatisticsError::NumericalOverflow {
+                        operation: "mixed-effects profile information",
+                    });
+                }
+                information.set(left, right, value);
+                information.set(right, left, value);
+            }
+        }
+        log_determinant += (1.0 + group_size * variance_ratio).ln();
+    }
+    let factor = CholeskyFactor::try_factor(&information)?;
+    if factor.diagonal_ratio() > 1.0e10 {
+        return Err(StatisticsError::SingularMatrix {
+            reason: "mixed-effects design is too ill-conditioned",
+        });
+    }
+    let coefficients = factor.try_solve(&rhs)?;
+    let fitted = design.try_mul_vector(&coefficients)?;
+    let residuals = outcomes
+        .iter()
+        .zip(&fitted)
+        .map(|(&observed, &estimate)| observed - estimate)
+        .collect::<Vec<_>>();
+    let mut quadratic = 0.0;
+    for (_, rows) in grouped_rows {
+        let group_size = rows.len() as f64;
+        let shrink = variance_ratio / (1.0 + group_size * variance_ratio);
+        let mut sum = 0.0;
+        let mut sum_squares = 0.0;
+        for &row in rows {
+            sum += residuals[row];
+            sum_squares += residuals[row] * residuals[row];
+        }
+        quadratic += sum_squares - shrink * sum * sum;
+    }
+    if !quadratic.is_finite() || quadratic <= f64::MIN_POSITIVE {
+        return Err(StatisticsError::DegenerateSample {
+            reason: "mixed-effects model requires residual variation",
+        });
+    }
+    let n = outcomes.len() as f64;
+    let residual_variance = quadratic / n;
+    let log_likelihood = -0.5
+        * (n * ((2.0 * std::f64::consts::PI).ln() + 1.0 + residual_variance.ln())
+            + log_determinant);
+    if !log_likelihood.is_finite() {
+        return Err(StatisticsError::NumericalOverflow {
+            operation: "mixed-effects profile likelihood",
+        });
+    }
+    Ok(ProfileFit {
+        coefficients,
+        covariance_basis: factor.try_inverse()?,
+        residual_variance,
+        log_likelihood,
+        variance_ratio,
+    })
+}
+
+/// Fit a Gaussian random-intercept model by profile maximum likelihood.
+pub fn try_random_intercept_model(
+    predictors: &[Vec<f64>],
+    outcomes: &[f64],
+    groups: &[usize],
+    options: RandomInterceptOptions,
+) -> StatsResult<RandomInterceptFit> {
+    validate_options(options)?;
+    if outcomes.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    if groups.len() != outcomes.len() {
+        return Err(StatisticsError::LengthMismatch {
+            left: groups.len(),
+            right: outcomes.len(),
+        });
+    }
+    for (index, &value) in outcomes.iter().enumerate() {
+        if !value.is_finite() {
+            return Err(StatisticsError::NonFiniteInput { index, value });
+        }
+    }
+    let grouped_rows = group_rows(groups);
+    if grouped_rows.len() < 2 {
+        return Err(StatisticsError::InsufficientSamples {
+            required: 2,
+            actual: grouped_rows.len(),
+        });
+    }
+    if !grouped_rows.iter().any(|(_, rows)| rows.len() > 1) {
+        return Err(StatisticsError::DegenerateSample {
+            reason: "random-intercept variance requires at least one repeated group",
+        });
+    }
+    let design = try_design_matrix(predictors, outcomes.len(), options.include_intercept)?;
+    if outcomes.len() <= design.columns() + 1 {
+        return Err(StatisticsError::InsufficientSamples {
+            required: design.columns() + 2,
+            actual: outcomes.len(),
+        });
+    }
+
+    let mut best = try_profile_fit(&design, outcomes, &grouped_rows, 0.0)?;
+    let minimum_ratio = (options.maximum_variance_ratio * 1.0e-12).max(1.0e-12);
+    let lower_log = minimum_ratio.ln();
+    let upper_log = options.maximum_variance_ratio.ln();
+    let step = (upper_log - lower_log) / (options.profile_points - 1) as f64;
+    let mut values = Vec::with_capacity(options.profile_points);
+    for index in 0..options.profile_points {
+        let log_ratio = lower_log + index as f64 * step;
+        let candidate = try_profile_fit(&design, outcomes, &grouped_rows, log_ratio.exp())?;
+        if candidate.log_likelihood > best.log_likelihood {
+            best = candidate.clone();
+        }
+        values.push(candidate);
+    }
+
+    let best_grid_index = values
+        .iter()
+        .enumerate()
+        .max_by(|(_, left), (_, right)| left.log_likelihood.total_cmp(&right.log_likelihood))
+        .map(|(index, _)| index)
+        .unwrap_or(0);
+    if best_grid_index > 0 && best_grid_index + 1 < values.len() {
+        let mut left = lower_log + (best_grid_index - 1) as f64 * step;
+        let mut right = lower_log + (best_grid_index + 1) as f64 * step;
+        let golden = (5.0_f64.sqrt() - 1.0) / 2.0;
+        let mut first = right - golden * (right - left);
+        let mut second = left + golden * (right - left);
+        let mut first_fit = try_profile_fit(&design, outcomes, &grouped_rows, first.exp())?;
+        let mut second_fit = try_profile_fit(&design, outcomes, &grouped_rows, second.exp())?;
+        for _ in 0..96 {
+            if (right - left).abs() <= options.tolerance * (1.0 + right.abs()) {
+                break;
+            }
+            if first_fit.log_likelihood < second_fit.log_likelihood {
+                left = first;
+                first = second;
+                first_fit = second_fit;
+                second = left + golden * (right - left);
+                second_fit = try_profile_fit(&design, outcomes, &grouped_rows, second.exp())?;
+            } else {
+                right = second;
+                second = first;
+                second_fit = first_fit;
+                first = right - golden * (right - left);
+                first_fit = try_profile_fit(&design, outcomes, &grouped_rows, first.exp())?;
+            }
+        }
+        for candidate in [first_fit, second_fit] {
+            if candidate.log_likelihood > best.log_likelihood {
+                best = candidate;
+            }
+        }
+    }
+
+    let random_intercept_variance = best.variance_ratio * best.residual_variance;
+    let total_variance = random_intercept_variance + best.residual_variance;
+    let intraclass_correlation = if total_variance == 0.0 {
+        0.0
+    } else {
+        random_intercept_variance / total_variance
+    };
+    let fitted = design.try_mul_vector(&best.coefficients)?;
+    let residuals = outcomes
+        .iter()
+        .zip(&fitted)
+        .map(|(&observed, &estimate)| observed - estimate)
+        .collect::<Vec<_>>();
+    let random_intercepts = grouped_rows
+        .iter()
+        .map(|(group, rows)| {
+            let size = rows.len() as f64;
+            let sum = rows.iter().map(|&row| residuals[row]).sum::<f64>();
+            let denominator = 1.0 + size * best.variance_ratio;
+            GroupRandomIntercept {
+                group: *group,
+                observations: rows.len(),
+                estimate: best.variance_ratio / denominator * sum,
+                posterior_variance: random_intercept_variance / denominator,
+            }
+        })
+        .collect::<Vec<_>>();
+
+    let critical = try_normal_quantile(0.5 + options.confidence / 2.0)?;
+    let mut standard_errors = Vec::with_capacity(best.coefficients.len());
+    let mut z_statistics = Vec::with_capacity(best.coefficients.len());
+    let mut p_values_two_sided = Vec::with_capacity(best.coefficients.len());
+    let mut confidence_intervals = Vec::with_capacity(best.coefficients.len());
+    for (index, &coefficient) in best.coefficients.iter().enumerate() {
+        let standard_error = (best.residual_variance * best.covariance_basis.get(index, index))
+            .max(0.0)
+            .sqrt();
+        let z = if standard_error == 0.0 {
+            if coefficient == 0.0 { 0.0 } else { coefficient.signum() * f64::INFINITY }
+        } else {
+            coefficient / standard_error
+        };
+        standard_errors.push(standard_error);
+        z_statistics.push(z);
+        p_values_two_sided.push((2.0 * normal_sf(z.abs())).clamp(0.0, 1.0));
+        confidence_intervals.push(Interval {
+            low: coefficient - critical * standard_error,
+            high: coefficient + critical * standard_error,
+        });
+    }
+    let parameter_count = best.coefficients.len() + 2;
+    let n = outcomes.len() as f64;
+    Ok(RandomInterceptFit {
+        coefficients: best.coefficients,
+        standard_errors,
+        z_statistics,
+        p_values_two_sided,
+        confidence_intervals,
+        residual_variance: best.residual_variance,
+        random_intercept_variance,
+        intraclass_correlation,
+        variance_ratio: best.variance_ratio,
+        random_intercepts,
+        log_likelihood: best.log_likelihood,
+        aic: 2.0 * parameter_count as f64 - 2.0 * best.log_likelihood,
+        bic: parameter_count as f64 * n.ln() - 2.0 * best.log_likelihood,
+        n: outcomes.len(),
+        group_count: grouped_rows.len(),
+        predictor_count: design.columns() - usize::from(options.include_intercept),
+        include_intercept: options.include_intercept,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn recovers_fixed_slope_and_group_variation() {
+        let mut predictors = Vec::new();
+        let mut outcomes = Vec::new();
+        let mut groups = Vec::new();
+        let offsets = [-1.5, -0.5, 0.75, 1.5];
+        for (group, &offset) in offsets.iter().enumerate() {
+            for time in 0..6 {
+                let x = time as f64;
+                predictors.push(vec![x]);
+                let noise = [0.04, -0.03, 0.01, -0.02, 0.03, -0.01][time]
+                    * if group % 2 == 0 { 1.0 } else { -1.0 };
+                outcomes.push(2.0 + 0.8 * x + offset + noise);
+                groups.push(group);
+            }
+        }
+        let fit = try_random_intercept_model(
+            &predictors,
+            &outcomes,
+            &groups,
+            RandomInterceptOptions::default(),
+        )
+        .unwrap();
+        assert!((fit.coefficients[1] - 0.8).abs() < 0.05);
+        assert!(fit.random_intercept_variance > fit.residual_variance);
+        assert!(fit.intraclass_correlation > 0.5);
+        assert!(fit.try_predict_group(&[2.0], 3).unwrap() > fit.try_predict_group(&[2.0], 0).unwrap());
+    }
+
+    #[test]
+    fn rejects_unreplicated_groups() {
+        let predictors = vec![vec![0.0], vec![1.0], vec![2.0]];
+        assert!(matches!(
+            try_random_intercept_model(
+                &predictors,
+                &[1.0, 2.0, 3.0],
+                &[0, 1, 2],
+                Default::default()
+            ),
+            Err(StatisticsError::DegenerateSample { .. })
+        ));
+    }
+}
