new file mode 100644
index 0000000..e933de1
--- /dev/null
+++ b/src/expectile_regression.rs
@@ -0,0 +1,228 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Linear expectile regression through asymmetric least squares.
+
+use crate::error::{StatsResult, StatisticsError};
+use crate::linalg::try_solve_spd;
+use crate::model_matrix::{try_design_matrix, try_feature_vector};
+use crate::qr::QrDecomposition;
+
+/// Configuration for linear expectile regression.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct ExpectileRegressionOptions {
+    /// Expectile level in `(0, 1)`.
+    pub expectile: f64,
+    pub include_intercept: bool,
+    pub max_iterations: usize,
+    pub tolerance: f64,
+    /// Non-negative diagonal stabilization added to non-intercept coefficients.
+    pub ridge: f64,
+}
+
+impl Default for ExpectileRegressionOptions {
+    fn default() -> Self {
+        Self {
+            expectile: 0.5,
+            include_intercept: true,
+            max_iterations: 200,
+            tolerance: 1.0e-10,
+            ridge: 0.0,
+        }
+    }
+}
+
+/// Fitted asymmetric least-squares model.
+#[derive(Debug, Clone, PartialEq)]
+pub struct ExpectileRegressionFit {
+    pub coefficients: Vec<f64>,
+    pub expectile: f64,
+    pub n: usize,
+    pub predictor_count: usize,
+    pub include_intercept: bool,
+    pub asymmetric_loss: f64,
+    pub iterations: usize,
+}
+
+impl ExpectileRegressionFit {
+    pub fn try_predict(&self, predictors: &[f64]) -> StatsResult<f64> {
+        let features = try_feature_vector(
+            predictors,
+            self.predictor_count,
+            self.include_intercept,
+        )?;
+        let mut value = 0.0;
+        for (&feature, &coefficient) in features.iter().zip(&self.coefficients) {
+            value = feature.mul_add(coefficient, value);
+        }
+        if value.is_finite() {
+            Ok(value)
+        } else {
+            Err(StatisticsError::NumericalOverflow {
+                operation: "expectile regression prediction",
+            })
+        }
+    }
+}
+
+fn validate_options(options: ExpectileRegressionOptions) -> StatsResult<()> {
+    if !options.expectile.is_finite() || !(0.0..1.0).contains(&options.expectile) {
+        return Err(StatisticsError::InvalidProbability {
+            value: options.expectile,
+        });
+    }
+    if options.max_iterations == 0 {
+        return Err(StatisticsError::InvalidIterations { iterations: 0 });
+    }
+    if !options.tolerance.is_finite() || options.tolerance <= 0.0 {
+        return Err(StatisticsError::NonPositiveValue {
+            name: "expectile regression tolerance",
+            value: options.tolerance,
+        });
+    }
+    if !options.ridge.is_finite() || options.ridge < 0.0 {
+        return Err(StatisticsError::NegativeValue {
+            name: "expectile regression ridge",
+            value: options.ridge,
+        });
+    }
+    Ok(())
+}
+
+/// Fit a linear expectile model.
+pub fn try_expectile_regression(
+    predictors: &[Vec<f64>],
+    outcomes: &[f64],
+    options: ExpectileRegressionOptions,
+) -> StatsResult<ExpectileRegressionFit> {
+    validate_options(options)?;
+    if outcomes.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    for (index, &value) in outcomes.iter().enumerate() {
+        if !value.is_finite() {
+            return Err(StatisticsError::NonFiniteInput { index, value });
+        }
+    }
+    let design = try_design_matrix(predictors, outcomes.len(), options.include_intercept)?;
+    if outcomes.len() < design.columns() {
+        return Err(StatisticsError::InsufficientSamples {
+            required: design.columns(),
+            actual: outcomes.len(),
+        });
+    }
+    let factor = QrDecomposition::try_factor(&design)?;
+    let mut coefficients = factor.try_solve_least_squares(outcomes)?;
+
+    for iteration in 1..=options.max_iterations {
+        let fitted = design.try_mul_vector(&coefficients)?;
+        let weights = outcomes
+            .iter()
+            .zip(&fitted)
+            .map(|(&observed, &estimate)| {
+                if observed >= estimate {
+                    options.expectile
+                } else {
+                    1.0 - options.expectile
+                }
+            })
+            .collect::<Vec<_>>();
+        let mut gram = design.try_weighted_gram(&weights)?;
+        for index in 0..gram.rows() {
+            if !(options.include_intercept && index == 0) {
+                let updated = gram.try_get(index, index)? + options.ridge;
+                if !updated.is_finite() {
+                    return Err(StatisticsError::NumericalOverflow {
+                        operation: "expectile ridge stabilization",
+                    });
+                }
+                // The indices are known valid from the loop bounds.
+                gram.set(index, index, updated);
+            }
+        }
+        let rhs = design.try_weighted_transpose_mul_vector(&weights, outcomes)?;
+        let updated = try_solve_spd(&gram, &rhs)?;
+        let maximum_change = updated
+            .iter()
+            .zip(&coefficients)
+            .map(|(&next, &previous)| (next - previous).abs())
+            .fold(0.0_f64, f64::max);
+        coefficients = updated;
+        if maximum_change <= options.tolerance {
+            let fitted = design.try_mul_vector(&coefficients)?;
+            let asymmetric_loss = outcomes
+                .iter()
+                .zip(&fitted)
+                .map(|(&observed, &estimate)| {
+                    let residual = observed - estimate;
+                    let weight = if residual >= 0.0 {
+                        options.expectile
+                    } else {
+                        1.0 - options.expectile
+                    };
+                    weight * residual * residual
+                })
+                .sum::<f64>();
+            if !asymmetric_loss.is_finite() {
+                return Err(StatisticsError::NumericalOverflow {
+                    operation: "expectile regression loss",
+                });
+            }
+            return Ok(ExpectileRegressionFit {
+                coefficients,
+                expectile: options.expectile,
+                n: outcomes.len(),
+                predictor_count: design.columns() - usize::from(options.include_intercept),
+                include_intercept: options.include_intercept,
+                asymmetric_loss,
+                iterations: iteration,
+            });
+        }
+    }
+    Err(StatisticsError::NonConvergence {
+        function: "expectile regression IRLS",
+        iterations: options.max_iterations,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn half_expectile_matches_ordinary_least_squares_line() {
+        let x = (0..8).map(|value| vec![value as f64]).collect::<Vec<_>>();
+        let y = x
+            .iter()
+            .map(|row| 1.5 + 2.25 * row[0])
+            .collect::<Vec<_>>();
+        let fit = try_expectile_regression(&x, &y, Default::default()).unwrap();
+        assert!((fit.coefficients[0] - 1.5).abs() < 1.0e-10);
+        assert!((fit.coefficients[1] - 2.25).abs() < 1.0e-10);
+    }
+
+    #[test]
+    fn upper_expectile_moves_toward_large_observations() {
+        let x: Vec<Vec<f64>> = Vec::new();
+        let y = [0.0, 0.0, 0.0, 1.0, 2.0, 10.0];
+        let low = try_expectile_regression(
+            &x,
+            &y,
+            ExpectileRegressionOptions {
+                expectile: 0.2,
+                ..Default::default()
+            },
+        )
+        .unwrap();
+        let high = try_expectile_regression(
+            &x,
+            &y,
+            ExpectileRegressionOptions {
+                expectile: 0.8,
+                ..Default::default()
+            },
+        )
+        .unwrap();
+        assert!(high.coefficients[0] > low.coefficients[0]);
+    }
+}
diff --git a/src/gamma_regression.rs b/src/gamma_regression.rs
new file mode 100644
index 0000000..c5cdff7
--- /dev/null
+++ b/src/gamma_regression.rs
@@ -0,0 +1,311 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Gamma generalized linear regression with a log link.
+
+use crate::descriptive::try_mean;
+use crate::distributions::{normal_sf, try_normal_quantile};
+use crate::error::{StatsResult, StatisticsError};
+use crate::inference::Interval;
+use crate::linalg::CholeskyFactor;
+use crate::model_matrix::{try_design_matrix, try_feature_vector};
+use crate::special::ln_gamma;
+
+/// Controls for gamma-regression fitting.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct GammaRegressionOptions {
+    pub include_intercept: bool,
+    pub ridge: f64,
+    pub penalize_intercept: bool,
+    pub maximum_iterations: usize,
+    pub tolerance: f64,
+    pub confidence: f64,
+}
+
+impl Default for GammaRegressionOptions {
+    fn default() -> Self {
+        Self {
+            include_intercept: true,
+            ridge: 0.0,
+            penalize_intercept: false,
+            maximum_iterations: 200,
+            tolerance: 1.0e-9,
+            confidence: 0.95,
+        }
+    }
+}
+
+/// Fitted gamma log-link model.
+#[derive(Debug, Clone, PartialEq)]
+pub struct GammaRegressionFit {
+    pub coefficients: Vec<f64>,
+    pub standard_errors: Vec<f64>,
+    pub z_statistics: Vec<f64>,
+    pub p_values_two_sided: Vec<f64>,
+    pub confidence_intervals: Vec<Interval>,
+    pub dispersion: f64,
+    pub shape: f64,
+    pub n: usize,
+    pub predictor_count: usize,
+    pub include_intercept: bool,
+    pub iterations: usize,
+    pub deviance: f64,
+    pub null_deviance: f64,
+    pub log_likelihood: f64,
+    pub aic: f64,
+    pub bic: f64,
+}
+
+impl GammaRegressionFit {
+    pub fn try_log_mean(&self, predictors: &[f64]) -> StatsResult<f64> {
+        let features = try_feature_vector(
+            predictors,
+            self.predictor_count,
+            self.include_intercept,
+        )?;
+        let value = features
+            .iter()
+            .zip(&self.coefficients)
+            .fold(0.0, |sum, (&feature, &coefficient)| {
+                feature.mul_add(coefficient, sum)
+            });
+        if value.is_finite() {
+            Ok(value)
+        } else {
+            Err(StatisticsError::NumericalOverflow {
+                operation: "gamma regression linear predictor",
+            })
+        }
+    }
+
+    pub fn try_mean(&self, predictors: &[f64]) -> StatsResult<f64> {
+        let value = self.try_log_mean(predictors)?.exp();
+        if value.is_finite() {
+            Ok(value)
+        } else {
+            Err(StatisticsError::NumericalOverflow {
+                operation: "gamma regression predicted mean",
+            })
+        }
+    }
+}
+
+fn validate_options(options: GammaRegressionOptions) -> StatsResult<()> {
+    if !options.ridge.is_finite() || options.ridge < 0.0 {
+        return Err(StatisticsError::NegativeValue {
+            name: "gamma ridge penalty",
+            value: options.ridge,
+        });
+    }
+    if options.maximum_iterations == 0 {
+        return Err(StatisticsError::InvalidIterations { iterations: 0 });
+    }
+    if !options.tolerance.is_finite() || options.tolerance <= 0.0 {
+        return Err(StatisticsError::NonPositiveValue {
+            name: "gamma convergence tolerance",
+            value: options.tolerance,
+        });
+    }
+    if !options.confidence.is_finite() || !(0.0..1.0).contains(&options.confidence) {
+        return Err(StatisticsError::InvalidProbability {
+            value: options.confidence,
+        });
+    }
+    Ok(())
+}
+
+fn gamma_deviance(outcomes: &[f64], means: &[f64]) -> f64 {
+    2.0 * outcomes
+        .iter()
+        .zip(means)
+        .map(|(&outcome, &mean)| (outcome - mean) / mean - (outcome / mean).ln())
+        .sum::<f64>()
+}
+
+fn gamma_log_likelihood(outcomes: &[f64], means: &[f64], shape: f64) -> f64 {
+    outcomes
+        .iter()
+        .zip(means)
+        .map(|(&outcome, &mean)| {
+            let rate = shape / mean;
+            shape * rate.ln() - ln_gamma(shape) + (shape - 1.0) * outcome.ln()
+                - rate * outcome
+        })
+        .sum()
+}
+
+/// Fit a gamma GLM with log-linked conditional means.
+pub fn try_gamma_regression(
+    predictors: &[Vec<f64>],
+    outcomes: &[f64],
+    options: GammaRegressionOptions,
+) -> StatsResult<GammaRegressionFit> {
+    validate_options(options)?;
+    if outcomes.is_empty() {
+        return Err(StatisticsError::EmptySample);
+    }
+    for (index, &value) in outcomes.iter().enumerate() {
+        if !value.is_finite() {
+            return Err(StatisticsError::NonFiniteInput { index, value });
+        }
+        if value <= 0.0 {
+            return Err(StatisticsError::NonPositiveValue {
+                name: "gamma outcome",
+                value,
+            });
+        }
+    }
+    let design = try_design_matrix(predictors, outcomes.len(), options.include_intercept)?;
+    let parameter_count = design.columns();
+    if outcomes.len() <= parameter_count {
+        return Err(StatisticsError::InsufficientSamples {
+            required: parameter_count + 1,
+            actual: outcomes.len(),
+        });
+    }
+    let mean = try_mean(outcomes)?;
+    let mut coefficients = vec![0.0; parameter_count];
+    if options.include_intercept {
+        coefficients[0] = mean.ln();
+    }
+    let unit_weights = vec![1.0; outcomes.len()];
+    let mut information = design.try_weighted_gram(&unit_weights)?;
+    for index in 0..parameter_count {
+        let is_intercept = options.include_intercept && index == 0;
+        if options.ridge > 0.0 && (options.penalize_intercept || !is_intercept) {
+            information.set(index, index, information.get(index, index) + options.ridge);
+        }
+    }
+    let factor = CholeskyFactor::try_factor(&information)?;
+    let mut iterations = 0;
+    for iteration in 1..=options.maximum_iterations {
+        iterations = iteration;
+        let eta = design.try_mul_vector(&coefficients)?;
+        let means = eta
+            .iter()
+            .map(|&value| value.clamp(-40.0, 40.0).exp())
+            .collect::<Vec<_>>();
+        let working = eta
+            .iter()
+            .zip(outcomes)
+            .zip(&means)
+            .map(|((&linear, &outcome), &current_mean)| {
+                linear + (outcome - current_mean) / current_mean
+            })
+            .collect::<Vec<_>>();
+        let rhs = design.try_weighted_transpose_mul_vector(&unit_weights, &working)?;
+        let next = factor.try_solve(&rhs)?;
+        let maximum_change = next
+            .iter()
+            .zip(&coefficients)
+            .map(|(&new, &old)| (new - old).abs())
+            .fold(0.0_f64, f64::max);
+        let scale = next.iter().map(|value| value.abs()).fold(0.0_f64, f64::max);
+        coefficients = next;
+        if maximum_change <= options.tolerance * (1.0 + scale) {
+            break;
+        }
+        if iteration == options.maximum_iterations {
+            return Err(StatisticsError::NonConvergence {
+                function: "gamma regression IRLS",
+                iterations,
+            });
+        }
+    }
+
+    let eta = design.try_mul_vector(&coefficients)?;
+    let means = eta
+        .iter()
+        .map(|&value| value.clamp(-40.0, 40.0).exp())
+        .collect::<Vec<_>>();
+    let deviance = gamma_deviance(outcomes, &means);
+    let null_means = vec![mean; outcomes.len()];
+    let null_deviance = gamma_deviance(outcomes, &null_means);
+    let residual_df = outcomes.len() - parameter_count;
+    let dispersion = (deviance / residual_df as f64).max(f64::MIN_POSITIVE);
+    let shape = 1.0 / dispersion;
+    if !shape.is_finite() {
+        return Err(StatisticsError::NumericalOverflow {
+            operation: "gamma regression shape",
+        });
+    }
+    let covariance_basis = factor.try_inverse()?;
+    let critical = try_normal_quantile(0.5 + options.confidence / 2.0)?;
+    let mut standard_errors = Vec::with_capacity(parameter_count);
+    let mut z_statistics = Vec::with_capacity(parameter_count);
+    let mut p_values_two_sided = Vec::with_capacity(parameter_count);
+    let mut confidence_intervals = Vec::with_capacity(parameter_count);
+    for (index, &coefficient) in coefficients.iter().enumerate() {
+        let standard_error = (dispersion * covariance_basis.get(index, index))
+            .max(0.0)
+            .sqrt();
+        let z = if standard_error == 0.0 {
+            if coefficient == 0.0 { 0.0 } else { coefficient.signum() * f64::INFINITY }
+        } else {
+            coefficient / standard_error
+        };
+        standard_errors.push(standard_error);
+        z_statistics.push(z);
+        p_values_two_sided.push((2.0 * normal_sf(z.abs())).clamp(0.0, 1.0));
+        let half_width = critical * standard_error;
+        confidence_intervals.push(Interval {
+            low: coefficient - half_width,
+            high: coefficient + half_width,
+        });
+    }
+    let log_likelihood = gamma_log_likelihood(outcomes, &means, shape);
+    if !log_likelihood.is_finite() || !deviance.is_finite() {
+        return Err(StatisticsError::NumericalOverflow {
+            operation: "gamma regression likelihood",
+        });
+    }
+    let estimated_parameters = (parameter_count + 1) as f64;
+    let n = outcomes.len() as f64;
+    Ok(GammaRegressionFit {
+        coefficients,
+        standard_errors,
+        z_statistics,
+        p_values_two_sided,
+        confidence_intervals,
+        dispersion,
+        shape,
+        n: outcomes.len(),
+        predictor_count: parameter_count - usize::from(options.include_intercept),
+        include_intercept: options.include_intercept,
+        iterations,
+        deviance,
+        null_deviance,
+        log_likelihood,
+        aic: 2.0 * estimated_parameters - 2.0 * log_likelihood,
+        bic: estimated_parameters * n.ln() - 2.0 * log_likelihood,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn gamma_fit_recovers_multiplicative_trend() {
+        let predictors = (0..12)
+            .map(|index| vec![index as f64 / 4.0])
+            .collect::<Vec<_>>();
+        let outcomes = predictors
+            .iter()
+            .enumerate()
+            .map(|(index, row)| (1.0 + 0.03 * (index as f64 - 5.5)) * (1.2 + 0.45 * row[0]).exp())
+            .collect::<Vec<_>>();
+        let fit = try_gamma_regression(&predictors, &outcomes, Default::default()).unwrap();
+        assert!(fit.coefficients[1] > 0.50 && fit.coefficients[1] < 0.65);
+        assert!(fit.try_mean(&[2.0]).unwrap() > fit.try_mean(&[0.5]).unwrap());
+        assert!(fit.deviance < fit.null_deviance);
+    }
+
+    #[test]
+    fn rejects_zero_outcomes() {
+        assert!(matches!(
+            try_gamma_regression(&[], &[1.0, 0.0], Default::default()),
+            Err(StatisticsError::NonPositiveValue { .. })
+        ));
+    }
+}
