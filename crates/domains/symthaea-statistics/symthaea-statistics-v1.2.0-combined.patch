@@ -0,0 +1,378 @@
+// Copyright (C) 2024-2026 Tristan Stoltz / Luminous Dynamics
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Validated weighted graph summaries and connectivity diagnostics.
+
+use std::collections::VecDeque;
+
+use crate::error::{StatsResult, StatisticsError};
+
+/// Dense non-negative weighted graph.
+#[derive(Debug, Clone, PartialEq)]
+pub struct WeightedGraph {
+    nodes: usize,
+    directed: bool,
+    adjacency: Vec<f64>,
+}
+
+/// Structural summary of a validated graph.
+#[derive(Debug, Clone, PartialEq)]
+pub struct NetworkSummary {
+    pub nodes: usize,
+    pub edges: usize,
+    pub directed: bool,
+    pub density: f64,
+    pub isolates: usize,
+    pub weak_components: usize,
+    pub largest_component: usize,
+    pub mean_out_degree: f64,
+    pub mean_out_strength: f64,
+    pub global_transitivity: f64,
+    pub average_local_clustering: f64,
+}
+
+impl WeightedGraph {
+    /// Construct a graph from a square adjacency matrix.
+    ///
+    /// Weights must be finite and non-negative. Self loops are rejected. For an
+    /// undirected graph, opposite entries must agree within `symmetry_tolerance`.
+    pub fn try_from_adjacency(
+        adjacency: &[Vec<f64>],
+        directed: bool,
+        symmetry_tolerance: f64,
+    ) -> StatsResult<Self> {
+        if adjacency.is_empty() {
+            return Err(StatisticsError::EmptySample);
+        }
+        if !symmetry_tolerance.is_finite() || symmetry_tolerance < 0.0 {
+            return Err(StatisticsError::NegativeValue {
+                name: "network symmetry tolerance",
+                value: symmetry_tolerance,
+            });
+        }
+        let nodes = adjacency.len();
+        let capacity = nodes
+            .checked_mul(nodes)
+            .ok_or(StatisticsError::NumericalOverflow {
+                operation: "network adjacency size",
+            })?;
+        let mut data = Vec::with_capacity(capacity);
+        for (row, values) in adjacency.iter().enumerate() {
+            if values.len() != nodes {
+                return Err(StatisticsError::InvalidShape {
+                    rows: nodes,
+                    columns: values.len(),
+                });
+            }
+            let mut row_sum = 0.0_f64;
+            for (column, &value) in values.iter().enumerate() {
+                if !value.is_finite() {
+                    return Err(StatisticsError::NonFiniteInput {
+                        index: row * nodes + column,
+                        value,
+                    });
+                }
+                if value < 0.0 {
+                    return Err(StatisticsError::NegativeValue {
+                        name: "network edge weight",
+                        value,
+                    });
+                }
+                if row == column && value != 0.0 {
+                    return Err(StatisticsError::DegenerateSample {
+                        reason: "network self loops are not supported",
+                    });
+                }
+                row_sum += value;
+                if !row_sum.is_finite() {
+                    return Err(StatisticsError::NumericalOverflow {
+                        operation: "network row strength",
+                    });
+                }
+                data.push(value);
+            }
+        }
+        if !directed {
+            for row in 0..nodes {
+                for column in 0..row {
+                    let left = data[row * nodes + column];
+                    let right = data[column * nodes + row];
+                    let scale = left.abs().max(right.abs()).max(1.0);
+                    if (left - right).abs() > symmetry_tolerance * scale {
+                        return Err(StatisticsError::DegenerateSample {
+                            reason: "undirected adjacency matrix is not symmetric",
+                        });
+                    }
+                }
+            }
+        }
+        Ok(Self {
+            nodes,
+            directed,
+            adjacency: data,
+        })
+    }
+
+    pub fn node_count(&self) -> usize {
+        self.nodes
+    }
+
+    pub fn is_directed(&self) -> bool {
+        self.directed
+    }
+
+    pub fn try_weight(&self, from: usize, to: usize) -> StatsResult<f64> {
+        if from >= self.nodes || to >= self.nodes {
+            return Err(StatisticsError::DimensionMismatch {
+                context: "network node index",
+                expected: self.nodes,
+                actual: from.max(to).saturating_add(1),
+            });
+        }
+        Ok(self.weight(from, to))
+    }
+
+    pub(crate) fn weight(&self, from: usize, to: usize) -> f64 {
+        self.adjacency[from * self.nodes + to]
+    }
+
+    pub(crate) fn adjacent_weak(&self, left: usize, right: usize) -> bool {
+        self.weight(left, right) > 0.0 || self.weight(right, left) > 0.0
+    }
+
+    pub(crate) fn outgoing_neighbors_unchecked(&self, node: usize) -> Vec<usize> {
+        (0..self.nodes)
+            .filter(|&target| self.weight(node, target) > 0.0)
+            .collect()
+    }
+
+    pub fn try_outgoing_neighbors(&self, node: usize) -> StatsResult<Vec<usize>> {
+        if node >= self.nodes {
+            return Err(StatisticsError::DimensionMismatch {
+                context: "network node index",
+                expected: self.nodes,
+                actual: node.saturating_add(1),
+            });
+        }
+        Ok(self.outgoing_neighbors_unchecked(node))
+    }
+
+    pub fn edge_count(&self) -> usize {
+        if self.directed {
+            (0..self.nodes)
+                .flat_map(|row| (0..self.nodes).map(move |column| (row, column)))
+                .filter(|&(row, column)| row != column && self.weight(row, column) > 0.0)
+                .count()
+        } else {
+            (0..self.nodes)
+                .flat_map(|row| (row + 1..self.nodes).map(move |column| (row, column)))
+                .filter(|&(row, column)| self.weight(row, column) > 0.0)
+                .count()
+        }
+    }
+
+    pub fn density(&self) -> f64 {
+        if self.nodes < 2 {
+            return 0.0;
+        }
+        let possible = if self.directed {
+            self.nodes * (self.nodes - 1)
+        } else {
+            self.nodes * (self.nodes - 1) / 2
+        };
+        self.edge_count() as f64 / possible as f64
+    }
+
+    pub fn out_degrees(&self) -> Vec<usize> {
+        (0..self.nodes)
+            .map(|node| self.outgoing_neighbors_unchecked(node).len())
+            .collect()
+    }
+
+    pub fn out_strengths(&self) -> Vec<f64> {
+        (0..self.nodes)
+            .map(|node| {
+                (0..self.nodes)
+                    .map(|target| self.weight(node, target))
+                    .sum::<f64>()
+            })
+            .collect()
+    }
+
+    /// Weakly connected components. Directed edges are symmetrized for this diagnostic.
+    pub fn weak_components(&self) -> Vec<Vec<usize>> {
+        let mut visited = vec![false; self.nodes];
+        let mut components = Vec::new();
+        for start in 0..self.nodes {
+            if visited[start] {
+                continue;
+            }
+            let mut queue = VecDeque::from([start]);
+            visited[start] = true;
+            let mut component = Vec::new();
+            while let Some(node) = queue.pop_front() {
+                component.push(node);
+                for neighbor in 0..self.nodes {
+                    if !visited[neighbor] && self.adjacent_weak(node, neighbor) {
+                        visited[neighbor] = true;
+                        queue.push_back(neighbor);
+                    }
+                }
+            }
+            components.push(component);
+        }
+        components
+    }
+
+    /// Unweighted outward shortest-path lengths from one node.
+    pub fn try_shortest_hops(&self, source: usize) -> StatsResult<Vec<Option<usize>>> {
+        if source >= self.nodes {
+            return Err(StatisticsError::DimensionMismatch {
+                context: "network source node",
+                expected: self.nodes,
+                actual: source.saturating_add(1),
+            });
+        }
+        let mut distances = vec![None; self.nodes];
+        distances[source] = Some(0);
+        let mut queue = VecDeque::from([source]);
+        while let Some(node) = queue.pop_front() {
+            let distance = distances[node].unwrap_or(0);
+            for neighbor in self.outgoing_neighbors_unchecked(node) {
+                if distances[neighbor].is_none() {
+                    distances[neighbor] = Some(distance + 1);
+                    queue.push_back(neighbor);
+                }
+            }
+        }
+        Ok(distances)
+    }
+
+    fn weak_neighbors(&self, node: usize) -> Vec<usize> {
+        (0..self.nodes)
+            .filter(|&neighbor| neighbor != node && self.adjacent_weak(node, neighbor))
+            .collect()
+    }
+
+    pub fn local_clustering_coefficients(&self) -> Vec<f64> {
+        (0..self.nodes)
+            .map(|node| {
+                let neighbors = self.weak_neighbors(node);
+                if neighbors.len() < 2 {
+                    return 0.0;
+                }
+                let mut links = 0_usize;
+                for left in 0..neighbors.len() {
+                    for right in left + 1..neighbors.len() {
+                        if self.adjacent_weak(neighbors[left], neighbors[right]) {
+                            links += 1;
+                        }
+                    }
+                }
+                let possible = neighbors.len() * (neighbors.len() - 1) / 2;
+                links as f64 / possible as f64
+            })
+            .collect()
+    }
+
+    pub fn global_transitivity(&self) -> f64 {
+        let mut closed = 0_usize;
+        let mut triples = 0_usize;
+        for node in 0..self.nodes {
+            let neighbors = self.weak_neighbors(node);
+            triples += neighbors.len().saturating_mul(neighbors.len().saturating_sub(1)) / 2;
+            for left in 0..neighbors.len() {
+                for right in left + 1..neighbors.len() {
+                    if self.adjacent_weak(neighbors[left], neighbors[right]) {
+                        closed += 1;
+                    }
+                }
+            }
+        }
+        if triples == 0 {
+            0.0
+        } else {
+            closed as f64 / triples as f64
+        }
+    }
+
+    pub fn summary(&self) -> NetworkSummary {
+        let degrees = self.out_degrees();
+        let strengths = self.out_strengths();
+        let components = self.weak_components();
+        let local = self.local_clustering_coefficients();
+        NetworkSummary {
+            nodes: self.nodes,
+            edges: self.edge_count(),
+            directed: self.directed,
+            density: self.density(),
+            isolates: (0..self.nodes)
+                .filter(|&node| self.weak_neighbors(node).is_empty())
+                .count(),
+            weak_components: components.len(),
+            largest_component: components.iter().map(Vec::len).max().unwrap_or(0),
+            mean_out_degree: degrees
+                .iter()
+                .map(|&degree| degree as f64 / self.nodes as f64)
+                .sum(),
+            mean_out_strength: strengths
+                .iter()
+                .map(|&strength| strength / self.nodes as f64)
+                .sum(),
+            global_transitivity: self.global_transitivity(),
+            average_local_clustering: local.iter().sum::<f64>() / self.nodes as f64,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn triangle_is_connected_and_fully_clustered() {
+        let graph = WeightedGraph::try_from_adjacency(
+            &[
+                vec![0.0, 1.0, 1.0],
+                vec![1.0, 0.0, 1.0],
+                vec![1.0, 1.0, 0.0],
+            ],
+            false,
+            1.0e-12,
+        )
+        .unwrap();
+        let summary = graph.summary();
+        assert_eq!(summary.edges, 3);
+        assert_eq!(summary.weak_components, 1);
+        assert!((summary.density - 1.0).abs() < 1.0e-12);
+        assert!((summary.global_transitivity - 1.0).abs() < 1.0e-12);
+    }
+
+    #[test]
+    fn shortest_hops_preserve_unreachable_nodes() {
+        let graph = WeightedGraph::try_from_adjacency(
+            &[
+                vec![0.0, 1.0, 0.0, 0.0],
+                vec![0.0, 0.0, 1.0, 0.0],
+                vec![0.0, 0.0, 0.0, 0.0],
+                vec![0.0, 0.0, 0.0, 0.0],
+            ],
+            true,
+            0.0,
+        )
+        .unwrap();
+        assert_eq!(graph.try_shortest_hops(0).unwrap(), vec![Some(0), Some(1), Some(2), None]);
+    }
+
+    #[test]
+    fn rejects_asymmetric_undirected_input() {
+        assert!(matches!(
+            WeightedGraph::try_from_adjacency(
+                &[vec![0.0, 1.0], vec![0.0, 0.0]],
+                false,
+                1.0e-12
+            ),
+            Err(StatisticsError::DegenerateSample { .. })
+        ));
+    }
+}
