  "status": "research_prototype_authored_not_deployed",
  "nixos_module": {
    "path": "research/evaluator-isolation/nixos-module.nix",
    "default_enabled": false,
    "state_directory": "/var/lib/symthaea-temporal-eval",
    "run_mode": "serial_only_fixed_paths",
    "services": [
      "symthaea-temporal-taskgen",
      "symthaea-temporal-candidate",
      "symthaea-temporal-evaluator"
    ],
    "order": [
      "taskgen",
      "candidate",
      "evaluator"
