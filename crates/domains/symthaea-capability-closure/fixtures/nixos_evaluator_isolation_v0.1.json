        "groups": [
          "symthaea-temporal-generator",
          "symthaea-temporal-public",
          "symthaea-temporal-oracle"
        ]
      },
      "candidate": {
        "user": "symthaea-temporal-candidate",
        "groups": [
          "symthaea-temporal-candidate",
          "symthaea-temporal-public",
          "symthaea-temporal-exchange"
        ]
      },
      "evaluator": {
        "user": "symthaea-temporal-evaluator",
        "groups": [
          "symthaea-temporal-evaluator",
          "symthaea-temporal-public",
          "symthaea-temporal-oracle",
          "symthaea-temporal-exchange"
        ]
      }
    },
    "directories": [
      {
        "path": "public",
        "owner": "generator",
        "group": "public",
        "mode": "2750",
        "generator": "read_write",
        "candidate": "read_only",
        "evaluator": "read_only"
      },
      {
        "path": "oracle",
        "owner": "generator",
        "group": "oracle",
        "mode": "2750",
        "generator": "read_write",
        "candidate": "inaccessible",
        "evaluator": "read_only"
      },
      {
        "path": "exchange",
        "owner": "candidate",
        "group": "exchange",
        "mode": "2710",
        "generator": "inaccessible",
        "candidate": "read_write",
        "evaluator": "traverse_and_read_known_filename"
      },
      {
        "path": "candidate-work",
        "owner": "candidate",
        "group": "candidate",
        "mode": "0700",
        "generator": "inaccessible",
        "candidate": "read_write",
        "evaluator": "inaccessible"
      },
      {
        "path": "evaluator-private",
        "owner": "evaluator",
        "group": "evaluator",
        "mode": "0700",
        "generator": "inaccessible",
        "candidate": "inaccessible",
        "evaluator": "read_write"
      },
      {
        "path": "evaluator-private/replay-ledger",
        "owner": "evaluator",
        "group": "evaluator",
        "mode": "0700",
        "generator": "inaccessible",
        "candidate": "inaccessible",
        "evaluator": "read_write"
