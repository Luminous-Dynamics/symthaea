    "id": "splitmix64-uniform-residual-v1",
    "prng": "SplitMix64",
    "distribution_transform": "u=(next_u64+0.5)/2^64; symmetric residual z=2u-1; residual_milli=location_milli+round(scale_milli*z); all rounding ties away from zero",
    "covariate_stream": "independent SplitMix64 stream with a separate committed seed; x=2u-1",
    "residual_equation": "location + scale*z + covariate_slope*x; tail-contamination scenarios replace z with signed tail_scale with probability tail_contamination_ppm/1000000",
    "seed_policy": "every scenario x seed is an independent stream; commit seed list before evaluation; no test-seed selection",
    "candidate_visibility": "outcome labels only become visible at feedback_available_step; later revisions only after revision_available_step"
  },
