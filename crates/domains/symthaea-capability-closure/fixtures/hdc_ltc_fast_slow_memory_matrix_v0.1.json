    "current_source_revision": "40c3b0e75845a20b3ef2dbbe0ea3a0af0068f4b7",
    "implementation_summary": [
      "equilibrium = activation(bundle(bind(weight_hv,state), bind(input_mask,input), optional_fourier_basis))",
      "tau uses state norm and input similarity to tau_modulator, clamped to [0.01,10.0]",
      "gate uses state/input bundle similarity and gate bias followed by sigmoid and dt scaling",
      "closed-form update interpolates state toward equilibrium"
    ],
    "stored_continuous_hv_vectors_per_neuron": 8,
    "default_dimension": 16384,
    "bytes_per_continuous_hv_f32_vector_at_default_dimension": 65536,
    "source_derived_vector_payload_bytes_per_neuron_at_default_dimension": 524288,
    "storage_note": "Source-derived payload estimate only; excludes Vec/allocator overhead, inputs, temporary binds/bundles/equilibrium, network buffers and measured runtime RSS."
  },
