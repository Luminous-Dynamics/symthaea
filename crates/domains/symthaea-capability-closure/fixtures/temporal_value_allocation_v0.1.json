  "research_question": {
    "memory_allocation": "Does candidate-estimated future wrong-belief exposure avoided per byte-time improve the quality/TED/resource Pareto frontier under a fixed capacity?",
    "metric_calibration": "How accurately do sample-density-corrected CSE/CAE estimates track exact piecewise-linear residual risk across controlled timestamp schedules?"
  },
  "candidate_policy": {
    "path": "research/temporal-bench/src/temporal_value.rs",
    "candidate_only": true,
    "oracle_inputs_allowed": false,
    "feature_fields": [
      "item_id",
      "bytes",
      "predicted_ted_reduction_us",
      "confidence_ppm",
      "relevance_ppm",
      "freshness_ppm",
      "novelty_ppm",
      "last_access_us",
      "last_update_us",
      "expected_retention_us",
      "valid_until_us",
      "access_count"
    ],
    "estimate_provenance": "estimate_model_sha256",
    "probability_scale_ppm": 1000000,
    "score": {
      "numerator": "predicted_ted_reduction_us * confidence_ppm * relevance_ppm * freshness_ppm",
      "denominator": "bytes * effective_retention_us",
      "effective_retention": "min(expected_retention_us, valid_until_us - now_us) when hard validity deadline exists",
      "fixed_point_score_scale": 1000000000000000000,
      "arithmetic": "multiply-first checked u128 PPM product, one division by PPM^3, then deterministic fixed-point ratio",
      "selection": "greedy_density_heuristic_not_exact_knapsack",
      "tie_break": "ascending_item_id"
    },
    "hard_constraints": [
      "expired_or_retracted_item_is_ineligible",
      "zero_size_rejected",
      "zero_retention_rejected",
      "duplicate_item_id_rejected",
      "future_access_or_update_timestamp_rejected",
      "probabilities_must_be_at_most_1000000_ppm",
      "zero_ttl_rejected",
      "selected_bytes_never_exceed_capacity",
      "zero_predicted_value_does_not_consume_temporal_value_budget"
    ],
    "policies": [
      "temporal_value_per_byte_second",
      "lru",
      "lfu",
      "fixed_ttl",
      "novelty_first",
      "confidence_first"
    ],
    "controls": [
      "full_retention_upper_reference",
      "no_retention_lower_reference"
    ],
    "implementation": {
      "tests_authored": 12,
      "tests_executed": false,
      "production_hdc_ltc_integration": false,
      "online_value_predictor": false,
      "tiered_memory_and_refresh_cost_model": false
    }
  },
  "continuous_time_reference": {
    "path": "research/temporal-bench/src/continuous_risk.rs",
    "interpolant": "piecewise_linear_residual_between_adjacent_observed_endpoints",
    "squared_error_integral": "dt * (e0^2 + e0*e1 + e1^2) / 3",
    "absolute_error_integral": {
      "same_sign_or_zero_endpoint": "dt * (abs(e0) + abs(e1)) / 2",
      "opposite_sign": "dt * (e0^2 + e1^2) / (2 * (abs(e0) + abs(e1)))"
    },
    "support": "first_observation_through_last_observation_only_no_extrapolation",
    "claim_ceiling": "exact for declared piecewise-linear residual interpolant only; not ground truth over unobserved intervals; CAE is a locally added absolute-error companion and is not claimed as a method established by the cited CSE paper",
    "outputs": [
      "duration_us",
      "integrated_squared_error",
      "integrated_absolute_error",
      "mean_squared_error",
      "mean_absolute_error"
    ],
    "implementation": {
      "tests_authored": 8,
