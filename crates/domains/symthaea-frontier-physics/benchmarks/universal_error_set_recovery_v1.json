  "mathematical_contract": {
    "code": {
      "dimension": 2,
      "physical_dimension": 8,
      "codewords": [
        "|000>",
        "|111>"
      ],
      "projector": "P=|000><000|+|111><111|"
    },
    "error_set": [
      "I",
      "X_0",
      "X_1",
      "X_2"
    ],
    "qec_matrix": "A_QEC[(i,k),(j,l)] = <c_i|E_k^dagger E_l|c_j>",
    "exact_kl_condition": "A_QEC = I_K tensor lambda for lambda positive semidefinite",
    "hellinger_distance": "zeta_H(E,Q) = (1/sqrt(K)) min_{lambda>=0} ||sqrt(A_QEC)-I_K tensor sqrt(lambda)||_2",
    "environment_leakage": "zeta(E,Q) = inf_lambda ||B^E_(lambda,Q)||_diamond",
    "environment_leakage_map": "B^E_(lambda,Q)(X)=sum_kl tr((P E_l^dagger E_k P - lambda_kl P)X)|k><l|",
    "controlled_channel": "F_alpha = sum_k C[alpha,k] E_k",
    "theorem_policy": "Average-case certificate uses the Knill-Laflamme Hellinger metric; worst-case certificate requires the paper's stronger E-control condition and environment-leakage metric. Verify all coefficient constraints and conventions before applying bounds.",
    "controlled_channel_coefficient_norm": "Spectral/operator norm ||C||_infinity <= 1 (paper Definition 2).",
    "strongly_controlled_channel_coefficient_norm": "Schatten-2/Hilbert-Schmidt norm ||C||_2 <= 1 (paper Definition 7); stronger than spectral norm <= 1.",
    "hellinger_closed_form": "zeta_H = sqrt(tr(A_QEC)/K - ||tr_K(sqrt(A_QEC))||_2^2/K^2).",
    "strongly_controlled_petz_worst_case_bound": "d_wc(R_Petz o N|_Q, I_Q) <= (1/sqrt(2))*||sqrt(A_QEC) - I_K tensor (1/sqrt(K))*sqrt(tr_K(A_QEC))||_infinity; apply only to strongly E-controlled channels.",
    "distinction": "Environment-leakage diamond distance and the Theorem 11 operator-norm Petz bound are separate quantities; do not substitute one for the other."
  },
