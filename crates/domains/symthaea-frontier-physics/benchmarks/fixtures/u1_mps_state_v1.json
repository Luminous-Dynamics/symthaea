  "claim_ceiling": "No two-site TEBD circuit evolution, truncation guarantee, large-N scaling or quantum advantage claim.",
  "conventions": {
    "physical_dimension": 2,
    "physical_charges": [
      0,
      1
    ],
    "virtual_charge": "integer prefix excitation number",
    "selection_rule": "q_right = q_left + physical_charge",
    "left_boundary": "single virtual state with charge zero",
    "right_boundary": "single virtual state with declared total charge",
    "bit_order": "most-significant-site first",
    "tensor_layout": "((left_index * 2) + physical_index) * right_dimension + right_index",
    "normalization": "No implicit normalization or renormalization."
  },
