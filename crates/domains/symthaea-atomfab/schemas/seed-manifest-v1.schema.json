{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/crates/domains/symthaea-atomfab/schemas/seed-manifest-v1.schema.json",
  "title": "AtomFab Preregistered Seed Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seeds",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "seeds": {
      "type": "array",
      "minItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
