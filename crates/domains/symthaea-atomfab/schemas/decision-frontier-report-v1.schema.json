{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/crates/domains/symthaea-atomfab/schemas/decision-frontier-report-v1.schema.json",
  "title": "AtomFab Decision Frontier Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_contract_digest",
    "seed",
    "objective_name",
    "objective_unit",
    "objective_direction",
    "objective_tolerance",
    "total_cost_unit",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "comparison_contract_digest": {
      "$ref": "#/$defs/sha256"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "objective_name": {
      "type": "string",
      "minLength": 1
    },
    "objective_unit": {
      "type": "string",
      "minLength": 1
    },
    "objective_direction": {
      "enum": [
        "maximize",
        "minimize"
      ]
    },
    "objective_tolerance": {
      "type": "number",
      "minimum": 0
    },
    "total_cost_unit": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "disposition"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "const": "pareto_frontier"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "dominated_by"
              ],
              "properties": {
                "status": {
                  "const": "dominated"
                },
                "dominated_by": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reasons"
              ],
              "properties": {
                "status": {
                  "const": "ineligible"
                },
                "reasons": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
