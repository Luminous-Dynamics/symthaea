{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/hardsec-pmu-observations-v1.schema.json",
  "title": "HARDSEC PMU observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "evidence_domain",
    "trials"
  ],
  "properties": {
    "schema_version": {
      "const": "hardsec-pmu-observations-v1"
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_domain": {
      "enum": [
        "synthetic_fixture",
        "simulator",
        "physical_hardware"
      ]
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trial_id",
          "block_id",
          "order_index",
          "randomization_seed",
          "platform_id",
          "workload_id",
          "protocol_id",
          "condition",
          "work_units",
          "elapsed_ns",
          "pmu_read_overhead_ns",
          "events"
        ],
        "properties": {
          "trial_id": {
            "type": "string",
            "minLength": 1
          },
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "order_index": {
            "type": "integer",
            "minimum": 1
          },
          "randomization_seed": {
            "type": "string",
            "minLength": 1
          },
          "platform_id": {
            "type": "string",
            "minLength": 1
          },
          "workload_id": {
            "type": "string",
            "minLength": 1
          },
          "protocol_id": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "enum": [
              "baseline_no_pmu",
              "singleton_per_event",
              "grouped_co_scheduled",
              "grouped_overcommitted"
            ]
          },
          "work_units": {
            "type": "integer",
            "minimum": 1
          },
          "elapsed_ns": {
            "type": "integer",
            "minimum": 1
          },
          "pmu_read_overhead_ns": {
            "type": "integer",
            "minimum": 0
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_id",
                "encoding",
                "raw_count",
                "time_enabled_ns",
                "time_running_ns",
                "sample_count",
                "lost_samples"
              ],
              "properties": {
                "event_id": {
                  "type": "string",
                  "minLength": 1
                },
                "encoding": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "time_enabled_ns": {
                  "type": "integer",
                  "minimum": 1
                },
                "time_running_ns": {
                  "type": "integer",
                  "minimum": 1
                },
                "sample_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "lost_samples": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
