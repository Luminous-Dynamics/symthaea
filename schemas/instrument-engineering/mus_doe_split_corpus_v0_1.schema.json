{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/instrument-engineering/mus_doe_split_corpus_v0_1.schema.json",
  "title": "MUS-DOE synthetic experiment-design corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "workstream_id",
    "status",
    "evidence_note",
    "partitions",
    "available_group_axes",
    "selection_policies",
    "cases"
  ],
  "properties": {
    "manifest_version": {
      "const": "musical-instrument-experiment-design-corpus/0.1"
    },
    "workstream_id": {
      "const": "MUS-DOE-001"
    },
    "status": {
      "const": "SYNTHETIC_POLICY_FIXTURES_NOT_PHYSICAL_EVIDENCE"
    },
    "evidence_note": {
      "type": "string",
      "minLength": 80
    },
    "partitions": {
      "const": [
        "fit",
        "calibration",
        "locked_test"
      ]
    },
    "available_group_axes": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "physical_unit_id",
          "build_batch_id",
          "builder_id",
          "environment_id",
          "measurement_session_id",
          "material_lot_id"
        ]
      }
    },
    "selection_policies": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fixed_grid",
          "seeded_random",
          "uncertainty_first",
          "model_disagreement",
          "cost_aware_information_gain",
          "predicted_mean_exploitation"
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "groupIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_unit_id",
        "build_batch_id",
        "builder_id",
        "environment_id",
        "measurement_session_id",
        "material_lot_id"
      ],
      "properties": {
        "physical_unit_id": {
          "type": "string",
          "minLength": 1
        },
        "build_batch_id": {
          "type": "string",
          "minLength": 1
        },
        "builder_id": {
          "type": "string",
          "minLength": 1
        },
        "environment_id": {
          "type": "string",
          "minLength": 1
        },
        "measurement_session_id": {
          "type": "string",
          "minLength": 1
        },
        "material_lot_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "partition",
        "source_class",
        "group_ids"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[a-z]+-[0-9]{3}$"
        },
        "partition": {
          "enum": [
            "fit",
            "calibration",
            "locked_test"
          ]
        },
        "source_class": {
          "const": "synthetic_fixture"
        },
        "group_ids": {
          "$ref": "#/$defs/groupIds"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "policy_version",
        "random_seed",
        "experiment_budget",
        "candidate_count",
        "selected_candidate_ids",
        "selected_candidates_admissible",
        "data_partitions_consumed",
        "locked_test_outcomes_used",
        "posthoc_policy_change"
      ],
      "properties": {
        "policy": {
          "enum": [
            "fixed_grid",
            "seeded_random",
            "uncertainty_first",
            "model_disagreement",
            "cost_aware_information_gain",
            "predicted_mean_exploitation"
          ]
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "random_seed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "experiment_budget": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 1
        },
        "selected_candidate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_candidates_admissible": {
          "type": "boolean"
        },
        "data_partitions_consumed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "fit",
              "calibration",
              "locked_test"
            ]
          }
        },
        "locked_test_outcomes_used": {
          "type": "boolean"
        },
        "posthoc_policy_change": {
          "type": "boolean"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_type",
        "source_class",
        "independence_axes",
        "observations",
        "selection",
        "fault_modes",
        "expected_disposition",
        "rationale"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^(POS|NEG)-[0-9]{3}$"
        },
        "case_type": {
          "enum": [
            "positive_control",
            "negative_control"
          ]
        },
        "source_class": {
          "const": "synthetic_fixture"
        },
        "independence_axes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "physical_unit_id",
              "build_batch_id",
              "builder_id",
              "environment_id",
              "measurement_session_id",
              "material_lot_id"
            ]
          }
        },
        "observations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "fault_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "physical_unit_cross_partition",
              "build_batch_cross_partition",
              "builder_cross_partition",
              "environment_cross_partition",
              "measurement_session_cross_partition",
              "material_lot_cross_partition",
              "locked_test_outcome_used",
              "inadmissible_experiment_selected",
              "random_seed_missing",
              "posthoc_policy_change"
            ]
          }
        },
        "expected_disposition": {
          "enum": [
            "VALID_SYNTHETIC_SPLIT",
            "REJECT_GROUP_LEAKAGE",
            "REJECT_TEST_CONTAMINATION",
            "REJECT_INADMISSIBLE_SELECTION",
            "REJECT_NONDETERMINISTIC_REPLAY",
            "REJECT_POSTHOC_CHANGE"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 30
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "case_type": {
                "const": "positive_control"
              }
            },
            "required": [
              "case_type"
            ]
          },
          "then": {
            "properties": {
              "expected_disposition": {
                "const": "VALID_SYNTHETIC_SPLIT"
              },
              "fault_modes": {
                "const": [
                  "none"
                ]
              },
              "case_id": {
                "pattern": "^POS-[0-9]{3}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "case_type": {
                "const": "negative_control"
              }
            },
            "required": [
              "case_type"
            ]
          },
          "then": {
            "properties": {
              "expected_disposition": {
                "not": {
                  "const": "VALID_SYNTHETIC_SPLIT"
                }
              },
              "fault_modes": {
                "not": {
                  "contains": {
                    "const": "none"
                  }
                }
              },
              "case_id": {
                "pattern": "^NEG-[0-9]{3}$"
              }
            }
          }
        }
      ]
    }
  }
}
