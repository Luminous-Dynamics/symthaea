{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/transport/battery_inverse_design_v0_1.schema.json",
  "title": "Battery inverse design manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "mission",
    "scenarios",
    "objectives",
    "evidence",
    "candidates",
    "experiment_options",
    "selection_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "application",
        "duty_cycle_ref",
        "required_calendar_life_years",
        "minimum_lifetime_energy_kwh",
        "system_boundary"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "application": {
          "type": "string",
          "minLength": 1
        },
        "duty_cycle_ref": {
          "type": "string",
          "minLength": 1
        },
        "required_calendar_life_years": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_lifetime_energy_kwh": {
          "type": "number",
          "minimum": 0
        },
        "system_boundary": {
          "enum": [
            "cell",
            "module",
            "pack",
            "installed_system"
          ]
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "temperature_c",
          "age_state",
          "duty_cycle_ref"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "temperature_c": {
            "type": "number"
          },
          "age_state": {
            "type": "string",
            "minLength": 1
          },
          "duty_cycle_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objective_id",
          "unit",
          "direction",
          "boundary"
        ],
        "properties": {
          "objective_id": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "maximize",
              "minimize"
            ]
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "hard_gate": {
            "type": "boolean"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "evidence_class",
          "source_digest",
          "claim_scope",
          "validity_domain",
          "admission"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_class": {
            "enum": [
              "synthetic_fixture",
              "assumption",
              "vendor_claim",
              "literature_reported",
              "surrogate",
              "calculation",
              "physical_measurement",
              "independent_lab"
            ]
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "claim_scope": {
            "type": "string",
            "minLength": 1
          },
          "validity_domain": {
            "type": "string",
            "minLength": 1
          },
          "admission": {
            "enum": [
              "candidate",
              "admitted_for_research",
              "admitted_for_evaluation",
              "blocked",
              "unknown"
            ]
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "revision",
          "design_refs",
          "scenario_metrics",
          "hard_gates"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "design_refs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "materials",
              "electrode_design",
              "process_window",
              "cell_configuration"
            ],
            "properties": {
              "materials": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "electrode_design": {
                "type": "string",
                "minLength": 1
              },
              "process_window": {
                "type": "string",
                "minLength": 1
              },
              "cell_configuration": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "scenario_metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scenario_id",
                "metrics"
              ],
              "properties": {
                "scenario_id": {
                  "type": "string",
                  "minLength": 1
                },
                "metrics": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "objective_id",
                      "value",
                      "evidence_id"
                    ],
                    "properties": {
                      "objective_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "number"
                      },
                      "lower": {
                        "type": "number"
                      },
                      "upper": {
                        "type": "number"
                      },
                      "uncertainty_kind": {
                        "enum": [
                          "interval",
                          "standard_uncertainty",
                          "unknown"
                        ]
                      },
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "hard_gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "gate_id",
                "disposition",
                "evidence_id"
              ],
              "properties": {
                "gate_id": {
                  "type": "string",
                  "minLength": 1
                },
                "disposition": {
                  "enum": [
                    "pass",
                    "fail",
                    "unknown"
                  ]
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "experiment_options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experiment_id",
          "question",
          "estimated_cost_usd",
          "duration_hours",
          "material_consumption_g",
          "risk_class",
          "expected_information_gain",
          "estimate_evidence_id"
        ],
        "properties": {
          "experiment_id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "estimated_cost_usd": {
            "type": "number",
            "minimum": 0
          },
          "duration_hours": {
            "type": "number",
            "minimum": 0
          },
          "material_consumption_g": {
            "type": "number",
            "minimum": 0
          },
          "risk_class": {
            "enum": [
              "low",
              "moderate",
              "high",
              "prohibited",
              "unknown"
            ]
          },
          "expected_information_gain": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "estimate_evidence_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cost_usd",
        "max_duration_hours",
        "max_material_g",
        "allow_no_experiment"
      ],
      "properties": {
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_duration_hours": {
          "type": "number",
          "minimum": 0
        },
        "max_material_g": {
          "type": "number",
          "minimum": 0
        },
        "allow_no_experiment": {
          "type": "boolean"
        },
        "maximum_risk_class": {
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        }
      }
    }
  }
}
