{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/transport/battery_design_lifetime_transfer_v0_1.schema.json",
  "title": "Battery design lifetime transfer manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "cutoff_cycles",
    "cells",
    "split",
    "predictions",
    "outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "cutoff_cycles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "design_group_id",
          "protocol_group_id",
          "feature_available_through_cycle",
          "prediction_cutoff_cycle",
          "feature_evidence_ref"
        ],
        "properties": {
          "cell_id": {
            "type": "string",
            "minLength": 1
          },
          "design_group_id": {
            "type": "string",
            "minLength": 1
          },
          "protocol_group_id": {
            "type": "string",
            "minLength": 1
          },
          "feature_available_through_cycle": {
            "type": "integer",
            "minimum": 1
          },
          "prediction_cutoff_cycle": {
            "type": "integer",
            "minimum": 1
          },
          "feature_evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split_id",
        "kind",
        "train_cell_ids",
        "validation_cell_ids",
        "test_cell_ids",
        "train_design_group_ids",
        "validation_design_group_ids",
        "test_design_group_ids",
        "train_protocol_group_ids",
        "validation_protocol_group_ids",
        "test_protocol_group_ids"
      ],
      "properties": {
        "split_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "published_reproduction",
            "leave_one_cell_out",
            "leave_one_design_group_out",
            "leave_one_protocol_out",
            "prospective"
          ]
        },
        "train_cell_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "validation_cell_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "test_cell_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "train_design_group_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "validation_design_group_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "test_design_group_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "train_protocol_group_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "validation_protocol_group_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "test_protocol_group_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "design_group_id",
          "prediction_cutoff_cycle",
          "predicted_cycle_life",
          "lower_cycle_life",
          "upper_cycle_life",
          "model_evidence_ref"
        ],
        "properties": {
          "cell_id": {
            "type": "string",
            "minLength": 1
          },
          "design_group_id": {
            "type": "string",
            "minLength": 1
          },
          "prediction_cutoff_cycle": {
            "type": "integer",
            "minimum": 1
          },
          "predicted_cycle_life": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "lower_cycle_life": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "upper_cycle_life": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "model_evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "kind",
          "observed_through_cycle",
          "event_cycle",
          "event_code"
        ],
        "properties": {
          "cell_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "event_observed",
              "right_censored",
              "competing_event",
              "unknown"
            ]
          },
          "observed_through_cycle": {
            "type": "integer",
            "minimum": 1
          },
          "event_cycle": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "event_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
