{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/transport/ev-diagnostic-voi-scenario/0.1",
  "title": "EV diagnostic value-of-information scenario v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_version",
    "scenario_id",
    "oracle_evidence_class",
    "context",
    "states",
    "actions",
    "tests",
    "asset",
    "evidence"
  ],
  "properties": {
    "scenario_version": {
      "const": "ev-diagnostic-voi-scenario/0.1"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "oracle_evidence_class": {
      "enum": [
        "synthetic_fixture",
        "independently_adjudicated_reference"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chemistry",
        "temperature_c",
        "soc_fraction"
      ],
      "properties": {
        "chemistry": {
          "enum": [
            "lfp",
            "lmfp",
            "nmc",
            "nca",
            "lco",
            "sodium_ion",
            "other",
            "unknown"
          ]
        },
        "temperature_c": {
          "type": "number"
        },
        "soc_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state_id",
          "prior_probability"
        ],
        "properties": {
          "state_id": {
            "type": "string",
            "minLength": 1
          },
          "prior_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "gate_status",
          "losses"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "gate_status": {
            "enum": [
              "satisfied",
              "blocked",
              "unknown"
            ]
          },
          "losses": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state_id",
                "loss_units"
              ],
              "properties": {
                "state_id": {
                  "type": "string",
                  "minLength": 1
                },
                "loss_units": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "protocol_ref",
          "equipment_ref",
          "protocol_digest",
          "equipment_digest",
          "calibration_digest",
          "interpretation_status",
          "cost",
          "applicability",
          "preconditions",
          "outcomes",
          "vehicle_configuration_digest",
          "pack_configuration_digest",
          "calibration_ref"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1
          },
          "protocol_ref": {
            "type": "string",
            "minLength": 1
          },
          "equipment_ref": {
            "type": "string",
            "minLength": 1
          },
          "protocol_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "equipment_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "calibration_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "interpretation_status": {
            "enum": [
              "qualified_for_domain",
              "unqualified",
              "unknown"
            ]
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "test_cost_units",
              "downtime_cost_units",
              "cost_unit_ref",
              "evidence_class",
              "evidence_digest",
              "source_ref"
            ],
            "properties": {
              "test_cost_units": {
                "type": "number",
                "minimum": 0
              },
              "downtime_cost_units": {
                "type": "number",
                "minimum": 0
              },
              "cost_unit_ref": {
                "const": "decision-loss-unit/0.1"
              },
              "evidence_class": {
                "enum": [
                  "declared_synthetic_cost",
                  "reference_quote",
                  "measured_cost"
                ]
              },
              "evidence_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "supported_chemistries",
              "minimum_temperature_c",
              "maximum_temperature_c",
              "minimum_soc_fraction",
              "maximum_soc_fraction"
            ],
            "properties": {
              "supported_chemistries": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "lfp",
                    "lmfp",
                    "nmc",
                    "nca",
                    "lco",
                    "sodium_ion",
                    "other",
                    "unknown"
                  ]
                }
              },
              "minimum_temperature_c": {
                "type": "number"
              },
              "maximum_temperature_c": {
                "type": "number"
              },
              "minimum_soc_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "maximum_soc_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "preconditions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "safety_review",
              "qualified_facility",
              "protocol_approved",
              "calibration_valid",
              "authority_approved"
            ],
            "properties": {
              "safety_review": {
                "enum": [
                  "satisfied",
                  "missing",
                  "unknown"
                ]
              },
              "qualified_facility": {
                "enum": [
                  "satisfied",
                  "missing",
                  "unknown"
                ]
              },
              "protocol_approved": {
                "enum": [
                  "satisfied",
                  "missing",
                  "unknown"
                ]
              },
              "calibration_valid": {
                "enum": [
                  "satisfied",
                  "missing",
                  "unknown"
                ]
              },
              "authority_approved": {
                "enum": [
                  "satisfied",
                  "missing",
                  "unknown"
                ]
              }
            }
          },
          "outcomes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome_id",
                "likelihoods"
              ],
              "properties": {
                "outcome_id": {
                  "type": "string",
                  "minLength": 1
                },
                "likelihoods": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "state_id",
                      "probability"
                    ],
                    "properties": {
                      "state_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "probability": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "vehicle_configuration_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "pack_configuration_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "calibration_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vehicle_ref",
        "vehicle_configuration_digest",
        "pack_ref",
        "pack_configuration_digest"
      ],
      "properties": {
        "vehicle_ref": {
          "type": "string",
          "minLength": 1
        },
        "vehicle_configuration_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pack_ref": {
          "type": "string",
          "minLength": 1
        },
        "pack_configuration_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_batch_ref",
        "observation_batch_digest",
        "pack_capability_profile_ref",
        "pack_capability_profile_digest",
        "prior_model_ref",
        "prior_model_digest",
        "decision_loss_model_ref",
        "decision_loss_model_digest"
      ],
      "properties": {
        "observation_batch_ref": {
          "type": "string",
          "minLength": 1
        },
        "observation_batch_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pack_capability_profile_ref": {
          "type": "string",
          "minLength": 1
        },
        "pack_capability_profile_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prior_model_ref": {
          "type": "string",
          "minLength": 1
        },
        "prior_model_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision_loss_model_ref": {
          "type": "string",
          "minLength": 1
        },
        "decision_loss_model_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
