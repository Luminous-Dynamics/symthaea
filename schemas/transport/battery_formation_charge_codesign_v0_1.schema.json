{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/transport/battery_formation_charge_codesign_v0_1.schema.json",
  "title": "Battery formation and charge-policy factorial campaign manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign",
    "arms",
    "cells",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "mission_id",
        "blocking_axis",
        "holdout_axis",
        "maximum_feature_cutoff_cycle"
      ],
      "properties": {
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "holdout_axis": {
          "enum": [
            "lot",
            "line",
            "protocol_pair",
            "design"
          ]
        },
        "maximum_feature_cutoff_cycle": {
          "type": "integer",
          "minimum": 1
        },
        "blocking_axis": {
          "enum": [
            "lot",
            "line"
          ]
        }
      }
    },
    "arms": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "arm_id",
          "design_id",
          "design_revision",
          "formation_profile_id",
          "formation_revision",
          "charge_policy_id",
          "charge_policy_revision",
          "protocol_evidence_id",
          "is_reference"
        ],
        "properties": {
          "arm_id": {
            "type": "string",
            "minLength": 1
          },
          "design_id": {
            "type": "string",
            "minLength": 1
          },
          "design_revision": {
            "type": "string",
            "minLength": 1
          },
          "formation_profile_id": {
            "type": "string",
            "minLength": 1
          },
          "formation_revision": {
            "type": "string",
            "minLength": 1
          },
          "charge_policy_id": {
            "type": "string",
            "minLength": 1
          },
          "charge_policy_revision": {
            "type": "string",
            "minLength": 1
          },
          "protocol_evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "is_reference": {
            "type": "boolean"
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "arm_id",
          "design_id",
          "design_revision",
          "lot_id",
          "lot_lineage_digest",
          "line_id",
          "line_identity_digest",
          "split",
          "feature_cutoff_cycle",
          "feature_observations",
          "cycles_observed",
          "status",
          "event_cycle",
          "failure_mode",
          "outcome_evidence_id"
        ],
        "properties": {
          "cell_id": {
            "type": "string",
            "minLength": 1
          },
          "arm_id": {
            "type": "string",
            "minLength": 1
          },
          "design_id": {
            "type": "string",
            "minLength": 1
          },
          "design_revision": {
            "type": "string",
            "minLength": 1
          },
          "lot_id": {
            "type": "string",
            "minLength": 1
          },
          "lot_lineage_digest": {
            "$ref": "#/$defs/digest"
          },
          "line_id": {
            "type": "string",
            "minLength": 1
          },
          "line_identity_digest": {
            "$ref": "#/$defs/digest"
          },
          "split": {
            "enum": [
              "train",
              "validation",
              "test",
              "prospective"
            ]
          },
          "feature_cutoff_cycle": {
            "type": "integer",
            "minimum": 1
          },
          "cycles_observed": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "observed_eol",
              "right_censored",
              "competing_failure",
              "invalid",
              "unknown",
              "synthetic_outcome"
            ]
          },
          "event_cycle": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "failure_mode": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome_evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "feature_observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "feature_id",
                "available_cycle",
                "evidence_id"
              ],
              "properties": {
                "feature_id": {
                  "type": "string",
                  "minLength": 1
                },
                "available_cycle": {
                  "type": "integer",
                  "minimum": 1
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "source_digest",
          "evidence_class",
          "admission",
          "claim_scope",
          "validity_domain",
          "metrology_ref"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "source_digest": {
            "$ref": "#/$defs/digest"
          },
          "evidence_class": {
            "enum": [
              "synthetic_fixture",
              "assumption",
              "vendor_claim",
              "literature_reported",
              "simulation",
              "surrogate",
              "calculation",
              "physical_measurement",
              "independent_laboratory"
            ]
          },
          "admission": {
            "enum": [
              "candidate",
              "admitted_for_research",
              "admitted_for_evaluation",
              "blocked",
              "unknown"
            ]
          },
          "claim_scope": {
            "type": "string",
            "minLength": 1
          },
          "validity_domain": {
            "type": "string",
            "minLength": 1
          },
          "metrology_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
