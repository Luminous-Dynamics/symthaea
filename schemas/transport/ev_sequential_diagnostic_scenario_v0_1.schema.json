{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/transport/ev-sequential-diagnostic-scenario/0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "decision_unit",
    "horizon",
    "abstain_loss",
    "hypotheses",
    "actions",
    "tests"
  ],
  "properties": {
    "schema_version": {
      "const": "ev-sequential-diagnostic/0.1"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_unit": {
      "type": "string",
      "minLength": 1
    },
    "horizon": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "abstain_loss": {
      "type": "number",
      "minimum": 0
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1
    },
    "actions": {
      "type": "array"
    },
    "tests": {
      "type": "array"
    }
  }
}
