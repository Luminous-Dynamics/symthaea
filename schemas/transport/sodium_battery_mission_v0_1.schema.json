{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/transport/sodium_battery_mission_v0_1.schema.json",
  "title": "Sodium battery mission comparison manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "mission",
    "technology_lanes",
    "specimens",
    "test_conditions",
    "measurements",
    "lifetime_outcomes",
    "evidence_registry",
    "comparison_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "application",
        "duty_cycle_ref",
        "ambient_scenarios",
        "system_boundary"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "application": {
          "enum": [
            "cold_climate_stationary",
            "remote_off_grid",
            "industrial_fleet",
            "hybrid_sodium_lfp",
            "other"
          ]
        },
        "duty_cycle_ref": {
          "type": "string",
          "minLength": 1
        },
        "ambient_scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario_id",
              "ambient_c",
              "preheat_policy"
            ],
            "properties": {
              "scenario_id": {
                "type": "string",
                "minLength": 1
              },
              "ambient_c": {
                "type": "number"
              },
              "preheat_policy": {
                "enum": [
                  "none",
                  "included_and_metered",
                  "excluded",
                  "unknown"
                ]
              }
            }
          }
        },
        "system_boundary": {
          "enum": [
            "complete_cell",
            "module",
            "pack",
            "installed_system"
          ]
        },
        "required_lifetime_energy_kwh": {
          "type": "number",
          "minimum": 0
        },
        "required_peak_power_kw": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "technology_lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane_id",
          "technology_lane",
          "maturity_class",
          "allowed_comparator_lanes"
        ],
        "properties": {
          "lane_id": {
            "type": "string",
            "minLength": 1
          },
          "technology_lane": {
            "enum": [
              "commercial_sodium_ion",
              "zero_excess_sodium_metal",
              "lithium_iron_phosphate",
              "nickel_manganese_cobalt"
            ]
          },
          "maturity_class": {
            "enum": [
              "commercial_product",
              "pilot_line",
              "laboratory_pouch",
              "coin_cell",
              "computational_only",
              "unknown"
            ]
          },
          "allowed_comparator_lanes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "commercial_sodium_ion",
                "zero_excess_sodium_metal",
                "lithium_iron_phosphate",
                "nickel_manganese_cobalt"
              ]
            }
          }
        }
      }
    },
    "specimens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "specimen_id",
          "design_id",
          "lane_id",
          "chemistry_description",
          "cell_format",
          "mass_basis",
          "cell_mass_g",
          "cell_volume_cm3",
          "areal_loading_mg_cm2",
          "electrolyte_to_capacity_g_ah",
          "source_lineage_ref",
          "batch_group_id"
        ],
        "properties": {
          "specimen_id": {
            "type": "string",
            "minLength": 1
          },
          "design_id": {
            "type": "string",
            "minLength": 1
          },
          "lane_id": {
            "type": "string",
            "minLength": 1
          },
          "chemistry_description": {
            "type": "string",
            "minLength": 1
          },
          "cell_format": {
            "enum": [
              "coin",
              "cylindrical",
              "pouch",
              "prismatic",
              "module",
              "pack",
              "other"
            ]
          },
          "mass_basis": {
            "enum": [
              "active_material",
              "electrode",
              "complete_cell_including_inactive_components",
              "module",
              "pack",
              "installed_system"
            ]
          },
          "cell_mass_g": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cell_volume_cm3": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "areal_loading_mg_cm2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "electrolyte_to_capacity_g_ah": {
            "type": "number",
            "minimum": 0
          },
          "n_p_ratio": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "stack_pressure_kpa": {
            "type": "number",
            "minimum": 0
          },
          "source_lineage_ref": {
            "type": "string",
            "minLength": 1
          },
          "batch_group_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "test_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition_id",
          "specimen_id",
          "temperature_c",
          "soc_min_pct",
          "soc_max_pct",
          "charge_c_rate",
          "discharge_c_rate",
          "voltage_window_ref",
          "protocol_ref",
          "formation_ref",
          "calibration_ref",
          "raw_data_digest"
        ],
        "properties": {
          "condition_id": {
            "type": "string",
            "minLength": 1
          },
          "specimen_id": {
            "type": "string",
            "minLength": 1
          },
          "temperature_c": {
            "type": "number"
          },
          "soc_min_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "soc_max_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "charge_c_rate": {
            "type": "number",
            "minimum": 0
          },
          "discharge_c_rate": {
            "type": "number",
            "minimum": 0
          },
          "voltage_window_ref": {
            "type": "string",
            "minLength": 1
          },
          "protocol_ref": {
            "type": "string",
            "minLength": 1
          },
          "formation_ref": {
            "type": "string",
            "minLength": 1
          },
          "calibration_ref": {
            "type": "string",
            "minLength": 1
          },
          "raw_data_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "measurement_id",
          "specimen_id",
          "condition_id",
          "metric_id",
          "value",
          "unit",
          "system_boundary",
          "evidence_id"
        ],
        "properties": {
          "measurement_id": {
            "type": "string",
            "minLength": 1
          },
          "specimen_id": {
            "type": "string",
            "minLength": 1
          },
          "condition_id": {
            "type": "string",
            "minLength": 1
          },
          "metric_id": {
            "enum": [
              "specific_energy",
              "volumetric_energy",
              "usable_capacity",
              "charge_acceptance",
              "peak_power",
              "round_trip_efficiency",
              "coulombic_efficiency",
              "impedance_growth",
              "preheat_energy",
              "process_energy"
            ]
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "system_boundary": {
            "enum": [
              "active_material",
              "electrode",
              "complete_cell",
              "module",
              "pack",
              "installed_system"
            ]
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lifetime_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome_id",
          "specimen_id",
          "status",
          "observed_cycles",
          "event_cycle",
          "event_code",
          "end_of_life_definition_ref"
        ],
        "properties": {
          "outcome_id": {
            "type": "string",
            "minLength": 1
          },
          "specimen_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "event_observed",
              "right_censored",
              "competing_event",
              "invalid_test",
              "unknown"
            ]
          },
          "observed_cycles": {
            "type": "integer",
            "minimum": 0
          },
          "event_cycle": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "event_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "end_of_life_definition_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "evidence_class",
          "source_digest",
          "claim_scope",
          "validity_domain",
          "rights_state"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_class": {
            "enum": [
              "synthetic_fixture",
              "assumption",
              "vendor_claim",
              "literature_reported",
              "surrogate",
              "calculation",
              "physical_measurement",
              "independent_lab"
            ]
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "claim_scope": {
            "type": "string",
            "minLength": 1
          },
          "validity_domain": {
            "type": "string",
            "minLength": 1
          },
          "rights_state": {
            "enum": [
              "candidate_unreviewed",
              "research_use_admitted",
              "evaluation_only",
              "commercial_use_blocked",
              "redistribution_blocked",
              "rejected"
            ]
          }
        }
      }
    },
    "comparison_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_matched_conditions",
        "forbid_lane_mixing",
        "allow_active_material_to_full_cell_extrapolation"
      ],
      "properties": {
        "require_matched_conditions": {
          "const": true
        },
        "forbid_lane_mixing": {
          "const": true
        },
        "allow_active_material_to_full_cell_extrapolation": {
          "const": false
        },
        "minimum_independent_specimens_per_design": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
