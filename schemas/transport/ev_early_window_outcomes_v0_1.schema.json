{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/ev_early_window_outcomes_v0_1",
  "title": "EV early-window multi-output target evidence corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_version",
    "cases"
  ],
  "properties": {
    "corpus_version": {
      "const": "ev-early-window-outcomes/0.1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "feature_sha256",
        "source_class",
        "source_window_start_seconds",
        "source_window_end_seconds",
        "available_at_seconds",
        "uses_target_or_future_data"
      ],
      "properties": {
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "feature_sha256": {
          "$ref": "#/$defs/digest"
        },
        "source_class": {
          "type": "string",
          "enum": [
            "OBSERVED_PREFIX",
            "DERIVED_PREFIX",
            "POST_CUTOFF",
            "FULL_LIFETIME",
            "TARGET_DERIVED"
          ]
        },
        "source_window_start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "source_window_end_seconds": {
          "type": "number",
          "minimum": 0
        },
        "available_at_seconds": {
          "type": "number",
          "minimum": 0
        },
        "uses_target_or_future_data": {
          "type": "boolean"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "kind",
        "unit",
        "target_value",
        "label_source",
        "evidence_ref",
        "evidence_sha256",
        "reference_protocol_ref",
        "reference_protocol_sha256",
        "reference_time_seconds",
        "target_window_start_seconds",
        "target_window_end_seconds",
        "horizon_seconds",
        "uncertainty",
        "coverage_fraction",
        "target_resolution",
        "censoring_state",
        "observed_duration_seconds",
        "competing_event_code",
        "load_profile_ref",
        "load_profile_sha256"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "SOH",
            "REMAINING_DISCHARGE_TIME",
            "PEAK_TEMPERATURE",
            "POWER_ENVELOPE"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "target_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "label_source": {
          "type": "string",
          "enum": [
            "INDEPENDENT_REFERENCE_TEST",
            "OPERATIONAL_DERIVED",
            "INDEPENDENT_THERMAL_MEASUREMENT",
            "QUALIFIED_PHYSICAL_MODEL"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_sha256": {
          "$ref": "#/$defs/digest"
        },
        "reference_protocol_ref": {
          "type": "string",
          "minLength": 1
        },
        "reference_protocol_sha256": {
          "$ref": "#/$defs/digest"
        },
        "reference_time_seconds": {
          "type": "number",
          "minimum": 0
        },
        "target_window_start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "target_window_end_seconds": {
          "type": "number",
          "minimum": 0
        },
        "horizon_seconds": {
          "type": "number",
          "minimum": 0
        },
        "uncertainty": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "coverage_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "target_resolution": {
          "type": "string",
          "enum": [
            "CELL",
            "MODULE",
            "PACK",
            "NOT_APPLICABLE"
          ]
        },
        "censoring_state": {
          "type": "string",
          "enum": [
            "NOT_APPLICABLE",
            "EXACT_ENDPOINT_EVENT",
            "RIGHT_CENSORED",
            "COMPETING_EVENT"
          ]
        },
        "observed_duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "competing_event_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "load_profile_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "load_profile_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "expected_disposition",
        "asset_ref",
        "configuration_sha256",
        "prediction_event_ref",
        "modality",
        "prediction_cutoff_seconds",
        "features",
        "targets"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_disposition": {
          "type": "string",
          "enum": [
            "ACCEPT",
            "REJECT"
          ]
        },
        "asset_ref": {
          "type": "string",
          "minLength": 1
        },
        "configuration_sha256": {
          "$ref": "#/$defs/digest"
        },
        "prediction_event_ref": {
          "type": "string",
          "minLength": 1
        },
        "modality": {
          "type": "string",
          "enum": [
            "PARTIAL_DISCHARGE",
            "PARTIAL_CHARGE"
          ]
        },
        "prediction_cutoff_seconds": {
          "type": "number",
          "minimum": 0
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      }
    }
  }
}
