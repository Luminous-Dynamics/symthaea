{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/schemas/rea-differential-oracle-v1.schema.json",
  "title": "Single generated known-answer extraction oracle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "case_id",
    "source",
    "expected_regions",
    "expected_files"
  ],
  "properties": {
    "schema_version": {
      "const": "symthaea.rea-differential-oracle.v1"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "expected_regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "expected_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "byte_length"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "end"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_length",
        "logical_id"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "logical_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
