{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/hardsec-fsm-event-pool-v1.schema.json",
  "title": "HARDSEC Finite FSM Event-Pool Fixture v1",
  "description": "A finite deterministic labelled transition system and sampled trace pool. Reference completeness is limited to the declared initial states and max_states.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "description",
    "states",
    "initial_states",
    "max_states",
    "transitions",
    "trace_pool"
  ],
  "properties": {
    "schema_version": {
      "const": "hardsec-fsm-event-pool-v1"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "initial_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_states": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "trace_pool": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trace"
      }
    }
  },
  "$defs": {
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "event_id",
        "from",
        "input",
        "to"
      ],
      "properties": {
        "transition_id": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "initial_state",
        "steps"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "initial_state": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
