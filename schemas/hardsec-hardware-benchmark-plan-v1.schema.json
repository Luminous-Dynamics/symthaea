{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/hardsec-hardware-benchmark-plan-v1.schema.json",
  "title": "HARDSEC hardware attack detector benchmark plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "status",
    "evidence_domains",
    "evidence_separation",
    "minimum_platform_scope",
    "split_ladder",
    "baseline_arms",
    "candidate_arms",
    "attack_families",
    "nuisance_factors",
    "primary_metrics",
    "aspirational_targets",
    "statistical_support",
    "negative_controls",
    "report_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "hardsec-hardware-benchmark-plan-v1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "complete",
        "superseded"
      ]
    },
    "evidence_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "synthetic_fixture",
          "simulator",
          "physical_hardware"
        ]
      }
    },
    "evidence_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_domain_pooling",
        "source_lineage_required",
        "exact_input_digests_required",
        "truth_oracle_independent",
        "threshold_frozen_on_validation",
        "energy_requires_measurement"
      ],
      "properties": {
        "no_domain_pooling": {
          "const": true
        },
        "source_lineage_required": {
          "const": true
        },
        "exact_input_digests_required": {
          "const": true
        },
        "truth_oracle_independent": {
          "const": true
        },
        "threshold_frozen_on_validation": {
          "const": true
        },
        "energy_requires_measurement": {
          "const": true
        }
      }
    },
    "minimum_platform_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_microarchitectures",
        "isa_families"
      ],
      "properties": {
        "physical_microarchitectures": {
          "type": "integer",
          "minimum": 1
        },
        "isa_families": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "split_ladder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "baseline_arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "method",
          "modality",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "modality": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidate_arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "method",
          "modality"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "modality": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "attack_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "nuisance_factors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "primary_metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "aspirational_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pooled_attack_effect_recall_min",
        "worst_family_recall_min",
        "benign_false_alerts_per_device_hour_max",
        "p95_detection_delay_sampling_windows_max",
        "median_end_to_end_overhead_fraction_max",
        "p95_end_to_end_overhead_fraction_max",
        "invalid_sensor_silent_clears_max",
        "scope_note"
      ],
      "properties": {
        "pooled_attack_effect_recall_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "worst_family_recall_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "benign_false_alerts_per_device_hour_max": {
          "type": "number",
          "minimum": 0
        },
        "p95_detection_delay_sampling_windows_max": {
          "type": "integer",
          "minimum": 1
        },
        "median_end_to_end_overhead_fraction_max": {
          "type": "number",
          "minimum": 0
        },
        "p95_end_to_end_overhead_fraction_max": {
          "type": "number",
          "minimum": 0
        },
        "invalid_sensor_silent_clears_max": {
          "const": 0
        },
        "scope_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "statistical_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint_alpha",
        "family_wise_alpha",
        "bonferroni_group_risk_endpoint_count",
        "zero_failure_independent_groups_for_upper_risk_le_0_05_single_endpoint",
        "zero_failure_independent_groups_for_upper_risk_le_0_01_single_endpoint",
        "zero_failure_independent_groups_for_upper_risk_le_0_05_six_endpoints",
        "zero_failure_independent_groups_for_upper_risk_le_0_01_six_endpoints",
        "iid_group_assumption_must_be_justified",
        "windows_do_not_increase_independent_group_support"
      ],
      "properties": {
        "endpoint_alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "family_wise_alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "bonferroni_group_risk_endpoint_count": {
          "type": "integer",
          "minimum": 1
        },
        "zero_failure_independent_groups_for_upper_risk_le_0_05_single_endpoint": {
          "type": "integer",
          "minimum": 1
        },
        "zero_failure_independent_groups_for_upper_risk_le_0_01_single_endpoint": {
          "type": "integer",
          "minimum": 1
        },
        "zero_failure_independent_groups_for_upper_risk_le_0_05_six_endpoints": {
          "type": "integer",
          "minimum": 1
        },
        "zero_failure_independent_groups_for_upper_risk_le_0_01_six_endpoints": {
          "type": "integer",
          "minimum": 1
        },
        "iid_group_assumption_must_be_justified": {
          "const": true
        },
        "windows_do_not_increase_independent_group_support": {
          "const": true
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "report_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_faithful_and_nested_reproduction_separate",
        "no_random_window_confirmatory_claim",
        "one_class_fold_mixed_precision_f1_mcc_na",
        "failed_runs_preserved",
        "na_reason_required",
        "simulator_physical_synthetic_separate"
      ],
      "properties": {
        "paper_faithful_and_nested_reproduction_separate": {
          "const": true
        },
        "no_random_window_confirmatory_claim": {
          "const": true
        },
        "one_class_fold_mixed_precision_f1_mcc_na": {
          "const": true
        },
        "failed_runs_preserved": {
          "const": true
        },
        "na_reason_required": {
          "const": true
        },
        "simulator_physical_synthetic_separate": {
          "const": true
        }
      }
    }
  }
}
