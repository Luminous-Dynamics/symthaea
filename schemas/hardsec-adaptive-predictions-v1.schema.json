{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/hardsec-adaptive-predictions-v1.schema.json",
  "title": "HARDSEC adaptive detector predictions v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "model_id",
    "model_sha256",
    "threshold_profile_sha256",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "hardsec-adaptive-predictions-v1"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "threshold_profile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "response",
          "score",
          "cost"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "response": {
            "enum": [
              "alert",
              "clear",
              "abstain",
              "sensor_invalid"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "acquisition_ns",
              "inference_ns",
              "telemetry_bytes",
              "peak_memory_bytes"
            ],
            "properties": {
              "acquisition_ns": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "inference_ns": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "telemetry_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "peak_memory_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$comment": "Detector output only. Do not include case truth, attack-effect outcome, hidden strategy labels, or evaluator oracle fields."
}
