{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/hardsec-context-assignment-policy-v1.schema.json",
  "title": "HARDSEC context assignment policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "evidence_domain",
    "stream_id",
    "evaluation_group_id",
    "assignment_mode",
    "assignment_artifact_sha256",
    "anomaly_score_artifact_sha256",
    "assignment_not_derived_from_anomaly_score",
    "assignment_not_derived_from_sequential_wealth",
    "allowed_contexts",
    "minimum_top1_confidence",
    "minimum_top1_top2_margin",
    "classifier_training_group_ids",
    "classifier_calibration_group_ids",
    "frozen_before_evaluation"
  ],
  "properties": {
    "schema_version": {
      "const": "hardsec-context-assignment-policy-v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_domain": {
      "enum": [
        "synthetic_fixture",
        "simulator",
        "physical_hardware"
      ]
    },
    "stream_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_group_id": {
      "type": "string",
      "minLength": 1
    },
    "assignment_mode": {
      "enum": [
        "external_metadata",
        "frozen_classifier"
      ]
    },
    "assignment_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "anomaly_score_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assignment_not_derived_from_anomaly_score": {
      "const": true
    },
    "assignment_not_derived_from_sequential_wealth": {
      "const": true
    },
    "allowed_contexts": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "minimum_top1_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "minimum_top1_top2_margin": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "classifier_training_group_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "classifier_calibration_group_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "frozen_before_evaluation": {
      "const": true
    }
  }
}
