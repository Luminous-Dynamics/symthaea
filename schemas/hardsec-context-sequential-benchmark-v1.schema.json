{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/hardsec-context-sequential-benchmark-v1.schema.json",
  "title": "HARDSEC context sequential benchmark plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "status",
    "baselines",
    "candidates",
    "scenarios",
    "holdout_axes",
    "metrics",
    "aspirational_targets",
    "claim_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "hardsec-context-sequential-benchmark-v1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "complete",
        "superseded"
      ]
    },
    "baselines": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "holdout_axes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "aspirational_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p95_delay_reduction_vs_best_reproduced_baseline",
        "worst_group_gap_max",
        "benign_false_alerts_per_device_hour_max",
        "pooled_attack_effect_recall_min",
        "invalid_sensor_or_unseen_context_silent_clears_max",
        "incremental_decision_layer_p95_overhead_max"
      ],
      "properties": {
        "p95_delay_reduction_vs_best_reproduced_baseline": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "worst_group_gap_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "benign_false_alerts_per_device_hour_max": {
          "type": "number",
          "minimum": 0
        },
        "pooled_attack_effect_recall_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "invalid_sensor_or_unseen_context_silent_clears_max": {
          "const": 0
        },
        "incremental_decision_layer_p95_overhead_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "claim_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditional_superuniformity_must_be_justified",
        "alpha_budget_allocated_across_streams",
        "domain_pooling_forbidden",
        "random_window_confirmatory_claim_forbidden",
        "targets_not_achievements"
      ],
      "properties": {
        "conditional_superuniformity_must_be_justified": {
          "const": true
        },
        "alpha_budget_allocated_across_streams": {
          "const": true
        },
        "domain_pooling_forbidden": {
          "const": true
        },
        "random_window_confirmatory_claim_forbidden": {
          "const": true
        },
        "targets_not_achievements": {
          "const": true
        }
      }
    }
  }
}
