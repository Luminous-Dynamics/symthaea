{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/hardsec-randomized-pit-benchmark-v1.schema.json",
  "title": "HARDSEC randomized PIT CCTM benchmark plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "status",
    "reference_implementations",
    "score_distributions",
    "randomizer_scenarios",
    "null_dependence_scenarios",
    "attack_scenarios",
    "holdout_axes",
    "primary_metrics",
    "calibration_frontier",
    "aspirational_targets",
    "claim_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "hardsec-randomized-pit-benchmark-v1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "complete",
        "superseded"
      ]
    },
    "reference_implementations": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "score_distributions": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "atoms",
          "quantization_levels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "atoms": {
            "type": "boolean"
          },
          "quantization_levels": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 2
          }
        }
      }
    },
    "randomizer_scenarios": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "boolean"
          }
        }
      }
    },
    "null_dependence_scenarios": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "attack_scenarios": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "holdout_axes": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "primary_metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "calibration_frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_alpha",
        "total_delta",
        "context_count",
        "alpha_per_context",
        "delta_per_context",
        "epsilon_formula",
        "epsilon_targets",
        "independent_reference_units_per_context",
        "iid_reference_assumption_required",
        "repeated_windows_do_not_count_as_independent_reference_units"
      ],
      "properties": {
        "total_alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "total_delta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "context_count": {
          "type": "integer",
          "minimum": 1
        },
        "alpha_per_context": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "delta_per_context": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "epsilon_formula": {
          "type": "string"
        },
        "epsilon_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        },
        "independent_reference_units_per_context": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "iid_reference_assumption_required": {
          "const": true
        },
        "repeated_windows_do_not_count_as_independent_reference_units": {
          "const": true
        }
      }
    },
    "aspirational_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_additional_null_calibration_loss_for_atomic_scores_under_assumptions",
        "matched_horizon_false_alarm_probability_not_worse_than_deterministic_cctm",
        "zero_wealth_updates_when_randomizer_missing_invalid_or_unqualified",
        "incremental_randomization_and_decision_layer_p95_overhead_max",
        "p95_detection_delay_reduction_vs_best_reproduced_baseline_min"
      ],
      "properties": {
        "no_additional_null_calibration_loss_for_atomic_scores_under_assumptions": {
          "const": true
        },
        "matched_horizon_false_alarm_probability_not_worse_than_deterministic_cctm": {
          "const": true
        },
        "zero_wealth_updates_when_randomizer_missing_invalid_or_unqualified": {
          "const": true
        },
        "incremental_randomization_and_decision_layer_p95_overhead_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "p95_detection_delay_reduction_vs_best_reproduced_baseline_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "claim_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "randomizer_independence_must_be_justified",
        "iid_null_and_reference_assumptions_must_be_justified",
        "dependent_null_scenarios_are_negative_controls",
        "reference_and_evaluation_groups_must_be_disjoint",
        "no_sota_claim_without_same_protocol_reproduction",
        "targets_are_not_results"
      ],
      "properties": {
        "randomizer_independence_must_be_justified": {
          "const": true
        },
        "iid_null_and_reference_assumptions_must_be_justified": {
          "const": true
        },
        "dependent_null_scenarios_are_negative_controls": {
          "const": true
        },
        "reference_and_evaluation_groups_must_be_disjoint": {
          "const": true
        },
        "no_sota_claim_without_same_protocol_reproduction": {
          "const": true
        },
        "targets_are_not_results": {
          "const": true
        }
      }
    }
  }
}
