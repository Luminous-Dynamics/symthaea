{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/hardsec-pmu-metrology-plan-v1.schema.json",
  "title": "HARDSEC PMU metrology plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "evidence_domain",
    "platform",
    "workload",
    "events",
    "acquisition_conditions",
    "protocol",
    "claim_scope"
  ],
  "properties": {
    "schema_version": {
      "const": "hardsec-pmu-metrology-plan-v1"
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_domain": {
      "enum": [
        "synthetic_fixture",
        "simulator",
        "physical_hardware"
      ]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_id",
        "architecture",
        "cpu_model",
        "pmu_model",
        "firmware_id",
        "kernel_id",
        "perf_id",
        "programmable_counter_capacity"
      ],
      "properties": {
        "platform_id": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "cpu_model": {
          "type": "string",
          "minLength": 1
        },
        "pmu_model": {
          "type": "string",
          "minLength": 1
        },
        "firmware_id": {
          "type": "string",
          "minLength": 1
        },
        "kernel_id": {
          "type": "string",
          "minLength": 1
        },
        "perf_id": {
          "type": "string",
          "minLength": 1
        },
        "programmable_counter_capacity": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_id",
        "binary_sha256",
        "work_unit",
        "fixed_work_units"
      ],
      "properties": {
        "workload_id": {
          "type": "string",
          "minLength": 1
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "work_unit": {
          "type": "string",
          "minLength": 1
        },
        "fixed_work_units": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "encoding",
          "semantic",
          "unit"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "encoding": {
            "type": "string",
            "minLength": 1
          },
          "semantic": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acquisition_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_condition",
        "singleton_condition",
        "co_scheduled_condition",
        "overcommitted_condition",
        "co_scheduled_event_ids",
        "overcommitted_event_ids"
      ],
      "properties": {
        "baseline_condition": {
          "const": "baseline_no_pmu"
        },
        "singleton_condition": {
          "const": "singleton_per_event"
        },
        "co_scheduled_condition": {
          "const": "grouped_co_scheduled"
        },
        "overcommitted_condition": {
          "const": "grouped_overcommitted"
        },
        "co_scheduled_event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "overcommitted_event_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "randomized_order_required",
        "randomization_seed",
        "matched_blocks_required",
        "minimum_blocks_for_descriptive_quantiles",
        "minimum_singleton_running_fraction",
        "minimum_co_scheduled_running_fraction",
        "maximum_co_scheduled_relative_deviation",
        "maximum_instrumentation_throughput_degradation"
      ],
      "properties": {
        "randomized_order_required": {
          "const": true
        },
        "randomization_seed": {
          "type": "string",
          "minLength": 1
        },
        "matched_blocks_required": {
          "const": true
        },
        "minimum_blocks_for_descriptive_quantiles": {
          "type": "integer",
          "minimum": 2
        },
        "minimum_singleton_running_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "minimum_co_scheduled_running_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "maximum_co_scheduled_relative_deviation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_instrumentation_throughput_degradation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "claim_scope": {
      "const": "measurement_configuration_and_declared_trial_record_qualification_only"
    }
  }
}
