{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/schemas/rea-differential-cases-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "purpose",
    "safety_constraints",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "symthaea.rea-differential-cases.v1"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "safety_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "family",
          "recipe",
          "supported_baseline",
          "expected_files",
          "required_region_kinds",
          "accounting_classes",
          "mutations"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "recipe": {
            "type": "string",
            "minLength": 1
          },
          "supported_baseline": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "enum": [
                  "abstain-or-partial",
                  "partial-or-abstain"
                ]
              }
            ]
          },
          "expected_files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "utf8",
                "logical_id"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "utf8": {
                  "type": "string"
                },
                "logical_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "required_region_kinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "accounting_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "identified",
                "padding",
                "unknown",
                "unsupported",
                "ambiguous"
              ]
            }
          },
          "mutations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
