{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/hardsec-source-graph-v1.schema.json",
  "title": "HARDSEC source graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_artifact_sha256",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "hardsec-source-graph-v1"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "source",
          "target"
        ],
        "properties": {
          "edge_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the original source design/netlist bytes from which this graph was extracted."
    }
  },
  "$comment": "source_artifact_sha256 binds the graph representation to the original netlist/design bytes; hash of this JSON graph file is a separate receipt input, and the canonical node/edge-map digest is another distinct identity."
}
