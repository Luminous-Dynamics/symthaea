{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/energy/edlc_mission_readiness_v0_1.schema.json",
  "title": "EDLC mission-weighted standby-to-service readiness fixture v0.1",
  "description": "Strict data contract for mission-stratified EDLC standby-to-service outcomes. Schema shape does not authenticate physical traces, instruments, calibration, mission-weight provenance or device identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "evidence_class",
    "claim_ceiling",
    "assumptions",
    "protocol",
    "strata",
    "expected",
    "negative_controls"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "fixture_id": {
      "const": "EDLC-MISSION-READINESS-KNOWN-ANSWER-001"
    },
    "evidence_class": {
      "const": "synthetic_mission_readiness_arithmetic"
    },
    "claim_ceiling": {
      "const": "SYNTHETIC_MISSION_PROFILE_WEIGHTING_AND_PASS_RULES_ONLY_NOT_PHYSICAL_DEVICE_READINESS_OR_RELIABILITY"
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stratum"
      }
    },
    "expected": {
      "$ref": "#/$defs/expected"
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "standby_mode",
        "physical_boundary",
        "event_weight_source",
        "event_weight_source_reference"
      ],
      "properties": {
        "protocol_id": {
          "type": "string",
          "minLength": 1
        },
        "standby_mode": {
          "enum": [
            "open_circuit",
            "regulated_voltage_hold"
          ]
        },
        "physical_boundary": {
          "enum": [
            "complete_device",
            "module",
            "installed_system"
          ]
        },
        "event_weight_source": {
          "enum": [
            "observed_application_log",
            "contractual_profile",
            "engineering_assumption",
            "synthetic_demo_only"
          ]
        },
        "event_weight_source_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_delivered_energy_wh",
        "minimum_sustained_power_w",
        "maximum_response_latency_s",
        "minimum_application_voltage_v",
        "maximum_temperature_rise_c",
        "maximum_standby_auxiliary_energy_wh",
        "maximum_external_replenishment_energy_wh"
      ],
      "properties": {
        "minimum_delivered_energy_wh": {
          "type": "number",
          "minimum": 0
        },
        "minimum_sustained_power_w": {
          "type": "number",
          "minimum": 0
        },
        "maximum_response_latency_s": {
          "type": "number",
          "minimum": 0
        },
        "minimum_application_voltage_v": {
          "type": "number",
          "minimum": 0
        },
        "maximum_temperature_rise_c": {
          "type": "number",
          "minimum": 0
        },
        "maximum_standby_auxiliary_energy_wh": {
          "type": "number",
          "minimum": 0
        },
        "maximum_external_replenishment_energy_wh": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_device_serial",
        "status"
      ],
      "properties": {
        "physical_device_serial": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "measured",
            "failed",
            "invalid",
            "censored"
          ]
        },
        "failure_reason": {
          "type": "string",
          "minLength": 1
        },
        "delivered_energy_wh": {
          "type": "number",
          "minimum": 0
        },
        "minimum_sustained_power_w": {
          "type": "number",
          "minimum": 0
        },
        "response_latency_s": {
          "type": "number",
          "minimum": 0
        },
        "minimum_application_voltage_v": {
          "type": "number",
          "minimum": 0
        },
        "temperature_rise_c": {
          "type": "number"
        },
        "standby_auxiliary_energy_wh": {
          "type": "number",
          "minimum": 0
        },
        "external_replenishment_energy_wh": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "measured"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "delivered_energy_wh",
              "minimum_sustained_power_w",
              "response_latency_s",
              "minimum_application_voltage_v",
              "temperature_rise_c",
              "standby_auxiliary_energy_wh",
              "external_replenishment_energy_wh"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "invalid",
                  "censored"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "failure_reason"
            ]
          }
        }
      ]
    },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stratum_id",
        "load_profile_id",
        "standby_duration_hours",
        "event_arrival_weight",
        "requirements",
        "observations"
      ],
      "properties": {
        "stratum_id": {
          "type": "string",
          "minLength": 1
        },
        "load_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "standby_duration_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "event_arrival_weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_weighted_service_pass_rate",
        "method"
      ],
      "properties": {
        "mission_weighted_service_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "const": "sum_of_event_weight_times_stratum_service_pass_fraction"
        }
      }
    }
  }
}
