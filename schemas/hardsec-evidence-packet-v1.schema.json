{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/hardsec-evidence-packet-v1.schema.json",
  "title": "HARDSEC Evidence Packet v1",
  "description": "Portable shape for a detector alert or detector-free witness validation packet. Claim correctness remains subject to the semantic auditor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "dataset_id",
    "evaluation_mode",
    "subject",
    "evidence",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "hardsec-evidence-packet-v1"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_mode": {
      "enum": [
        "detector_alert",
        "witness_validation"
      ]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "detector": {
      "$ref": "#/$defs/detector"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluation_mode": {
            "const": "detector_alert"
          }
        },
        "required": [
          "evaluation_mode"
        ]
      },
      "then": {
        "required": [
          "detector"
        ]
      },
      "else": {
        "not": {
          "required": [
            "detector"
          ]
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|\\\\\\\\|(^|/)\\\\.\\\\.?(/|$))"
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_id",
        "netlist_sha256"
      ],
      "properties": {
        "design_id": {
          "type": "string",
          "minLength": 1
        },
        "netlist_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "local_path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "model_sha256",
        "config_sha256",
        "score",
        "threshold",
        "decision"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decision": {
          "enum": [
            "trojan_suspected",
            "no_alert",
            "abstain"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "subject_sha256",
        "evidence_sha256",
        "uri",
        "status",
        "tool",
        "tool_version",
        "scope"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "stimulus_trace",
            "cover_witness",
            "payload_effect_trace",
            "formal_proof",
            "equivalence_report",
            "localization_map",
            "domain_measurement",
            "precedent",
            "artifact_manifest",
            "reviewer_decision"
          ]
        },
        "subject_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "local_path": {
          "$ref": "#/$defs/relativePath"
        },
        "witness_local_path": {
          "$ref": "#/$defs/relativePath"
        },
        "assumptions_local_path": {
          "$ref": "#/$defs/relativePath"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "not_applicable"
          ]
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "proof_scope": {
          "enum": [
            "bounded",
            "unbounded",
            "assumption_scoped"
          ]
        },
        "formal_result": {
          "enum": [
            "assertion_proved",
            "bounded_no_counterexample",
            "cover_reached",
            "equivalence_proved",
            "counterexample_found",
            "timeout",
            "unknown"
          ]
        },
        "property_id": {
          "type": "string",
          "minLength": 1
        },
        "assumptions_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "witness_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stimuli_count": {
          "type": "integer",
          "minimum": 0
        },
        "activation_count": {
          "type": "integer",
          "minimum": 0
        },
        "payload_effects_observed": {
          "type": "integer",
          "minimum": 0
        },
        "bound_cycles": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "formal_proof"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "formal_result",
              "property_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "cover_witness"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "formal_result",
              "property_id",
              "proof_scope",
              "bound_cycles",
              "witness_sha256"
            ],
            "properties": {
              "formal_result": {
                "const": "cover_reached"
              },
              "proof_scope": {
                "const": "bounded"
              },
              "bound_cycles": {
                "minimum": 1
              },
              "status": {
                "const": "pass"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "payload_effect_trace"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "stimuli_count",
              "payload_effects_observed"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "equivalence_report"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "formal_result",
              "property_id"
            ]
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_type",
        "status",
        "scope",
        "evidence_ids"
      ],
      "properties": {
        "claim_type": {
          "enum": [
            "model_suspects_trojan",
            "localization_provided",
            "trigger_activated",
            "trigger_not_observed_under_budget",
            "payload_effect_observed",
            "payload_effect_not_observed_under_budget",
            "bounded_reachability_not_found",
            "trigger_unreachable_under_assumptions",
            "functional_equivalence",
            "source_integrity_checked",
            "reviewer_confirmed",
            "trojan_absent",
            "design_is_secure"
          ]
        },
        "status": {
          "enum": [
            "supported",
            "contradicted",
            "unknown",
            "not_evaluated"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
