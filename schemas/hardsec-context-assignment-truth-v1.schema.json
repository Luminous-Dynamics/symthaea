{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symthaea/blob/main/schemas/hardsec-context-assignment-truth-v1.schema.json",
  "title": "HARDSEC held-out context truth oracle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_domain",
    "stream_id",
    "evaluation_group_id",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "hardsec-context-assignment-truth-v1"
    },
    "evidence_domain": {
      "enum": [
        "synthetic_fixture",
        "simulator",
        "physical_hardware"
      ]
    },
    "stream_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_group_id": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence_index",
          "window_id",
          "true_context_id"
        ],
        "properties": {
          "sequence_index": {
            "type": "integer",
            "minimum": 1
          },
          "window_id": {
            "type": "string",
            "minLength": 1
          },
          "true_context_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
